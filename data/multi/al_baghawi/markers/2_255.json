  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1022,
      "end": 1191,
      "text": "¬أبي السليل: هو ضريب بن نقيْر ويقال نقيل أبو السليل القيسي الجريري البصري، قال إسحاق بن منصور: عن يحيى بن معين: ثقة وذكره ابن حبان في الثقات: تهذيب التهذيب ج 4 - ص 401.¥",
      "attached_span_id": "s002",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1677,
      "end": 1822,
      "text": "¬أخرجه مسلم: في صلاة المسافرين وقصرها برقم (810) 1/ 156 برواية مختلفة. والمصنف ف شرح السنة 4/ 459. وقوله: (ليهنك العلم) أي: ليكن العلم هنيئا لك.¥",
      "attached_span_id": "s005",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4678,
      "end": 4853,
      "text": "¬أخرجه البخاري في الوكالة، باب إذا وكل رجلا فترك الوكيل شيئا .. 4/ 486 - 487، وفي بدء الخلق - باب صفة إبليس وجنوده 6/ 335 - 336 وفي فضائل القرآن. والمصنف في شرح السنة 4/ 460.¥",
      "attached_span_id": "s026",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5597,
      "end": 5832,
      "text": "¬أخرجه الترمذي: في فضائل القرآن - باب ما جاء في سورة البقرة وآية الكرسي 8/ 182 وقال هذا حديث غريب. وفي سنده عبد الرحمن بن أبي بكر بن عبيد الله بن أبي مليكه (بالتصغير) كما في المغني وهو ضعيف من السابعة - التقريب. ميزان الاعتدال 2/ 550.¥",
      "attached_span_id": "s029",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6231,
      "end": 6245,
      "text": "¬ساقط من (ب).¥",
      "attached_span_id": "s030",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7876,
      "end": 8028,
      "text": "¬أخرجه مسلم: في الإيمان - باب في قوله عليه السلام إن الله لا ينام وفي قوله حجابه النور لو كشفه لأحرقت سبحات وجهه ما انتهى والمصنف في شرح السنة: 1/ 173.¥",
      "attached_span_id": "s037",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9998,
      "end": 10500,
      "text": "¬أورده الطبري في التفسير برواية أخرى قال: حدثني يونس قال أخبرنا ابن وهب قال: قال ابن زيد حدثني أبي قال: قال رسول الله صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \"ما السماوات السبع في الكرسي إلا كدراهم سبعة ألقيت في ترس\" 5/ 399. ورواه محمد بن أبي شيبة في كتاب العرش، وعزاه ابن كثير لابن مردويه، وأخرجه البيهقي في الأسماء والصفات: 2/ 149 وفيه إبراهيم ابن هشام بن يحيى الغساني: متروك كذبه أبو حاتم وأبو زرعة، وطرق الحديث كلها واهية، فلا تعتضد لضعفها، انظر: النهج السديد في تخريج أحاديث تيسير العزيز الحميد ص 283.¥",
      "attached_span_id": "s050",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11435,
      "end": 11449,
      "text": "¬ساقط من (ب).¥",
      "attached_span_id": "s052",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11846,
      "end": 12134,
      "text": "¬نقل ذلك عنه الطبري في التفسير: 5/ 397 - 398، والبيهقي في الأسماء والصفات، فقال: \"وروينا عن سعيد بن جبير عن ابن عباس رضي الله عنهما أنه قال: \"علمه\" ثم قال: وسائر الروايات عن ابن عباس وغيره تدل على أن المراد به الكرسي المشهور المذكور مع العرش، انظر: الأسماء والصفات للبيهقي: 2/ 134 - 135.¥",
      "attached_span_id": "s054",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    }

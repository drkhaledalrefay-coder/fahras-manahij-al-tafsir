    {
      "id": "s288",
      "start": 22943,
      "end": 23015,
      "text": " به، {وَمَا أُنْزِلَ عَلَى الْمَلَكَيْنِ بِبَابِلَ هَارُوتَ وَمَارُوتَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 22948,
          "end": 23014,
          "span_id": "s288"
        }
      ]
    },
    {
      "id": "s289",
      "start": 23038,
      "end": 23039,
      "text": ".",
      "markers": []
    },
    {
      "id": "s290",
      "start": 23043,
      "end": 23047,
      "text": "فإذ ",
      "markers": []
    },
    {
      "id": "s291",
      "start": 23062,
      "end": 23106,
      "text": " كان الأمرُ في ذلك ما وصَفنا، وتأويلُ قولِه:",
      "markers": []
    },
    {
      "id": "s292",
      "start": 23106,
      "end": 23251,
      "text": " {وَاتَّبَعُوا مَا تَتْلُو الشَّيَاطِينُ عَلَى مُلْكِ سُلَيْمَانَ وَمَا كَفَرَ سُلَيْمَانُ وَلَكِنَّ الشَّيَاطِينَ كَفَرُوا}. ما ذكَرنا، فبيِّنٌ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 23107,
          "end": 23230,
          "span_id": "s292"
        }
      ]
    },
    {
      "id": "s293",
      "start": 23282,
      "end": 23356,
      "text": " أن في الكلامِ متروكًا، ترِك ذكرُه اكتفاءً بما ذكِر منه، وأن معنى الكلامِ:",
      "markers": []
    },
    {
      "id": "s294",
      "start": 23356,
      "end": 23523,
      "text": " واتَّبَعوا ما تَتْلو الشياطينُ مِن السحرِ على مُلْكِ سليمانَ، فتُضِيفُه إلى سليمانَ، وما كفَر سليمانُ فيعمَلَ بالسحرِ، ولكنَّ الشياطينَ كفَروا يعلِّمون الناسَ السحرَ.",
      "markers": []
    },
    {
      "id": "s295",
      "start": 23527,
      "end": 23557,
      "text": "وقد كان قتادةُ يتأوَّلُ قولَه:",
      "markers": []
    },
    {
      "id": "s296",
      "start": 23557,
      "end": 23623,
      "text": " {وَمَا كَفَرَ سُلَيْمَانُ وَلَكِنَّ الشَّيَاطِينَ كَفَرُوا}. على ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 23558,
          "end": 23617,
          "span_id": "s296"
        }
      ]
    },
    {
      "id": "s297",
      "start": 23639,
      "end": 23640,
      "text": " ",
      "markers": []
    },
    {
      "id": "s298",
      "start": 23673,
      "end": 23674,
      "text": ".",
      "markers": []
    },
    {
      "id": "s299",
      "start": 23678,
      "end": 23706,
      "text": "حدَّثنا بشرُ بنُ معاذٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 23678,
          "end": 23685,
          "span_id": "s299"
        },
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 23695,
          "end": 23699,
          "span_id": "s299"
        }
      ]
    },
    {
      "id": "s300",
      "start": 23706,
      "end": 23737,
      "text": " حدثنا يزيدُ بنُ زُرَيْعٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 23707,
          "end": 23712,
          "span_id": "s300"
        }
      ]
    },
    {
      "id": "s301",
      "start": 23737,
      "end": 23822,
      "text": " حدثنا سعيدٌ، عن قتادةَ: {وَمَا كَفَرَ سُلَيْمَانُ وَلَكِنَّ الشَّيَاطِينَ كَفَرُوا}.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 23738,
          "end": 23743,
          "span_id": "s301"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 23754,
          "end": 23759,
          "span_id": "s301"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 23762,
          "end": 23821,
          "span_id": "s301"
        }
      ]
    },
    {
      "id": "s302",
      "start": 23822,
      "end": 23903,
      "text": " يقولُ: ما كان عن مشورتِه، ولا عن رضًا منه، ولكنه شيء افتَعَلَته الشياطينُ دونَه ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 23837,
          "end": 23875,
          "stripped": "عن مشورته، ولا عن رضا منه، ولكنه شيء",
          "span_id": "s302"
        }
      ]
    },
    {
      "id": "s303",
      "start": 23978,
      "end": 23979,
      "text": ".",
      "markers": []
    },
    {
      "id": "s304",
      "start": 23983,
      "end": 24041,
      "text": "وقد دلَّلنا فيما مضَى قبلُ على اختلافِ المختلِفين في معنى:",
      "markers": []
    },
    {
      "id": "s305",
      "start": 24041,
      "end": 24083,
      "text": " {تَتْلُو}. وتوجيهِ مَن وجَّه ذلك إلى أنه ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 24042,
          "end": 24051,
          "span_id": "s305"
        }
      ]
    },
    {
      "id": "s306",
      "start": 24101,
      "end": 24158,
      "text": " بمعنى \"تلَت\"، إذ كان الذي قبلَه خبرًا ماضيًا، وهو قولُه:",
      "markers": []
    },
    {
      "id": "s307",
      "start": 24158,
      "end": 24292,
      "text": " {تَتْلُو}. وتوجيهِ الذين وجَّهوا ذلك إلى خلافِ ذلك، وبيَّنا فيه وفي نظيرِه الصوابَ مِن القولِ، فأغنَى ذلك عن إعادتِه في هذا الموضِعِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 24159,
          "end": 24168,
          "span_id": "s307"
        }
      ]
    },
    {
      "id": "s308",
      "start": 24316,
      "end": 24317,
      "text": ".",
      "markers": []
    },
    {
      "id": "s309",
      "start": 24321,
      "end": 24354,
      "text": "وأمَّا معنى قولِه: {مَا تَتْلُو}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 24340,
          "end": 24353,
          "span_id": "s309"
        }
      ]
    },
    {
      "id": "s310",
      "start": 24354,
      "end": 24390,
      "text": " فإنه: بمعنى: الذي تتلو، وهو السحرُ.",
      "markers": []
    },
    {
      "id": "s311",
      "start": 24394,
      "end": 24398,
      "text": "كما ",
      "markers": []
    },
    {
      "id": "s312",
      "start": 24425,
      "end": 24477,
      "text": " حدَّثنا ابنُ حميدٍ، قال: ثنا سلمةُ، عن ابنِ إسحاقَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 24426,
          "end": 24433,
          "span_id": "s312"
        }
      ]
    },
    {
      "id": "s313",
      "start": 24477,
      "end": 24556,
      "text": " {وَاتَّبَعُوا مَا تَتْلُو الشَّيَاطِينُ عَلَى مُلْكِ سُلَيْمَانَ}. أي: السحرَ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 24478,
          "end": 24543,
          "span_id": "s313"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 24545,
          "end": 24548,
          "span_id": "s313"
        }
      ]
    },
    {
      "id": "s314",
      "start": 24560,
      "end": 24620,
      "text": "ولعلَّ قائلًا أن يقولَ: أوَ ما كان السحرُ إلا أيامَ سليمانَ؟",
      "markers": []
    },
    {
      "id": "s315",
      "start": 24624,
      "end": 24635,
      "text": "قيل له: بل ",
      "markers": []
    },
    {
      "id": "s316",
      "start": 24664,
      "end": 24724,
      "text": " قد كان ذلك قبلَ ذلك، وقد أخبرَ اللهُ عن سَحَرةِ فرعونَ بما ",
      "markers": []
    },
    {
      "id": "s317",
      "start": 24737,
      "end": 24821,
      "text": " أخبرَ عنهم، وقد كانوا قبلَ سليمانَ، وأخبرَ عن قومِ نوحٍ أنهم قالوا لنوحٍ إنه ساحرٌ.",
      "markers": []
    },
    {
      "id": "s318",
      "start": 24825,
      "end": 24829,
      "text": "فإن ",
      "markers": []
    },
    {
      "id": "s319",
      "start": 24856,
      "end": 24920,
      "text": " قال: فكيف أخبرَ عن اليهودِ أنهم اتبَعوا ما تَلَته الشياطينُ في ",
      "markers": []
    },
    {
      "id": "s320",
      "start": 24949,
      "end": 24964,
      "text": " عهدِ سليمانَ، ",
      "markers": []
    },
    {
      "id": "s321",
      "start": 25144,
      "end": 25145,
      "text": " ",
      "markers": []
    },
    {
      "id": "s322",
      "start": 25159,
      "end": 25321,
      "text": "؛ لأنهم أضافوا ذلك إلى سليمانَ -على ما قد قدَّمنا البيانَ عنه- فأراد اللهُ تعالى ذكرُه تَبرئةَ سليمانَ مما نَحَلُوه وأضافوا إليه مما كانوا وجَدوه، إما في خزائنِه ",
      "markers": []
    },
    {
      "id": "s323",
      "start": 25342,
      "end": 25415,
      "text": " وإما تحتَ كرسيِّه، على ما جاءت به الآثارُ التي قد ذكَرناها من ذلك، فخصّ ",
      "markers": []
    },
    {
      "id": "s324",
      "start": 25445,
      "end": 25483,
      "text": " الخبرَ عما كانت اليهودُ اتبَعتْه مما ",
      "markers": []
    },
    {
      "id": "s325",
      "start": 25498,
      "end": 25526,
      "text": " تَلَته الشياطينُ أيَّامئذٍ ",
      "markers": []
    },
    {
      "id": "s326",
      "start": 25548,
      "end": 25568,
      "text": " دونَ غيرِه لذلك من ",
      "markers": []
    },
    {
      "id": "s327",
      "start": 25585,
      "end": 25652,
      "text": " السببِ، وإن كانت الشياطينُ قد كانت تاليةَ السحرِ والكفرِ قبلَ ذلك.",
      "markers": []
    }
  ],

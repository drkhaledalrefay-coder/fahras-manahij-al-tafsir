  "spans": [
    {
      "id": "s001",
      "start": 5,
      "end": 6,
      "text": " ",
      "markers": []
    },
    {
      "id": "s002",
      "start": 10,
      "end": 11,
      "text": " ",
      "markers": []
    },
    {
      "id": "s003",
      "start": 15,
      "end": 52,
      "text": "القولُ في تأويل قولِ اللهِ جلّ ثناؤه:",
      "markers": []
    },
    {
      "id": "s004",
      "start": 52,
      "end": 107,
      "text": " {اللَّهُ لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 53,
          "end": 106,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 111,
      "end": 175,
      "text": "قد دلَّلْنا فيما مضى على تأويلِ قولِ اللهِ جلّ ثناؤه: {اللَّهُ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 165,
          "end": 174,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 200,
      "end": 201,
      "text": ".",
      "markers": []
    },
    {
      "id": "s007",
      "start": 205,
      "end": 249,
      "text": "وأما تأويلُ قولِه: {لَا إِلَهَ إِلَّا هُوَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 224,
          "end": 248,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 249,
      "end": 379,
      "text": " فإن معناه النَّهيُ عن أن يُعبدَ شيءٌ غيرُ اللهِ الحيِّ القَيُّومِ، الذي صفَتُه ما وصَف به نفسَه تعالى ذكرُه في هذه الآيةِ، يقولُ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 254,
          "end": 259,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 379,
      "end": 454,
      "text": " اللهُ الذي له عبادةُ الخلقِ، الحيُّ القيومُ، لا إلهَ سواه، لا معبودَ سواه.",
      "markers": []
    },
    {
      "id": "s010",
      "start": 454,
      "end": 483,
      "text": " يعني: فلا تعبُدوا شيئًا سوى ",
      "markers": []
    },
    {
      "id": "s011",
      "start": 498,
      "end": 582,
      "text": " الحيِّ القيُّومِ الذي لا تأخُذُه سِنةٌ ولا نومٌ، والذي صفتُه ما وصَف في هذه الآيةِ.",
      "markers": []
    },
    {
      "id": "s012",
      "start": 586,
      "end": 659,
      "text": "وهذه الآيةُ إبانةٌ من اللهِ جلّ ثناؤه للمؤمنين به وبرسولِه، عما جاءتْ به ",
      "markers": []
    },
    {
      "id": "s013",
      "start": 680,
      "end": 692,
      "text": " المختلِفين ",
      "markers": []
    },
    {
      "id": "s014",
      "start": 710,
      "end": 740,
      "text": " البيناتُ من بعدِ الرسلِ التي ",
      "markers": []
    },
    {
      "id": "s015",
      "start": 756,
      "end": 804,
      "text": " أخبَرَنا تعالى ذكرُه أنه فضَّل بعضَهم على بعضٍ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 757,
          "end": 765,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 804,
      "end": 932,
      "text": " واختلَفوا فيه، فاقتتلُوا فيه كفرًا به من بعضٍ، وإيمانًا به من بعضٍ، فالحمدُ للهِ الذي هدانا للتصديقِ به، ووفَّقَنا للإقرارِ به.",
      "markers": []
    },
    {
      "id": "s017",
      "start": 936,
      "end": 972,
      "text": "وأما قولُه: {الْحَيُّ}. فإنه يَعنِي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 948,
          "end": 958,
          "span_id": "s017"
        }
      ]
    },
    {
      "id": "s018",
      "start": 972,
      "end": 1032,
      "text": " الذي له الحياةُ الدائمةُ، والبقاءُ الذي لا أوّلَ له بحَدٍّ ",
      "markers": []
    },
    {
      "id": "s019",
      "start": 1046,
      "end": 1066,
      "text": "، ولا آخرَ له بأمدٍ ",
      "markers": []
    },
    {
      "id": "s020",
      "start": 1081,
      "end": 1160,
      "text": "، إذ كلُّ ما سواه فإنه وإنْ كان حيًّا فلِحياتِه أَوَّلٌ محدودٌ، وآخرٌ مَمْدودٌ ",
      "markers": []
    },
    {
      "id": "s021",
      "start": 1179,
      "end": 1235,
      "text": "، يَنْقَطِعُ بانقطاعِ أمدِها، وينقَضِى بانقضاءِ غايتِها.",
      "markers": []
    },
    {
      "id": "s022",
      "start": 1239,
      "end": 1282,
      "text": "وبما قلْنا في ذلك قال جماعةُ أهلِ التأويلِ.",
      "markers": []
    },
    {
      "id": "s023",
      "start": 1286,
      "end": 1300,
      "text": "ذكر من قال ذلك",
      "markers": []
    },
    {
      "id": "s024",
      "start": 1304,
      "end": 1338,
      "text": "حُدِّثْتُ عن عمارِ بن الحسنِ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 1326,
          "end": 1331,
          "span_id": "s024"
        }
      ]
    },
    {
      "id": "s025",
      "start": 1338,
      "end": 1413,
      "text": " ثنا ابن أبي جعفرٍ، عن أبيه، عن الرَّبيعِ قولَه: {الْحَيُّ}: حيٌّ لا يموتُ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1358,
          "end": 1401,
          "stripped": "عن أبيه، عن الربيع قوله: {الحي}: حي",
          "span_id": "s025"
        },
        {
          "family": "TABIIN",
          "marker": "الربيع",
          "name": "الربيع",
          "role": "NARRATOR",
          "start": 1370,
          "end": 1378,
          "span_id": "s025"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1387,
          "end": 1397,
          "span_id": "s025"
        }
      ]
    },
    {
      "id": "s026",
      "start": 1482,
      "end": 1483,
      "text": ".",
      "markers": []
    },
    {
      "id": "s027",
      "start": 1487,
      "end": 1526,
      "text": "حدَّثني المثنَّى، قال: ثنا إسحاقُ، قال:",
      "markers": []
    },
    {
      "id": "s028",
      "start": 1526,
      "end": 1572,
      "text": " ثنا ابن أبي جعفرٍ، عن أبيه، عن الربيعِ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1546,
          "end": 1572,
          "stripped": "عن أبيه، عن الربيع مثله.",
          "span_id": "s028"
        },
        {
          "family": "TABIIN",
          "marker": "الربيع",
          "name": "الربيع",
          "role": "NARRATOR",
          "start": 1558,
          "end": 1564,
          "span_id": "s028"
        }
      ]
    },
    {
      "id": "s029",
      "start": 1576,
      "end": 1613,
      "text": "وقد اختلَف أهلُ البحثِ في تأويلِ ذلك؛",
      "markers": []
    },
    {
      "id": "s030",
      "start": 1613,
      "end": 1663,
      "text": " فقال بعضُهم: إنما سمَّى اللهُ جل وعزّ نفسه حيًّا؛",
      "markers": []
    },
    {
      "id": "s031",
      "start": 1663,
      "end": 1750,
      "text": " لصَرْفِه الأمورَ مَصارفَها، وتقديرِه الأشياءَ مقاديرَها، فهو حيٌّ بالتدبيرِ لا بحياةٍ.",
      "markers": []
    },
    {
      "id": "s032",
      "start": 1754,
      "end": 1795,
      "text": "وقال آخرون: بل هو حيٌّ بحياةٍ هي له صفةٌ.",
      "markers": []
    },
    {
      "id": "s033",
      "start": 1799,
      "end": 1872,
      "text": "وقال آخرون: بل ذلك اسمٌ من الأسماءِ تَسَمَّى به، فقُلْناه تسليمًا لأمرِه.",
      "markers": []
    },
    {
      "id": "s034",
      "start": 1876,
      "end": 2098,
      "text": "وأما قولُه: {الْقَيُّومُ}. فإنه الفَيْعُولُ من القيامِ، وأصلُه القيْوُومُ، سبَق عينَ الفعلِ - وهي واوٌ - ياءٌ ساكنةٌ، فانْدَغَمتا فصارتا ياءً مشددةً، وكذلك تفعلُ العربُ في كلِّ واوٍ كانت للفعلِ عينًا سبَقَتْها ياءٌ ساكنةٌ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1888,
          "end": 1901,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2102,
      "end": 2179,
      "text": "ومعنى قولِه: {الْقَيُّومُ}: القائمُ برزْقِ ما خلَق وحِفْظِه، كما قال أُميّةُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2115,
          "end": 2128,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 2197,
      "end": 2198,
      "text": ":",
      "markers": []
    },
    {
      "id": "s037",
      "start": 2202,
      "end": 2234,
      "text": "لم تُخْلَقِ السماءُ والنُّجومُ .",
      "markers": []
    },
    {
      "id": "s038",
      "start": 2234,
      "end": 2266,
      "text": ".. والشمسُ مَنْها قَمَرٌ يَعومُ ",
      "markers": []
    },
    {
      "id": "s039",
      "start": 2298,
      "end": 2344,
      "text": "قَدَّرَهُ المُهَيْمِنُ القَيُّومُ ... والحشرُ ",
      "markers": []
    },
    {
      "id": "s040",
      "start": 2365,
      "end": 2385,
      "text": " والجَنَّةُ والجحيمُ",
      "markers": []
    },
    {
      "id": "s041",
      "start": 2389,
      "end": 2410,
      "text": "إلا لأمرٍ شأنُه عظيمُ",
      "markers": []
    },
    {
      "id": "s042",
      "start": 2414,
      "end": 2457,
      "text": "وبنحوِ الذي قلْنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s043",
      "start": 2461,
      "end": 2462,
      "text": " ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 2466,
      "end": 2481,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s045",
      "start": 2485,
      "end": 2514,
      "text": "حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s046",
      "start": 2514,
      "end": 2588,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابن أبي نَجيحٍ، عن مجاهدٍ في قولِ اللهِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2545,
          "end": 2588,
          "stripped": "عن ابن أبي نجيح، عن مجاهد في قول الله:",
          "span_id": "s046"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 2567,
          "end": 2572,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 2588,
      "end": 2631,
      "text": " {الْقَيُّومُ}. قال: القائمُ على كلِّ شيءٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2589,
          "end": 2602,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 2849,
      "end": 2850,
      "text": ".",
      "markers": []
    },
    {
      "id": "s049",
      "start": 2854,
      "end": 2893,
      "text": "حدَّثني المثنَّى، قال: ثنا إسحاقُ، قال:",
      "markers": []
    },
    {
      "id": "s050",
      "start": 2893,
      "end": 2963,
      "text": " حدثنا ابن أبي جعفرٍ، عن أبيه، عن الربيعِ: {الْقَيُّومُ}: قَيِّمٌ على ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2894,
          "end": 2899,
          "span_id": "s050"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2915,
          "end": 2962,
          "stripped": "عن أبيه، عن الربيع: {القيوم}: قيم على",
          "span_id": "s050"
        },
        {
          "family": "TABIIN",
          "marker": "الربيع",
          "name": "الربيع",
          "role": "SPEAKER",
          "start": 2927,
          "end": 2933,
          "span_id": "s050"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2936,
          "end": 2949,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 2996,
      "end": 3040,
      "text": " كلِّ شيءٍ، يَكْلَؤُه ويَرْزُقُه ويَحْفَظُه ",
      "markers": []
    },
    {
      "id": "s052",
      "start": 3109,
      "end": 3110,
      "text": ".",
      "markers": []
    },
    {
      "id": "s053",
      "start": 3114,
      "end": 3141,
      "text": "حدثني موسى بنُ هارونَ، قال:",
      "markers": []
    },
    {
      "id": "s054",
      "start": 3141,
      "end": 3167,
      "text": " ثنا عمرُو بنُ حمادٍ، قال:",
      "markers": []
    },
    {
      "id": "s055",
      "start": 3167,
      "end": 3218,
      "text": " ثنا أسباطُ، عن السديِّ: {الْقَيُّومُ}: هو القائمُ ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 3183,
          "end": 3188,
          "span_id": "s055"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3192,
          "end": 3205,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 3346,
      "end": 3347,
      "text": ".",
      "markers": []
    },
    {
      "id": "s057",
      "start": 3351,
      "end": 3390,
      "text": "حدَّثني المثنَّى، قال: ثنا إسحاقُ، قال:",
      "markers": []
    },
    {
      "id": "s058",
      "start": 3390,
      "end": 3435,
      "text": " ثنا أبو زُهَيرٍ، عن جُويبرٍ، عن الضَّحَّاكِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3408,
          "end": 3435,
          "stripped": "عن جويبر، عن الضحاك:",
          "span_id": "s058"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 3423,
          "end": 3433,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 3435,
      "end": 3480,
      "text": " {الْحَيُّ الْقَيُّومُ} قال: القائمُ الدائمُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3436,
          "end": 3458,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 3519,
      "end": 3520,
      "text": ".",
      "markers": []
    },
    {
      "id": "s061",
      "start": 3524,
      "end": 3525,
      "text": " ",
      "markers": []
    },
    {
      "id": "s062",
      "start": 3529,
      "end": 3563,
      "text": "القولُ في تأويلِ قولِه جلّ ثناؤُه:",
      "markers": []
    },
    {
      "id": "s063",
      "start": 3563,
      "end": 3601,
      "text": " {لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3564,
          "end": 3600,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 3605,
      "end": 3653,
      "text": "يعني بقولِه جلّ ثناؤُه: {لَا تَأْخُذُهُ سِنَةٌ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3629,
          "end": 3652,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 3653,
      "end": 3716,
      "text": " لا يَأْخُذُه نُعاسٌ فيَنْعَسَ، ولا نَوْمٌ فيَسْتَثْقِلَ نومًا.",
      "markers": []
    },
    {
      "id": "s066",
      "start": 3720,
      "end": 3745,
      "text": "والوَسَنُ خُثورةُ النومِ ",
      "markers": []
    },
    {
      "id": "s067",
      "start": 3801,
      "end": 3832,
      "text": "، ومنه قولُ عديِّ بن الرِّقاعِ ",
      "markers": []
    },
    {
      "id": "s068",
      "start": 3894,
      "end": 3895,
      "text": ":",
      "markers": []
    },
    {
      "id": "s069",
      "start": 3899,
      "end": 3937,
      "text": "وشنانُ أقْصَدَهُ النُّعاسُ فَرنَّقَتْ ",
      "markers": []
    },
    {
      "id": "s070",
      "start": 3981,
      "end": 4015,
      "text": " ... في عَيْنِه سِنَةٌ وليس بنائمِ",
      "markers": []
    },
    {
      "id": "s071",
      "start": 4019,
      "end": 4118,
      "text": "ومن الدليلِ على ما قلْنا، من أنها خُثورةُ النومِ في عينِ الإنسانِ، قولُ الأَعْشَى ميمونِ بن قَيْسٍ ",
      "markers": []
    },
    {
      "id": "s072",
      "start": 4132,
      "end": 4133,
      "text": ":",
      "markers": []
    },
    {
      "id": "s073",
      "start": 4137,
      "end": 4170,
      "text": "تُعاطِى الضَّجِيعَ إذا اسْتامَها ",
      "markers": []
    },
    {
      "id": "s074",
      "start": 4267,
      "end": 4281,
      "text": " ... بُعَيْدَ ",
      "markers": []
    },
    {
      "id": "s075",
      "start": 4299,
      "end": 4300,
      "text": " ",
      "markers": []
    },
    {
      "id": "s076",
      "start": 4343,
      "end": 4352,
      "text": " الوَسَنْ",
      "markers": []
    },
    {
      "id": "s077",
      "start": 4371,
      "end": 4372,
      "text": " ",
      "markers": []
    },
    {
      "id": "s078",
      "start": 4456,
      "end": 4457,
      "text": ":",
      "markers": []
    },
    {
      "id": "s079",
      "start": 4461,
      "end": 4482,
      "text": "باكَرَتْها الأغْرابُ ",
      "markers": []
    },
    {
      "id": "s080",
      "start": 4545,
      "end": 4605,
      "text": " في سِنَةِ النَّوْ ... مِ فتَجْرِى خِلالَ شَوْكِ السَّيَالِ ",
      "markers": []
    },
    {
      "id": "s081",
      "start": 4692,
      "end": 4757,
      "text": "يعني عندَ هُبوبِها من النومِ ووَسَنُ النومِ في عينِها، يقالُ منه:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 4747,
          "end": 4751,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 4757,
      "end": 4826,
      "text": " وَسِن فلانٌ فهو يَوْسَنُ وَسَنًا وسِنةً، وهو وَسْنانُ، إذا كان كذلك.",
      "markers": []
    },
    {
      "id": "s083",
      "start": 4830,
      "end": 4873,
      "text": "وبنحوِ الذي قلْنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s084",
      "start": 4877,
      "end": 4892,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s085",
      "start": 4896,
      "end": 4947,
      "text": "حدَّثني المثنى، قال: ثنا عبدُ اللهِ بنُ صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s086",
      "start": 4947,
      "end": 5012,
      "text": " ثني معاويةُ بنُ صالحٍ، عن عليّ بن أبي طلحةَ، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4971,
          "end": 5012,
          "stripped": "عن علي بن أبي طلحة، عن ابن عباس قوله:",
          "span_id": "s086"
        },
        {
          "family": "TABIIN",
          "marker": "علي بن أبي طلحة",
          "name": "علي بن أبي طلحة",
          "role": "NARRATOR",
          "start": 4974,
          "end": 4990,
          "span_id": "s086"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 4996,
          "end": 5004,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 5012,
      "end": 5050,
      "text": " {لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5013,
          "end": 5049,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 5050,
      "end": 5095,
      "text": " قال: السَّنَةُ النُّعاسُ، والنومُ هو النومُ ",
      "markers": []
    },
    {
      "id": "s089",
      "start": 5293,
      "end": 5294,
      "text": ".",
      "markers": []
    },
    {
      "id": "s090",
      "start": 5298,
      "end": 5326,
      "text": "حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s091",
      "start": 5326,
      "end": 5354,
      "text": " ثنى أبي، قال: ثنى عمي، قال:",
      "markers": []
    },
    {
      "id": "s092",
      "start": 5354,
      "end": 5386,
      "text": " ثنى أبي، عن أبيه، عن ابن عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5364,
          "end": 5386,
          "stripped": "عن أبيه، عن ابن عباس:",
          "span_id": "s092"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5376,
          "end": 5384,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 5386,
      "end": 5432,
      "text": " {لَا تَأْخُذُهُ سِنَةٌ}: السِّنَةُ النُّعاسُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5387,
          "end": 5410,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 5458,
      "end": 5459,
      "text": ".",
      "markers": []
    },
    {
      "id": "s095",
      "start": 5463,
      "end": 5490,
      "text": "حدثنا الحسنُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5463,
          "end": 5468,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 5490,
      "end": 5567,
      "text": " أخبَرَنا عبدُ الرزّاقِ، قال: أَخبَرَنَا مَعْمَرٌ، عن قتادةَ والحسن في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 5491,
          "end": 5499,
          "span_id": "s096"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 5491,
          "end": 5549,
          "stripped": "أخبرنا عبد الرزاق، قال: أخبرنا معمر، عن قتادة",
          "span_id": "s096"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 5520,
          "end": 5530,
          "span_id": "s096"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 5544,
          "end": 5549,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 5567,
      "end": 5607,
      "text": " {لَا تَأْخُذُهُ سِنَةٌ}: قالا: نَعْسةٌ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5568,
          "end": 5591,
          "span_id": "s097"
        }
      ]
    },
    {
      "id": "s098",
      "start": 5611,
      "end": 5657,
      "text": "حدَّثني المثنّى، قال: ثنا عمرُو بنُ عونٍ، قال:",
      "markers": []
    },
    {
      "id": "s099",
      "start": 5657,
      "end": 5708,
      "text": " حدثنا هُشيمٌ، عن جُويبرٍ، عن الضَّحَّاكِ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5658,
          "end": 5663,
          "span_id": "s099"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5672,
          "end": 5708,
          "stripped": "عن جويبر، عن الضحاك في قوله:",
          "span_id": "s099"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 5687,
          "end": 5697,
          "span_id": "s099"
        }
      ]
    },
    {
      "id": "s100",
      "start": 5708,
      "end": 5746,
      "text": " {لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5709,
          "end": 5745,
          "span_id": "s100"
        }
      ]
    },
    {
      "id": "s101",
      "start": 5746,
      "end": 5811,
      "text": " قال: السِّنَةُ الوَسْنةُ، وهو دونَ النومِ، والنومُ الاستِثْقالُ ",
      "markers": []
    },
    {
      "id": "s102",
      "start": 5916,
      "end": 5917,
      "text": ".",
      "markers": []
    },
    {
      "id": "s103",
      "start": 5921,
      "end": 5960,
      "text": "حدَّثني المثنَّى، قال: ثنا إسحاقُ، قال:",
      "markers": []
    },
    {
      "id": "s104",
      "start": 5960,
      "end": 6003,
      "text": " ثنا أبو زُهَيرٍ، عن جُويبرٍ، عن الضّحّاكِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5978,
          "end": 6003,
          "stripped": "عن جويبر، عن الضحاك:",
          "span_id": "s104"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 5993,
          "end": 6001,
          "span_id": "s104"
        }
      ]
    },
    {
      "id": "s105",
      "start": 6003,
      "end": 6084,
      "text": " {لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ}: السِّنَةُ النُّعاسُ، والنومُ الاستِثْقالُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6004,
          "end": 6040,
          "span_id": "s105"
        }
      ]
    },
    {
      "id": "s106",
      "start": 6190,
      "end": 6191,
      "text": ".",
      "markers": []
    },
    {
      "id": "s107",
      "start": 6195,
      "end": 6227,
      "text": "حدَّثني يحيى بنُ أبى طالبٍ، قال:",
      "markers": []
    },
    {
      "id": "s108",
      "start": 6227,
      "end": 6292,
      "text": " أخبَرَنا يزيدُ، قال: أخبَرَنا جُويبرٌ، عن الضَّحاكِ مثلَه سواءً.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6228,
          "end": 6236,
          "span_id": "s108"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 6228,
          "end": 6278,
          "stripped": "أخبرنا يزيد، قال: أخبرنا جويبر، عن الضحاك",
          "span_id": "s108"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6249,
          "end": 6257,
          "span_id": "s108"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 807,
      "end": 1030,
      "text": "¬أخرجه البخاري في الاستسقاء، باب قول النبي صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: نصرت بالصبا: 2/ 520، وفي بدء الخلق، والأنبياء، ومسلم في الاستسقاء، باب في ريح الصبا والدَّبُور برقم (900): 2/ 617، والمصنف في شرح السنة: 4/ 387.¥",
      "attached_span_id": "s010",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1263,
      "end": 1546,
      "text": "¬أخرجه أبو داود في الجهاد، باب في أي وقت يستحب اللقاء؟: 4/ 7، والترمذي في السير، باب ما جاء في الساعة التي يستحب فيها القتال: 5/ 238، وقال: حديث حسن صحيح، والحاكم: 2/ 116، وصححه على شرط مسلم، ووافقه الذهبي، والإمام أحمد في المسند: 5/ 444 - 445، وعزاه المنذري في مختصر السنن للنسائي.¥",
      "attached_span_id": "s012",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2554,
      "end": 2767,
      "text": "¬أخرجه البخاري في الجهاد، باب كان النبي صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إذا لم يقاتل أول النهار. . . 6/ 130، ومسلم في الجهاد والسير، باب كراهية تمني لقاء العدو (1742) 3/ 1362، والمصنف في شرح السنة: 11/ 38 - 39.¥",
      "attached_span_id": "s016",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    }
  ],

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1558,
      "end": 1993,
      "text": "¬أخرجه الطبري في التفسير: 13/ 467 بهذا اللفظ، وأخرجه بنحوه الترمذي في فضائل القرآن - باب ما جاء في فضل فاتحة الكتاب: 8/ 178 - 180 وقال: هذا حديث حسن صحيح. والإمام أحمد في المسند: 2/ 412 - 413، وأخرجه البخاري بغير هذا السياق في التفسير 8/ 156، وفي فضائل القرآن. وقال المنذري: رواه ابن خزيمة وابن حبان في صحيحيهما والحاكم باختصار عن أبي هريرة عن أُبي، وقال الحاكم: صحيح على شرط مسلم. انظر: الكافي الشاف ص (68 - 69) تحفة الأحوذي: 8/ 180.¥",
      "attached_span_id": "s014",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1995,
      "end": 2024,
      "text": "¬ما بين القوسين من نسخة \"ب\".¥",
      "attached_span_id": "s015",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3468,
      "end": 3761,
      "text": "¬أخرجه بهذا اللفظ: الإمام أحمد في المسند: 3/ 112، 257، والترمذي بزيادة \"كيف شاء\" في القدر، باب ما جاء أن القلوب بين أصبعين من أصابع الرحمن: 6/ 349، وأخرجه مسلم من رواية عبد الله بن عمرو، في القدر، باب تصريف الله تعالى القلوب كيف شاء برقم (2654): 4/ 2045. وذكره البغوي في مصابيح السنة: 1/ 141.¥",
      "attached_span_id": "s027",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    }

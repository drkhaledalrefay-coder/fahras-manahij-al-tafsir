  "spans": [
    {
      "start": 0,
      "end": 76,
      "text": "{لِيُحِقَّ الْحَقَّ وَيُبْطِلَ الْبَاطِلَ وَلَوْ كَرِهَ الْمُجْرِمُونَ (8)}\n",
      "id": "s001"
    },
    {
      "start": 76,
      "end": 192,
      "text": "{إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ (9)}\n",
      "id": "s002"
    },
    {
      "start": 192,
      "end": 268,
      "text": "{لِيُحِقَّ الْحَقَّ} لِيُثَبِّتَ الْإِسْلَامَ، {وَيُبْطِلَ الْبَاطِلَ} أَيْ:",
      "id": "s003"
    },
    {
      "start": 268,
      "end": 333,
      "text": " يُفْنِي الْكُفْرَ {وَلَوْ كَرِهَ الْمُجْرِمُونَ} الْمُشْرِكُونَ.",
      "id": "s004"
    },
    {
      "start": 333,
      "end": 436,
      "text": " وَكَانَتْ وَقْعَةُ بَدْرٍ يَوْمَ الْجُمُعَةِ صَبِيحَةَ سَبْعَ عَشْرَةَ لَيْلَةً مِنْ شَهْرِ رَمَضَانَ.",
      "id": "s005"
    }
  ]

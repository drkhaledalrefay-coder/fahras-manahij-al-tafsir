  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 829,
      "end": 875,
      "text": "¬بعده فى م: \"بن\". وينظر الجرح والتعديل 8/ 19.¥",
      "attached_span_id": "s009",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1253,
      "end": 1322,
      "text": "¬في ص، ت 1، ت 2، س، ف: \"أن النبي -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-\".¥",
      "attached_span_id": "s016",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1438,
      "end": 1600,
      "text": "¬عزاه السيوطي في الدر المنثور 3/ 178 إلى المصنف وابن المنذر وأبى الشيخ، وذكره ابن كثير في تفسيره 3/ 582 عن المصنف ثم قال: هذا حديث غريب جدا، وفي سنده وسياقه نظر.¥",
      "attached_span_id": "s018",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1647,
      "end": 1678,
      "text": "¬فى ص، ت 1، ت 2، س، ف: \"الذي\".¥",
      "attached_span_id": "s020",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2416,
      "end": 2430,
      "text": "¬في م: \"بها\".¥",
      "attached_span_id": "s033",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2494,
      "end": 2520,
      "text": "¬سيأتى تخريجه في 11/ 657.¥",
      "attached_span_id": "s035",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2827,
      "end": 2985,
      "text": "¬أخرجه سعيد بن منصور في سننه (987 - تفسير)، وابن أبي حاتم فى تفسيره 5/ 1684 من طريق سفيان به. وعزاه السيوطى فى الدر المنثور 3/ 178 إلى ابن المنذر وأبى الشيخ.¥",
      "attached_span_id": "s041",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3170,
      "end": 3244,
      "text": "¬فى ص، ف، م: \"عبد\". والمثبت من تفسير ابن كثير، وينظر الجرح والتعديل 8/ 1.¥",
      "attached_span_id": "s046",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3418,
      "end": 3606,
      "text": "¬ذكره ابن كثير في تفسيره 3/ 581 عن المصنف. ويونس بن الحارث ضعيف، ولو صح فالمراد أن ذلك نوع خيانة لله ورسوله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، فقتل عثمان رضي الله عنه كان بعد نزول القرآن.¥",
      "attached_span_id": "s049",
      "grading": [
        "ضعيف"
      ],

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 19071,
      "end": 19153,
      "text": "¬في ص: \"رحمة الله عليه\". وفي ت 1، ت 2، س، ف: \"رضى الله عنه\". وينظر مصادر التخريج.¥",
      "attached_span_id": "s228",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 19154,
      "end": 19542,
      "text": "¬أخرجه أبو عبيد في الأموال (39، 837، 847)، والحاكم 2/ 128، والبيهقي في السنن 6/ 338، 342 من طريق عبد الرحمن بن مهدى به، وأخرجه عبد الرزاق في مصنفه (9382)، وابن أبي شيبة 12/ 431، 471، 472، وابن زنجويه فى الأموال (75، 1247)، والنسائي (4154)، وابن أبي حاتم في تفسيره 5/ 1702، والطحاوى فى شرح معانى الآثار 3/ 234، 277 من طريق سفيان به، وعزاه السيوطى فى الدر المنثور 3/ 185 إلى أبى الشيخ<br>.¥",
      "attached_span_id": "s229",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 19709,
      "end": 19724,
      "text": "¬فى ف: \"عمرو\".¥",
      "attached_span_id": "s234",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 19962,
      "end": 20003,
      "text": "¬ذكره ابن كثير في تفسيره 4/ 6 عن المصنف.¥",
      "attached_span_id": "s238",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 20841,
      "end": 21098,
      "text": "¬تقدم في ص 191 دون قوله: \"فلما قبض. . .\" إلخ -وينظر الأثر السابق- ودون المرفوع منه. وقد أخرج المرفوع البخاري (3093، 3712، 4036، 5358، 6726، 6727، 7305) من حديث أبي بكر وعائشة وغيرهما. وأخرجه <br>مسلم [(1757/ 49، 50) 1758، 1759] من حديث عائشة ومالك ابن أوس.¥",
      "attached_span_id": "s246",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 21525,
      "end": 21539,
      "text": "¬فى م: \"ولي\".¥",
      "attached_span_id": "s251",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 22616,
      "end": 22664,
      "text": "¬ذكره ابن كثير في تفسيره 4/ 6 وعزاه إلى المصنف.¥",
      "attached_span_id": "s268",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 23584,
      "end": 23638,
      "text": "¬فى ص، ت 1، ت 2، س، ف: \"الضعيف\". وينظر مصادر التخريج.¥",
      "attached_span_id": "s276",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 23671,
      "end": 23697,
      "text": "¬تقدم أوله في ص 190، 191.¥",
      "attached_span_id": "s277",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 24622,
      "end": 24817,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره 5/ 1706 (9101)، والحاكم في المستدرك 3/ 23، والبيهقي في دلائل النبوة 3/ 120 من طريق أبي صالح به، وعزاه السيوطى فى الدر المنثور 3/ 187، 188 إلى أبي الشيخ وابن مردويه.¥",
      "attached_span_id": "s286",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 24917,
      "end": 24982,
      "text": "¬تفسير مجاهد ص 355، وذكره ابن أبي حاتم في تفسيره 5/ 1706 معلقًا.¥",
      "attached_span_id": "s289",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 25177,
      "end": 25198,
      "text": "¬سقط مِن: ت 2، س، ف.¥",
      "attached_span_id": "s293",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 25695,
      "end": 25720,
      "text": "¬مصنف عبد الرزاق (9726).¥",
      "attached_span_id": "s295",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 26062,
      "end": 26088,
      "text": "¬تفسير عبد الرزاق 1/ 259.¥",
      "attached_span_id": "s302",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 26278,
      "end": 26394,
      "text": "¬أخرجه ابن أبي حاتم فى تفسيره 5/ 1706 بهذا الإسناد، وعزاه السيوطى في الدر المنثور 3/ 187 إلى أبي الشيخ وابن مردويه.¥",
      "attached_span_id": "s308",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 26714,
      "end": 26825,
      "text": "¬ذكره ابن كثير في تفسيره 4/ 9 عن المصنف، وقال: إسناد جيد قوى، وعزاه السيوطى في الدر المنثور 3/ 188 إلى المصنف.¥",
      "attached_span_id": "s313",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 27141,
      "end": 27168,
      "text": "¬في سيرة ابن هشام: \"فرقت\".¥",
      "attached_span_id": "s320",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 27197,
      "end": 27215,
      "text": "¬في م: \"ببدر أي\".¥",
      "attached_span_id": "s321",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 27250,
      "end": 27273,
      "text": "¬سيرة ابن هشام 1/ 672.¥",
      "attached_span_id": "s322",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 27445,
      "end": 27516,
      "text": "¬ذكره ابن أبي حاتم فى تفسيره 5/ 1706 معلقًا، وابن كثير في تفسيره 4/ 9.¥",
      "attached_span_id": "s326",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    }

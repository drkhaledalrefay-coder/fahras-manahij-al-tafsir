  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 228,
      "end": 240,
      "text": "¬سقط من: ص.¥",
      "attached_span_id": "s002",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 254,
      "end": 282,
      "text": "¬سقط من: ص، ت 1، ت 2، س، ف.¥",
      "attached_span_id": "s003",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 702,
      "end": 772,
      "text": "¬في النسخ: \"أبو إدريس\". والصواب ما أثبتناه. وتقدم هذا الإسناد كثيرًا.¥",
      "attached_span_id": "s010",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1485,
      "end": 1763,
      "text": "¬أخرجه سعيد بن منصور في سننه (2448)، وأحمد 28/ 642 (17432)، ومسلم (1918)، وأبو داود (2514)، وابن ماجه (2813)، وأبو يعلى (1743)، وأبو عوانة (7488 - 7493)، وابن أبي حاتم في تفسيره 5/ 1722، وابن حبان (4709)، والطبراني 17/ 911 (16225)، والبيهقى 10/ 13 طريق أبى على ثمامة بن شفى به.¥",
      "attached_span_id": "s018",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2138,
      "end": 2174,
      "text": "¬أخرجه الترمذى (3083) من طريق وكيع.¥",
      "attached_span_id": "s023",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2515,
      "end": 2564,
      "text": "¬أخرجه سفيان الثورى في تفسيره ص 120 عن أسامة به.¥",
      "attached_span_id": "s027",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2843,
      "end": 3022,
      "text": "¬أخرجه إسحاق بن إبراهيم القراب في الرمي (11) من طريق موسى ابن عبيدة به، وينظر علل ابن أبي حاتم (1696)، وعزاه السيوطي في الدر المنثور 3/ 192 إلى ابن المنذر وأبى الشيخ وابن مردويه.¥",
      "attached_span_id": "s032",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3219,
      "end": 3394,
      "text": "¬تفسير سفيان ص 120، ومن طريقه البيهقى في الشعب (4307). وأخرجه ابن أبي شيبة 12/ 483، وابن أبي حاتم 5/ 1722 من طريق وكيع به، وعزاه السيوطي في الدر المنثور 3/ 192 إلى أبي الشيخ.¥",
      "attached_span_id": "s036",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3526,
      "end": 3626,
      "text": "¬الجوالق: وعاء كبير منسوج من صوف أو شعر. وهو الذي يسميه العامة \"شوال\". ينظر المعرب للجواليقي ص 158.¥",
      "attached_span_id": "s040",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3685,
      "end": 3741,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره 5/ 1722 عن علي بن سهل به.¥",
      "attached_span_id": "s041",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3894,
      "end": 3950,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره 5/ 1772 من طريق أسباط به.¥",
      "attached_span_id": "s045",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4208,
      "end": 4263,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره 5/ 1723 من طريق وكيع به.¥",
      "attached_span_id": "s050",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4597,
      "end": 4616,
      "text": "¬في م: \"يقرأ بها\".¥",
      "attached_span_id": "s057",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4630,
      "end": 4763,
      "text": "¬في النسخ: \"ترهبون\" وما أثبتناه هو الصواب، وقراءة (تخزون) قراءة شاذة لمخالفتها رسم المصحف، وينظر الكشاف 2/ 166 والبحر المحيط 4/ 512.¥",
      "attached_span_id": "s058",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5102,
      "end": 5130,
      "text": "¬سقط من: ص، ت 1، ت 2، س، ف.¥",
      "attached_span_id": "s065",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5152,
      "end": 5188,
      "text": "¬بعده في ص، ت 1، ت 2، س: \"وأرهبته\".¥",
      "attached_span_id": "s066",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5246,
      "end": 5260,
      "text": "¬ديوانه ص 96.¥",
      "attached_span_id": "s067",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5707,
      "end": 5892,
      "text": "¬تفسير مجاهد ص 357، ومن طريقه ابن أبي حاتم في تفسيره 5/ 1723، وابن الجوزي في نواسخ القرآن ص 348، وعزاه السيوطي في الدر المنثور 3/ 198 إلى الفريابي وابن أبي شيبة وابن المنذر وأبي الشيخ.¥",
      "attached_span_id": "s077",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6249,
      "end": 6314,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره 5/ 1724 من طريق أحمد بن المفضل به.¥",
      "attached_span_id": "s086",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6738,
      "end": 6801,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره 5/ 1720 من طريق أصبغ عن ابن زيد.¥",
      "attached_span_id": "s094",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7639,
      "end": 7661,
      "text": "¬بعده في ص، ف: \"كان\".¥",
      "attached_span_id": "s106",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7980,
      "end": 8124,
      "text": "¬أخرجه أحمد 28/ 642 (17432)، ومسلم (1918) وغيرهما من حديث عقبة بن عامر بهذا اللفظ، ولعل المصنف قصد الرواية الأخرى وهى: \"ألا إن الرمي هو القوة\".¥",
      "attached_span_id": "s109",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    }
  ],

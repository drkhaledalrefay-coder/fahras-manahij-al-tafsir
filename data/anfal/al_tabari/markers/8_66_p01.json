    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4467,
      "end": 4486,
      "text": "¬بعده في م: \"بعد\".¥",
      "attached_span_id": "s046",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4512,
      "end": 4580,
      "text": "¬زيادة يقتضيها السياق، وينظر تفسير الطبرى بتحقيق الشيخ شاكر 14/ 53.¥",
      "attached_span_id": "s048",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4606,
      "end": 4634,
      "text": "¬في ص، م، ت 1، س، ف: \"إذا\".¥",
      "attached_span_id": "s049",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5340,
      "end": 5358,
      "text": "¬في ت 2: \"يعجزك\".¥",

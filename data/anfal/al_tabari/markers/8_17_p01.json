      "marker": "editor_footnote",
      "start": 5692,
      "end": 5755,
      "text": "¬أخرجه ابن أبي حاتم فى تفسيره 5/ 1673 من طريق أصبغ عن ابن زيد.¥",
      "attached_span_id": "s071",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"

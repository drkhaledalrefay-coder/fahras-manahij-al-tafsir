  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 533,
      "end": 606,
      "text": "¬في م: \"خافوا\". وخام: نكص وجبن، وخام عن القتال: جبن عنه. اللسان (خ ى م).¥",
      "attached_span_id": "s003",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 743,
      "end": 814,
      "text": "¬فى ص: \"تجنيه\"، وفى م: \"تخفيه\". وفى ت 2: \"تحفظه\". وتجنه: تخفيه وتستره.¥",
      "attached_span_id": "s004",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1295,
      "end": 1337,
      "text": "¬في ص، ت 1، ت 2، س، ف: \"أراهم الله إياه\".¥",
      "attached_span_id": "s015",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1363,
      "end": 1387,
      "text": "¬فى ص، ت 1، ف: \"وأخبر\".¥",
      "attached_span_id": "s016",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1463,
      "end": 1637,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره 5/ 1709 من طريق محمد بن عبد الأعلى به، وأخرجه عبد الرزاق في تفسيره 1/ 259، 260 عن معمر به، وعزاه السيوطى فى الدر المنثور 3/ 188 إلى ابن المنذر.¥",
      "attached_span_id": "s017",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2033,
      "end": 2113,
      "text": "¬فى ص، ت 1، ت 2، س: \"كفها عنهم\"، وفى م: \"كفاهم بها\". والمثبت مِن سيرة ابن هشام.¥",
      "attached_span_id": "s025",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2160,
      "end": 2183,
      "text": "¬سيرة ابن هشام 1/ 673.¥",
      "attached_span_id": "s026",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2542,
      "end": 2599,
      "text": "¬أخرجه ابن أبي حاتم فى تفسيره 5/ 1709 عن محمد بن سعد به.¥",
      "attached_span_id": "s035",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {

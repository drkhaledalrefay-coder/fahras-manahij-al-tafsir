    "verse_refs": {
      "[الروم: 24]": 1,
      "[المعنى.<br>والوجهُ الثاني: على أنه أراد إضْمارَ منصوبٍ بـ \"يحسب\" كأنه قال: ولا يَحْسَبُ الذين كفَروا أنهم سبَقوا. ثم حذَف \"أنهم\" ¬في م، ت 1، ت 2، س، ف: \"الهمز\"، والصواب ما أثبتناه، وينظر تفسير الطبري بتحقيق الشيخ شاكر.¥ وأضْمَرَ.<br>وقد وجَّه بعضُهم معنى قوله: {إِنَّمَا ذَلِكُمُ الشَّيْطَانُ يُخَوِّفُ أَوْلِيَاءَهُ} [آل عمران: 175]": 1
    },
    "other_brackets": {
      "[ففاتونا، إنهم لا يُعْجِزوننا أي: يَفُوتوننا بأنفسِهم، ولا يَقْدِرون على الهربِ منا.<br>كما حدَّثني محمدُ بنُ الحسينِ، قال: ثنا أحمدُ بنُ المفضلِ، قال: ثنا أسْباطُ، عن السديِّ: (وَلَا تَحْسَبَن الَّذِينَ كَفَرُوا سَبَقُوا إنهُمْ لا يُعْجِزُون). يقولُ: لا يَفُوتون ¬أخرجه ابن أبي حاتم في تفسيره 5/ 1721 من طريق أسباط به.¥.<br>⟪UNCLOSED⟫": 1
    }
  }

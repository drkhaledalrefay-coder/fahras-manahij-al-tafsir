      "id": "s038",
      "start": 1910,
      "end": 1963,
      "text": "حدَّثنا ابنُ حميدٍ، قال: ثنا سَلَمةُ، عن ابنِ إسحاقَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1910,
          "end": 1917,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 1963,
      "end": 2065,
      "text": " {يَاأَيُّهَا الَّذِينَ آمَنُوا اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1964,
          "end": 2064,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 2065,
      "end": 2184,
      "text": " أى: للحربِ الذى أعزَّكم اللهُ بها بعدَ الذُّلِّ، وقوَّاكم بعدَ الضَّعْفِ، ومنعَكم بها من عدوِّكم بعدَ القهرِ منهم لكم ",
      "markers": []
    },
    {
      "id": "s041",
      "start": 2470,
      "end": 2471,
      "text": ".",
      "markers": []
    },
    {
      "id": "s042",
      "start": 2475,
      "end": 2517,
      "text": "وأولى الأقوال في ذلك بالصوابِ قولُ من قال:",
      "markers": []
    },
    {
      "id": "s043",
      "start": 2517,
      "end": 2598,
      "text": " معناه: استجِيبوا للهِ وللرسولِ بالطاعةِ إذا دعاكم الرسولُ لما يُحييكم من الحقِّ.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 2518,
          "end": 2523,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 2598,
      "end": 2658,
      "text": " وذلك أن ذلك إذا كان معناه، كان داخلًا فيه الأمرُ بإجابتِهم ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 2619,
          "end": 2624,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 2692,
      "end": 2819,
      "text": " لقتالِ العدوِّ والجهادِ، والإجابةِ إذا دعاكم إلى حكمِ القرآنِ، وفى الإجابةِ إلى كلِّ ذلك حياةُ المجيبِ. أما في الدنيا، فيقالُ ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 2813,
          "end": 2817,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 2875,
      "end": 2905,
      "text": ": الذكرُ الجميلُ. وذلك له فيه ",
      "markers": []
    },
    {
      "id": "s047",
      "start": 2936,
      "end": 3001,
      "text": " حياةٌ. وأما في الآخرةِ، فحياةُ الأبدِ فى الجِنانِ والخلودُ فيها.",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3005,
      "end": 3029,
      "text": "وأما قولُ من قال: معناه:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 3023,
          "end": 3028,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3029,
      "end": 3057,
      "text": " الإسلامُ. فقولٌ لا معنى له؛",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3057,
      "end": 3095,
      "text": " لأن اللهَ قد وصفَهم بالإيمانِ بقولِه:",
      "markers": []
    },
    {
      "id": "s051",
      "start": 3095,
      "end": 3163,
      "text": " {يَاأَيُّهَا الَّذِينَ آمَنُوا اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3096,
          "end": 3162,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 3163,
      "end": 3191,
      "text": " فلا وجهَ لأن يقالَ للمؤمنِ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 3177,
          "end": 3181,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 3191,
      "end": 3225,
      "text": " اسْتَجِبْ للهِ وللرسولِ إذا دعاك ",
      "markers": []
    },
    {
      "id": "s054",
      "start": 3252,
      "end": 3276,
      "text": " إلى الإسلامِ والإيمانِ.",
      "markers": []
    },
    {
      "id": "s055",
      "start": 3280,
      "end": 3336,
      "text": "وبعدُ، ففيما حدَّثنا أحمدُ بنُ المقدامِ العِجْليُّ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3293,
          "end": 3300,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 3336,
      "end": 3363,
      "text": " ثنا يزيدُ بنُ زُريعٍ، قال:",
      "markers": []
    },
    {
      "id": "s057",
      "start": 3363,
      "end": 3445,
      "text": " ثنا رَوْحُ بنُ القاسمِ، عن العلاءِ بنِ عبدِ الرحمنِ، عن أبيه، عن أبى هريرةَ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3388,
          "end": 3440,
          "stripped": "عن العلاء بن عبد الرحمن، عن أبيه، عن أبى هريرة،",
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 3445,
      "end": 3528,
      "text": " خرَج رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- على أُبَيٍّ وهو يُصلِّى، فدعاه:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "خرج رسول الله",
          "start": 3446,
          "end": 3461,
          "span_id": "s058"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3464,
          "end": 3494,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 3528,
      "end": 3667,
      "text": " \"أى أُبَيُّ\". فالتفت إليه أُبَيٌّ ولم يُجِبْه، ثم إن أُبيًّا خفَّف الصلاةَ، ثم انصرَف إلى النبيِّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3628,
          "end": 3658,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 3667,
      "end": 3699,
      "text": " السلامُ عليك، أَيْ رسولَ اللهِ.",
      "markers": []
    },
    {
      "id": "s061",
      "start": 3699,
      "end": 3745,
      "text": " قال: \"وعليك، ما منَعك إذْ دعوتُك أن تُجيبَنى؟",
      "markers": []
    },
    {
      "id": "s062",
      "start": 3745,
      "end": 3782,
      "text": " \" قال: يا رسولَ اللهِ، كنتُ أُصلِّى.",
      "markers": []
    },
    {
      "id": "s063",
      "start": 3782,
      "end": 3824,
      "text": " قال: \"أفلم تجِدْ فيما أُوحِيَ إِليَّ أَن ",
      "markers": []
    },
    {
      "id": "s064",
      "start": 3836,
      "end": 3908,
      "text": " {اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ}؟",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3837,
          "end": 3907,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 3908,
      "end": 3946,
      "text": " \". قال: بلى يا رسولَ اللهِ، لا أعودُ ",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4069,
      "end": 4070,
      "text": ".",
      "markers": []
    },
    {
      "id": "s067",
      "start": 4074,
      "end": 4182,
      "text": "حدَّثنا أبو كُريبٍ، قال: ثنا خالدُ بنُ مَخْلدٍ، عن محمدِ بنِ جعفرٍ، عن العلاءِ، عن أبيه، عن أبى هريرةَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4074,
          "end": 4081,
          "span_id": "s067"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4122,
          "end": 4165,
          "stripped": "عن محمد بن جعفر، عن العلاء، عن أبيه، عن",
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 4182,
      "end": 4273,
      "text": " مرَّ رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- على أُبَيٍّ وهو قائمٌ يصلِّى، فصرَخ به ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4201,
          "end": 4231,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 4299,
      "end": 4300,
      "text": " ",
      "markers": []
    },
    {
      "id": "s070",
      "start": 4330,
      "end": 4394,
      "text": ": \"يا أُبَيُّ، ما منَعك أن تُجيبَنى إذ دعوتُك، أليس اللهُ يقولُ:",
      "markers": []
    },
    {
      "id": "s071",
      "start": 4394,
      "end": 4498,
      "text": " {يَاأَيُّهَا الَّذِينَ آمَنُوا اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ} \"؟",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4395,
          "end": 4495,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 4498,
      "end": 4575,
      "text": " قال أُبَيٌّ: لا جَرَمَ يا رسولَ اللهِ، لا تدعونى إلَّا أجبتُ وإن كنتُ أُصلى ",
      "markers": []
    },
    {
      "id": "s073",
      "start": 4864,
      "end": 4865,
      "text": ".",
      "markers": []
    },
    {
      "id": "s074",
      "start": 4869,
      "end": 4872,
      "text": "ما ",
      "markers": []
    },
    {
      "id": "s075",
      "start": 4957,
      "end": 4972,
      "text": " يُبِينُ عن أن ",
      "markers": []
    },
    {
      "id": "s076",
      "start": 5000,
      "end": 5110,
      "text": " المَعنيَّ بالآيةِ هم الذين يدعوهم رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- إلى ما فيه حياتُهم بإجابتِهم ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5048,
          "end": 5078,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 5144,
      "end": 5174,
      "text": " إليه من الحقِّ بعدَ إسلامِهم ",
      "markers": []
    },
    {
      "id": "s078",
      "start": 5204,
      "end": 5221,
      "text": "؛ لأن أبيًّا كان ",
      "markers": []
    },
    {
      "id": "s079",
      "start": 5233,
      "end": 5347,
      "text": " لا شكَّ أنه كان مسلمًا في الوقتِ الذى قال له النبيُّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- ما ذكَرنا في هذين الخبرين.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5288,
          "end": 5318,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 5351,
      "end": 5475,
      "text": "القولُ في تأويلِ قولِه: {وَاعْلَمُوا أَنَّ اللَّهَ يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ وَأَنَّهُ إِلَيْهِ تُحْشَرُونَ (24)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5375,
          "end": 5474,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 5479,
      "end": 5512,
      "text": "اختلف أهلُ التأويلِ في تأويل ذلك؛",
      "markers": []
    },
    {
      "id": "s082",
      "start": 5512,
      "end": 5585,
      "text": " فقال بعضُهم: معناه: يحولُ بينَ الكافرِ والإيمانِ، وبينَ المؤمنِ والكفرِ.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 5526,
          "end": 5531,
          "span_id": "s082"
        }
      ]
    },
    {
      "id": "s083",
      "start": 5589,
      "end": 5604,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s084",
      "start": 5608,
      "end": 5637,
      "text": "حدَّثنا محمدُ بنُ بشارٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5608,
          "end": 5615,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 5637,
      "end": 5663,
      "text": " ثنا محمدُ بنُ جعفرٍ، قال:",
      "markers": []
    },
    {
      "id": "s086",
      "start": 5663,
      "end": 5769,
      "text": " ثنا عبدُ الرحمنِ، قال: ثنا سفيانُ، عن الأعمشِ، عن عبدِ اللهِ بنِ عبدِ اللهِ الرازيِّ، عن سعيدِ بنِ جبيرٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5699,
          "end": 5732,
          "stripped": "عن الأعمش، عن عبد الله بن عبد",
          "span_id": "s086"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 5753,
          "end": 5767,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 5769,
      "end": 5813,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5770,
          "end": 5807,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 5813,
      "end": 5861,
      "text": " بينَ الكافرِ أن يؤمنَ، وبينَ المؤمنِ أن يكفُرَ ",
      "markers": []
    },
    {
      "id": "s089",
      "start": 5918,
      "end": 5919,
      "text": ".",
      "markers": []
    },
    {
      "id": "s090",
      "start": 5923,
      "end": 5984,
      "text": "حدَّثنا ابنُ بشارٍ، قال: ثنا وكيعٌ، وحدَّثنا ابنُ وكيعٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5923,
          "end": 5930,
          "span_id": "s090"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5960,
          "end": 5967,
          "span_id": "s090"
        }
      ]
    },
    {
      "id": "s091",
      "start": 5984,
      "end": 6048,
      "text": " ثنا أبو أحمدَ، قالا: ثنا سفيانُ، وحدَّثنا الحسنُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6019,
          "end": 6026,
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 6048,
      "end": 6165,
      "text": " أخبَرنا عبدُ الرزاق، قال: ثنا الثوريُّ، عن الأعمشِ، عن عبدِ اللهِ بنِ عبدِ الله الرازيِّ، عن سعيدِ بنِ جبيرٍ بنحوِه ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6049,
          "end": 6056,
          "span_id": "s092"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6089,
          "end": 6122,
          "stripped": "عن الأعمش، عن عبد الله بن عبد",
          "span_id": "s092"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "NARRATOR",
          "start": 6142,
          "end": 6156,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 6216,
      "end": 6217,
      "text": ".",
      "markers": []
    },
    {
      "id": "s094",
      "start": 6221,
      "end": 6266,
      "text": "حدَّثني أبو زائدةَ زكريا بنُ أبي زائدةَ، قال:",
      "markers": []
    },
    {
      "id": "s095",
      "start": 6266,
      "end": 6365,
      "text": " ثنا أبو عاصمٍ، عن سفيانَ، عن الأعمشِ، عن عبدِ اللهِ بنِ عبدِ عبدِ اللهِ، عن سعيدِ بنِ جبيرٍ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6282,
          "end": 6326,
          "stripped": "عن سفيان، عن الأعمش، عن عبد الله بن عبد",
          "span_id": "s095"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "NARRATOR",
          "start": 6343,
          "end": 6357,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 6369,
      "end": 6407,
      "text": "حدَّثني أبو السائبِ وابنُ وكيعٍ، قالا:",
      "markers": []
    },
    {
      "id": "s097",
      "start": 6407,
      "end": 6459,
      "text": " ثنا أبو معاويةَ، عن المِنْهالِ، عن سعيدِ بنِ جبيرٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6425,
          "end": 6459,
          "stripped": "عن المنهال، عن سعيد بن جبير:",
          "span_id": "s097"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 6443,
          "end": 6457,
          "span_id": "s097"
        }
      ]
    },
    {
      "id": "s098",
      "start": 6459,
      "end": 6503,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6460,
          "end": 6497,
          "span_id": "s098"
        }
      ]
    },
    {
      "id": "s099",
      "start": 6503,
      "end": 6565,
      "text": " يحولُ بينَ المؤمنِ وبينَ الكفرِ، وبينَ الكافر وبينَ الإيمانِ.",
      "markers": []
    },
    {
      "id": "s100",
      "start": 6569,
      "end": 6701,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا محمدُ بنُ فُضيلٍ، عن الأعمشِ، عن عبدِ اللهِ بنِ عبدِ اللهِ الرازيِّ، عن سعيدِ بنِ جبيرٍ، عن ابنِ عباسٍ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6569,
          "end": 6576,
          "span_id": "s100"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6616,
          "end": 6649,
          "stripped": "عن الأعمش، عن عبد الله بن عبد",
          "span_id": "s100"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6667,
          "end": 6701,
          "stripped": "عن سعيد بن جبير، عن ابن عباس:",
          "span_id": "s100"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "NARRATOR",
          "start": 6670,
          "end": 6684,
          "span_id": "s100"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6690,
          "end": 6699,
          "span_id": "s100"
        }
      ]
    },
    {
      "id": "s101",
      "start": 6701,
      "end": 6783,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}: يحولُ بيَن الكافرِ والإيمانِ وطاعةِ اللهِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6702,
          "end": 6739,
          "span_id": "s101"
        }
      ]
    },
    {
      "id": "s102",
      "start": 7004,
      "end": 7065,
      "text": "قال: ثنا حفصٌ، عن الأعمشِ، عن سعيدِ بنِ جبيرٍ، عن ابنِ عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7019,
          "end": 7053,
          "stripped": "عن الأعمش، عن سعيد بن جبير، عن",
          "span_id": "s102"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "NARRATOR",
          "start": 7034,
          "end": 7048,
          "span_id": "s102"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 7054,
          "end": 7063,
          "span_id": "s102"
        }
      ]
    },
    {
      "id": "s103",
      "start": 7065,
      "end": 7109,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7066,
          "end": 7103,
          "span_id": "s103"
        }
      ]
    },
    {
      "id": "s104",
      "start": 7109,
      "end": 7162,
      "text": " يحولُ بينِ المؤمنِ والكفرِ، وبينَ الكافرِ والإيمانِ ",
      "markers": []
    },
    {
      "id": "s105",
      "start": 7202,
      "end": 7203,
      "text": ".",
      "markers": []
    },
    {
      "id": "s106",
      "start": 7207,
      "end": 7257,
      "text": "حدَّثنا ابنُ حُميدٍ، قال: ثنا يحيى بنُ واضحٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7207,
          "end": 7214,
          "span_id": "s106"
        }
      ]
    },
    {
      "id": "s107",
      "start": 7257,
      "end": 7334,
      "text": " ثنا عُبيدُ بنُ سليمانَ وعبدُ العزيزِ بنُ أبي روَّادٍ، عن الضحَّاكِ فى قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "NARRATOR",
          "start": 7315,
          "end": 7323,
          "span_id": "s107"
        }
      ]
    },
    {
      "id": "s108",
      "start": 7334,
      "end": 7378,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7335,
          "end": 7372,
          "span_id": "s108"
        }
      ]
    },
    {
      "id": "s109",
      "start": 7378,
      "end": 7430,
      "text": " يحولُ بينَ الكافرِ وطاعتِه، وبينَ المؤمنِ ومعصيتِه ",
      "markers": []
    },
    {
      "id": "s110",

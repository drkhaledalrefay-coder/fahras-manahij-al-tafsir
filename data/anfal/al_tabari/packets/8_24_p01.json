    },
    {
      "id": "s005",
      "start": 306,
      "end": 321,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s006",
      "start": 325,
      "end": 356,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s007",
      "start": 356,
      "end": 384,
      "text": " ثنا أحمدُ بنُ مفضَّلٍ، قال:",
      "markers": []
    },
    {
      "id": "s008",
      "start": 384,
      "end": 544,
      "text": " ثنا أسباطُ، عن السُّدِّيِّ: {يَاأَيُّهَا الَّذِينَ آمَنُوا اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ}. قال: أمَّا {يُحْيِيكُمْ} فهو ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",

    {
      "id": "s001",
      "start": 4,
      "end": 129,
      "text": "القولُ في تأويلِ قولِه: {يَاأَيُّهَا الَّذِينَ آمَنُوا اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28,
          "end": 128,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 133,
      "end": 165,
      "text": "اخْتَلف أهلُ التأويلِ في تأويلِ ",
      "markers": []
    },
    {
      "id": "s003",
      "start": 192,
      "end": 236,
      "text": " قولِه: {إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ}؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 200,
          "end": 235,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 236,
      "end": 302,
      "text": " فقال بعضُهم: معناه: اسْتَجِيبوا للهِ وللرسولِ إذا دعاكم للإيمانِ.",
      "markers": [
        {
          "family": "LUGHA",

          "end": 2192,
          "stripped": "عن ابن أبي نجيح، عن مجاهد نحوه.",
          "span_id": "s032"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 2179,
          "end": 2184,
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 2196,
      "end": 2231,
      "text": "حدَّثنا محمدُ بنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2196,
          "end": 2203,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 2231,
      "end": 2277,
      "text": " ثنا محمدُ بنُ ثورٍ، عن معمرٍ، عن الزُّهْريِّ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2252,
          "end": 2277,
          "stripped": "عن معمر، عن الزهري:",
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2277,
      "end": 2327,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2278,
          "end": 2326,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 2327,
      "end": 2363,
      "text": " قال: استفتح أبو جهلٍ، قال: اللهمَّ ",
      "markers": []
    },
    {
      "id": "s037",
      "start": 2391,
      "end": 2392,
      "text": " ",
      "markers": []
    },
    {
      "id": "s038",
      "start": 2468,
      "end": 2484,
      "text": " - كان أفجرَ بك ",
      "markers": []
    },
    {
      "id": "s039",
      "start": 2550,
      "end": 2585,
      "text": "، اللهمَّ وأقطعَ للرحمِ، فَأَحِنْه ",
      "markers": []
    },
    {
      "id": "s040",
      "start": 2652,
      "end": 2721,
      "text": " اليومَ. قال اللهُ: {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2672,
          "end": 2720,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 2725,
      "end": 2754,
      "text": "حدَّثنا الحسنُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2725,
          "end": 2732,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 2754,
      "end": 2821,
      "text": " أخبَرنا عبدُ الرزاقِ، قال: أخبَرنا معمرٌ، عن الزُّهْريِّ فى قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2755,
          "end": 2762,
          "span_id": "s042"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 2755,
          "end": 2809,
          "stripped": "أخبرنا عبد الرزاق، قال: أخبرنا معمر، عن الزهري",
          "span_id": "s042"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2782,
          "end": 2789,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 2821,
      "end": 2871,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2822,
          "end": 2870,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 2871,
      "end": 2909,
      "text": " قال: استفتح أبو جهلِ بنُ هشامٍ، فقال:",
      "markers": []
    },
    {
      "id": "s045",
      "start": 2909,
      "end": 2969,
      "text": " اللهمَّ أيُّنا كان أفجرَ لك وأقطعَ للرحمِ، فأَحِنْه اليومَ.",
      "markers": []
    },
    {
      "id": "s046",
      "start": 2969,
      "end": 3011,
      "text": " يعنى محمدًا عليه الصلاةُ والسلامُ ونفسَه.",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3011,
      "end": 3081,
      "text": " قال اللهُ عز وجلَّ: {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3032,
          "end": 3080,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3081,
      "end": 3124,
      "text": " فضرَبه ابنا عَفْراء؛ عوفٌ ومعوَّذٌ، وأجاز ",
      "markers": []
    },
    {
      "id": "s049",
      "start": 3164,
      "end": 3182,
      "text": " عليه ابنُ مسعودٍ ",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3234,
      "end": 3235,
      "text": ".",
      "markers": []
    },
    {
      "id": "s051",
      "start": 3239,
      "end": 3279,
      "text": "حدَّثني المثنى، قال: ثنا أبو صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s052",
      "start": 3279,
      "end": 3329,
      "text": " ثني الليثُ، قال: ثني عُقيلٌ، عن ابنِ شِهابٍ، قال:",
      "markers": []
    },
    {
      "id": "s053",
      "start": 3329,
      "end": 3481,
      "text": " أخبَرنى عبدُ اللهِ بنُ ثَعْلبةَ بنِ صُعيرٍ العدويُّ حليفُ بني زُهْرةَ، أن المستفتِحَ يومَئذ أبو جهلٍ، وأنه قال حينَ التقى القومُ: أيُّنا أقطعُ للرحمِ، ",
      "markers": []
    },
    {
      "id": "s054",
      "start": 3504,
      "end": 3505,
      "text": " ",
      "markers": []
    },
    {
      "id": "s055",
      "start": 3533,
      "end": 3595,
      "text": "، فَأَحِنْه الغداةَ، فكان ذلك استفتاحَه، فأَنْزل اللهُ في ذلك:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 3574,
          "end": 3581,
          "span_id": "s055"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 3574,
          "end": 3586,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 3595,
      "end": 3651,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ} الآية ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3596,
          "end": 3644,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 3707,
      "end": 3708,
      "text": ".",
      "markers": []
    },
    {
      "id": "s058",
      "start": 3712,
      "end": 3746,
      "text": "حدَّثنا بشرٌ، قال: ثنا يزيدُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3712,
          "end": 3719,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 3746,
      "end": 3774,
      "text": " ثنا سعيدٌ، عن قتادةَ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 3761,
          "end": 3766,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 3774,
      "end": 3830,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3775,
          "end": 3823,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 3830,
      "end": 3875,
      "text": " يقولُ: قد كانت بدرٌ قضاءً وعِبرةً لمن اعتبر.",
      "markers": []
    },
    {
      "id": "s062",
      "start": 3879,
      "end": 3910,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s063",
      "start": 3910,
      "end": 3938,
      "text": " ثنا أحمدُ بنُ مفضَّلٍ، قال:",
      "markers": []
    },
    {
      "id": "s064",
      "start": 3938,
      "end": 3971,
      "text": " ثنا أسباطُ، عن السُّدِّيِّ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 3954,
          "end": 3963,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 3971,
      "end": 4100,
      "text": " كان المشركون حينَ خرَجوا إلى النبيِّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- من مكةَ، أخَذوا بأستارِ الكعبةِ، واستنصروا اللهَ، وقالوا:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4010,
          "end": 4040,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 4100,
      "end": 4174,
      "text": " اللهمَّ انصرْ أعزَّ الجندين، وأكرمَ الفئتين، وخيرَ القبيلتين، فقال اللهُ:",
      "markers": []
    },
    {
      "id": "s067",
      "start": 4174,
      "end": 4224,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4175,
          "end": 4223,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 4224,
      "end": 4294,
      "text": " يقولُ: قد نصرتُ ما قلتم، وهو محمدٌ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- ",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 4244,
          "end": 4247,
          "span_id": "s068"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4261,
          "end": 4291,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 4343,
      "end": 4344,
      "text": ".",
      "markers": []
    },
    {
      "id": "s070",
      "start": 4348,
      "end": 4384,
      "text": "حُدِّثتُ عن الحسينِ بنِ الفرجِ، قال:",
      "markers": []
    },
    {
      "id": "s071",
      "start": 4384,
      "end": 4436,
      "text": " سمِعت أبا معاذٍ يقولُ: ثنا عُبيدُ بنُ سليمانَ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 4395,
          "end": 4399,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 4436,
      "end": 4468,
      "text": " سمِعت الضحَّاكَ يقولُ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 4443,
          "end": 4451,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 4468,
      "end": 4528,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ} إلى قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4469,
          "end": 4517,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 4528,
      "end": 4625,
      "text": " {وَأَنَّ اللَّهَ مَعَ الْمُؤْمِنِينَ}. وذلك حينَ خرَج المشركون ينظرون عِيرَهم، وإن أهلَ العِيرِ؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4529,
          "end": 4566,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 4625,
      "end": 4701,
      "text": " أبا سفيانَ وأصحابَه أَرْسَلوا إلى المشركين بمكةَ يستنصرونهم، فقال أبو جهلٍ:",
      "markers": []
    },
    {
      "id": "s076",
      "start": 4701,
      "end": 4783,
      "text": " أيُّنا كان خيرًا عندَك فانصره، وهو قولُه: {إِنْ تَسْتَفْتِحُوا}. يقولُ: تستنصروا.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4744,
          "end": 4765,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 4787,
      "end": 4829,
      "text": "حدَّثني يونسُ، قال: أخبرنا ابنُ وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4807,
          "end": 4813,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 4829,
      "end": 4853,
      "text": " قال ابنُ زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 4834,
          "end": 4842,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 4853,
      "end": 4903,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4854,
          "end": 4902,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 4903,
      "end": 4955,
      "text": " قال: إن تستفتحوا العذابَ، فعُذِّبوا يومَ بدرٍ، قال:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4940,
          "end": 4948,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 4955,
      "end": 5123,
      "text": " وكان استفتاحُهم بمكةَ، قالوا: {اللَّهُمَّ إِنْ كَانَ هَذَا هُوَ الْحَقَّ مِنْ عِنْدِكَ فَأَمْطِرْ عَلَيْنَا حِجَارَةً مِنَ السَّمَاءِ أَوِ ائْتِنَا بِعَذَابٍ أَلِيمٍ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4986,
          "end": 5122,
          "span_id": "s081"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 5123,
          "end": 5136,
          "text": "[الأنفال: 32]",
          "via": "apparatus",
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 5136,
      "end": 5137,
      "text": ".",
      "markers": []
    },
    {
      "id": "s083",
      "start": 5141,
      "end": 5182,
      "text": "قال: فجاءهم العذابُ يومَ بدرٍ، وأَخْبرهم ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 5161,
          "end": 5169,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 5197,
      "end": 5201,
      "text": " عن ",
      "markers": []
    },
    {
      "id": "s085",
      "start": 5215,
      "end": 5349,
      "text": " يومِ أحدٍ: {وَإِنْ تَعُودُوا نَعُدْ وَلَنْ تُغْنِيَ عَنْكُمْ فِئَتُكُمْ شَيْئًا وَلَوْ كَثُرَتْ وَأَنَّ اللَّهَ مَعَ الْمُؤْمِنِينَ} ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم أحد",
          "start": 5216,
          "end": 5224,
          "span_id": "s085"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5227,
          "end": 5348,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 5382,
      "end": 5383,
      "text": ".",
      "markers": []
    },
    {
      "id": "s087",
      "start": 5387,
      "end": 5455,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا ابنُ فُضيلٍ، عن مطرِّفٍ، عن عطيةَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5387,
          "end": 5394,
          "span_id": "s087"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5429,
          "end": 5455,
          "stripped": "عن مطرف، عن عطية، قال:",
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 5455,
      "end": 5479,
      "text": " قال أبو جهلٍ يومَ بدرٍ:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 5469,
          "end": 5477,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 5479,
      "end": 5538,
      "text": " اللهمَّ انصُرْ أهدى الفئتين، وخيرَ الفئتين وأفضلَ، فنزلَت:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 5531,
          "end": 5537,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 5538,
      "end": 5588,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5539,
          "end": 5587,
          "span_id": "s090"
        }
      ]
    },
    {
      "id": "s091",
      "start": 5710,
      "end": 5711,
      "text": ".",
      "markers": []
    },
    {
      "id": "s092",
      "start": 5715,
      "end": 5804,
      "text": "قال: ثنا عبد الأعلى، عن معمرٍ، عن الزّهْريِّ، أن أبا جهلٍ هو الذي استفتح يومَ بدرٍ، وقال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5736,
          "end": 5771,
          "stripped": "عن معمر، عن الزهري، أن أبا جهل",
          "span_id": "s092"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 5788,
          "end": 5796,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 5804,
      "end": 5878,
      "text": " اللهمَّ أيُّنا كان أفجرَ وأقطعَ لرحمِه، فَأَحِنْه اليومَ، فَأَنْزل اللهُ:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 5863,
          "end": 5871,
          "span_id": "s093"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 5863,
          "end": 5876,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 5878,
      "end": 5928,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5879,
          "end": 5927,
          "span_id": "s094"
        }
      ]
    },
    {
      "id": "s095",
      "start": 5974,
      "end": 5975,
      "text": ".",
      "markers": []
    },
    {
      "id": "s096",
      "start": 5979,
      "end": 6101,
      "text": "قال: ثنا يزيدُ بنُ هارونَ، عن ابن إسحاقَ، عن الزُّهْريِّ، عن عبدِ اللهِ بنِ ثعلبةَ بنِ صُعَيرٍ، أن أبا جهلٍ قال يومَ بدرٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6006,
          "end": 6060,
          "stripped": "عن ابن إسحاق، عن الزهري، عن عبد الله بن ثعلبة",
          "span_id": "s096"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 6091,
          "end": 6099,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 6101,
      "end": 6165,
      "text": " اللهمَّ أقطعُنا لرحمِه، وآتانا بما لا نعرِفُ، فأَحِنْه الغداةَ ",
      "markers": []
    },
    {
      "id": "s098",
      "start": 6198,
      "end": 6231,
      "text": ". وكان ذلك استفتاحًا منه، فنزَلت:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 6224,
          "end": 6230,
          "span_id": "s098"
        }
      ]
    },
    {
      "id": "s099",
      "start": 6231,
      "end": 6287,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ} الآية ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6232,
          "end": 6280,
          "span_id": "s099"
        }
      ]
    },
    {
      "id": "s100",
      "start": 6546,
      "end": 6547,
      "text": ".",
      "markers": []
    },
    {
      "id": "s101",
      "start": 6551,
      "end": 6677,
      "text": "قال: ثنا يحيى بنُ آدمَ، عن إبراهيمَ بنِ سعدٍ، عن صالحِ بنِ كَيْسانَ، عن الزُّهْريِّ، عن عبدِ اللهِ بن ثعلبةَ بنِ صُعَيرٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6575,
          "end": 6622,
          "stripped": "عن إبراهيم بن سعد، عن صالح بن كيسان، عن",
          "span_id": "s101"
        }
      ]
    },
    {
      "id": "s102",
      "start": 6677,
      "end": 6707,
      "text": " كان المستفتِحَ يومَ بدرٍ أبو ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 6693,
          "end": 6701,
          "span_id": "s102"
        }
      ]
    },
    {
      "id": "s103",
      "start": 6721,
      "end": 6815,
      "text": " جهلٍ، قال: اللهمَّ أقطعُنا للرحمِ، وآتانا بما لا نعرِفُ، فَأَحِنْه الغداةَ، فَأَنْزَلَ اللهُ:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 6798,
          "end": 6807,
          "span_id": "s103"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 6798,
          "end": 6813,
          "span_id": "s103"
        }
      ]
    },
    {
      "id": "s104",
      "start": 6815,
      "end": 6865,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ} ",
      "markers": [

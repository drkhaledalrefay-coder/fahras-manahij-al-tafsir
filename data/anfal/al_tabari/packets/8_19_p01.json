    {
      "id": "s001",
      "start": 4,
      "end": 241,
      "text": "القولُ في تأويلِ قولِه: {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ وَإِنْ تَنْتَهُوا فَهُوَ خَيْرٌ لَكُمْ وَإِنْ تَعُودُوا نَعُدْ وَلَنْ تُغْنِيَ عَنْكُمْ فِئَتُكُمْ شَيْئًا وَلَوْ كَثُرَتْ وَأَنَّ اللَّهَ مَعَ الْمُؤْمِنِينَ (19)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28,
          "end": 240,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 245,
      "end": 337,
      "text": "يقولُ تعالى ذكرُه للمشركين الذين حاربوا رسولَ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- ببدرٍ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 298,
          "end": 328,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 337,
      "end": 387,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 338,
          "end": 386,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 387,
      "end": 548,
      "text": " يعنى: إن تَسْتَحكموا اللهَ على أقطعِ الحزبين للرحم وأظلمِ الفئتين، وتَسْتَنصروه عليه، فقد جاءَكم حكمُ اللهِ ونصرُه المظلومَ على الظالمِ، والمحقَّ على المُبْطلِ.",
      "markers": []
    },
    {
      "id": "s005",
      "start": 552,
      "end": 592,
      "text": "وبنحوِ ما قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s006",
      "start": 596,
      "end": 611,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s007",
      "start": 615,
      "end": 684,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا المُحَاربيُّ، عن جُوَيبرٍ، عن الضحَّاكِ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 615,
          "end": 622,
          "span_id": "s007"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 658,
          "end": 684,
          "stripped": "عن جويبر، عن الضحاك:",
          "span_id": "s007"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 674,
          "end": 682,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 684,
      "end": 734,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ}.",
      "markers": [

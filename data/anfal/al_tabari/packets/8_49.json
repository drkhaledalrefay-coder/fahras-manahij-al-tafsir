      "start": 2864,
      "end": 2892,
      "text": " ثنا سعيدٌ، عن قتادةَ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 2879,
          "end": 2884,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 2892,
      "end": 2970,
      "text": " {إِذْ يَقُولُ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ}، إلى قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2893,
          "end": 2958,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 2970,
      "end": 3010,
      "text": " {فَإِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2971,
          "end": 3004,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 3010,
      "end": 3046,
      "text": " رأَوْا عِصابةً مِن المؤمنين شرَدتْ ",
      "markers": []
    },
    {
      "id": "s039",
      "start": 3126,
      "end": 3238,
      "text": " لأمرِ اللهِ. وذُكِر لنا أن أبا جهلٍ عدوَّ اللَّهِ لمَّا أشْرَف على محمدٍ - صلى الله عليه وسلم -، وأصحابِه، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3202,
          "end": 3220,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3238,
      "end": 3289,
      "text": " واللَّهِ لا يُعْبَدُ اللَّهُ بعدَ اليومَ. قَسْوةً ",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3310,
      "end": 3321,
      "text": " وعُتُوًّا ",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3376,
      "end": 3377,
      "text": ".",
      "markers": []
    },
    {
      "id": "s043",
      "start": 3381,
      "end": 3420,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3381,
          "end": 3388,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 3420,
      "end": 3460,
      "text": " ثني حجاجٌ، قال: قال ابن جريجٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 3441,
          "end": 3449,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3460,
      "end": 3527,
      "text": " {إِذْ يَقُولُ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3461,
          "end": 3526,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3527,
      "end": 3623,
      "text": " قال: ناسٌ كانوا مِن المنافقين بمكةَ، قالوه يومَ بدرٍ، وهم يومَئذٍ ثلاثمائةٍ وبضعةَ عشَرَ رجلًا ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 3571,
          "end": 3579,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3679,
      "end": 3680,
      "text": ".",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3684,
      "end": 3727,
      "text": "قال: حدَّثني حجاجٌ، عن ابن جُريجٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 3707,
          "end": 3716,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3727,
      "end": 3794,
      "text": " {إِذْ يَقُولُ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3728,
          "end": 3793,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 3794,
      "end": 3924,
      "text": " قال: لمَّا دنا القومُ بعضُهم مِن بعضٍ، فقلَّل اللهُ المسلمين في أعينِ المشركين، وقلَّل المشركين في أعينِ المسلمين، فقال المشركون:",
      "markers": []
    },
    {
      "id": "s051",
      "start": 3924,
      "end": 4050,
      "text": " {غَرَّ هَؤُلَاءِ دِينُهُمْ}. وإنما قالوا ذلك مِن قلتهم في أعينِهم، وظنُّوا أنهم سيَهْزِمونهم لا يَشْكُّون في ذلك، فقال اللهُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3925,
          "end": 3952,
          "span_id": "s051"
        },
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 3974,
          "end": 3977,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4050,
      "end": 4118,
      "text": " {وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَإِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4051,
          "end": 4117,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 4122,
      "end": 4169,
      "text": "وأما قولُه: {وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4134,
          "end": 4168,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4169,
      "end": 4260,
      "text": " فإن معناه: ومَن يُسْلِمُ أمره إلى الله ويَثِق به، ويَرْضَ بقضائِه، فإن الله حافظُه وناصره؛",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 4174,
          "end": 4179,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4260,
      "end": 4357,
      "text": " لأنه عزيزٌ لا يَغْلِبُه شَيءٌ، ولا يَفْهَرُه أَحدٌ، فجارُه مَنيعٌ، ومَن يَتَوَكَّلْ عليه مكفيٌّ ",
      "markers": []
    },
    {
      "id": "s056",
      "start": 4403,
      "end": 4404,
      "text": ".",
      "markers": []
    },
    {
      "id": "s057",
      "start": 4408,
      "end": 4581,
      "text": "وهذا أمرٌ مِن الله جلَّ ثناؤُه المؤمنين به مِن أصحابِ رسولِ اللهِ وغيرِهم أن يُفَوِّضوا أمرَهم إليه، ويُسَلِّموا لقضائه، كيما يكفيهم أعداءهم، ولا يَسْتَذِلَّهم مَن ناوَأَهم؛",
      "markers": []
    },
    {
      "id": "s058",
      "start": 4581,
      "end": 4643,
      "text": " لأنه عزيزٌ غيرُ مغلوبٍ، فجارُه غير مَقْهورٍ، {حَكِيمٌ} يقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4627,
          "end": 4636,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4643,
      "end": 4710,
      "text": " هو فيما يُدَبِّرُ مِن أمرِ خلقِه، حكيمٌ لا يَدْخُلُ تدبيره خَلَلٌ ",
      "markers": []
    },
    {
      "id": "s060",
      "start": 4730,
      "end": 4731,
      "text": ".",
      "markers": []
    }
  ],

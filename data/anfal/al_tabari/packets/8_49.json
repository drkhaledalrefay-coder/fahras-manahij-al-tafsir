    {
      "id": "s001",
      "start": 4,
      "end": 190,
      "text": "القولُ في تأويلِ قولِه: {إِذْ يَقُولُ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ غَرَّ هَؤُلَاءِ دِينُهُمْ وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَإِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ (49)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28,
          "end": 189,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 194,
      "end": 265,
      "text": "يقولُ تعالى ذكرُه: {وَإِنَّ اللَّهَ لَسَمِيعٌ عَلِيمٌ} في هذه الأحوالِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 213,
          "end": 248,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 282,
      "end": 320,
      "text": " {إِذْ يَقُولُ الْمُنَافِقُونَ} وكرَّ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 283,
          "end": 313,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 350,
      "end": 399,
      "text": " بقوله: {إِذْ يَقُولُ الْمُنَافِقُونَ} على قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 358,
          "end": 388,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 399,
      "end": 450,
      "text": " {إِذْ يُرِيكَهُمُ اللَّهُ فِي مَنَامِكَ قَلِيلًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 400,
          "end": 449,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 454,
      "end": 497,
      "text": "{وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ}. يعنى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 454,
          "end": 490,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 497,
      "end": 594,
      "text": " شكٌّ في الإسلام، لم يَصِحُّ يقينُهم، ولم تُشْرَحْ بالإيمانِ صدورهم، {غَرَّ هَؤُلَاءِ دِينُهُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 566,
          "end": 593,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 594,
      "end": 714,
      "text": " يقولُ: غَرَّ هؤلاء الذين يُقاتِلون المشركين مِن أصحابِ محمدٍ - صلى الله عليه وسلم - مِن أنفسِهم - دينُهم وذلك الإسلامُ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 658,
          "end": 676,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 718,
      "end": 845,
      "text": "وذُكِر أن الذين قالوا هذا القولَ كانوا نفرًا ممن كان قد تكَلَّم بالإسلامِ مِن مشركي قريشٍ، ولم يَسْتَحْكمِ الإسلامُ في قلوبُهم.",
      "markers": []
    },
    {
      "id": "s010",
      "start": 849,
      "end": 865,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s011",
      "start": 869,
      "end": 903,
      "text": "حدَّثنا محمدُ بنُ المُثَنَّى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 869,
          "end": 876,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 903,
      "end": 960,
      "text": " ثنا عبدُ الأعلى، قال: ثنا داودُ، عن عامرٍ في هذه الآيةِ:",
      "markers": []
    },
    {
      "id": "s013",
      "start": 960,
      "end": 1053,
      "text": " {إِذْ يَقُولُ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ غَرَّ هَؤُلَاءِ دِينُهُمْ}.",
      "markers": [
        {
          "family": "QURAN",

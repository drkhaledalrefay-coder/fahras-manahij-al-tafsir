          "marker": "{…}",
          "start": 10306,
          "end": 10364,
          "span_id": "s148"
        }
      ]
    },
    {
      "id": "s149",
      "start": 10365,
      "end": 10444,
      "text": " يقولُ: ومنهم من قد سَبَقَ له من اللهِ الدخولُ في الإيمانِ، وهو الاستغفارُ. ثم ",
      "markers": []
    },
    {
      "id": "s150",
      "start": 10459,
      "end": 10537,
      "text": " قال: {وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ}. فعذَّبهم يومَ بدرٍ بالسيفِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10465,
          "end": 10508,
          "span_id": "s150"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 10519,
          "end": 10527,
          "span_id": "s150"
        }
      ]
    },
    {
      "id": "s151",
      "start": 10706,
      "end": 10707,
      "text": ".",
      "markers": []
    },
    {
      "id": "s152",
      "start": 10711,
      "end": 10771,
      "text": "وقال آخرون: بل معناه: وما كان اللهُ معذِّبَهم وهم يُصَلُّون.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 10726,
          "end": 10731,
          "span_id": "s152"
        }
      ]
    },
    {
      "id": "s153",
      "start": 10775,
      "end": 10791,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s154",
      "start": 10795,
      "end": 10846,
      "text": "حدَّثني المثنى، قال: ثنا عبدُ اللهِ بنُ صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s155",
      "start": 10846,
      "end": 10890,
      "text": " ثني معاويةُ، عن علىٍّ، عن ابنِ عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10860,
          "end": 10890,
          "stripped": "عن على، عن ابن عباس قوله:",
          "span_id": "s155"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 10873,
          "end": 10882,
          "span_id": "s155"
        }
      ]
    },
    {
      "id": "s156",
      "start": 10890,
      "end": 10950,
      "text": " {وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10891,
          "end": 10949,
          "span_id": "s156"
        }
      ]
    },
    {
      "id": "s157",
      "start": 10950,
      "end": 10987,
      "text": " يعنى: يُصلُّون. يعنى بهذا أهلَ مكةَ ",
      "markers": []
    },
    {
      "id": "s158",
      "start": 11030,
      "end": 11031,
      "text": ".",
      "markers": []
    },
    {
      "id": "s159",
      "start": 11035,
      "end": 11083,
      "text": "حدَّثنى موسى بنُ عبدِ الرحمنِ المَسْروقىُّ، قال:",
      "markers": []
    },
    {
      "id": "s160",
      "start": 11083,
      "end": 11153,
      "text": " ثنا حسينٌ الجُعْفِيُّ، عن زائدةَ، عن منصورٍ، عن مجاهدٍ في قولِ اللهِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11107,
          "end": 11153,
          "stripped": "عن زائدة، عن منصور، عن مجاهد في قول الله:",
          "span_id": "s160"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 11132,
          "end": 11137,
          "span_id": "s160"
        }
      ]
    },
    {
      "id": "s161",
      "start": 11153,
      "end": 11280,
      "text": " {وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ}. قال: يصلُّون ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11154,
          "end": 11265,
          "span_id": "s161"
        }
      ]
    },
    {
      "id": "s162",
      "start": 11300,
      "end": 11301,
      "text": ".",
      "markers": []
    },
    {
      "id": "s163",
      "start": 11305,
      "end": 11341,
      "text": "حُدِّثتُ عن الحسينِ بنِ الفرجِ، قال:",
      "markers": []
    },
    {
      "id": "s164",
      "start": 11341,
      "end": 11392,
      "text": " سمِعتُ أبا معاذٍ، قال: ثنا عبيدُ بنُ سليمانَ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 11353,
          "end": 11357,
          "span_id": "s164"
        }
      ]
    },
    {
      "id": "s165",
      "start": 11392,
      "end": 11435,
      "text": " سمعتُ الضحَّاكَ بنَ مزاحمٍ يقولُ في قولِه:",
      "markers": []
    },
    {
      "id": "s166",
      "start": 11435,
      "end": 11491,
      "text": " {وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11436,
          "end": 11490,
          "span_id": "s166"
        }
      ]
    },
    {
      "id": "s167",
      "start": 11491,
      "end": 11554,
      "text": " يعنى أهلَ مكةَ. يقولُ: لم أكنْ لأعذِّبَكم وفيكم محمدٌ، ثم قال:",
      "markers": []
    },
    {
      "id": "s168",
      "start": 11554,
      "end": 11637,
      "text": " {وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ}. يعنى: يؤمنون ويصلُّون.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11555,
          "end": 11613,
          "span_id": "s168"
        }
      ]
    },
    {
      "id": "s169",
      "start": 11641,
      "end": 11709,
      "text": "حدَّثنا ابنُ حميدٍ، قال: ثنا جَرِيرٌ، عن منصورٍ، عن مجاهدٍ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11641,
          "end": 11648,
          "span_id": "s169"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11679,
          "end": 11709,
          "stripped": "عن منصور، عن مجاهد في قوله:",
          "span_id": "s169"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 11693,
          "end": 11698,
          "span_id": "s169"
        }
      ]
    },
    {
      "id": "s170",
      "start": 11709,
      "end": 11787,
      "text": " {وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ}. قال: وهم يصلُّون.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11710,
          "end": 11768,
          "span_id": "s170"
        }
      ]
    },
    {
      "id": "s171",
      "start": 11791,
      "end": 11806,
      "text": "وقال آخرون: بل ",
      "markers": []
    },
    {
      "id": "s172",
      "start": 11820,
      "end": 11876,
      "text": " معنى ذلك: وما كان اللهُ ليعذِّبَ المشركين وهم يستغفرون.",
      "markers": []
    },
    {
      "id": "s173",
      "start": 11876,
      "end": 11904,
      "text": " قالوا: ثم نُسِخ ذلك بقولِه:",
      "markers": []
    },
    {
      "id": "s174",
      "start": 11904,
      "end": 11995,
      "text": " {وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ وَهُمْ يَصُدُّونَ عَنِ الْمَسْجِدِ الْحَرَامِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11905,
          "end": 11994,
          "span_id": "s174"
        }
      ]
    },
    {
      "id": "s175",
      "start": 11999,
      "end": 12015,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s176",
      "start": 12019,
      "end": 12138,
      "text": "حدَّثنا ابنُ حميدٍ، قال: ثنا يحيى بنُ واضحٍ، عن الحسينِ بنِ واقدٍ، عن يزيدَ النحوىِّ، عن عكرمةَ والحسنِ البصرىِّ، قالا:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 12019,
          "end": 12026,
          "span_id": "s176"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 12064,
          "end": 12113,
          "stripped": "عن الحسين بن واقد، عن يزيد النحوى، عن عكرمة",
          "span_id": "s176"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 12108,
          "end": 12113,
          "span_id": "s176"
        }
      ]
    },
    {
      "id": "s177",
      "start": 12138,
      "end": 12269,
      "text": " قال فى \"الأنفال\": {وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12157,
          "end": 12268,
          "span_id": "s177"
        }
      ]
    },
    {
      "id": "s178",
      "start": 12269,
      "end": 12342,
      "text": " فنسَختها الآيةُ التي تليها: {وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12298,
          "end": 12341,
          "span_id": "s178"
        }
      ]
    },
    {
      "id": "s179",
      "start": 12342,
      "end": 12404,
      "text": " إلى قولِه: {فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12354,
          "end": 12403,
          "span_id": "s179"
        }
      ]
    },
    {
      "id": "s180",
      "start": 12404,
      "end": 12450,
      "text": " فقوتلوا بمكةَ، وأصابهم فيها الجوعُ والحَصْرُ ",
      "markers": []
    },
    {
      "id": "s181",
      "start": 12523,
      "end": 12524,
      "text": ".",
      "markers": []
    },
    {
      "id": "s182",
      "start": 12528,
      "end": 12580,
      "text": "وأولى هذه الأقوالِ عندى فى ذلك بالصوابِ قولُ من قال:",
      "markers": []
    },
    {
      "id": "s183",
      "start": 12580,
      "end": 12685,
      "text": " تأويلُه: وما كان اللهُ ليعذِّبَهم وأنت فيهم يا محمدُ، وبينَ أظهرِهم مقيمٌ، حتى أُخرِجَك من بينِ أظهرِهم؛",
      "markers": []
    },
    {
      "id": "s184",
      "start": 12685,
      "end": 12862,
      "text": " لأنى لا أُهْلِكُ قريةً وفيها نبيُّها، وما كان اللهُ معذِّبَهم وهم يستغفِرون من ذنوبِهم وكفرِهم، ولكنهم لا يستغفرون من ذلك، بل هم مصرُّون عليه، فهم للعذابِ مستحقُّون، كما يقالُ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 12856,
          "end": 12860,
          "span_id": "s184"
        }
      ]
    },
    {
      "id": "s185",
      "start": 12862,
      "end": 12904,
      "text": " ما كنتُ لِأُحْسِنَ إليك وأنت تسيءُ إلىَّ.",
      "markers": []
    },
    {
      "id": "s186",
      "start": 12904,
      "end": 12954,
      "text": " يرادُ بذلك: لا أُحْسِنُ إليك إذا أسأت إلىَّ. أو: ",
      "markers": []
    },
    {
      "id": "s187",
      "start": 12966,
      "end": 13034,
      "text": " لو أسأْتَ إلىَّ لم أحسنْ إليك، ولكن أُحسنُ إليك لأنك لا تسئُ إلىَّ.",
      "markers": []
    },
    {
      "id": "s188",
      "start": 13034,
      "end": 13144,
      "text": " وكذلك ذلك، ثم قيل: {وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ وَهُمْ يَصُدُّونَ عَنِ الْمَسْجِدِ الْحَرَامِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13054,
          "end": 13143,
          "span_id": "s188"
        }
      ]
    },
    {
      "id": "s189",
      "start": 13144,
      "end": 13296,
      "text": " بمعنى: وما شأنُهم وما يمنَعُهم أن يعذِّبَهم اللهُ وهم لا يستغفِرون اللهَ من كفرِهم فيؤمنوا به، وهم يصُدُّون المؤمنين باللهِ ورسولِه عن المسجدِ الحرامِ.",
      "markers": []
    },
    {
      "id": "s190",
      "start": 13300,
      "end": 13355,
      "text": "وإنما قلنا: هذا القولُ أَوْلى الأقوالِ فى ذلك بالصوابِ؛",
      "markers": []
    },
    {
      "id": "s191",
      "start": 13355,
      "end": 13419,
      "text": " لأن القومَ، أعنى مشركي مكةَ، كانوا اسْتَعْجلوا العذابَ، فقالوا:",
      "markers": []
    },
    {
      "id": "s192",
      "start": 13419,
      "end": 13516,
      "text": " اللهمَّ إن كان ما جاء به محمدٌ هو الحقَّ، فأمطِرْ علينا حجارةً من السماءِ أو ائتنا بعذابٍ أليمٍ.",
      "markers": []
    },
    {
      "id": "s193",
      "start": 13516,
      "end": 13695,
      "text": " فقال اللهُ لنبيِّه: ما كنتُ لأعذِّبَهم وأنتَ فيهم، وما كنتُ لأعذِّبَهم لو استغفروا، وكيف لا أعذِّبُهم بعدَ إخراجِك منهم وهم يصُدُّون عن المسجدِ الحرامِ. فأَعْلَمه جلَّ ثناؤُه أن ",
      "markers": []
    },
    {
      "id": "s194",
      "start": 13716,
      "end": 13717,
      "text": " ",
      "markers": []
    },
    {
      "id": "s195",
      "start": 13770,
      "end": 13863,
      "text": " العذابِ حائقٌ بهم ونازلٌ، وأَعْلَمهم حالَ نزولِه بهم، وذلك بعد إخراجِه إياه من بينِ أظهرِهم.",
      "markers": []
    },
    {
      "id": "s196",
      "start": 13863,
      "end": 14055,
      "text": " ولا وجهَ لإيعادِهم العذابَ في الآخرةِ وهم مستعجِلوه فى العاجلِ، ولا شكَّ أنهم في الآخرةِ إلى العذابِ صائرون، بل في تعجيلِ اللهِ لهم ذلك يومَ بدرٍ الدليلُ الواضحُ على أن القولَ فى ذلك ما قلنا.",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 14000,
          "end": 14008,
          "span_id": "s196"
        }
      ]
    },
    {
      "id": "s197",
      "start": 14059,
      "end": 14094,
      "text": "وكذلك لا وجهَ لقولِ من وجَّه قولَه:",
      "markers": []
    },
    {
      "id": "s198",
      "start": 14094,
      "end": 14154,
      "text": " {وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14095,
          "end": 14153,
          "span_id": "s198"
        }
      ]
    },
    {
      "id": "s199",
      "start": 14154,
      "end": 14291,
      "text": " إلى أنه عُنِى به المؤمنون، وهو في سياقِ الخبرِ عنهم، وعما اللهُ فاعلٌ بهم، ولا دليلَ على أن الخبرَ عنهم قد تقضَّى، وعلى أن ذلك به عُنوا ",
      "markers": []
    },
    {
      "id": "s200",
      "start": 14321,
      "end": 14328,
      "text": "، وألا ",
      "markers": []
    },
    {
      "id": "s201",
      "start": 14344,
      "end": 14379,
      "text": " خِلافَ في تأويلِه من أهلِه موجودٌ.",
      "markers": []
    },
    {
      "id": "s202",
      "start": 14383,
      "end": 14416,
      "text": "وكذلك أيضًا لا وجهَ لقولِ من قال:",
      "markers": []
    },
    {
      "id": "s203",
      "start": 14416,
      "end": 14532,
      "text": " ذلك منسوخٌ بقولِه: {وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ وَهُمْ يَصُدُّونَ عَنِ الْمَسْجِدِ الْحَرَامِ} الآية؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14436,
          "end": 14525,
          "span_id": "s203"
        }
      ]
    },
    {
      "id": "s204",
      "start": 14532,
      "end": 14615,
      "text": " لأن قولَه جلَّ ثناؤُه: {وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14556,
          "end": 14614,
          "span_id": "s204"
        }
      ]
    },
    {
      "id": "s205",
      "start": 14615,
      "end": 14686,
      "text": " خبرٌ، والخبرُ لا يجوزُ أن يكونَ فيه نسخٌ، وإنما يكون النسخُ للأمرِ أو ",
      "markers": []
    },
    {
      "id": "s206",
      "start": 14698,
      "end": 14706,
      "text": " النهيِ.",
      "markers": []
    },
    {
      "id": "s207",
      "start": 14710,
      "end": 14761,
      "text": "واخْتَلف أهلُ العربيةِ فى وجهِ دخولِ \"أن\" فى قولِه:",
      "markers": []
    },
    {
      "id": "s208",
      "start": 14761,
      "end": 14814,
      "text": " {وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ اللَّهُ}؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14762,
          "end": 14813,
          "span_id": "s208"
        }
      ]
    },
    {
      "id": "s209",
      "start": 14814,
      "end": 14863,
      "text": " فقال بعضُ نحويِّى البصرةِ: هي زائدةٌ هاهنا. قال ",
      "markers": []
    },
    {
      "id": "s210",
      "start": 14875,
      "end": 14928,
      "text": ": وقد عمِلت كما عمِلت \"لا\" وهي زائدةٌ وجاء في الشعرِ ",
      "markers": []
    },
    {
      "id": "s211",
      "start": 14945,
      "end": 14946,
      "text": ":",
      "markers": []
    },
    {
      "id": "s212",
      "start": 14950,
      "end": 14999,
      "text": "لو لم تكنْ غَطَفانُ لا ذُنوبَ لها ... إلىَّ لامت ",
      "markers": []
    },
    {
      "id": "s213",
      "start": 15016,
      "end": 15036,
      "text": " ذوُو أحسابِها عُمرا",
      "markers": []
    }
  ],

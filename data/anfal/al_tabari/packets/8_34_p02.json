          "span_id": "s112"
        }
      ]
    },
    {
      "id": "s113",
      "start": 8274,
      "end": 8387,
      "text": " {وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8275,
          "end": 8386,
          "span_id": "s113"
        }
      ]
    },
    {
      "id": "s114",
      "start": 8387,
      "end": 8426,
      "text": " قال: يقولُ: لو استغفَروا لم أعذِّبْهم ",
      "markers": []
    },
    {
      "id": "s115",
      "start": 8463,
      "end": 8464,
      "text": ".",
      "markers": []
    },
    {
      "id": "s116",
      "start": 8468,
      "end": 8529,
      "text": "وقال آخرون: معنى ذلك: وما كان اللهُ ليعذِّبَهم وهم يُسْلِمون.",
      "markers": []
    },
    {
      "id": "s117",
      "start": 8529,
      "end": 8577,
      "text": " قالوا: واستغفارُهم كان في هذا الموضعِ إسلامَهم.",
      "markers": []
    },
    {
      "id": "s118",
      "start": 8581,
      "end": 8596,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s119",

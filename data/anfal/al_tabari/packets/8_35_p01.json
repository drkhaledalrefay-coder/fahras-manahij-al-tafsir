          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 2969,
      "end": 2970,
      "text": ".",
      "markers": []
    },
    {
      "id": "s043",
      "start": 2974,
      "end": 3058,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا أبي، عن قُرَّةَ بنِ خالدٍ، عن عطيةَ، عن ابنِ عمرَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2974,
          "end": 2981,
          "span_id": "s043"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3008,
          "end": 3053,
          "stripped": "عن قرة بن خالد، عن عطية، عن ابن عمر،",
          "span_id": "s043"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عمر",
          "name": "ابن عمر",
          "role": "SPEAKER",
          "start": 3043,
          "end": 3051,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 3058,
      "end": 3100,
      "text": " المكاءُ التصفيقُ، والتصديةُ الصفيرُ. قال:",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3100,
      "end": 3127,
      "text": " وأمال ابنُ عمرَ خدَّه إلى ",
      "markers": []
    },
    {
      "id": "s046",
      "start": 3153,
      "end": 3160,
      "text": " جانبٍ ",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3422,
      "end": 3423,
      "text": ".",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3427,
      "end": 3466,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3427,
          "end": 3434,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3466,
      "end": 3520,
      "text": " ثنا وكيعٌ، عن قرةَ بنِ خالدٍ، عن عطيةَ، عن ابنِ عمرَ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3478,
          "end": 3520,
          "stripped": "عن قرة بن خالد، عن عطية، عن ابن عمر:",
          "span_id": "s049"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عمر",
          "name": "ابن عمر",
          "role": "SPEAKER",
          "start": 3510,
          "end": 3518,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 3520,
      "end": 3592,
      "text": " {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3521,
          "end": 3591,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3592,
      "end": 3635,
      "text": " قال: المكاءُ والتصديةُ: الصفيرُ والتصفيقُ ",
      "markers": []
    },
    {
      "id": "s052",
      "start": 3656,
      "end": 3657,
      "text": ".",
      "markers": []
    },
    {
      "id": "s053",
      "start": 3661,
      "end": 3724,
      "text": "حدَّثني الحارثُ، قال: ثنا القاسمُ، قال: سمعت محمدَ بنَ الحسينِ ",
      "markers": []
    },
    {
      "id": "s054",
      "start": 3772,
      "end": 3876,
      "text": " يحدِّثُ عن قرةَ بنِ خالدٍ، عن عطيةَ العَوْفىِّ، عن ابنِ عمرَ، قال: المكاءُ الصفيرُ، والتصديةُ التصفيقُ.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3781,
          "end": 3827,
          "stripped": "عن قرة بن خالد، عن عطية العوفى، عن ابن",
          "span_id": "s054"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عمر",
          "name": "ابن عمر",
          "role": "SPEAKER",
          "start": 3824,
          "end": 3832,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 3880,
      "end": 3924,
      "text": "حدَّثنا ابنُ بشارٍ، قال: ثنا أبو عامرٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3880,
          "end": 3887,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 3924,
      "end": 3971,
      "text": " ثنا قُرَّةُ، عن عطيةَ، عن ابنِ عمرَ، في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3938,
          "end": 3971,
          "stripped": "عن عطية، عن ابن عمر، في قوله:",
          "span_id": "s056"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عمر",
          "name": "ابن عمر",
          "role": "SPEAKER",
          "start": 3951,
          "end": 3959,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 3971,
      "end": 4043,
      "text": " {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3972,
          "end": 4042,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4043,
      "end": 4085,
      "text": " قال: المكاءُ الصفيرُ، والتصديةُ التصفيقُ.",
      "markers": []
    },
    {
      "id": "s059",
      "start": 4085,
      "end": 4161,
      "text": " وقال قرةُ: وحكى لنا عطيةُ فعلَ ابنِ عمرَ فصفَّر، وأمال خدَّه، وصفَّق بيديه ",
      "markers": []
    },
    {
      "id": "s060",
      "start": 4163,
      "end": 4164,
      "text": ".",
      "markers": []
    },
    {
      "id": "s061",
      "start": 4168,
      "end": 4234,
      "text": "حدَّثني يونسُ، قال: أخبرنا ابنُ وهبٍ، قال: أخبرني بكرُ بنُ مُضَرَ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4188,
          "end": 4194,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4236,
      "end": 4263,
      "text": "، عن جعفرِ بنِ ربيعةَ، قال:",
      "markers": []
    },
    {
      "id": "s063",
      "start": 4263,
      "end": 4327,
      "text": " سمعت أبا سَلَمةَ بنَ عبدِ الرحمنِ بنِ عوفٍ يقولُ في قولِ اللهِ:",
      "markers": []
    },
    {
      "id": "s064",
      "start": 4327,
      "end": 4399,
      "text": " {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4328,
          "end": 4398,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4399,
      "end": 4478,
      "text": " قال بكرٌ: فجمَع لى جعفرٌ كفَّيْه ثم نفَخ فيهما صفيرًا، كما قال له أبو سَلَمةَ.",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4482,
      "end": 4512,
      "text": "حدَّثنا أحمدُ بنُ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4482,
          "end": 4489,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 4512,
      "end": 4636,
      "text": " ثنا أبو أحمدَ، قال: ثنا إسرائيلُ، عن ابنِ أبي نَجيحٍ، عن مجاهدٍ، عن ابنِ عباسٍ، قال: المكاءُ الصَّفيرُ، والتصديةُ التصفيقُ.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4547,
          "end": 4592,
          "stripped": "عن ابن أبي نجيح، عن مجاهد، عن ابن عباس،",
          "span_id": "s067"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 4570,
          "end": 4575,
          "span_id": "s067"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4581,
          "end": 4590,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 4640,
      "end": 4664,
      "text": "قال: ثنا أبو أحمدَ، قال:",
      "markers": []
    },
    {
      "id": "s069",
      "start": 4664,
      "end": 4712,
      "text": " ثنا سَلَمةُ بنُ سابورَ، عن عطيةَ، عن ابنِ عمرَ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4689,
          "end": 4712,
          "stripped": "عن عطية، عن ابن عمر:",
          "span_id": "s069"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عمر",
          "name": "ابن عمر",
          "role": "SPEAKER",
          "start": 4702,
          "end": 4710,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 4712,
      "end": 4805,
      "text": " {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}، قال: تصفيرٌ وتصفيقٌ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4713,
          "end": 4783,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 4809,
      "end": 4849,
      "text": "قال: ثنا أبو أحمدَ، قال: ثنا فُضيلُ بنُ ",
      "markers": []
    },
    {
      "id": "s072",
      "start": 4897,
      "end": 4935,
      "text": " مرزوقٍ، عن عطيةَ، عن ابنِ عمرَ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4906,
          "end": 4935,
          "stripped": "عن عطية، عن ابن عمر مثله.",
          "span_id": "s072"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عمر",
          "name": "ابن عمر",
          "role": "NARRATOR",
          "start": 4919,
          "end": 4927,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 4939,
      "end": 5051,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا حَبُّويَهْ أبو يزيدَ، عن يعقوبَ، عن جعفرٍ، عن سعيدِ بنِ جُبيرٍ، عن ابنِ عباسٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4939,
          "end": 4946,
          "span_id": "s073"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4990,
          "end": 5034,
          "stripped": "عن يعقوب، عن جعفر، عن سعيد بن جبير، عن",
          "span_id": "s073"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "NARRATOR",
          "start": 5014,
          "end": 5029,
          "span_id": "s073"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5035,
          "end": 5044,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 5051,
      "end": 5124,
      "text": " كانت قريشٌ يطوفون بالبيتِ وهم عراةٌ يصفِّرون ويصفِّقون، فَأَنْزَل اللهُ:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 5108,
          "end": 5117,
          "span_id": "s074"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 5108,
          "end": 5122,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 5124,
      "end": 5190,
      "text": " {قُلْ مَنْ حَرَّمَ زِينَةَ اللَّهِ الَّتِي أَخْرَجَ لِعِبَادِهِ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5125,
          "end": 5189,
          "span_id": "s075"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 5190,
          "end": 5203,
          "text": "[الأعراف: 32]",
          "via": "apparatus",
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 5203,
      "end": 5223,
      "text": ". فأُمِروا بالثيابِ ",
      "markers": []
    },
    {
      "id": "s077",
      "start": 5399,
      "end": 5400,
      "text": ".",
      "markers": []
    },
    {
      "id": "s078",
      "start": 5404,
      "end": 5448,
      "text": "حدَّثني المُثنى، قال: ثنا الحِمَّانيُّ، قال:",
      "markers": []
    },
    {
      "id": "s079",
      "start": 5448,
      "end": 5484,
      "text": " ثنا شريكٌ، عن سالمٍ، عن سعيدٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5460,
          "end": 5484,
          "stripped": "عن سالم، عن سعيد، قال:",
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 5484,
      "end": 5599,
      "text": " كانت قريشٌ يعارضون النبىَّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- فى الطوافِ يستهزئون به، يصفِّرون به ويصفِّقون، فنزلت:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5513,
          "end": 5543,
          "span_id": "s080"
        },
        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 5593,
          "end": 5598,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 5599,
      "end": 5671,
      "text": " {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5600,
          "end": 5670,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 5725,
      "end": 5726,
      "text": ".",
      "markers": []
    },
    {
      "id": "s083",
      "start": 5730,
      "end": 5796,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا أبي، عن سفيانَ، عن منصورٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5730,
          "end": 5737,
          "span_id": "s083"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5764,
          "end": 5796,
          "stripped": "عن سفيان، عن منصور، عن مجاهد:",
          "span_id": "s083"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 5789,
          "end": 5794,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 5796,
      "end": 5865,
      "text": " {إِلَّا مُكَاءً}. قال: كانوا ينفُخون في أيدِيهم، والتصديةُ التصفيقُ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5797,
          "end": 5813,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 5869,
      "end": 5898,
      "text": "حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s086",
      "start": 5898,
      "end": 5959,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابنِ أبى نَجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5929,
          "end": 5959,
          "stripped": "عن ابن أبى نجيح، عن مجاهد:",
          "span_id": "s086"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 5952,
          "end": 5957,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 5959,
      "end": 6004,
      "text": " {إِلَّا مُكَاءً وَتَصْدِيَةً}. قال: المكاءُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5960,
          "end": 5989,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 6004,
      "end": 6053,
      "text": " إدخالُ أصابعِهم في أفواهِهم، والتصديةُ التصفيرُ ",
      "markers": []
    },
    {
      "id": "s089",
      "start": 6100,
      "end": 6166,
      "text": "، يخلِطون بذلك على محمدٍ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- صلاتَه ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6126,
          "end": 6156,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 6314,
      "end": 6315,
      "text": ".",
      "markers": []
    },
    {
      "id": "s091",
      "start": 6319,
      "end": 6357,
      "text": "حدَّثنا المُثنى، قال: ثنا إسحاقُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6319,
          "end": 6326,
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 6357,
      "end": 6445,
      "text": " ثنا عبدُ اللهِ، عن ورقاءَ، عن ابنِ أبي نجيحٍ، عن مجاهدٍ مثلَه، إلا أنه لم يقلْ: صلاتَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6374,
          "end": 6406,
          "stripped": "عن ورقاء، عن ابن أبي نجيح، عن",
          "span_id": "s092"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 6407,
          "end": 6412,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 6449,
      "end": 6488,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6449,
          "end": 6456,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 6488,
      "end": 6517,
      "text": " ثني حجَّاجٌ، عن ابنِ جُريجٍ ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 6505,
          "end": 6515,
          "span_id": "s094"
        }
      ]
    },
    {
      "id": "s095",
      "start": 6538,
      "end": 6564,
      "text": "، عن مجاهدٍ، قال: المكاءُ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 6543,
          "end": 6548,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 6564,
      "end": 6613,
      "text": " إدخالُ أصابعِهم فى أفواهِهم، والتصديةُ التصفيقُ.",
      "markers": []
    },
    {
      "id": "s097",
      "start": 6613,
      "end": 6685,
      "text": " قال: نفرٌ من بني عبدِ الدارِ كانوا يخلِطون بذلك كلِّه على محمدٍ صلاتَه.",
      "markers": []
    },
    {
      "id": "s098",
      "start": 6689,
      "end": 6719,
      "text": "حدَّثنا أحمدُ بنُ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6689,
          "end": 6696,
          "span_id": "s098"
        }
      ]
    },
    {
      "id": "s099",
      "start": 6719,
      "end": 6781,
      "text": " ثنا أبو أحمدَ، قال: ثنا طلحةُ بنُ عمرٍو، عن سعيدِ بنِ جُبيرٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 6764,
          "end": 6779,
          "span_id": "s099"
        }
      ]
    },
    {
      "id": "s100",
      "start": 6781,
      "end": 6853,
      "text": " {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6782,
          "end": 6852,
          "span_id": "s100"
        }
      ]
    },
    {
      "id": "s101",
      "start": 6853,
      "end": 6887,
      "text": " قال: من بينِ الأصابعِ. قال أحمدُ:",
      "markers": []
    },
    {
      "id": "s102",
      "start": 6887,
      "end": 6927,
      "text": " سقَط علىَّ حرفٌ وما أُراه إلا الحَذْفَ ",
      "markers": []
    },
    {
      "id": "s103",
      "start": 6959,
      "end": 7049,
      "text": "، والنفخُ والصفيرُ منها، وأرانى سعيدُ بنُ جبيرٍ حيث كانوا يَمْكُون من ناحيةِ أبي قُبَيْسٍ.",
      "markers": []
    },
    {
      "id": "s104",
      "start": 7053,
      "end": 7103,
      "text": "حدَّثني المُثنى، قال: ثنا إسحاقُ بنُ سليمانَ، قال:",
      "markers": []
    },
    {
      "id": "s105",
      "start": 7103,
      "end": 7157,
      "text": " أخبرَنا طلحةُ بنُ عمرٍو، عن سعيدِ بنِ جبيرٍ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 7104,
          "end": 7111,
          "span_id": "s105"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 7132,
          "end": 7146,
          "span_id": "s105"
        }
      ]
    },
    {
      "id": "s106",
      "start": 7157,
      "end": 7229,
      "text": " {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7158,
          "end": 7228,
          "span_id": "s106"
        }
      ]
    },
    {
      "id": "s107",
      "start": 7229,
      "end": 7302,
      "text": " قال: المكاءُ: كانوا يُشبِّكون بينَ أصابعِهم ويصفِّرون بها، فذلك المكاءُ.",
      "markers": []
    },
    {
      "id": "s108",
      "start": 7302,
      "end": 7381,
      "text": " قال: وأرانى سعيدُ بنُ جبيرٍ المكانَ الذى كانوا يَمْكُون فيه نحوَ أبي قُبَيْسٍ ",
      "markers": []
    },
    {
      "id": "s109",
      "start": 7499,
      "end": 7500,
      "text": ".",
      "markers": []
    }
  ],

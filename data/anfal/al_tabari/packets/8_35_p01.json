          "end": 2151,
          "span_id": "s030"
        }
      ]
    },
    {
      "id": "s031",
      "start": 2159,
      "end": 2269,
      "text": " {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}: المكاءُ التصفيرُ، والتصديةُ التصفيقُ ",
      "markers": [
        {

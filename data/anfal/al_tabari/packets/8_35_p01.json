          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 2561,
      "end": 2650,
      "text": " يقولُ: كانت صلاةُ المشركين عندَ البيتِ مُكاءً، يعني: التصفيرَ. وتصديةً، يقولُ: التصفيقُ ",
      "markers": []
    },
    {
      "id": "s038",
      "start": 2726,
      "end": 2727,
      "text": ".",
      "markers": []
    },
    {
      "id": "s039",
      "start": 2731,
      "end": 2771,
      "text": "حدَّثني محمدُ بنُ عُمارةَ الأسدىُّ، قال:",
      "markers": []
    },
    {
      "id": "s040",
      "start": 2771,
      "end": 2802,
      "text": " ثنا عبيدُ اللهِ بنُ موسى، قال:",
      "markers": []
    },
    {
      "id": "s041",
      "start": 2802,
      "end": 2925,
      "text": " أخبرنا فُضيلٌ، عن عطيةَ: {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}، قال: التصفيقُ والصَّفيرُ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2803,
          "end": 2809,
          "span_id": "s041"
        },
        {

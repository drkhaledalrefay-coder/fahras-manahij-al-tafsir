  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 152,
      "text": "القولُ في تأويلِ قولِه: {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ (35)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28,
          "end": 151,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 156,
      "end": 254,
      "text": "يقولُ تعالى ذكرُه: وما لهؤلاء المشركين ألَّا يعذِّبَهم اللهُ وهم يصُدُّون عن المسجدِ الحرامِ الذى ",
      "markers": []
    },
    {
      "id": "s003",
      "start": 283,
      "end": 529,
      "text": " يصلُّون للهِ فيه ويعبُدونه، ولم يكونوا للهِ أولياءَ، بل أولياؤُه الذين يصدُّونهم عن المسجدِ الحرامِ، وهم لا يصلون في المسجدِ الحرامِ، {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ}، يعنى بيتَ اللهِ العتيقَ {إِلَّا مُكَاءً}، وهو الصَّفيرُ، يقالُ منه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 418,
          "end": 460,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 486,
          "end": 502,
          "span_id": "s003"
        },
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 519,
          "end": 523,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 529,
      "end": 568,
      "text": " مكَا يَمْكُو مَكْوًا ومُكاءً. وقد قيل:",
      "markers": []
    },
    {
      "id": "s005",
      "start": 568,
      "end": 637,
      "text": " إن المَكْوَ: أن يجمَعَ الرجلُ يديه ثم يُدْخِلَهما في فِيه، ثم يصيحَ.",
      "markers": []
    },
    {
      "id": "s006",
      "start": 637,
      "end": 698,
      "text": " ويقالُ منه: مكَتِ استُ الدابَّةِ مُكاءً، إذا نَفَخت بالريحِ.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 639,
          "end": 643,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 698,
      "end": 759,
      "text": " ويقالُ: إنه لا يَمْكُو إلَّا استٌ مكشوفةٌ، ولذلك قيل للاستِ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 700,
          "end": 704,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 759,
      "end": 804,
      "text": " المَكْوةُ، سمِّيت بذلك، ومن ذلك قولُ عنترةَ:",
      "markers": []
    },
    {
      "id": "s009",
      "start": 808,
      "end": 816,
      "text": "وحَليلِ ",
      "markers": []
    },
    {
      "id": "s010",
      "start": 897,
      "end": 905,
      "text": " غانيةٍ ",
      "markers": []
    },
    {
      "id": "s011",
      "start": 947,
      "end": 964,
      "text": " تركتُ مُجدَّلًا ",
      "markers": []
    },
    {
      "id": "s012",
      "start": 1020,
      "end": 1042,
      "text": " ... تَمْكُو فَريصتُه ",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1139,
      "end": 1158,
      "text": " كشِدْقِ الأَعْلمِ ",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1386,
      "end": 1406,
      "text": "وقولُ الطَّرِمَّاحِ ",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1421,
      "end": 1422,
      "text": ":",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1426,
      "end": 1432,
      "text": "فنَحا ",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1448,
      "end": 1459,
      "text": " لأُولَاها ",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1482,
      "end": 1533,
      "text": " بطعنةِ مُحْفَظٍ ... تَمْكُو جوانبُها من الإنْهارِ ",
      "markers": []
    },
    {
      "id": "s019",
      "start": 1596,
      "end": 1611,
      "text": "بمعنى: تصوِّتُ.",
      "markers": []
    },
    {
      "id": "s020",
      "start": 1615,
      "end": 1656,
      "text": "وأما التصديةُ، فإنها التصفيقُ، يقالُ منه:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 1646,
          "end": 1650,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 1656,
      "end": 1710,
      "text": " صدَّى يُصَدِّى تَصْدِيةً، وصفَّق وصفَّح بمعنًى واحدٍ.",
      "markers": []
    },
    {
      "id": "s022",
      "start": 1714,
      "end": 1754,
      "text": "وبنحوِ ما قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s023",
      "start": 1758,
      "end": 1774,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s024",
      "start": 1778,
      "end": 1840,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا أبى، عن موسى بنِ قيسٍ، عن حُجْرِ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1778,
          "end": 1785,
          "span_id": "s024"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1812,
          "end": 1838,
          "stripped": "عن موسى بن قيس، عن حجر",
          "span_id": "s024"
        }
      ]
    },
    {
      "id": "s025",
      "start": 1899,
      "end": 1949,
      "text": " بنِ عَنْبسٍ: {إِلَّا مُكَاءً وَتَصْدِيَةً}. قال: ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1913,
          "end": 1942,
          "span_id": "s025"
        }
      ]
    },
    {
      "id": "s026",
      "start": 1971,
      "end": 1972,
      "text": " ",
      "markers": []
    },
    {
      "id": "s027",
      "start": 1986,
      "end": 2005,
      "text": " التصديةُ التصفيقُ ",
      "markers": []
    },
    {
      "id": "s028",
      "start": 2055,
      "end": 2056,
      "text": ".",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2060,
      "end": 2115,
      "text": "حدَّثني المُثَنَّى، قال: ثنا عبدُ اللهِ بنُ صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s030",
      "start": 2115,
      "end": 2159,
      "text": " ثني معاويةُ، عن علىٍّ، عن ابنِ عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",

          "name": "الشعبي",
          "role": "NARRATOR",
          "start": 2400,
          "end": 2406,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 2570,
      "end": 2571,
      "text": ".",
      "markers": []
    },
    {
      "id": "s040",
      "start": 2575,
      "end": 2615,
      "text": "حدَّثنا أحمدُ بنُ محمدٍ الطُّوسيُّ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2575,
          "end": 2582,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 2615,
      "end": 2701,
      "text": " ثنا عليُّ بنُ عاصمٍ، عن داودَ بنِ أبي هندٍ، عن أبى نضرةَ، عن أبي سعيدٍ الخدريِّ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2637,
          "end": 2680,
          "stripped": "عن داود بن أبي هند، عن أبى نضرة، عن أبي",
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 2701,
      "end": 2848,
      "text": " إنما كان ذلك يومَ بدرٍ، ولم يكنْ للمسلمين فئةٌ إلَّا رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، فأما بعدَ ذلك، فإن المسلمين بعضُهم فئةٌ لبعضٍ ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 2715,
          "end": 2723,
          "span_id": "s042"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2768,
          "end": 2798,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 2891,
      "end": 2892,
      "text": ".",
      "markers": []
    },
    {
      "id": "s044",
      "start": 2896,
      "end": 2960,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا عبدُ الأعلى عن داودَ، عن أبي نضرةَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2896,
          "end": 2903,
          "span_id": "s044"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2937,
          "end": 2960,
          "stripped": "عن داود، عن أبي نضرة:",
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 2960,
      "end": 3007,
      "text": " {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2961,
          "end": 3001,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3007,
      "end": 3031,
      "text": " هذه نزلَت فى أهلِ بدرٍ ",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3075,
      "end": 3076,
      "text": ".",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3080,
      "end": 3139,
      "text": "حدَّثني يعقوبُ، قال: ثنا ابنُ عُلَيَّةَ، عن ابنِ عونٍ، قال:",
      "markers": []
    },
    {
      "id": "s049",
      "start": 3139,
      "end": 3172,
      "text": " كتبتُ إلى نافعٍ أسألُه عن قولِه:",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3172,
      "end": 3242,
      "text": " {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ}: أكان ذلك اليومَ أم هو بعدُ؟",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3173,
          "end": 3213,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3242,
      "end": 3284,
      "text": " قال: وكتبَ إليَّ: إنما كان ذلك يومَ بدرٍ ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 3274,
          "end": 3282,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 3334,
      "end": 3335,
      "text": ".",
      "markers": []
    },
    {
      "id": "s053",
      "start": 3339,
      "end": 3367,
      "text": "حدَّثنا عليُّ بنُ سهلٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3339,
          "end": 3346,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 3367,
      "end": 3419,
      "text": " ثنا زيدٌ، عن سفيانَ، عن جُويبرٍ، عن الضحَّاكِ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3378,
          "end": 3419,
          "stripped": "عن سفيان، عن جويبر، عن الضحاك، قال:",
          "span_id": "s054"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 3404,
          "end": 3412,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 3419,
      "end": 3448,
      "text": " إنما كان الفِرارُ يومَ بدرٍ ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 3438,
          "end": 3446,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 3465,
      "end": 3521,
      "text": "، لم يكن لهم ملجأٌ يلجئون إليه، فأما اليومَ فليس فِرارٌ ",
      "markers": []
    },
    {
      "id": "s057",
      "start": 3575,
      "end": 3576,
      "text": ".",
      "markers": []
    },
    {
      "id": "s058",
      "start": 3580,
      "end": 3636,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا أبى، عن الربيعِ، عن الحسنِ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3580,
          "end": 3587,
          "span_id": "s058"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3614,
          "end": 3636,
          "stripped": "عن الربيع، عن الحسن:",
          "span_id": "s058"
        },
        {
          "family": "TABIIN",
          "marker": "الربيع",
          "name": "الربيع",
          "role": "NARRATOR",
          "start": 3617,
          "end": 3623,
          "span_id": "s058"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 3629,
          "end": 3634,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 3636,
      "end": 3683,
      "text": " {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3637,
          "end": 3677,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 3683,
      "end": 3746,
      "text": " كانت هذه يومَ بدرٍ خاصَّةً، ليس الفرارُ من الزحفِ من الكبائرِ ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 3693,
          "end": 3701,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 3892,
      "end": 3893,
      "text": ".",
      "markers": []
    },
    {
      "id": "s062",
      "start": 3897,
      "end": 3944,
      "text": "قال: ثنا أبي، عن سفيانَ، عن رجلٍ، عن الضحَّاكِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3911,
          "end": 3944,
          "stripped": "عن سفيان، عن رجل، عن الضحاك:",
          "span_id": "s062"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 3934,
          "end": 3942,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 3944,
      "end": 3991,
      "text": " {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3945,
          "end": 3985,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 3991,
      "end": 4019,
      "text": " كانت هذه يومَ بدرٍ خاصَّةً ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4001,
          "end": 4009,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4059,
      "end": 4060,
      "text": ".",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4064,
      "end": 4125,
      "text": "قال: ثنا رَوْحُ بنُ عُبادةَ، عن حبيبِ بنِ الشهيدِ، عن الحسنِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4093,
          "end": 4125,
          "stripped": "عن حبيب بن الشهيد، عن الحسن:",
          "span_id": "s066"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 4118,
          "end": 4123,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 4125,
      "end": 4192,
      "text": " {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ}. قال: نزَلت فى أهلِ بدرٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4126,
          "end": 4166,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 4252,
      "end": 4253,
      "text": ".",
      "markers": []
    },
    {
      "id": "s069",
      "start": 4257,
      "end": 4284,
      "text": "حدَّثنا بشرُ بن معاذٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4257,
          "end": 4264,
          "span_id": "s069"
        },
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 4273,
          "end": 4277,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 4284,
      "end": 4322,
      "text": " ثنا يزيدُ، قال: ثنا سعيدٌ، عن قتادةَ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 4315,
          "end": 4320,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 4322,
      "end": 4385,
      "text": " {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ}. قال: ذلكم يومُ بدرٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4323,
          "end": 4363,
          "span_id": "s071"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4375,
          "end": 4383,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 4504,
      "end": 4505,
      "text": ".",
      "markers": []
    },
    {
      "id": "s073",
      "start": 4509,
      "end": 4545,
      "text": "حدَّثني المثنى، قال: ثنا سويدٌ، قال:",
      "markers": []
    },
    {
      "id": "s074",
      "start": 4545,
      "end": 4604,
      "text": " أخبَرنا ابنُ المباركِ، عن المباركِ بنِ فَضالةَ، عن الحسنِ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4546,
          "end": 4553,
          "span_id": "s074"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4569,
          "end": 4604,
          "stripped": "عن المبارك بن فضالة، عن الحسن:",
          "span_id": "s074"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 4597,
          "end": 4602,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 4604,
      "end": 4651,
      "text": " {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4605,
          "end": 4645,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 4651,
      "end": 4735,
      "text": " ذلك يومُ بدرٍ، فأما اليومَ فإنِ انحازَ إلى فئةٍ أو مِصرٍ، أحسَبُه قال: فلا بأسَ به ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4656,
          "end": 4664,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 4843,
      "end": 4844,
      "text": ".",
      "markers": []
    },
    {
      "id": "s078",
      "start": 4848,
      "end": 4896,
      "text": "حدَّثني المثنى، قال: ثنا قَبيصةُ بنُ عقبةَ، قال:",
      "markers": []
    },
    {
      "id": "s079",
      "start": 4896,
      "end": 4932,
      "text": " قال: ثنا سفيانُ، عن ابنِ عونٍ، قال:",
      "markers": []
    },
    {
      "id": "s080",
      "start": 4932,
      "end": 4990,
      "text": " كتبت إلى نافعٍ: {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4949,
          "end": 4989,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 4990,
      "end": 5015,
      "text": " قال: إنما هذا يومُ بدرٍ.",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 5005,
          "end": 5013,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 5019,
      "end": 5064,
      "text": "حدَّثني المثنى، قال: ثنا سويدُ بنُ نصرٍ، قال:",
      "markers": []
    },
    {
      "id": "s083",
      "start": 5064,
      "end": 5105,
      "text": " ثنا ابنُ المباركِ، عن ابنِ لَهِيعةَ قال:",
      "markers": []
    },
    {
      "id": "s084",
      "start": 5105,
      "end": 5135,
      "text": " ثنى يزيدُ بنُ أبي حبيبٍ، قال:",
      "markers": []
    },
    {
      "id": "s085",
      "start": 5135,
      "end": 5175,
      "text": " أَوْجب اللهُ لمن فرَّ يومَ بدرٍ النارَ.",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 5158,
          "end": 5166,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 5175,
      "end": 5318,
      "text": " قال: {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ إِلَّا مُتَحَرِّفًا لِقِتَالٍ أَوْ مُتَحَيِّزًا إِلَى فِئَةٍ فَقَدْ بَاءَ بِغَضَبٍ مِنَ اللَّهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5181,
          "end": 5317,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 5318,
      "end": 5351,
      "text": " فلما كان يومُ أحدٍ بعدَ ذلك قال:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم أحد",
          "start": 5328,
          "end": 5336,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 5351,
      "end": 5445,
      "text": " {إِنَّمَا اسْتَزَلَّهُمُ الشَّيْطَانُ بِبَعْضِ مَا كَسَبُوا وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5352,
          "end": 5444,
          "span_id": "s088"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 5445,
          "end": 5460,
          "text": "[آل عمران: 155]",
          "via": "apparatus",
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 5460,
      "end": 5491,
      "text": ". ثم كان حُنينٌ بعدَ ذلك بسبعِ ",
      "markers": []
    },
    {
      "id": "s090",
      "start": 5506,
      "end": 5616,
      "text": " سنينَ، فقال: {ثُمَّ وَلَّيْتُمْ مُدْبِرِينَ} - {ثُمَّ يَتُوبُ اللَّهُ مِنْ بَعْدِ ذَلِكَ عَلَى مَنْ يَشَاءُ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5520,
          "end": 5551,
          "span_id": "s090"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5554,
          "end": 5615,
          "span_id": "s090"
        }
      ]
    },
    {
      "id": "s091",
      "start": 5706,
      "end": 5707,
      "text": " ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 5707,
          "end": 5724,
          "text": "[التوبة: 25 - 27]",
          "via": "apparatus",
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 5724,
      "end": 5725,
      "text": ".",
      "markers": []
    },
    {
      "id": "s093",
      "start": 5729,
      "end": 5771,
      "text": "حدَّثني يعقوبُ، قال: ثنا ابنُ عُليةَ، قال:",
      "markers": []
    },
    {
      "id": "s094",
      "start": 5771,
      "end": 5797,
      "text": " ثنا ابنُ عونٍ، عن محمدٍ، ",
      "markers": []
    },
    {
      "id": "s095",
      "start": 5806,
      "end": 5807,
      "text": " ",
      "markers": []
    },
    {
      "id": "s096",
      "start": 5844,
      "end": 5888,
      "text": " رضى اللهُ عنه بلَغه قتلُ أبي عُبيدٍ، فقال: ",
      "markers": []
    },
    {
      "id": "s097",
      "start": 5921,
      "end": 5922,
      "text": " ",
      "markers": []
    },
    {
      "id": "s098",
      "start": 6128,
      "end": 6129,
      "text": ".",
      "markers": []
    },
    {
      "id": "s099",
      "start": 6133,
      "end": 6170,
      "text": "حدَّثني المثنى، قال: ثنا سُويدٌ، قال:",
      "markers": []
    },
    {
      "id": "s100",
      "start": 6170,
      "end": 6203,
      "text": " ثنا ابنُ المباركِ، عن جريرِ بنِ ",
      "markers": []
    },
    {
      "id": "s101",
      "start": 6222,
      "end": 6253,
      "text": " حازمٍ، قال: ثني قيسُ بنُ سعدٍ ",
      "markers": []
    },
    {
      "id": "s102",
      "start": 6329,
      "end": 6370,
      "text": "، قال: سألت عطاءَ بنَ أبي رباحٍ عن قولِه:",
      "markers": []
    },
    {
      "id": "s103",
      "start": 6370,
      "end": 6417,
      "text": " {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6371,
          "end": 6411,
          "span_id": "s103"
        }
      ]
    },
    {
      "id": "s104",
      "start": 6417,
      "end": 6454,
      "text": " هذه منسوخةٌ بالآية التي في الأنفالِ:",
      "markers": []
    },
    {
      "id": "s105",
      "start": 6454,
      "end": 6584,
      "text": " {الْآنَ خَفَّفَ اللَّهُ عَنْكُمْ وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا فَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ صَابِرَةٌ يَغْلِبُوا مِائَتَيْنِ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6455,
          "end": 6583,
          "span_id": "s105"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 6584,
          "end": 6597,
          "text": "[الأنفال: 66]",
          "via": "apparatus",
          "span_id": "s105"
        }
      ]
    },
    {
      "id": "s106",
      "start": 6597,
      "end": 6639,
      "text": ". قال: وليس لقومٍ أن يفرُّوا من مِثْلَيهم ",
      "markers": []
    },
    {
      "id": "s107",
      "start": 6668,
      "end": 6675,
      "text": ". قال: ",
      "markers": []
    },
    {
      "id": "s108",
      "start": 6692,
      "end": 6693,
      "text": " ",
      "markers": []
    },
    {
      "id": "s109",
      "start": 6872,
      "end": 6887,
      "text": " هذه العِدَّةَ ",
      "markers": []
    },
    {
      "id": "s110",
      "start": 7075,
      "end": 7076,
      "text": ".",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s003",
      "start": 229,
      "end": 341,
      "text": "¬في ت 1، ت 2، س، ف: \"إلا منتظرا\"، وفى م: \"إلا مستطردا\". فى كلٍّ مصحفة، وما أثبتناه موافق لما سبق ومصدر التخريج.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s004",
      "start": 357,
      "end": 374,
      "text": "¬في م: \"العودة\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s006",
      "start": 445,
      "end": 473,
      "text": "¬فى ت 1، ت 2، س، ف: \"حيده\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s007",
      "start": 561,
      "end": 630,
      "text": "¬أخرجه ابن أبي حاتم فى تفسيره 5/ 1670 من طريق أسباط به مختصرا بنحوه.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s013",
      "start": 1053,
      "end": 1076,
      "text": "¬فى م: \"فاليوم أفلهم\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s020",
      "start": 1368,
      "end": 1414,
      "text": "¬أخرجه ابن أبى شيبة 14/ 380 عن عبد الأعلى به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s025",
      "start": 1661,
      "end": 1805,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره 5/ 1670 من طريق داود به، وعزاه السيوطى في الدر المنثور 5/ 173 إلى عبد بن حميد وابن المنذر وأبى الشيخ وابن مردويه.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s030",
      "start": 1976,
      "end": 2069,
      "text": "¬أخرجه النسائي في الكبرى (11204) عن حميد بن مسعدة به، وأخرجه أبو داود (2648) من طريق بشر به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s034",
      "start": 2217,
      "end": 2230,
      "text": "¬فى ف: \"عن\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s038",
      "start": 2423,
      "end": 2570,
      "text": "¬أخرجه النسائى فى الكبرى (11203) -وعنه النحاس في ناسخه ص 460 - والحاكم 2/ 327 من طريق شعبة به. وأخرجه ابن الجوزى فى النواسخ ص 345 من طريق غندر به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s042",
      "start": 2848,
      "end": 2891,
      "text": "¬ذكره البغوى في تفسيره 3/ 337 عن أبي سعيد.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s046",
      "start": 3031,
      "end": 3075,
      "text": "¬ذكره ابن أبي حاتم في تفسيره 5/ 1670 معلقا.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s051",
      "start": 3284,
      "end": 3334,
      "text": "¬أخرجه ابن المبارك فى الجهاد (231) عن ابن عون به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s055",
      "start": 3448,
      "end": 3465,
      "text": "¬بعده في م: \"و\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s056",
      "start": 3521,
      "end": 3575,
      "text": "¬أخرجه عبد الرزاق فى المصنف (9521) عن الثورى به نحوه.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s060",
      "start": 3746,
      "end": 3892,
      "text": "¬أخرجه ابن أبي شيبة 14/ 386، والنحاس في ناسخه ص 460 من طريق وكيع به، وعزاه السيوطي في الدر المنثور 3/ 173 إلى عبد بن حميد وابن المنذر وأبى الشيخ.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s064",
      "start": 4019,
      "end": 4059,
      "text": "¬أخرجه ابن أبي شيبة 14/ 386 عن وكيع به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s067",
      "start": 4192,
      "end": 4252,
      "text": "¬أخرجه ابن الجوزى فى النواسخ ص 345 من طريق روح بن عبادة به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s071",
      "start": 4385,
      "end": 4504,
      "text": "¬أخرجه عبد الرزاق فى المصنف (9520) عن معمر به، بلفظ أطول من هذا. وعزاه السيوطى في الدر المنثور 3/ 173 إلى عبد بن حميد.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s076",
      "start": 4735,
      "end": 4843,
      "text": "¬أخرجه ابن المبارك فى كتاب الجهاد (232)، وأخرجه ابن أبي حاتم فى تفسيره 5/ 1671 من طريق المبارك بن فضالة به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s089",
      "start": 5491,
      "end": 5506,
      "text": "¬فى ف: \"بتسع\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s090",
      "start": 5616,
      "end": 5706,
      "text": "¬ذكره ابن أبي حاتم فى تفسيره 5/ 1670 معلقًا، وعزاه السيوطى فى الدر 3/ 173 إلى ابن المنذر.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s095",
      "start": 5807,
      "end": 5844,
      "text": "¬فى ص: \"أبى عمر\". وفى ف: \"أبي عمرو\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s097",
      "start": 5922,
      "end": 6128,
      "text": "¬فى م: \"لو تحيز إلى لكنت له فئة\".<br>والأثر أخرجه ابن المبارك فى الجهاد (233)، وابن أبى شيبة 12/ 536 من طريق ابن عون به، وأخرجه ابن المبارك (234)، وعبد الرزاق في مصنفه (9522)، والبيهقى 9/ 77 من طرق عن عمر.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s100",
      "start": 6203,
      "end": 6222,
      "text": "¬بعده في ف: \"أبي\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s101",
      "start": 6253,
      "end": 6329,
      "text": "¬في النسخ: \"سعيد\". والمثبت من مصدر التخريج، وينظر تهذيب الكمال 24/ 47 - 50.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s106",
      "start": 6639,
      "end": 6668,
      "text": "¬في ص، ت 1، ت 2، س: \"مثلهم\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s108",
      "start": 6693,
      "end": 6872,
      "text": "¬فى الجهاد لابن المبارك: \"نسخت هذه الآية\"، والمراد من قول المصنف: ونُسخت تلك -أى {ومن يولهم يومئذ دبره} - إلا هذه العدة -أى {مائة يغلبوا مائتين} - فلا يجوز لمسلم أن يفر من مثليه.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s109",
      "start": 6887,
      "end": 7075,
      "text": "¬الجهاد لابن المبارك (236). وعزاه السيوطى فى الدر المنثور 3/ 174 إلى ابن المنذر وأبى الشيخ، وقد روى عبد الرزاق فى المصنف (9519) عن ابن جريج عن عطاء ما يفيد أنه أثبت معناها ولم يقل بنسخها.¥",
      "grading": []
    },
    {
      "label_ar": "إضافة المحقق — ليست من كلام الطبري",
      "attached_span_id": "s012",
      "start": 1031,
      "end": 1052,
      "text": "[فأَمَّا اليومَ فلهم]",
      "grading": []
    },
    {
      "label_ar": "إضافة المحقق — ليست من كلام الطبري",
      "attached_span_id": "s094",
      "start": 5797,
      "end": 5806,
      "text": "[أن عمرَ]",
      "grading": []
    },
    {
      "label_ar": "إضافة المحقق — ليست من كلام الطبري",
      "attached_span_id": "s096",
      "start": 5888,
      "end": 5921,
      "text": "[لو انحاز إليَّ إن كنتُ له لفئةً]",
      "grading": []
    },
    {
      "label_ar": "إضافة المحقق — ليست من كلام الطبري",
      "attached_span_id": "s107",
      "start": 6675,
      "end": 6692,
      "text": "[ونسِخَت تلك إلا]",
      "grading": []
    }
  ]
}
          "span_id": "s023"
        }
      ]
    },
    {
      "id": "s024",
      "start": 1518,
      "end": 1588,
      "text": " {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ}. ثم ذكَر نحوَه، إلا أنه قال:",
      "markers": [
        {
          "family": "QURAN",

      "start": 1335,
      "end": 1368,
      "text": " قال أبو موسى: يعنى إلى المشركين ",
      "markers": []
    },
    {
      "id": "s021",
      "start": 1414,
      "end": 1415,
      "text": ".",
      "markers": []
    },
    {
      "id": "s022",
      "start": 1419,
      "end": 1450,
      "text": "حدَّثنا إسحاقُ بنُ شاهينٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1419,
          "end": 1426,
          "span_id": "s022"
        }

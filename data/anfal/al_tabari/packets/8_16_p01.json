    },
    {
      "id": "s023",
      "start": 1450,
      "end": 1518,
      "text": " ثنا خالدٌ، عن داودَ، عن أبي نَضْرةَ، عن أبى سعيدٍ قولَه عزَّ وجلَّ:",
      "markers": [

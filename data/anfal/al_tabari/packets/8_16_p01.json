  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 35,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s002",
      "start": 35,
      "end": 63,
      "text": " ثنا أحمدُ بنُ مفضَّلٍ، قال:",
      "markers": []
    },
    {
      "id": "s003",
      "start": 63,
      "end": 229,
      "text": " ثنا أسباطُ، عن السُّديِّ: {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ إِلَّا مُتَحَرِّفًا لِقِتَالٍ أَوْ مُتَحَيِّزًا إِلَى فِئَةٍ}: أمَّا المتحرِّفُ، يقولُ: الاستطرادُ ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 79,
          "end": 86,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 90,
          "end": 191,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 341,
      "end": 357,
      "text": "، يريدُ العورةَ ",
      "markers": []
    },
    {
      "id": "s005",
      "start": 374,
      "end": 409,
      "text": "، {أَوْ مُتَحَيِّزًا إِلَى فِئَةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 376,
          "end": 408,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 409,
      "end": 445,
      "text": " قال: المتحيِّزُ إلى الإمامِ وجندِه ",
      "markers": []
    },
    {
      "id": "s007",
      "start": 473,
      "end": 561,
      "text": " إن هو كرَّ فلم يكنْ له بهم طاقةٌ، ولا يُعْذَرُ الناسُ وإن كثُروا أن يولُّوا عن الإمامِ ",
      "markers": []
    },
    {
      "id": "s008",
      "start": 630,
      "end": 631,
      "text": ".",
      "markers": []
    },
    {
      "id": "s009",
      "start": 635,
      "end": 686,
      "text": "واخْتَلف أهلُ العلمِ في حكمِ قولِ اللهِ عزَّ وجلَّ:",
      "markers": []
    },
    {
      "id": "s010",
      "start": 686,
      "end": 898,
      "text": " {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ إِلَّا مُتَحَرِّفًا لِقِتَالٍ أَوْ مُتَحَيِّزًا إِلَى فِئَةٍ فَقَدْ بَاءَ بِغَضَبٍ مِنَ اللَّهِ وَمَأْوَاهُ جَهَنَّمُ}، هل هو خاصٌّ فى أهلِ بدرٍ، أم هو فى المؤمنين جميعًا؟",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 687,
          "end": 845,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 898,
      "end": 932,
      "text": " فقال قومٌ: هو لأهلِ بدرٍ خاصَّةً؛",
      "markers": []
    },
    {
      "id": "s012",
      "start": 932,
      "end": 1031,
      "text": " لأنه لم يكنْ لهم أن يترُكوا رسولَ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- مع عدوِّه وينهزموا عنه، ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 974,
          "end": 1004,
          "span_id": "s012"
        }
      ]
    },
    {
      "id": "s013",
      "start": 1052,
      "end": 1053,
      "text": " ",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1076,
      "end": 1087,
      "text": " الانهزامُ؟",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1091,
      "end": 1106,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1110,
      "end": 1140,
      "text": "حدَّثنا محمدُ بنُ المثنى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1110,
          "end": 1117,
          "span_id": "s016"
        }
      ]
    },
    {
      "id": "s017",
      "start": 1140,
      "end": 1214,
      "text": " ثنا عبدُ الأعلى، قال: ثنا داودُ، عن أبي نَضْرةَ فى قولِ اللهِ عزَّ وجلَّ:",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1214,
      "end": 1261,
      "text": " {وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1215,
          "end": 1255,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 1261,
      "end": 1335,
      "text": " ذاك يومَ بدرٍ، لم يكنْ لهم أن ينحازوا، ولو انحاز أحدٌ لم ينحزْ إلَّا إلى.",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 1266,
          "end": 1274,
          "span_id": "s019"
        }
      ]
    },
    {

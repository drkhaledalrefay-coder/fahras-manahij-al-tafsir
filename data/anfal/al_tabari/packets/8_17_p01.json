  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 219,
      "text": "القولُ في تأويلِ قولِه: {فَلَمْ تَقْتُلُوهُمْ وَلَكِنَّ اللَّهَ قَتَلَهُمْ وَمَا رَمَيْتَ إِذْ رَمَيْتَ وَلَكِنَّ اللَّهَ رَمَى وَلِيُبْلِيَ الْمُؤْمِنِينَ مِنْهُ بَلَاءً حَسَنًا إِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ (17)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28,
          "end": 218,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 223,
      "end": 431,
      "text": "يقولُ تعالى ذكرُه -للمؤمنين به وبرسولِه ممن شهِد بدرًا مع رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، فقاتَل أعداءَ دينِه معه من كفارِ قريشٍ- فلم تقتُلوا المشركين أيُّها المؤمنون أنتم، ولكنَّ اللهَ قتَلهم.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 294,
          "end": 324,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 431,
      "end": 512,
      "text": " وأضاف جلَّ ثناؤُه قتلَهم إلى نفسِه، ونفاه عن المؤمنين به الذين قاتَلوا المشركين؛",
      "markers": []
    },
    {
      "id": "s004",
      "start": 512,
      "end": 671,
      "text": " إذ كان جلَّ ثناؤُه هو مسبِّبَ قتلِهم، وعن أمرِه كان قتالُ المؤمنين إيَّاهم، ففى ذلك أدلُّ الدليلِ على فسادِ قول المنكِرين أن يكونَ للهِ فى أفعالِ خلقِه صُنعٌ ",
      "markers": []
    },
    {
      "id": "s005",
      "start": 686,
      "end": 745,
      "text": " به وصلوا إليها، وكذلك قولُه لنبيِّه عليه الصلاةُ والسلامُ:",
      "markers": []
    },
    {
      "id": "s006",
      "start": 745,
      "end": 876,
      "text": " {وَمَا رَمَيْتَ إِذْ رَمَيْتَ وَلَكِنَّ اللَّهَ رَمَى} فأضاف الرميَ إلى نبيِّ اللهِ، ثم نفاه عنه، وأَخْبَر عن نفسِه أنه هو الرامى؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 746,
          "end": 800,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 876,
      "end": 937,
      "text": " إذ كان جلَّ ثناؤُه هو المُوصِلَ المرميَّ به إلى الذين رُموا ",
      "markers": []
    },
    {
      "id": "s008",
      "start": 944,
      "end": 945,
      "text": " ",
      "markers": []
    },
    {
      "id": "s009",
      "start": 961,
      "end": 1016,
      "text": " المشركين، والمسبِّبَ الرميةَ لرسولِه، فيقالُ للمنكرين ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 1001,
          "end": 1005,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 1041,
      "end": 1247,
      "text": " ما ذكَرنا: قد علمتم إضافةَ اللهِ رميَ نبيِّه -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- المشركين إلى نفسه، بعدَ وصفِه نبيَّه به، وإضافتُه إليه ذلك فعلٌ واحدٌ كان من اللهِ بتسبيبِه وتسديدِه، ومن رسولِ اللهِ -صَلَّى ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1088,
          "end": 1118,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 1251,
      "end": 1362,
      "text": "اللهُ عَلَيْهِ وَسَلَّمَ- الحذفُ والإرسالُ، فما تُنْكِرون أن يكونَ كذلك سائرُ أفعالِ الخلقِ المكتسبةِ من اللهِ؛",
      "markers": []
    },
    {
      "id": "s012",
      "start": 1362,
      "end": 1485,
      "text": " الإنشاءُ والإنجازُ بالتسبيبِ، ومن الخلقِ الاكتسابُ بالقُوَى، فلن يقولوا في أحدِهما قولًا إلَّا أُلْزِموا في الآخَرِ مثلَه.",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1489,
      "end": 1529,
      "text": "وبنحوِ ما قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1533,
      "end": 1548,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1552,
      "end": 1581,
      "text": "حدَّثنا محمدٌ بنُ عمرٍو، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1552,
          "end": 1559,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1581,
      "end": 1667,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابنِ أبي نَجيحٍ، عن مجاهدٍ في قولِ اللهِ عزَّ وجلَّ:",
      "markers": [

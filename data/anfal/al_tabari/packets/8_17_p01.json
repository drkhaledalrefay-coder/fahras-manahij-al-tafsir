      "start": 2844,
      "end": 2910,
      "text": " لما ورَد رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- بدرًا قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2867,
          "end": 2897,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 2910,
      "end": 2985,
      "text": " \"هذه مصارِعُهم\". ووجَد المشركون النبيَّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2952,
          "end": 2982,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 2985,
      "end": 3086,
      "text": " قد سبَقهم إليه ونزَل عليه، فلما طلَعوا عليه زعَموا أن النبيَّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أن النبي",
          "start": 3037,
          "end": 3045,
          "span_id": "s037"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3049,
          "end": 3079,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 3086,
      "end": 3118,
      "text": " \"هذه قريشٌ قد جاءت بجَلْبَتِها ",
      "markers": []
    },
    {
      "id": "s039",
      "start": 3137,
      "end": 3205,
      "text": " وفخرِها، تُحادُّك وتُكذِّبُ رسولَك، اللهمَّ إنى أسألُك ما وعَدتنى\".",
      "markers": []
    },
    {
      "id": "s040",
      "start": 3205,
      "end": 3274,
      "text": " فلما أَقْبَلوا استقبلهم، فحثَا في وجوهِهم، فهزَمهم اللهُ عزَّ وجلَّ ",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3399,
      "end": 3400,
      "text": ".",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3404,
      "end": 3412,
      "text": "حدَّثنا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3404,
          "end": 3411,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3448,
      "end": 3498,
      "text": " أحمدُ بنُ منصورٍ، قال: ثنا يعقوبُ بنُ محمدٍ، قال:",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3498,
      "end": 3534,
      "text": " ثنا عبدُ العزيزِ بنُ عِمْرانَ، قال:",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3534,
      "end": 3649,
      "text": " ثنا موسى بنُ يعقوبَ بنِ عبدِ اللهِ بنِ زَمْعَةَ، عن يزيدَ بنِ عبدِ اللهِ، عن أبي بكرِ بنِ سليمانَ بنِ أبي حَثْمةَ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3584,
          "end": 3631,
          "stripped": "عن يزيد بن عبد الله، عن أبي بكر بن سليمان",
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3665,
      "end": 3692,
      "text": "، عن حَكيمِ بنِ حزامٍ، قال:",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3692,
      "end": 3852,
      "text": " لما كان يومُ بدرٍ، سمِعنا صوتًا وقَع من السماءِ كأنه صوتُ حَصاةٍ وقَعت في طَسْتٍ، ورمَى رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- تلك الرَّمْيةَ، فانهزمنا ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 3701,
          "end": 3709,
          "span_id": "s047"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3794,
          "end": 3824,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 4021,
      "end": 4022,
      "text": ".",
      "markers": []
    },
    {
      "id": "s049",
      "start": 4026,
      "end": 4070,
      "text": "حدَّثني الحارثُ، قال: ثنا عبدُ العزيزِ، قال:",
      "markers": []
    },
    {
      "id": "s050",
      "start": 4070,
      "end": 4137,
      "text": " ثنا أبو معشرٍ، عن محمدِ بنِ قيسٍ ومحمدِ بنِ كعبٍ القُرَظيِّ، قالا:",
      "markers": []
    },
    {
      "id": "s051",
      "start": 4137,
      "end": 4278,
      "text": " لما دنا القومُ بعضُهم من بعضٍ، أخَذ رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- قَبضْةً من ترابٍ، فرمَى بها في وجوهِ القومِ، وقال: \"شاهتِ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4187,
          "end": 4217,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4291,
      "end": 4388,
      "text": " الوجوهُ\". فدخَلت في أعينِهم كلِّهم، وأقْبَل أصحابُ رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4356,
          "end": 4386,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 4409,
      "end": 4410,
      "text": " ",
      "markers": []
    },
    {
      "id": "s054",
      "start": 4440,
      "end": 4527,
      "text": "، وكانت هزيمتُهم في رميةِ رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، وأَنْزل اللهُ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4479,
          "end": 4509,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4527,
      "end": 4602,
      "text": " {وَمَا رَمَيْتَ إِذْ رَمَيْتَ} الآية إلى: {إِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4528,
          "end": 4558,
          "span_id": "s055"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4570,
          "end": 4601,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4719,
      "end": 4720,
      "text": ".",
      "markers": []
    },
    {
      "id": "s057",
      "start": 4724,
      "end": 4752,
      "text": "حدَّثنا بشرُ بنُ معاذٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4724,
          "end": 4731,
          "span_id": "s057"
        },
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 4741,
          "end": 4745,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4752,
      "end": 4796,
      "text": " ثنا يزيدُ، قال: ثنا سعيدٌ، عن قتادةَ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 4783,
          "end": 4788,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4796,
      "end": 4834,
      "text": " {وَمَا رَمَيْتَ إِذْ رَمَيْتَ} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4797,
          "end": 4827,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4834,
      "end": 4934,
      "text": " ذُكِر لنا أن نبيَّ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- أخَذ يومَ بدرٍ ثلاثةَ أحجارٍ، ورمَى بها ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4861,
          "end": 4891,
          "span_id": "s060"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4899,
          "end": 4907,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4952,
      "end": 4997,
      "text": " وجوهَ الكفارِ، فهُزِموا عندَ الحجرِ الثالثِ ",
      "markers": []
    },
    {
      "id": "s062",
      "start": 5028,
      "end": 5029,
      "text": ".",
      "markers": []
    },
    {
      "id": "s063",
      "start": 5033,
      "end": 5064,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s064",
      "start": 5064,
      "end": 5092,
      "text": " ثنا أحمدُ بنُ مفضَّلٍ، قال:",
      "markers": []
    },
    {
      "id": "s065",
      "start": 5092,
      "end": 5125,
      "text": " ثنا أسباطُ، عن السُّدِّيِّ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 5108,
          "end": 5117,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 5125,
      "end": 5229,
      "text": " قال رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- حينَ التقى الجمعانِ يومَ بدرٍ لعليٍّ: \"أَعْطِنى حصًى ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 5126,
          "end": 5140,
          "span_id": "s066"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5143,
          "end": 5173,
          "span_id": "s066"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 5196,
          "end": 5204,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 5257,
      "end": 5283,
      "text": " من الأرْضِ\"، فناوله حصًى ",
      "markers": []
    },
    {
      "id": "s068",
      "start": 5316,
      "end": 5386,
      "text": " عليه ترابٌ، فرمي به وجوهَ القومِ، فلم يبقَ مشركٌ إلَّا دخَل في عينِه ",
      "markers": []
    },
    {
      "id": "s069",
      "start": 5415,
      "end": 5447,
      "text": " من ذلك الترابِ شيءٌ، ثم ردِفهم ",
      "markers": []
    },
    {
      "id": "s070",
      "start": 5494,
      "end": 5586,
      "text": " المؤمنون يقتُلونهم ويأسِرونهم، فذكَر رميةَ النبيِّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5547,
          "end": 5577,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 5586,
      "end": 5692,
      "text": " {فَلَمْ تَقْتُلُوهُمْ وَلَكِنَّ اللَّهَ قَتَلَهُمْ وَمَا رَمَيْتَ إِذْ رَمَيْتَ وَلَكِنَّ اللَّهَ رَمَى} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5587,
          "end": 5691,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 5755,
      "end": 5756,
      "text": ".",
      "markers": []
    },
    {
      "id": "s073",
      "start": 5760,
      "end": 5802,
      "text": "حدَّثني يونسُ قال: أخبَرنا ابنُ وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 5779,
          "end": 5786,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 5802,
      "end": 5826,
      "text": " قال ابنُ زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 5807,
          "end": 5815,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 5826,
      "end": 5882,
      "text": " {وَمَا رَمَيْتَ إِذْ رَمَيْتَ وَلَكِنَّ اللَّهَ رَمَى}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5827,
          "end": 5881,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 5882,
      "end": 6054,
      "text": " قال: هذا يومُ بدرٍ، أَخَذ رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- ثلاثَ حَصَياتٍ، فرمَى بحصاةٍ في ميمنةِ القومِ، وحصَاةٍ في ميسرةِ القومِ، وحصَاةٍ بينَ أظهرِهم وقال:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 5892,
          "end": 5900,
          "span_id": "s076"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5922,
          "end": 5952,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 6054,
      "end": 6110,
      "text": " \"شاهَتِ الوجوهُ\". فانهزموا، فذلك قولُ اللهِ عزَّ وجلَّ:",
      "markers": []
    },
    {
      "id": "s078",
      "start": 6110,
      "end": 6166,
      "text": " {وَمَا رَمَيْتَ إِذْ رَمَيْتَ وَلَكِنَّ اللَّهَ رَمَى} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6111,
          "end": 6165,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 6276,
      "end": 6277,
      "text": ".",
      "markers": []
    },
    {
      "id": "s080",
      "start": 6281,
      "end": 6321,
      "text": "حدَّثني المثنى، قال: ثنا أبو صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s081",
      "start": 6321,
      "end": 6364,
      "text": " ثنا معاويةُ، عن عليٍّ، عن ابنِ عباسٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6335,
          "end": 6364,
          "stripped": "عن علي، عن ابن عباس، قال:",
          "span_id": "s081"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 6338,
          "end": 6341,
          "span_id": "s081"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6348,
          "end": 6357,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 6364,
      "end": 6437,
      "text": " رفَع رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- يدَه يومَ بدرٍ، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6383,
          "end": 6413,
          "span_id": "s082"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 6421,
          "end": 6429,
          "span_id": "s082"
        }
      ]
    },
    {
      "id": "s083",
      "start": 6437,
      "end": 6500,
      "text": " \"ياربِّ إن تَهْلِك هذه العصابةُ فلن تُعْبَدَ في الأرضِ أبدًا\".",
      "markers": []
    },
    {
      "id": "s084",
      "start": 6500,
      "end": 6529,
      "text": " فقال له جبريلُ عليه السلامُ:",
      "markers": []
    },
    {
      "id": "s085",
      "start": 6529,
      "end": 6671,
      "text": " خُذْ قبضةً من الترابِ، فرمَى بها في وجوههم، فما من المشركين من أحدٍ إلَّا أصاب عينيه ومَنْخِرَيه وفمَه ترابٌ من تلك القبضةِ، فولَّوْا مدبرين ",
      "markers": []
    },
    {
      "id": "s086",
      "start": 6673,
      "end": 6674,
      "text": ".",
      "markers": []
    },
    {
      "id": "s087",
      "start": 6678,
      "end": 6735,
      "text": "حدَّثنا ابنُ حُميدٍ، قال: ثنا سلمةُ، عن ابنِ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6678,
          "end": 6685,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 6735,
      "end": 6831,
      "text": " قال اللهُ عزَّ وجلَّ في رمي رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- المشركين بالحَصْباءِ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6777,
          "end": 6807,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 6899,
      "end": 6950,
      "text": " من يدِه حينَ رماهم: {وَلَكِنَّ اللَّهَ رَمَى}. أى ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6920,
          "end": 6945,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 6979,
      "end": 7082,
      "text": " لم يكنْ ذلك برميتِك، لولا الذى جعَل اللهُ فيها من نصرِك، وما أَلْقَى في صدورِ عدوِّك منها حينَ هزَمهم ",
      "markers": []
    },
    {
      "id": "s091",
      "start": 7218,
      "end": 7219,
      "text": ".",
      "markers": []
    },
    {
      "id": "s092",
      "start": 7223,
      "end": 7314,
      "text": "ورُوِى عن الزُّهْريِّ فى ذلك قولٌ خلافُ هذه الأقوالِ، وهو ما حدَّثنا الحسنُ ابنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7284,
          "end": 7291,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 7314,
      "end": 7368,
      "text": " ثنا عبدُ الرزاقِ، قال: أخبَرنا معمرٌ، عن الزُّهْريِّ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 7338,
          "end": 7345,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 7368,
      "end": 7405,
      "text": " {وَمَا رَمَيْتَ إِذْ رَمَيْتَ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7369,
          "end": 7399,
          "span_id": "s094"
        }
      ]
    },
    {
      "id": "s095",
      "start": 7405,
      "end": 7501,
      "text": " جاء أُبيُّ بنُ خلفٍ الجُمَحيُّ إلى النبيِّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- بعظمٍ حائلٍ، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7450,
          "end": 7480,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 7501,
      "end": 7536,
      "text": " اللهُ محيى هذا يا محمدُ وهو رميمٌ؟",
      "markers": []
    },
    {
      "id": "s097",
      "start": 7536,
      "end": 7603,
      "text": "! وهو يفتُّ العظمَ، فقال النبيُّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7570,
          "end": 7600,
          "span_id": "s097"
        }
      ]
    },
    {
      "id": "s098",
      "start": 7603,
      "end": 7653,
      "text": " \"يُحْييه اللهُ، ثم يُميتُك، ثم يُدْخِلُك النارَ\".",
      "markers": []
    },
    {
      "id": "s099",
      "start": 7653,
      "end": 7683,
      "text": " قال: فلما كان يومُ أحدٍ، قال:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم أحد",
          "start": 7668,
          "end": 7676,
          "span_id": "s099"
        }
      ]
    },
    {
      "id": "s100",
      "start": 7683,
      "end": 7720,
      "text": " واللهِ لأَقتُلنَّ محمدًا إذا رأيتُه.",
      "markers": []
    },
    {
      "id": "s101",
      "start": 7720,
      "end": 7779,
      "text": " فبلَغ ذلك النبيَّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7740,
          "end": 7770,
          "span_id": "s101"
        }
      ]
    },
    {
      "id": "s102",
      "start": 7779,
      "end": 7810,
      "text": " \"بل أنا أقتُلُه إن شاء اللهُ\" ",
      "markers": []
    },
    {
      "id": "s103",
      "start": 8110,
      "end": 8111,
      "text": ".",
      "markers": []
    },
    {
      "id": "s104",
      "start": 8115,
      "end": 8180,
      "text": "وأما قولُه: {وَلِيُبْلِيَ الْمُؤْمِنِينَ مِنْهُ بَلَاءً حَسَنًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8127,
          "end": 8179,
          "span_id": "s104"
        }
      ]
    },
    {
      "id": "s105",
      "start": 8180,
      "end": 8265,
      "text": " فإن معناه: وكى يُنْعِمَ على المؤمنين باللهِ ورسولِه بالظَّفَرِ بأعدائِهم، ويَعِدَهم ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 8185,
          "end": 8190,
          "span_id": "s105"
        }
      ]
    },
    {
      "id": "s106",
      "start": 8282,
      "end": 8302,
      "text": " ما معهم، ويَكْتُبَ ",
      "markers": []
    },
    {
      "id": "s107",
      "start": 8317,
      "end": 8403,
      "text": " لهم أجور أعمالِهم وجهادِهم مع رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، وذلك هو ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 8361,
          "end": 8391,
          "span_id": "s107"
        }
      ]
    },
    {
      "id": "s108",
      "start": 8415,
      "end": 8479,
      "text": " البلاء الحسنُ رميُ اللهِ هؤلاء المشركين، ويعنى بالبلاءِ الحسنِ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 8472,
          "end": 8477,
          "span_id": "s108"
        }
      ]
    },
    {
      "id": "s109",
      "start": 8479,
      "end": 8534,
      "text": " النعمةَ الحسنةَ الجميلةَ، وهى ما وصَفتُ، وما في معناه.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 8528,
          "end": 8533,
          "span_id": "s109"
        }
      ]
    }
  ],
  "editor_footnote_evidence": [
    {

  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 231,
      "text": "القول في تأويلِ قولِه: {وَاذْكُرُوا إِذْ أَنْتُمْ قَلِيلٌ مُسْتَضْعَفُونَ فِي الْأَرْضِ تَخَافُونَ أَنْ يَتَخَطَّفَكُمُ النَّاسُ فَآوَاكُمْ وَأَيَّدَكُمْ بِنَصْرِهِ وَرَزَقَكُمْ مِنَ الطَّيِّبَاتِ لَعَلَّكُمْ تَشْكُرُونَ (26)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 27,
          "end": 230,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 235,
      "end": 329,
      "text": "وهذا تذكيرٌ من اللهِ عزَّ وجلَّ أصحابَ رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- ومناصحةٌ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 287,
          "end": 317,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 375,
      "end": 541,
      "text": ". يقولُ أطيعوا اللهَ ورسولَه أيُّها المؤمنون، واستجِيبوا له إذا دعاكم لما يُحييكم، ولا تخالِفوا أمرَه وإن أمرَكم بما فيه عليكم المشقّةُ والشدّةُ، فإن اللهَ مُهوِّنُه ",
      "markers": []
    },
    {
      "id": "s004",
      "start": 557,
      "end": 591,
      "text": " عليكم بطاعتِكم إيَّاه، ومُعجِّلٌ ",
      "markers": []
    },
    {
      "id": "s005",
      "start": 606,
      "end": 716,
      "text": " لكم منه ما تُحِبُّون، كما فعَل بكم إذ آمنتُم به واتَّبَعْتُموه وأنتم قليلٌ يَسْتَضْعفُكم الكفارُ فيفتِنُونكم ",
      "markers": []
    },
    {
      "id": "s006",
      "start": 751,
      "end": 774,
      "text": " عن دينِكم، وينالُونكم ",
      "markers": []
    },
    {
      "id": "s007",
      "start": 808,
      "end": 913,
      "text": " بالمكروهِ في أنفسِكم وأعراضِكم، تخافون منهم أن يتخطَّفوكم فيقتُلوكم، ويَصْطَلِموا جميعَكم، {فَآوَاكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 900,
          "end": 912,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 913,
      "end": 983,
      "text": " يقولُ: فجعَل لكم مَأْوًى تأوون إليه منهم، {وَأَيَّدَكُمْ بِنَصْرِهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 956,
          "end": 982,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 983,
      "end": 1080,
      "text": " يقولُ: وقوَّاكم بنصرِه عليهم حتى قتَلتم منهم من قتَلتم يبدرٍ، {وَرَزَقَكُمْ مِنَ الطَّيِّبَاتِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1046,
          "end": 1079,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 1080,
      "end": 1170,
      "text": " يقولُ: وأَطْعَمكم غنيمتَهم حلالًا طيِّبًا، {لَعَلَّكُمْ تَشْكُرُونَ}. يقولُ: لكى تشكُروا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1124,
          "end": 1149,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 1203,
      "end": 1218,
      "text": " على ما رزَقكم ",
      "markers": []
    },
    {
      "id": "s012",
      "start": 1256,
      "end": 1259,
      "text": " وأ",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1263,
      "end": 1309,
      "text": "َنْعَم به عليكم من ذلك وغيرِه من نعمِه عندَكم.",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1313,
      "end": 1369,
      "text": "واخْتَلف أهلُ التأويلِ فى {النَّاسُ} الذين عُنوا بقولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1339,
          "end": 1349,
          "span_id": "s014"
        }
      ]
    },
    {
      "id": "s015",
      "start": 1369,
      "end": 1428,
      "text": " {أَنْ يَتَخَطَّفَكُمُ النَّاسُ}؛ فقال بعضُهم: كفارُ قريشٍ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1370,
          "end": 1401,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1432,
      "end": 1447,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1451,
      "end": 1490,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",

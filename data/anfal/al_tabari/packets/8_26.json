      ]
    },
    {
      "id": "s023",
      "start": 1876,
      "end": 1930,
      "text": ": {وَاذْكُرُوا إِذْ أَنْتُمْ قَلِيلٌ مُسْتَضْعَفُونَ}:",
      "markers": [

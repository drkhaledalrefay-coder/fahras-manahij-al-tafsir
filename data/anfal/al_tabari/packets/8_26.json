    {
      "id": "s037",
      "start": 2702,
      "end": 2762,
      "text": " ثنى عبدُ الصمدِ، أنه سمِع وهبَ بنَ مُنَبِّهٍ يقولُ - وقرَأ:",
      "markers": [
        {
          "family": "ISRAILIYYAT",
          "marker": "وهب بن منبه",
          "start": 2729,
          "end": 2746,
          "span_id": "s037"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 2757,
          "end": 2761,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 2762,
      "end": 2870,
      "text": " {وَاذْكُرُوا إِذْ أَنْتُمْ قَلِيلٌ مُسْتَضْعَفُونَ فِي الْأَرْضِ تَخَافُونَ أَنْ يَتَخَطَّفَكُمُ النَّاسُ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2763,
          "end": 2869,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 2870,
      "end": 2900,
      "text": " والناسُ إذ ذاك فارسُ والرومُ ",
      "markers": []
    },
    {
      "id": "s040",
      "start": 2958,
      "end": 2959,
      "text": ".",
      "markers": []
    },
    {
      "id": "s041",
      "start": 2963,
      "end": 3011,
      "text": "قال: ثنا يزيدُ، قال: ثنا سعيدٌ، عن قتادةَ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 2998,
          "end": 3003,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 3011,
      "end": 3078,
      "text": " {وَاذْكُرُوا إِذْ أَنْتُمْ قَلِيلٌ مُسْتَضْعَفُونَ فِي الْأَرْضِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3012,
          "end": 3077,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3078,
      "end": 3159,
      "text": " قال: كان هذا الحىُّ من العربِ أذلَّ الناسِ ذُلًّا، وأشقاه عيشًا، وأجوعَه بطونًا ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3191,
      "end": 3223,
      "text": "، وأعراه جلودًا، وأبينَه ضلالًا ",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3348,
      "end": 3462,
      "text": "، من عاش منهم عاش شقيًّا، ومَن مات منهم رُدِّى فى النارِ، يُؤْكَلون ولا يأكُلون، واللهِ ما نعلَمُ قبيلًا من حاضرِ ",
      "markers": []
    },
    {
      "id": "s046",
      "start": 3496,
      "end": 3689,
      "text": " أهلِ الأرضِ يومَئذٍ كانوا أشرَّ منهم منزلًا، حتى جاء اللهُ بالإسلامِ، فمكّن به في البلادِ، ووسَّع به فى الرزقِ، وجعَلكم به ملوكًا على رقابِ الناسِ، فبالإسلامِ أَعْطَى اللهُ ما رأيتم، فاشكُروا ",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3701,
      "end": 3702,
      "text": " ",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3726,
      "end": 3807,
      "text": "، فإن ربَّكم مُنْعِمٌ يحِبُّ الشكرَ، وأهلُ الشكرِ في مزيدٍ من اللهِ تبارك وتعالى.",
      "markers": []
    },
    {
      "id": "s049",
      "start": 3811,
      "end": 3859,
      "text": "وأولى القولين فى ذلك عندى بالصوابِ قولُ مَن قال:",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3859,
      "end": 3948,
      "text": " عُنِى بذلك مشركو قريشٍ؛ لأن المسلمين لم يكونوا يخافون على أنفسِهم قبلَ الهجرةِ من غيرهم؛",
      "markers": []
    },
    {
      "id": "s051",
      "start": 3948,
      "end": 4047,
      "text": " لأنهم كانوا أدنى الكفارِ منهم إليهم، وأشدَّهم عليهم يومَئذٍ، مع كثرةِ عددِهم، وقلِة عددِ المسلمين.",
      "markers": []
    },
    {
      "id": "s052",
      "start": 4051,
      "end": 4087,
      "text": "وأما قولُه: {فَآوَاكُمْ}. فإنه يعنى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4063,
          "end": 4075,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 4087,
      "end": 4155,
      "text": " آواكم المدينةَ. وكذلك قولُه: {وَأَيَّدَكُمْ بِنَصْرِهِ}: بالأنصارِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4117,
          "end": 4143,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4159,
      "end": 4201,
      "text": "وبنحوِ الذي قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s055",
      "start": 4205,
      "end": 4220,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s056",
      "start": 4224,
      "end": 4255,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s057",
      "start": 4255,
      "end": 4283,
      "text": " ثنا أحمدُ بنُ مفضَّلٍ، قال:",
      "markers": []
    },
    {
      "id": "s058",
      "start": 4283,
      "end": 4325,
      "text": " ثنا أسباطُ، عن السُّدِّىِّ: {فَآوَاكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4312,
          "end": 4324,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4325,
      "end": 4382,
      "text": " قال: إلى الأنصارِ بالمدينةِ، {وَأَيَّدَكُمْ بِنَصْرِهِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4355,
          "end": 4381,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4382,
      "end": 4464,
      "text": " وهؤلاءِ أصحابُ محمدٍ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، أيَّدهم بنصرِه يومَ بدرٍ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4405,
          "end": 4435,
          "span_id": "s060"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4454,
          "end": 4462,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4579,
      "end": 4580,
      "text": ".",
      "markers": []
    },
    {
      "id": "s062",
      "start": 4584,
      "end": 4623,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4584,
          "end": 4591,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 4623,
      "end": 4662,
      "text": " ثني حجَّاجٌ، عن ابنِ جريجٍ، عن عكرمةَ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4637,
          "end": 4662,
          "stripped": "عن ابن جريج، عن عكرمة:",
          "span_id": "s063"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 4640,
          "end": 4649,
          "span_id": "s063"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 4655,
          "end": 4660,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 4662,
      "end": 4748,
      "text": " {فَآوَاكُمْ وَأَيَّدَكُمْ بِنَصْرِهِ وَرَزَقَكُمْ مِنَ الطَّيِّبَاتِ}: يعنى المدينةَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4663,
          "end": 4732,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4767,
      "end": 4768,
      "text": ".",
      "markers": []
    }
  ],

          "end": 1458,
          "span_id": "s017"
        }
      ]
    },
    {
      "id": "s018",
      "start": 1490,
      "end": 1536,
      "text": " ثنى حجَّاجٌ، عن ابنِ جُريجٍ، عن عكرمةَ قولَه:",

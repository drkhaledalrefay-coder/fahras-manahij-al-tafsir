    },
    {
      "id": "s019",
      "start": 1536,
      "end": 1644,
      "text": " {وَاذْكُرُوا إِذْ أَنْتُمْ قَلِيلٌ مُسْتَضْعَفُونَ فِي الْأَرْضِ تَخَافُونَ أَنْ يَتَخَطَّفَكُمُ النَّاسُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1537,
          "end": 1643,
          "span_id": "s019"
        }
      ]
    },
    {
      "id": "s020",
      "start": 1644,
      "end": 1758,
      "text": " قال: يعنى بمكةَ، مع النبيِّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- ومن تبِعه من قريشٍ وحلفائِها ومواليها قبلَ الهجرةِ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1674,
          "end": 1704,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 1762,
      "end": 1792,
      "text": "حدَّثنا ابنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1762,
          "end": 1769,
          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 1792,
      "end": 1859,
      "text": " ثنا محمدُ بنُ ثورٍ، عن معمرٍ، عن الكَلْبيِّ، أو قتادةَ، أو كلاهما ",
      "markers": [

    {
      "id": "s001",
      "start": 4,
      "end": 167,
      "text": "القولُ في تأويلِ قولِه: {وَلَوْ تَرَى إِذْ يَتَوَفَّى الَّذِينَ كَفَرُوا الْمَلَائِكَةُ يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبَارَهُمْ وَذُوقُوا عَذَابَ الْحَرِيقِ (50)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28,
          "end": 166,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 171,
      "end": 226,
      "text": "يقولُ تعالى ذكرُه لنبيِّه محمدٍ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 205,
          "end": 223,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 226,
      "end": 361,
      "text": " ولو تُعايِنُ يا محمدُ حينَ يَتَوَفَّى الملائكةُ أرواحَ الكفارِ، فتَنزعُها مِن أجسادِهم، تَضْرِبُ الوجوهَ منهم والأسْتاهَ، ويقولون لهم:",
      "markers": []
    },
    {
      "id": "s004",
      "start": 361,
      "end": 417,
      "text": " ذُوقوا عذابَ النارِ التي تُحرِقُكم يومَ وُرودِكم جهنمَ.",
      "markers": []
    },
    {
      "id": "s005",
      "start": 421,
      "end": 463,
      "text": "وبنحوِ الذي قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s006",
      "start": 467,
      "end": 483,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s007",
      "start": 487,
      "end": 516,
      "text": "حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s008",
      "start": 516,
      "end": 583,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابِن أبى نَجيحٍ، عن مجاهدٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 547,
          "end": 583,
          "stripped": "عن ابن أبى نجيح، عن مجاهد قوله:",

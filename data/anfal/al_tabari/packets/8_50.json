      "start": 2245,
      "end": 2326,
      "text": " ثنا إسرائيلُ، عن منصورٍ، عن مجاهدٍ، أن رجلًا قال للنبيِّ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2260,
          "end": 2294,
          "stripped": "عن منصور، عن مجاهد، أن رجلا قال",
          "span_id": "s035"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 2274,
          "end": 2279,
          "span_id": "s035"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2305,
          "end": 2323,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 2326,
      "end": 2388,
      "text": " إلى حمَلْتُ على رجلٍ مِن المشركين، فذهَبْتُ لأضْرِبَه، فندَر ",
      "markers": []
    },
    {
      "id": "s037",
      "start": 2424,
      "end": 2459,
      "text": " رأسه! فقال: \"سبَقك إليه المَلَكُ\".",
      "markers": []
    },
    {
      "id": "s038",
      "start": 2463,
      "end": 2506,
      "text": "حدَّثني يونُسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2484,
          "end": 2491,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 2506,
      "end": 2546,
      "text": " ثنى حَرْملة، أنه سمِع عمرَ مولى غُفْرة ",
      "markers": []
    },
    {
      "id": "s040",
      "start": 2577,
      "end": 2608,
      "text": " يقولُ: إذا سمِعْتَ الله يقولُ:",
      "markers": []
    },
    {
      "id": "s041",
      "start": 2608,
      "end": 2675,
      "text": " {يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبَارَهُمْ}. فإنما يُرِيدُ أستاهَهم ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2609,
          "end": 2650,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 2721,
      "end": 2722,
      "text": ".",
      "markers": []
    },
    {
      "id": "s043",
      "start": 2726,
      "end": 2811,
      "text": "قال أبو جعفرٍ: وفى الكلامِ محذوفٌ اسْتغْنِى بدلالةِ الظاهرِ عليه مِن ذكرِه، وهو قوله:",
      "markers": []
    },
    {
      "id": "s044",
      "start": 2811,
      "end": 2891,
      "text": " ويقولون: {وَذُوقُوا عَذَابَ الْحَرِيقِ}. حُذفت \"يقولون\"، كما حُذِفَت مِن قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2821,
          "end": 2851,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 2891,
      "end": 2998,
      "text": " {وَلَوْ تَرَى إِذِ الْمُجْرِمُونَ نَاكِسُو رُءُوسِهِمْ عِنْدَ رَبِّهِمْ رَبَّنَا أَبْصَرْنَا وَسَمِعْنَا} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2892,
          "end": 2997,
          "span_id": "s045"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 2998,
          "end": 3010,
          "text": "[السجدة: 12]",
          "via": "apparatus",
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3010,
      "end": 3045,
      "text": ". بمعنى: يقولون: ربَّنا أَبْصَرْنا.",
      "markers": []
    }
  ],

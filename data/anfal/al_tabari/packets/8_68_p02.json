      ]
    },
    {
      "id": "s143",
      "start": 11055,
      "end": 11105,
      "text": " \"لو عُذِّبنا في هذا الأمرِ يا عمرُ ما نجا غيرُك\".",
      "markers": []
    },
    {
      "id": "s144",
      "start": 11105,
      "end": 11162,
      "text": " قال اللَّهُ: لا تعودوا تَستَحِلُّون قبلَ أن أُحِلَّ لكم ",
      "markers": []
    },
    {
      "id": "s145",
      "start": 11225,
      "end": 11226,
      "text": ".",
      "markers": []
    },
    {
      "id": "s146",
      "start": 11230,
      "end": 11271,
      "text": "حدَّثنا ابن حميدٍ، قال: ثنا سَلَمةُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11230,
          "end": 11237,
          "span_id": "s146"
        }
      ]
    },
    {
      "id": "s147",
      "start": 11271,
      "end": 11301,
      "text": " قال ابن إسحاقَ: لمّا نَزَلَت:",
      "markers": []
    },
    {
      "id": "s148",
      "start": 11301,
      "end": 11388,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ} الآية، قال رسولُ اللَّهِ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11302,
          "end": 11339,
          "span_id": "s148"
        },
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 11347,
          "end": 11363,
          "span_id": "s148"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11367,
          "end": 11385,
          "span_id": "s148"
        }
      ]
    },
    {
      "id": "s149",
      "start": 11388,
      "end": 11449,
      "text": " \"لو نَزَل عذابٌ من السماءِ لم ينْجُ منه إلا سعدُ بنُ معاذٍ\".",
      "markers": []
    },
    {
      "id": "s150",
      "start": 11449,
      "end": 11530,
      "text": " لقوله: يا نبيَّ اللَّهِ، كان الإثخانُ في القتلِ أحبَّ إليَّ من استبقاءِ الرجالِ ",
      "markers": []
    },
    {
      "id": "s151",
      "start": 11628,
      "end": 11629,
      "text": ".",
      "markers": []
    }
  ],

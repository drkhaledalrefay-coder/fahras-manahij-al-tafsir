          "span_id": "s119"
        }
      ]
    },
    {
      "id": "s120",
      "start": 9186,
      "end": 9241,
      "text": " مما أسَرْتم. ثم قال بعد: {فَكُلُوا مِمَّا غَنِمْتُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9212,
          "end": 9240,
          "span_id": "s120"
        }
      ]
    },
    {
      "id": "s121",
      "start": 9245,
      "end": 9299,
      "text": "حدَّثنا ابن حميدٍ، قال: ثنا سلمةُ، عن ابن إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9245,
          "end": 9252,
          "span_id": "s121"
        }
      ]
    },
    {
      "id": "s122",
      "start": 9299,
      "end": 9393,
      "text": " عاتَبَه في الأسارى وأخذِ الغنائمِ، ولم يكنْ أحدٌ قبلَه من الأنبياءِ يأكلُ مغنمًا من عدوٍّ له ",
      "markers": []
    },
    {
      "id": "s123",
      "start": 9416,
      "end": 9417,
      "text": ".",
      "markers": []
    },
    {
      "id": "s124",
      "start": 9421,
      "end": 9470,
      "text": "حدَّثنا ابن حميدٍ، قال: ثنا سلمةُ، عن محمدٍ، قال ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9421,
          "end": 9428,
          "span_id": "s124"
        }
      ]
    },
    {
      "id": "s125",
      "start": 9512,
      "end": 9579,
      "text": ": ثني أبو جعفرٍ محمدُ بن عليّ بن الحسينِ بن عليّ بن أبى طالبٍ، قال:",
      "markers": []
    },
    {
      "id": "s126",
      "start": 9579,
      "end": 9617,
      "text": " قال رسولُ اللَّهِ صلى الله عليه وسلم:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 9580,
          "end": 9596,
          "span_id": "s126"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 9598,
          "end": 9616,
          "span_id": "s126"
        }
      ]
    },
    {
      "id": "s127",
      "start": 9617,
      "end": 9809,
      "text": " \"نُصرتُ بالرُّعبِ، وجُعِلَت لِىَ الأرضُ مسجدًا وطَهورًا، وأُعطِيتُ جوامعَ الكَلِمِ، وأُحِلَّت لىَ المغائمُ ولم تَحِلُّ لنبيٍّ كان قَبْلى، وأُعطِيتُ الشفاعةَ، خمسٌ لم يؤتهنَّ نبيٌّ كان قبْلى\".",
      "markers": []
    },
    {
      "id": "s128",
      "start": 9809,
      "end": 9849,
      "text": " قال محمدٌ: فقال: {مَا كَانَ لِنَبِيٍّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9827,
          "end": 9848,
          "span_id": "s128"
        }
      ]
    },
    {
      "id": "s129",
      "start": 9849,
      "end": 9898,
      "text": " أي: قبلَك {أَنْ يَكُونَ لَهُ أَسْرَى}، إلى قوله:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 9850,
          "end": 9853,
          "span_id": "s129"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9860,
          "end": 9887,
          "span_id": "s129"
        }
      ]
    },
    {
      "id": "s130",
      "start": 9898,
      "end": 9967,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9899,
          "end": 9966,
          "span_id": "s130"
        }
      ]
    },
    {
      "id": "s131",
      "start": 9967,
      "end": 10013,
      "text": " أي: من الأُسارى والمغانمِ، {عَذَابٌ عَظِيمٌ}:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 9968,
          "end": 9971,
          "span_id": "s131"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9995,
          "end": 10012,
          "span_id": "s131"
        }
      ]
    },
    {
      "id": "s132",
      "start": 10013,
      "end": 10178,
      "text": " أي لولا أنه سبَق منى أن لا أُعَذِّبَ إلا بعدَ النهى، ولم أكُنْ نَهَيتُكم، لعذَّبتُكم فيما صنَعتم، ثم أُحِلُّها له ولهم، رحمةً ونعمةً وعائدةً من الرحمنِ الرحيمِ (1).",
      "markers": []
    },
    {
      "id": "s133",
      "start": 10182,
      "end": 10248,
      "text": "قال أبو جعفرٍ: وأولى الأقوالِ في ذلك بالصوابِ ما قد بَيَّناه قبلُ.",
      "markers": []
    },
    {
      "id": "s134",
      "start": 10248,
      "end": 10302,
      "text": " وذلك أن قولَه: {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10264,
          "end": 10301,
          "span_id": "s134"
        }
      ]
    },
    {
      "id": "s135",
      "start": 10302,
      "end": 10559,
      "text": " خبرٌ عامٌّ غيرُ محصورٍ على معنًى دونَ معنًى، وكلُّ هذه المعانى التي ذكرتُها عمَّن ذكَرتُ مما قد سبَق في كتابِ اللَّهِ أَنه لا يُؤَاخِذُ بشيءٍ منها هذه الأمةَ، وذلك ما عَمِلوا من عملٍ بجهالةٍ، وإحلال الغنيمةِ، والمغفرةُ لأهلِ بدرٍ، وكلُّ ذلك مما كُتِبَ لهم.",
      "markers": []
    },
    {
      "id": "s136",
      "start": 10559,
      "end": 10599,
      "text": " وإذ كان ذلك كذلك، فلا وجهَ لأن يَخُصَّ ",
      "markers": []
    },
    {
      "id": "s137",
      "start": 10630,
      "end": 10731,
      "text": " من ذلك معنًى دونَ معنًى، وقد عَمَّ اللَّهُ الخبرَ بكلِّ ذلك بغيرِ دلالةٍ توجِبُ صحةَ القولُ بخصوصِه.",
      "markers": []
    },
    {
      "id": "s138",
      "start": 10735,
      "end": 10777,
      "text": "حدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 10755,
          "end": 10762,
          "span_id": "s138"
        }
      ]
    },
    {
      "id": "s139",
      "start": 10777,
      "end": 10920,
      "text": " قال ابن زيدٍ: لم يكنْ من المؤمنين أَحدٌ ممَّن نُصِرَ إلا أحبَّ الغنائمَ إلا عمرَ بنَ الخطابِ، جعَل لا يَلْقَى أسيرًا إِلا ضَرَب عُنُقَه، وقال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 10782,
          "end": 10789,
          "span_id": "s139"
        }
      ]
    },
    {
      "id": "s140",
      "start": 10920,
      "end": 10956,
      "text": " يا رسولَ اللَّهِ، ما لنا وللغنائمِ؟",
      "markers": []
    },
    {
      "id": "s141",
      "start": 10956,
      "end": 11012,
      "text": " نحن قومٌ نُجَاهِدُ في دينِ اللَّهِ حتى يُعبَدَ اللَّهُ.",
      "markers": []
    },
    {
      "id": "s142",
      "start": 11012,
      "end": 11055,
      "text": " فقال رسولُ اللَّهِ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 11014,
          "end": 11030,
          "span_id": "s142"
        },

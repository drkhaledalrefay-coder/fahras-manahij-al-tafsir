          "span_id": "s118"
        }
      ]
    },
    {
      "id": "s119",
      "start": 9150,
      "end": 9186,
      "text": " قال ابن عباسٍ: {فِيمَا أَخَذْتُمْ}:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 9155,

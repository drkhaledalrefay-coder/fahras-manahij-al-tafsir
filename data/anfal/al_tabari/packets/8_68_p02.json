          "end": 8833,
          "span_id": "s115"
        }
      ]
    },
    {
      "id": "s116",
      "start": 8841,
      "end": 8904,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ} لأهل بدرٍ ومشهدَهم إياه.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8842,
          "end": 8879,
          "span_id": "s116"
        }
      ]
    },
    {
      "id": "s117",
      "start": 8904,
      "end": 9031,
      "text": " قال: كتابٌ سبَق؛ لقولِه: {وَمَا كَانَ اللَّهُ لِيُضِلَّ قَوْمًا بَعْدَ إِذْ هَدَاهُمْ حَتَّى يُبَيِّنَ لَهُمْ مَا يَتَّقُونَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8930,
          "end": 9030,
          "span_id": "s117"

    },
    {
      "id": "s113",
      "start": 8740,
      "end": 8755,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s114",
      "start": 8759,
      "end": 8798,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8759,
          "end": 8766,
          "span_id": "s114"
        }
      ]
    },
    {
      "id": "s115",
      "start": 8798,
      "end": 8841,
      "text": " ثني حجاجٌ، عن ابن جُريجٍ، عن مجاهدٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",

    {
      "id": "s111",
      "start": 8586,
      "end": 8687,
      "text": "وقال آخرون: معنى ذلك: {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ} أن لا يؤاخذَ أحدًا بفعلٍ أتاه على جهالةٍ؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8608,
          "end": 8645,
          "span_id": "s111"
        }
      ]
    },
    {
      "id": "s112",
      "start": 8687,
      "end": 8736,
      "text": " {لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8688,
          "end": 8735,

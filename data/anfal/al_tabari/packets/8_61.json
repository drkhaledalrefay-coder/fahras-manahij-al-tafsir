    {
      "id": "s001",
      "start": 4,
      "end": 138,
      "text": "القولُ في تأويلِ قوله: {وَإِنْ جَنَحُوا لِلسَّلْمِ فَاجْنَحْ لَهَا وَتَوَكَّلْ عَلَى اللَّهِ إِنَّهُ هُوَ السَّمِيعُ الْعَلِيمُ (61)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 27,
          "end": 137,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 142,
      "end": 197,
      "text": "يقولُ تعالى ذكرُه لنبيِّه محمدٍ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 176,
          "end": 194,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 197,
      "end": 327,
      "text": " وإما تخافَنَّ مِن قومٍ خِيانَةً وغدرًا، فانْبِذْ إليهم على سواءٍ، وآذِنْهم بالحربِ، {وَإِنْ جَنَحُوا لِلسَّلْمِ فَاجْنَحْ لَهَا}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 282,
          "end": 326,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 327,
      "end": 502,
      "text": " وإن مالوا إلى مسالمَتِك، ومُتارَكتِك الحربَ، إما بالدخولِ في الإسلامِ، وإما بإعطاءِ الجزيةِ، وإما بموادَعَةٍ، ونحوِ ذلك من أسبابِ السَّلْمِ والصلحِ، {فَاجْنَحْ لَهَا}، يقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 477,
          "end": 494,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 502,
      "end": 558,
      "text": " فمِلْ إليها، وابْذُل لهم ما مالوا إليه مِن ذلك وسألوكه.",
      "markers": []
    },
    {
      "id": "s006",
      "start": 562,
      "end": 661,
      "text": "يقالُ منه منه: جنَح الرجلُ إلى كذا يَجْنَحُ إليه جُنوحًا، وهى لتَميمٍ، وقيسٍ فيما ذُكِر عنها تقولُ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 562,
          "end": 566,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 661,
      "end": 701,
      "text": " يَجْنُحُ، بضمِّ النونِ. وآخرون: يقولون:",
      "markers": []
    },
    {
      "id": "s008",
      "start": 701,
      "end": 738,
      "text": " يَجْنِحُ بكسرِ النونِ، وذلك إذا مال.",
      "markers": []
    },
    {
      "id": "s009",
      "start": 738,
      "end": 769,
      "text": " ومنه قولُ نابغةِ بني ذُبْيانَ ",
      "markers": []
    },
    {
      "id": "s010",
      "start": 783,
      "end": 784,
      "text": ":",
      "markers": []
    },
    {
      "id": "s011",
      "start": 788,
      "end": 826,
      "text": "جَوانِحَ قَدْ أَيْقَنَّ أَن قَبِيلَه .",
      "markers": []
    },
    {
      "id": "s012",
      "start": 826,
      "end": 868,
      "text": ".. إذا ما الْتَقَى الجَمْعَانِ أولُ غالِبِ",
      "markers": []
    },
    {
      "id": "s013",
      "start": 872,
      "end": 888,
      "text": "جوانحُ: مَوائلُ.",
      "markers": []
    },
    {
      "id": "s014",
      "start": 892,
      "end": 935,
      "text": "وبنحوِ الذي قلْنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s015",
      "start": 939,
      "end": 955,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s016",
      "start": 959,
      "end": 994,
      "text": "حدَّثنا محمدُ بنُ عبدِ الأعلى، قال:",

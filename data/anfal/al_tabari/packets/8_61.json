      "end": 2617,
      "text": " ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 2617,
          "end": 2629,
          "text": "[التوبة: 29]",
          "via": "apparatus",
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 2629,
      "end": 2630,
      "text": ".",
      "markers": []
    },
    {
      "id": "s041",
      "start": 2634,
      "end": 2665,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s042",
      "start": 2665,
      "end": 2693,
      "text": " ثنا أحمدُ بنُ المفضلِ، قال:",
      "markers": []
    },
    {
      "id": "s043",
      "start": 2693,
      "end": 2764,
      "text": " ثنا أسْباطُ، عن السديِّ: {وَإِنْ جَنَحُوا لِلسَّلْمِ فَاجْنَحْ لَهَا}.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 2710,
          "end": 2715,
          "span_id": "s043"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2719,
          "end": 2763,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 2764,
      "end": 2798,
      "text": " يقولُ: وإن أرادوا الصلحَ فأرِدْه ",
      "markers": []
    },
    {
      "id": "s045",
      "start": 2861,
      "end": 2862,
      "text": ".",
      "markers": []
    },
    {
      "id": "s046",
      "start": 2866,
      "end": 2915,
      "text": "حدَّثنا ابن حميدٍ، قال: ثنا سلمةُ، عن ابن إسحاقَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2866,
          "end": 2873,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 2915,
      "end": 2965,
      "text": " {وَإِنْ جَنَحُوا لِلسَّلْمِ فَاجْنَحْ لَهَا}، أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2916,
          "end": 2960,
          "span_id": "s047"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 2962,
          "end": 2965,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 2965,
      "end": 3020,
      "text": " إن دعَوْك إلى السَّلْمِ، إلى الإسلامِ، فصالِحْهم عليه ",
      "markers": []
    },
    {
      "id": "s049",
      "start": 3043,
      "end": 3044,
      "text": ".",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3048,
      "end": 3092,
      "text": "حدَّثني يونُسُ، قال: أخْبرَنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3069,
          "end": 3077,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3092,
      "end": 3115,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 3097,
          "end": 3104,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 3115,
      "end": 3161,
      "text": " {وَإِنْ جَنَحُوا لِلسَّلْمِ فَاجْنَحْ لَهَا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3116,
          "end": 3160,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 3161,
      "end": 3206,
      "text": " قال: فصالِحْهم، قال: وهذا قد نسَخَه الجهادُ ",
      "markers": []
    },
    {
      "id": "s054",
      "start": 3238,
      "end": 3239,
      "text": ".",
      "markers": []
    },
    {
      "id": "s055",
      "start": 3243,
      "end": 3368,
      "text": "فأما ما قاله قتادةُ ومَن قال مثلَ قولِه مِن أن هذه الآيةَ منسوخةٌ، فقولٌ لا دَلالةَ عليه مِن كتابٍ ولا سنةٍ ولا فِطْرةِ عقلٍ.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 3256,
          "end": 3261,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 3372,
      "end": 3530,
      "text": "وقد دلَّلْنا في غيرِ موضعٍ مِن كتابِنا هذا وغيرِه، على أن الناسخَ لا يكونُ إلا ما نفَى حكمَ المنسوخِ مِن كلِّ وجهٍ، فأما ما كان بخلافِ ذلك فغيرُ كائنٍ ناسخًا.",
      "markers": []
    },
    {
      "id": "s057",
      "start": 3534,
      "end": 3613,
      "text": "وقولُ اللَّهِ في \"براءةَ\": {فَاقْتُلُوا الْمُشْرِكِينَ حَيْثُ وَجَدْتُمُوهُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3561,
          "end": 3612,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 3613,
      "end": 3641,
      "text": " غيرُ نافٍ حكمُه حكمَ قولِه:",
      "markers": []
    },
    {
      "id": "s059",
      "start": 3641,
      "end": 3687,
      "text": " {وَإِنْ جَنَحُوا لِلسَّلْمِ فَاجْنَحْ لَهَا}؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3642,
          "end": 3686,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 3687,
      "end": 3728,
      "text": " لأن قولَه: {وَإِنْ جَنَحُوا لِلسَّلْمِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3699,
          "end": 3727,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 3728,
      "end": 3884,
      "text": " إنما عُنِى به بنو قريظةَ، وكانوا يهودًا أهلَ كتابٍ، وقد أذِن اللَّهُ جَلَّ ثناؤُه للمؤمنين بصلحِ أهلِ الكتابِ، ومُتارَكتِهم الحربَ، على أخْذِ الجزيةِ منهم.",
      "markers": [
        {
          "family": "ISRAILIYYAT",
          "marker": "أهل الكتاب",
          "start": 3826,
          "end": 3837,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 3888,
      "end": 3952,
      "text": "وأما قولُه: {فَاقْتُلُوا الْمُشْرِكِينَ حَيْثُ وَجَدْتُمُوهُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3900,
          "end": 3951,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 3952,
      "end": 4126,
      "text": " فإنما عُنِى به مشركو العربِ مِن عَبَدة الأوثانِ الذين لا يَجوزُ قبولُ الجزيةِ منهم، فليس في إحدى الآيتين نفيُ حكمِ الأخرى، بل كلُّ واحدةٍ منهما مُحْكَمةٌ فيما أُنْزِلَت فيه.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "نزلت في",
          "start": 4114,
          "end": 4124,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 4130,
      "end": 4159,
      "text": "حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s065",
      "start": 4159,
      "end": 4219,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابن أبي نَجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4190,
          "end": 4219,
          "stripped": "عن ابن أبي نجيح، عن مجاهد:",
          "span_id": "s065"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 4212,
          "end": 4217,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 4219,
      "end": 4262,
      "text": " {وَإِنْ جَنَحُوا لِلسَّلْمِ}. قال: قريظةُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4220,
          "end": 4248,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 4377,
      "end": 4378,
      "text": ".",
      "markers": []
    },
    {
      "id": "s068",
      "start": 4382,
      "end": 4422,
      "text": "وأما قولُه: {وَتَوَكَّلْ عَلَى اللَّهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4394,
          "end": 4421,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 4422,
      "end": 4500,
      "text": " يقولُ: فوِّضْ إلى اللَّهِ يا محمدُ أمرَك، واسْتَكْفِه واثقًا به أنه يَكْفِيك.",
      "markers": []
    },
    {
      "id": "s070",
      "start": 4504,
      "end": 4533,
      "text": "كالذي حدَّثنا ابن حميدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4510,
          "end": 4517,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 4533,
      "end": 4559,
      "text": " ثنا سلمةُ، عن ابن إسحاقَ:",
      "markers": []
    },
    {
      "id": "s072",
      "start": 4559,
      "end": 4603,
      "text": " {وَتَوَكَّلْ عَلَى اللَّهِ}: إن الله كافيك ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4560,
          "end": 4587,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 4626,
      "end": 4627,
      "text": ".",
      "markers": []
    },
    {
      "id": "s074",
      "start": 4631,
      "end": 4676,
      "text": "وقولُه: {إِنَّهُ هُوَ السَّمِيعُ الْعَلِيمُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4639,
          "end": 4675,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 4676,
      "end": 4845,
      "text": " يعنى بذلك: إن اللَّهَ الذي تَتَوَكَّلُ عليه سميعٌ لما تَقولُ أنت ومَن تُسالِمُه وتُتارِكُه الحربَ مِن أعداءِ اللَّهِ وأعدائِك، عندَ عقدِ السَّلْمِ بينَك وبينَه، وبشرطِ ",
      "markers": []
    },
    {
      "id": "s076",
      "start": 4889,
      "end": 5086,
      "text": " كلِّ فريقٍ منكم على صاحبِه مِن الشروطِ، و {الْعَلِيمُ} بما يُضْمِرُه كلُّ فريقٍ منكم للفريقِ الآخرِ مِن الوفاءِ بما عاقَدَه عليه، ومَن المُضْمِرُ ذلك منكم في قلبه، والمُنْطَوِى على خلافِه لصاحبِه ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4932,
          "end": 4944,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 5135,
      "end": 5136,
      "text": ".",
      "markers": []
    }
  ],

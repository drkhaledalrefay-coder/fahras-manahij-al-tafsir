    },
    {
      "id": "s130",
      "start": 8746,
      "end": 8803,
      "text": " {وَأَنَّ اللَّهَ مَعَ الْمُؤْمِنِينَ}. يقولُ جلَّ ذكرُه:",
      "markers": [

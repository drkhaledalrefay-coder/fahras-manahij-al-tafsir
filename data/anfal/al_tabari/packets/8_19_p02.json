      "start": 9849,
      "end": 9952,
      "text": " - إظهارَ دينِه، وإعلاءَ كلمتِه من قبلِ أن يستفتحَ أبو جهلٍ وحزبُه، فلا وجهَ لأن يُقالَ -والأمرُ كذلك-:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 9930,
          "end": 9935,
          "span_id": "s147"
        }
      ]
    },
    {
      "id": "s148",
      "start": 9952,
      "end": 10011,
      "text": " إن تنتهُوا عن الاستفتاحِ، فهو خيرٌ لكم، وإن تعودوا نَعُدْ؛",
      "markers": []
    },
    {
      "id": "s149",
      "start": 10011,
      "end": 10089,
      "text": " لأن اللهَ قد كان وعَد نبيَّه -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- الفتحَ بقولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 10042,
          "end": 10072,
          "span_id": "s149"
        }
      ]
    },
    {
      "id": "s150",
      "start": 10089,
      "end": 10187,
      "text": " {أُذِنَ لِلَّذِينَ يُقَاتَلُونَ بِأَنَّهُمْ ظُلِمُوا وَإِنَّ اللَّهَ عَلَى نَصْرِهِمْ لَقَدِيرٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10090,
          "end": 10186,
          "span_id": "s150"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 10187,
          "end": 10197,
          "text": "[الحج: 39]",
          "via": "apparatus",
          "span_id": "s150"
        }
      ]
    },
    {
      "id": "s151",
      "start": 10197,
      "end": 10234,
      "text": "، اسْتَفْتَح المشركون أو لم يستفتحوا.",
      "markers": []
    },
    {
      "id": "s152",
      "start": 10238,
      "end": 10253,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s153",
      "start": 10257,
      "end": 10288,
      "text": "حدَّثنا محمدُ بنُ الحسينِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10257,
          "end": 10264,
          "span_id": "s153"
        }
      ]
    },
    {
      "id": "s154",
      "start": 10288,
      "end": 10316,
      "text": " ثنا أحمدُ بنُ مفضَّلٍ، قال:",
      "markers": []
    },
    {
      "id": "s155",
      "start": 10316,
      "end": 10371,
      "text": " ثنا أسباطُ، عن السُّدِّيِّ: {وَإِنْ تَعُودُوا نَعُدْ}:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 10332,
          "end": 10341,
          "span_id": "s155"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10345,
          "end": 10370,
          "span_id": "s155"
        }
      ]
    },
    {
      "id": "s156",
      "start": 10371,
      "end": 10548,
      "text": " إن تستفتحوا الثانيةَ نفتَحْ لمحمدٍ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، {وَلَنْ تُغْنِيَ عَنْكُمْ فِئَتُكُمْ شَيْئًا وَلَوْ كَثُرَتْ وَأَنَّ اللَّهَ مَعَ الْمُؤْمِنِينَ}: محمدًا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 10408,
          "end": 10438,
          "span_id": "s156"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10442,
          "end": 10539,
          "span_id": "s156"
        }
      ]
    },
    {
      "id": "s157",
      "start": 10563,
      "end": 10573,
      "text": " وأصحابَه ",
      "markers": []
    },
    {
      "id": "s158",
      "start": 10731,
      "end": 10732,
      "text": ".",
      "markers": []
    },
    {
      "id": "s159",
      "start": 10736,
      "end": 10772,
      "text": "واخْتَلفت القرَأَةُ فى قراءةِ قولِه:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 10748,
          "end": 10752,
          "span_id": "s159"
        },
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 10759,
          "end": 10764,
          "span_id": "s159"
        }
      ]
    },
    {
      "id": "s160",
      "start": 10772,
      "end": 10847,
      "text": " {وَأَنَّ اللَّهَ مَعَ الْمُؤْمِنِينَ}؛ ففتَحها عامةُ قرأَةِ أهلِ المدينةِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10773,
          "end": 10810,
          "span_id": "s160"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 10826,
          "end": 10829,
          "span_id": "s160"
        }
      ]
    },
    {
      "id": "s161",
      "start": 10911,
      "end": 10981,
      "text": " بمعنى: ولن تُغنيَ عنكم فئتُكم شيئًا ولو كثُرت، وأن اللهَ مع المؤمنين.",
      "markers": []
    },
    {
      "id": "s162",
      "start": 10981,
      "end": 11027,
      "text": " فعطَف بـ \"أن\" على موضعِ \"ولو كثُرت\" كأنه قال:",
      "markers": []
    },
    {
      "id": "s163",
      "start": 11027,
      "end": 11061,
      "text": " لكثرتِها، ولأن اللهَ مع المؤمنين.",
      "markers": []
    },
    {
      "id": "s164",
      "start": 11061,
      "end": 11108,
      "text": " ويكونُ موضعُ \"أن\" حينئذٍ نصبًا على هذا القولِ.",
      "markers": []
    },
    {
      "id": "s165",
      "start": 11112,
      "end": 11170,
      "text": "وقد كان بعضُ أهلِ العربيةِ يزعُمُ أن فتحَها إذا فُتحت على:",
      "markers": []
    },
    {
      "id": "s166",
      "start": 11170,
      "end": 11282,
      "text": " {وَأَنَّ اللَّهَ مُوهِنُ كَيْدِ الْكَافِرِينَ}، {وَأَنَّ اللَّهَ مَعَ الْمُؤْمِنِينَ} عطفًا بالأخرى على الأولى.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11171,
          "end": 11217,
          "span_id": "s166"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11219,
          "end": 11256,
          "span_id": "s166"
        }
      ]
    },
    {
      "id": "s167",
      "start": 11286,
      "end": 11326,
      "text": "وقرأ ذلك عامةُ قرأةِ الكوفيين والبصريين:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 11287,
          "end": 11290,
          "span_id": "s167"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 11301,
          "end": 11304,
          "span_id": "s167"
        }
      ]
    },
    {
      "id": "s168",
      "start": 11326,
      "end": 11366,
      "text": " (وإن اللهَ) بكسرِ الألفِ على الابتداءِ ",
      "markers": []
    },
    {
      "id": "s169",
      "start": 11448,
      "end": 11484,
      "text": "، واعتلوا بأنها في قراءة عبدِ اللهِ ",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 11467,
          "end": 11472,
          "span_id": "s169"
        }
      ]
    },
    {
      "id": "s170",
      "start": 11509,
      "end": 11510,
      "text": " ",
      "markers": []
    },
    {
      "id": "s171",
      "start": 11624,
      "end": 11625,
      "text": ".",
      "markers": []
    },
    {
      "id": "s172",
      "start": 11629,
      "end": 11689,
      "text": "وأولى القراءتين بالصوابِ قراءةُ مَن كسَر \"إن\" على الابتداءِ ",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 11654,
          "end": 11659,
          "span_id": "s172"
        }
      ]
    },
    {
      "id": "s173",
      "start": 11714,
      "end": 11795,
      "text": "؛ لتقضِّى الخبرِ قبل ذلك عمَّا يَقْتضى قولُه: (وَإِنَّ اللهَ مَعَ المُؤْمِنِينَ).",
      "markers": []
    }
  ],

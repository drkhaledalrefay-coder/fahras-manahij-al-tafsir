    },
    {
      "id": "s127",
      "start": 8406,
      "end": 8476,
      "text": "وقولُه: {وَلَنْ تُغْنِيَ عَنْكُمْ فِئَتُكُمْ شَيْئًا وَلَوْ كَثُرَتْ}.",

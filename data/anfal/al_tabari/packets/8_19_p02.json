    {
      "id": "s106",
      "start": 6972,
      "end": 7031,
      "text": "حدَّثنا ابنُ حُميدٍ، قال: ثنا سَلَمةُ، عن ابنِ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6972,
          "end": 6979,
          "span_id": "s106"
        }
      ]
    },
    {
      "id": "s107",
      "start": 7031,
      "end": 7125,
      "text": " ثنى محمدُ بنُ مسلمٍ الزُّهْرِيُّ، عن عبدِ اللهِ بنِ ثعلبةَ بنِ صُعيرٍ حليفِ بني زُهْرةَ، قال:",
      "markers": []
    },
    {
      "id": "s108",
      "start": 7125,
      "end": 7180,
      "text": " لما الْتَقى الناسُ، ودنا بعضُهم من بعضٍ، قال أبو جهلٍ:",
      "markers": []
    },
    {
      "id": "s109",
      "start": 7180,
      "end": 7245,
      "text": " اللهمَّ أقطعُنا للرحمِ، وآتانا بما لا نَعرِفُ، فأَحِنْه الغداةَ ",
      "markers": []
    },
    {
      "id": "s110",
      "start": 7278,
      "end": 7308,
      "text": ". فكان هو المستفتحَ على نفسِه ",
      "markers": []
    },
    {
      "id": "s111",
      "start": 7353,
      "end": 7354,
      "text": ".",
      "markers": []
    },
    {
      "id": "s112",
      "start": 7358,
      "end": 7386,
      "text": "قال ابنُ إسحاقَ: فقال اللهُ:",
      "markers": []
    },
    {
      "id": "s113",
      "start": 7386,
      "end": 7436,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ}؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7387,
          "end": 7435,
          "span_id": "s113"
        }
      ]
    },
    {
      "id": "s114",
      "start": 7436,
      "end": 7488,
      "text": " لقولِ أبي جهلٍ: اللهمَّ أقطعُنا للرحمِ، وآتانا لما ",
      "markers": []
    },
    {
      "id": "s115",
      "start": 7502,
      "end": 7568,
      "text": " لا نعرِفُ، فأحنْه الغداةَ. قال: والاستفتاحُ: الإنصافُ فى الدعاءِ ",
      "markers": []
    },
    {
      "id": "s116",
      "start": 7677,
      "end": 7678,
      "text": ".",
      "markers": []
    },
    {
      "id": "s117",
      "start": 7682,
      "end": 7726,
      "text": "حدَّثني الحارثُ، قال: ثنا عبدُ العزيزِ، قال:",
      "markers": []
    },
    {
      "id": "s118",
      "start": 7726,
      "end": 7751,
      "text": " ثنا أبو معشرٍ، عن يزيدَ ",
      "markers": []
    },
    {
      "id": "s119",
      "start": 7765,
      "end": 7809,
      "text": " بنِ رُومانَ وغيرِه: قال أبو جهلٍ يومَ بدرٍ:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 7799,
          "end": 7807,
          "span_id": "s119"
        }
      ]
    },
    {
      "id": "s120",
      "start": 7809,
      "end": 7846,
      "text": " اللهمَّ انصُرْ أحبَّ الدِّينين إليك؛",
      "markers": []
    },
    {
      "id": "s121",
      "start": 7846,
      "end": 7881,
      "text": " دينِنا العتيقِ، أم دينِهم الحديثِ.",
      "markers": []
    },
    {
      "id": "s122",
      "start": 7881,
      "end": 8007,
      "text": " فَأَنْزل اللهُ عزَّ وجلَّ: {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ} إلى قولِه: {وَأَنَّ اللَّهَ مَعَ الْمُؤْمِنِينَ}.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 7882,
          "end": 7890,
          "span_id": "s122"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 7882,
          "end": 7895,
          "span_id": "s122"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7909,
          "end": 7957,
          "span_id": "s122"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7969,
          "end": 8006,
          "span_id": "s122"
        }
      ]
    },
    {
      "id": "s123",
      "start": 8011,
      "end": 8076,
      "text": "وأما قولُه: {وَإِنْ تَنْتَهُوا فَهُوَ خَيْرٌ لَكُمْ}، فإنه يقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8023,
          "end": 8063,
          "span_id": "s123"
        }
      ]
    },
    {
      "id": "s124",
      "start": 8076,
      "end": 8239,
      "text": " وإن تنتُهوا يا معشرَ قريشٍ وجماعةَ الكفارِ عن الكفرِ باللهِ ورسولِه، وقتال نبيِّه -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- والمؤمنين به، فهو خيرٌ لكم في دنياكم وآخرِتكم.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 8160,
          "end": 8190,
          "span_id": "s124"
        }
      ]
    },
    {
      "id": "s125",
      "start": 8239,
      "end": 8352,
      "text": " {وَإِنْ تَعُودُوا نَعُدْ}. يقولُ: وإن تعودُوا لحربِه وقتالِه وقتالِ أتباعِه المؤمنين، {نَعُدْ} أى بمثلِ الوقعةِ ",
      "markers": [
        {
          "family": "QURAN",

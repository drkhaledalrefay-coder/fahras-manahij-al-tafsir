          "span_id": "s125"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8326,
          "end": 8334,
          "span_id": "s125"
        }
      ]
    },
    {
      "id": "s126",
      "start": 8373,
      "end": 8402,
      "text": " التي أوْقعَتُ بكم يومَ بدرٍ.",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 8392,

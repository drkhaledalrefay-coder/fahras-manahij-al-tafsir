  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 186,
      "text": "القولُ في تأويلِ قولِه: {وَلَا تَكُونُوا كَالَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا وَرِئَاءَ النَّاسِ وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَاللَّهُ بِمَا يَعْمَلُونَ مُحِيطٌ (47)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28,
          "end": 185,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 190,
      "end": 253,
      "text": "وهذا تقدُّمٌ مِن الله جلَّ ثناؤُه إلى المؤمنين به وبرسولِه ألا ",
      "markers": []
    },
    {
      "id": "s003",
      "start": 266,
      "end": 431,
      "text": " يَعْمَلُوا عملًا إلا للهِ خاصةً، وطلَبِ ما عندَه، لا رِئَاءَ الناسِ، كما فعل القومُ مِن المشركين في مسيرِهم إلى بدرٍ طلبَ رئاءِ الناسِ، وذلك أنهم أُخْبِروا بفَوْتِ ",
      "markers": []
    },
    {
      "id": "s004",
      "start": 462,
      "end": 536,
      "text": " العِيرِ رسولَ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- وأصحابَه، وقيل لهم:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 484,
          "end": 514,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 536,
      "end": 587,
      "text": " انْصَرِفوا فقد سلِمَت العيرُ التي جئْتم لنصْرتِها.",
      "markers": []
    },
    {
      "id": "s006",
      "start": 587,
      "end": 692,
      "text": " فأبَوْا وقالوا: نَأْتِي بدرًا، فَنَشْرَبُ بها الخمرَ، وتَعْزِفُ علينا القِيانُ، وتَتَحَدَّثُ بنا العربُ ",
      "markers": []
    },
    {
      "id": "s007",
      "start": 716,
      "end": 722,
      "text": " فيها.",
      "markers": []
    },
    {
      "id": "s008",
      "start": 726,
      "end": 764,
      "text": "فَسُقُوا مكانَ الخمرِ كُئوسَ المَنايا.",
      "markers": []
    },
    {
      "id": "s009",
      "start": 768,
      "end": 814,
      "text": "كما حدَّثنا عبدُ الوارثِ بنُ عبدِ الصمدِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 772,
          "end": 779,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 814,
      "end": 844,
      "text": " ثني أبي، قال: ثنا أبانٌ، قال:",
      "markers": []
    },
    {
      "id": "s011",
      "start": 844,
      "end": 879,
      "text": " ثنا هشامُ بنُ عروةَ، عن عروةَ قال:",
      "markers": []
    },
    {
      "id": "s012",
      "start": 879,
      "end": 1031,
      "text": " كانت قريشٌ قبلَ أن يَلْقاهم النبيُّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- يومَ بدرٍ قد جاءهم راكبٌ مِن أبى سفيانَ والركبِ الذين معه: إنا قد أجَزْنا القومَ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 917,
          "end": 947,
          "span_id": "s012"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 950,
          "end": 958,
          "span_id": "s012"
        }
      ]
    },
    {
      "id": "s013",
      "start": 1045,
      "end": 1046,
      "text": " ",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1064,
      "end": 1156,
      "text": ". فجاء الركبُ الذين بعَثهم أبو سفيانَ الذين يَأْمُرُون قريشًا بالرَّجْعةِ بالجُحْفة، فقالوا:",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1156,
      "end": 1208,
      "text": " واللهِ لا نَرْجِعُ حتى نَنْزِلَ بدرًا، فنُقِيمَ به ",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1222,
      "end": 1329,
      "text": " ثلاثَ ليالٍ، ويَرانا مَن غَشِيَنا مِن أهلِ الحجازِ، فإنه لن يرانا أحدٌ مِن العربِ وما جمَعْنا فيُقاتِلَنا.",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1329,
      "end": 1418,
      "text": " وهم الذين قال اللهُ: {كَالَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا وَرِئَاءَ النَّاسِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1351,
          "end": 1417,
          "span_id": "s017"
        }
      ]
    },
    {
      "id": "s018",
      "start": 1418,
      "end": 1549,
      "text": " والْتَقَوْا هم والنبيُّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، ففتَح اللهُ على رسولِه، وأخْزَى أئمة الكفرِ، وشفَى صدورَ المؤمنين منهم ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1444,
          "end": 1474,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 1598,
      "end": 1599,
      "text": ".",
      "markers": []
    },
    {
      "id": "s020",
      "start": 1603,
      "end": 1643,
      "text": "حدَّثنا ابنُ حميدٍ، قال: ثنا سلمةُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1603,
          "end": 1610,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 1643,
      "end": 1680,
      "text": " ثنى ابنُ إسحاقَ في حديثٍ ذكَره، قال:",
      "markers": []
    },
    {
      "id": "s022",
      "start": 1680,
      "end": 1719,
      "text": " ثنى محمدُ بنُ مسلمٍ، وعاصمُ بنُ عُمرَ ",
      "markers": []
    },
    {
      "id": "s023",
      "start": 1788,
      "end": 1867,
      "text": "، وعبدُ اللَّهِ بنُ أَبي بكرٍ، ويزيدُ بنُ رُومانَ، عن عروةَ بنِ الزبيرِ وغيرِه ",
      "markers": []
    },
    {
      "id": "s024",
      "start": 1883,
      "end": 1917,
      "text": " مِن علمائِنا، عن ابنِ عباسٍ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 1901,
          "end": 1910,
          "span_id": "s024"
        }
      ]
    },
    {
      "id": "s025",
      "start": 1917,
      "end": 1976,
      "text": " لمَّا رأَى أبو سفيانَ أنه أحْرَز عِيرَه، أرْسَل إلى قريشٍ:",
      "markers": []
    },
    {
      "id": "s026",
      "start": 1976,
      "end": 2060,
      "text": " إنكم إنما خرَجْتم لتَمْنَعوا عيرَكم ورجالكم وأموالَكم، فقد نجَّاها اللهُ فارْجِعوا.",
      "markers": []
    },
    {
      "id": "s027",
      "start": 2060,
      "end": 2085,
      "text": " فقال أبو جهلِ بنُ هشامٍ:",
      "markers": []
    },
    {
      "id": "s028",
      "start": 2085,
      "end": 2366,
      "text": " واللَّهِ لا نَرْجِعُ حتى نَرِدَ بدرًا -وكان بدرٌ مَوْسمًا مِن مَواسمِ العربِ، يَجْتَمِعُ لهم بها سُوقٌ كلَّ عامٍ- فنُقِيمَ عليه ثلاثًا، ونَنْحَرَ الجُزُرَ، ونُطْعِمَ الطعامَ، ونَسْقِيَ الخمورَ، وتَعْزِفَ علينا القِيانُ، وتَسْمَعَ بنا العربَ فلا يَزالون يَهابُوننا أبدًا، فامْضُوا ",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2434,
      "end": 2435,
      "text": ".",
      "markers": []
    },
    {
      "id": "s030",
      "start": 2439,
      "end": 2469,
      "text": "قال ابن حميدٍ: ثنا سلمةُ، قال:",
      "markers": []
    },
    {
      "id": "s031",
      "start": 2469,
      "end": 2573,
      "text": " قال ابن إسحاقَ: {وَلَا تَكُونُوا كَالَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا وَرِئَاءَ النَّاسِ}، أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2486,
          "end": 2568,
          "span_id": "s031"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 2570,
          "end": 2573,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2573,
      "end": 2615,
      "text": " لا تكونوا كأبي جهلٍ وأصحابِه الذين قالوا:",
      "markers": []
    },
    {
      "id": "s033",
      "start": 2615,
      "end": 2762,
      "text": " لا تَرْجِعُ حتى نَأْتىَ بدرًا، ونَنْحَرَ بها الجُزُرَ، ونَسْقِى بها الخمرَ، وتَعْزِفَ علينا القِيانُ، وتَسْمَعَ بنا العربُ فلا يَزالون يَهابُوننا.",
      "markers": []
    },
    {
      "id": "s034",
      "start": 2762,
      "end": 2904,
      "text": " أي: لا يَكُونَنَّ أمرُكم رياءً ولا سُمْعةً ولا الْتماسَ ما عندَ الناسِ، وأخْلِصوا اللهِ النيةَ والحِسْبةَ في نصرِ دينِكم، ومُؤازَرةِ نبيِّكم.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 2763,
          "end": 2766,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2904,
      "end": 2953,
      "text": " أي: لا تَعْمَلُوا إلا للهِ، ولا تَطْلُبوا غيرَه ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 2905,
          "end": 2908,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 3103,
      "end": 3104,
      "text": ".",
      "markers": []
    },
    {
      "id": "s037",
      "start": 3108,
      "end": 3148,
      "text": "حدَّثني محمدُ بنُ عُمارة الأسَديُّ، قال:",
      "markers": []
    },
    {
      "id": "s038",
      "start": 3148,
      "end": 3179,
      "text": " ثنا عبيدُ اللهِ بنُ موسى، قال:",
      "markers": []
    },
    {
      "id": "s039",
      "start": 3179,
      "end": 3231,
      "text": " أَخْبرَنا إسرائيلُ، وحدَّثنا أحمدُ بنُ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3180,
          "end": 3189,
          "span_id": "s039"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3201,
          "end": 3208,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3231,
      "end": 3295,
      "text": " ثنا أبو أحمدَ، قال: ثنا إسرائيلُ، عن ابن أبي نَجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3266,
          "end": 3295,
          "stripped": "عن ابن أبي نجيح، عن مجاهد:",
          "span_id": "s040"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3288,
          "end": 3293,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 3295,
      "end": 3381,
      "text": " {كَالَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا وَرِئَاءَ النَّاسِ}. قال: أصحابُ بدرٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3296,
          "end": 3362,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 3502,
      "end": 3503,
      "text": ".",
      "markers": []
    },
    {
      "id": "s043",
      "start": 3507,
      "end": 3536,
      "text": "حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3536,
      "end": 3603,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابن أبي، نَجيحٍ، عن مجاهدٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3567,
          "end": 3603,
          "stripped": "عن ابن أبي، نجيح، عن مجاهد قوله:",
          "span_id": "s044"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 3590,
          "end": 3595,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3603,
      "end": 3667,
      "text": " {بَطَرًا وَرِئَاءَ النَّاسِ}. قال: أبو جهلٍ وأصحابُه يومَ بدرٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3604,
          "end": 3632,
          "span_id": "s045"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 3657,
          "end": 3665,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3761,
      "end": 3762,
      "text": ".",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3766,
      "end": 3805,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3766,
          "end": 3773,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3805,
      "end": 3848,
      "text": " ثني حجاجٌ، عن ابن جُريجٍ، عن مجاهدٍ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3817,
          "end": 3848,
          "stripped": "عن ابن جريج، عن مجاهد مثله.",
          "span_id": "s048"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 3820,
          "end": 3829,
          "span_id": "s048"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 3835,
          "end": 3840,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3848,
      "end": 3890,
      "text": " قال ابن جُريج: وقال عبدُ اللهِ بنُ كثيرٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 3853,
          "end": 3862,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 3890,
      "end": 3929,
      "text": " هم مشركو قريشٍ، وذلك خروجُهم إلى بدرٍ.",
      "markers": []
    },
    {
      "id": "s051",
      "start": 3933,
      "end": 3961,
      "text": "حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s052",
      "start": 3961,
      "end": 3989,
      "text": " ثنى أبي، قال: ثنى عمي، قال:",
      "markers": []
    },
    {
      "id": "s053",
      "start": 3989,
      "end": 4022,
      "text": " ثنى أبي، عن أبيه،، عن ابن عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3999,
          "end": 4022,
          "stripped": "عن أبيه،، عن ابن عباس:",
          "span_id": "s053"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4012,
          "end": 4020,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4022,
      "end": 4106,
      "text": " {وَلَا تَكُونُوا كَالَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا وَرِئَاءَ النَّاسِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4023,
          "end": 4105,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4106,
      "end": 4174,
      "text": " يعني: المشركين الذين قاتَلوا رسولَ - صلى الله عليه وسلم - يوم بدرٍ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4144,
          "end": 4162,
          "span_id": "s055"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4165,
          "end": 4172,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4289,
      "end": 4290,
      "text": ".",
      "markers": []
    },
    {
      "id": "s057",
      "start": 4294,
      "end": 4329,
      "text": "حدَّثنا محمدُ بنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4294,
          "end": 4301,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4329,
      "end": 4370,
      "text": " ثنا محمدُ بنُ ثورٍ، عن معمرٍ، عن قتادةَ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4350,
          "end": 4370,
          "stripped": "عن معمر، عن قتادة:",
          "span_id": "s058"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 4363,
          "end": 4368,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4370,
      "end": 4426,
      "text": " {خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا وَرِئَاءَ النَّاسِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4371,
          "end": 4425,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4426,
      "end": 4483,
      "text": " قال: هم قريشٌ وأبو جهلٍ وأصحابُه الذين خرَجوا يومَ بدرٍ ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4473,
          "end": 4481,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4530,
      "end": 4531,
      "text": ".",
      "markers": []
    },
    {
      "id": "s062",
      "start": 4535,
      "end": 4569,
      "text": "حدَّثنا بشرٌ، قال: ثنا يزيدُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4535,
          "end": 4542,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 4569,
      "end": 4745,
      "text": " ثنا سعيدٌ، عن قتادةَ: {وَلَا تَكُونُوا كَالَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا وَرِئَاءَ النَّاسِ وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَاللَّهُ بِمَا يَعْمَلُونَ مُحِيطٌ}.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 4584,
          "end": 4589,
          "span_id": "s063"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4592,
          "end": 4744,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 4745,
      "end": 4850,
      "text": " قال: كان مشركو قريشٍ الذين قاتَلوا نبيَّ الله يومَ بدرٍ خرَجوا، ولهم بَغْىٌ وفخرٌ، وقد قيل لهم يومَئِذٍ:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4792,
          "end": 4800,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4850,
      "end": 4897,
      "text": " ارْجِعوا، فقد انْطَلَقَت عِيرُكم وقد ظفِرْتُم.",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4897,
      "end": 4961,
      "text": " قالوا: لا واللهِ حتى يَتَحَدَّثَ أهلِ الحجازِ بمسيرِنا وعددِنا.",
      "markers": []
    },
    {
      "id": "s067",
      "start": 4961,
      "end": 5027,
      "text": " قال: وذُكِر لنا أن نبيَّ اللَّهِ صلى الله عليه وسلم قال يومَئِذٍ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4995,
          "end": 5013,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 5027,
      "end": 5094,
      "text": " \"اللهم إن قريشًا أَقْبَلَت بفخرِها وخُيَلائِها لتُحادَّك ورسولَك\" ",
      "markers": []
    },
    {
      "id": "s069",
      "start": 5266,
      "end": 5267,
      "text": ".",
      "markers": []
    },
    {
      "id": "s070",
      "start": 5271,
      "end": 5302,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s071",
      "start": 5302,
      "end": 5330,
      "text": " ثنا أحمدُ بنُ المفضلِ، قال:",
      "markers": []
    },
    {
      "id": "s072",
      "start": 5330,
      "end": 5363,
      "text": " ثنا أسباطُ، عن السُّدِّيِّ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 5346,
          "end": 5355,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 5363,
      "end": 5409,
      "text": " ذكَر المشركين وما يُطْعِمون على المياهِ فقال:",
      "markers": []
    },
    {
      "id": "s074",
      "start": 5409,
      "end": 5527,
      "text": " {وَلَا تَكُونُوا كَالَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا وَرِئَاءَ النَّاسِ وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5410,
          "end": 5526,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 5531,
      "end": 5567,
      "text": "حُدِّثْتُ عن الحسينِ بن الفرجِ، قال:",
      "markers": []
    },
    {
      "id": "s076",
      "start": 5567,
      "end": 5607,
      "text": " سِمعتُ أبا معاذٍ الفضلَ بنَ خالدٍ، قال:",
      "markers": []
    },
    {
      "id": "s077",
      "start": 5607,
      "end": 5635,
      "text": " ثنا عبيدُ بنُ سليمانَ، قال:",
      "markers": []
    },
    {
      "id": "s078",
      "start": 5635,
      "end": 5666,
      "text": " سمِعْتُ الضحاكَ يقولُ في قوله:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 5644,
          "end": 5650,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 5666,
      "end": 5715,
      "text": " {كَالَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5667,
          "end": 5714,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 5715,
      "end": 5766,
      "text": " قال: هم المشركون خرَجوا إلى بدرٍ أَشَرًا وبَطَرًا ",
      "markers": []
    },
    {
      "id": "s081",
      "start": 5802,
      "end": 5803,
      "text": ".",
      "markers": []
    },
    {
      "id": "s082",
      "start": 5807,
      "end": 5850,
      "text": "حدَّثني الحارث، قال: ثنا عبدُ العزيزِ، قال:",
      "markers": []
    },
    {
      "id": "s083",
      "start": 5850,
      "end": 5902,
      "text": " ثنا أبو مَعْشَرٍ، عن محمدِ بن كعبٍ القُرَظيِّ، قال:",
      "markers": [
        {
          "family": "ISRAILIYYAT",
          "marker": "كعب الأحبار (via TABIIN)",
          "name": "محمد بن كعب القرظي",
          "role": "SPEAKER",
          "start": 5872,
          "end": 5894,
          "span_id": "s083"
        },
        {
          "family": "TABIIN",
          "marker": "محمد بن كعب القرظي",
          "name": "محمد بن كعب القرظي",
          "role": "SPEAKER",
          "start": 5872,
          "end": 5894,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 5902,
      "end": 5979,
      "text": " لما خرَجَت قريشٌ مِن مكةَ إلى بدرٍ، خرَجوا بالقِيانِ والدفوف، فأنْزَل اللهُ:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 5965,
          "end": 5972,
          "span_id": "s084"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 5965,
          "end": 5977,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 5979,
      "end": 6133,
      "text": " {وَلَا تَكُونُوا كَالَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا وَرِئَاءَ النَّاسِ وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَاللَّهُ بِمَا يَعْمَلُونَ مُحِيطٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5980,
          "end": 6132,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 6214,
      "end": 6215,
      "text": ".",
      "markers": []
    },
    {
      "id": "s087",
      "start": 6219,
      "end": 6534,
      "text": "فتأويلُ الكلامِ إذن: ولا تكونوا أيُّها المؤمنون باللهِ ورسولِه في العملِ بالرياءِ والسُّمعةِ، وتركِ إخلاصِ العملِ للهِ واحْتِسابِ الأجرِ فيه كالجيش مِن أهلِ الكفرِ باللهِ ورسولِه الذين خرَجوا مِن منازِلهم بطَرًا ومُراءاة الناسِ بزِيِّهم وأموالِهم وكثرةِ عددِهم، وشدةِ بِطانتِهم، {وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6498,
          "end": 6533,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 6534,
      "end": 6766,
      "text": " يقولُ: ويَمْنَعون الناسَ مِن دينِ اللهِ والدخولِ في الإسلامِ بقتالِهم إياهم، وتعذيبِهم مِن قدَرُوا عليه مِن أهلِ الإيمانِ باللهِ، {وَاللَّهُ بِمَا يَعْمَلُونَ} مِن الرياءِ، والصدِّ عن سبيلِ اللهِ، وغيرِ ذلك مِن أفعالِهم، {مُحِيطٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6665,
          "end": 6694,
          "span_id": "s088"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6756,
          "end": 6765,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 6766,
      "end": 6923,
      "text": " يقولُ: عالمٌ بجميعِ ذلك، لا يَخْفَى عليه منه شيءٌ، وذلك أن الأشياءَ كلَّها له مُتَجَلِّيةٌ، لا يَعْزُبُ عنه منها شيءٌ، فهو لهم بها مُعاقِبٌ، وعليها معذِّبٌ.",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s002",

      "end": 6597,
      "text": " {بِأَلْفٍ مِّنَ الْمَلَائِكَةِ مُرْدِفِينَ}. أي متتابعين ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6540,
          "end": 6583,
          "span_id": "s097"
        }

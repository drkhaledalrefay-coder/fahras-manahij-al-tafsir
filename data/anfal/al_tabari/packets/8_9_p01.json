    },
    {
      "id": "s107",
      "start": 7255,
      "end": 7276,
      "text": " قال ابن زيد في قوله:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 7260,

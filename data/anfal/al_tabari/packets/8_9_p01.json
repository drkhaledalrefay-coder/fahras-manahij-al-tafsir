    },
    {
      "id": "s108",
      "start": 7276,
      "end": 7353,
      "text": " {مُرْدِفِينَ}. قال: المرْدِفِين: بعضُهم على إثْرِ بعضٍ، يتبَعُ بعضُهم بعضًا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7277,
          "end": 7290,

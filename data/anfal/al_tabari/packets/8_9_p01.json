      "id": "s098",
      "start": 6704,
      "end": 6705,
      "text": ".",
      "markers": []
    },
    {
      "id": "s099",
      "start": 6709,
      "end": 6760,
      "text": "حدَّثنا محمدُ بن عبد الأعلى، قال: ثنا محمد بن ثورٍ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6709,
          "end": 6716,
          "span_id": "s099"
        }

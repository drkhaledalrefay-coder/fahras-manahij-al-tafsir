      "end": 2839,
      "text": ".",
      "markers": []
    },
    {
      "id": "s031",
      "start": 2843,
      "end": 2902,
      "text": "حدَّثني أبو السائب، قال: ثنا أبو معاوية، عن الأعمش، عن أبي ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2884,
          "end": 2901,
          "stripped": "عن الأعمش، عن أبي",
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2925,
      "end": 2950,
      "text": " إسحاق، عن زيد بن نُفيعٍ ",
      "markers": []
    },
    {
      "id": "s033",
      "start": 3042,
      "end": 3135,
      "text": "، قال: كان أبو بكرٍ الصدِّيق رضي الله عنه مع رسول الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- على ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3098,
          "end": 3128,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 3148,
      "end": 3215,
      "text": " العريش، فجعل النبيُّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- يدعو، يقول:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3171,
          "end": 3201,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 3215,
      "end": 3271,
      "text": " \"اللهمَّ انصُرْ هذه العِصابَةَ، فإِنَّكَ إن لم تفعل لم ",
      "markers": []
    },
    {
      "id": "s036",
      "start": 3297,
      "end": 3336,
      "text": " تُعبَد في الأرضِ\". قال: فقال أبو بكرٍ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 3327,
          "end": 3334,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 3336,
      "end": 3371,
      "text": " بعض مناشدَتِك، مُنجِزَكَ ما وعدَك ",
      "markers": []
    },
    {
      "id": "s038",
      "start": 3417,
      "end": 3418,
      "text": ".",
      "markers": []
    },
    {
      "id": "s039",
      "start": 3422,
      "end": 3450,
      "text": "حدَّثني محمد بن الحسين، قال:",
      "markers": []
    },
    {
      "id": "s040",
      "start": 3450,
      "end": 3478,
      "text": " ثنا أحمد بن المفضَّلِ، قال:",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3478,
      "end": 3508,
      "text": " ثنا أسباط، عن السُّدىِّ، قال:",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3508,
      "end": 3610,
      "text": " أقبل النبي -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- يدعو الله ويستغيثه ويستنصِرُه، فأنزل الله عليه الملائكة ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3521,
          "end": 3551,
          "span_id": "s042"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 3585,
          "end": 3590,
          "span_id": "s042"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 3585,
          "end": 3595,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3639,
      "end": 3640,
      "text": ".",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3644,
      "end": 3682,
      "text": "حدَّثنا القاسم، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3644,
          "end": 3651,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3682,
      "end": 3712,
      "text": " ثني حجاجٌ، عن ابن جريج قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 3697,
          "end": 3705,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3712,
      "end": 3798,
      "text": " {إِذْ تَسْتَغِيثُونَ رَبَّكُمْ}. قال: دعا النبيُّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-] ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3713,
          "end": 3744,
          "span_id": "s046"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3764,
          "end": 3794,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3823,
      "end": 3824,
      "text": ".",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3828,
      "end": 3874,
      "text": "حدَّثنا ابن حميد، قال: ثنا سلمة، عن ابن إسحاق:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3828,
          "end": 3835,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3874,
      "end": 3925,
      "text": " {إِذْ تَسْتَغِيثُونَ رَبَّكُمْ}. أي: بدعائكم. حين ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3875,
          "end": 3906,
          "span_id": "s049"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 3908,
          "end": 3911,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 4018,
      "end": 4139,
      "text": " نظروا إلى كثرة عدوِّهم وقلة عددهم، {فَاسْتَجَابَ لَكُمْ} بدعاءِ رسول الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- ودعائكم معه ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4054,
          "end": 4075,
          "span_id": "s050"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4094,
          "end": 4124,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 4194,
      "end": 4195,
      "text": ".",
      "markers": []
    },
    {
      "id": "s052",
      "start": 4199,
      "end": 4236,
      "text": "حدَّثنا القاسم، قال: ثنا الحسين، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4199,
          "end": 4206,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 4236,
      "end": 4290,
      "text": " ثنا أبو بكر بن عياشٍ، عن أبي حصينٍ، عن أبي صالح، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4259,
          "end": 4290,
          "stripped": "عن أبي حصين، عن أبي صالح، قال:",
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4290,
      "end": 4428,
      "text": " لما كان يومُ بدرٍ، جعل النبي -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- يناشِد ربَّه أَشدَّ النِّشدةِ يدعو، فأتاه عمر بن الخطاب رضي الله عنه فقال:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4299,
          "end": 4307,
          "span_id": "s054"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4321,
          "end": 4351,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4428,
      "end": 4457,
      "text": " يا رسولَ اللهِ، بعض نشدَتِك؛",
      "markers": []
    },
    {
      "id": "s056",
      "start": 4457,
      "end": 4496,
      "text": " فواللهِ لَيَفِينَّ الله لكَ بما وعدَك ",
      "markers": []
    },
    {
      "id": "s057",
      "start": 4498,
      "end": 4499,
      "text": ".",
      "markers": []
    },
    {
      "id": "s058",
      "start": 4503,
      "end": 4596,
      "text": "وأمَّا قولُه: {أَنِّي مُمِدُّكُم بِأَلْفٍ مِّنَ الْمَلَائِكَةِ مُرْدِفِينَ}. فقد بينا معناهُ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4517,
          "end": 4578,
          "span_id": "s058"
        },
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 4589,
          "end": 4594,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4600,
      "end": 4638,
      "text": "وبنحو الذي قلنا في ذلك قال أهل التأويل",
      "markers": []
    },
    {
      "id": "s060",
      "start": 4642,
      "end": 4656,
      "text": "ذكر من قال ذلك",
      "markers": []
    },
    {
      "id": "s061",
      "start": 4660,
      "end": 4685,
      "text": "حدَّثني محمد بن سعد، قال:",
      "markers": []
    },
    {
      "id": "s062",
      "start": 4685,
      "end": 4713,
      "text": " ثني أبي، قال: ثني عمي، قال:",
      "markers": []
    },
    {
      "id": "s063",
      "start": 4713,
      "end": 4744,
      "text": " ثني أبي، عن أبيه، عن ابن عباس:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4723,
          "end": 4744,
          "stripped": "عن أبيه، عن ابن عباس:",
          "span_id": "s063"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4735,
          "end": 4743,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 4744,
      "end": 4806,
      "text": " {أَنِّي مُمِدُّكُم بِأَلْف مِّنَ الْمَلَائِكَةِ مُرْدِفِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4745,
          "end": 4805,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4806,
      "end": 4860,
      "text": " يقولُ: المزيد، كما تقولُ: ائتِ الرجل فزِدْه كذا وكذا ",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4925,
      "end": 4926,
      "text": ".",
      "markers": []
    },
    {
      "id": "s067",
      "start": 4930,
      "end": 5046,
      "text": "حدَّثنا ابن وكيعٍ، قال: ثنا أحمد بن بشيرٍ، عن هارون بن عنترةَ، عن أبيه، عن ابن عباس: {مُرْدِفِينَ}. قال: متتَابِعين ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4930,
          "end": 4937,
          "span_id": "s067"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4973,
          "end": 5014,
          "stripped": "عن هارون بن عنترة، عن أبيه، عن ابن عباس:",
          "span_id": "s067"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5005,
          "end": 5013,
          "span_id": "s067"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5015,
          "end": 5028,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 5102,
      "end": 5103,
      "text": ".",
      "markers": []
    },
    {
      "id": "s069",
      "start": 5107,
      "end": 5149,
      "text": "قال: ثني أبي، عن سفيان، عن هارون بن عنترة ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5121,
          "end": 5148,
          "stripped": "عن سفيان، عن هارون بن عنترة",
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 5308,
      "end": 5328,
      "text": "، عن ابن عباسٍ مثله ",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 5313,
          "end": 5321,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 5425,
      "end": 5426,
      "text": ".",
      "markers": []
    },
    {
      "id": "s072",
      "start": 5430,
      "end": 5467,
      "text": "حدَّثني سليمانُ بنُ عبدِ الجبار، قال:",
      "markers": []
    },
    {
      "id": "s073",
      "start": 5467,
      "end": 5492,
      "text": " ثنا محمد بن الصلتِ، قال:",
      "markers": []
    },
    {
      "id": "s074",
      "start": 5492,
      "end": 5544,
      "text": " ثنا أبو كُدَينَةَ، عن قابوسَ، عن أبيه عن ابن عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5512,
          "end": 5544,
          "stripped": "عن قابوس، عن أبيه عن ابن عباس:",
          "span_id": "s074"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5534,
          "end": 5542,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 5544,
      "end": 5600,
      "text": " {مُمِدُّكُم بِأَلْفٍ مِّنَ الْمَلَائِكَةِ مُرْدِفِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5545,
          "end": 5599,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 5600,
      "end": 5628,
      "text": " قال: وراء كلِّ ملَكٍ ملَكٌ ",
      "markers": []
    },
    {
      "id": "s077",
      "start": 5661,
      "end": 5662,
      "text": ".",
      "markers": []
    },
    {
      "id": "s078",
      "start": 5666,
      "end": 5799,
      "text": "حدَّثني ابن وكيعٍ، قال: ثنا أبو أسامةَ، عن أبي كُدينة يحيى بن المهلبِ، عن قابوسَ، عن أبيه، عن ابن عباسٍ: {مُردِفِينَ}. قال: متتابعين ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5737,
          "end": 5789,
          "stripped": "عن قابوس، عن أبيه، عن ابن عباس: {مردفين}. قال:",
          "span_id": "s078"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5760,
          "end": 5768,
          "span_id": "s078"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5771,
          "end": 5783,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 5801,
      "end": 5802,
      "text": ".",
      "markers": []
    },
    {
      "id": "s080",
      "start": 5806,
      "end": 5864,
      "text": "قال: ثنا هانئُ بن سعيدٍ، عن حجاج بن أرطاة، عن قابوسَ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5831,
          "end": 5864,
          "stripped": "عن حجاج بن أرطاة، عن قابوس، قال:",
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 5864,
      "end": 5901,
      "text": " سمعت أبا ظبيان يقولُ: {مُرْدِفِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5887,
          "end": 5900,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 5901,
      "end": 5938,
      "text": " قال: الملائكةُ بعضُهم على إثرِ بعضٍ ",
      "markers": []
    },
    {
      "id": "s083",
      "start": 5940,
      "end": 5941,
      "text": ".",
      "markers": []
    },
    {
      "id": "s084",
      "start": 5945,
      "end": 5991,
      "text": "قال: ثنا المحاربيُّ، عن جويبر، عن الضحاك، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5966,
          "end": 5991,
          "stripped": "عن جويبر، عن الضحاك، قال:",
          "span_id": "s084"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 5979,
          "end": 5985,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 5991,
      "end": 6032,
      "text": " {مُردِفِينَ}. قال: بعضُهم على إثرِ بعضٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5992,
          "end": 6004,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 6034,
      "end": 6035,
      "text": ".",
      "markers": []
    },
    {
      "id": "s087",
      "start": 6039,
      "end": 6075,
      "text": "حدَّثني المثنى، قال: ثنا إسحاق، قال:",
      "markers": []
    },
    {
      "id": "s088",
      "start": 6075,
      "end": 6134,
      "text": " ثنا عبد الله، عن ورقاءَ، عن ابن أبي نجيحٍ، عن مجاهد مثلَه ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6090,
          "end": 6121,
          "stripped": "عن ورقاء، عن ابن أبي نجيح، عن",
          "span_id": "s088"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 6122,
          "end": 6127,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 6245,
      "end": 6246,
      "text": ".",
      "markers": []
    },
    {
      "id": "s090",
      "start": 6250,
      "end": 6287,
      "text": "حدَّثنا القاسم، قال: ثنا الحسين، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6250,
          "end": 6257,
          "span_id": "s090"
        }
      ]
    },
    {
      "id": "s091",
      "start": 6287,
      "end": 6327,
      "text": " ثنى حجاجٌ، عن ابن جريجٍ، عن مجاهد قوله:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6299,
          "end": 6327,
          "stripped": "عن ابن جريج، عن مجاهد قوله:",
          "span_id": "s091"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 6302,
          "end": 6310,
          "span_id": "s091"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 6316,
          "end": 6321,
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 6327,
      "end": 6374,
      "text": " {مُرْدِفِينَ}. قال: مُمدِّين. قال ابنُ جُرَيج:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6328,
          "end": 6341,
          "span_id": "s092"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 6362,
          "end": 6373,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 6374,
      "end": 6441,
      "text": " عن عبدِ اللهِ بن كثيرٍ قال: {مُرْدِفِينَ}. الإرْدافُ: الإمداد بهم ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6403,
          "end": 6416,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 6474,
      "end": 6475,
      "text": ".",
      "markers": []
    },
    {
      "id": "s095",
      "start": 6479,
      "end": 6504,
      "text": "حدَّثني بشر بن معاذ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 6494,
          "end": 6498,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 6504,
      "end": 6539,
      "text": " ثنا يزيد، قال: ثنا سعيد، عن قتادة:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",

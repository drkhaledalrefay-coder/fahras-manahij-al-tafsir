      "text": " ",
      "markers": []
    },
    {
      "id": "s103",
      "start": 7031,
      "end": 7065,
      "text": "، قال: ثنا أحمد بن المفضَّلِ، قال:",
      "markers": []
    },
    {
      "id": "s104",
      "start": 7065,
      "end": 7154,
      "text": " ثنا أسباطُ، عن السُّديِّ: {بِأَلْفٍ مِّنَ الْمَلَائِكَةِ مُردِفِينَ}. يتبع بعضُهم بعضًا ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 7081,
          "end": 7088,
          "span_id": "s104"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7092,
          "end": 7134,
          "span_id": "s104"
        }
      ]
    },
    {
      "id": "s105",
      "start": 7210,
      "end": 7211,
      "text": ".",
      "markers": []
    },
    {
      "id": "s106",
      "start": 7215,
      "end": 7255,
      "text": "حدَّثنا يونس، قال: أخبرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7215,
          "end": 7222,
          "span_id": "s106"

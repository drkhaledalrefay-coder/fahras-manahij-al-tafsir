  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s002",
      "start": 215,
      "end": 233,
      "text": "¬بعده في م: \"من\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s014",
      "start": 1143,
      "end": 1345,
      "text": "¬في م: \"كفاك\". وقد روى الخبر بالوجهين جميعا، قال النووى: هكذا وقع لجماهير رواة مسلم (كذاك) بالذال: ولبعضهم (كفاك) بالفاء، وفي رواية البخارى: حسبك مناشدتك ربك. وكلٌّ بمعنى. صحيح مسلم بشرح النووى 12/ 85.¥",
      "grading": [
        "صحيح"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s016",
      "start": 1539,
      "end": 1975,
      "text": "¬أخرجه مسلم (1763) من طريق ابن المبارك به، وأخرجه ابن أبي شيبة 10/ 350، 14/ 365، <br>وأحمد 1/ 334 - 336 (208)، وعبد بن حميد (31)، وأبو داود (2690)، والترمذى (3081)، وأبو عوانة (6692 - 6695)، والطحاوى في المشكل (3309)، وابن أبي حاتم في تفسيره 5/ 1662، 1730، وابن حبان (4793)، وأبو نعيم في الدلائل (408)، والبيهقى 6/ 321، وفى الدلائل 3/ 51 - 53 من طريق عكرمة به، وعزاه السيوطي في الدر المنثور 3/ 69 إلى ابن المنذر وأبي الشيخ وابن مردويه.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s021",
      "start": 2247,
      "end": 2280,
      "text": "¬ذكره ابن كثير في تفسيره 3/ 559.¥",
      "grading": []
    },
    {

  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 141,
      "text": "القول في تأويل قوله: {إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ (9)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 25,
          "end": 140,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 145,
      "end": 215,
      "text": "يقول تعالى ذكره: ويُبطل الباطل حين تستغيثونَ ربَّكم، فـ {إذْ} مِن صلة ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 201,
          "end": 206,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 233,
      "end": 245,
      "text": " {يُبْطِلَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 234,
          "end": 244,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 249,
      "end": 361,
      "text": "ومعنى قوله: {تَسْتَغِيثُونَ رَبَّكُمْ}: تستجِيرون به من عدوِّكُم، وتدعُونَه للنصرِ عليهم، {فَاسْتَجَابَ لَكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 261,
          "end": 287,
          "span_id": "s004"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 339,
          "end": 360,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 361,
      "end": 461,
      "text": " يقولُ: فأجاب دعاءَكُم بأَنِّي مُمِدُّكم بألفٍ من الملائكةِ يُردِفُ بعضُهم بعضًا، ويتلو بعضهم بعضًا.",
      "markers": []
    },
    {
      "id": "s006",
      "start": 465,
      "end": 571,
      "text": "وبنحو ما قلنا في ذلك قال أهل التأويلِ، وجاءت الرواية عن أصحاب رسول الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 538,
          "end": 568,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 575,
      "end": 592,
      "text": "ذكرُ الأخبار بذلك",
      "markers": []
    },
    {
      "id": "s008",
      "start": 596,
      "end": 634,
      "text": "حدَّثني محمد بن عبيدٍ المحاربيُّ، قال:",
      "markers": []
    },
    {
      "id": "s009",
      "start": 634,
      "end": 682,
      "text": " ثنا عبد الله بن المبارك، عن عكرمة بن عمار، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 663,
          "end": 668,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 682,
      "end": 728,
      "text": " ثنى سماك الحنفيُّ، قال: سمعتُ ابن عباس يقولُ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 713,
          "end": 721,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 728,
      "end": 767,
      "text": " ثني عمرُ بنُ الخطابِ رضي الله عنه قال:",
      "markers": []
    },
    {
      "id": "s012",
      "start": 767,
      "end": 930,
      "text": " لما كان يوم بدر ونظَر رسول الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- إلى المشركين وعِدَّتِهم، ونظر إلى أصحابه نيِّفًا على ثلاثمائة، فاستقبل القبلة، فجعل يدعو ويقولُ:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 776,
          "end": 783,
          "span_id": "s012"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 801,
          "end": 831,
          "span_id": "s012"
        }
      ]
    },
    {
      "id": "s013",
      "start": 930,
      "end": 1025,
      "text": " \"اللهمَّ أنجِز لي ما وَعدتَنى، اللهم إن تهلك هذه العصابة من أهل الإسلام، لا تُعبَدْ في الأرض\".",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1025,
      "end": 1143,
      "text": " فلم يزل كذلك حتى سقط رداؤُه، وأخذه أبو بكرٍ الصديقُ رضي الله عنه، فوضع رداءَه عليه، ثم التزمه من ورائه، ثم قال: كذاك ",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1345,
      "end": 1427,
      "text": " يا نبيَّ الله، بأبي وأمِّى مناشدتَك ربَّكَ، فإنه سيُنجِزُ لك ما وعدك، فأنزل الله:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 1416,
          "end": 1421,
          "span_id": "s015"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 1416,
          "end": 1426,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1427,
      "end": 1539,
      "text": " {إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُم بِأَلْفٍ مِّنَ الْمَلَائِكَةِ مُردِفِينَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1428,
          "end": 1538,
          "span_id": "s016"
        }
      ]
    },
    {
      "id": "s017",
      "start": 1975,
      "end": 1976,
      "text": ".",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1980,
      "end": 2060,
      "text": "حدَّثني المثنى، قال: ثنا أبو صالحٍ، قال ثني معاويةُ، عن عليٍّ، عن ابن عباس، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2033,
          "end": 2060,
          "stripped": "عن علي، عن ابن عباس، قال:",
          "span_id": "s018"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 2036,
          "end": 2039,
          "span_id": "s018"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 2046,
          "end": 2054,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 2060,
      "end": 2092,
      "text": " لما اصطفَّ القومُ، قال أبو جهل:",
      "markers": []
    },
    {
      "id": "s020",
      "start": 2092,
      "end": 2185,
      "text": " اللهمَّ، أولانا بالحقِّ فانصره. ورفع رسول الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- يدَه، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2141,
          "end": 2171,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 2185,
      "end": 2247,
      "text": " \"يا ربِّ، إن تَهلِك هذه العصابة فلن تُعبَدَ في الأرضِ أبدًا\" ",
      "markers": []
    },
    {
      "id": "s022",
      "start": 2280,
      "end": 2281,
      "text": ".",
      "markers": []
    },
    {
      "id": "s023",
      "start": 2285,
      "end": 2306,
      "text": "حدَّثني محمد بن سعد، ",
      "markers": []
    },
    {
      "id": "s024",
      "start": 2320,
      "end": 2321,
      "text": " ",
      "markers": []
    },
    {
      "id": "s025",
      "start": 2333,
      "end": 2353,
      "text": "، قال: ثني عمي، قال:",
      "markers": []
    },
    {
      "id": "s026",
      "start": 2353,
      "end": 2389,
      "text": " ثني أبي، عن أبيه، عن ابن عباس، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2363,
          "end": 2389,
          "stripped": "عن أبيه، عن ابن عباس، قال:",
          "span_id": "s026"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 2375,
          "end": 2383,
          "span_id": "s026"
        }
      ]
    },
    {
      "id": "s027",
      "start": 2389,
      "end": 2440,
      "text": " قام النبي -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2401,
          "end": 2431,
          "span_id": "s027"
        }
      ]
    },
    {
      "id": "s028",
      "start": 2440,
      "end": 2537,
      "text": " \"اللهمَّ ربنا أنزلتَ علىَّ الكتاب، وأمَرتَنى بالقتال، ووعدتَنى بالنَّصرِ، ولا تُخلِفُ الميعادَ\".",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2537,
      "end": 2818,
      "text": " فأتاه جبريل عليه السلام، فأنزل اللَّهُ {أَلَن يَكْفِيكُمْ أَن يُمِدَّكُمْ رَبُّكُم بِثَلَاثَةِ آلَافٍ مِّنَ الْمَلَائِكَةِ مُنزَلِينَ (124) بَلَى إن تَصْبِرُوا وَتَتَّقُوا وَيَأْتُوكُم مِّن فَورِهِمْ هَذَا يُمْدِدْكُمْ رَبُّكُم بِخَمْسَةِ آلَافٍ مِنَ الْمَلَائِكَةِ مُسَوِّمِينَ} ",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 2563,
          "end": 2568,
          "span_id": "s029"

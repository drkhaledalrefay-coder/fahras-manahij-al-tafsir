  "spans": [
    {
      "id": "s111",
      "start": 7480,
      "end": 7567,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا أبو أسامةَ، عن أبي رَوْقٍ، عن الضحَّاك بن مُزاحِمٍ بنحوِه.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7480,
          "end": 7487,
          "span_id": "s111"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7521,
          "end": 7567,
          "stripped": "عن أبي روق، عن الضحاك بن مزاحم بنحوه.",
          "span_id": "s111"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "NARRATOR",
          "start": 7539,
          "end": 7547,
          "span_id": "s111"
        }
      ]
    },
    {
      "id": "s112",
      "start": 7571,
      "end": 7624,
      "text": "قال: ثنا المُحاربيُّ، عن جُوَيبرٍ، عن الضحَّاكِ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7593,
          "end": 7624,
          "stripped": "عن جويبر، عن الضحاك، قال:",
          "span_id": "s112"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 7609,
          "end": 7617,
          "span_id": "s112"
        }
      ]
    },
    {
      "id": "s113",
      "start": 7624,
      "end": 7689,
      "text": " يحولُ بينَ المرءِ وبينَ أن يكفُرَ، وبينَ الكافرِ وبينَ أن يؤمنَ.",
      "markers": []
    },
    {
      "id": "s114",
      "start": 7693,
      "end": 7722,
      "text": "حدَّثنا الحسنُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7693,
          "end": 7700,
          "span_id": "s114"
        }
      ]
    },
    {
      "id": "s115",
      "start": 7722,
      "end": 7808,
      "text": " أخبَرنا عبدُ الرزاقِ، قال: ثنا عبدُ العزيزِ بنُ أبى روَّادٍ، عن الضحَّاكِ بنِ مزاحمٍ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 7723,
          "end": 7730,
          "span_id": "s115"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "NARRATOR",
          "start": 7787,
          "end": 7795,
          "span_id": "s115"
        }
      ]
    },
    {
      "id": "s116",
      "start": 7808,
      "end": 7852,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7809,
          "end": 7846,
          "span_id": "s116"
        }
      ]
    },
    {
      "id": "s117",
      "start": 7852,
      "end": 7920,
      "text": " يحولُ بينَ الكافِرِ وبينَ طاعةِ اللهِ، وبينَ المؤمنِ ومعصيةِ اللهِ ",
      "markers": []
    },
    {
      "id": "s118",
      "start": 7946,
      "end": 7947,
      "text": ".",
      "markers": []
    },
    {
      "id": "s119",
      "start": 7951,
      "end": 7981,
      "text": "حدَّثنا أحمدُ بنُ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7951,
          "end": 7958,
          "span_id": "s119"
        }
      ]
    },
    {
      "id": "s120",
      "start": 7981,
      "end": 8013,
      "text": " ثنا أبو أحمدَ الزُّبيريُّ، قال:",
      "markers": []
    },
    {
      "id": "s121",
      "start": 8013,
      "end": 8055,
      "text": " ثنا ابنُ أبي روَّادٍ، عن الضحَّاكِ نحوَه.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "NARRATOR",
          "start": 8039,
          "end": 8047,
          "span_id": "s121"
        }
      ]
    },
    {
      "id": "s122",
      "start": 8059,
      "end": 8095,
      "text": "وحُدِّثت عن الحسينِ بنِ الفرجِ، قال:",
      "markers": []
    },
    {
      "id": "s123",
      "start": 8095,
      "end": 8147,
      "text": " سمِعت أبا معاذٍ يقولُ: ثنا عُبيدُ بنُ سليمانَ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 8106,
          "end": 8110,
          "span_id": "s123"
        }
      ]
    },
    {
      "id": "s124",
      "start": 8147,
      "end": 8192,
      "text": " سمِعت الضحاكَ بنَ مزاحمٍ يقولُ. فذكَر نحوَه.",
      "markers": []
    },
    {
      "id": "s125",
      "start": 8196,
      "end": 8249,
      "text": "حدَّثني المثنى، قال: ثنا الحجَّاجُ بنُ مِنْهالٍ، قال:",
      "markers": []
    },
    {
      "id": "s126",
      "start": 8249,
      "end": 8280,
      "text": " ثنا المعتمرُ بنُ سليمانَ، قال:",
      "markers": []
    },
    {
      "id": "s127",
      "start": 8280,
      "end": 8360,
      "text": " سمِعتُ عبدَ العزيزِ بنَ أبى روَّادٍ يحدِّثُ، عن الضحَّاكِ بنِ مُزاحمٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "NARRATOR",
          "start": 8329,
          "end": 8337,
          "span_id": "s127"
        }
      ]
    },
    {
      "id": "s128",
      "start": 8360,
      "end": 8433,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. قال: يحولُ بينَ المؤمنِ ومعصيتِه.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8361,
          "end": 8398,
          "span_id": "s128"
        }
      ]
    },
    {
      "id": "s129",
      "start": 8437,
      "end": 8477,
      "text": "حدَّثني المثنى، قال: ثنا أبو صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s130",
      "start": 8477,
      "end": 8515,
      "text": " ثني معاويةُ، عن عليٍّ، عن ابنِ عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 8491,
          "end": 8515,
          "stripped": "عن علي، عن ابن عباس:",
          "span_id": "s130"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 8494,
          "end": 8497,
          "span_id": "s130"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 8504,
          "end": 8513,
          "span_id": "s130"
        }
      ]
    },
    {
      "id": "s131",
      "start": 8515,
      "end": 8580,
      "text": " {وَاعْلَمُوا أَنَّ اللَّهَ يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8516,
          "end": 8579,
          "span_id": "s131"
        }
      ]
    },
    {
      "id": "s132",
      "start": 8580,
      "end": 8656,
      "text": " يقولُ: يحولُ بينَ المؤمنِ وبينَ الكفرِ، ويحولُ بينَ الكافرِ وبينَ الإيمانِ.",
      "markers": []
    },
    {
      "id": "s133",
      "start": 8660,
      "end": 8688,
      "text": "حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s134",
      "start": 8688,
      "end": 8716,
      "text": " ثني أبي، قال: ثني عمي، قال:",
      "markers": []
    },
    {
      "id": "s135",
      "start": 8716,
      "end": 8749,
      "text": " ثني أبي، عن أبيه، عن ابنِ عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",

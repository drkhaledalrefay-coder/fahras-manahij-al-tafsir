        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 9220,
          "end": 9228,
          "span_id": "s142"
        }
      ]
    },
    {
      "id": "s143",
      "start": 9230,
      "end": 9276,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. يقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9231,
          "end": 9268,
          "span_id": "s143"
        }
      ]
    },
    {
      "id": "s144",
      "start": 9276,
      "end": 9338,
      "text": " يحولُ بينَ الكافرِ وبينَ طاعتِه، وبينَ المؤمنِ وبينَ معصيتِه.",
      "markers": []
    },
    {
      "id": "s145",
      "start": 9342,
      "end": 9423,
      "text": "قال: ثنا إسحاقُ بنُ إسماعيلَ، عن يعقوبَ القُمِّيِّ، عن جعفرٍ، عن سعيدِ بنِ جبيرٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9372,
          "end": 9423,
          "stripped": "عن يعقوب القمي، عن جعفر، عن سعيد بن جبير:",
          "span_id": "s145"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 9407,
          "end": 9421,
          "span_id": "s145"
        }
      ]
    },
    {
      "id": "s146",
      "start": 9423,
      "end": 9516,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}: يحولُ بينَ المؤمنِ والمعاصى، وبينَ الكافرِ والإيمانِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9424,
          "end": 9461,
          "span_id": "s146"
        }
      ]
    },
    {
      "id": "s147",
      "start": 9520,
      "end": 9564,
      "text": "قال: ثنا عُبيدةُ، عن إسماعيلَ، عن أبي صالحٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9538,
          "end": 9564,
          "stripped": "عن إسماعيل، عن أبي صالح:",
          "span_id": "s147"
        }
      ]
    },
    {
      "id": "s148",
      "start": 9564,
      "end": 9635,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. قال: يحولُ بينَه وبينَ المعاصى ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9565,
          "end": 9602,
          "span_id": "s148"
        }
      ]
    },
    {
      "id": "s149",
      "start": 9730,
      "end": 9731,
      "text": ".",
      "markers": []
    },
    {
      "id": "s150",
      "start": 9735,
      "end": 9759,
      "text": "وقال آخرون: بل معنى ذلك:",
      "markers": []
    },
    {
      "id": "s151",
      "start": 9759,
      "end": 9806,
      "text": " يحولُ بينَ المرءِ وعقلِه فلا يَدْرى ما يعمَلُ.",
      "markers": []
    },
    {
      "id": "s152",
      "start": 9810,
      "end": 9825,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s153",
      "start": 9829,
      "end": 9877,
      "text": "حدَّثنا عبيدُ اللهِ بنُ محمدٍ الفِرْيابيُّ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9829,
          "end": 9836,
          "span_id": "s153"
        }
      ]
    },
    {
      "id": "s154",
      "start": 9877,
      "end": 9928,
      "text": " ثنا عبدُ المجيدِ، عن ابنِ جُريجٍ، عن مجاهدٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9896,
          "end": 9928,
          "stripped": "عن ابن جريج، عن مجاهد قوله:",
          "span_id": "s154"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 9899,
          "end": 9909,
          "span_id": "s154"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 9915,
          "end": 9920,
          "span_id": "s154"
        }
      ]
    },
    {
      "id": "s155",
      "start": 9928,
      "end": 9998,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. قال: يحولُ بينَ المرءِ وعقلِه.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9929,
          "end": 9966,
          "span_id": "s155"
        }
      ]
    },
    {
      "id": "s156",
      "start": 10002,
      "end": 10031,
      "text": "حدَّثنا محمدُ بنُ عمرٍو، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10002,
          "end": 10009,
          "span_id": "s156"
        }
      ]
    },
    {
      "id": "s157",
      "start": 10031,
      "end": 10092,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابنِ أبي نَجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10062,
          "end": 10092,
          "stripped": "عن ابن أبي نجيح، عن مجاهد:",
          "span_id": "s157"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 10085,
          "end": 10090,
          "span_id": "s157"
        }
      ]
    },
    {
      "id": "s158",
      "start": 10092,
      "end": 10154,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}: حتى يترُكَه لا يعقِلُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10093,
          "end": 10130,
          "span_id": "s158"
        }
      ]
    },
    {
      "id": "s159",
      "start": 10216,
      "end": 10217,
      "text": ".",
      "markers": []
    },
    {
      "id": "s160",
      "start": 10221,
      "end": 10262,
      "text": "حدَّثنا المثنى، قال: ثنا أبو حذيفةَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10221,
          "end": 10228,
          "span_id": "s160"
        }
      ]
    },
    {
      "id": "s161",
      "start": 10262,
      "end": 10308,
      "text": " ثنا عيسى، عن ابن أبي نَجيحٍ، عن مجاهدٍ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10273,
          "end": 10308,
          "stripped": "عن ابن أبي نجيح، عن مجاهد مثله.",
          "span_id": "s161"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 10295,
          "end": 10300,
          "span_id": "s161"
        }
      ]
    },
    {
      "id": "s162",
      "start": 10312,
      "end": 10349,
      "text": "حدَّثني المثنى، قال: ثنا إسحاقُ، قال:",
      "markers": []
    },
    {
      "id": "s163",
      "start": 10349,
      "end": 10417,
      "text": " ثنا عبدُ اللهِ، عن وَرْقاءَ، عن ابنِ أبي نَجيحٍ، عن مجاهدٍ في قوله:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10366,
          "end": 10401,
          "stripped": "عن ورقاء، عن ابن أبي نجيح، عن",
          "span_id": "s163"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 10402,
          "end": 10407,
          "span_id": "s163"
        }
      ]
    },
    {
      "id": "s164",
      "start": 10417,
      "end": 10462,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. قال: ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10418,
          "end": 10455,
          "span_id": "s164"
        }
      ]
    },
    {
      "id": "s165",
      "start": 10488,
      "end": 10489,
      "text": " ",
      "markers": []
    },
    {
      "id": "s166",
      "start": 10533,
      "end": 10544,
      "text": " لا يعقِلُ.",
      "markers": []
    },
    {
      "id": "s167",
      "start": 10548,
      "end": 10578,
      "text": "حدَّثنا أحمدُ بنُ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10548,
          "end": 10555,
          "span_id": "s167"
        }
      ]
    },
    {
      "id": "s168",
      "start": 10578,
      "end": 10650,
      "text": " ثنا أبو أحمدَ، قال: ثنا مَعْقِلُ بنُ عبيدِ اللهِ، عن حُميدٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10629,
          "end": 10650,
          "stripped": "عن حميد، عن مجاهد:",
          "span_id": "s168"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 10643,
          "end": 10648,
          "span_id": "s168"
        }
      ]
    },
    {
      "id": "s169",
      "start": 10650,
      "end": 10694,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10651,
          "end": 10688,
          "span_id": "s169"
        }
      ]
    },
    {
      "id": "s170",
      "start": 10694,
      "end": 10730,
      "text": " إذا حال بينك وبين قلبِك كيف تعمَلُ!",
      "markers": []
    },
    {
      "id": "s171",
      "start": 10734,
      "end": 10758,
      "text": "قال: ثنا أبو أحمدَ، قال:",
      "markers": []
    },
    {
      "id": "s172",
      "start": 10758,
      "end": 10791,
      "text": " ثنا شريكٌ، عن خُصيفٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10770,
          "end": 10791,
          "stripped": "عن خصيف، عن مجاهد:",
          "span_id": "s172"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 10784,
          "end": 10789,
          "span_id": "s172"
        }
      ]
    },
    {
      "id": "s173",
      "start": 10791,
      "end": 10835,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10792,
          "end": 10829,
          "span_id": "s173"
        }
      ]
    },
    {
      "id": "s174",
      "start": 10835,
      "end": 10877,
      "text": " يحولُ بينَ قلبِ الكافرِ وأن يعمَلَ خيرًا ",
      "markers": []
    },
    {
      "id": "s175",
      "start": 10953,
      "end": 10954,
      "text": ".",
      "markers": []
    },
    {
      "id": "s176",
      "start": 10958,
      "end": 11041,
      "text": "وقال آخرون: معناه: يحولُ بين المرءِ وقلبِه أن يقدِرَ على إيمانٍ أو كفرٍ إلا بإذنِه.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 10970,
          "end": 10975,
          "span_id": "s176"
        }
      ]
    },
    {
      "id": "s177",
      "start": 11045,
      "end": 11060,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s178",
      "start": 11064,
      "end": 11095,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s179",
      "start": 11095,
      "end": 11123,
      "text": " ثنا أحمدُ بنُ مفضَّلٍ، قال:",
      "markers": []
    },
    {
      "id": "s180",
      "start": 11123,
      "end": 11216,
      "text": " ثنا أسباطُ، عن السُّدِّيِّ: {وَاعْلَمُوا أَنَّ اللَّهَ يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 11139,
          "end": 11148,
          "span_id": "s180"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11152,
          "end": 11215,
          "span_id": "s180"
        }
      ]
    },
    {
      "id": "s181",
      "start": 11216,
      "end": 11291,
      "text": " قال: يحولُ بينَ الإنسانِ وقلبِه فلا يستطيعُ أن يؤمنَ ولا يكفرَ إلا بإذنِه ",
      "markers": []
    },
    {
      "id": "s182",
      "start": 11353,
      "end": 11354,
      "text": ".",
      "markers": []
    },
    {
      "id": "s183",
      "start": 11358,
      "end": 11439,
      "text": "وقال آخرون: معنى ذلك أنه قريبٌ من قلبِه لا يَخفَى عليه شيءٌ أَظْهَره أَو أَسرَّه.",
      "markers": []
    },
    {
      "id": "s184",
      "start": 11443,
      "end": 11458,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s185",
      "start": 11462,
      "end": 11497,
      "text": "حدَّثنا محمدُ بنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11462,
          "end": 11469,
          "span_id": "s185"
        }
      ]
    },
    {
      "id": "s186",
      "start": 11497,
      "end": 11524,
      "text": " ثنا محمدُ بنُ ثَوْرٍ، قال:",
      "markers": []
    },
    {
      "id": "s187",
      "start": 11524,
      "end": 11555,
      "text": " ثنا معمرٌ، عن قتادةَ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 11539,
          "end": 11544,
          "span_id": "s187"
        }
      ]
    },
    {
      "id": "s188",
      "start": 11555,
      "end": 11599,
      "text": " {يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11556,
          "end": 11593,
          "span_id": "s188"
        }
      ]
    },
    {
      "id": "s189",
      "start": 11599,
      "end": 11654,
      "text": " هي كقولِه: {أَقْرَبُ إِلَيْهِ مِنْ حَبْلِ الْوَرِيدِ} ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "كقول",
          "start": 11603,
          "end": 11607,
          "span_id": "s189"
        },
        {
          "family": "LUGHA",
          "marker": "كقوله",
          "start": 11603,
          "end": 11609,
          "span_id": "s189"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11611,
          "end": 11653,
          "span_id": "s189"
        }
      ]
    },
    {
      "id": "s190",
      "start": 11748,
      "end": 11749,
      "text": " ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 11749,
          "end": 11756,
          "text": "[ق: 16]",
          "via": "apparatus",
          "span_id": "s190"
        }
      ]
    },
    {
      "id": "s191",
      "start": 11756,
      "end": 11757,
      "text": ".",
      "markers": []
    },
    {
      "id": "s192",
      "start": 11761,
      "end": 11806,
      "text": "وأولى الأقوالِ بالصوابِ عندى فى ذلك أن يقالَ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 11800,
          "end": 11804,
          "span_id": "s192"
        }
      ]
    },
    {
      "id": "s193",
      "start": 11806,
      "end": 11868,
      "text": " إن ذلك خبرٌ من اللهِ عزَّ وجلَّ أنه أملكُ لقلوبِ عبادِه منهم ",
      "markers": []
    },
    {
      "id": "s194",
      "start": 11892,
      "end": 12233,
      "text": "، وأنه يحولُ بينهم وبينها إذا شاء، حتى لا يقدِرَ ذو قلبٍ أن يدرِكَ به شيئًا من إيمانٍ أو كفرٍ، أو أن يعىَ به شيئًا، أو أن يفهمَ، إلا بإذنِه ومشيئتِه، وذلك أن الحولَ بينَ الشيءِ والشيءِ إنما هو الحجزُ بينهما، وإذا حجَز جلَّ ثناؤُه بين عبدٍ وقلبِه في شيءٍ أن يُدْركَه أو يفهَمَه، لم يكنْ للعبدِ إلى إدراكِ ما قد منَع اللهُ قلبَه إدراكَه سبيلٌ.",
      "markers": []
    },
    {
      "id": "s195",
      "start": 12233,
      "end": 12277,
      "text": " وإذا كان ذلك معناه، دخل في ذلك قولُ من قال:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 12247,
          "end": 12252,
          "span_id": "s195"
        }
      ]
    },
    {
      "id": "s196",
      "start": 12277,
      "end": 12343,
      "text": " يحولُ بينَ المؤمنِ والكفرِ، وبين الكافرِ والإيمانِ، وقولُ من قال:",
      "markers": []
    },
    {
      "id": "s197",
      "start": 12343,
      "end": 12381,
      "text": " يحولُ بينَه وبينَ عقله. وقولُ من قال:",
      "markers": []
    },
    {
      "id": "s198",
      "start": 12381,
      "end": 12451,
      "text": " يحولُ بينَه وبينَ قلبِه حتى لا يستطيعَ أن يؤمنَ ولا يكفرَ إلا بإذنِه؛",
      "markers": []
    },
    {
      "id": "s199",
      "start": 12451,
      "end": 12585,
      "text": " لأن اللهَ عزَّ وجلَّ إذا حال بينَ عبدٍ وقلبِه، لم يفهَمِ العبدُ بقلبِه الذي قد حِيل بينَه وبينَه ما مُنِع إدراكَه به، على ما بيَّنتُ.",
      "markers": []
    },
    {
      "id": "s200",
      "start": 12585,
      "end": 12610,
      "text": " غيرَ أنه ينبغي أن يقالَ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 12604,
          "end": 12608,
          "span_id": "s200"
        }
      ]
    },
    {
      "id": "s201",
      "start": 12610,
      "end": 12697,
      "text": " إن اللهَ عمَّ بقولِه: {وَاعْلَمُوا أَنَّ اللَّهَ يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12633,
          "end": 12696,
          "span_id": "s201"
        }
      ]
    },
    {
      "id": "s202",
      "start": 12697,
      "end": 12785,
      "text": " عن الخبرِ أنه يحولُ بينَ العبدِ وقلبِه، ولم يَخْصُصْ من المعانى التى ذكَرنا شيئًا دونَ ",
      "markers": []
    },
    {
      "id": "s203",
      "start": 12789,
      "end": 12886,
      "text": "شيءٍ، والكلامُ مُحْتَمِلٌ كُلَّ هذه المعانى، فالخبرُ على العمومِ حتى يخُصَّه ما يجبُ التسليمُ له.",
      "markers": []
    },
    {
      "id": "s204",
      "start": 12890,
      "end": 12935,
      "text": "وأما قولُه: {وَأَنَّهُ إِلَيْهِ تُحْشَرُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12902,
          "end": 12934,
          "span_id": "s204"
        }
      ]
    },
    {
      "id": "s205",
      "start": 12935,
      "end": 13353,
      "text": " فإن معناه: واعلَموا أيُّها المؤمنون أيضًا مع العلم بأن اللهَ يحولُ بين المرءِ وقلبِه، أن اللهَ الذي يقدِرُ على قلوبِكم وهو أملَكُ بها منكم، إليه مصيرُكم ومرجِعُكم في القيامةِ، فيوفِّيكم جزاءَ أعمالِكم، المحسنَ منكم بإحسانِه، والمسئَ بإساءتِه، فاتَّقوه وراقِبوه فيما أمَركم ونهاكم هو ورسولُه أن تُضيِّعوه، وألا تستجيبوا لرسولِه إذا دعاكم لما يُحييكم، فيُوجِبَ ذلك سَخَطَه، وتستحِقوا به أليمَ عذابِه حينَ تُحْشرون إليه.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 12940,
          "end": 12945,
          "span_id": "s205"
        }
      ]
    }
  ],

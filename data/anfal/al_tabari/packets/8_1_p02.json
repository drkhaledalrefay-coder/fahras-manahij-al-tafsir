  "spans": [
    {
      "id": "s109",
      "start": 6314,
      "end": 6358,
      "text": "حدَّثني الحارثُ، قال: ثنا عبدُ العزيزِ، قال:",
      "markers": []
    },
    {
      "id": "s110",
      "start": 6358,
      "end": 6412,
      "text": " ثنا عبد الوارث بن سعيدٍ، عن ابن أبي نَجيحٍ، عن مجاهد:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6384,
          "end": 6412,
          "stripped": "عن ابن أبي نجيح، عن مجاهد:",
          "span_id": "s110"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 6406,
          "end": 6411,
          "span_id": "s110"
        }
      ]
    },
    {
      "id": "s111",
      "start": 6412,
      "end": 6497,
      "text": " {يَسْأَلُونَكَ عَنِ الْأَنفَالِ}. قال: هو الخُمُسُ، قال المهاجرون: لِمَ يُرفَعُ عنا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6413,
          "end": 6445,
          "span_id": "s111"
        }
      ]
    },
    {
      "id": "s112",
      "start": 6538,
      "end": 6566,
      "text": " هذا الخُمُسُ؟ لم يُخرج منا؟",
      "markers": []
    },
    {
      "id": "s113",
      "start": 6566,
      "end": 6593,
      "text": " فقال الله: هو لله والرسول ",
      "markers": []
    },
    {
      "id": "s114",
      "start": 6624,
      "end": 6625,
      "text": ".",
      "markers": []
    },
    {
      "id": "s115",
      "start": 6629,
      "end": 6656,
      "text": "حدَّثنا أحمد بن إسحاق، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6629,
          "end": 6636,
          "span_id": "s115"
        }
      ]
    },
    {
      "id": "s116",
      "start": 6656,
      "end": 6857,
      "text": " ثنا أبو أحمد، قال: ثنا عبادُ بنُ العوَّامِ، عن الحجاجِ، عن ابن أبي نَجيحٍ، عن مجاهدٍ، أنهم سألوا النبيَّ - صلى الله عليه وسلم - عن الخمس بعد الأربعة الأخماسِ، فنزلتْ: {يَسْأَلُونَكَ عَنِ الْأَنفَالِ} ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6701,
          "end": 6734,
          "stripped": "عن الحجاج، عن ابن أبي نجيح، عن",
          "span_id": "s116"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 6735,
          "end": 6740,
          "span_id": "s116"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6764,
          "end": 6782,
          "span_id": "s116"
        },
        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 6816,
          "end": 6821,
          "span_id": "s116"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6824,
          "end": 6856,
          "span_id": "s116"
        }
      ]
    },
    {
      "id": "s117",
      "start": 6909,
      "end": 6910,
      "text": ".",
      "markers": []
    },
    {
      "id": "s118",
      "start": 6914,
      "end": 6984,
      "text": "قال أبو جعفر: وأوْلى هذه الأقوال بالصواب في معنى الأنفال قولُ مَن قال:",
      "markers": []
    },
    {
      "id": "s119",
      "start": 6984,
      "end": 7050,
      "text": " هي زياداتٌ يزيدُها الإمامُ بعض الجيش أو جميعهم، إمّا مِن سَلَبِه ",
      "markers": []
    },
    {
      "id": "s120",
      "start": 7081,
      "end": 7150,
      "text": " على حقوقهم من القسمةِ، وإمَّا مما وصَل إليه بالنفَلِ أو ببعض أسبابه؛",
      "markers": []
    },
    {
      "id": "s121",
      "start": 7150,
      "end": 7243,
      "text": " ترغيبا له، وتحريضا لمن معه من جيْشِه على ما فيه صلاحهم وصلاح المسلمين، أو صلاح أحد الفريقين.",
      "markers": []
    },
    {
      "id": "s122",
      "start": 7243,
      "end": 7392,
      "text": " وقد يدخُلُ في ذلك ما قال ابن عباسٍ من أنه الفرسُ والدرع ونحو ذلك، ويدخُلُ فيه ما قاله عطاء من أن ذلك ما عاد من المشركين إلى المسلمين من عبد أو فرسٍ؛",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 7269,
          "end": 7277,
          "span_id": "s122"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 7330,
          "end": 7334,
          "span_id": "s122"
        }
      ]
    },
    {
      "id": "s123",
      "start": 7392,
      "end": 7528,
      "text": " لأن ذلك أمره إلى الإمام، إذا لم يكن ما وصَلوا إليه لغلبةٍ وقهرٍ، يفعَل ما فيه صلاح أهل الإسلام، وقد يدخُلُ فيه ما غلب عليه الجيش بقهرٍ.",
      "markers": []
    },
    {
      "id": "s124",
      "start": 7532,
      "end": 7570,
      "text": "وإنما قلنا: ذلك أولى الأقوال بالصوابِ؛",
      "markers": []
    },
    {
      "id": "s125",
      "start": 7570,
      "end": 7637,
      "text": " لأن النَّفَل في كلام العرَبِ، إنما هو الزيادة على الشيء، يقال منه:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 7628,
          "end": 7632,
          "span_id": "s125"
        }
      ]
    },
    {
      "id": "s126",
      "start": 7637,
      "end": 7678,
      "text": " نفَّلتُك كذا وأَنْفَلْتُك: إِذا زِدْتُك.",
      "markers": []
    },
    {
      "id": "s127",
      "start": 7682,
      "end": 7731,
      "text": "والأنفالُ: جمعُ نَفَلٍ، ومنه قولُ لبيد بن ربيعةَ ",
      "markers": []
    },
    {
      "id": "s128",
      "start": 7754,
      "end": 7755,
      "text": ":",
      "markers": []
    },
    {
      "id": "s129",
      "start": 7759,
      "end": 7797,
      "text": "إِنَّ تَقْوَى رَبِّنَا خَيْرُ نَفَلْ .",
      "markers": []
    },
    {
      "id": "s130",
      "start": 7797,
      "end": 7833,
      "text": ".. وبإِذْنِ اللَّهِ رَيْثِي وَعَجَلْ",
      "markers": []
    },
    {
      "id": "s131",
      "start": 7837,
      "end": 8005,
      "text": "فإذ كان معناه ما ذكَرْنا، فكلُّ مَن زِيدَ مِن مُقَاتِلَةِ الجيش على سهمه من الغنيمة، إن كان ذلك لبلاءٍ أبلَاه أو لغَناءٍ كان منه عن المسلمين، بتنفيل الوالي ذلك إيَّاه، ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 7845,
          "end": 7850,
          "span_id": "s131"
        }
      ]
    },
    {
      "id": "s132",
      "start": 8016,
      "end": 8017,
      "text": " ",
      "markers": []
    },
    {
      "id": "s133",
      "start": 8033,
      "end": 8138,
      "text": " حكم ذلك له، كالسَّلَبِ الذي يَسْلُبُه القاتِلُ - فهو مُنَفَّلٌ ما زيد مِنْ ذلك؛ لأنَّ الزيادةَ الفَضْلُ ",
      "markers": []
    },
    {
      "id": "s134",
      "start": 8259,
      "end": 8269,
      "text": "، وإن كان ",
      "markers": []
    },
    {
      "id": "s135",
      "start": 8289,
      "end": 8303,
      "text": " مُسْتَوجِبَه ",
      "markers": []
    },
    {
      "id": "s136",
      "start": 8320,
      "end": 8342,
      "text": " في بعض الأحوال لحقٍّ ",
      "markers": []
    },
    {
      "id": "s137",
      "start": 8364,
      "end": 8366,
      "text": "، ",
      "markers": []
    },
    {
      "id": "s138",
      "start": 8374,
      "end": 8375,
      "text": " ",
      "markers": []
    },
    {
      "id": "s139",
      "start": 8391,
      "end": 8447,
      "text": " من الغنيمة التي تقعُ فيها القسمة. وكذلك كلُّ ما رُضِخَ ",
      "markers": []
    },
    {
      "id": "s140",
      "start": 8490,
      "end": 8528,
      "text": " لمن لا سهمَ له في الغنيمة فهو نَفَلٌ؛",
      "markers": []
    },
    {
      "id": "s141",
      "start": 8528,
      "end": 8585,
      "text": " لأنَّه وإن كان مغلوبًا عليه، فليس مما وقعت عليه القسمةُ.",
      "markers": []
    },
    {
      "id": "s142",
      "start": 8589,
      "end": 8641,
      "text": "فالفصلُ - إذ كان الأمرُ على ما وصَفنا - بين الغنيمة ",
      "markers": []
    },
    {
      "id": "s143",
      "start": 8674,
      "end": 8688,
      "text": " والنفَلِ، أن ",
      "markers": []
    },
    {
      "id": "s144",
      "start": 8716,
      "end": 8856,
      "text": " الغنيمة هي ما أفاء الله على المسلمين من أموال المشركين بغلبةٍ وقهرٍ، نُفِّل منه مُنَفَّلٌ أو لم يُنفَّلْ، والنَّفَلُ: هو ما أعطِيَه المرءُ ",
      "markers": []
    },
    {
      "id": "s145",
      "start": 8872,
      "end": 8919,
      "text": " على البلاء والغَنَاءِ عن الجيش على غيرِ قسمةٍ.",
      "markers": []
    },
    {
      "id": "s146",
      "start": 8923,
      "end": 8966,
      "text": "وإذْ كان ذلك معنى النَّفَلِ، فتأويل الكلام:",
      "markers": []
    },
    {
      "id": "s147",
      "start": 8966,
      "end": 9078,
      "text": " يسألُكَ أصحابك يا محمد عن الفضلِ من المال الذي تقعُ فيه القِسْمة من غنيمة كفار قريش الذين قتلوا ببدرٍ لمنْ هوَ؟",
      "markers": []
    },
    {
      "id": "s148",
      "start": 9078,
      "end": 9124,
      "text": " قل لهم يا محمد: هو لله ولرسوله دونَكم، يجعله ",
      "markers": []
    },
    {
      "id": "s149",
      "start": 9148,
      "end": 9158,
      "text": " حيث شاءَ.",
      "markers": []
    },
    {
      "id": "s150",
      "start": 9162,
      "end": 9210,
      "text": "واختُلِف في السببِ الذي من أجله نزلت هذه الآيةُ؛",
      "markers": []
    },
    {
      "id": "s151",
      "start": 9210,
      "end": 9243,
      "text": " فقال بعضُهم: نزلت في غنائم بدرٍ؛",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "نزلت في",
          "start": 9224,
          "end": 9231,
          "span_id": "s151"
        }
      ]
    },
    {
      "id": "s152",
      "start": 9243,
      "end": 9397,
      "text": " لأنَّ النبي - صلى الله عليه وسلم - كان نفَّل أقوامًا على بلاءٍ، فأبلى أقوام وتخلَّف آخرُون مع رسول الله - صلى الله عليه وسلم -، فاختلفوا فيها بعد انقضاء ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أن النبي",
          "start": 9245,
          "end": 9255,
          "span_id": "s152"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 9258,
          "end": 9276,
          "span_id": "s152"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 9350,
          "end": 9368,
          "span_id": "s152"
        }
      ]
    },
    {
      "id": "s153",
      "start": 9505,
      "end": 9619,
      "text": " الحربِ، فأنزل الله هذه الآيةَ على رسولِه، يُعْلِمُهم أن ما فعل فيها رسول الله - صلى الله عليه وسلم - فماضٍ جائزٌ.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 9514,
          "end": 9519,
          "span_id": "s153"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 9514,
          "end": 9524,
          "span_id": "s153"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 9586,
          "end": 9604,
          "span_id": "s153"
        }
      ]
    },
    {
      "id": "s154",
      "start": 9623,
      "end": 9639,
      "text": "ذِكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s155",
      "start": 9643,
      "end": 9673,
      "text": "حدثنا محمد بن عبد الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9643,
          "end": 9648,
          "span_id": "s155"
        }
      ]
    },
    {
      "id": "s156",
      "start": 9673,
      "end": 9700,
      "text": " ثنا معتمرُ بن سليمان، قال:",
      "markers": []
    },
    {
      "id": "s157",
      "start": 9700,
      "end": 9786,
      "text": " سمعتُ داود بن أبي هند يحدِّثُ عن عكرمة، عن ابن عباس، أن النبي صلى الله عليه وسلم قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9731,
          "end": 9762,
          "stripped": "عن عكرمة، عن ابن عباس، أن النبي",
          "span_id": "s157"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 9734,
          "end": 9739,
          "span_id": "s157"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 9744,
          "end": 9752,
          "span_id": "s157"
        },
        {
          "family": "HADITH",
          "marker": "أن النبي",
          "start": 9754,
          "end": 9762,
          "span_id": "s157"
        },
        {
          "family": "HADITH",
          "marker": "النبي",
          "role": "SPEAKER",
          "start": 9757,
          "end": 9762,
          "span_id": "s157"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 9763,
          "end": 9781,
          "span_id": "s157"
        }
      ]
    },
    {
      "id": "s158",
      "start": 9786,
      "end": 9820,
      "text": " \"مَنْ أَتَى مَكانَ كَذَا وَكَذَا ",
      "markers": []
    },
    {
      "id": "s159",
      "start": 9848,
      "end": 9899,
      "text": "، أَوْ فَعَلَ كَذَا وَكَذَا، فَلَهُ كَذَا وَكَذَا\".",
      "markers": []
    },
    {
      "id": "s160",
      "start": 9899,
      "end": 10042,
      "text": " فتسارع إليه الشبَّانُ، وبقى الشيوخ عند الرايات، فلمَّا فتَح الله عليهم، جاءوا يطلبون ما جعل لهم النبي - صلى الله عليه وسلم - فقال لهم الأشياخ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 10004,
          "end": 10022,
          "span_id": "s160"
        }
      ]
    },
    {
      "id": "s161",
      "start": 10042,
      "end": 10093,
      "text": " لا تذهَبوا به دونَنا. فأنزل الله تعالى هذه الآيةَ:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 10065,
          "end": 10070,
          "span_id": "s161"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 10065,
          "end": 10075,
          "span_id": "s161"
        }
      ]
    },
    {
      "id": "s162",
      "start": 10093,
      "end": 10145,
      "text": " {فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10094,
          "end": 10144,
          "span_id": "s162"
        }
      ]
    },
    {
      "id": "s163",
      "start": 10559,
      "end": 10560,
      "text": ".",
      "markers": []
    },
    {
      "id": "s164",
      "start": 10564,
      "end": 10624,
      "text": "حدَّثنا المثنى، قال: ثنا عبد الأعلى، وحدَّثنا ابن وكيع، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10564,
          "end": 10571,
          "span_id": "s164"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10602,
          "end": 10609,
          "span_id": "s164"
        }
      ]
    },
    {
      "id": "s165",
      "start": 10624,
      "end": 10684,
      "text": " ثنا عبد الأعلى، قال: ثنا داودُ، عن عكرمة، عن ابن عباس، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10657,
          "end": 10684,
          "stripped": "عن عكرمة، عن ابن عباس، قال:",
          "span_id": "s165"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 10660,
          "end": 10665,
          "span_id": "s165"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 10670,
          "end": 10678,
          "span_id": "s165"
        }
      ]
    },
    {
      "id": "s166",
      "start": 10684,
      "end": 10741,
      "text": " لما كان يوم بدرٍ، قال رسولُ الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 10693,
          "end": 10700,
          "span_id": "s166"
        },
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 10703,
          "end": 10717,
          "span_id": "s166"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 10720,
          "end": 10738,
          "span_id": "s166"
        }
      ]
    },
    {
      "id": "s167",
      "start": 10741,
      "end": 10791,
      "text": " \"مَنْ صَنَعَ كَذَا وَكَذَا فَلَهُ كَذَا وَكَذَا\".",
      "markers": []
    },
    {
      "id": "s168",
      "start": 10791,
      "end": 10865,
      "text": " قال: فتسارع في ذلك شبَّانُ الرجالِ، وبقيت الشيوخ تحت الراياتِ، فلما كانت ",
      "markers": []
    },
    {
      "id": "s169",
      "start": 10895,
      "end": 10947,
      "text": " الغنائم، جاءوا يطلبون الذي جُعِل لهم، فقالت الشيوخ:",
      "markers": []
    },
    {
      "id": "s170",
      "start": 10947,
      "end": 11031,
      "text": " لا تسْتأثِرُوا علينا؛ فإنا كنا رِدْءًا لكم، وكنا تحتَ الرايات، ولو انكشفتم انكشفتم ",
      "markers": []
    },
    {
      "id": "s171",
      "start": 11047,
      "end": 11257,
      "text": " إلينا. فتنازَعُوا، فأنزَلَ اللَّهُ: {يَسْأَلُونَكَ عَنِ الْأَنفَالِ قُل الأَنفَالُ لِلَّهِ وَالرَّسُول فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ وَأَطِيعُوا اللَّهَ وَرَسُولَهُ إِن كُنتُم مُّؤْمِنِينَ} ",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 11067,
          "end": 11073,
          "span_id": "s171"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 11067,
          "end": 11081,
          "span_id": "s171"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11084,
          "end": 11256,
          "span_id": "s171"
        }
      ]
    },
    {
      "id": "s172",
      "start": 11303,
      "end": 11304,
      "text": ".",
      "markers": []
    },
    {
      "id": "s173",
      "start": 11308,
      "end": 11335,
      "text": "حدثني إسحاق بن شاهينَ، قال:",
      "markers": []
    },
    {
      "id": "s174",
      "start": 11335,
      "end": 11401,
      "text": " ثنا خالدُ بنُ عبدِ اللَّهِ، عن داودَ، عن عكرمة، عن ابن عباس، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11364,
          "end": 11401,
          "stripped": "عن داود، عن عكرمة، عن ابن عباس، قال:",
          "span_id": "s174"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 11377,
          "end": 11382,
          "span_id": "s174"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 11387,
          "end": 11395,
          "span_id": "s174"
        }
      ]
    },
    {
      "id": "s175",
      "start": 11401,
      "end": 11460,
      "text": " لما كان يوم بدر، قال رسولُ اللَّهِ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 11410,
          "end": 11417,
          "span_id": "s175"
        },
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 11419,
          "end": 11435,
          "span_id": "s175"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11439,
          "end": 11457,
          "span_id": "s175"
        }
      ]
    },
    {
      "id": "s176",
      "start": 11460,
      "end": 11516,
      "text": " \"مَنْ فَعَلَ كَذَا فَلَهُ كَذَا وَكَذَا مِن النَّفَلِ\".",
      "markers": []
    },
    {
      "id": "s177",
      "start": 11516,
      "end": 11572,
      "text": " قال: فتقدّم الفتيانُ، ولزم المشيخة الرايات فلم يبرَحوا ",
      "markers": []
    },
    {
      "id": "s178",
      "start": 11602,
      "end": 11636,
      "text": "، فلما فُتِحَ عليهم قالت المشيخةُ:",
      "markers": []
    },
    {
      "id": "s179",
      "start": 11636,
      "end": 11705,
      "text": " كنا ردءًا لكم، فلو انهزمتم انحزتُم إلينا، لا تذهَبوا بالمغنم دونَنا.",
      "markers": []
    },
    {
      "id": "s180",
      "start": 11705,
      "end": 11771,
      "text": " فأبى الفتيانُ، وقالوا: جعله رسول الله - صلى الله عليه وسلم - لنا.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11746,
          "end": 11764,
          "span_id": "s180"
        }
      ]
    },
    {
      "id": "s181",
      "start": 11771,
      "end": 11854,
      "text": " فأنزل الله: {يَسْأَلُونَكَ عَنِ الْأَنفَالِ قُلِ الْأَنفَالُ لِلَّهِ وَالرَّسُول}.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 11772,
          "end": 11777,
          "span_id": "s181"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 11772,
          "end": 11782,
          "span_id": "s181"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11784,
          "end": 11853,
          "span_id": "s181"
        }
      ]
    },
    {
      "id": "s182",
      "start": 11854,
      "end": 11911,
      "text": " قال: فكان ذلك خيرًا لهم، وكذلك أيضًا أطيعوني فإني أعلمُ ",
      "markers": []
    },
    {
      "id": "s183",
      "start": 12005,
      "end": 12006,
      "text": " ",
      "markers": []
    },
    {
      "id": "s184",
      "start": 12112,
      "end": 12113,
      "text": ".",
      "markers": []
    },
    {
      "id": "s185",
      "start": 12117,
      "end": 12143,
      "text": "حدثنا محمد بن المثنى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 12117,
          "end": 12122,
          "span_id": "s185"
        }
      ]
    },
    {
      "id": "s186",
      "start": 12143,
      "end": 12197,
      "text": " ثنا عبد الوهاب، قال: ثنا داود، عن عكرمة في هذه الآية:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 12178,
          "end": 12183,
          "span_id": "s186"
        }
      ]
    },
    {
      "id": "s187",
      "start": 12197,
      "end": 12269,
      "text": " {يَسْأَلُونَكَ عَنِ الْأَنفَالِ قُلِ الْأَنفَالُ لِلَّهِ وَالرَّسُولِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12198,
          "end": 12268,
          "span_id": "s187"
        }
      ]
    },
    {
      "id": "s188",
      "start": 12269,
      "end": 12325,
      "text": " قال: لما كان يوم بدر، قال النبي - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 12283,
          "end": 12290,
          "span_id": "s188"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 12304,
          "end": 12322,
          "span_id": "s188"
        }
      ]
    },
    {
      "id": "s189",
      "start": 12325,
      "end": 12386,
      "text": " \"مَنْ صَنَعَ كَذَا فَلَهُ مِن النَّفَل كَذَا\". فخرج شبَّانُ ",
      "markers": []
    },
    {
      "id": "s190",
      "start": 12404,
      "end": 12464,
      "text": " الرجال فجعَلوا يصنَعونَه، فلما كان عند القسمةِ، قال الشيوخ:",
      "markers": []
    },
    {
      "id": "s191",
      "start": 12464,
      "end": 12506,
      "text": " نحن أصحابُ الراياتِ، وقد كنا رِدْءًا لكم.",
      "markers": []
    },
    {
      "id": "s192",
      "start": 12506,
      "end": 12674,
      "text": " فأنزل الله في ذلك: {قُلِ الْأَنْفَالُ لِلَّهِ وَالرَّسُولِ فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ وَأَطِيعُوا اللَّهَ وَرَسُولَهُ إِنْ كُنْتُمْ مُؤْمِنِينَ}.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 12507,
          "end": 12512,
          "span_id": "s192"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 12507,
          "end": 12517,
          "span_id": "s192"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12526,
          "end": 12673,
          "span_id": "s192"
        }
      ]
    },
    {
      "id": "s193",
      "start": 12678,
      "end": 12732,
      "text": "حدثني المثنى، قال: ثنا إسحاق، قال: ثنا يعقوب الزهريُّ ",
      "markers": []
    },
    {
      "id": "s194",
      "start": 12781,
      "end": 12884,
      "text": "، قال: ثنى المغيرةُ بن عبد الرحمن، عن أبيه، عن سليمان بن موسى، عن مكحولٍ مولَى هُذَيلٍ، عن أبي سلَّامٍ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 12816,
          "end": 12846,
          "stripped": "عن أبيه، عن سليمان بن موسى، عن",
          "span_id": "s194"
        }
      ]
    },
    {
      "id": "s195",
      "start": 12944,
      "end": 12997,
      "text": " الباهليِّ، عن أبي أمامة، عن عُبادةَ بن الصامتِ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 12956,
          "end": 12997,
          "stripped": "عن أبي أمامة، عن عبادة بن الصامت، قال:",
          "span_id": "s195"
        }
      ]
    },
    {
      "id": "s196",
      "start": 12997,
      "end": 13055,
      "text": " أَنزَلَ اللَّهُ حِينَ اختلَف القومُ في الغنائم يومَ بدرٍ:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 13045,
          "end": 13053,
          "span_id": "s196"
        }
      ]
    },
    {
      "id": "s197",
      "start": 13055,
      "end": 13099,
      "text": " {يَسْأَلُونَكَ عَنِ الْأَنفَالِ}. إلى قوله:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13056,
          "end": 13088,
          "span_id": "s197"
        }
      ]
    },
    {
      "id": "s198",
      "start": 13099,
      "end": 13184,
      "text": " {إن كُنتُم مُؤْمِنِينَ}، فقسمه رسولُ اللَّهِ - صلى الله عليه وسلم - بينهم عن بَوَاء ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13100,
          "end": 13123,
          "span_id": "s198"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 13147,
          "end": 13165,
          "span_id": "s198"
        }
      ]
    },
    {
      "id": "s199",
      "start": 13537,
      "end": 13538,
      "text": ".",
      "markers": []
    },
    {
      "id": "s200",
      "start": 13542,
      "end": 13587,
      "text": "حدثنا ابن حميدٍ، قال: ثنا سلمة، عن محمد، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 13542,
          "end": 13547,
          "span_id": "s200"
        }
      ]
    },
    {
      "id": "s201",
      "start": 13587,
      "end": 13697,
      "text": " ثنى عبد الرحمن بنُ الحارث وغيره من أصحابنا، عن سليمان بن موسى الأشدقِ، عن مكحول، عن أبي أمامة الباهليِّ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 13632,
          "end": 13681,
          "stripped": "عن سليمان بن موسى الأشدق، عن مكحول، عن أبي أمامة",
          "span_id": "s201"
        }
      ]
    },
    {
      "id": "s202",
      "start": 13697,
      "end": 13738,
      "text": " سألتُ عبادة بن الصامتِ عن الأنفال، فقال:",
      "markers": []
    },
    {
      "id": "s203",
      "start": 13738,
      "end": 13938,
      "text": " فينا معشر أصحاب بدرٍ نزَلتْ، حين اختلفنا في النَّفَل وساءت فيه أخلاقنا، فنزعه الله من أيدينا، فجعَله إلى رسول الله - صلى الله عليه وسلم -، وقسَمه رسول الله صلى الله عليه وسلم بين المسلمين عن بَوَاءٍ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 13856,
          "end": 13874,
          "span_id": "s203"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 13895,
          "end": 13913,
          "span_id": "s203"
        }
      ]
    },
    {
      "id": "s204",
      "start": 13953,
      "end": 14053,
      "text": " - يقولُ: على السواءِ - فكان في ذلك تقوى الله، وطاعة رسوله - صلى الله عليه وسلم -، وصلاح ذات البينِ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 14014,
          "end": 14032,
          "span_id": "s204"
        }
      ]
    },
    {
      "id": "s205",
      "start": 14406,
      "end": 14407,
      "text": ".",
      "markers": []
    },
    {
      "id": "s206",
      "start": 14411,
      "end": 14426,
      "text": "وقال آخرون: بل ",
      "markers": []
    },
    {
      "id": "s207",
      "start": 14449,
      "end": 14657,
      "text": " إنما نزلت هذه الآيةُ؛ لأن بعض أصحاب رسول الله - صلى الله عليه وسلم - سأله من المغنم شيئًا قبلَ قِسْمَتِها، فلم يُعْطِه إيَّاه، إذ كان شركًا بين الجيشِ، فجعَل الله جميعَ ذلك لرسول الله - صلى الله عليه وسلم -.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 14498,
          "end": 14516,
          "span_id": "s207"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 14636,
          "end": 14654,
          "span_id": "s207"
        }
      ]
    },
    {
      "id": "s208",
      "start": 14661,
      "end": 14675,
      "text": "ذكر من قال ذلك",
      "markers": []
    },
    {
      "id": "s209",
      "start": 14679,
      "end": 14716,
      "text": "حدثني إسماعيل بن موسى السُّديُّ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 14701,
          "end": 14708,
          "span_id": "s209"
        }
      ]
    },
    {
      "id": "s210",
      "start": 14716,
      "end": 14770,
      "text": " ثنا أبو الأحوص، عن عاصم، عن مصعب بن سعد، عن سعد، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 14733,
          "end": 14760,
          "stripped": "عن عاصم، عن مصعب بن سعد، عن",
          "span_id": "s210"
        }
      ]
    },
    {
      "id": "s211",
      "start": 14770,
      "end": 14827,
      "text": " أتيت النبي - صلى الله عليه وسلم - يومَ بدرٍ بسيفٍ، فقلت:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 14784,
          "end": 14802,
          "span_id": "s211"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 14805,
          "end": 14813,
          "span_id": "s211"
        },
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 14823,
          "end": 14826,
          "span_id": "s211"
        }
      ]
    },
    {
      "id": "s212",
      "start": 14827,
      "end": 14904,
      "text": " يا رسولَ اللهِ، هذا السيفُ قد شفَى الله به من المشركين، فسألته إيَّاه، فقال:",
      "markers": []
    },
    {
      "id": "s213",
      "start": 14904,
      "end": 14926,
      "text": " \"ليسَ هذا لي ولا لك\".",
      "markers": []
    },
    {
      "id": "s214",
      "start": 14926,
      "end": 15031,
      "text": " قال: فلما ولَّيتُ، قلتُ: أخافُ أن يُعطيه من لم يُبل بلائي، فإذا رسول الله - صلى الله عليه وسلم - خلْفِى.",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 14946,
          "end": 14949,
          "span_id": "s214"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 15003,
          "end": 15021,
          "span_id": "s214"
        }
      ]
    },
    {
      "id": "s215",
      "start": 15031,
      "end": 15074,
      "text": " قال: فقلتُ: أخافُ أن يكونَ نزَل فيَّ شيءٌ.",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 15038,
          "end": 15041,
          "span_id": "s215"
        }
      ]
    },
    {
      "id": "s216",
      "start": 15074,
      "end": 15101,
      "text": " قال: \"إن السيف قد صار لي\".",
      "markers": []
    },
    {
      "id": "s217",
      "start": 15101,
      "end": 15157,
      "text": " قال: فأعطانيه، ونزلت: {يَسْأَلُونَكَ عَنِ الْأَنفَالِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 15124,
          "end": 15156,
          "span_id": "s217"
        }
      ]
    }
  ],

    {
      "id": "s004",
      "start": 41,
      "end": 86,
      "text": "القول في تفسير السورة التي يُذكر فيها الأنفال",
      "markers": []
    },
    {
      "id": "s005",
      "start": 90,
      "end": 183,
      "text": "القول في تأويل قوله: {يَسْأَلُونَكَ عَنِ الْأَنْفَالِ قُلِ الْأَنفَالُ لِلَّهِ وَالرَّسُولِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 111,
          "end": 182,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 187,
      "end": 252,
      "text": "اختلف أهل التأويل في معنى الأنفال التي ذكرها الله في هذا الموضعِ؛",
      "markers": []
    },
    {
      "id": "s007",
      "start": 252,
      "end": 285,
      "text": " فقال بعضُهم: هي الغنائم. وقالوا:",
      "markers": []
    },
    {
      "id": "s008",
      "start": 285,
      "end": 395,
      "text": " معنى الكلام: يسألك أصحابك يا محمد عن الغنائم التي غَنِمتَها أنت وأصحابك يوم بدر لمن هي؟ فقلْ: هي لله ولرسوله.",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 358,
          "end": 365,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 399,
      "end": 414,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s010",
      "start": 418,
      "end": 433,
      "text": "حدثنا ابن وكيع ",
      "markers": [

          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 1634,
      "end": 1691,
      "text": " {يَسْأَلُونَكَ عَنِ الْأَنفَالِ}. قال: الأنفالُ الغنائم ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1635,
          "end": 1667,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 1744,
      "end": 1745,
      "text": ".",
      "markers": []
    },
    {
      "id": "s039",
      "start": 1749,
      "end": 1786,
      "text": "حدثني يونس، قال: أخبرنا ابن وهب، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 1766,
          "end": 1772,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 1786,
      "end": 1816,
      "text": " قال ابن زيد: الأنفال الغنائم ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 1791,
          "end": 1798,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 1849,
      "end": 1850,
      "text": ".",
      "markers": []
    },
    {
      "id": "s042",
      "start": 1854,
      "end": 1879,
      "text": "حدثنا أحمد بن إسحاق، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1854,
          "end": 1859,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 1879,
      "end": 1939,
      "text": " ثنا أبو أحمد، قال: ثنا ابن المبارك، عن ابن جُريجٍ، عن عطاء:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1916,
          "end": 1939,
          "stripped": "عن ابن جريج، عن عطاء:",
          "span_id": "s043"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 1919,
          "end": 1928,
          "span_id": "s043"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 1934,
          "end": 1938,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 1939,
      "end": 1988,
      "text": " {يَسْأَلُونَكَ عَنِ الْأَنفَالِ}. قال: الغنائمُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1940,
          "end": 1972,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 2111,
      "end": 2112,
      "text": ".",
      "markers": []
    },
    {
      "id": "s046",
      "start": 2116,
      "end": 2148,
      "text": "وقال آخرون: هي أنفالُ السَّرايا.",
      "markers": []
    },
    {
      "id": "s047",
      "start": 2152,
      "end": 2168,
      "text": "ذِكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s048",
      "start": 2172,
      "end": 2214,
      "text": "حدَّثني الحارثُ، قال: ثنا عبد العزيز، قال:",
      "markers": []
    },
    {
      "id": "s049",
      "start": 2214,
      "end": 2246,
      "text": " ثنا عليُّ بن صالح بن حيٍّ، قال:",
      "markers": []
    },
    {
      "id": "s050",
      "start": 2246,
      "end": 2311,
      "text": " بلغنى في قوله: {يَسْأَلُونَكَ عَنِ الْأَنفَالِ}. قال: السَّرايا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2262,
          "end": 2294,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 2354,
      "end": 2355,
      "text": ".",
      "markers": []
    },
    {
      "id": "s052",
      "start": 2359,
      "end": 2432,
      "text": "وقال آخرون: الأنفال ما شذَّ من المشركين إلى المسلمين من عبد أو دابَّة أو ",
      "markers": []
    },
    {
      "id": "s053",
      "start": 2449,
      "end": 2462,
      "text": " ما أشبه ذلك.",
      "markers": []
    },
    {
      "id": "s054",
      "start": 2466,
      "end": 2480,
      "text": "ذكر من قال ذلك",
      "markers": []
    },
    {
      "id": "s055",
      "start": 2484,
      "end": 2555,
      "text": "حدثنا أبو كريبٍ، قال: ثنا جابر بن نوحٍ، عن عبد الملكِ، عن عطاء في قوله:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2484,
          "end": 2489,
          "span_id": "s055"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2524,
          "end": 2555,
          "stripped": "عن عبد الملك، عن عطاء في قوله:",
          "span_id": "s055"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 2542,
          "end": 2546,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 2555,
      "end": 2627,
      "text": " {يَسْأَلُونَكَ عَنِ الْأَنفَالِ قُلِ الْأَنفَالُ لِلَّهِ وَالرَّسُولِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2556,
          "end": 2626,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 2627,
      "end": 2680,
      "text": " قال: هو ما شذَّ من المشركين إلى المسلمين بغير قتالٍ؛",
      "markers": []
    },
    {
      "id": "s058",
      "start": 2680,
      "end": 2755,
      "text": " دابَّةٌ أو عبد أو متاعٌ، ذلك للنبي - صلى الله عليه وسلم - يصنع فيه ما شاء ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2718,
          "end": 2736,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 2918,
      "end": 2919,
      "text": ".",
      "markers": []
    },
    {
      "id": "s060",
      "start": 2923,
      "end": 3015,
      "text": "حدثنا ابن وكيع، قال: ثنا ابن نميرٍ، عن عبد الملك، عن عطاء: {يَسْأَلُونَكَ عَنِ الْأَنفَالِ}.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2923,
          "end": 2928,
          "span_id": "s060"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2959,
          "end": 3015,
          "stripped": "عن عبد الملك، عن عطاء: {يسألونك عن الأنفال}.",
          "span_id": "s060"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "NARRATOR",
          "start": 2976,
          "end": 2980,
          "span_id": "s060"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2982,
          "end": 3014,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 3019,
      "end": 3102,
      "text": "قال: هي ما شذَّ من المشركين إلى المسلمين بغير قتال من عبد أو أمة أو متاعٍ أو نَفَل ",
      "markers": []
    },
    {
      "id": "s062",
      "start": 3235,
      "end": 3286,
      "text": "، فهو للنبي - صلى الله عليه وسلم - يصنع فيه ما شاء ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3249,
          "end": 3267,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 3361,
      "end": 3362,
      "text": ".",
      "markers": []
    },
    {
      "id": "s064",
      "start": 3366,
      "end": 3459,
      "text": "قال: ثنا عبد الأعلى، عن معمرٍ، عن الزهريِّ، أن ابن عباس سُئل عن الأنفال، فقال: السلب والفرسُ.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3387,
          "end": 3421,
          "stripped": "عن معمر، عن الزهري، أن ابن عباس",
          "span_id": "s064"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 3413,
          "end": 3421,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 3463,
      "end": 3486,
      "text": "حدثني محمد بن سعد، قال:",
      "markers": []
    },
    {
      "id": "s066",
      "start": 3486,
      "end": 3514,
      "text": " ثنى أبي، قال: ثنى عمي، قال:",
      "markers": []
    },
    {
      "id": "s067",
      "start": 3514,
      "end": 3552,
      "text": " ثنى أبي، عن أبيه، عن ابن عباس، ويقال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3524,
          "end": 3552,
          "stripped": "عن أبيه، عن ابن عباس، ويقال:",
          "span_id": "s067"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 3536,
          "end": 3544,
          "span_id": "s067"
        },
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 3547,
          "end": 3551,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 3552,
      "end": 3634,
      "text": " الأنفالُ ما أُخِذ مما سقط من المتاعِ بعدما تُقسم الغنائم، فهي نَفَلٌ لله ولرسوله.",
      "markers": []
    },
    {
      "id": "s069",
      "start": 3638,
      "end": 3673,
      "text": "حدثني القاسم، قال: ثنا الحسين، قال:",
      "markers": []
    },
    {
      "id": "s070",
      "start": 3673,
      "end": 3703,
      "text": " ثني حجاجٌ، قال: قال ابن جريج:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 3694,
          "end": 3702,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 3703,
      "end": 3799,
      "text": " أخبرني عثمان بن أبي سليمانَ، عن محمد بن شهاب، أن رجلا قال لابن عباس: ما الأنفالُ؟ قال: الفرسُ، ",
      "markers": []
    },
    {
      "id": "s072",
      "start": 3815,
      "end": 3816,
      "text": " ",
      "markers": []
    },
    {
      "id": "s073",
      "start": 3932,
      "end": 3933,
      "text": ".",
      "markers": []
    },
    {
      "id": "s074",
      "start": 3937,
      "end": 3976,
      "text": "حدثني الحارث، قال: ثنا عبد العزيز، قال:",
      "markers": []
    },
    {
      "id": "s075",
      "start": 3976,
      "end": 4005,
      "text": " ثنا عبد الوارث بن سعيد، قال:",
      "markers": []
    },
    {
      "id": "s076",
      "start": 4005,
      "end": 4032,
      "text": " قال ابن جُريجٍ: قال عطاءٌ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 4010,
          "end": 4019,
          "span_id": "s076"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 4026,
          "end": 4030,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 4032,
      "end": 4077,
      "text": " الأنفال: الفرسُ الشاذُّ، والدِّرعُ، والثوبُ.",
      "markers": []
    },
    {
      "id": "s078",
      "start": 4081,
      "end": 4114,
      "text": "حدثنا محمدُ بنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4081,
          "end": 4086,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 4114,
      "end": 4195,
      "text": " ثنا محمدُ بنُ ثورٍ، عن معمر، عن الزهريِّ، عن ابن عباس، قال: كان يُنفَّلُ الرجلُ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4135,
          "end": 4178,
          "stripped": "عن معمر، عن الزهري، عن ابن عباس، قال: كان",
          "span_id": "s079"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4160,
          "end": 4168,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 4216,
      "end": 4217,
      "text": " ",
      "markers": []
    },
    {
      "id": "s081",
      "start": 4320,
      "end": 4321,
      "text": ".",
      "markers": []
    },
    {
      "id": "s082",
      "start": 4325,
      "end": 4362,
      "text": "حدثني يونس، قال: أخبرنا ابن وهب، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4342,
          "end": 4348,
          "span_id": "s082"
        }
      ]
    },
    {
      "id": "s083",
      "start": 4362,
      "end": 4421,
      "text": " أخبرني مالك بن أنس، عن ابن شهابٍ، عن القاسم بن محمدٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4383,
          "end": 4421,
          "stripped": "عن ابن شهاب، عن القاسم بن محمد، قال:",
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 4421,
      "end": 4472,
      "text": " سمعت رجلا سأل ابن عباس عن الأنفالِ، فقال ابن عباس:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4463,
          "end": 4471,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 4472,
      "end": 4515,
      "text": " الفرسُ من النَّفَل، والسَّلَبُ من النفَلِ.",
      "markers": []
    },
    {
      "id": "s086",
      "start": 4515,
      "end": 4571,
      "text": " ثم عاد لمسألته، فقال ابن عباس ذلك أيضًا، ثم قال الرجلُ:",
      "markers": []
    },
    {
      "id": "s087",
      "start": 4571,
      "end": 4610,
      "text": " الأنفالُ التي قال الله في كتابه ما هي؟",
      "markers": []
    },
    {
      "id": "s088",
      "start": 4610,
      "end": 4655,
      "text": " قال القاسم: فلم يزل يسأله حتى كاد يُخْرِجُه ",
      "markers": []
    },
    {
      "id": "s089",
      "start": 4704,
      "end": 4742,
      "text": "، فقال ابن عباس: أتدرون ما مَثَلُ هذا؟",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4711,
          "end": 4719,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 4746,
      "end": 4799,
      "text": "مَثَلُ صَبِيغٍ الذي ضرَبه عمر بن الخطاب رضي الله عنه ",
      "markers": []
    },
    {
      "id": "s091",
      "start": 5156,
      "end": 5157,
      "text": ".",
      "markers": []
    },
    {
      "id": "s092",
      "start": 5161,
      "end": 5187,
      "text": "حدثنا الحسنُ بن يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5161,
          "end": 5166,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 5187,
      "end": 5262,
      "text": " أخبرنا عبد الرزَّاقِ، قال: أخبرنا معمر، عن الزهرى، عن القاسم بن محمد، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 5188,
          "end": 5194,
          "span_id": "s093"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 5188,
          "end": 5238,
          "stripped": "أخبرنا عبد الرزاق، قال: أخبرنا معمر، عن الزهرى،",
          "span_id": "s093"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 5215,
          "end": 5221,
          "span_id": "s093"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5228,
          "end": 5262,
          "stripped": "عن الزهرى، عن القاسم بن محمد، قال:",
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 5262,
      "end": 5319,
      "text": " قال ابن عباس: كان عمر رضي الله عنه إذا سُئل عن شيءٍ قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5267,
          "end": 5275,
          "span_id": "s094"
        }
      ]
    },
    {
      "id": "s095",
      "start": 5319,
      "end": 5357,
      "text": " لا آمرُك ولا أنهاكَ. ثم قال ابن عباس:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5348,
          "end": 5356,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 5357,
      "end": 5430,
      "text": " واللَّهِ ما بَعَثَ اللَّهُ نبيَّه عليه السلام إلا زاجرًا أمرًا مُحِلًّا ",
      "markers": []
    },
    {
      "id": "s097",
      "start": 5446,
      "end": 5528,
      "text": " محرِّمًا. قال القاسم: فسُلِّط على ابن عباس رجلٌ يسأله عن الأنفال، فقال ابن عباسٍ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5518,
          "end": 5526,
          "span_id": "s097"
        }
      ]
    },
    {
      "id": "s098",
      "start": 5528,
      "end": 5648,
      "text": " كان الرجلُ يُنَفَّلُ فرسَ الرجل وسلاحَه، فأعادَ عليه الرجلُ، فقال له مثل ذلك، ثم أعادَ عليه حتى أغْضَبه، فقال ابن عباس:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5639,
          "end": 5647,
          "span_id": "s098"
        }
      ]
    },
    {
      "id": "s099",
      "start": 5648,
      "end": 5743,
      "text": " أتدرون ما مَثَلُ هذا؟ مَثَلُ صَبِيغٍ الذي ضرَبه عمر حتى سالت الدماء على عِقبيْه، أو على رجليه.",
      "markers": []
    },
    {
      "id": "s100",
      "start": 5743,
      "end": 5793,
      "text": " فقال الرجلُ: أمّا أنت فقد انتقم اللَّهُ لعمر منك ",
      "markers": []
    },
    {
      "id": "s101",
      "start": 5871,
      "end": 5872,
      "text": ".",
      "markers": []
    },
    {
      "id": "s102",
      "start": 5876,
      "end": 5902,
      "text": "حدثنا أحمد بن إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5876,
          "end": 5881,
          "span_id": "s102"
        }
      ]
    },
    {
      "id": "s103",
      "start": 5902,
      "end": 5962,
      "text": " ثنا أبو أحمد، قال: ثنا ابن المباركِ، عن عبد الملك، عن عطاء:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5940,
          "end": 5962,
          "stripped": "عن عبد الملك، عن عطاء:",
          "span_id": "s103"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 5957,
          "end": 5961,
          "span_id": "s103"
        }
      ]
    },
    {
      "id": "s104",
      "start": 5962,
      "end": 6077,
      "text": " {يَسْأَلُونَكَ عَنِ الْأَنفَالِ}. قال: يسألونك فيما شذَّ من المشركين إلى المسلمين في غير قتال، من دابَّةٍ أو عبدٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5963,
          "end": 5995,
          "span_id": "s104"
        }
      ]
    },
    {
      "id": "s105",
      "start": 6117,
      "end": 6158,
      "text": "، فهو نفَلٌ للنبي - صلى الله عليه وسلم - ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6137,
          "end": 6155,
          "span_id": "s105"
        }
      ]
    },
    {
      "id": "s106",
      "start": 6224,
      "end": 6225,
      "text": ".",
      "markers": []
    },
    {
      "id": "s107",
      "start": 6229,
      "end": 6289,
      "text": "وقال آخرون: النفَلُ: الخُمُسُ الذي جعله الله لأهلِ الخُمُسِ.",
      "markers": []
    },
    {
      "id": "s108",
      "start": 6293,
      "end": 6310,
      "text": "ذِكرُ مَن قال ذلك",
      "markers": []
    }
  ],

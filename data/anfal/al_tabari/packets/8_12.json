    {
      "id": "s040",
      "start": 2405,
      "end": 2454,
      "text": " {فَاضْرِبُوا فَوْقَ الْأَعْنَاقِ}. قال: الرءوسَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2406,
          "end": 2439,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 2511,
      "end": 2512,
      "text": ".",
      "markers": []
    },
    {
      "id": "s042",
      "start": 2516,
      "end": 2566,
      "text": "واعتلَّ قائلو هذه المقالةِ بأن الذى فوقَ الأعناقِ ",
      "markers": []
    },
    {
      "id": "s043",
      "start": 2619,
      "end": 2620,
      "text": " ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 2645,
      "end": 2677,
      "text": ". فيكونَ معناه: الأعناقَ. قالوا:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 2654,
          "end": 2659,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 2677,
      "end": 2705,
      "text": " ولو جازَ ذلك كان أن يُقالَ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 2698,
          "end": 2703,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 2705,
      "end": 2742,
      "text": " تحتَ الأعناقِ. فيكون معناه: الأعناق.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 2727,
          "end": 2732,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 2742,
      "end": 2802,
      "text": " قالوا: وذلك خلافُ المعقولِ من الخطابِ، وقلبُ معانى الكلامِ.",
      "markers": []
    },
    {
      "id": "s048",
      "start": 2806,
      "end": 2850,
      "text": "وقال آخرون: معنى ذلك: فاضرِبوا على الأعناقِ.",
      "markers": []
    },
    {
      "id": "s049",
      "start": 2850,
      "end": 2932,
      "text": " وقالوا: \"على\" و \"فوقَ\" معناهما مُتقارِبان، فجاز أن يُوضَعَ أحدُهُما مكانَ الآخرِ.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 2874,
          "end": 2879,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 2936,
      "end": 2972,
      "text": "والصوابُ من القولِ فى ذلك أن يُقالَ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 2965,
          "end": 2970,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 2972,
      "end": 3094,
      "text": " إن اللهَ أمَر المؤمنينَ مُعلِّمَهم كيفيةَ قتلِ المشركين وضرِبهم بالسيفِ، أن يضرِبوا فوقَ الأعناقِ منهم والأيديَ والأرجلَ.",
      "markers": []
    },
    {
      "id": "s052",
      "start": 3094,
      "end": 3194,
      "text": " وقولُه: {فَوْقَ الْأَعْنَاقِ}. مُحتملٌ أن يكونَ مرادًا به الرءوسُ، ومحتملٌ أن يكونَ مرادًا به: مِن ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3103,
          "end": 3124,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 3216,
      "end": 3251,
      "text": " فوقِ جلدةِ الأعناقِ، فيكونَ معناه:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 3245,
          "end": 3250,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 3251,
      "end": 3299,
      "text": " على الأعناقِ، وإذا احتَمل ذلك صحَّ قولُ من قال:",
      "markers": []
    },
    {
      "id": "s055",
      "start": 3299,
      "end": 3490,
      "text": " معناه: الأعناقُ. وإذا كان الأمرُ محتمِلًا ما ذكرنا من التأويلِ، لم يكنْ لنا أن نوجِّهَه إلى بعضِ معانيه دونَ بعضٍ، إلا بحجةٍ يجبُ التسليمُ لها، ولا حجةَ تدلُّ على خصوصِه، فالواجبُ أن يُقالَ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 3300,
          "end": 3305,
          "span_id": "s055"
        },
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 3483,
          "end": 3488,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 3490,
      "end": 3626,
      "text": " إن اللهَ أمر بضربِ رءوسِ المشركينِ وأعناقِهم وأيدِيهم وأرجلِهم، أصحابَ نبيِّه -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- الذين شهِدوا معه بدرًا.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3570,
          "end": 3600,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 3630,
      "end": 3679,
      "text": "وأما قولُه: {وَاضْرِبُوا مِنْهُمْ كُلَّ بَنَانٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3642,
          "end": 3678,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 3679,
      "end": 3776,
      "text": " فإن معناه: واضرِبوا، أيها المؤمنون، من عدوِّكم كلَّ طَرَفٍ ومَفْصِلٍ من أطرافِ أيدِيهم وأرجلِهم.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 3684,
          "end": 3689,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 3780,
      "end": 3864,
      "text": "والبنانُ: جمعُ بنَانَةٍ، وهى أطرافُ أصابعِ اليدَيْن والرجليْن، ومن ذلك قولُ الشاعرِ ",
      "markers": []
    },
    {
      "id": "s060",
      "start": 3930,
      "end": 3931,
      "text": ":",
      "markers": []
    },
    {
      "id": "s061",
      "start": 3935,
      "end": 3962,
      "text": "ألا ليْتنِي قطَّعْتُ منِّى ",
      "markers": []
    },
    {
      "id": "s062",
      "start": 4018,
      "end": 4067,
      "text": " بنانةً ... ولاقيْتُهُ في البَيْتِ يقْظانَ حاذِرا",
      "markers": []
    },
    {
      "id": "s063",
      "start": 4071,
      "end": 4102,
      "text": "يعنى بالبنانةِ: واحدةَ البنانِ.",
      "markers": []
    },
    {
      "id": "s064",
      "start": 4106,
      "end": 4147,
      "text": "وبنحوِ الذي قلنا في ذلك قال أهلُ التأويلِ",
      "markers": []
    },
    {
      "id": "s065",
      "start": 4151,
      "end": 4168,
      "text": "ذِكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4172,
      "end": 4233,
      "text": "حدَّثنا أبو السائبِ، قال: ثنا ابنُ إدريسَ، عن أبيه، عن عطيةَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4172,
          "end": 4179,
          "span_id": "s066"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4215,
          "end": 4233,
          "stripped": "عن أبيه، عن عطية:",
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 4233,
      "end": 4291,
      "text": " {وَاضْرِبُوا مِنْهُمْ كُلَّ بَنَانٍ}. قال: كلَّ مَفْصِلٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4234,
          "end": 4270,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 4351,
      "end": 4352,
      "text": ".",
      "markers": []
    },
    {
      "id": "s069",
      "start": 4356,
      "end": 4416,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا ابنُ إدريسَ، عن أبيه، عن عطيةَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4356,
          "end": 4363,
          "span_id": "s069"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4398,
          "end": 4416,
          "stripped": "عن أبيه، عن عطية:",
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 4416,
      "end": 4470,
      "text": " {وَاضْرِبُوا مِنْهُمْ كُلَّ بَنَانٍ}. قال: المفاصِلَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4417,
          "end": 4453,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 4543,
      "end": 4544,
      "text": ".",
      "markers": []
    },
    {
      "id": "s072",
      "start": 4548,
      "end": 4591,
      "text": "قال: ثنا المحاربيُّ، عن جويبرٍ، عن الضحاكِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4569,
          "end": 4591,
          "stripped": "عن جويبر، عن الضحاك:",
          "span_id": "s072"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 4583,
          "end": 4589,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 4591,
      "end": 4648,
      "text": " {وَاضْرِبُوا مِنْهُمْ كُلَّ بَنَانٍ}. قال: كلَّ مَفْصلٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4592,
          "end": 4628,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 4650,
      "end": 4651,
      "text": ".",
      "markers": []
    },
    {
      "id": "s075",
      "start": 4655,
      "end": 4704,
      "text": "حدَّثنا ابنُ حميدٍ، قال: ثنا يحيى بنُ واضحٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4655,
          "end": 4662,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 4704,
      "end": 4737,
      "text": " ثنا الحسنُ، عن يزيدَ، عن عكرمةَ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4717,
          "end": 4737,
          "stripped": "عن يزيد، عن عكرمة:",
          "span_id": "s076"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 4730,
          "end": 4735,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 4737,
      "end": 4812,
      "text": " {وَاضْرِبُوا مِنْهُمْ كُلَّ بَنَانٍ}. قال: الأطرافَ. ويقالُ: كلَّ مَفصِلٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4738,
          "end": 4774,
          "span_id": "s077"
        },
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 4792,
          "end": 4796,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 4814,
      "end": 4815,
      "text": ".",
      "markers": []
    },
    {
      "id": "s079",
      "start": 4819,
      "end": 4859,
      "text": "حدَّثني المثنى، قال: ثنا أبو صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s080",
      "start": 4859,
      "end": 4897,
      "text": " ثني معاويةُ، عن عليٍّ، عن ابنِ عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4873,
          "end": 4897,
          "stripped": "عن علي، عن ابن عباس:",
          "span_id": "s080"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 4876,
          "end": 4879,
          "span_id": "s080"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4886,
          "end": 4895,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 4897,
      "end": 4959,
      "text": " {وَاضْرِبُوا مِنْهُمْ كُلَّ بَنَانٍ}. يعنى بالبنانِ الأطرافَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4898,
          "end": 4934,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 5018,
      "end": 5019,
      "text": ".",
      "markers": []
    },
    {
      "id": "s083",
      "start": 5023,
      "end": 5062,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5023,
          "end": 5030,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 5062,
      "end": 5095,
      "text": " ثني حجاجٌ، عن ابنِ جُريجٍ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 5077,
          "end": 5087,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 5095,
      "end": 5148,
      "text": " {وَاضْرِبُوا مِنْهُمْ كُلَّ بَنَانٍ}. قال: الأطرافَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5096,
          "end": 5132,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 5179,
      "end": 5180,
      "text": ".",
      "markers": []
    },
    {
      "id": "s087",
      "start": 5184,
      "end": 5220,
      "text": "حُدِّثتُ عن الحسينِ بنِ الفرجِ، قال:",
      "markers": []
    },
    {
      "id": "s088",
      "start": 5220,
      "end": 5272,
      "text": " سمِعتُ أبا معاذٍ، قال: ثنا عُبيدُ بنُ سليمانَ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 5232,
          "end": 5236,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 5272,
      "end": 5302,
      "text": " سمِعتُ الضحاكَ يقولُ في قوله:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 5280,
          "end": 5286,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 5302,
      "end": 5355,
      "text": " {وَاضْرِبُوا مِنْهُمْ كُلَّ بَنَانٍ}. يعنى الأطرافَ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5303,
          "end": 5339,
          "span_id": "s090"
        }
      ]
    }
  ],
  "editor_footnote_evidence": [
    {

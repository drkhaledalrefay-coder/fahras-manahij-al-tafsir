          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 1855,
      "end": 1914,
      "text": " {فَاضْرِبُوا فَوْقَ الْأَعْنَاقِ}. يقولُ: اضرِبوا الرقابَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1856,
          "end": 1889,

  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 75,
      "text": "وأما قولُه: {إِذْ يُوحِي رَبُّكَ إِلَى الْمَلَائِكَةِ أَنِّي مَعَكُمْ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 16,
          "end": 74,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 75,
      "end": 126,
      "text": " أَنصرُكُم، {فَثَبِّتُوا الَّذِينَ آمَنُوا}. يقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 87,
          "end": 118,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 126,
      "end": 191,
      "text": " قَوُّوا عزمَهم، وصحِّحُوا نيّاتِهم في قتالِ عدوِّهم من المشركين.",
      "markers": []
    },
    {
      "id": "s004",
      "start": 195,
      "end": 260,
      "text": "وقد قيلَ: إنَّ تثبيتَ الملائكةِ المؤمنين كان حضورَهم حربَهم معهم.",
      "markers": []
    },
    {
      "id": "s005",
      "start": 260,
      "end": 308,
      "text": " وقيل: كان ذلك معونتَهم إيَّاهم بقتالِ أعدائِهم.",
      "markers": []
    },
    {
      "id": "s006",
      "start": 308,
      "end": 406,
      "text": " وقيل: كان ذلك بأن الملَكَ يأتى الرجلَ من أصحابِ النبيِّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- ويقولُ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 366,
          "end": 396,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 406,
      "end": 451,
      "text": " سمِعتُ هؤلاءِ القومَ -يعنى المشركين- يقولون:",
      "markers": []
    },
    {
      "id": "s008",
      "start": 451,
      "end": 491,
      "text": " واللهِ لئن حمَلُوا عليْنا لنَنْكشِفنَّ.",
      "markers": []
    },
    {
      "id": "s009",
      "start": 491,
      "end": 545,
      "text": " فيحدِّثُ المسلمون بعضُهم بعضًا بذلك، فتقوَى أنفُسُهم.",
      "markers": []
    },
    {
      "id": "s010",
      "start": 545,
      "end": 585,
      "text": " قالوا: وذلك كان وحيَ الله إلى ملائكتِه.",
      "markers": []
    },
    {
      "id": "s011",
      "start": 589,
      "end": 645,
      "text": "وأما ابنُ إسحاقَ، فإنه قال بما حدَّثنا ابنُ حُميدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 620,
          "end": 627,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 645,
      "end": 672,
      "text": " ثنا سلمةُ، عن ابنِ إسحاقَ:",
      "markers": []
    },
    {
      "id": "s013",
      "start": 672,
      "end": 730,
      "text": " {فَثَبِّتُوا الَّذِينَ آمَنُوا}. أى فآزِرُوا الذين آمنوا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 673,
          "end": 704,
          "span_id": "s013"
        }
      ]
    },
    {
      "id": "s014",
      "start": 871,
      "end": 872,
      "text": ".",
      "markers": []
    },
    {
      "id": "s015",
      "start": 876,
      "end": 1020,
      "text": "القولُ في تأويلِ قولِه: {سَأُلْقِي فِي قُلُوبِ الَّذِينَ كَفَرُوا الرُّعْبَ فَاضْرِبُوا فَوْقَ الْأَعْنَاقِ وَاضْرِبُوا مِنْهُمْ كُلَّ بَنَانٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 900,
          "end": 1019,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1024,
      "end": 1165,
      "text": "يقولُ تعالى ذكرُه: سأُرعِبُ قلوبَ الذين كفروا بي، أيها المؤمنون، منكم، وأملؤُها فَرَقًا حتى ينهزِموا عنكم، {فَاضْرِبُوا فَوْقَ الْأَعْنَاقِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1131,
          "end": 1164,
          "span_id": "s016"
        }
      ]
    },
    {
      "id": "s017",
      "start": 1169,
      "end": 1207,
      "text": "واختلفَ أهلُ التأويلِ في تأويلِ قولِه:",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1207,
      "end": 1268,
      "text": " {فَوْقَ الْأَعْنَاقِ}؛ فقال بعضُهم: معناه: فاضربوا الأعناقَ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1208,
          "end": 1229,
          "span_id": "s018"
        },
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 1244,
          "end": 1249,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 1272,
      "end": 1288,
      "text": "ذِكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s020",
      "start": 1292,
      "end": 1352,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا ابنُ إدريسَ، عن أبيه، عن عطيةَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1292,
          "end": 1299,
          "span_id": "s020"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1334,
          "end": 1352,
          "stripped": "عن أبيه، عن عطية:",
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 1352,
      "end": 1410,
      "text": " {فَاضْرِبُوا فَوْقَ الْأَعْنَاقِ}. قال: اضربِوا الأعناقَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1353,
          "end": 1386,
          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 1463,
      "end": 1464,
      "text": ".",
      "markers": []
    },
    {
      "id": "s023",
      "start": 1468,
      "end": 1514,
      "text": "قال: ثنا أبي، عن المسعودِيِّ، عن القاسمِ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1482,
          "end": 1514,
          "stripped": "عن المسعودي، عن القاسم، قال:",
          "span_id": "s023"
        }
      ]
    },
    {
      "id": "s024",
      "start": 1514,
      "end": 1565,
      "text": " قال رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 1515,
          "end": 1529,
          "span_id": "s024"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1532,
          "end": 1562,
          "span_id": "s024"
        }
      ]
    },
    {
      "id": "s025",
      "start": 1565,
      "end": 1668,
      "text": " \"إِنِّى لمْ أُبْعَثْ لأُعَذِّبَ بعذابِ اللهِ، إِنَّمَا بُعِثْتُ لِضَرْبِ الأَعْناقِ، وشدِّ الوَثَاقِ\" ",
      "markers": []
    },
    {
      "id": "s026",
      "start": 1731,
      "end": 1732,
      "text": ".",
      "markers": []
    },
    {
      "id": "s027",
      "start": 1736,
      "end": 1772,
      "text": "حُدِّثتُ عن الحسينِ بنِ الفرجِ، قال:",
      "markers": []
    },
    {
      "id": "s028",
      "start": 1772,
      "end": 1824,
      "text": " سمِعتُ أبا معاذٍ، قال: ثنا عُبيدُ بنُ سليمانَ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",

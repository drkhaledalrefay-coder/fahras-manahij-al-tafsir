    },
    {
      "id": "s029",
      "start": 1824,
      "end": 1855,
      "text": " سمِعتُ الضحاكَ يقولُ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",

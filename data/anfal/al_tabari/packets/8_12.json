      "text": ".",
      "markers": []
    },
    {
      "id": "s032",
      "start": 2030,
      "end": 2074,
      "text": "واحتجَّ قائلو هذه المقالةِ بأن العربَ تقولُ:",
      "markers": []
    },
    {
      "id": "s033",
      "start": 2074,
      "end": 2121,
      "text": " رأيتُ نفْسَ فلانٍ. بمعنى رأيتُه، قالوا: فكذلك ",
      "markers": []
    },
    {
      "id": "s034",
      "start": 2147,
      "end": 2219,
      "text": " قولُه: {فَاضْرِبُوا فَوْقَ الْأَعْنَاقِ}. إنما معناه: فاضربوا الأعناقَ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",

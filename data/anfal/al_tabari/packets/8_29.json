  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 39,
      "text": "القولُ في تأويلِ قولِه جلَّ ثناؤُه:",
      "markers": []
    },
    {
      "id": "s002",
      "start": 39,
      "end": 216,
      "text": " {يَاأَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا وَيُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ (29)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 40,
          "end": 215,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 220,
      "end": 412,
      "text": "يقولُ تعالى ذكرُه: يأيُّها الذين صدَّقوا اللهَ ورسولَه، إن تَتَّقوا اللهَ بطاعتِه وأداءِ فرائضِه، واجتنابِ معاصيه، وتركِ خيانتِه وخيانةِ رسولِه وخيانةِ أماناتِكم، {يَجْعَلْ لَكُمْ فُرْقَانًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 383,
          "end": 411,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 412,
      "end": 517,
      "text": " يقولُ: يجعَلْ لكم فَصْلًا وفَرْقًا بين حقِّكم وباطلِ من يَبْغِيكم السوءَ من أعدائِكم المشركين، بنُصرتِه ",
      "markers": []
    },
    {
      "id": "s005",
      "start": 533,
      "end": 612,
      "text": " إيَّاكم عليهم، وإعطائِكم الظُّفَرَ بهم، {وَيُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 574,
          "end": 611,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 612,
      "end": 683,
      "text": " يقولُ: ويمحو عنكم ما سلَف من ذنوبِكم بينكم وبينه، {وَيَغْفِرْ لَكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 663,
          "end": 682,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 683,
      "end": 772,
      "text": " يقولُ: ويغطِّيها فيسترُها عليكم، فلا يؤاخذُكم بها، {وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 735,
          "end": 771,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 772,
      "end": 907,
      "text": " يقولُ: واللهُ الذى يفعلُ ذلك بكم، له الفضلُ العظيمُ عليكم وعلى غيرِكم من خلقِه بفعلِه ذلك وفعلِ أمثالِه، وإنَّ فعلَه جزاءٌ منه لعبدِه ",
      "markers": []
    },
    {
      "id": "s009",
      "start": 937,
      "end": 1047,
      "text": " على طاعتِه إيَّاه؛ لأنه الموفِّقُ عبدَه لطاعتِه التي اكتسَبها، حتى استحقَّ من ربِّه الجزاءَ الذي وعَده عليها.",
      "markers": []
    },
    {
      "id": "s010",
      "start": 1051,
      "end": 1105,
      "text": "وقد اخْتَلف أهلُ التأويلِ فى العبارةِ عن تأويلِ قولهِ:",
      "markers": []
    },
    {
      "id": "s011",
      "start": 1105,
      "end": 1156,
      "text": " {يَجْعَلْ لَكُمْ فُرْقَانًا}؛ فقال بعضُهم: مخرجًا.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1106,
          "end": 1134,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 1160,
      "end": 1179,
      "text": "وقال بعضُهم: نجاةً.",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1183,
      "end": 1204,
      "text": "وقال بعضُهم: فَصْلًا ",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1236,
      "end": 1237,
      "text": ".",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1241,
      "end": 1352,
      "text": "وكلُّ ذلك متقاربُ المعنى وإن اخْتَلفت العباراتُ عنها، وقد بيَّنت صحةَ ذلك فيما مضَى قبلُ بما أَغْنى عن إعادتِه ",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1380,
      "end": 1381,
      "text": ".",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1385,
      "end": 1411,
      "text": "ذكرُ من قال: معناه المخرجُ",
      "markers": [
        {
          "family": "LUGHA",

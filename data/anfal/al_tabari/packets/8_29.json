          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 2164,
          "end": 2169,
          "span_id": "s030"
        }
      ]
    },
    {
      "id": "s031",
      "start": 2181,
      "end": 2258,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا هانئُ بنُ سعيدٍ، عن حجَّاجٍ، عن ابنِ أبي نَجيحٍ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2181,
          "end": 2188,
          "span_id": "s031"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2227,
          "end": 2258,
          "stripped": "عن حجاج، عن ابن أبي نجيح.",
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2258,
      "end": 2306,
      "text": " عن مجاهدٍ: {فُرْقَانًا}. قال: الفرقانُ المخرجُ.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 2262,
          "end": 2267,
          "span_id": "s032"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2270,
          "end": 2282,
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 2310,
      "end": 2350,
      "text": "حدَّثني المثنى، قال: ثنا أبو صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s034",
      "start": 2350,
      "end": 2423,
      "text": " ثني معاويةُ، عن علىٍّ، عن ابنِ عباسٍ قولَه: {فُرْقَانًا}. يقولُ: مخرجًا ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2364,
          "end": 2408,
          "stripped": "عن على، عن ابن عباس قوله: {فرقانا}.",
          "span_id": "s034"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 2377,
          "end": 2386,
          "span_id": "s034"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2395,
          "end": 2407,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2482,
      "end": 2483,
      "text": ".",
      "markers": []
    },
    {
      "id": "s036",
      "start": 2487,
      "end": 2516,
      "text": "حدَّثنا الحسنُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2487,
          "end": 2494,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 2516,
      "end": 2603,
      "text": " أخبرنا عبدُ الرزاقِ، قال: أخبرنا الثوريُّ، عن منصورٍ، عن مجاهدٍ: {فُرْقَانًا}: مخرجًا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2517,
          "end": 2523,
          "span_id": "s037"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 2517,
          "end": 2570,
          "stripped": "أخبرنا عبد الرزاق، قال: أخبرنا الثوري، عن منصور،",
          "span_id": "s037"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2543,
          "end": 2549,
          "span_id": "s037"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2560,
          "end": 2602,
          "stripped": "عن منصور، عن مجاهد: {فرقانا}: مخرجا",
          "span_id": "s037"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 2574,
          "end": 2579,
          "span_id": "s037"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2582,
          "end": 2594,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 2649,
      "end": 2650,
      "text": ".",
      "markers": []
    },
    {
      "id": "s039",
      "start": 2654,
      "end": 2714,
      "text": "حدَّثني المثنى، قال: ثنا عبدُ اللهِ بنُ رجاءٍ البصرىُّ، قال:",
      "markers": []
    },
    {
      "id": "s040",
      "start": 2714,
      "end": 2754,
      "text": " ثنا زائدةُ، عن منصورٍ، عن مجاهدٍ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2727,
          "end": 2754,
          "stripped": "عن منصور، عن مجاهد مثله.",
          "span_id": "s040"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 2741,
          "end": 2746,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 2758,
      "end": 2852,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا المُحاربيُّ، عن جُوَيبرٍ، عن الضحَّاك: {فُرْقَانًا}. قال: مخرجًا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2758,
          "end": 2765,
          "span_id": "s041"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2800,
          "end": 2851,
          "stripped": "عن جويبر، عن الضحاك: {فرقانا}. قال: مخرجا",
          "span_id": "s041"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 2816,
          "end": 2824,
          "span_id": "s041"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2826,
          "end": 2838,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 2897,
      "end": 2898,
      "text": ".",
      "markers": []
    },
    {
      "id": "s043",
      "start": 2902,
      "end": 2937,
      "text": "حُدِّثت عن الحسينِ بنِ الفرجِ، قال:",
      "markers": []
    },
    {
      "id": "s044",
      "start": 2937,
      "end": 2980,
      "text": " سمِعتُ أبا معاذٍ قال: سمِعت عُبيدًا يقولُ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 2949,
          "end": 2953,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 2980,
      "end": 3025,
      "text": " سمِعتُ الضحَّاك يقولُ: {فُرْقَانًا}: مخرجًا.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 2988,
          "end": 2996,
          "span_id": "s045"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3004,
          "end": 3016,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3029,
      "end": 3059,
      "text": "حدَّثنا أحمدُ بنُ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3029,
          "end": 3036,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3059,
      "end": 3119,
      "text": " ثنا أبو أحمدَ، قال: ثنا سفيانُ، عن منصورٍ، عن مجاهدٍ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3092,
          "end": 3119,
          "stripped": "عن منصور، عن مجاهد مثله.",
          "span_id": "s047"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 3106,
          "end": 3111,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3123,
      "end": 3214,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا حُميدٌ، عن زُهيرٍ، عن جابرٍ، عن عكرمةَ، قال: الفرقانُ المخرجُ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3123,
          "end": 3130,
          "span_id": "s048"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3160,
          "end": 3212,
          "stripped": "عن زهير، عن جابر، عن عكرمة، قال: الفرقان المخرج",
          "span_id": "s048"
        },
        {
          "family": "SAHABA",
          "marker": "جابر",
          "name": "جابر",
          "role": "NARRATOR",
          "start": 3174,
          "end": 3178,
          "span_id": "s048"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 3184,
          "end": 3189,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3259,
      "end": 3260,
      "text": ".",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3264,
      "end": 3290,
      "text": "ذكرُ من قال: معناه النجاةُ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 3277,
          "end": 3282,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3294,
      "end": 3365,
      "text": "حدَّثنا ابنُ حميدٍ، قال: ثنا حكَّامٌ، عن عَنْبسةَ، عن جابرٍ، عن عكرمةَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3294,
          "end": 3301,
          "span_id": "s051"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3332,
          "end": 3365,
          "stripped": "عن عنبسة، عن جابر، عن عكرمة:",
          "span_id": "s051"
        },
        {
          "family": "SAHABA",
          "marker": "جابر",
          "name": "جابر",
          "role": "NARRATOR",
          "start": 3348,
          "end": 3352,
          "span_id": "s051"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 3358,
          "end": 3363,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 3365,
      "end": 3430,
      "text": " {إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا}. قال: نجاةً ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3366,
          "end": 3417,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 3479,
      "end": 3480,
      "text": ".",
      "markers": []
    },
    {
      "id": "s054",
      "start": 3484,
      "end": 3528,
      "text": "حدَّثني الحارثُ، قال: ثنا عبدُ العزيزِ، قال:",
      "markers": []
    },
    {
      "id": "s055",
      "start": 3528,
      "end": 3579,
      "text": " ثنا إسرائيلُ، عن رجلٍ، عن عكرمةَ ومجاهدٍ فى قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3543,
          "end": 3579,
          "stripped": "عن رجل، عن عكرمة ومجاهد فى قوله:",
          "span_id": "s055"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 3555,
          "end": 3560,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 3579,
      "end": 3652,
      "text": " {يَجْعَلْ لَكُمْ فُرْقَانًا}. قال عكرمةُ: المخرجُ. وقال مجاهدٌ: النجاةُ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3580,
          "end": 3608,
          "span_id": "s056"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 3614,
          "end": 3619,
          "span_id": "s056"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3636,
          "end": 3641,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 3656,
      "end": 3687,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s058",
      "start": 3687,
      "end": 3715,
      "text": " ثنا أحمدُ بنُ مفضَّلٍ، قال:",
      "markers": []
    },
    {
      "id": "s059",
      "start": 3715,
      "end": 3785,
      "text": " ثنا أسباطُ، عن السُّدِّىِّ: {يَجْعَلْ لَكُمْ فُرْقَانًا}. قال: نجاةً ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3744,
          "end": 3772,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 3841,
      "end": 3842,
      "text": ".",
      "markers": []
    },
    {
      "id": "s061",
      "start": 3846,
      "end": 3874,
      "text": "حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s062",
      "start": 3874,
      "end": 3902,
      "text": " ثني أبي، قال: ثني عمي، قال:",
      "markers": []
    },
    {
      "id": "s063",
      "start": 3902,
      "end": 3935,
      "text": " ثني أبي، عن أبيه، عن ابنِ عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3912,
          "end": 3935,
          "stripped": "عن أبيه، عن ابن عباس:",
          "span_id": "s063"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 3924,
          "end": 3933,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 3935,
      "end": 3990,
      "text": " {يَجْعَلْ لَكُمْ فُرْقَانًا}. يقولُ: يجعَلْ لكم نجاةً ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3936,
          "end": 3964,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4088,
      "end": 4089,
      "text": ".",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4093,
      "end": 4127,
      "text": "حدَّثنا بشرٌ، قال: ثنا يزيدُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4093,
          "end": 4100,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 4127,
      "end": 4189,
      "text": " ثنا سعيدٌ، عن قتادةَ: {يَجْعَلْ لَكُمْ فُرْقَانًا} أي: نجاةً.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 4142,
          "end": 4147,
          "span_id": "s067"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4150,
          "end": 4178,
          "span_id": "s067"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 4179,
          "end": 4182,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 4193,
      "end": 4211,
      "text": "ذكرُ من قال: فصلًا",
      "markers": []
    },
    {
      "id": "s069",
      "start": 4215,
      "end": 4224,
      "text": ". . . . .",
      "markers": []
    },
    {
      "id": "s070",
      "start": 4224,
      "end": 4243,
      "text": " . . . . . . . . . ",
      "markers": []
    },
    {
      "id": "s071",
      "start": 4358,
      "end": 4411,
      "text": " {إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4359,
          "end": 4410,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 4415,
      "end": 4503,
      "text": "قال: فرقانًا يَفْرُقُ في قلوبِهم بين الحقِّ والباطلِ حتى يعرِفوه ويهتدُوا بذلك الفرقانِ.",
      "markers": []
    },
    {
      "id": "s073",
      "start": 4507,
      "end": 4560,
      "text": "حدَّثنا ابنُ حميدٍ، قال: ثنا سَلَمةُ، عن ابنِ إسحاقَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4507,
          "end": 4514,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 4560,
      "end": 4647,
      "text": " {يَاأَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا}، أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4561,
          "end": 4642,
          "span_id": "s074"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 4644,
          "end": 4647,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 4647,
      "end": 4704,

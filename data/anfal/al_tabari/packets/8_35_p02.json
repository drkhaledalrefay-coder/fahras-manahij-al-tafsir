        }
      ]
    },
    {
      "id": "s119",
      "start": 8012,
      "end": 8046,
      "text": "حدَّثنا بشرٌ، قال: ثنا يزيدُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8012,
          "end": 8019,
          "span_id": "s119"
        }
      ]
    },
    {
      "id": "s120",
      "start": 8046,
      "end": 8074,
      "text": " ثنا سعيدٌ، عن قتادةَ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 8061,
          "end": 8066,
          "span_id": "s120"
        }
      ]
    },
    {
      "id": "s121",
      "start": 8074,
      "end": 8146,
      "text": " {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8075,
          "end": 8145,
          "span_id": "s121"
        }
      ]
    },
    {
      "id": "s122",
      "start": 8146,
      "end": 8236,
      "text": " قال: كنا نُحَدَّثُ أن المكاءَ التصفيقُ بالأيدى، والتصديةَ صياحٌ كانوا يعارضون به القرآنَ.",
      "markers": []
    },
    {
      "id": "s123",
      "start": 8240,
      "end": 8275,
      "text": "حدَّثنا محمدُ بنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8240,
          "end": 8247,
          "span_id": "s123"
        }
      ]
    },
    {
      "id": "s124",
      "start": 8275,
      "end": 8316,
      "text": " ثنا محمدُ بنُ ثورٍ، عن معمرٍ، عن قتادةَ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 8296,
          "end": 8316,

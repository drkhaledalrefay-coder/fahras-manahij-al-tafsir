    {
      "id": "s110",
      "start": 7504,
      "end": 7542,
      "text": "حدَّثني المُثنى، قال: ثنا إسحاقُ، قال:",
      "markers": []
    },
    {
      "id": "s111",
      "start": 7542,
      "end": 7567,
      "text": " ثنا محمدُ بنُ حربٍ، قال:",
      "markers": []
    },
    {
      "id": "s112",
      "start": 7567,
      "end": 7650,
      "text": " ثنا ابنُ لَهِيعةَ، عن جعفرِ بنِ ربيعةَ، عن أبي سَلَمَةَ بنِ عبدِ الرحمنِ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7587,
          "end": 7631,
          "stripped": "عن جعفر بن ربيعة، عن أبي سلمة بن عبد",
          "span_id": "s112"
        }
      ]
    },
    {
      "id": "s113",
      "start": 7650,
      "end": 7709,
      "text": " {مُكَاءً وَتَصْدِيَةً}. قال: المكاءُ النفخُ، وأشار بكفِّه ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7651,
          "end": 7673,
          "span_id": "s113"
        }
      ]
    },
    {
      "id": "s114",
      "start": 7732,
      "end": 7763,
      "text": " قِبلَ فيه، والتصديةُ التصفيقُ ",
      "markers": []
    },
    {
      "id": "s115",
      "start": 7796,
      "end": 7797,
      "text": ".",
      "markers": []
    },
    {
      "id": "s116",
      "start": 7801,
      "end": 7911,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا المُحاربيُّ، عن جُويبرٍ، عن الضحَّاكِ، قال: المُكاءُ الصفيرُ، والتصديةُ التصفيقُ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7801,
          "end": 7808,
          "span_id": "s116"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7843,
          "end": 7891,
          "stripped": "عن جويبر، عن الضحاك، قال: المكاء الصفير،",
          "span_id": "s116"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",

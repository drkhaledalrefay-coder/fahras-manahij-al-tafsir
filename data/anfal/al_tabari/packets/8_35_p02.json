          "end": 7866,
          "span_id": "s116"
        }
      ]
    },
    {
      "id": "s117",
      "start": 7915,
      "end": 7961,
      "text": "حدَّثني المُثنى، قال: ثنا عمرُو بنُ عونٍ، قال:",
      "markers": []
    },
    {
      "id": "s118",
      "start": 7961,
      "end": 8008,
      "text": " أخبرنا هُشيمٌ، عن جُويبرٍ، عن الضحَّاكِ مثلَه.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 7962,
          "end": 7968,
          "span_id": "s118"
        },
        {

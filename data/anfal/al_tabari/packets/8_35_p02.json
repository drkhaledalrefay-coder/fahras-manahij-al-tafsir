        }
      ]
    },
    {
      "id": "s125",
      "start": 8316,
      "end": 8383,
      "text": " {مُكَاءً وَتَصْدِيَةً}. قال: المكاءُ التصفيرُ، والتصديةُ التصفيقُ ",
      "markers": [
        {

      "markers": []
    },
    {
      "id": "s127",
      "start": 8435,
      "end": 8466,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s128",
      "start": 8466,
      "end": 8496,
      "text": " ثنا أحمدُ بنُ المفضَّلِ، قال:",
      "markers": []
    },
    {
      "id": "s129",
      "start": 8496,
      "end": 8596,
      "text": " ثنا أسباطُ، عن السُّدِّىِّ: {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8525,
          "end": 8595,
          "span_id": "s129"
        }
      ]
    },
    {
      "id": "s130",
      "start": 8596,
      "end": 8644,
      "text": " والمكاءُ: الصفيرُ على نحوِ طيرٍ أبيضَ يقالُ له:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 8635,
          "end": 8639,
          "span_id": "s130"
        }
      ]
    },
    {
      "id": "s131",
      "start": 8644,
      "end": 8680,
      "text": " المَكَّاءُ، يكونُ بأرضِ الحجازِ، و ",
      "markers": []
    },
    {
      "id": "s132",
      "start": 8695,
      "end": 8715,
      "text": " التصديةُ: التصفيقُ ",
      "markers": []
    },
    {
      "id": "s133",
      "start": 8807,
      "end": 8808,
      "text": ".",
      "markers": []
    },
    {
      "id": "s134",
      "start": 8812,
      "end": 8854,
      "text": "حدَّثني يونسُ، قال: أخبرنا ابنُ وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 8832,
          "end": 8838,
          "span_id": "s134"
        }
      ]
    },
    {
      "id": "s135",
      "start": 8854,
      "end": 8878,
      "text": " قال ابنُ زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 8859,
          "end": 8867,
          "span_id": "s135"
        }
      ]
    },
    {
      "id": "s136",
      "start": 8878,
      "end": 8950,
      "text": " {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8879,
          "end": 8949,
          "span_id": "s136"
        }
      ]
    },
    {
      "id": "s137",
      "start": 8950,
      "end": 9005,
      "text": " قال: المكاءُ: صفيرٌ كان أهلُ الجاهليةِ يعلنون به، قال:",
      "markers": []
    },
    {
      "id": "s138",
      "start": 9005,
      "end": 9051,
      "text": " وقال فى المكاءِ أيضًا: صفيرٌ في أيديهم ولعبٌ ",
      "markers": []
    },
    {
      "id": "s139",
      "start": 9095,
      "end": 9096,
      "text": ".",
      "markers": []
    },
    {
      "id": "s140",
      "start": 9100,
      "end": 9155,
      "text": "وقد قيل في التصديةِ: إنها الصدُّ عن بيتِ اللهِ الحرامِ.",
      "markers": []
    },
    {
      "id": "s141",
      "start": 9155,
      "end": 9177,
      "text": " وذلك قولٌ لا وجهَ له؛",
      "markers": []
    },
    {
      "id": "s142",
      "start": 9177,
      "end": 9236,
      "text": " لأن التصديةَ مصدرٌ من قولِ القائلِ: صدَّيْتُ تصديةً. وأما ",
      "markers": []
    },
    {
      "id": "s143",
      "start": 9267,
      "end": 9317,
      "text": " الصَّدُّ فلا يقالُ منه: صدَّيْتُ، إنما يقالُ منه:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 9281,
          "end": 9285,
          "span_id": "s143"
        },
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 9307,
          "end": 9311,
          "span_id": "s143"
        }
      ]
    },
    {
      "id": "s144",
      "start": 9317,
      "end": 9379,
      "text": " صَدَدْتُ، فإن شدَّدت منها الدالَ على معنى تكريرِ الفعلِ، قيل:",
      "markers": []
    },
    {
      "id": "s145",
      "start": 9379,
      "end": 9496,
      "text": " صدَّدْتُ تصديةً، إلا أن يكونَ صاحبُ هذا القولِ وجَّه التصديةَ إلى أنه من صددتُ، ثم قلبت إحدى دالَيْه ياءً، كما يقال:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 9491,
          "end": 9495,
          "span_id": "s145"
        }
      ]
    },
    {
      "id": "s146",
      "start": 9496,
      "end": 9537,
      "text": " تظنَّيْتُ من ظَنَنْتُ، وكما قال الراجزُ ",
      "markers": []
    },
    {
      "id": "s147",
      "start": 9571,
      "end": 9572,
      "text": ":",
      "markers": []
    },
    {
      "id": "s148",
      "start": 9576,
      "end": 9610,
      "text": "تَقَضِّىَ البازي إذا البازى كَسَرْ",
      "markers": []
    },
    {
      "id": "s149",
      "start": 9614,
      "end": 9659,
      "text": "يعني: تقضُّضَ البازى، فقلَب إحدى ضادَيه ياءً.",
      "markers": []
    },
    {
      "id": "s150",
      "start": 9659,
      "end": 9691,
      "text": " فيكونُ ذلك وجهًا يُوجَّهُ إليه.",
      "markers": []
    },
    {
      "id": "s151",
      "start": 9695,
      "end": 9736,
      "text": "ذكرُ مَن قال ما ذكَرنا في تأويلِ التصديةِ",
      "markers": []
    },
    {
      "id": "s152",
      "start": 9740,
      "end": 9770,
      "text": "حدَّثنا أحمدُ بنُ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9740,
          "end": 9747,
          "span_id": "s152"
        }
      ]
    },
    {
      "id": "s153",
      "start": 9770,
      "end": 9831,
      "text": " ثنا أبو أحمدَ، قال: ثنا طلحةُ بنُ عمرٍو، عن سعيدِ بنِ جبيرٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 9815,
          "end": 9829,
          "span_id": "s153"
        }
      ]
    },
    {
      "id": "s154",
      "start": 9831,
      "end": 9903,
      "text": " {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9832,
          "end": 9902,
          "span_id": "s154"
        }
      ]
    },
    {
      "id": "s155",
      "start": 9903,
      "end": 9933,
      "text": " صدُّهم عن بيتِ اللهِ الحرامِ.",
      "markers": []
    },
    {
      "id": "s156",
      "start": 9937,
      "end": 9973,
      "text": "حدَّثني المثنى، قال: ثنا إسحاقُ بنُ ",
      "markers": []
    },
    {
      "id": "s157",
      "start": 10006,
      "end": 10038,
      "text": " سليمانَ، قال: أخبرنا طلحةُ بنُ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 10021,
          "end": 10027,
          "span_id": "s157"
        }
      ]
    },
    {
      "id": "s158",
      "start": 10090,
      "end": 10117,
      "text": " عمرٍو، عن سعيدِ بنِ جبيرٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 10101,
          "end": 10115,
          "span_id": "s158"
        }
      ]
    },
    {
      "id": "s159",
      "start": 10117,
      "end": 10181,
      "text": " {وَتَصْدِيَةً}. قال: التصديةُ: صدُّهم الناسَ عن البيتِ الحرامِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10118,
          "end": 10132,
          "span_id": "s159"
        }
      ]
    },
    {
      "id": "s160",
      "start": 10299,
      "end": 10300,
      "text": ".",
      "markers": []
    },
    {
      "id": "s161",
      "start": 10304,
      "end": 10346,
      "text": "حدَّثني يونسُ، قال: أخبرنا ابنُ وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 10324,
          "end": 10330,
          "span_id": "s161"
        }
      ]
    },
    {
      "id": "s162",
      "start": 10346,
      "end": 10370,
      "text": " قال ابنُ زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 10351,
          "end": 10359,
          "span_id": "s162"
        }
      ]
    },
    {
      "id": "s163",
      "start": 10370,
      "end": 10452,
      "text": " {وَتَصْدِيَةً}. قال: التصديةُ عن سبيلِ اللهِ، وصدُّهم عن الصلاةِ، وعن دينِ اللهِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10371,
          "end": 10385,
          "span_id": "s163"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10401,
          "end": 10450,
          "stripped": "عن سبيل الله، وصدهم عن الصلاة، وعن دين الله",
          "span_id": "s163"
        }
      ]
    },
    {
      "id": "s164",
      "start": 10516,
      "end": 10517,
      "text": ".",
      "markers": []
    },
    {
      "id": "s165",
      "start": 10521,
      "end": 10574,
      "text": "حدَّثنا ابنُ حميدٍ، قال: ثنا سَلَمةُ، عن ابنِ إسحاقَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10521,
          "end": 10528,
          "span_id": "s165"
        }
      ]
    },
    {
      "id": "s166",
      "start": 10574,
      "end": 10646,
      "text": " {وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10575,
          "end": 10645,
          "span_id": "s166"
        }
      ]
    },
    {
      "id": "s167",
      "start": 10646,
      "end": 10694,
      "text": " قال: ما كان صلاتُهم التي يزعُمون أنها يُدْرَأُ ",
      "markers": []
    },
    {
      "id": "s168",
      "start": 10725,
      "end": 10828,
      "text": " بها عنهم إلا مُكاءً وتصديةً، وذلك ما لا يَرْضَى اللهُ، ولا يحبُّ، ولا ما افترض عليهم، ولا ما أمرهم به ",
      "markers": []
    },
    {
      "id": "s169",
      "start": 10851,
      "end": 10852,
      "text": ".",
      "markers": []
    },
    {
      "id": "s170",
      "start": 10856,
      "end": 10918,
      "text": "وأما قولُه: {فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10868,
          "end": 10917,
          "span_id": "s170"
        }
      ]
    },
    {
      "id": "s171",
      "start": 10918,
      "end": 10998,
      "text": " فإنه يعنى العذابَ الذي وعَدهم به بالسيفِ يومَ بدرٍ، يقولُ للمشركين الذين قالوا:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 10960,
          "end": 10968,
          "span_id": "s171"
        }
      ]
    },
    {
      "id": "s172",
      "start": 10998,
      "end": 11110,
      "text": " {اللَّهُمَّ إِنْ كَانَ هَذَا هُوَ الْحَقَّ مِنْ عِنْدِكَ فَأَمْطِرْ عَلَيْنَا حِجَارَةً مِنَ السَّمَاءِ} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10999,
          "end": 11103,
          "span_id": "s172"
        }
      ]
    },
    {
      "id": "s173",
      "start": 11110,
      "end": 11148,
      "text": " حين أتاهم بما اسْتَعْجلوه من العذابِ:",
      "markers": []
    },
    {
      "id": "s174",
      "start": 11148,
      "end": 11251,
      "text": " {فَذُوقُوا}، أى اطْعَموا. وليس بذوقٍ بفمٍ، ولكنه ذَوقُ بالحسِّ، ووجودُ طعمٍ ألمِه بالقلوبِ، يقولُ لهم:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11149,
          "end": 11160,
          "span_id": "s174"
        }
      ]
    },
    {
      "id": "s175",
      "start": 11251,
      "end": 11383,
      "text": " فذوقوا العذابَ بما كنتم تجْحَدون أن اللهَ معذِّبُكم به على جحودِكم توحيدَ ربِّكم ورسالةَ نبيِّكم -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11350,
          "end": 11380,
          "span_id": "s175"
        }
      ]
    },
    {
      "id": "s176",
      "start": 11387,
      "end": 11429,
      "text": "وبنحوِ الذي قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s177",
      "start": 11433,
      "end": 11449,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s178",
      "start": 11453,
      "end": 11506,
      "text": "حدَّثنا ابنُ حميدٍ، قال: ثنا سَلَمةُ، عن ابنِ إسحاقَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11453,
          "end": 11460,
          "span_id": "s178"
        }
      ]
    },
    {
      "id": "s179",
      "start": 11506,
      "end": 11562,
      "text": " {فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ}. أى: ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11507,
          "end": 11556,
          "span_id": "s179"
        }
      ]
    },
    {
      "id": "s180",
      "start": 11579,
      "end": 11580,
      "text": " ",
      "markers": []
    },
    {
      "id": "s181",
      "start": 11611,
      "end": 11636,
      "text": " بهم يومَ بدرٍ من القتلِ ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 11616,
          "end": 11624,
          "span_id": "s181"
        }
      ]
    },
    {
      "id": "s182",
      "start": 11659,
      "end": 11660,
      "text": ".",
      "markers": []
    },
    {
      "id": "s183",
      "start": 11664,
      "end": 11703,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11664,
          "end": 11671,
          "span_id": "s183"
        }
      ]
    },
    {
      "id": "s184",
      "start": 11703,
      "end": 11732,
      "text": " ثني حجَّاجٌ، عن ابنِ جُريجٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 11720,
          "end": 11730,
          "span_id": "s184"
        }
      ]
    },
    {
      "id": "s185",
      "start": 11732,
      "end": 11783,
      "text": " {فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11733,
          "end": 11782,
          "span_id": "s185"
        }
      ]
    },
    {
      "id": "s186",
      "start": 11783,
      "end": 11825,
      "text": " قال: هؤلاءِ أهلُ بدرٍ يومَ عذَّبهم اللهُ.",
      "markers": []
    },
    {
      "id": "s187",
      "start": 11829,
      "end": 11864,
      "text": "حُدِّثت عن الحسينِ بنِ الفرجِ، قال:",
      "markers": []
    },
    {
      "id": "s188",
      "start": 11864,
      "end": 11913,
      "text": " سمعتُ أبا معاذٍ قال: ثنا عبيدُ بنُ سليمانَ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 11875,
          "end": 11879,
          "span_id": "s188"
        }
      ]
    },
    {
      "id": "s189",
      "start": 11913,
      "end": 11945,
      "text": " سمعتُ الضحَّاكَ يقولُ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 11920,
          "end": 11928,
          "span_id": "s189"
        }
      ]
    },
    {
      "id": "s190",
      "start": 11945,
      "end": 11996,
      "text": " {فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11946,
          "end": 11995,
          "span_id": "s190"
        }
      ]
    },
    {
      "id": "s191",
      "start": 11996,
      "end": 12054,
      "text": " يعنى: أهلَ بدرٍ، عذَّبهم اللهُ يومَ بدرٍ بالقتلِ والأسرِ ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 12028,
          "end": 12036,
          "span_id": "s191"
        }
      ]
    },
    {
      "id": "s192",
      "start": 12177,
      "end": 12178,
      "text": ".",
      "markers": []
    }
  ],

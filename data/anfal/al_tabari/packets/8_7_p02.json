          "span_id": "s107"
        }
      ]
    },
    {
      "id": "s108",
      "start": 10695,
      "end": 10771,
      "text": " {وَتَوَدُّونَ أَنَّ غَيْرَ ذَاتِ الشَّوْكَةِ تَكُونُ لَكُمْ} إلى آخر الآية:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10696,
          "end": 10756,
          "span_id": "s108"
        }
      ]
    },
    {
      "id": "s109",
      "start": 10771,
      "end": 10846,
      "text": " خرج النبيُّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- إلى بدرٍ وهم يريدون يعترضون ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 10785,
          "end": 10815,
          "span_id": "s109"
        }
      ]
    },
    {
      "id": "s110",
      "start": 10860,
      "end": 10861,
      "text": " ",
      "markers": []
    },
    {
      "id": "s111",
      "start": 10881,
      "end": 10963,
      "text": "، قال: وخرج الشيطان في صورة سُراقةَ بن جُعشُمٍ، حتى أتَى أهل مكةَ، فاستغواهم وقال:",
      "markers": []
    },
    {
      "id": "s112",
      "start": 10963,
      "end": 10992,
      "text": " إن محمدًا وأصحابَه قد عرضوا ",
      "markers": []
    },
    {
      "id": "s113",
      "start": 11019,
      "end": 11076,
      "text": " لعِيرِكم، وقال: لا غالب لكم اليوم من الناسِ، مَن مثلُكم؟",
      "markers": []
    },
    {
      "id": "s114",
      "start": 11076,
      "end": 11119,
      "text": "! وإنى جارٌ لكم أن تكونوا على ما يكره الله.",
      "markers": []
    },
    {
      "id": "s115",
      "start": 11119,
      "end": 11184,
      "text": " فخرجوا ونادوا أن لا يتخلَّفَ منا أحد إلا هدَمنا داره واستبحْناه.",
      "markers": []
    },
    {
      "id": "s116",
      "start": 11184,
      "end": 11253,
      "text": " وأخذ رسول الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- وأصحابه بالرَّوحاء ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11201,
          "end": 11231,
          "span_id": "s116"
        }
      ]
    },
    {
      "id": "s117",
      "start": 11352,
      "end": 11428,
      "text": " عينًا للقوم، فأخبره بهم، فقال رسولُ الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 11379,
          "end": 11393,
          "span_id": "s117"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11395,
          "end": 11425,
          "span_id": "s117"
        }
      ]
    },
    {
      "id": "s118",
      "start": 11428,
      "end": 11471,
      "text": " \"إنَّ الله قد وَعَدكُمُ العِير أو القومَ\".",
      "markers": []
    },
    {
      "id": "s119",
      "start": 11471,
      "end": 11501,
      "text": " فكانت العيرُ أحبَّ إلى القوم ",
      "markers": []
    },
    {
      "id": "s120",
      "start": 11511,
      "end": 11512,
      "text": " ",
      "markers": []
    },
    {
      "id": "s121",
      "start": 11524,
      "end": 11594,
      "text": "؛ كان القتالُ في الشوكةِ، والعيرُ ليس فيها قتال، وذلك قول الله عز وجل:",
      "markers": []
    },
    {
      "id": "s122",
      "start": 11594,
      "end": 11659,
      "text": " {وَتَوَدُّونَ أَنَّ غَيْرَ ذَاتِ الشَّوْكَةِ تَكُونُ لَكُمْ}. قا",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11595,
          "end": 11655,
          "span_id": "s122"
        }
      ]
    },
    {
      "id": "s123",
      "start": 11663,
      "end": 11706,
      "text": "ل: الشوكةُ: القتالُ، وغيرُ الشوكة: العِيرُ.",
      "markers": []
    },
    {
      "id": "s124",
      "start": 11710,
      "end": 11747,
      "text": "حدَّثني المثنى، قال: ثنا إسحاقُ، قال:",
      "markers": []
    },
    {
      "id": "s125",
      "start": 11747,
      "end": 11778,
      "text": " ثنا يعقوب بن محمد الزهرى، قال:",
      "markers": []
    },
    {
      "id": "s126",
      "start": 11778,
      "end": 11868,
      "text": " ثنا عبد الله بن وهبٍ، عن ابن لَهِيعَةَ، عن ابن أبي حبيب، عن أبي عمران، عن أبي أيوبَ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11801,
          "end": 11838,
          "stripped": "عن ابن لهيعة، عن ابن أبي حبيب، عن",
          "span_id": "s126"
        }
      ]
    },
    {
      "id": "s127",
      "start": 11868,
      "end": 11959,
      "text": " أنزل الله جلَّ وعزَّ: {وَإِذْ يَعِدُكُمُ اللَّهُ إحْدَى الطَّائِفَتَيْنِ أَنَّهَا لَكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11891,
          "end": 11958,
          "span_id": "s127"
        }
      ]
    },
    {
      "id": "s128",
      "start": 11959,
      "end": 12023,
      "text": " فلمّا وعدنا إحدى الطائفتين أنها لنا طابتْ أنفُسُنا، والطائفتان:",
      "markers": []
    },
    {
      "id": "s129",
      "start": 12023,
      "end": 12049,
      "text": " عِيرُ أبي سفيان، أو قريش ",
      "markers": []
    },
    {
      "id": "s130",
      "start": 12178,
      "end": 12179,
      "text": ".",
      "markers": []
    },
    {
      "id": "s131",
      "start": 12183,
      "end": 12225,
      "text": "حدَّثني المثنى، قال: ثنا سويد بن نصر، قال:",
      "markers": []
    },
    {
      "id": "s132",
      "start": 12225,
      "end": 12326,
      "text": " أخبرنا ابن المبارك، عن ابن لَهِيعةَ، عن يزيدَ بن أبي حبيبٍ، عن أسلم أبى عمران الأنصاريِّ، أحسبه قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 12226,
          "end": 12232,
          "span_id": "s132"
        },

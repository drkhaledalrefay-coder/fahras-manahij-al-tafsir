          "end": 10660,
          "span_id": "s106"
        }
      ]
    },
    {
      "id": "s107",
      "start": 10674,
      "end": 10695,
      "text": " قال ابن زيد في قوله:",
      "markers": [
        {
          "family": "TABIIN",

      "id": "s150",
      "start": 13332,
      "end": 13402,
      "text": "وأما قوله: {أَنَّهَا لَكُمْ} ففُتحت على تكرير \"يَعِدُ\"، وذلك أن قولَه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13343,
          "end": 13360,
          "span_id": "s150"
        }
      ]
    },
    {
      "id": "s151",
      "start": 13402,
      "end": 13461,
      "text": " {يَعِدُكُمُ اللَّهُ} قد عمل في {إِحْدَى الطَّائِفَتَيْنِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13403,
          "end": 13423,
          "span_id": "s151"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13434,
          "end": 13460,
          "span_id": "s151"
        }
      ]
    },
    {
      "id": "s152",
      "start": 13465,
      "end": 13532,
      "text": "فتأويل الكلام {وَإِذْ يَعِدُكُمُ اللَّهُ إِحْدَى الطَّائِفَتَيْنِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13479,
          "end": 13531,
          "span_id": "s152"
        }
      ]
    },
    {
      "id": "s153",
      "start": 13532,
      "end": 13570,
      "text": " يعدكم أن إحدى الطائفتين لكم، كما قال:",
      "markers": []
    },
    {
      "id": "s154",
      "start": 13570,
      "end": 13634,
      "text": " {فَهَلْ يَنظُرُونَ إِلَّا السَّاعَةَ أَن تَأْتِيَهُم بَغْتَةً} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13571,
          "end": 13633,
          "span_id": "s154"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 13634,
          "end": 13644,
          "text": "[محمد: 18]",
          "via": "apparatus",
          "span_id": "s154"
        }
      ]
    },
    {
      "id": "s155",
      "start": 13644,
      "end": 13712,
      "text": ". قال: {وَتَوَدُّونَ أَنَّ غَيْرَ ذَاتِ الشَّوْكَةِ تَكُونُ لَكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13651,
          "end": 13711,
          "span_id": "s155"
        }
      ]
    },
    {
      "id": "s156",
      "start": 13712,
      "end": 13752,
      "text": " فأنَّثَ \"ذات\" لأنَّه مرادٌ بها الطائفة.",
      "markers": []
    },
    {
      "id": "s157",
      "start": 13756,
      "end": 13850,
      "text": "ومعنى الكلام: وتودُّون أن الطائفة التى هى غيرُ ذاتِ الشوكة تكون لكم، دون الطائفةِ ذاتِ الشوكة.",
      "markers": []
    },
    {
      "id": "s158",
      "start": 13854,
      "end": 13969,
      "text": "القولُ في تأويل قوله: {وَيُرِيدُ اللَّهُ أَنْ يُحِقَّ الْحَقَّ بِكَلِمَاتِهِ وَيَقْطَعَ دَابِرَ الْكَافِرِينَ (7)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13876,
          "end": 13968,
          "span_id": "s158"
        }
      ]
    },
    {
      "id": "s159",
      "start": 13973,
      "end": 14030,
      "text": "يقول تعالى ذكرُه: ويريدُ الله أن يُحقَّ الإسلام ويُعليَه ",
      "markers": []
    },
    {
      "id": "s160",
      "start": 14065,
      "end": 14161,
      "text": ": {بِكَلِمَاتِهِ}. يقولُ: بأمره إيَّاكم أيها المؤمنون بقتال الكفار، وأنتم تريدون الغنيمة والمال.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14067,
          "end": 14082,
          "span_id": "s160"
        }
      ]
    },
    {
      "id": "s161",
      "start": 14165,
      "end": 14232,
      "text": "وقوله: {وَيَقْطَعَ دَابِرَ الْكَافِرِينَ}. يقولُ: ويريد أن يَجُبَّ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14172,
          "end": 14206,
          "span_id": "s161"
        }
      ]
    },
    {
      "id": "s162",
      "start": 14250,
      "end": 14277,
      "text": " أصلَ الجاحدين توحيدَ الله.",
      "markers": []
    },
    {
      "id": "s163",
      "start": 14281,
      "end": 14371,
      "text": "وقد بيَّنا فيما مضَى معنى \"دابر\"، وأنَّه المتأخرُ، وأن معنى قطعه: الإتيان على الجميع منهم ",
      "markers": []
    },
    {
      "id": "s164",
      "start": 14388,
      "end": 14389,
      "text": ".",
      "markers": []
    },
    {
      "id": "s165",
      "start": 14393,
      "end": 14430,
      "text": "وبنحو ما قلنا في ذلك قال أهل التأويل.",
      "markers": []
    },
    {
      "id": "s166",
      "start": 14434,
      "end": 14448,
      "text": "ذكر من قال ذلك",
      "markers": []
    },
    {
      "id": "s167",
      "start": 14452,
      "end": 14493,
      "text": "حدَّثني يونسُ، قال: أخبرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 14472,
          "end": 14478,
          "span_id": "s167"
        }
      ]
    },
    {
      "id": "s168",
      "start": 14493,
      "end": 14519,
      "text": " قال ابن زيد، في قول الله:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 14498,
          "end": 14505,
          "span_id": "s168"
        }
      ]
    },
    {
      "id": "s169",
      "start": 14519,
      "end": 14576,
      "text": " {وَيُرِيدُ اللَّهُ أَنْ يُحِقَّ الْحَقَّ بِكَلِمَاتِهِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14520,
          "end": 14575,
          "span_id": "s169"
        }
      ]
    },
    {
      "id": "s170",
      "start": 14576,
      "end": 14646,
      "text": " أن يقتل هؤلاء الذين أراد أن يقطعَ دَابِرَهم، هذا خيرٌ لكم من العِيرِ.",
      "markers": []
    },
    {
      "id": "s171",
      "start": 14650,
      "end": 14786,
      "text": "حدَّثنا ابن حميد، قال: ثنا سلَمةُ، عن ابن إسحاق {وَيُرِيدُ اللَّهُ أَن يُحِقَّ الْحَقَّ بِكَلِمَاتِهِ وَيَقْطَعَ دَابِرَ الْكَافِرِينَ}.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 14650,
          "end": 14657,
          "span_id": "s171"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14698,
          "end": 14785,
          "span_id": "s171"
        }
      ]
    },
    {
      "id": "s172",
      "start": 14786,
      "end": 14830,
      "text": " أي: الوقعة التي أوقعَ بصناديد قريش وقادتهم ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 14787,
          "end": 14790,
          "span_id": "s172"
        }
      ]
    },
    {
      "id": "s173",
      "start": 14847,
      "end": 14857,
      "text": " يوم بدرٍ ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 14848,
          "end": 14855,
          "span_id": "s173"
        }
      ]
    },
    {
      "id": "s174",
      "start": 14880,
      "end": 14881,
      "text": ".",
      "markers": []
    }
  ],

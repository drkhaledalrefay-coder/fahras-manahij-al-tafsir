    },
    {
      "id": "s133",
      "start": 12326,
      "end": 12469,
      "text": " قال أبو أيوبَ: {وَإِذْ يَعِدُكُمُ اللَّهُ إحْدَى الطَّائِفَتَيْنِ أَنَّهَا لَكُمْ وَتَوَدُّونَ أَنَّ غَيْرَ ذَاتِ الشَّوْكَةِ تَكُونُ لَكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12342,
          "end": 12468,
          "span_id": "s133"
        }
      ]
    },
    {
      "id": "s134",
      "start": 12469,
      "end": 12506,
      "text": " قالوا: الشوكةُ: القوم، وغيرُ الشوكة:",
      "markers": []
    },
    {
      "id": "s135",
      "start": 12506,
      "end": 12549,
      "text": " العِيرُ، فلمَّا وعدنا الله إحدى الطائفتين؛",
      "markers": []
    },
    {
      "id": "s136",
      "start": 12549,
      "end": 12589,

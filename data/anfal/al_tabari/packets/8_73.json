    },
    {
      "id": "s022",
      "start": 1377,
      "end": 1533,
      "text": " قال: وذلك لأن هذا الدينَ كان بهذا البلدِ قليلًا، حتى كان يومُ الفتحِ وانقَطَعت الهجرةُ توارَثوا حيثما كانوا بالأرحامِ، وقال النبيُّ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1512,
          "end": 1530,
          "span_id": "s022"
        }
      ]
    },
    {
      "id": "s023",
      "start": 1533,
      "end": 1564,
      "text": " \"لا هجرةَ بعدَ الفتحِ\". وقرَأ ",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 1559,
          "end": 1563,
          "span_id": "s023"
        }

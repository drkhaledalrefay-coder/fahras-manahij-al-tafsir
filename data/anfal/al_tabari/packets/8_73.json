          "span_id": "s019"
        }
      ]
    },
    {
      "id": "s020",
      "start": 1152,
      "end": 1265,
      "text": " {وَالَّذِينَ آمَنُوا وَلَمْ يُهَاجِرُوا مَا لَكُمْ مِنْ وَلَايَتِهِمْ مِنْ شَيْءٍ حَتَّى يُهَاجِرُوا} إلى قولِه:",

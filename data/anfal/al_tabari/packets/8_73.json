    },
    {
      "id": "s024",
      "start": 1580,
      "end": 1654,
      "text": ": {وَأُولُو الْأَرْحَامِ بَعْضُهُمْ أَوْلَى بِبَعْضٍ فِي كِتَابِ اللَّهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1582,
          "end": 1653,
          "span_id": "s024"
        }

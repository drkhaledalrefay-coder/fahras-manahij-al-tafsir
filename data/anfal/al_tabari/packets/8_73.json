    },
    {
      "id": "s021",
      "start": 1265,
      "end": 1377,
      "text": " {وَفَسَادٌ كَبِيرٌ}. قال: كان المؤمنُ المهاجِرُ والمؤمنُ الذي ليس بمهاجرٍ لا يتَوارَثان وإن كانا أخوَين مؤمنين.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1266,
          "end": 1285,
          "span_id": "s021"
        }

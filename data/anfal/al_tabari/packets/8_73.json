    {
      "id": "s040",
      "start": 2591,
      "end": 2768,
      "text": " فقال بعضُهم: معناه: إلا تَفْعَلُوا أَيُّها المؤمنون ما أُمِرتُم به من مُوارَثةِ المهاجرين منكم بعضِهم من بعضٍ بالهجرةِ والأنصارِ بالإيمانِ، دونَ أقربائِهم من أعرابِ المسلمين و ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 2605,
          "end": 2610,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 2796,
      "end": 2835,
      "text": " دونَ الكفارِ {تَكُنْ فِتْنَةٌ}. يقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2810,
          "end": 2827,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 2835,
      "end": 2911,
      "text": " يحدُثْ بلاءٌ في الأرضِ بسببِ ذلك، {وَفَسَادٌ كَبِيرٌ}. يعنى: ومعاصٍ للَّهِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2870,
          "end": 2889,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 2942,
      "end": 2943,
      "text": ".",
      "markers": []
    },
    {
      "id": "s044",
      "start": 2947,
      "end": 2962,
      "text": "ذكر مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s045",
      "start": 2966,
      "end": 3009,
      "text": "حدَّثني يونُسُ، قال: أخبرَنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2987,
          "end": 2994,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3009,
      "end": 3032,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 3014,
          "end": 3021,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3032,
      "end": 3102,
      "text": " {إِلَّا تَفْعَلُوهُ تَكُنْ فِتْنَةٌ فِي الْأَرْضِ وَفَسَادٌ كَبِيرٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3033,
          "end": 3101,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3102,
      "end": 3213,
      "text": " إلا تَفْعلوا هذا تَتْرُكوهم يَتَوارثون كما كانوا يَتَوارثون {تَكُنْ فِتْنَةٌ فِي الْأَرْضِ وَفَسَادٌ كَبِيرٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3163,
          "end": 3212,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3213,
      "end": 3331,
      "text": " قال: ولم يَكُنْ رسولُ اللَّهِ - صلى الله عليه وسلم - يَقْبَلُ الإيمانَ إلا بالهجرةِ، ولا يَجعلونهم منهم إلا بالهجرةِ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3246,
          "end": 3264,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 3335,
      "end": 3388,
      "text": "حدَّثني المثنى، قال: ثنا عبدُ اللَّهِ بنُ صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s051",
      "start": 3388,
      "end": 3431,
      "text": " ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3402,
          "end": 3431,
          "stripped": "عن علي، عن ابن عباس قوله:",
          "span_id": "s051"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 3405,
          "end": 3408,
          "span_id": "s051"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 3415,
          "end": 3423,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 3431,
      "end": 3485,
      "text": " {وَالَّذِينَ كَفَرُوا بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3432,
          "end": 3484,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 3485,
      "end": 3526,
      "text": " يعنى: في الميراثِ. {إِلَّا تَفْعَلُوهُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3505,
          "end": 3525,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 3526,
      "end": 3626,
      "text": " يقولُ: إلا تأْخُذوا في الميراثِ بما أَمَرتُكم به {تَكُنْ فِتْنَةٌ فِي الْأَرْضِ وَفَسَادٌ كَبِيرٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3576,
          "end": 3625,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 3769,
      "end": 3770,
      "text": ".",
      "markers": []
    },
    {
      "id": "s056",
      "start": 3774,
      "end": 3872,
      "text": "وقال آخرون: معنى ذلك: إلا تَناصروا أيُّها المؤمنون في الدِّينِ تَكُنْ فتنةٌ في الأرض وفسادٌ كبيرٌ.",
      "markers": []
    },
    {
      "id": "s057",
      "start": 3876,
      "end": 3891,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s058",
      "start": 3895,
      "end": 3949,
      "text": "حدَّثنا ابن حميدٍ، قال: ثنا سلمةُ، عن ابن إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3895,
          "end": 3902,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 3949,
      "end": 3988,
      "text": " جعَل المهاجرين والأنصارَ أهلَ وَلايةٍ ",
      "markers": []
    },
    {
      "id": "s060",
      "start": 4008,
      "end": 4075,
      "text": " في الدين دونَ من سِواهم، وجعل الكفارَ بعضَهم أولياءَ بعضٍ، ثم قال:",
      "markers": []
    },
    {
      "id": "s061",
      "start": 4075,
      "end": 4188,
      "text": " {إِلَّا تَفْعَلُوهُ تَكُنْ فِتْنَةٌ فِي الْأَرْضِ وَفَسَادٌ كَبِيرٌ} أَن يَتَولَّى المؤمنُ الكافرَ دونَ المؤمنِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4076,
          "end": 4144,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4188,
      "end": 4220,
      "text": " ثم ردَّ المواريثَ إلى الأرحامِ ",
      "markers": []
    },
    {
      "id": "s063",
      "start": 4391,
      "end": 4392,
      "text": ".",
      "markers": []
    },
    {
      "id": "s064",
      "start": 4396,
      "end": 4435,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4396,
          "end": 4403,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4435,
      "end": 4466,
      "text": " ثني حجاجٌ، قال: قال ابن جريجٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 4456,
          "end": 4464,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 4466,
      "end": 4543,
      "text": " قولُه: {إِلَّا تَفْعَلُوهُ تَكُنْ فِتْنَةٌ فِي الْأَرْضِ وَفَسَادٌ كَبِيرٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4474,
          "end": 4542,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 4543,
      "end": 4614,
      "text": " قال: إلا تَعاوَنوا وتَناصروا في الدين تكن فتنةٌ في الأرض وفسادٌ كبيرٌ ",
      "markers": []
    },
    {
      "id": "s068",
      "start": 4645,
      "end": 4646,
      "text": ".",
      "markers": []
    },
    {
      "id": "s069",
      "start": 4650,
      "end": 4692,
      "text": "قال أبو جعفر: وأولى التأويلين بتأويل قوله:",
      "markers": []
    },
    {
      "id": "s070",
      "start": 4692,
      "end": 4758,
      "text": " {وَالَّذِينَ كَفَرُوا بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ} قولُ من قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4693,
          "end": 4745,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 4758,
      "end": 4881,
      "text": " معناه أن بعضَهم أنصارُ بعضٍ دونَ المؤمنين، وأنه دَلالةٌ على تحريمِ الله على المؤمنِ المُقامَ في دار الحربِ، وتركَ الهجرةِ؛",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 4759,
          "end": 4764,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 4881,
      "end": 4977,
      "text": " لأن المعروفَ في كلامِ العربِ من معنى الوليِّ أنه النَّصيرُ والمُعينُ، أو ابن العمِّ والنَّسيبُ.",
      "markers": []
    },
    {
      "id": "s073",
      "start": 4977,
      "end": 5115,
      "text": " فأما الوارثُ فغيرُ معروفٍ ذلك من معانيه، إلا بمعنى أنه يَليه في القيام بإِرثِه من بعدِه، وذلك معنًى بعيدٌ، وإن كان قد يَحتَمِلُه الكلامُ.",
      "markers": []
    },
    {
      "id": "s074",
      "start": 5115,
      "end": 5190,
      "text": " وتوجيهُ معنى كلامِ الله إلى الأظهرِ الأشهرِ أولى من توجيههِ إلى خلافِ ذلك.",
      "markers": []
    },
    {
      "id": "s075",
      "start": 5194,
      "end": 5244,
      "text": "وإذ كان ذلك كذلك، فبيِّنٌ أن أولى التأويلين بقوله:",
      "markers": []
    },
    {
      "id": "s076",
      "start": 5244,
      "end": 5328,
      "text": " {إِلَّا تَفْعَلُوهُ تَكُنْ فِتْنَةٌ فِي الْأَرْضِ وَفَسَادٌ كَبِيرٌ} تأويلُ من قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5245,
          "end": 5313,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 5328,
      "end": 5413,
      "text": " إلا تَفْعَلوا ما أمرتُكم به من التعاونِ والنُّصرةِ على الدين، تكُنْ فتنةٌ في الأرضِ.",
      "markers": []
    },
    {
      "id": "s078",
      "start": 5413,
      "end": 5444,
      "text": " إذ كان مبتدأُ الآيةِ من قولِه:",
      "markers": []
    },
    {
      "id": "s079",
      "start": 5444,
      "end": 5631,
      "text": " {إِنَّ الَّذِينَ آمَنُوا وَهَاجَرُوا وَجَاهَدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فِي سَبِيلِ اللَّهِ} بالحثِّ على الموالاةِ على الدين والتَّناصُرِ جاء، وكذلك الواجبُ أن يكونَ خاتمتُها به.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5445,
          "end": 5545,
          "span_id": "s079"
        }
      ]
    }
  ],

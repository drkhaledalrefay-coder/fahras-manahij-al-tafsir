    },
    {
      "id": "s025",
      "start": 1658,
      "end": 1769,
      "text": "وقال آخرون: معنى ذلك أن الكفارَ بعضُهم أنصارُ بعضٍ، وأنه لا يكونُ مؤمنًا من كان مقيمًا بدارِ الحربِ لم يهاجِرْ.",
      "markers": []
    },
    {
      "id": "s026",
      "start": 1773,
      "end": 1788,
      "text": "ذكرُ من قال ذلك",
      "markers": []
    },
    {
      "id": "s027",
      "start": 1792,
      "end": 1826,
      "text": "حدَّثنا بشرٌ، قال: ثنا يزيدُ، قال:",
      "markers": [

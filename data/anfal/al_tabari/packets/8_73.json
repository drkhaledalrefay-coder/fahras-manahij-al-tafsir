    {
      "id": "s001",
      "start": 4,
      "end": 153,
      "text": "القولُ في تأويلِ قولِه: {وَالَّذِينَ كَفَرُوا بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ إِلَّا تَفْعَلُوهُ تَكُنْ فِتْنَةٌ فِي الْأَرْضِ وَفَسَادٌ كَبِيرٌ (73)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28,
          "end": 152,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 157,
      "end": 246,
      "text": "يقولُ تعالى ذكره: {وَالَّذِينَ كَفَرُوا} باللَّهِ ورسوله {بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 175,
          "end": 197,
          "span_id": "s002"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 214,
          "end": 245,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 246,
      "end": 322,
      "text": " يقولُ: بعضُهم أعوانُ بعضٍ وأنصارُه، وأحقُّ به من المؤمنين باللَّهِ ورسولِه.",
      "markers": []
    },
    {
      "id": "s004",
      "start": 326,
      "end": 360,
      "text": "وقد ذكَرنا قولَ من قال: عنى بأنَّ ",
      "markers": []
    },
    {
      "id": "s005",
      "start": 411,
      "end": 462,
      "text": " بعضَهم أحقُّ بميراثِ بعضٍ من قرابتِهم من المؤمنين.",
      "markers": []
    },
    {
      "id": "s006",
      "start": 462,
      "end": 495,
      "text": " وسنذكُرُ بقيةَ من حضَرَنا ذكرُه.",
      "markers": []
    },
    {
      "id": "s007",
      "start": 499,
      "end": 530,
      "text": "حدَّثنا محمدُ بنُ بشَّارٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 499,
          "end": 506,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 530,
      "end": 598,
      "text": " ثنا عبدُ الرحمنِ، قال: ثنا سفيانُ، عن السدِّيِّ، عن أبي مالكٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 566,
          "end": 598,
          "stripped": "عن السدي، عن أبي مالك، قال:",
          "span_id": "s008"
        },
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "NARRATOR",
          "start": 569,
          "end": 576,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 598,
      "end": 639,
      "text": " قال رجلٌ: نُورِّثُ أرحامَنا من المشركين؟",
      "markers": []
    },
    {
      "id": "s010",
      "start": 639,
      "end": 709,
      "text": " فنزَلَت: {وَالَّذِينَ كَفَرُوا بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ} الآيةَ ",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 640,
          "end": 647,
          "span_id": "s010"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 649,
          "end": 701,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 772,
      "end": 773,
      "text": ".",
      "markers": []
    },
    {
      "id": "s012",
      "start": 777,
      "end": 805,
      "text": "حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s013",
      "start": 805,
      "end": 835,
      "text": " ثنى أبي، قال: ثني عمِّي، قال:",
      "markers": []

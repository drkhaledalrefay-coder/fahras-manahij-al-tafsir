    {
      "id": "s001",
      "start": 4,
      "end": 241,
      "text": "القول في تأويل قوله: {كَمَا أَخْرَجَكَ رَبُّكَ مِنْ بَيْتِكَ بِالْحَقِّ وَإِنَّ فَرِيقًا مِنَ الْمُؤْمِنِينَ لَكَارِهُونَ (5) يُجَادِلُونَكَ فِي الْحَقِّ بَعْدَ مَا تَبَيَّنَ كَأَنَّمَا يُسَاقُونَ إِلَى الْمَوْتِ وَهُمْ يَنْظُرُونَ (6)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 25,
          "end": 240,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 245,
      "end": 299,
      "text": "اختلف أهل التأويل في الجالبِ لهذه الكافِ التي في قوله:",
      "markers": []
    },
    {
      "id": "s003",
      "start": 299,
      "end": 407,
      "text": " {كَمَا أَخْرَجَكَ}. وما الذى شُبِّه بإخراج اللهِ نبيَّه -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- من بيتِه بالحقِّ؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 300,
          "end": 318,
          "span_id": "s003"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 357,
          "end": 387,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 407,
      "end": 508,
      "text": " فقال بعضُهم: شُبِّه به في الصلاح للمؤمنين، اتقاؤهم ربَّهم، وإصلاحهم ذات بينهم، وطاعتهم الله ورسولَه.",
      "markers": []
    },
    {
      "id": "s005",
      "start": 508,
      "end": 541,
      "text": " وقالوا: معنى ذلك: يقولُ اللَّهُ:",
      "markers": []
    },
    {
      "id": "s006",
      "start": 541,
      "end": 592,
      "text": " وأَصْلِحوا ذات بينكم، فإن ذلك خيرٌ لكم، كما إخراج ",
      "markers": []
    },
    {
      "id": "s007",
      "start": 610,
      "end": 671,
      "text": " اللهِ محمدا -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- من بيته بالحق ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 624,
          "end": 654,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 689,
      "end": 702,
      "text": " كان خيرا له.",
      "markers": []
    },
    {
      "id": "s009",

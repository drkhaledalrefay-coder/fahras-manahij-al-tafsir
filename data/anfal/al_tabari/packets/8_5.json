        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2477,
          "end": 2507,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 2622,
      "end": 2634,
      "text": " وهم كارهون.",
      "markers": []
    },
    {
      "id": "s040",
      "start": 2638,
      "end": 2664,
      "text": "وقال آخرون منهم: معنى ذلك:",
      "markers": []
    },
    {
      "id": "s041",
      "start": 2664,
      "end": 2737,
      "text": " يسألونك عن الأنفال مجادلةً كما جادَلوك يوم بدرٍ، فقالوا: أخرجْتنا للعير ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 2704,
          "end": 2711,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 2756,
      "end": 2788,
      "text": "، ولم تُعلمنا قتالا فنستعدَّ له.",
      "markers": []
    },
    {
      "id": "s043",
      "start": 2792,
      "end": 2875,
      "text": "وقال بعضُ نحويِّى البصرةِ: يجوز أن يكونَ هذا الكافُ في {كَمَا أَخْرَجَكَ} على قوله:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2847,
          "end": 2865,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 2875,
      "end": 2918,
      "text": " {أَوْلَئِكَ هُمُ الْمُؤْمِنُونَ حَقًّا}. .",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2876,
          "end": 2915,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 2918,
      "end": 2979,
      "text": " . {كَمَا أَخْرَجَكَ رَبُّكَ مِنْ بَيْتِكَ بِالْحَقِّ}. وقال ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2921,
          "end": 2972,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 2993,
      "end": 3013,
      "text": ": الكافُ بمعنى علَى.",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3017,
      "end": 3027,
      "text": "وقال آخرُ ",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3054,
      "end": 3083,
      "text": " منهم: هى بمعنى القسَمِ. قال:",
      "markers": []
    },
    {
      "id": "s049",
      "start": 3083,
      "end": 3116,
      "text": " ومعنى الكلام: والذي أخرجك ربُّك.",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3120,
      "end": 3209,
      "text": "قال أبو جعفرٍ: وأَوْلَى هذه الأقوال عندى بالصوابِ قولُ مَن قال في ذلك بقولِ مجاهدٍ، وقال:",
      "markers": []
    },
    {
      "id": "s051",
      "start": 3209,
      "end": 3263,
      "text": " معناه: كما أخرجك ربُّك بالحقِّ، على كُرْه من فريق من ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 3210,
          "end": 3215,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 3278,
      "end": 3329,
      "text": " المؤمنين، كذلك يُجادِلونك في الحقِّ بعدما تبيَّنَ؛",
      "markers": []
    },
    {
      "id": "s053",
      "start": 3329,
      "end": 3524,
      "text": " لأن كلا الأمرين قد كان، أعنى خروج بعض من خرَج من المدينةِ كارهًا، وجدالهم في لقاء العدوِّ عند دنوِّ القومِ بعضهم من بعض، فتشبيه بعض ذلك ببعض مع قرب أحدهما من الآخر، أولَى من تشبيهه بما بعُد عنه.",
      "markers": []
    },
    {
      "id": "s054",
      "start": 3528,
      "end": 3557,
      "text": "وقال مجاهد في الحق الذى ذُكر ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3533,
          "end": 3538,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 3575,
      "end": 3660,
      "text": " أنهم يجادلون فيه النبي -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- بعد ما تبيَّنوه: هو القتال.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3600,
          "end": 3630,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 3664,
      "end": 3690,
      "text": "حدَّثني محمد بن عمرو، قال:",
      "markers": []
    },
    {
      "id": "s057",
      "start": 3690,
      "end": 3749,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابن أبى نَجيحٍ، عن مجاهد:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3721,
          "end": 3749,
          "stripped": "عن ابن أبى نجيح، عن مجاهد:",
          "span_id": "s057"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3743,
          "end": 3748,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 3749,
      "end": 3794,
      "text": " {يُجَادِلُونَكَ فِي الْحَقِّ}. قال: القتالُ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3750,
          "end": 3779,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 3798,
      "end": 3839,
      "text": "حدَّثني المثنى، قال: ثنا أبو حذيفةَ، قال:",
      "markers": []
    },
    {
      "id": "s060",
      "start": 3839,
      "end": 3885,
      "text": " ثنا شبلٌ، عن ابن أبي نَجيحٍ، عن مجاهدٍ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3850,
          "end": 3885,
          "stripped": "عن ابن أبي نجيح، عن مجاهد مثله.",
          "span_id": "s060"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 3872,
          "end": 3877,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 3889,
      "end": 3968,
      "text": "حدَّثنا إسحاق، قال: ثنا عبدُ الله، عن ورقاءَ، عن ابن أبي نَجيحٍ، عن مجاهد مثله ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3889,
          "end": 3896,
          "span_id": "s061"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3924,
          "end": 3956,
          "stripped": "عن ورقاء، عن ابن أبي نجيح، عن",
          "span_id": "s061"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 3957,
          "end": 3962,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4106,
      "end": 4107,
      "text": ".",
      "markers": []
    },
    {
      "id": "s063",
      "start": 4111,
      "end": 4173,
      "text": "وأما قولُه: {مِن بَيْتِكَ}. فإن بعضهم قال: معناه: من المدينةِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4123,
          "end": 4137,
          "span_id": "s063"
        },
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 4154,
          "end": 4159,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 4177,
      "end": 4191,
      "text": "ذكر من قال ذلك",
      "markers": []
    },
    {
      "id": "s065",
      "start": 4195,
      "end": 4236,
      "text": "حدَّثني المثنى، قال: ثنا أبو حذيفةَ، قال:",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4236,
      "end": 4265,
      "text": " ثنا شبلٌ، عن ابن أبي بزَّةَ:",
      "markers": []
    },
    {
      "id": "s067",
      "start": 4265,
      "end": 4325,
      "text": " {كَمَا أَخْرَجَكَ رَبُّكَ مِنْ بَيْتِكَ}: المدينة إلى بدرٍ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4266,
          "end": 4306,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 4329,
      "end": 4368,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4329,
          "end": 4336,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 4368,
      "end": 4399,
      "text": " ثني حجاجٌ، عن ابن جُريجٍ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 4383,
          "end": 4392,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 4399,
      "end": 4438,
      "text": " أخبرني محمد بن عبّادِ بن جعفر في قوله:",
      "markers": []
    },
    {
      "id": "s071",
      "start": 4438,
      "end": 4491,
      "text": " {كَمَا أَخْرَجَكَ رَبُّكَ مِنْ بَيْتِكَ بِالْحَقِّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4439,
          "end": 4490,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 4491,
      "end": 4517,
      "text": " قال: من المدينة إلى بدرٍ.",
      "markers": []
    },
    {
      "id": "s073",
      "start": 4521,
      "end": 4631,
      "text": "وأما قوله: {وَإِنَّ فَرِيقًا مِّنَ الْمُؤْمِنِينَ لَكَارِهُونَ}، فإن كراهتهم كانت كما حدَّثنا ابن حُميدٍ، قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4532,
          "end": 4584,
          "span_id": "s073"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4607,
          "end": 4614,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 4631,
      "end": 4662,
      "text": " ثنا سلمَةُ، عن ابن إسحاق، قال:",
      "markers": []
    },
    {
      "id": "s075",
      "start": 4662,
      "end": 4817,
      "text": " ثنى محمد بن مسلم الزهريُّ وعاصم بن عمر بن قتادة وعبد الله بن أبى بكر ويزيد بن رومانَ، عن عروة بن الزبير -وغيرهم من علمائنا- عن عبدِ اللهِ بنِ عباس، قالوا:",
      "markers": []
    },
    {
      "id": "s076",
      "start": 4817,
      "end": 4925,
      "text": " لما سمع رسول الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- بأبي سفيانَ مقبلًا من الشام، ندَب إليهم المسلمين، وقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4837,
          "end": 4867,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 4925,
      "end": 5003,
      "text": " \"هذه عيرُ قريش فيها أموالهم، فاخْرُجوا إليها لعلَّ اللَّه أن يُنفِّلَكُموها\".",
      "markers": []
    },
    {
      "id": "s078",
      "start": 5003,
      "end": 5046,
      "text": " فانتدَب الناس، فخفَّ بعضُهم، وثقُل بعضُهم ",
      "markers": []
    },
    {
      "id": "s079",
      "start": 5074,
      "end": 5155,
      "text": "، وذلك أنهم لم يظُنُّوا أن رسول الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- يلقى حربا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أن رسول الله",
          "start": 5098,
          "end": 5110,
          "span_id": "s079"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5112,
          "end": 5142,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 5275,
      "end": 5276,
      "text": ".",
      "markers": []
    },
    {
      "id": "s081",
      "start": 5280,
      "end": 5308,
      "text": "حدَّثني محمد بن الحسين، قال:",
      "markers": []
    },
    {
      "id": "s082",
      "start": 5308,
      "end": 5335,
      "text": " ثنا أحمد بن المفضَّل، قال:",
      "markers": []
    },
    {
      "id": "s083",
      "start": 5335,
      "end": 5428,
      "text": " ثنا أسباط، عن السُّديِّ: {وَإِنَّ فَرِيقًا مِّنَ الْمُؤْمِنِينَ لَكَارِهُونَ} لطلب المشركين ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 5350,
          "end": 5357,
          "span_id": "s083"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5361,
          "end": 5413,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 5491,
      "end": 5492,
      "text": ".",
      "markers": []
    }
  ],

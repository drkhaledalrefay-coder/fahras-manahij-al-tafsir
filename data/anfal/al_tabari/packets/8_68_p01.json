  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 117,
      "text": "القولُ في تأويلِ قولِه: {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ (68)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28,
          "end": 116,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 121,
      "end": 192,
      "text": "يقولُ تعالى ذكرُه لأهلِ بدرٍ الذين غَنِموا وأخَذوا من الأَسْرى الفداءَ:",
      "markers": []
    },
    {
      "id": "s003",
      "start": 192,
      "end": 231,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 193,
          "end": 230,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 231,
      "end": 619,
      "text": " يقولُ: لولا قضاءٌ من اللَّهِ سَبَقَ لكم، أهلَ بدرٍ، في اللوحِ المحفوظِ - بأن اللَّهَ مُحِلٌّ لكم الغنيمةَ، وأن اللَّهَ قَضَى فيما قَضَى أنه لا يُضِلُّ قومًا بعدَ إذ هَداهم حتى يُبَيِّنَ لهم ما يَتَّقون، وأنه لا يُعذِّبُ أحدًا شَهِدَ المشهدَ الذي شَهِدتُموه ببدرٍ مع رسولِ اللَّهِ - صلى الله عليه وسلم - ناصرًا دينَ اللَّهِ - لنالَكم مِن اللَّهِ، بأخْذِكم الغنيمةَ والفِداءَ، عذابٌ عظيمٌ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 514,
          "end": 532,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 623,
      "end": 666,
      "text": "وبنحوِ الذي قُلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s006",
      "start": 670,
      "end": 685,
      "text": "ذكر مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s007",
      "start": 689,
      "end": 718,
      "text": "حدَّثنا محمدُ بنُ بشارٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 689,
          "end": 696,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 718,
      "end": 767,
      "text": " ثنا ابن أبي عَديٍّ، عن عوفٍ، عن الحسنِ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 739,
          "end": 767,
          "stripped": "عن عوف، عن الحسن في قوله:",
          "span_id": "s008"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 751,
          "end": 756,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 767,
      "end": 812,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 768,
          "end": 805,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 812,
      "end": 920,
      "text": " قال: إن اللَّهَ كان مُطْعِمَ هذه الأمةِ الغنيمةَ، وإنهم أَخَذوا الفداءَ من أُسارى بدرٍ قبلَ أن يُؤمَروا به.",
      "markers": []
    },
    {
      "id": "s011",
      "start": 920,
      "end": 967,
      "text": " قال فعاب اللَّهُ ذلك عليهم، ثم أحلَّه اللَّهُ ",
      "markers": []
    },
    {
      "id": "s012",
      "start": 1026,
      "end": 1027,
      "text": ".",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1031,
      "end": 1077,
      "text": "حدَّثنا محمدُ بنُ عبدِ اللَّهِ بن بَزيعٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1031,
          "end": 1038,
          "span_id": "s013"
        }
      ]
    },
    {
      "id": "s014",
      "start": 1077,
      "end": 1136,
      "text": " ثنا بشرُ بنُ المفضلِ، عن عَوفٍ، عن الحسنِ في قولِ اللَّهِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1100,
          "end": 1136,
          "stripped": "عن عوف، عن الحسن في قول الله:",
          "span_id": "s014"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "NARRATOR",
          "start": 1113,
          "end": 1118,
          "span_id": "s014"
        }
      ]
    },
    {
      "id": "s015",
      "start": 1136,
      "end": 1335,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ} الآية، وذلك يومَ بدرٍ، أَخَذَ أصحابُ النبيِّ - صلى الله عليه وسلم - المغانمَ والأُسارى قبلَ أن يُؤمَروا به، وكان اللَّهُ، تبارك وتعالى، قد كتَب في أمِّ الكتابِ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1137,
          "end": 1174,
          "span_id": "s015"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 1187,
          "end": 1195,
          "span_id": "s015"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1222,
          "end": 1240,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1335,
      "end": 1375,
      "text": " المغانمُ والأُسارى حلالٌ لمحمدٍ وأمتِه.",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1375,
      "end": 1486,
      "text": " ولم يكنْ أحَلَّه لأمةٍ قبلَهم، فأَخذوا المغانَم، وأَسَروا الأُسارى قبلَ أن يُنزَّلَ إليهم في ذلك، قال اللَّهُ:",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1486,
      "end": 1525,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1487,
          "end": 1524,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 1525,
      "end": 1630,
      "text": " يعنى: في الكتابِ الأولِ أن المغانمَ والأُسارى حلالٌ لكم {لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1582,
          "end": 1629,
          "span_id": "s019"
        }
      ]
    },
    {
      "id": "s020",
      "start": 1634,
      "end": 1662,
      "text": "حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s021",
      "start": 1662,
      "end": 1728,
      "text": " ثنى أبي، قال ثني عمِّي، قال ثني أبي، عن أبيه، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1700,
          "end": 1728,
          "stripped": "عن أبيه، عن ابن عباس قوله:",
          "span_id": "s021"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 1712,
          "end": 1720,
          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 1728,
      "end": 2289,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ} الآية، وكانت الغنائمُ قبلَ أن يُبْعَثَ النبيُّ - صلى الله عليه وسلم - في الأممِ إذا أصابوا مَغْنمًا جَعَلوه للقربانِ، وحرَّمَ اللَّهُ عليهم أن يأكُلوا منه قليلًا أو كثيرًا، حُرِّمَ ذلك على كلِّ نبيٍّ وعلى أمته، فكانوا لا يأكلون منه، ولا يَغُلُّون منه، ولا يأخُذون منه قليلًا ولا كثيرًا إلا عَذَّبَهم اللَّهُ عليه، وكان اللَّهُ حرَّمَه عليهم تحريمًا شديدًا، فلم يُحِلُّه لنبيٍّ إلا لمحمدٍ - صلى الله عليه وسلم -، وكان قد سبَق من الله في قضائِه أن المغنمَ له ولأمتِه حلالٌ، فذلك قولُه يومَ بدرٍ، في أخذِ الفداءِ من الأُسارى:",

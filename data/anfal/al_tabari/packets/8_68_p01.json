          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 2576,
          "end": 2581,
          "span_id": "s026"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2584,
          "end": 2621,
          "span_id": "s026"
        }
      ]
    },
    {
      "id": "s027",
      "start": 2622,
      "end": 2718,
      "text": " قال: إن اللَّهَ كان مُعْطِىَ هذه الأمةِ الغنيمةَ، وفعَلوا الذي فَعَلوا قبل أن تَحِلَّ الغنيمةُ ",
      "markers": []
    },
    {
      "id": "s028",
      "start": 2782,
      "end": 2783,
      "text": ".",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2787,
      "end": 2822,
      "text": "حدَّثنا محمدُ بنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2787,
          "end": 2794,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 2822,
      "end": 2858,
      "text": " ثنا محمدُ بنُ ثورٍ، عن مَعمرٍ، قال:",
      "markers": []
    },
    {
      "id": "s031",
      "start": 2858,
      "end": 2955,
      "text": " قال الأعمشُ في قولِه: {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ}، سبَق من الله أن أحلَّ لهم الغنيمةَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2881,
          "end": 2918,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 3001,
      "end": 3002,
      "text": ".",
      "markers": []
    },
    {
      "id": "s033",
      "start": 3006,
      "end": 3095,
      "text": "حدَّثنا أبو كريبٍ، قال: ثنا محمدُ بنُ عبدِ الرحمنِ بن أبي ليلى، عن بشيرِ بن مَيمونٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3006,
          "end": 3013,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 3095,
      "end": 3138,
      "text": " سمعتُ سعيدًا يُحدِّثُ، عن أبي هريرةَ، قال:",
      "markers": []
    },
    {
      "id": "s035",
      "start": 3138,
      "end": 3239,
      "text": " قرأ هذه الآيةَ: {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ}.",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 3139,
          "end": 3142,
          "span_id": "s035"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3155,
          "end": 3238,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 3239,
      "end": 3348,
      "text": " قال: يعنى: لولا أنه سبَقَ في عِلْمى أنى سأُحِلَّ الغنائمَ، لَمَسَّكم فيما أَخَذْتُم من الأُسارى عذابٌ عظيمٌ ",
      "markers": []
    },
    {
      "id": "s037",
      "start": 3513,
      "end": 3514,
      "text": ".",
      "markers": []
    },
    {
      "id": "s038",
      "start": 3518,
      "end": 3628,
      "text": "حدَّثنا أبو كريبٍ، قال: ثنا جابرُ بنُ نوحٍ وأبو مُعاويةَ بنحوِه، عن الأعمشِ، عن أبي صالحٍ، عن أبي هريرةَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3518,
          "end": 3525,
          "span_id": "s038"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3583,
          "end": 3628,
          "stripped": "عن الأعمش، عن أبي صالح، عن أبي هريرة، قال:",
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 3628,
      "end": 3670,
      "text": " قال رسولُ اللَّهِ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 3629,
          "end": 3645,
          "span_id": "s039"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3649,
          "end": 3667,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3670,
      "end": 3754,
      "text": " \"ما أَحلَّتِ الغنائمُ لأحدٍ سُود الرءوسِ من قَبْلِكم، كانت تَنْزلُ نارٌ من السماءِ ",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3765,
      "end": 3766,
      "text": " ",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3786,
      "end": 3850,
      "text": " \". حتى كان يومُ بدرٍ، فوقَع الناسُ في الغنائمِ، فأنزلَ اللَّهُ:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 3798,
          "end": 3806,
          "span_id": "s042"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 3835,
          "end": 3840,
          "span_id": "s042"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 3835,
          "end": 3848,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3850,
      "end": 3931,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ} حتى بلغَ: {حَلَالًا طَيِّبًا} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3851,
          "end": 3900,
          "span_id": "s043"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3911,
          "end": 3930,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 4406,
      "end": 4407,
      "text": ".",
      "markers": []
    },
    {
      "id": "s045",
      "start": 4411,
      "end": 4538,
      "text": "حدَّثنا ابن وكيعٍ، قال: ثنا أبو معاويةَ، عن الأعمشِ، عن أبي صالحٍ، عن أبي هريرةَ، عن النبيِّ - صلى الله عليه وسلم - بنحوه، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4411,
          "end": 4418,
          "span_id": "s045"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4452,
          "end": 4501,
          "stripped": "عن الأعمش، عن أبي صالح، عن أبي هريرة، عن النبي",
          "span_id": "s045"
        },
        {
          "family": "HADITH",
          "marker": "النبي",
          "role": "SPEAKER",
          "start": 4496,
          "end": 4501,
          "span_id": "s045"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4506,
          "end": 4524,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 4538,
      "end": 4582,
      "text": " فلما كان يومُ بدرٍ أسرع الناسُ في الغنائمِ.",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4548,
          "end": 4556,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 4586,
      "end": 4681,
      "text": "حدَّثنا أبو كريبٍ، قال: ثنا ابن فُضَيلٍ، عن أشعثَ بن سَوَّارٍ، عن ابن سيرينَ، عن عَبِيدةَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4586,
          "end": 4593,
          "span_id": "s047"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4627,
          "end": 4676,
          "stripped": "عن أشعث بن سوار، عن ابن سيرين، عن عبيدة،",
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 4681,
      "end": 4770,
      "text": " أَسَر المسلمون من المشركين سبعين، وقَتَلوا سبعين، فقال رسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 4733,
          "end": 4746,
          "span_id": "s048"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4749,
          "end": 4767,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 4770,
      "end": 4885,
      "text": " \"اختاروا أن تأخُذُوا منهم الفداءَ فتقَووا بهِ على عَدُوَّكُم، وإن قَبِلْتُموُه قُتِلَ منكم سبعونَ، أو تَقْتُلوهم\".",
      "markers": []
    },
    {
      "id": "s050",
      "start": 4885,
      "end": 4917,
      "text": " فقالوا: بل نأخذُ الفِديةَ منهم.",
      "markers": []
    },
    {
      "id": "s051",
      "start": 4917,
      "end": 4978,
      "text": " وقُتِل منهم سبعون. قال عَبيدةُ: وطَلَبوا الخِيَرتين كلتيهما ",
      "markers": []
    },
    {
      "id": "s052",
      "start": 5117,
      "end": 5118,
      "text": ".",
      "markers": []
    },
    {
      "id": "s053",
      "start": 5122,
      "end": 5205,
      "text": "حدَّثنا أبو كُرَيبٍ، قال: ثنا ابن فُضيلٍ، عن أشعثَ، عن ابن سيرينَ، عن عَبيدةَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5122,
          "end": 5129,
          "span_id": "s053"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5164,
          "end": 5205,
          "stripped": "عن أشعث، عن ابن سيرين، عن عبيدة، قال:",
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 5205,
      "end": 5301,
      "text": " كان فِداءُ أُسارى بدرٍ مائةَ أوقيَّةٍ، والأوقيَّةُ أربعون درهمًا، ومن الدنانيرِ ستَّةُ دنانيرَ.",
      "markers": []
    },
    {
      "id": "s055",
      "start": 5305,
      "end": 5351,
      "text": "حدَّثنا أبو كُريبٍ ويعقوبُ بنُ إبراهيمَ، قالا:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5305,
          "end": 5312,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 5351,
      "end": 5437,
      "text": " ثنا ابن عُليَّةَ، قال: ثنا ابن عونٍ، عن ابن سيرينَ، عن عبيدةَ، أنه قال في أسارى بدرٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5389,
          "end": 5425,
          "stripped": "عن ابن سيرين، عن عبيدة، أنه قال في",
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 5437,
      "end": 5479,
      "text": " قال رسولُ اللَّهِ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 5438,
          "end": 5454,
          "span_id": "s057"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5458,
          "end": 5476,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 5479,
      "end": 5554,
      "text": " \"إن شئتم قَتَلتُموهُم، وإن شِئتم فاديتمُوهُم واستُشهِدَ منكُم بِعِدَّتهم\".",
      "markers": []
    },
    {
      "id": "s059",
      "start": 5554,
      "end": 5592,
      "text": " فقالوا: بلى، نأخُذُ الفداءَ فنستمتعُ ",
      "markers": []
    },
    {
      "id": "s060",
      "start": 5610,
      "end": 5639,
      "text": " به ويُستَشهدُ منا بعدَّتِهم ",
      "markers": []
    },
    {
      "id": "s061",
      "start": 5739,
      "end": 5740,
      "text": ".",
      "markers": []
    },
    {
      "id": "s062",
      "start": 5744,
      "end": 5784,
      "text": "حدَّثني أحمدُ بنُ محمدٍ الطُّوسيُّ، قال:",
      "markers": []
    },
    {
      "id": "s063",
      "start": 5784,
      "end": 5825,
      "text": " ثنا عبدُ الصَّمدِ بنُ عبدِ الوارثِ، قال:",
      "markers": []
    },
    {
      "id": "s064",
      "start": 5825,
      "end": 5921,
      "text": " ثنَا هَمَّامُ بنُ يحيى، قال ثنا عطاءُ بنُ السائبِ، عن أبي وائلٍ، عن عبدِ اللَّهِ بن سعودٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5877,
          "end": 5916,
          "stripped": "عن أبي وائل، عن عبد الله بن سعود،",
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 5921,
      "end": 5980,
      "text": " أمَر عمرُ، رضيَ الله عنه، بقَتْلِ الأُسارى، فأنزل اللَّهُ:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 5966,
          "end": 5971,
          "span_id": "s065"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 5966,
          "end": 5978,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 5980,
      "end": 6065,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5981,
          "end": 6064,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 6069,
      "end": 6106,
      "text": "حُدِّثْتُ عن الحسينِ بن الفَرجِ، قال:",
      "markers": []
    },
    {
      "id": "s068",
      "start": 6106,
      "end": 6156,
      "text": " سمعتُ أبا معاذٍ، قال: ثنا عبيدُ بنُ سليمانَ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 6117,
          "end": 6121,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 6156,
      "end": 6186,
      "text": " سمعتُ الضحاكَ يقولُ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 6163,
          "end": 6169,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 6186,
      "end": 6225,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6187,
          "end": 6224,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 6225,
      "end": 6436,
      "text": " قال: كان المَغْنَم مُحرَّمًا على كلِّ نبيٍّ وأُمَّتِه، وكانوا إذا غَنِموا يَجْعَلون المغنم للَّهِ قُربانًا تأكُلُه النارُ، وكان سَبَقَ في قضاءِ اللَّهِ وعلمِه أن يُحِلَّ المغنمَ لهذه الأمةِ يأكلُونه في بطونِهم.",
      "markers": []
    },
    {
      "id": "s072",
      "start": 6440,
      "end": 6503,
      "text": "حدَّثنا ابن حُميدٍ، قال: ثنا جَرِيرٌ، عن عطاءٍ في قولِ اللَّهِ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6440,
          "end": 6447,
          "span_id": "s072"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "NARRATOR",
          "start": 6481,
          "end": 6485,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 6503,
      "end": 6588,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6504,
          "end": 6587,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 6588,
      "end": 6644,
      "text": " قال: كان في علمِ اللَّهِ أن تَحِلَّ لهم الغنائمُ، فقال:",
      "markers": []
    },
    {
      "id": "s075",
      "start": 6644,
      "end": 6755,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ} بأنه أحلَّ لكم الغنائمَ {لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6645,
          "end": 6682,
          "span_id": "s075"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6707,
          "end": 6754,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 6800,
      "end": 6801,
      "text": ".",
      "markers": []
    },
    {
      "id": "s077",
      "start": 6805,
      "end": 6905,
      "text": "وقال آخرون: معنى ذلك: لولا كتابٌ من اللَّهِ سبَق لأهلِ بدرٍ ألَّا يُعَذِّبَهم: لمَسَّهم عذابٌ عظيمٌ.",
      "markers": []
    },
    {
      "id": "s078",
      "start": 6909,
      "end": 6924,
      "text": "ذكر مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s079",
      "start": 6928,
      "end": 7011,
      "text": "حدَّثنا ابن وكيعٍ، قال: حدَّثنا أبو أحمدَ الزُّبيريُّ، عن شريكٍ، عن سالمٍ، عن سعيد:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6928,
          "end": 6935,
          "span_id": "s079"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 6928,
          "end": 6982,
          "stripped": "حدثنا ابن وكيع، قال: حدثنا أبو أحمد الزبيري،",
          "span_id": "s079"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6952,
          "end": 6959,
          "span_id": "s079"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6983,
          "end": 7011,
          "stripped": "عن شريك، عن سالم، عن سعيد:",
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 7011,
      "end": 7050,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7012,
          "end": 7049,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 7050,
      "end": 7080,
      "text": " قال: لأهلِ بدرٍ مِن السعادةِ ",
      "markers": []
    },
    {
      "id": "s082",
      "start": 7135,
      "end": 7136,
      "text": ".",
      "markers": []
    },
    {
      "id": "s083",
      "start": 7140,
      "end": 7221,
      "text": "حدَّثنا ابن وكيعٍ قال: ثنا ابن نُمِيرٍ، عن وَرقاءَ، عن ابن أبي نَجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7140,
          "end": 7147,
          "span_id": "s083"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7180,
          "end": 7213,
          "stripped": "عن ورقاء، عن ابن أبي نجيح، عن",
          "span_id": "s083"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 7214,
          "end": 7219,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 7221,
      "end": 7281,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ} لأهلِ بدرٍ مَشْهدَهم ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7222,
          "end": 7259,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 7301,
      "end": 7302,
      "text": ".",
      "markers": []
    },
    {
      "id": "s086",
      "start": 7306,
      "end": 7341,
      "text": "حدَّثنا محمدُ بنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7306,
          "end": 7313,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 7341,
      "end": 7383,
      "text": " ثنا محمدُ بنُ ثورٍ، عن مَعمرٍ، عن الحسنِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7362,
          "end": 7383,
          "stripped": "عن معمر، عن الحسن:",
          "span_id": "s087"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 7376,
          "end": 7381,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 7383,
      "end": 7422,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7384,
          "end": 7421,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 7422,
      "end": 7462,
      "text": " قال: سَبَقَ من اللَّهِ خيرٌ لأهلِ بدرٍ ",
      "markers": []
    },
    {
      "id": "s090",
      "start": 7509,
      "end": 7510,
      "text": ".",
      "markers": []
    },
    {
      "id": "s091",
      "start": 7514,
      "end": 7548,
      "text": "حدَّثنا بشرٌ، قال: ثنا يزيدُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7514,
          "end": 7521,
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 7548,
      "end": 7576,
      "text": " ثنا سعيدٌ، عن قتادةَ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 7563,
          "end": 7568,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 7576,
      "end": 7661,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7577,
          "end": 7660,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 7661,
      "end": 7714,
      "text": " كان سبَق لهم من اللَّهِ خيرٌ، وأَحَلَّ لهم الغنائمَ ",
      "markers": []
    },
    {
      "id": "s095",
      "start": 7759,
      "end": 7760,
      "text": ".",
      "markers": []
    },
    {
      "id": "s096",
      "start": 7764,
      "end": 7808,
      "text": "حدَّثني الحارثُ، قال: ثنا عبدُ العزيزِ، قال:",
      "markers": []
    },
    {
      "id": "s097",
      "start": 7808,
      "end": 7867,
      "text": " ثنا عبدُ الوارثِ بنُ سعيدٍ، عن عمرِو بن عُبيدٍ، عن الحسنِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7837,
          "end": 7867,
          "stripped": "عن عمرو بن عبيد، عن الحسن:",
          "span_id": "s097"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 7860,
          "end": 7865,
          "span_id": "s097"
        }
      ]
    },
    {
      "id": "s098",
      "start": 7867,
      "end": 7906,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7868,
          "end": 7905,
          "span_id": "s098"
        }
      ]
    },
    {
      "id": "s099",
      "start": 7906,
      "end": 7951,
      "text": " قال: سبَق أن لا يُعذِّبَ أحدًا من أهلِ بدرٍ ",
      "markers": []
    },
    {
      "id": "s100",
      "start": 7996,
      "end": 7997,
      "text": ".",
      "markers": []
    },
    {
      "id": "s101",
      "start": 8001,
      "end": 8030,
      "text": "حدَّثنا محمدُ بنُ عمرٍو، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8001,
          "end": 8008,
          "span_id": "s101"
        }
      ]
    },
    {
      "id": "s102",
      "start": 8030,
      "end": 8089,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابن أبي نجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 8061,
          "end": 8089,
          "stripped": "عن ابن أبي نجيح، عن مجاهد:",
          "span_id": "s102"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 8082,
          "end": 8087,
          "span_id": "s102"
        }
      ]
    },
    {
      "id": "s103",
      "start": 8089,
      "end": 8156,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ}. لأهلِ بدرٍ ومشهدَهم إيَّاه.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8090,
          "end": 8127,
          "span_id": "s103"
        }
      ]
    },
    {
      "id": "s104",
      "start": 8160,
      "end": 8202,
      "text": "حدَّثني يونسُ، قال: أخبرَنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 8180,
          "end": 8187,
          "span_id": "s104"
        }
      ]
    },
    {
      "id": "s105",
      "start": 8202,
      "end": 8225,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 8207,
          "end": 8214,
          "span_id": "s105"
        }
      ]
    },
    {
      "id": "s106",
      "start": 8225,
      "end": 8310,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8226,
          "end": 8309,
          "span_id": "s106"
        }
      ]
    },
    {
      "id": "s107",
      "start": 8310,
      "end": 8374,
      "text": " لمسَّكم فيما أخذتُم من الغنائم يومَ بدرٍ قبلَ أن أُحِلَّها لكم.",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 8342,
          "end": 8350,
          "span_id": "s107"
        }
      ]
    },
    {
      "id": "s108",
      "start": 8374,
      "end": 8456,
      "text": " فقال: سبَق من اللَّهِ العَفْوُ عنهم، والرحمةُ لهم، سبَق أنه لا يُعذِّبُ المؤمنين؛",
      "markers": []
    },
    {
      "id": "s109",
      "start": 8456,
      "end": 8512,
      "text": " لأنه لا يعذِّبُ رسولَه، ومن آمن به، وهاجَر معه ونَصَره ",
      "markers": []
    },
    {
      "id": "s110",
      "start": 8581,
      "end": 8582,
      "text": ".",
      "markers": []
    }
  ],

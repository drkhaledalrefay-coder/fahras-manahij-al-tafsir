    {
      "id": "s029",
      "start": 2986,
      "end": 3193,
      "text": " {الْآنَ خَفَّفَ اللَّهُ عَنْكُمْ وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا فَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ صَابِرَةٌ يَغْلِبُوا مِائَتَيْنِ}، فَعَبَّأ لكلِّ رجلٍ مِن المسلمين رجلين مِن المشركين، فنسَخ الأمرَ الأَوَّلَ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2987,
          "end": 3115,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 3193,
      "end": 3220,
      "text": " وقال مرَّةً أخرى في قولِه:",
      "markers": []
    },
    {
      "id": "s031",
      "start": 3220,
      "end": 3288,
      "text": " {إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ يَغْلِبُوا مِائَتَيْنِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3221,
          "end": 3287,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 3288,
      "end": 3403,
      "text": " فأمَر اللَّهُ الرجلَ مِن المؤمنين أن يُقاتِلَ عشرةً مِن الكفارِ، فَشَقَّ ذلك على المؤمنين، ورَحِمَهم اللَّهُ فقال:",
      "markers": []
    },
    {
      "id": "s033",
      "start": 3403,
      "end": 3568,
      "text": " {فَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ صَابِرَةٌ يَغْلِبُوا مِائَتَيْنِ وَإِنْ يَكُنْ مِنْكُمْ أَلْفٌ يَغْلِبُوا أَلْفَيْنِ بِإِذْنِ اللَّهِ وَاللَّهُ مَعَ الصَّابِرِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3404,
          "end": 3567,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 3568,
      "end": 3632,
      "text": " فأمرَ اللَّهُ الرجلَ مِن المؤمنين أن يُقاتِلَ رجلين مِن الكفار.",
      "markers": []
    },
    {
      "id": "s035",
      "start": 3636,
      "end": 3664,
      "text": "حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s036",
      "start": 3664,
      "end": 3692,
      "text": " ثنى أبي، قال: ثنى عمي، قال:",
      "markers": []
    },
    {
      "id": "s037",
      "start": 3692,
      "end": 3730,
      "text": " ثنى أبي، عن أبيه، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3702,
          "end": 3730,
          "stripped": "عن أبيه، عن ابن عباس قوله:",
          "span_id": "s037"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 3714,
          "end": 3722,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 3730,
      "end": 3807,
      "text": " {يَاأَيُّهَا النَّبِيُّ حَرِّضِ الْمُؤْمِنِينَ عَلَى الْقِتَالِ}، إلى قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3731,
          "end": 3795,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 3807,
      "end": 3925,
      "text": " {بِأَنَّهُمْ قَوْمٌ لَا يَفْقَهُونَ}: وذلك أنه كان جعَل على كلِّ رجلٍ من المسلمين عشرةً من العدوِّ يُؤشِّبُهم - يعنى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3808,
          "end": 3844,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3925,
      "end": 3975,
      "text": " يُغْرِيهم - بذلك، ليُوَطِّنوا أنفسَهم على الغزوِ ",
      "markers": []
    },
    {
      "id": "s041",
      "start": 4020,
      "end": 4179,
      "text": "، وأن اللَّهَ ناصِرُهم على العدوِّ، ولم يكنْ أمرًا عَزَمَه اللَّهُ عليهم ولا أوجَبَه، ولكن كان تَحْريضًا ووصيةً أمَرَ اللَّهُ بها نبيَّه، ثم خَفَّفَ عنهم فقال:",
      "markers": []
    },
    {
      "id": "s042",
      "start": 4179,
      "end": 4290,
      "text": " {الْآنَ خَفَّفَ اللَّهُ عَنْكُمْ وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا}، فجَعَل على كلِّ رجلٍ رجلين بعدَ ذلك تخفيفًا؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4180,
          "end": 4244,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 4290,
      "end": 4363,
      "text": " ليعلمَ المؤمنون أن اللَّهَ بهم رحيمٌ، فَتَوَكَّلوا على اللَّهِ، وصبَروا ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 4380,
      "end": 4390,
      "text": " وصَدَقوا ",
      "markers": []
    },
    {
      "id": "s045",
      "start": 4407,
      "end": 4439,
      "text": ". ولو كان عليهم واجبًا، كفَّروا ",
      "markers": []
    },
    {
      "id": "s046",
      "start": 4455,
      "end": 4467,
      "text": " إذنْ: كلُّ ",
      "markers": []
    },
    {
      "id": "s047",
      "start": 4486,
      "end": 4505,
      "text": " رجلٍ مِن المسلمين ",
      "markers": []
    },
    {
      "id": "s048",
      "start": 4511,
      "end": 4512,
      "text": " ",
      "markers": []
    },
    {
      "id": "s049",
      "start": 4580,
      "end": 4606,
      "text": " عمن لَقِىَ مِن الكفار إذ ",
      "markers": []
    },
    {
      "id": "s050",
      "start": 4634,
      "end": 4660,
      "text": " كانوا أكثرَ منهم فلم يُقا",
      "markers": []
    },
    {
      "id": "s051",
      "start": 4664,
      "end": 4730,
      "text": "تِلوهم، فلا يَغُرَّنَّك قولُ رجالٍ، فإني قد سَمِعتُ رجالًا يقولون:",
      "markers": []
    },
    {
      "id": "s052",
      "start": 4730,
      "end": 5051,
      "text": " إنه لا يَصلُحُ لرجلٍ من المسلمين أن يُقاتِلَ حتى يكونَ على كلِّ رجلٍ رجلان، وحتى يكونَ على كلِّ رجلين أربعةٌ، ثم بحسابِ ذلك، وزَعَموا أنهم يَعْصُون اللَّهَ إن قاتلوا حتى يَبْلُغوا عِدَّةَ ذلك، وأنه لا حَرَج عليهم أن لا يُقاتِلوا حتى يَبْلُغوا عدَّةَ أن يكونَ على كلِّ رجلٍ رجلان، وعلى كلِّ رجلين أربعةٌ، وقد قال اللَّهُ:",
      "markers": []
    },
    {
      "id": "s053",
      "start": 5051,
      "end": 5152,
      "text": " {وَمِنَ النَّاسِ مَنْ يَشْرِي نَفْسَهُ ابْتِغَاءَ مَرْضَاتِ اللَّهِ وَاللَّهُ رَءُوفٌ بِالْعِبَادِ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5052,
          "end": 5151,
          "span_id": "s053"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 5152,
          "end": 5165,
          "text": "[البقرة: 207]",
          "via": "apparatus",
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 5165,
      "end": 5265,
      "text": "، وقال الله: {فَقَاتِلْ فِي سَبِيلِ اللَّهِ لَا تُكَلَّفُ إِلَّا نَفْسَكَ وَحَرِّضِ الْمُؤْمِنِينَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5178,
          "end": 5264,
          "span_id": "s054"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 5265,
          "end": 5277,
          "text": "[النساء: 84]",
          "via": "apparatus",
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 5277,
      "end": 5340,
      "text": "، فهو التحريضُ الذي أنزلَ الله عليهم في \"الأنفال\"، فلا تعجزنَّ ",
      "markers": []
    },
    {
      "id": "s056",
      "start": 5358,
      "end": 5366,
      "text": "، قاتلْ ",
      "markers": []
    },
    {
      "id": "s057",
      "start": 5383,
      "end": 5442,
      "text": "، قد سَقَطتَ بينَ ظَهْرَى أَناسٍ كما شاء اللَّهُ أن يكونوا.",
      "markers": []
    },
    {
      "id": "s058",
      "start": 5446,
      "end": 5501,
      "text": "حدَّثنا ابن حميدٍ، قال: ثنا يحيى بنُ واضحٍ، عن الحسينِ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5446,
          "end": 5453,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 5564,
      "end": 5600,
      "text": "، عن يزيدَ، عن عكرمةَ والحسنِ، قالا:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5566,
          "end": 5600,
          "stripped": "عن يزيد، عن عكرمة والحسن، قالا:",
          "span_id": "s059"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 5579,
          "end": 5584,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 5600,
      "end": 5814,
      "text": " قال في \"سورة الأنفال\": {إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ يَغْلِبُوا مِائَتَيْنِ وَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ يَغْلِبُوا أَلْفًا مِنَ الَّذِينَ كَفَرُوا بِأَنَّهُمْ قَوْمٌ لَا يَفْقَهُونَ}، ثم نسَخ فقال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5624,
          "end": 5799,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 5814,
      "end": 5923,
      "text": " {الْآنَ خَفَّفَ اللَّهُ عَنْكُمْ وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا}، إلى قولِه: {وَاللَّهُ مَعَ الصَّابِرِينَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5815,
          "end": 5879,
          "span_id": "s061"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5892,
          "end": 5922,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 6072,
      "end": 6073,
      "text": ".",
      "markers": []
    },
    {
      "id": "s063",
      "start": 6077,
      "end": 6140,
      "text": "حدَّثنا ابن حميدٍ، قال: ثنا جريرٌ، عن مُغيرةً، عن عكرمةَ قولَه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6077,
          "end": 6084,
          "span_id": "s063"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6112,
          "end": 6140,
          "stripped": "عن مغيرة، عن عكرمة قوله:",
          "span_id": "s063"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 6127,
          "end": 6132,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 6140,
      "end": 6185,
      "text": " {إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6141,
          "end": 6184,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 6185,
      "end": 6289,
      "text": " قال: واحدٌ من المسلمين وعَشَرةٌ من المشركين، ثم خَفَّفَ عنهم، فجعَل عليهم أن لا يَفِرَّ رجلٌ مِن رجلين ",
      "markers": []
    },
    {
      "id": "s066",
      "start": 6334,
      "end": 6335,
      "text": ".",
      "markers": []
    },
    {
      "id": "s067",
      "start": 6339,
      "end": 6368,
      "text": "حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s068",
      "start": 6368,
      "end": 6432,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابن أبي نجيحٍ، عن مجاهدٍ قوله:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6399,
          "end": 6432,
          "stripped": "عن ابن أبي نجيح، عن مجاهد قوله:",
          "span_id": "s068"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 6420,
          "end": 6425,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 6432,
      "end": 6488,
      "text": " {إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ}، إلى قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6433,
          "end": 6476,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 6488,
      "end": 6532,
      "text": " {وَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ}. قال: هذا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6489,
          "end": 6521,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 6546,
      "end": 6621,
      "text": " لأصحابِ محمدٍ - صلى الله عليه وسلم - يومَ بدرٍ، جعَل على الرجل منهم قتالَ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6563,
          "end": 6581,
          "span_id": "s071"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 6584,
          "end": 6592,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 6636,
      "end": 6697,
      "text": " عشرةٍ مِن الكفارِ، فضجُّوا مِن ذلك، فجَعَل على الرجلِ قتالَ ",
      "markers": []
    },
    {
      "id": "s073",
      "start": 6709,
      "end": 6739,
      "text": " رجلين، تَخْفيفًا مِن اللَّهِ ",
      "markers": []
    },
    {
      "id": "s074",
      "start": 6811,
      "end": 6812,
      "text": ".",
      "markers": []
    },
    {
      "id": "s075",
      "start": 6816,
      "end": 6846,
      "text": "حدَّثنا أحمدُ بنُ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6816,
          "end": 6823,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 6846,
      "end": 6883,
      "text": " ثنا أبو أحمدَ، قال ثنا إبراهيمُ بنُ ",
      "markers": []
    },
    {
      "id": "s077",
      "start": 6898,
      "end": 6955,
      "text": " يزيدَ، عن عمرِو بن دينارٍ وأبي معبدٍ، عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6940,
          "end": 6948,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 6955,
      "end": 7145,
      "text": " إنما أُمِر الرجلُ أن يُصَبِّرَ نفسَه لعشرةٍ، والعشرةُ لمائةٍ، إذ المسلمون قليلٌ، فلما كثُر المسلمون خفَّف اللَّهُ عنهم، فأمَر الرجلَ أن يَصْبِرَ لرجلين، والعشرةَ للعشرين، والمائةَ المائتين.",
      "markers": []
    },
    {
      "id": "s079",
      "start": 7149,
      "end": 7184,
      "text": "حدَّثنا محمدُ بنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7149,
          "end": 7156,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 7184,
      "end": 7232,
      "text": " ثنا محمدُ بنُ ثورٍ، عن معمرٍ، عن ابن أبي نجيحٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7205,
          "end": 7232,
          "stripped": "عن معمر، عن ابن أبي نجيح:",
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 7232,
      "end": 7300,
      "text": " {إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ يَغْلِبُوا مِائَتَيْنِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7233,
          "end": 7299,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 7300,
      "end": 7425,
      "text": " قال: كان فُرِضَ عليهم إذا لَقِىَ عشرون مائتين أن لا يَفِرُّوا، فإنهم إن لم يَفِرُّوا غَلَبُوا، ثم خَفَّفَ اللَّهُ عنهم وقال:",
      "markers": []
    },
    {
      "id": "s083",
      "start": 7425,
      "end": 7552,
      "text": " {فَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ صَابِرَةٌ يَغْلِبُوا مِائَتَيْنِ وَإِنْ يَكُنْ مِنْكُمْ أَلْفٌ يَغْلِبُوا أَلْفَيْنِ}، فيقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7426,
          "end": 7543,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 7552,
      "end": 7619,
      "text": " لا ينبغى أن يَفِرَّ ألفٌ من ألفين، فإنهم إن صَبَروا لهم غَلَبُوهم.",
      "markers": []
    },
    {
      "id": "s085",
      "start": 7623,
      "end": 7657,
      "text": "حدَّثنا بشرٌ، قال: ثنا يزيدُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7623,
          "end": 7630,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 7657,
      "end": 7685,
      "text": " ثنا سعيدٌ، عن قتادةَ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 7672,
          "end": 7677,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 7685,
      "end": 7867,
      "text": " {الْآنَ خَفَّفَ اللَّهُ عَنْكُمْ وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا فَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ صَابِرَةٌ يَغْلِبُوا مِائَتَيْنِ وَإِنْ يَكُنْ مِنْكُمْ أَلْفٌ يَغْلِبُوا أَلْفَيْنِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7686,
          "end": 7866,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 7867,
      "end": 7936,
      "text": " جَعَلَ اللَّهُ على كلِّ رجلٍ رجلين، بعدَ ما كان على كلِّ رجلٍ عشرةٌ.",
      "markers": []
    },
    {
      "id": "s089",
      "start": 7936,
      "end": 7963,
      "text": " وهذا الحديثُ عن ابن عباسٍ ",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 7953,
          "end": 7961,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 8027,
      "end": 8028,
      "text": ".",
      "markers": []
    },
    {
      "id": "s091",
      "start": 8032,
      "end": 8108,
      "text": "حدَّثنا ابن وكيعٍ، قال: ثنا يزيدُ بنُ هارونَ، عن جريرِ بن حازمٍ، عن الزبيرِ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8032,
          "end": 8039,
          "span_id": "s091"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 8078,
          "end": 8106,
          "stripped": "عن جرير بن حازم، عن الزبير",
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 8122,
      "end": 8123,
      "text": " ",
      "markers": []
    },
    {
      "id": "s093",
      "start": 8147,
      "end": 8173,
      "text": "، عن عكرمةَ، عن ابن عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 8149,
          "end": 8173,
          "stripped": "عن عكرمة، عن ابن عباس:",
          "span_id": "s093"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 8152,
          "end": 8157,
          "span_id": "s093"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 8163,
          "end": 8171,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 8173,
      "end": 8240,
      "text": " كان فُرِضَ على المؤمنين أن يُقاتِلَ الرجلُ منهم عشرةً من المشركين؛",
      "markers": []
    },
    {
      "id": "s095",
      "start": 8240,
      "end": 8365,
      "text": " قولُه: {إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ يَغْلِبُوا مِائَتَيْنِ وَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ يَغْلِبُوا أَلْفًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8248,
          "end": 8364,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 8365,
      "end": 8455,
      "text": " فشَقَّ ذلك عليهم، فأنزلَ اللَّهُ التخفيفَ، فجَعَلَ على الرجلِ أن يُقاتِلَ الرجلين، قولُه:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 8384,
          "end": 8389,
          "span_id": "s096"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 8384,
          "end": 8397,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 8455,
      "end": 8567,
      "text": " {فَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ صَابِرَةٌ يَغْلِبُوا مِائَتَيْنِ}، فخَفَّفَ اللَّهُ عنهم، ونُقِصوا مِن النّصرِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8456,
          "end": 8521,
          "span_id": "s097"
        }
      ]
    },
    {
      "id": "s098",
      "start": 8600,
      "end": 8613,
      "text": " بقَدْرِ ذلك ",
      "markers": []
    },
    {
      "id": "s099",
      "start": 8852,
      "end": 8853,
      "text": ".",
      "markers": []
    },
    {
      "id": "s100",
      "start": 8857,
      "end": 8888,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s101",
      "start": 8888,
      "end": 8916,
      "text": " ثنا أحمدُ بنُ المفضلِ، قال:",
      "markers": []
    },
    {
      "id": "s102",
      "start": 8916,
      "end": 9007,
      "text": " ثنا أسباطُ، عن السديِّ: {فَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ صَابِرَةٌ يَغْلِبُوا مِائَتَيْنِ}.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 8932,
          "end": 8937,
          "span_id": "s102"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8941,
          "end": 9006,
          "span_id": "s102"
        }
      ]
    },
    {
      "id": "s103",
      "start": 9007,
      "end": 9094,
      "text": " يقولُ: يُقاتِلوا مائتين، فكانوا أضعفَ من ذلك، فنَسَخَها اللَّهُ عنهما، فَخَفَّفَ فقال:",
      "markers": []
    },
    {
      "id": "s104",
      "start": 9094,
      "end": 9161,
      "text": " {فَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ صَابِرَةٌ يَغْلِبُوا مِائَتَيْنِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9095,
          "end": 9160,
          "span_id": "s104"
        }
      ]
    },
    {
      "id": "s105",
      "start": 9161,
      "end": 9195,
      "text": " فجَعَلَ أولَ مرةٍ الرجلَ لعشَرةٍ ",
      "markers": []
    },
    {
      "id": "s106",
      "start": 9225,
      "end": 9251,
      "text": "، ثم جَعَلَ الرجلَ لاثنين.",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s011",
      "start": 899,
      "end": 988,
      "text": "¬تفسير الثوري ص 121، ومن طريقه عبد الرزاق في تفسيره 1/ 262، وابن الجوزي في نواسخه ص 351.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s017",
      "start": 1316,
      "end": 1563,
      "text": "¬أخرجه الشافعي في الأم 4/ 92، وعبد الرزاق في مصنفه (9525)، وسعيد بن منصور في سننه (1000 - تفسير)، والبخاري (4652)، وابن الجارود (1049)، وابن أبي حاتم في تفسيره 5/ 1728، والطبراني (11211)، والبيهقي 9/ 76، وفي الشعب (4001) من طريق عمرو بن دينار به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s023",
      "start": 2214,
      "end": 2717,
      "text": "¬في ف: \"عليهم\". والحديث في سيرة بن هشام 1/ 675، 676، وأخرجه إسحاق بن راهويه - كما في الدر المنثور 3/ 200 - ومن طريقه الطبراني في الأوسط (8107)، وابن مردويه - كما في الدر - ومن طريقه الضياء في المختاره (489) - وابن حبان (4773)، والطبراني (11396) من طريق ابن إسحاق به، وأخرجه ابن المبارك في كتاب الجهاد (235)، وسعيد بن منصور في سننه (1001 - تفسير)، والبيهقى 9/ 76 من طريق ابن أبي <br>نجيح به، وأخرجه ابن أبي حاتم في تفسيره 5/ 1728 من طريق عطاء به، وعزاه السيوطي في الدر المنثور إلى ابن المنذر وأبى الشيخ.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s040",
      "start": 3975,
      "end": 4020,
      "text": "¬في ص، ت 2: \"العزو\"، وفي ت 1، س، ف: \"العدو\".¥",

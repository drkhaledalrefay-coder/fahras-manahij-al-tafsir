  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 68,
      "text": "ثم خَفَّفَ تعالى ذكرُه عن المؤمنين إذ عَلِمَ ضَعْفَهم، فقال لهم:",
      "markers": []
    },
    {
      "id": "s002",
      "start": 68,
      "end": 140,
      "text": " {الْآنَ خَفَّفَ اللَّهُ عَنْكُمْ وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا}، يعنى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 69,
          "end": 133,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 140,
      "end": 374,
      "text": " أن في الواحدِ منهم عن لقاءِ العشرةِ مِن عدوِّهم ضعفًا، {فَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ صَابِرَةٌ} عندَ لقائِهم للثباتِ لهم {يَغْلِبُوا مِائَتَيْنِ} منهم، {وَإِنْ يَكُنْ مِنْكُمْ أَلْفٌ يَغْلِبُوا أَلْفَيْنِ} منهم، {بِإِذْنِ اللَّهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 196,
          "end": 238,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 264,
          "end": 288,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 295,
          "end": 348,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 355,
          "end": 373,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 374,
      "end": 578,
      "text": " يعنى: بتَخْليةِ اللَّهِ إيَّاهم لغَلَبَتِهم، ومَعونته إياهم، {وَاللَّهُ مَعَ الصَّابِرِينَ} لعدوِّهم وعدوِّ اللَّهِ، احتسابًا في صَبْرِه، وطلبًا الجزيلِ الثوابِ مِن ربِّه، بالعَوْنِ منه له، والنصرِ عليه.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 436,
          "end": 466,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 582,
      "end": 623,
      "text": "وبنحوِ ما قُلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s006",
      "start": 627,
      "end": 643,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s007",
      "start": 647,
      "end": 676,
      "text": "حدَّثنا محمدُ بنُ بشارٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 647,
          "end": 654,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 676,
      "end": 706,
      "text": " ثنا محمدُ بنُ مُحَبَّبٍ، قال:",
      "markers": []
    },
    {
      "id": "s009",
      "start": 706,
      "end": 748,
      "text": " ثنا سفيانُ، عن لَيْثٍ، عن عطاءٍ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 719,
          "end": 748,
          "stripped": "عن ليث، عن عطاء في قوله:",
          "span_id": "s009"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 733,
          "end": 737,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 748,
      "end": 816,
      "text": " {إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ يَغْلِبُوا مِائَتَيْنِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 749,
          "end": 815,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 816,
      "end": 899,
      "text": " قال: كان الواحدُ لعشرةٍ، ثم جُعِلَ الواحدُ باثْنين، لا ينبغى له أَن يَفِرَّ منهما ",
      "markers": []
    },
    {
      "id": "s012",
      "start": 988,
      "end": 989,
      "text": ".",
      "markers": []
    },
    {
      "id": "s013",
      "start": 993,
      "end": 1021,
      "text": "حدَّثنا سعيدُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 993,
          "end": 1000,
          "span_id": "s013"
        }
      ]
    },
    {
      "id": "s014",
      "start": 1021,
      "end": 1089,
      "text": " ثنا أبي، قال: ثنا ابن جريجٍ، عن عمرِو بن دينارٍ، عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1051,
          "end": 1089,
          "stripped": "عن عمرو بن دينار، عن ابن عباس، قال:",
          "span_id": "s014"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 1074,
          "end": 1082,
          "span_id": "s014"
        }
      ]
    },
    {
      "id": "s015",
      "start": 1089,
      "end": 1144,
      "text": " جُعِل على المسلمين على الرجلِ عشرةٌ مِن الكفارِ، فقال:",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1144,
      "end": 1256,
      "text": " {إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ يَغْلِبُوا مِائَتَيْنِ} فخُفِّفَ ذلك عنهم، فجُعِلَ على الرجلِ رجلان.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1145,
          "end": 1211,
          "span_id": "s016"
        }
      ]
    },
    {
      "id": "s017",
      "start": 1256,
      "end": 1316,
      "text": " قال ابن عباسٍ: فما أحبُّ أن يعلمَ الناسُ تَخْفيفَ ذلك عنهم ",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 1261,
          "end": 1269,
          "span_id": "s017"
        }
      ]
    },
    {
      "id": "s018",
      "start": 1563,
      "end": 1564,
      "text": ":",
      "markers": []
    },
    {
      "id": "s019",
      "start": 1568,
      "end": 1607,
      "text": "حدَّثنا ابن حميدٍ، قال: ثنا سلمةُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1568,
          "end": 1575,
          "span_id": "s019"
        }
      ]
    },
    {
      "id": "s020",
      "start": 1607,
      "end": 1722,
      "text": " قال محمدُ بنُ إسحاقَ، ثنى عبدُ اللَّهِ بن أبي نجيحٍ المكيُّ، عن عطاءِ بن أبي رباحٍ، عن عبدِ اللَّهِ بن عباسٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1669,
          "end": 1717,
          "stripped": "عن عطاء بن أبي رباح، عن عبد الله بن عباس،",
          "span_id": "s020"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "NARRATOR",
          "start": 1672,
          "end": 1676,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 1722,
      "end": 1871,
      "text": " لمَّا نَزَلت هذه الآيةُ، ثقُلَت على المسلمين، وأعْظَموا أن يُقاتِلَ عشرون مائتين، ومئةٌ ألفًا، فَخَفَّفَ اللَّهُ عنهم، فنَسَخها بالآيةِ الأخرى فقال:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 1749,
          "end": 1754,
          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 1871,
      "end": 2053,
      "text": " {الْآنَ خَفَّفَ اللَّهُ عَنْكُمْ وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا فَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ صَابِرَةٌ يَغْلِبُوا مِائَتَيْنِ وَإِنْ يَكُنْ مِنْكُمْ أَلْفٌ يَغْلِبُوا أَلْفَيْنِ}.",

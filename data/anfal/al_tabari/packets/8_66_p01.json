      "attached_span_id": "s073",
      "start": 6739,
      "end": 6811,
      "text": "¬تفسير مجاهد ص 357، وعزاه السيوطي في الدر المنثور 3/ 201 إلى أبى الشيخ.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s076",
      "start": 6883,

    },
    {
      "id": "s122",
      "start": 10247,
      "end": 10304,
      "text": "وكان ابن إسحاق يقولُ في ذلك ما حدَّثنا به ابن حميدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10278,
          "end": 10285,
          "span_id": "s122"
        }
      ]
    },
    {
      "id": "s123",
      "start": 10304,
      "end": 10332,
      "text": " ثنا سَلَمةُ، عن ابن إسحاقَ:",
      "markers": []
    },
    {
      "id": "s124",
      "start": 10332,
      "end": 10397,
      "text": " {بِأَنَّهُمْ قَوْمٌ لَا يَفْقَهُونَ}، أي: لا يُقاتِلون على نيةٍ ",
      "markers": [

    {
      "id": "s128",
      "start": 10629,
      "end": 10791,
      "text": "وهذه الآيةُ، أعنى قولَه: {إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ يَغْلِبُوا مِائَتَيْنِ}، وإن كان مخرجُها مخرجَ الخبرِ، فإن معناها الأمرُ، يدلُّ على ذلك قولُه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10654,
          "end": 10720,
          "span_id": "s128"
        },
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 10756,
          "end": 10761,
          "span_id": "s128"
        }
      ]
    },
    {
      "id": "s129",
      "start": 10791,
      "end": 10980,
      "text": " {الْآنَ خَفَّفَ اللَّهُ عَنْكُمْ}. فلم يكن التخفيفُ إلا بعدَ التثقيلِ، ولو كان ثبوتُ العشرةِ منهم للمائةِ مِن عدوِّهم، كان غيرَ فرضٍ عليهم قبلَ التخفيفِ، وكان ندبًا، لم يكنْ للتخفيفِ وجهٌ؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10792,
          "end": 10825,
          "span_id": "s129"
        }
      ]
    },
    {
      "id": "s130",
      "start": 10980,
      "end": 11183,
      "text": " لأن التخفيفَ إنما هو ترخيصٌ في تركِ الواحدِ من المسلمين الثبوتَ للعشرَةِ من العدوِّ، وإذا لم يكن التشديدُ قد كان له مُتقدِّمًا، لم يكنْ للترخيصِ وجهٌ، إذ كان المفهومُ مِن الترخيصِ إنما هو بعدَ التشديدِ.",
      "markers": []
    },
    {
      "id": "s131",
      "start": 11183,
      "end": 11224,
      "text": " وإذ كان ذلك كذلك، فمعلومٌ أن حكمَ قولِه:",
      "markers": []
    },
    {
      "id": "s132",
      "start": 11224,
      "end": 11306,
      "text": " {الْآنَ خَفَّفَ اللَّهُ عَنْكُمْ وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا} ناسخٌ لحكم قوله:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11225,
          "end": 11289,
          "span_id": "s132"
        }
      ]
    },
    {
      "id": "s133",
      "start": 11306,
      "end": 11474,
      "text": " {إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ يَغْلِبُوا مِائَتَيْنِ وَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ يَغْلِبُوا أَلْفًا مِنَ الَّذِينَ كَفَرُوا}. وقد بَيَّنَّا في كتابِنا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11307,
          "end": 11447,
          "span_id": "s133"
        }
      ]
    },
    {
      "id": "s134",
      "start": 11500,
      "end": 11653,
      "text": " \"لطيفِ البيانِ عن أصولِ الأحكامِ\"، أن كلَّ خبرٍ مِن اللَّهِ وَعَدَ فيه عبادَه على عملٍ ثوابًا وجزاءً، وعلى تَرْكِه عقابًا وعذابًا، وإن لم يكنْ خارجًا ظا",
      "markers": []
    },
    {
      "id": "s135",
      "start": 11657,
      "end": 11728,
      "text": "هرُه مخرجَ الأمرِ، ففى معنى الأمرِ، بما أغنى عن إعادتِه في هذا الموضعِ.",
      "markers": []
    },
    {
      "id": "s136",
      "start": 11732,
      "end": 11800,
      "text": "واختلَفَت القرأةُ في قراءةِ قولِه: {وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا}.",
      "markers": [
        {
          "family": "QIRAAT",

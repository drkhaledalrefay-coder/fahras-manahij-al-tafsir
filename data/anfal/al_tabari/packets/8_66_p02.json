          "span_id": "s136"
        }
      ]
    },
    {
      "id": "s137",
      "start": 11804,
      "end": 11843,
      "text": "فقرأه بعضُ المدنيِّين وبعضُ البصريِّين:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 11805,

      "id": "s143",
      "start": 12293,
      "end": 12294,
      "text": ".",
      "markers": []
    },
    {
      "id": "s144",
      "start": 12298,
      "end": 12331,
      "text": "وقرأه بعضُ المدنيِّين: (ضُعفَاء) ",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",

    },
    {
      "id": "s148",
      "start": 12568,
      "end": 12605,
      "text": " {وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا}، و:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12569,
          "end": 12601,
          "span_id": "s148"
        }
      ]
    },
    {
      "id": "s149",
      "start": 12605,
      "end": 12640,
      "text": " (ضُعْفًا)، بفتحِ الضادِ أو ضمِّها؛",
      "markers": []
    },
    {
      "id": "s150",
      "start": 12640,
      "end": 12768,
      "text": " لأنهما القراءتان المعروفتان، وهما لغتان مشهورتان في كلامِ العربِ فصيحتان، بمعنًى واحدٍ، فبأيتِهما قَرأ القارئُ فمُصيبٌ الصوابَ.",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",

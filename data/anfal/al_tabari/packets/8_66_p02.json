          "end": 11809,
          "span_id": "s137"
        }
      ]
    },
    {
      "id": "s138",
      "start": 11843,
      "end": 11926,
      "text": " (وَعَلِمَ أنَّ فيكم ضُعْفًا). بضَمِّ الصَادِ في جميعِ القرآنِ، وتنوينِ الضعفِ على ",
      "markers": []
    },
    {
      "id": "s139",
      "start": 11941,
      "end": 11976,
      "text": " المصدرِ من: ضَعُفَ الرجلُ ضُعْفًا ",
      "markers": []
    },
    {
      "id": "s140",
      "start": 12051,
      "end": 12052,
      "text": ".",
      "markers": []
    },
    {
      "id": "s141",
      "start": 12056,
      "end": 12088,
      "text": "وقرأ ذلك عامةُ قرأةِ الكوفيِّين:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 12057,
          "end": 12060,
          "span_id": "s141"

          "end": 12074,
          "span_id": "s141"
        }
      ]
    },
    {
      "id": "s142",
      "start": 12088,
      "end": 12163,
      "text": " {وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا}، بفتحِ الضادِ على المصدر أيضًا مِن ضَعُف ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12089,
          "end": 12121,

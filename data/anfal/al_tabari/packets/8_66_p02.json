    {
      "id": "s109",
      "start": 9363,
      "end": 9431,
      "text": " {إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ يَغْلِبُوا مِائَتَيْنِ}.",

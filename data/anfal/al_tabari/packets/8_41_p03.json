          "span_id": "s245"
        }
      ]
    },
    {
      "id": "s246",
      "start": 20809,
      "end": 20841,
      "text": " \"لا نُورَثُ، ما ترَكْنا صدقةٌ\" ",
      "markers": []
    },
    {
      "id": "s247",
      "start": 21098,
      "end": 21099,
      "text": ".",
      "markers": []
    },
    {
      "id": "s248",
      "start": 21103,
      "end": 21149,
      "text": "حدَّثنا ابنُ بشارٍ، قال: ثنا عبدُ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 21103,
          "end": 21110,
          "span_id": "s248"
        }
      ]
    },
    {
      "id": "s249",
      "start": 21149,
      "end": 21206,
      "text": " ثنا سعيدٌ، عن قتادةَ، أنه سُئِل عن سهمِ ذى القربى، فقال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 21161,
          "end": 21206,
          "stripped": "عن قتادة، أنه سئل عن سهم ذى القربى، فقال:",
          "span_id": "s249"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 21164,
          "end": 21169,
          "span_id": "s249"
        }
      ]
    },
    {
      "id": "s250",
      "start": 21206,
      "end": 21376,
      "text": " كان طُعمةً لرسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، فلما تُوُفِّى حمَل عليه أبو بكرٍ وعمرُ في سبيلِ اللهِ صدقةً على رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 21232,
          "end": 21262,
          "span_id": "s250"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 21343,
          "end": 21373,
          "span_id": "s250"
        }
      ]
    },
    {
      "id": "s251",
      "start": 21380,
      "end": 21525,
      "text": "وقال آخرون: سهم ذوي القربى مِن بعدِ رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- مع سهمِ رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- إلى والى ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 21429,
          "end": 21459,
          "span_id": "s251"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 21483,
          "end": 21513,
          "span_id": "s251"
        }
      ]
    },
    {
      "id": "s252",
      "start": 21539,
      "end": 21554,
      "text": " أمرِ المسلمين.",
      "markers": []
    },
    {
      "id": "s253",
      "start": 21558,
      "end": 21574,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s254",
      "start": 21578,
      "end": 21608,
      "text": "حدَّثنا أحمدُ بنُ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 21578,
          "end": 21585,
          "span_id": "s254"
        }
      ]
    },
    {
      "id": "s255",
      "start": 21608,
      "end": 21723,
      "text": " ثنا أبو أحمدَ، قال: ثنا عمرُو بنُ ثابتٍ، عن عمرانَ بنِ ظَبْيان، عن حُكَيمِ بنِ سعدٍ، عن علىٍّ رضِى اللهُ عنه، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 21650,
          "end": 21696,
          "stripped": "عن عمران بن ظبيان، عن حكيم بن سعد، عن",
          "span_id": "s255"
        }
      ]
    },
    {
      "id": "s256",
      "start": 21723,
      "end": 21795,
      "text": " يُعْطَى كُلُّ إنسانٍ نصيبه مِن الخمسِ، ويلى الإمامُ سهمَ اللهِ ورسولِه.",
      "markers": []
    },
    {
      "id": "s257",
      "start": 21799,
      "end": 21845,
      "text": "حدَّثنا ابنُ بشارٍ، قال: ثنا عبدُ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 21799,
          "end": 21806,
          "span_id": "s257"
        }
      ]
    },
    {
      "id": "s258",
      "start": 21845,
      "end": 21904,
      "text": " ثنا سعيدٌ، عن قتادةَ، أنه سُئِل عن سهمِ ذوِي القربي، فقال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 21857,
          "end": 21904,
          "stripped": "عن قتادة، أنه سئل عن سهم ذوي القربي، فقال:",
          "span_id": "s258"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 21860,
          "end": 21865,
          "span_id": "s258"
        }
      ]
    },
    {
      "id": "s259",
      "start": 21904,
      "end": 22022,
      "text": " كان طُعْمةً لرسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- ما كان حيًّا، فلما تُوُفِّى جُعِل لولىِّ الأمرِ مِن بعدِه.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 21931,
          "end": 21961,
          "span_id": "s259"
        }
      ]
    },
    {
      "id": "s260",
      "start": 22026,
      "end": 22141,
      "text": "وقال آخرون: سهمُ رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- مردودٌ في الخمسِ، والخمسُ مَقْسومٌ على ثلاثةِ أسهمٍ؛",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 22056,
          "end": 22086,
          "span_id": "s260"
        }
      ]
    },
    {
      "id": "s261",
      "start": 22141,
      "end": 22216,
      "text": " على اليتامى، والمساكينِ، وابنِ السبيلِ، وذلك قولُ جماعةٍ مِن أهلِ العراقِ.",
      "markers": []
    },
    {
      "id": "s262",
      "start": 22220,
      "end": 22300,
      "text": "وقال آخرون: الخمسُ كلُّه لقَرابةِ رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 22267,
          "end": 22297,
          "span_id": "s262"
        }
      ]
    },
    {
      "id": "s263",
      "start": 22304,
      "end": 22320,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s264",
      "start": 22324,
      "end": 22368,
      "text": "حدَّثني الحارثُ، قال: ثنا عبدُ العزيزِ، قال:",
      "markers": []
    },
    {
      "id": "s265",
      "start": 22368,
      "end": 22426,
      "text": " ثنا عبدُ الغَفَّارِ، قال: ثنا المِنْهَالُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s266",
      "start": 22426,
      "end": 22500,
      "text": " سأَلْتُ عبد الله بنَ محمدِ بنِ علىٍّ، وعلىَّ بنَ الحسينِ عن الخمسِ، فقال:",
      "markers": []
    },
    {
      "id": "s267",
      "start": 22500,
      "end": 22537,
      "text": " هو لنا. فقلتُ لعلىٍّ: إن الله يقولُ:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 22510,
          "end": 22513,
          "span_id": "s267"
        }
      ]
    },
    {
      "id": "s268",
      "start": 22537,
      "end": 22616,
      "text": " {وَالْيَتَامَى وَالْمَسَاكِينِ وَابْنِ السَّبِيلِ}. فقال: يتامانا ومَساكينُنا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 22538,
          "end": 22588,
          "span_id": "s268"
        }
      ]
    },
    {
      "id": "s269",
      "start": 22664,
      "end": 22665,
      "text": ".",
      "markers": []
    },
    {
      "id": "s270",
      "start": 22669,
      "end": 22834,
      "text": "والصوابُ مِن القولِ فى ذلك عندَنا أن سهمَ رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- مردودٌ في الخمسِ، والخمسُ مقسومٌ على أربعة أسهمٍ، على ما رُوِى عن ابنِ عباسٍ؛",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 22724,
          "end": 22754,
          "span_id": "s270"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 22823,
          "end": 22832,
          "span_id": "s270"
        }
      ]
    },
    {
      "id": "s271",
      "start": 22834,
      "end": 22903,
      "text": " للقَرابةِ، سهمٌ، ولليتامى سهمٌ، وللمساكين سهمٌ، ولابنِ السبيلِ سهمٌ؛",
      "markers": []
    },
    {
      "id": "s272",
      "start": 22903,
      "end": 23284,
      "text": " لأن اللَّهَ أَوْجَب الخمسَ لأقوامٍ موصوفين بصفاتٍ، كما أوْجَب الأربعةَ الأخماسِ لآخرين، وقد أجْمَعوا أن حقَّ الأربعةِ الأخماسِ لن يَسْتَحِقَّه غيرُهم، فكذلك حقُّ أهلِ الخمسِ لن يَسْتَحِقَّه غيرُهم، فغيرُ جائزٍ أن يَخْرُجَ عنهم إلى غيرِهم، كما غيرُ جائزٍ أن تَخْرُجَ بعضُ السُّهمانِ التي جعَلها اللهُ لمن سماه في كتابِه بفقدِ بعضِ مَن يَسْتَحِقُه إلى غيرِ أهلِ السُّهمانِ الأُخَرِ.",
      "markers": []
    },
    {
      "id": "s273",
      "start": 23288,
      "end": 23439,
      "text": "وأما اليتامى فهم أطفالُ المسلمين الذين قد هلَك آباؤُهم، والمساكينُ هم أهلُ الفاقةِ والحاجةِ مِن المسلمين، وابنِ السبيلِ المُجْتازُ سفرًا قد انقُطِع به.",
      "markers": []
    },
    {
      "id": "s274",
      "start": 23443,
      "end": 23499,
      "text": "كما حدَّثني المُثنى، قال: ثنا عبدُ اللهِ بنُ صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s275",
      "start": 23499,
      "end": 23542,
      "text": " ثني معاويةُ، عن عليٍّ، عن ابنِ عباسٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 23513,
          "end": 23542,
          "stripped": "عن علي، عن ابن عباس، قال:",
          "span_id": "s275"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 23516,
          "end": 23519,
          "span_id": "s275"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 23526,
          "end": 23535,
          "span_id": "s275"
        }
      ]
    },
    {
      "id": "s276",
      "start": 23542,
      "end": 23584,
      "text": " الخمسُ الرابعُ لابنِ السبيلِ، وهو الضيفُ ",
      "markers": []
    },
    {
      "id": "s277",
      "start": 23638,
      "end": 23671,
      "text": " الفقيرُ الذي يَنْزِلُ بالمسلمين ",
      "markers": []
    },
    {
      "id": "s278",
      "start": 23697,
      "end": 23698,
      "text": ".",
      "markers": []
    },
    {
      "id": "s279",
      "start": 23702,
      "end": 23887,
      "text": "القولُ في تأويلِ قولِه: {إِنْ كُنْتُمْ آمَنْتُمْ بِاللَّهِ وَمَا أَنْزَلْنَا عَلَى عَبْدِنَا يَوْمَ الْفُرْقَانِ يَوْمَ الْتَقَى الْجَمْعَانِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ (41)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 23726,
          "end": 23886,
          "span_id": "s279"
        }
      ]
    },
    {
      "id": "s280",
      "start": 23891,
      "end": 24230,
      "text": "يقولُ تعالى ذِكرُه: أيْقِنوا أيُّها المؤمنون أنما غنِمْتُم مِن شَيءٍ فمقسومٌ القَسْمَ الذي بيَّنْتُه، وصدِّقوا به إن كنتم أقْرَرْتُم بوَحْدانية اللهِ، وبما أَنْزَلَ اللهُ على عبدِه محمدٍ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- يومَ فرَق بينَ الحقِّ والباطلِ ببدرٍ، فأبان فَلَجَ المؤمنين وظهورَهم على عدوِّهم، وذلك {يَوْمَ الْتَقَى الْجَمْعَانِ}؛",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 24079,
          "end": 24109,
          "span_id": "s280"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 24199,
          "end": 24229,
          "span_id": "s280"
        }
      ]
    },
    {
      "id": "s281",
      "start": 24230,
      "end": 24381,
      "text": " جمعُ المؤمنين، وجمعُ المشركين، واللهُ على إهلاكِ أهلِ الكفرِ وإذْلالِهم بأيدى المؤمنين، وعلى غيرِ ذلك مما يَشاءُ {قَدِيرٌ}، لا يمتنعُ عليه شيءٌ أراده.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 24344,
          "end": 24353,
          "span_id": "s281"
        }
      ]
    },
    {
      "id": "s282",
      "start": 24385,
      "end": 24427,
      "text": "وبنحوِ الذي قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s283",
      "start": 24431,
      "end": 24447,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s284",
      "start": 24451,
      "end": 24492,
      "text": "حدَّثني المُثنى، قال: ثنا أبو صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s285",
      "start": 24492,
      "end": 24536,
      "text": " ثني معاويةُ، عن علىٍّ، عن ابنِ عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 24506,
          "end": 24536,
          "stripped": "عن على، عن ابن عباس قوله:",
          "span_id": "s285"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 24519,
          "end": 24528,
          "span_id": "s285"
        }
      ]
    },
    {
      "id": "s286",
      "start": 24536,
      "end": 24622,
      "text": " {يَوْمَ الْفُرْقَانِ}. يعنى بالفرقانِ يومَ بدرٍ، فرَق اللهُ فيه بينَ الحقِّ والباطلِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 24537,
          "end": 24558,
          "span_id": "s286"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 24575,
          "end": 24583,
          "span_id": "s286"
        }
      ]
    },
    {
      "id": "s287",
      "start": 24817,
      "end": 24818,
      "text": ".",
      "markers": []
    },
    {
      "id": "s288",
      "start": 24822,
      "end": 24851,
      "text": "حدَّثنا محمدُ بنُ عمرٍو، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 24822,
          "end": 24829,
          "span_id": "s288"
        }
      ]
    },
    {
      "id": "s289",
      "start": 24851,
      "end": 24917,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابنِ أبي نجيحٍ، عن مجاهدٍ مثلَه ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 24882,
          "end": 24916,
          "stripped": "عن ابن أبي نجيح، عن مجاهد مثله",
          "span_id": "s289"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 24904,
          "end": 24909,
          "span_id": "s289"
        }
      ]
    },
    {
      "id": "s290",
      "start": 24982,
      "end": 24983,
      "text": ".",
      "markers": []
    },
    {
      "id": "s291",
      "start": 24987,
      "end": 25031,
      "text": "حدَّثنى المُثَنَّى، قال: ثنا أبو صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s292",
      "start": 25031,
      "end": 25099,
      "text": " ثني الليثُ، قال: ثني عُقَيْلٌ، عن ابنِ شهابٍ، عن عروةَ بنِ الزبير. ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 25063,
          "end": 25098,
          "stripped": "عن ابن شهاب، عن عروة بن الزبير.",
          "span_id": "s292"
        }
      ]
    },
    {
      "id": "s293",
      "start": 25176,
      "end": 25177,
      "text": " ",
      "markers": []
    },
    {
      "id": "s294",
      "start": 25198,
      "end": 25236,
      "text": " -يَزيدُ أحدُهما على صاحبِه- في قولِه:",
      "markers": []
    },
    {
      "id": "s295",
      "start": 25236,
      "end": 25695,
      "text": " {يَوْمَ الْفُرْقَانِ}: يومَ فرَق اللهُ بينَ الحقِّ والباطلِ، وهو يومُ بدرٍ، وهو أولُ مَشْهَدٍ شهِده رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، وكان رأسَ المشركين عتبةُ بنُ ربيعةَ، فالْتَقَوْا يومَ الجمعةِ لتسعَ عشْرةَ ليلةً مضَتْ مِن شهرِ رمضانَ، وأصحابُ رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- ثلاثُ مائةٍ وبضعةَ عشَرَ رجلًا، والمشركون ما بينَ الألفِ والتسعِ مائةٍ، فهزَم اللهُ يومَئذٍ المشركين، وقُتِل منهم زيادةٌ على سبعين، وأُسِر منهم مثلُ ذلك ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 25237,
          "end": 25258,
          "span_id": "s295"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 25302,
          "end": 25310,
          "span_id": "s295"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 25350,
          "end": 25380,
          "span_id": "s295"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 25509,
          "end": 25539,
          "span_id": "s295"
        }
      ]
    },
    {
      "id": "s296",
      "start": 25720,
      "end": 25721,
      "text": ".",
      "markers": []
    },
    {
      "id": "s297",
      "start": 25725,
      "end": 25759,
      "text": "حدَّثنا محمد بنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 25725,
          "end": 25732,
          "span_id": "s297"
        }
      ]
    },
    {
      "id": "s298",
      "start": 25759,
      "end": 25800,
      "text": " ثنا محمد بن ثورٍ، عن معمرٍ، عن مِقْسَمٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 25778,
          "end": 25800,
          "stripped": "عن معمر، عن مقسم:",
          "span_id": "s298"
        }
      ]
    },
    {
      "id": "s299",
      "start": 25800,
      "end": 25872,
      "text": " {يَوْمَ الْفُرْقَانِ}. قال: يومَ بدرٍ، فرَق اللهُ بينَ الحقِّ والباطلِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 25801,
          "end": 25822,
          "span_id": "s299"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 25829,
          "end": 25837,
          "span_id": "s299"
        }
      ]
    },
    {
      "id": "s300",
      "start": 25876,
      "end": 25905,
      "text": "حدَّثنا الحسنُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 25876,
          "end": 25883,
          "span_id": "s300"
        }
      ]
    },
    {
      "id": "s301",
      "start": 25905,
      "end": 25990,
      "text": " أَخْبَرنا عبد الرزاقِ، قال: أخبَرنا معمرٌ، عن عثمانَ الجزريِّ، عن مِقْسَمٍ فى قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 25906,
          "end": 25915,
          "span_id": "s301"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 25906,
          "end": 25957,
          "stripped": "أخبرنا عبد الرزاق، قال: أخبرنا معمر، عن عثمان",
          "span_id": "s301"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 25934,
          "end": 25941,
          "span_id": "s301"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 25949,
          "end": 25990,
          "stripped": "عن عثمان الجزري، عن مقسم فى قوله:",
          "span_id": "s301"
        },
        {
          "family": "SAHABA",
          "marker": "عثمان",
          "name": "عثمان",
          "role": "NARRATOR",
          "start": 25952,
          "end": 25957,
          "span_id": "s301"
        }
      ]
    },
    {
      "id": "s302",
      "start": 25990,
      "end": 26062,
      "text": " {يَوْمَ الْفُرْقَانِ}. قال: يومَ بدرٍ، فرَق اللهُ بينَ الحقِّ والباطلِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 25991,
          "end": 26012,
          "span_id": "s302"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 26019,
          "end": 26027,
          "span_id": "s302"
        }
      ]
    },
    {
      "id": "s303",
      "start": 26088,
      "end": 26089,
      "text": ".",
      "markers": []
    },
    {
      "id": "s304",
      "start": 26093,
      "end": 26121,
      "text": "حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s305",
      "start": 26121,
      "end": 26149,
      "text": " ثني أبي، قال: ثني عمي، قال:",
      "markers": []
    },
    {
      "id": "s306",
      "start": 26149,
      "end": 26188,
      "text": " ثني أبي، عن أبيه، عن ابنِ عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 26159,
          "end": 26188,
          "stripped": "عن أبيه، عن ابن عباس قوله:",
          "span_id": "s306"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 26171,
          "end": 26180,
          "span_id": "s306"
        }
      ]
    },
    {
      "id": "s307",
      "start": 26188,
      "end": 26240,
      "text": " {يَوْمَ الْفُرْقَانِ يَوْمَ الْتَقَى الْجَمْعَانِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 26189,
          "end": 26239,
          "span_id": "s307"
        }
      ]
    },
    {
      "id": "s308",
      "start": 26240,
      "end": 26278,
      "text": " يومَ بدرٍ، وبدرٌ بينَ المدينةِ ومكةَ ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 26241,
          "end": 26249,
          "span_id": "s308"
        }
      ]
    },
    {
      "id": "s309",
      "start": 26394,
      "end": 26395,
      "text": ".",
      "markers": []
    },
    {
      "id": "s310",
      "start": 26399,
      "end": 26448,
      "text": "حدَّثنا ابنُ حميدٍ، قال: ثنا يحيى بنُ واضحٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 26399,
          "end": 26406,
          "span_id": "s310"
        }
      ]
    },
    {
      "id": "s311",
      "start": 26448,
      "end": 26591,
      "text": " ثني يحيى بنُ يعقوبَ أبو طالبٍ، عن ابنِ عونٍ، عن محمدِ بنِ عبدِ اللَّهِ الثَّقفيِّ، عن أبي عبدِ الرحمنِ السُّلَمىِّ عبدِ اللهِ بنِ حَبيبٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 26480,
          "end": 26518,
          "stripped": "عن ابن عون، عن محمد بن عبد الله",
          "span_id": "s311"
        }
      ]
    },
    {
      "id": "s312",
      "start": 26591,
      "end": 26642,
      "text": " قال الحسنُ بنُ علىِّ بنِ أبي طالبٍ رضِي اللهُ عنه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 26596,
          "end": 26601,
          "span_id": "s312"
        }
      ]
    },
    {
      "id": "s313",
      "start": 26642,
      "end": 26714,
      "text": " كانت ليلةُ الفرقانِ يومَ الْتَقَى الجمعان لسبعَ عشْرةَ مِن شهرِ رمضانَ ",
      "markers": []
    },
    {
      "id": "s314",
      "start": 26825,
      "end": 26826,
      "text": ".",
      "markers": []
    },
    {
      "id": "s315",
      "start": 26830,
      "end": 26869,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 26830,
          "end": 26837,
          "span_id": "s315"
        }
      ]
    },
    {
      "id": "s316",
      "start": 26869,
      "end": 26909,
      "text": " ثني حجَّاجٌ، عن ابنِ جُريجٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 26883,
          "end": 26909,
          "stripped": "عن ابن جريج، عن مجاهد:",
          "span_id": "s316"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 26886,
          "end": 26896,
          "span_id": "s316"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 26902,
          "end": 26907,
          "span_id": "s316"
        }
      ]
    },
    {
      "id": "s317",
      "start": 26909,
      "end": 26957,
      "text": " {يَوْمَ الْتَقَى الْجَمْعَانِ}. قال ابنُ جريجٍ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 26910,
          "end": 26940,
          "span_id": "s317"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 26946,
          "end": 26955,
          "span_id": "s317"
        }
      ]
    },
    {
      "id": "s318",
      "start": 26957,
      "end": 26983,
      "text": " قال ابن كثيرٍ: يومَ بدرٍ.",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 26973,
          "end": 26981,
          "span_id": "s318"
        }
      ]
    },
    {
      "id": "s319",
      "start": 26987,
      "end": 27037,
      "text": "حدَّثنا ابنُ حميدٍ، قال: ثنا سلمة، عن ابنِ إسحاقَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 26987,
          "end": 26994,
          "span_id": "s319"
        }
      ]
    },
    {
      "id": "s320",
      "start": 27037,
      "end": 27141,
      "text": " {وَمَا أَنْزَلْنَا عَلَى عَبْدِنَا يَوْمَ الْفُرْقَانِ يَوْمَ الْتَقَى الْجَمْعَانِ}. أَىْ: يومَ فُرِق ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 27038,
          "end": 27122,
          "span_id": "s320"
        }
      ]
    },
    {
      "id": "s321",
      "start": 27168,
      "end": 27197,
      "text": " بينَ الحقِّ والباطلِ بقدرتى ",
      "markers": []
    },
    {
      "id": "s322",
      "start": 27215,
      "end": 27250,
      "text": "، يومَ الْتَقَى الجمعان منكم ومنهم ",
      "markers": []
    },
    {
      "id": "s323",
      "start": 27273,
      "end": 27274,
      "text": ".",
      "markers": []
    },
    {
      "id": "s324",
      "start": 27278,
      "end": 27311,
      "text": "حدَّثنا بشرٌ، قال: ثنا يزيد، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 27278,
          "end": 27285,
          "span_id": "s324"
        }
      ]
    },
    {
      "id": "s325",
      "start": 27311,
      "end": 27390,
      "text": " ثنا سعيدٌ، عن قتادةَ: {وَمَا أَنْزَلْنَا عَلَى عَبْدِنَا يَوْمَ الْفُرْقَانِ}:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 27326,
          "end": 27331,
          "span_id": "s325"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 27334,
          "end": 27389,
          "span_id": "s325"
        }
      ]
    },
    {
      "id": "s326",
      "start": 27390,
      "end": 27445,
      "text": " وذاكم يومُ بدرٍ، يومَ فرَق اللهُ بينَ الحقِّ والباطلِ ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 27397,
          "end": 27405,
          "span_id": "s326"
        }
      ]
    },
    {
      "id": "s327",
      "start": 27516,
      "end": 27517,
      "text": ".",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s228",
      "start": 19071,
      "end": 19153,
      "text": "¬في ص: \"رحمة الله عليه\". وفي ت 1، ت 2، س، ف: \"رضى الله عنه\". وينظر مصادر التخريج.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s229",
      "start": 19154,
      "end": 19542,
      "text": "¬أخرجه أبو عبيد في الأموال (39، 837، 847)، والحاكم 2/ 128، والبيهقي في السنن 6/ 338، 342 من طريق عبد الرحمن بن مهدى به، وأخرجه عبد الرزاق في مصنفه (9382)، وابن أبي شيبة 12/ 431، 471، 472، وابن زنجويه فى الأموال (75، 1247)، والنسائي (4154)، وابن أبي حاتم في تفسيره 5/ 1702، والطحاوى فى شرح معانى الآثار 3/ 234، 277 من طريق سفيان به، وعزاه السيوطى فى الدر المنثور 3/ 185 إلى أبى الشيخ<br>.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s234",
      "start": 19709,
      "end": 19724,
      "text": "¬فى ف: \"عمرو\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s238",
      "start": 19962,
      "end": 20003,
      "text": "¬ذكره ابن كثير في تفسيره 4/ 6 عن المصنف.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s246",
      "start": 20841,
      "end": 21098,
      "text": "¬تقدم في ص 191 دون قوله: \"فلما قبض. . .\" إلخ -وينظر الأثر السابق- ودون المرفوع منه. وقد أخرج المرفوع البخاري (3093، 3712، 4036، 5358، 6726، 6727، 7305) من حديث أبي بكر وعائشة وغيرهما. وأخرجه <br>مسلم [(1757/ 49، 50) 1758، 1759] من حديث عائشة ومالك ابن أوس.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s251",
      "start": 21525,
      "end": 21539,
      "text": "¬فى م: \"ولي\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s268",
      "start": 22616,
      "end": 22664,
      "text": "¬ذكره ابن كثير في تفسيره 4/ 6 وعزاه إلى المصنف.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s276",
      "start": 23584,
      "end": 23638,
      "text": "¬فى ص، ت 1، ت 2، س، ف: \"الضعيف\". وينظر مصادر التخريج.¥",
      "grading": [
        "ضعيف"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s277",
      "start": 23671,
      "end": 23697,
      "text": "¬تقدم أوله في ص 190، 191.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s286",
      "start": 24622,
      "end": 24817,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره 5/ 1706 (9101)، والحاكم في المستدرك 3/ 23، والبيهقي في دلائل النبوة 3/ 120 من طريق أبي صالح به، وعزاه السيوطى فى الدر المنثور 3/ 187، 188 إلى أبي الشيخ وابن مردويه.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s289",
      "start": 24917,
      "end": 24982,
      "text": "¬تفسير مجاهد ص 355، وذكره ابن أبي حاتم في تفسيره 5/ 1706 معلقًا.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s293",
      "start": 25177,
      "end": 25198,
      "text": "¬سقط مِن: ت 2، س، ف.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s295",
      "start": 25695,
      "end": 25720,
      "text": "¬مصنف عبد الرزاق (9726).¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s302",
      "start": 26062,
      "end": 26088,
      "text": "¬تفسير عبد الرزاق 1/ 259.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s308",
      "start": 26278,
      "end": 26394,
      "text": "¬أخرجه ابن أبي حاتم فى تفسيره 5/ 1706 بهذا الإسناد، وعزاه السيوطى في الدر المنثور 3/ 187 إلى أبي الشيخ وابن مردويه.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s313",
      "start": 26714,
      "end": 26825,
      "text": "¬ذكره ابن كثير في تفسيره 4/ 9 عن المصنف، وقال: إسناد جيد قوى، وعزاه السيوطى في الدر المنثور 3/ 188 إلى المصنف.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s320",
      "start": 27141,
      "end": 27168,
      "text": "¬في سيرة ابن هشام: \"فرقت\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s321",
      "start": 27197,
      "end": 27215,
      "text": "¬في م: \"ببدر أي\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s322",
      "start": 27250,
      "end": 27273,
      "text": "¬سيرة ابن هشام 1/ 672.¥",
      "grading": []
    },

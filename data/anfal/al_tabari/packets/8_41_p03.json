  "spans": [
    {
      "id": "s221",
      "start": 18512,
      "end": 18548,
      "text": "قال: سأَلْتُ الحسنَ عن قولِ اللَّهِ:",
      "markers": []
    },
    {
      "id": "s222",
      "start": 18548,
      "end": 18634,
      "text": " {وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَيْءٍ فَأَنَّ لِلَّهِ خُمُسَهُ وَلِلرَّسُولِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 18549,
          "end": 18633,
          "span_id": "s222"
        }
      ]
    },
    {
      "id": "s223",
      "start": 18634,
      "end": 18683,
      "text": " قال: هذا مِفْتاحُ كلامٍ؛ للَّهِ الدنيا والآخرةُ.",
      "markers": []
    },
    {
      "id": "s224",
      "start": 18683,
      "end": 18786,
      "text": " ثم اختلف الناسُ في هذين السهمين بعدَ وفاةِ رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، فقال قائلون:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 18740,
          "end": 18770,
          "span_id": "s224"
        }
      ]
    },
    {
      "id": "s225",
      "start": 18786,
      "end": 18885,
      "text": " سهمُ النبيِّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- لقرَابةِ النبيِّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 18801,
          "end": 18831,
          "span_id": "s225"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 18852,
          "end": 18882,
          "span_id": "s225"
        }
      ]
    },
    {
      "id": "s226",
      "start": 18885,
      "end": 18930,
      "text": " وقال قائلون: سهمُ القرابةِ لقرابةِ الخليفةِ.",
      "markers": []
    },
    {
      "id": "s227",
      "start": 18930,
      "end": 19046,
      "text": " واجْتَمَع رأيُهم أن يَجْعَلوا هذين السهمين في الخيلِ والعُدَّةِ في سبيلِ اللَّهِ، فكانا على ذلك في خلافةِ أبي بكرٍ ",
      "markers": []
    },
    {
      "id": "s228",
      "start": 19070,
      "end": 19071,
      "text": " ",
      "markers": []
    },
    {
      "id": "s229",
      "start": 19153,
      "end": 19154,
      "text": " ",
      "markers": []
    },
    {
      "id": "s230",
      "start": 19542,
      "end": 19543,
      "text": ".",
      "markers": []
    },
    {
      "id": "s231",
      "start": 19547,
      "end": 19577,
      "text": "حدَّثنا أحمدُ بنُ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 19547,
          "end": 19554,
          "span_id": "s231"
        }
      ]
    },
    {
      "id": "s232",
      "start": 19577,
      "end": 19633,
      "text": " ثنا أبو أحمدَ، قال: ثنا سفيانُ، عن قيسِ بنِ مسلمٍ، قال:",
      "markers": []
    },
    {
      "id": "s233",
      "start": 19633,
      "end": 19671,
      "text": " سأَلْتُ الحسنَ بنَ محمدٍ، فذكر نحوَه.",
      "markers": []
    },
    {
      "id": "s234",
      "start": 19675,
      "end": 19709,
      "text": "حدَّثنا ابنُ وكيعٍ، قال: ثنا عمرُ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 19675,
          "end": 19682,
          "span_id": "s234"
        }
      ]
    },
    {
      "id": "s235",
      "start": 19724,
      "end": 19765,
      "text": " بنُ عبيدٍ، عن الأعمشِ، عن إبراهيمَ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 19736,
          "end": 19765,
          "stripped": "عن الأعمش، عن إبراهيم، قال:",
          "span_id": "s235"
        }
      ]
    },
    {
      "id": "s236",
      "start": 19765,
      "end": 19896,
      "text": " كان أبو بكرٍ وعمرُ رضى اللهُ عنهما يَجْعَلان سهمَ النبيِّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- فى الكُرَاعِ والسلاحِ، فقلتُ لإبراهيم:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 19825,
          "end": 19855,
          "span_id": "s236"
        },
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 19882,
          "end": 19885,
          "span_id": "s236"
        }
      ]
    },
    {
      "id": "s237",
      "start": 19896,
      "end": 19934,
      "text": " ما كان علىٌّ رضى اللهُ عنه يقولُ فيه؟",
      "markers": []
    },
    {
      "id": "s238",
      "start": 19934,
      "end": 19962,
      "text": " قال: كان علىٌّ أشدَّهم فيه ",
      "markers": []
    },
    {
      "id": "s239",
      "start": 20003,
      "end": 20004,
      "text": ".",
      "markers": []
    },
    {
      "id": "s240",
      "start": 20008,
      "end": 20060,
      "text": "حدَّثني المُثنى، قال: ثنا عبدُ اللهِ بنُ صالحٍ، قال:",
      "markers": []
    },
    {
      "id": "s241",
      "start": 20060,
      "end": 20104,
      "text": " ثني معاويةُ، عن علىٍّ، عن ابنِ عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 20074,
          "end": 20104,
          "stripped": "عن على، عن ابن عباس قوله:",
          "span_id": "s241"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 20087,
          "end": 20096,
          "span_id": "s241"
        }
      ]
    },
    {
      "id": "s242",
      "start": 20104,
      "end": 20245,
      "text": " {وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَيْءٍ فَأَنَّ لِلَّهِ خُمُسَهُ وَلِلرَّسُولِ وَلِذِي الْقُرْبَى وَالْيَتَامَى وَالْمَسَاكِينِ} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 20105,
          "end": 20238,
          "span_id": "s242"
        }
      ]
    },
    {
      "id": "s243",
      "start": 20245,
      "end": 20304,
      "text": " قال ابنُ عباسٍ: فكانت الغَنيمةُ تُقْسَمُ على خمسةِ أخماسٍ؛",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 20250,
          "end": 20259,
          "span_id": "s243"
        }
      ]
    },
    {
      "id": "s244",
      "start": 20304,
      "end": 20366,
      "text": " أربعةٍ بينَ مَن قاتَل عليها، وخمسٍ واحدٍ يُقْسَمُ على أربعةٍ؛",
      "markers": []
    },
    {
      "id": "s245",
      "start": 20366,
      "end": 20809,
      "text": " للَّهِ وللرسولِ، ولذى القربى -يعنى قرابةَ النبيِّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-- فما كان للهِ وللرسولِ فهو لقَرابةِ النبيِّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، ولم يَأْخُذِ النبيُّ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- مِن الخمسِ شيئًا، فلما قبَض اللهُ رسولَه -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، ردَّ أبو بكرٍ رضِى اللهُ عنه نصيبَ القرَابةِ فى المسلمين، فجعَل يَحْمِلُ به في سبيلِ اللَّهِ، لأن رسولَ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 20418,
          "end": 20448,
          "span_id": "s245"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 20496,
          "end": 20526,
          "span_id": "s245"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 20552,
          "end": 20582,
          "span_id": "s245"
        },
        {

    },
    {
      "id": "s362",
      "start": 26501,
      "end": 26555,
      "text": " {يَسْأَلُونَكَ عَنِ الْأَنْفَالِ}، فقرَأ حتَّى بَلَغ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 26502,
          "end": 26535,
          "span_id": "s362"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 26538,
          "end": 26542,
          "span_id": "s362"
        }
      ]
    },
    {
      "id": "s363",
      "start": 26555,
      "end": 26629,
      "text": " {إِن كُنتُم مُّؤْمِنِينَ}: فسَلِّموا للهِ ولرسوله يحكُمان فيها بما شاءَا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 26556,
          "end": 26581,
          "span_id": "s363"
        }
      ]
    },
    {
      "id": "s364",
      "start": 26643,
      "end": 26673,
      "text": "، ويضعانها حيثُ أرادا، فقالوا:",
      "markers": []
    },
    {
      "id": "s365",
      "start": 26673,
      "end": 26700,
      "text": " نعم. ثم جاء بعدَ الأربعين:",
      "markers": []
    },
    {
      "id": "s366",
      "start": 26700,
      "end": 26791,
      "text": " {وَاعْلَمُوا أَنَّمَا غَنِمْتُم مِّن شَيْءٍ فَأَنَّ لِلَّهِ خُمُسَهُ وَلِلرَّسُولِ} الآية ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 26701,
          "end": 26784,
          "span_id": "s366"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 26791,
          "end": 26804,
          "text": "[الأنفال: 41]",
          "via": "apparatus",
          "span_id": "s366"
        }
      ]
    },
    {
      "id": "s367",
      "start": 26804,
      "end": 26880,
      "text": "، ولكم أربعة أخماس. وقال النبي -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- يوم خيبَرٍ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 26836,
          "end": 26866,
          "span_id": "s367"
        }
      ]
    },
    {
      "id": "s368",
      "start": 26880,
      "end": 26927,
      "text": " \"وَهَذَا الخُمُسُ مَرْدُودٌ على فُقَرائِكُمْ\".",
      "markers": []
    },
    {
      "id": "s369",
      "start": 26927,
      "end": 27020,
      "text": " يَصْنَعُ اللَّه ورسوله في ذلكَ الخُمْسِ مَا أَحَبَّا، ويَضَعَانِه حَيْثُ أحَبَّا. ثم أخبرنا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 27013,
          "end": 27019,
          "span_id": "s369"
        }
      ]
    },
    {
      "id": "s370",
      "start": 27043,
      "end": 27049,
      "text": " الله ",
      "markers": []
    },
    {
      "id": "s371",
      "start": 27063,
      "end": 27064,
      "text": " ",
      "markers": []
    },
    {
      "id": "s372",
      "start": 27083,
      "end": 27106,
      "text": " من ذلك، ثم قرأ الآيةَ:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 27095,
          "end": 27098,
          "span_id": "s372"
        }
      ]
    },
    {
      "id": "s373",
      "start": 27106,
      "end": 27229,
      "text": " {وَلِذِي الْقُرْبَى والْيَتَمَى وَالْمَسَكِينِ وَابْنِ السَّبِيلِ كَيْ لَا يَكُونَ دُولَةً بَيْنَ الْأَغْنِيَاءِ مِنكُمْ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 27107,
          "end": 27228,
          "span_id": "s373"
        }
      ]
    },
    {
      "id": "s374",
      "start": 27267,
      "end": 27268,
      "text": " ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 27268,
          "end": 27278,
          "text": "[الحشر: 7]",
          "via": "apparatus",
          "span_id": "s374"
        }
      ]
    },
    {
      "id": "s375",
      "start": 27278,
      "end": 27279,
      "text": ".",
      "markers": []
    },
    {
      "id": "s376",
      "start": 27283,
      "end": 27331,
      "text": "قال أبو جعفر: والصوابُ من القول في ذلك أن يقالَ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 27325,
          "end": 27329,
          "span_id": "s376"
        }
      ]
    },
    {
      "id": "s377",
      "start": 27331,
      "end": 27558,
      "text": " إن اللهَ جلَّ ثناؤُه أخبرَ أنه جعَل الأنفال لنبيِّه -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، يُنفِّلُ مَن شاء، فنفّل القاتل السَّلَبَ، وجعَل للجيشِ في البدْأَةِ الرُّبعَ، وفي الرجعةِ الثُّلثَ بعدَ الخُمُسِ، ونفّل قوما بعد سُهمانِهم ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 27385,
          "end": 27415,
          "span_id": "s377"
        }
      ]
    },
    {
      "id": "s378",
      "start": 27583,
      "end": 27599,
      "text": " بعيرا بعيرا في ",
      "markers": []
    },
    {
      "id": "s379",
      "start": 27629,
      "end": 27826,
      "text": " بعض المغازى، فجعَل الله تعالى ذكره حكم الأنفالِ إلى نبيِّه -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، يُنفِّلُ على ما يرَى مما فيه صلاح المسلمين، وعلى من بعده من الأئمةِ أَنْ يَستَنُّوا بسُنَّتِهِ في ذلك.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 27690,
          "end": 27720,
          "span_id": "s379"
        }
      ]
    },
    {
      "id": "s380",
      "start": 27826,
      "end": 27866,
      "text": " وليس في الآية دليلٌ على أن حكمها منسوخ؛",
      "markers": []
    },
    {
      "id": "s381",
      "start": 27866,
      "end": 28027,
      "text": " لاحتمالها ما ذكَرتُ من المعنى الذى وصَفتُ، وغير جائز أن يُحكَمَ بحكم قد نزل به القرآن أنه منسوخٌ إلا بحجة يجب التسليم لها، فقد دَلَّلْنا في غير موضع من كُتُبنا ",
      "markers": []
    },
    {
      "id": "s382",
      "start": 28052,
      "end": 28177,
      "text": " على أن لا منسوخ إلَّا ما أبطل حكمه حادث حكم بخلافه، ينفيه من كلِّ معانيه، أو يأتى خبرٌ يوجِبُ الحجةَ أن أحدهما ناسخٌ الآخرَ.",
      "markers": []
    },
    {
      "id": "s383",
      "start": 28181,
      "end": 28299,
      "text": "وقد ذُكِر عن سعيد بن المسيب أنه كان ينكرُ أن يكونَ التَّنفيلُ لأحدٍ بعدَ رسول الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-: ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 28265,
          "end": 28295,
          "span_id": "s383"
        }
      ]
    },
    {
      "id": "s384",
      "start": 28318,
      "end": 28319,
      "text": " ",
      "markers": []
    },
    {
      "id": "s385",
      "start": 28358,
      "end": 28412,
      "text": " الله تعالى: {قُلِ الْأَنفَالُ لِلَّهِ وَلِلرَّسُولِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28371,
          "end": 28411,
          "span_id": "s385"
        }
      ]
    },
    {
      "id": "s386",
      "start": 28416,
      "end": 28483,
      "text": "حدَّثنا ابن وكيع، قال: ثنا عبدَةُ بن سليمانَ، عن محمد بن عمرو، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 28416,
          "end": 28423,
          "span_id": "s386"
        }
      ]
    },
    {
      "id": "s387",
      "start": 28483,
      "end": 28541,
      "text": " أرسَل سعيد بن المسيبِ غلامَه إلى قومٍ سألوه عن شيء، فقال:",
      "markers": []
    },
    {
      "id": "s388",
      "start": 28541,
      "end": 28638,
      "text": " إنكم أرسلتم إليَّ تسألونى عن الأنفال، فلا نَفَل بعد رسول الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 28605,
          "end": 28635,
          "span_id": "s388"
        }
      ]
    },
    {
      "id": "s389",
      "start": 28745,
      "end": 28746,
      "text": ".",
      "markers": []
    },
    {
      "id": "s390",
      "start": 28750,
      "end": 28771,
      "text": "وقد بيَّنا أن للأئمة ",
      "markers": []
    },
    {
      "id": "s391",
      "start": 28804,
      "end": 28948,
      "text": " أن يتأسَّوْا برسول الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- في مغازيهم بفعلِه، فيُنفِّلوا على ما كان يُنَفِّلُ، إذا كان التنفيلُ صلاحًا للمسلمين.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 28830,
          "end": 28860,
          "span_id": "s391"
        }
      ]
    },
    {
      "id": "s392",
      "start": 28952,
      "end": 29086,
      "text": "القول في تأويل قوله: {فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ وَأَطِيعُوا اللَّهَ وَرَسُولَهُ إِنْ كُنْتُمْ مُؤْمِنِينَ (1)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28973,
          "end": 29085,
          "span_id": "s392"
        }
      ]
    },
    {
      "id": "s393",
      "start": 29090,
      "end": 29183,
      "text": "يقول تعالى ذكره: فخافوا اللهَ أيها القومُ، واتقوه بطاعته واجتناب معاصيه، وأصلحوا الحال بينكم.",
      "markers": []
    },
    {
      "id": "s394",
      "start": 29187,
      "end": 29218,
      "text": "واختلف أهل التأويل في الذى عنى ",
      "markers": []
    },
    {
      "id": "s395",
      "start": 29241,
      "end": 29294,
      "text": " بقوله: {وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ}؛ فقال بعضُهم:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 29249,
          "end": 29280,
          "span_id": "s395"
        }
      ]
    },
    {
      "id": "s396",
      "start": 29294,
      "end": 29437,
      "text": " هو أمرٌ من الله الذين غنموا الغنيمة يوم بدر، وشهدوا الوقعةَ مع رسول الله -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، إذ اختلفوا في الغنيمة، أن يَرُدَّ ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 29331,
          "end": 29338,
          "span_id": "s396"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 29369,
          "end": 29399,
          "span_id": "s396"
        }
      ]
    },
    {
      "id": "s397",
      "start": 29453,
      "end": 29484,
      "text": " ما أصابوا منها بعضُهم على بعض.",
      "markers": []
    },
    {
      "id": "s398",
      "start": 29488,
      "end": 29505,
      "text": "ذِكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s399",
      "start": 29509,
      "end": 29536,
      "text": "حدَّثنا بشرُ بن معاذٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 29509,
          "end": 29516,
          "span_id": "s399"
        },
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 29525,
          "end": 29529,
          "span_id": "s399"
        }
      ]
    },
    {
      "id": "s400",
      "start": 29536,
      "end": 29573,
      "text": " ثنا يزيد، قال: ثنا سعيدٌ، عن قتادةَ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 29566,
          "end": 29571,
          "span_id": "s400"
        }
      ]
    },
    {
      "id": "s401",
      "start": 29573,
      "end": 29625,
      "text": " {فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 29574,
          "end": 29624,
          "span_id": "s401"
        }
      ]
    },
    {
      "id": "s402",
      "start": 29625,
      "end": 29723,
      "text": " قال: كان نبىُّ اللهِ يُنفِّلُ الرجل من المؤمنين سَلَبَ الرجل من الكفار إذا قتله، ثم أنزل اللَّهُ:",
      "markers": []
    },
    {
      "id": "s403",
      "start": 29723,
      "end": 29775,
      "text": " {فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 29724,
          "end": 29774,
          "span_id": "s403"
        }
      ]
    },
    {
      "id": "s404",
      "start": 29775,
      "end": 29806,
      "text": " أمرهم أن يردَّ بعضُهم على بعض ",
      "markers": []
    },
    {
      "id": "s405",
      "start": 29848,
      "end": 29849,
      "text": ".",
      "markers": []
    },
    {
      "id": "s406",
      "start": 29853,
      "end": 29891,
      "text": "حدَّثنا القاسم، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 29853,
          "end": 29860,
          "span_id": "s406"
        }
      ]
    },
    {
      "id": "s407",
      "start": 29891,
      "end": 29921,
      "text": " ثني حجاجٌ، عن ابن جريجٍ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 29906,
          "end": 29914,
          "span_id": "s407"
        }
      ]
    },
    {
      "id": "s408",
      "start": 29921,
      "end": 30103,
      "text": " بلغنِي أن النبي -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، كان ينفِّلُ الرجل على قَدْرِ جِدِّه وغَنَائِه على ما رأى، حتى إذا كان يوم بدرٍ وملأ الناسُ أيديهم غنائمَ، قال أهل الضعف من الناسِ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أن النبي",
          "start": 29929,
          "end": 29937,
          "span_id": "s408"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 29939,
          "end": 29969,
          "span_id": "s408"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 30043,
          "end": 30050,
          "span_id": "s408"
        }
      ]
    },
    {
      "id": "s409",
      "start": 30103,
      "end": 30192,
      "text": " ذهَب أهلُ القوّة بالغنائمِ. فذكرُوا ذلك للنبي -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ-، فنزلتْ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 30151,
          "end": 30181,
          "span_id": "s409"
        },
        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 30185,
          "end": 30190,
          "span_id": "s409"
        }
      ]
    },
    {
      "id": "s410",
      "start": 30192,
      "end": 30282,
      "text": " {قُلِ الْأَنفَالُ لِلَّهِ وَالرَّسُولِ فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 30193,
          "end": 30281,
          "span_id": "s410"
        }
      ]
    },
    {
      "id": "s411",
      "start": 30282,
      "end": 30317,
      "text": " ليردَّ أهل القوّةِ على أهل الضعفِ.",
      "markers": []
    },
    {
      "id": "s412",
      "start": 30321,
      "end": 30423,
      "text": "وقال آخرون: هذا تحريجٌ من الله على القوم، ونهىٌ لهم عن الاختلاف فيما اختلفوا فيه من أمر الغنيمة وغيره.",
      "markers": []
    },
    {
      "id": "s413",
      "start": 30427,
      "end": 30444,
      "text": "ذِكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s414",
      "start": 30448,
      "end": 30476,
      "text": "حدَّثني محمد بن عمارةَ، قال:",
      "markers": []
    },
    {
      "id": "s415",
      "start": 30476,
      "end": 30522,
      "text": " ثنا خالد بن يزيد، وحدثنا أحمد بن إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 30496,
          "end": 30501,
          "span_id": "s415"
        }
      ]
    },
    {
      "id": "s416",
      "start": 30522,
      "end": 30591,
      "text": " ثنا أبو أحمدَ، قالا: ثنا أبو إسرائيل، عن فضيل، عن مجاهد في قول الله:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 30561,
          "end": 30591,
          "stripped": "عن فضيل، عن مجاهد في قول الله:",
          "span_id": "s416"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 30573,
          "end": 30578,
          "span_id": "s416"
        }
      ]
    },
    {
      "id": "s417",
      "start": 30591,
      "end": 30660,
      "text": " {فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكمْ}. قال: حرَّج عليهم.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 30592,
          "end": 30641,
          "span_id": "s417"
        }
      ]
    },
    {
      "id": "s418",
      "start": 30664,
      "end": 30701,
      "text": "حدَّثني الحارث، قال: ثنا القاسم، قال:",
      "markers": []
    },
    {
      "id": "s419",
      "start": 30701,
      "end": 30765,
      "text": " ثنا عباد بن العوّامِ، عن سفيان بن حسين، عن مجاهدٍ، عن ابن عباس:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 30724,
          "end": 30765,
          "stripped": "عن سفيان بن حسين، عن مجاهد، عن ابن عباس:",
          "span_id": "s419"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 30745,
          "end": 30750,
          "span_id": "s419"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 30756,
          "end": 30764,
          "span_id": "s419"
        }
      ]
    },
    {
      "id": "s420",
      "start": 30765,
      "end": 30817,
      "text": " {فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 30766,
          "end": 30816,
          "span_id": "s420"
        }
      ]
    },
    {
      "id": "s421",
      "start": 30821,
      "end": 30897,
      "text": "قال: هذا تحريجٌ من الله على المؤمنين، أن يتقوا ويصلحوا ذاتَ بينهم. قال عباد ",
      "markers": []
    },
    {
      "id": "s422",
      "start": 30929,
      "end": 30979,
      "text": ": قال سفيان: هذا حين اختلفوا في الغنائم يومَ بدرٍ ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 30969,
          "end": 30977,
          "span_id": "s422"
        }
      ]
    },
    {
      "id": "s423",
      "start": 31331,
      "end": 31332,
      "text": ".",
      "markers": []
    },
    {
      "id": "s424",
      "start": 31336,
      "end": 31364,
      "text": "حدَّثني محمد بن الحسين، قال:",
      "markers": []
    },
    {
      "id": "s425",
      "start": 31364,
      "end": 31391,
      "text": " ثنا أحمد بن المفضّلِ، قال:",
      "markers": []
    },
    {
      "id": "s426",
      "start": 31391,
      "end": 31474,
      "text": " ثنا أسباطُ، عن السُّديِّ: {فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ}: أَي ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 31407,
          "end": 31414,
          "span_id": "s426"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 31418,
          "end": 31468,
          "span_id": "s426"
        }
      ]
    },
    {
      "id": "s427",
      "start": 31502,
      "end": 31518,
      "text": " لا تَسْتَبُّوا ",
      "markers": []
    },
    {
      "id": "s428",
      "start": 31581,
      "end": 31582,
      "text": ".",
      "markers": []
    },
    {
      "id": "s429",
      "start": 31586,
      "end": 31628,
      "text": "واختلف أهل العربية في وجهِ تأنيثِ (البين)؛",
      "markers": []
    },
    {
      "id": "s430",
      "start": 31628,
      "end": 31693,
      "text": " فقال بعضُ نحويِّى البصرةِ: أضاف \"ذاتَ\" إلى \"البينِ\" وجعله \"ذاتَ ",
      "markers": []
    },
    {
      "id": "s431",
      "start": 31708,
      "end": 31831,
      "text": " \"؛ لأن بعض الأشياء يُوضَعُ عليه اسمٌ مؤنثٌ وبعضًا يُذَكَّرُ، نحو \"الدّارِ\" و \"الحائط\"، أُنِّثَ \"الدارُ\" وذُكِّر \"الحائطُ\".",
      "markers": []
    },
    {
      "id": "s432",
      "start": 31835,
      "end": 31864,
      "text": "وقال بعضُهم: إنما أراد بقوله:",
      "markers": []
    },
    {
      "id": "s433",
      "start": 31864,
      "end": 31910,
      "text": " {ذَاتَ بَيْنِكُمْ}. الحالَ التي للبينِ، فقال ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 31865,
          "end": 31883,
          "span_id": "s433"
        }
      ]
    },
    {
      "id": "s434",
      "start": 31924,
      "end": 31980,
      "text": ": وكذلك \"ذاتُ العِشاءِ\"، يريد الساعة التي فيها العِشاءُ.",
      "markers": []
    },
    {
      "id": "s435",
      "start": 31980,
      "end": 32041,
      "text": " قال: ولم يضَعُوا مذكرًا لمؤنث ولا مؤنثًا لمذكَّر إلا لمعنًى.",
      "markers": []
    },
    {
      "id": "s436",
      "start": 32045,
      "end": 32114,
      "text": "قال أبو جعفر: وهذا القولُ أولى القولين بالصواب، للعلة التي ذكرتها له.",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [

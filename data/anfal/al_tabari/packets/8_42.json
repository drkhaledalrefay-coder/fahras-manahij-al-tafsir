          "start": 2711,
          "end": 2745,
          "stripped": "عن ورقاء، عن ابن أبى نجيح، عن",
          "span_id": "s032"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 2746,
          "end": 2751,
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 2865,
      "end": 2866,
      "text": ".",
      "markers": []
    },
    {
      "id": "s034",
      "start": 2870,
      "end": 2901,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s035",
      "start": 2901,
      "end": 2931,
      "text": " ثنا أحمدُ بنُ المفضَّلِ، قال:",
      "markers": []
    },
    {
      "id": "s036",
      "start": 2931,
      "end": 2960,
      "text": " ثنا أسباطُ، عن السدىِّ، قال:",
      "markers": []
    },
    {
      "id": "s037",
      "start": 2960,
      "end": 2994,
      "text": " ذكرَ منازلَ القومِ والعيرِ، فقال:",
      "markers": []
    },
    {
      "id": "s038",
      "start": 2994,
      "end": 3093,
      "text": " {إِذْ أَنْتُمْ بِالْعُدْوَةِ الدُّنْيَا وَهُمْ بِالْعُدْوَةِ الْقُصْوَى}، والرَّكبُ هو أبو سفيانَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2995,
          "end": 3067,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 3114,
      "end": 3152,
      "text": " {أَسْفَلَ مِنْكُمْ}. على شاطئ البحرِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3115,
          "end": 3134,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3156,
      "end": 3191,
      "text": "واختَلَفَت القرأةُ فى قراءةِ قولِه:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 3169,
          "end": 3172,
          "span_id": "s040"
        },
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 3178,
          "end": 3183,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 3191,
      "end": 3295,
      "text": " {إِذْ أَنْتُمْ بِالْعُدْوَةِ}. فقرَأ ذلك عامةُ قرأةِ المدنيين والكوفيين: {بِالْعُدْوَةِ}، بضمِّ العينِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3192,
          "end": 3221,
          "span_id": "s041"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 3224,
          "end": 3228,
          "span_id": "s041"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 3239,
          "end": 3242,
          "span_id": "s041"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3265,
          "end": 3280,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 3417,
      "end": 3478,
      "text": ". وقرَأَه بعضُ المكيين والبصريين: (بالعِدْوَةِ) بكسرِ العينِ ",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 3420,
          "end": 3424,
          "span_id": "s042"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأه",
          "start": 3420,
          "end": 3426,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3548,
      "end": 3614,
      "text": ". وهما لغتان مشهورتان بمعنًى واحدٍ، فبأيتِهما قرَأ القارئُ فمصيبٌ.",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 3594,
          "end": 3598,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 3618,
      "end": 3639,
      "text": "يُنْشَدُ بيتُ الراعي ",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3654,
      "end": 3655,
      "text": ":",
      "markers": []
    },
    {
      "id": "s046",
      "start": 3659,
      "end": 3673,
      "text": "وعينان حُمْرٌ ",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3790,
      "end": 3834,
      "text": " مآقِيهما ... كما نظَر العِدْوةَ الجُؤْذَرُ ",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3882,
      "end": 3946,
      "text": "بكسرِ العينِ مِن العِدْوةِ، وكذلك يُنْشَدْ بيتُ أوسِ بنِ حَجَرٍ ",
      "markers": []
    },
    {
      "id": "s049",
      "start": 3961,
      "end": 3962,
      "text": ":",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3966,
      "end": 3974,
      "text": "وفارِسٍ ",
      "markers": []
    },
    {
      "id": "s051",
      "start": 3993,
      "end": 3994,
      "text": " ",
      "markers": []
    },
    {
      "id": "s052",
      "start": 4021,
      "end": 4072,
      "text": " عِدْوَتَه ... ولَّوْا سِراعًا وما هَمُّوا بإقْبالِ",
      "markers": []
    },
    {
      "id": "s053",
      "start": 4076,
      "end": 4208,
      "text": "القولُ في تأويلِ قولِه: {وَلَوْ تَوَاعَدْتُمْ لَاخْتَلَفْتُمْ فِي الْمِيعَادِ وَلَكِنْ لِيَقْضِيَ اللَّهُ أَمْرًا كَانَ مَفْعُولًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4100,
          "end": 4207,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4212,
      "end": 4287,
      "text": "يعنى تعالى ذكرُه: ولو كان اجْتماعُكم في الموضعِ الذى اجْتَمَعْتُم فيه أنتم ",
      "markers": []
    },
    {
      "id": "s055",
      "start": 4303,
      "end": 4400,
      "text": " أيُّها المؤمنون، وعدوُّكم مِن المشركين عن مِيعادٍ منكم ومنهم، {لَاخْتَلَفْتُمْ فِي الْمِيعَادِ}؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4366,
          "end": 4399,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4400,
      "end": 4489,
      "text": " لكثرةِ عددِ عدوِّكم، وقلةِ عددِكم، ولكنَّ اللهَ جمَعَكم على غيرِ مِيعادٍ بينَكم وبينَهم؛",
      "markers": []
    },
    {
      "id": "s057",
      "start": 4489,
      "end": 4655,
      "text": " {لِيَقْضِيَ اللَّهُ أَمْرًا كَانَ مَفْعُولًا}، وذلك القضاءُ مِن اللهِ كان نصرَه أولياءَه مِن المؤمنين بالله ورسولِه، وهلاكَ أعدائِه وأعدائهم ببدرٍ؛ بالقتلِ والأسْرِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4490,
          "end": 4535,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4659,
      "end": 4687,
      "text": "كما حدَّثنا ابنُ حميدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4663,
          "end": 4670,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4687,
      "end": 4714,
      "text": " ثنا سلمةُ، عن ابنِ إسحاقَ:",
      "markers": []
    },
    {
      "id": "s060",
      "start": 4714,
      "end": 4770,
      "text": " {وَلَوْ تَوَاعَدْتُمْ لَاخْتَلَفْتُمْ فِي الْمِيعَادِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4715,
          "end": 4769,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4770,
      "end": 4913,
      "text": " ولو كان ذلك عن مِيعادٍ منكم ومنهم، ثم بلَغَكم كثرةُ عددِهم وقلةُ عددِكم ما لقِيتُموهم، {وَلَكِنْ لِيَقْضِيَ اللَّهُ أَمْرًا كَانَ مَفْعُولًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4858,
          "end": 4912,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4913,
      "end": 5014,
      "text": " أى: ليَقْضِيَ اللهُ ما أراد بقدرتِه مِن إعزازِ الإسلامِ وأهلِه، وإذلالِ الشركِ وأهلِه، عن غيرِ ملأٍ ",
      "markers": []
    },
    {
      "id": "s063",
      "start": 5032,
      "end": 5068,
      "text": " منكم، ففعَل ما أراد مِن ذلك بلطفِه ",
      "markers": []
    },
    {
      "id": "s064",
      "start": 5091,
      "end": 5092,
      "text": ".",
      "markers": []
    },
    {
      "id": "s065",
      "start": 5096,
      "end": 5142,
      "text": "حدَّثني يونُسُ، قال: أَخْبَرنا ابنُ وهبٍ، قال ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 5117,
          "end": 5126,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 5236,
      "end": 5258,
      "text": ": أَخْبَرنى يونُسُ عن ",
      "markers": []
    },
    {
      "id": "s067",
      "start": 5270,
      "end": 5375,
      "text": " ابنِ شهابٍ، قال: أخبرَنى عبدُ الرحمنِ بنُ عبدِ اللَّهِ بن كعبِ بنِ مالكٍ، أن عبدَ اللَّهِ بنَ كعبٍ، قال:",
      "markers": []
    },
    {
      "id": "s068",
      "start": 5375,
      "end": 5431,
      "text": " سَمِعْتُ كعبَ بنَ مالكٍ يقولُ في غزوةِ بدرٍ: إنما خرَج ",
      "markers": [
        {
          "family": "SIRA",
          "marker": "غزوة",
          "start": 5409,
          "end": 5413,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 5469,
      "end": 5600,
      "text": " رسولُ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- والمسلمون يُريدون عِيرَ قريشٍ، حتى جمَع اللهُ بينَهم وبينَ عدوِّهم على غيرِ مِيعادٍ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5483,
          "end": 5513,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 5624,
      "end": 5625,
      "text": ".",
      "markers": []
    },
    {
      "id": "s071",
      "start": 5629,
      "end": 5688,
      "text": "حدَّثني يعقوب، قال: ثنا ابنُ عليةَ، عن ابنِ عونٍ، عن عميرِ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5665,
          "end": 5686,
          "stripped": "عن ابن عون، عن عمير",
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 5779,
      "end": 6023,
      "text": " بنِ إسحاقَ، قال: أقْبَل أبو سفيانَ فى الركْبِ مِن الشامِ، وخرَج أبو جهلٍ ليَمْنَعَه مِن رسولِ اللهِ -صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ- وأصحابِه، فالْتَقَوْا ببدرٍ، ولا يَشْعُرُ هؤلاء بهؤلاء، ولا هؤلاء بهؤلاء، حتى الْتَقَت السُّقاةُ، قال: ونهَد ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5881,
          "end": 5911,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 6102,
      "end": 6123,
      "text": " الناسُ بعضُهم لبعضٍ ",
      "markers": []
    },
    {
      "id": "s074",
      "start": 6165,
      "end": 6166,
      "text": ".",
      "markers": []
    },
    {
      "id": "s075",
      "start": 6170,
      "end": 6203,
      "text": "القولُ في تأويلِ قولِه جلّ ثناؤه:",
      "markers": []
    },
    {
      "id": "s076",
      "start": 6203,
      "end": 6319,
      "text": " {لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ وَيَحْيَى مَنْ حَيَّ عَنْ بَيِّنَةٍ وَإِنَّ اللَّهَ لَسَمِيعٌ عَلِيمٌ (42)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6204,
          "end": 6318,
          "span_id": "s076"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6228,
          "end": 6303,
          "stripped": "عن بينة ويحيى من حي عن بينة وإن الله لسميع",
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 6323,
      "end": 6397,
      "text": "يقولُ تعالى ذِكرُه: ولكنَّ الله جمَعَهم هنالك ليَقْضِىَ أمرًا كان مفعولًا؛",
      "markers": []
    },
    {
      "id": "s078",
      "start": 6397,
      "end": 6438,
      "text": " {لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6398,
          "end": 6437,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 6442,
      "end": 6477,
      "text": "وهذه اللامُ فى قولِه: {لِيَهْلِكَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6464,
          "end": 6476,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 6477,
      "end": 6507,
      "text": " مكرَّرةٌ على اللامِ في قولِه:",
      "markers": []
    },
    {
      "id": "s081",
      "start": 6507,
      "end": 6573,
      "text": " {لِيَقْضِيَ}. كأنه قال: ولكن ليَهْلِكَ مَن هلَك عن بينةٍ، جمَعكم.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6508,
          "end": 6520,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 6577,
      "end": 6631,
      "text": "ويعنى بقولِه: {لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6591,
          "end": 6630,
          "span_id": "s082"
        }
      ]
    },
    {
      "id": "s083",
      "start": 6631,
      "end": 6787,
      "text": " ليموتَ مَن مات مِن خلقِه عن حُجَّةٍ للهِ قد أُثْبِتَت له، وقطَعَت عُذرَه، وعبرةٍ قد عايَنها ورآها، {وَيَحْيَى مَنْ حَيَّ عَنْ بَيِّنَةٍ}. يقولُ: ولِيعِيشَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6731,
          "end": 6768,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 6809,
      "end": 6916,
      "text": " مَن عاش منهم عن حُجَّةٍ للهِ قد أُثْبِتَت له، وظهَرَت لعينِه، فعلِمها، جمَعَنا بينَكم وبينَ عدوِّكم هنالك.",
      "markers": []
    },
    {
      "id": "s085",
      "start": 6920,
      "end": 6972,
      "text": "وقال ابنُ إسحاقَ فى ذلك بما حدَّثنا ابنُ حميدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6948,
          "end": 6955,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 6972,
      "end": 6999,
      "text": " ثنا سلمةُ، عن ابنِ إسحاقَ:",
      "markers": []
    },
    {
      "id": "s087",
      "start": 6999,
      "end": 7040,
      "text": " {لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7000,
          "end": 7039,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 7081,
      "end": 7082,
      "text": " ",
      "markers": []
    },
    {
      "id": "s089",
      "start": 7145,
      "end": 7207,
      "text": "؛ لما رأَى مِن الآياتِ والعبر، ويُؤْمِنَ مَن آمن على مثلِ ذلك ",
      "markers": []
    },
    {
      "id": "s090",
      "start": 7235,
      "end": 7236,
      "text": ".",
      "markers": []
    },
    {
      "id": "s091",
      "start": 7240,
      "end": 7288,
      "text": "وأما قولُه: {وَإِنَّ اللَّهَ لَسَمِيعٌ عَلِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7252,
          "end": 7287,
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 7288,
      "end": 7483,
      "text": " فإن معناه: {وَإِنَّ اللَّهَ} أيُّها المؤمنون {لَسَمِيعٌ} لقولِكم وقولِ غيرِكم حينَ يُرِى اللهُ نبيَّه في منامِه، ويُرِيكم عدوَّكم في أعينِكم قليلًا، وهم كثيرٌ، ويرَاكم عدوُّكم في أعينِهم قليلًا ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 7293,
          "end": 7298,
          "span_id": "s092"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7300,
          "end": 7317,
          "span_id": "s092"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7334,
          "end": 7345,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 7516,
      "end": 7597,
      "text": "، {عَلِيمٌ} بما تُضْمِرُه نفوسُكم، وتَنْطَوِى عليه قلوبُكم حينئذٍ، وفي كلِّ حالٍ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7518,
          "end": 7527,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 7601,
      "end": 7632,
      "text": "يقولُ جلَّ ثناؤُه لهم ولعبادِه:",
      "markers": []
    },
    {
      "id": "s095",
      "start": 7632,
      "end": 7802,
      "text": " واتَّقُوا ربَّكم أيُّها الناسُ في مَنْطِقِكم أن تَنْطِقوا بغيرِ حقٍّ، وفى قلوبِكم أن تَعتَقِدوا فيها غيرَ الرُّشْدِ، فإن اللهَ لا يَخْفَى عليه خافيةٌ مِن ظاهرٍ أو باطنٍ.",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s012",
      "start": 962,
      "end": 1081,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره 5/ 1707 من طريق محمد بن عبد الأعلى ببعضه، وأخرجه عبد الرزاق في تفسيره 1/ 259 عن معمر به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s017",
      "start": 1349,
      "end": 1568,
      "text": "¬في ص: \"اتخذم\". وفى م: \"انحدر\". وفى ت 1، ت 2، س، ف: \"اىحدم\" قال ابن الأثير: ومنه حديث قتادة في قوله تعالى: {وَالرَّكْبُ أَسْفَلَ مِنْكُمْ} قال:\"انجذم أبو سفيان بالعير\". أي: انقطع بها من الركب وسار. اهـ. النهاية 1/ 252.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s018",
      "start": 1593,
      "end": 1765,
      "text": "¬في ص، ت 2، س، ف: \"حورىىه\" وفى م: \"حوزته\" وفى ت 1: \"حوريته\". والحوزِيَّة المنحازة عن الإبل لا تخالطها. وقيل: بل التي عندها سير مذخور من سيرها مصون لا يدرك. اللسان (ح و ز).¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s023",

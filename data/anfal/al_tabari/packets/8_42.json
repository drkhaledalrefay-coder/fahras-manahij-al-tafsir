    {
      "id": "s001",
      "start": 4,
      "end": 131,
      "text": "القولُ في تأويلِ قولِه: {إِذْ أَنْتُمْ بِالْعُدْوَةِ الدُّنْيَا وَهُمْ بِالْعُدْوَةِ الْقُصْوَى وَالرَّكْبُ أَسْفَلَ مِنْكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28,
          "end": 130,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 135,
      "end": 391,
      "text": "يقولُ تعالى ذِكرُه: أيْقِنوا أيُّها المؤمنون، واعْلَموا أَن قَسْمَ الغَنيمة على ما بيَّنه لكم ربُّكم، إن كنتم آمَنْتُم باللهِ وما أَنْزَل على عبدِه يومَ بدرٍ، إذ فرَق بينَ الحقِّ والباطلِ، مِن نصرِ رسولِه، {إِذْ أَنْتُمْ} حينئذٍ {بِالْعُدْوَةِ الدُّنْيَا}.",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 283,
          "end": 291,
          "span_id": "s002"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 341,
          "end": 356,
          "span_id": "s002"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 364,
          "end": 390,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 391,
      "end": 470,
      "text": " يقولُ: بشَفيرِ الوادى الأدنَى إلى المدينةِ، {وَهُمْ بِالْعُدْوَةِ الْقُصْوَى}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 436,
          "end": 469,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 470,
      "end": 570,
      "text": " يقولُ: وعدوُّكم مِن المشركين نزولٌ بشَفيرِ الوادى الأقصى إلى مكةَ، {وَالرَّكْبُ أَسْفَلَ مِنْكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 538,
          "end": 569,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 570,
      "end": 648,
      "text": " يقولُ: والعِيرُ فيه أبو سفيانَ وأصحابُه في موضعٍ أسفلَ منكم إلى ساحلِ البحرِ.",
      "markers": []
    },
    {
      "id": "s006",
      "start": 652,
      "end": 694,
      "text": "وبنحوِ الذي قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s007",
      "start": 698,
      "end": 714,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s008",
      "start": 718,
      "end": 753,
      "text": "حدَّثنا محمدُ بنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",

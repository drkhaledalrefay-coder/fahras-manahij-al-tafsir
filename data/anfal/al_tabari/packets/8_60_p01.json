        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 883,
          "end": 901,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 902,
      "end": 955,
      "text": " {وَأَعِدُّوا لَهُمْ مَا اسْتَطَعْتُمْ مِنْ قُوَّةٍ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 903,
          "end": 954,
          "span_id": "s012"
        }

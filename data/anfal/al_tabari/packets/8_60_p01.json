      "start": 2564,
      "end": 2565,
      "text": ".",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2569,
      "end": 2598,
      "text": "حدَّثنا أحمدُ بنُ حميدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2569,
          "end": 2576,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 2598,
      "end": 2623,
      "text": " ثنا يحيى بنُ واضحٍ، قال:",
      "markers": []
    },
    {
      "id": "s031",
      "start": 2623,
      "end": 2766,
      "text": " ثنا موسى بنُ عُبيدةَ، عن أخيه محمدِ بن عُبيدة، عن أخيه عبدِ اللَّهِ بن عُبيدةَ، عن عقبةَ بن عامرٍ، عن النبيِّ - صلى الله عليه وسلم - في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2646,
          "end": 2694,
          "stripped": "عن أخيه محمد بن عبيدة، عن أخيه عبد الله بن",
          "span_id": "s031"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2704,
          "end": 2744,
          "stripped": "عن عقبة بن عامر، عن النبي - صلى الله",
          "span_id": "s031"
        },
        {
          "family": "HADITH",
          "marker": "النبي",
          "role": "SPEAKER",
          "start": 2726,
          "end": 2731,
          "span_id": "s031"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2736,
          "end": 2754,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2766,
      "end": 2843,
      "text": " {وَأَعِدُّوا لَهُمْ مَا اسْتَطَعْتُمْ مِنْ قُوَّةٍ}: \"ألا إن القوةَ الرميُ\" ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2767,
          "end": 2818,
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 3022,
      "end": 3023,
      "text": ".",
      "markers": []
    },
    {
      "id": "s034",
      "start": 3027,
      "end": 3110,
      "text": "حدَّثنا ابن وكيعٍ، قال: ثنا أبى، عن سفيانَ، عن شعبةَ بن دينارٍ، عن عكرمةَ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3027,
          "end": 3034,
          "span_id": "s034"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3060,
          "end": 3093,
          "stripped": "عن سفيان، عن شعبة بن دينار، عن",
          "span_id": "s034"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 3094,
          "end": 3099,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 3110,
      "end": 3163,
      "text": " {وَأَعِدُّوا لَهُمْ مَا اسْتَطَعْتُمْ مِنْ قُوَّةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3111,
          "end": 3162,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 3163,
      "end": 3219,
      "text": " قال: الحصونِ، {وَمِنْ رِبَاطِ الْخَيْلِ}. قال: الإناثِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3178,
          "end": 3204,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 3394,
      "end": 3395,
      "text": ".",
      "markers": []
    },
    {
      "id": "s038",
      "start": 3399,
      "end": 3427,
      "text": "حدَّثنا عليُّ بنُ سهلٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3399,
          "end": 3406,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 3427,
      "end": 3479,
      "text": " ثنا ضَمْرةُ بنُ ربيعةَ، عن رجاءِ بن أبي سلمةَ، قال:",
      "markers": []
    },
    {
      "id": "s040",
      "start": 3479,
      "end": 3526,
      "text": " لقِى رجلٌ مجاهدًا بمكةَ، ومع مجاهدٍ جُوَالِقٌ ",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3626,
      "end": 3685,
      "text": "، قال: فقال مجاهدٌ: هذا القوةِ. ومجاهدٌ يَتَجَهَّزُ للغزوِ ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3638,
          "end": 3643,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 3741,
      "end": 3742,
      "text": ".",
      "markers": []
    },
    {
      "id": "s043",
      "start": 3746,
      "end": 3777,
      "text": "حدَّثني محمدُ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3777,
      "end": 3805,
      "text": " ثنا أحمدُ بنُ المفضلِ، قال:",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3805,
      "end": 3894,
      "text": " ثنا أسْباطُ، عن السديِّ: {وَأَعِدُّوا لَهُمْ مَا اسْتَطَعْتُمْ مِنْ قُوَّةٍ}: مِن سلاحٍ ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 3822,
          "end": 3827,
          "span_id": "s045"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3831,
          "end": 3882,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3950,
      "end": 3951,
      "text": ".",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3955,
      "end": 4015,
      "text": "وأما قوله: {تُرْهِبُونَ بِهِ عَدُوَّ اللَّهِ وَعَدُوَّكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3966,
          "end": 4014,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 4015,
      "end": 4117,
      "text": " فقال ابن وكيعٍ: حدَّثنا أبي، عن إسرائيلَ، عن عثمانَ بن المغيرةِ الثَّقَفيِّ، عن مجاهدٍ، عن ابن عباسٍ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4032,
          "end": 4039,
          "span_id": "s048"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4045,
          "end": 4117,
          "stripped": "عن إسرائيل، عن عثمان بن المغيرة الثقفي، عن مجاهد، عن ابن عباس:",
          "span_id": "s048"
        },
        {
          "family": "SAHABA",
          "marker": "عثمان",
          "name": "عثمان",
          "role": "NARRATOR",
          "start": 4061,
          "end": 4066,
          "span_id": "s048"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 4096,
          "end": 4101,
          "span_id": "s048"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4107,
          "end": 4115,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 4117,
      "end": 4167,
      "text": " {تُرْهِبُونَ بِهِ عَدُوَّ اللَّهِ وَعَدُوَّكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4118,
          "end": 4166,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 4167,
      "end": 4208,
      "text": " قال: تُخْزُون به عدوَّ اللَّهِ وعدوَّكم ",
      "markers": []
    },
    {
      "id": "s051",
      "start": 4263,
      "end": 4264,
      "text": ".",
      "markers": []
    },
    {
      "id": "s052",
      "start": 4268,
      "end": 4298,
      "text": "حدَّثنا أحمدُ بنُ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4268,
          "end": 4275,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 4298,
      "end": 4374,
      "text": " ثنا أبو أحمدَ، قال: ثنا إسرائيلُ، عن عثمانَ، عن مجاهدٍ، عن ابن عباسٍ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4333,
          "end": 4374,
          "stripped": "عن عثمان، عن مجاهد، عن ابن عباس مثله.",
          "span_id": "s053"
        },
        {
          "family": "SAHABA",
          "marker": "عثمان",
          "name": "عثمان",
          "role": "NARRATOR",
          "start": 4336,
          "end": 4341,
          "span_id": "s053"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 4347,
          "end": 4352,
          "span_id": "s053"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 4358,
          "end": 4366,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4378,
      "end": 4422,
      "text": "حدَّثني الحارثُ، قال: ثنا عبدُ العزيزِ، قال:",
      "markers": []
    },
    {
      "id": "s055",
      "start": 4422,
      "end": 4489,
      "text": " ثنا إسرائيلُ، عن خُصَيْفٍ، عن عكرمة وسعيدِ بن جبيرٍ، عن ابن عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4437,
          "end": 4489,
          "stripped": "عن خصيف، عن عكرمة وسعيد بن جبير، عن ابن عباس:",
          "span_id": "s055"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 4453,
          "end": 4458,
          "span_id": "s055"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4479,
          "end": 4487,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4489,
      "end": 4539,
      "text": " {تُرْهِبُونَ بِهِ عَدُوَّ اللَّهِ وَعَدُوَّكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4490,
          "end": 4538,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4539,
      "end": 4597,
      "text": " قال: تُخْزُون به عدوَّ اللَّهِ وعدوَّكم، وكذا كان يقرؤها ",
      "markers": []
    },
    {
      "id": "s058",
      "start": 4616,
      "end": 4630,
      "text": ": (تُخْزُونَ) ",
      "markers": []
    },
    {
      "id": "s059",
      "start": 4763,
      "end": 4764,
      "text": ".",
      "markers": []
    },
    {
      "id": "s060",
      "start": 4768,
      "end": 4812,
      "text": "حدَّثني الحارثُ، قال: ثنا عبدُ العزيزِ، قال:",
      "markers": []
    },
    {
      "id": "s061",
      "start": 4812,
      "end": 4916,
      "text": " ثنا إسرائيلُ، عن عثمانَ بن المغيرةِ وخُصَيْفٍ، عن مجاهدٍ، عن ابن عباسٍ: {تُرْهِبُونَ بِهِ} تُخْزُون به.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4827,
          "end": 4884,
          "stripped": "عن عثمان بن المغيرة وخصيف، عن مجاهد، عن ابن عباس:",
          "span_id": "s061"
        },
        {
          "family": "SAHABA",
          "marker": "عثمان",
          "name": "عثمان",
          "role": "NARRATOR",
          "start": 4830,
          "end": 4835,
          "span_id": "s061"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 4863,
          "end": 4868,
          "span_id": "s061"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4874,
          "end": 4882,
          "span_id": "s061"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4885,
          "end": 4903,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4920,
      "end": 4950,
      "text": "حدَّثنا أحمدُ بنُ إسحاقَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4920,
          "end": 4927,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 4950,
      "end": 5028,
      "text": " ثنا أبو أحمدَ، قال: ثنا إسرائيلُ، عن خُصَيْفٍ، عن عكرمةَ، عن ابن عباسٍ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4985,
          "end": 5028,
          "stripped": "عن خصيف، عن عكرمة، عن ابن عباس مثله.",
          "span_id": "s063"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 5001,
          "end": 5006,
          "span_id": "s063"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 5012,
          "end": 5020,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 5032,
      "end": 5089,
      "text": "يقالُ منه: أَرْهَبْتُ العدوَّ ورهَّبْتُه، فأنا أُرْهِبُه ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 5032,
          "end": 5036,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 5101,
      "end": 5102,
      "text": " ",
      "markers": []
    },
    {
      "id": "s066",
      "start": 5130,
      "end": 5152,
      "text": " إِرْهابًا وتَرْهيبًا ",
      "markers": []
    },
    {
      "id": "s067",
      "start": 5188,
      "end": 5246,
      "text": "، وهو الرَّهَبُ والرُّهْبُ، ومنه قولُ طُفَيْلٍ الغَنَويِّ ",
      "markers": []
    },
    {
      "id": "s068",
      "start": 5260,
      "end": 5261,
      "text": ":",
      "markers": []
    },
    {
      "id": "s069",
      "start": 5265,
      "end": 5309,
      "text": "وَيْلُ أُمِّ حَيٍّ دَفَعْتُم فِي نُحورِهمُ .",
      "markers": []
    },
    {
      "id": "s070",
      "start": 5309,
      "end": 5350,
      "text": ".. بني كِلابٍ غَداةَ الرُّعْبِ والرَّهَبِ",
      "markers": []
    },
    {
      "id": "s071",
      "start": 5354,
      "end": 5447,
      "text": "القولُ في تأويلِ قولِه: {وَآخَرِينَ مِنْ دُونِهِمْ لَا تَعْلَمُونَهُمُ اللَّهُ يَعْلَمُهُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5378,
          "end": 5446,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 5451,
      "end": 5505,
      "text": "اخْتَلَف أهلُ التأويلِ في هؤلاء الآخرين مَن هم وما هم؟",
      "markers": []
    },
    {
      "id": "s073",
      "start": 5505,
      "end": 5534,
      "text": " فقال بعضُهم: هم بنو قُريظةَ.",
      "markers": []
    },
    {
      "id": "s074",
      "start": 5538,
      "end": 5554,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s075",
      "start": 5558,
      "end": 5592,
      "text": "حُدِّثْتُ عن عمارِ بن الحسنِ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 5580,
          "end": 5585,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 5592,
      "end": 5654,
      "text": " ثنا ابن أبي جعفرٍ، عن وَرْقاءَ، عن ابن أبي نَجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5612,
          "end": 5646,
          "stripped": "عن ورقاء، عن ابن أبي نجيح، عن",
          "span_id": "s076"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 5647,
          "end": 5652,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 5654,
      "end": 5707,
      "text": " {وَآخَرِينَ مِنْ دُونِهِمْ}. يعنى: مِن بني قُرَيظةَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5655,
          "end": 5682,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 5892,
      "end": 5893,
      "text": ".",
      "markers": []
    },
    {
      "id": "s079",
      "start": 5897,
      "end": 5926,
      "text": "حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s080",
      "start": 5926,
      "end": 5986,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابن أبي نَجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5957,
          "end": 5986,
          "stripped": "عن ابن أبي نجيح، عن مجاهد:",
          "span_id": "s080"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 5979,
          "end": 5984,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 5986,
      "end": 6028,
      "text": " {وَآخَرِينَ مِنْ دُونِهِمْ}. قال: قريظةَ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5987,
          "end": 6014,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 6032,
      "end": 6054,
      "text": "وقال آخرون: مِن فارسَ.",
      "markers": []
    },
    {
      "id": "s083",
      "start": 6058,
      "end": 6074,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s084",
      "start": 6078,
      "end": 6109,
      "text": "حدَّثني محمدَ بنُ الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s085",
      "start": 6109,
      "end": 6137,
      "text": " ثنا أحمدُ بنُ المفضلِ، قال:",
      "markers": []
    },
    {
      "id": "s086",
      "start": 6137,
      "end": 6249,
      "text": " ثنا أسباطُ، عن السديِّ: {وَآخَرِينَ مِنْ دُونِهِمْ لَا تَعْلَمُونَهُمُ اللَّهُ يَعْلَمُهُمْ}: هؤلاء أهلُ فارسَ ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 6153,
          "end": 6158,
          "span_id": "s086"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6162,
          "end": 6230,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 6314,
      "end": 6315,
      "text": ".",
      "markers": []
    },
    {
      "id": "s088",
      "start": 6319,
      "end": 6451,
      "text": "وقال آخرون: هم كلُّ عدوٍّ للمسلمين غيرِ الذي أُمِر النبيُّ - صلى الله عليه وسلم - أن يُشَرِّدَ بهم مَن خلفَهم، قالوا: وهم المنافقون.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6380,
          "end": 6398,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 6455,
      "end": 6471,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s090",
      "start": 6475,
      "end": 6519,
      "text": "حدَّثني يونُسُ، قال: أخْبرَنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6496,
          "end": 6504,
          "span_id": "s090"
        }
      ]
    },
    {
      "id": "s091",
      "start": 6519,
      "end": 6549,
      "text": " قال ابن زيدٍ في قولِ اللَّهِ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 6524,
          "end": 6531,
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 6549,
      "end": 6624,
      "text": " {فَإِمَّا تَثْقَفَنَّهُمْ فِي الْحَرْبِ فَشَرِّدْ بِهِمْ مَنْ خَلْفَهُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6550,
          "end": 6623,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 6624,
      "end": 6662,
      "text": " قال: أخِفْهم بهم لما تَصْنَعُ بهؤلاء.",
      "markers": []
    },
    {
      "id": "s094",
      "start": 6662,
      "end": 6738,
      "text": " وقرأ: {وَآخَرِينَ مِنْ دُونِهِمْ لَا تَعْلَمُونَهُمُ اللَّهُ يَعْلَمُهُمْ} ",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 6664,
          "end": 6667,
          "span_id": "s094"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6669,
          "end": 6737,
          "span_id": "s094"
        }
      ]
    },
    {
      "id": "s095",
      "start": 6801,
      "end": 6802,
      "text": ".",
      "markers": []
    },
    {
      "id": "s096",
      "start": 6806,
      "end": 6850,
      "text": "حدَّثني يونُسُ، قال: أخْبرَنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6827,
          "end": 6835,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 6850,
      "end": 6873,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 6855,
          "end": 6862,
          "span_id": "s097"
        }
      ]
    },
    {
      "id": "s098",
      "start": 6873,
      "end": 6943,
      "text": " {وَآخَرِينَ مِنْ دُونِهِمْ لَا تَعْلَمُونَهُمُ اللَّهُ يَعْلَمُهُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6874,
          "end": 6942,
          "span_id": "s098"
        }
      ]
    },
    {
      "id": "s099",
      "start": 6943,
      "end": 6980,
      "text": " قال: هؤلاء المنافقون لا تَعْلَمونهم؛",
      "markers": []
    },
    {
      "id": "s100",
      "start": 6980,
      "end": 7036,
      "text": " لأنهم معكم يقولون: لا إلهَ إلا اللَّهُ، ويَغْرُون معكم.",
      "markers": []
    },
    {
      "id": "s101",
      "start": 7040,
      "end": 7071,
      "text": "وقال آخرون: هم قومٌ مِن الجنِّ.",
      "markers": []
    },
    {
      "id": "s102",
      "start": 7075,
      "end": 7126,
      "text": "قال أبو جعفرٍ: والصوابُ مِن القولِ في ذلك أن يقالَ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 7120,
          "end": 7124,
          "span_id": "s102"
        }
      ]
    },
    {
      "id": "s103",
      "start": 7126,
      "end": 7303,
      "text": " إن اللَّهَ أمَر المؤمنين بإعدادِ الجهادِ وآلةِ الحربِ وما يَتَقَوَّون به على جهادِ عدوِّه وعدوِّهم مِن المشركين مِن السلاحِ والرمِي وغيرِ ذلك ورباطِ الخيلِ، ولا وجهَ لأن يقالَ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 7297,
          "end": 7301,
          "span_id": "s103"
        }
      ]
    },
    {
      "id": "s104",
      "start": 7303,
      "end": 7381,
      "text": " عُنِى بالقوةِ معنًى دونَ معنًى مِن معاني القوةِ، وقد عمَّ اللَّهُ الأمرَ بها.",
      "markers": []
    },
    {
      "id": "s105",
      "start": 7385,
      "end": 7505,
      "text": "فإن قال قائلٌ: فإن رسولَ اللَّهِ - صلى الله عليه وسلم - قد بيَّن أن ذلك مرادٌ به الخصوصُ بقولِه: \"ألا إن القوةَ الرميُ\"؟",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7420,
          "end": 7438,
          "span_id": "s105"
        }
      ]
    },
    {
      "id": "s106",
      "start": 7509,
      "end": 7639,
      "text": "قيل له: إن الخبرَ، وإن كان قد جاء بذلك فليس في الخبرِ ما يَدلُّ على أنه مرادٌ بها الرميُ خاصةً دونَ سائرِ معاني القوةِ عليهم، فإن ",
      "markers": []
    },
    {
      "id": "s107",
      "start": 7661,
      "end": 7712,
      "text": " الرميَ أحدُ معاني القوةِ؛ لأنه إنما قيل في الخبرِ:",
      "markers": []
    },
    {
      "id": "s108",
      "start": 7712,
      "end": 7748,
      "text": " \"ألا إن القوةَ الرمىُ\". ولم يُقَلْ:",
      "markers": []
    },
    {
      "id": "s109",
      "start": 7748,
      "end": 7980,
      "text": " دونَ غيرِها. ومن القوةِ أيضًا السيفُ والرمحُ والحربةُ، وكلُّ ما كان مَعونةً على قتالِ المشركين، كمعونةِ الرميِ أو أبْلَغَ مِن الرميِ فيهم وفى النِّكايةِ منهم، هذا مع وَهَاءِ سندِ الخبرِ بذلك عن رسولِ اللَّهِ - صلى الله عليه وسلم - ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7959,
          "end": 7977,
          "span_id": "s109"
        }
      ]
    },
    {
      "id": "s110",
      "start": 8124,
      "end": 8125,
      "text": ".",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [

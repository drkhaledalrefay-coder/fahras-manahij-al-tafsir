  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 152,
      "text": "القولُ في تأويلِ قولِه: {وَأَعِدُّوا لَهُمْ مَا اسْتَطَعْتُمْ مِنْ قُوَّةٍ وَمِنْ رِبَاطِ الْخَيْلِ تُرْهِبُونَ بِهِ عَدُوَّ اللَّهِ وَعَدُوَّكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 28,
          "end": 151,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 156,
      "end": 228,
      "text": "يقول تعالى ذكره: {وَأَعِدُّوا} لهؤلاء الذين كفروا بربِّهم الذين بينَكم] ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 173,
          "end": 186,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 240,
      "end": 254,
      "text": " وبينَهم عهدٌ ",
      "markers": []
    },
    {
      "id": "s004",
      "start": 282,
      "end": 380,
      "text": "، إذا خِفْتُم خيانتَهم وغدرَهم أيُّها المؤمنون باللَّهِ ورسولِه، {مَا اسْتَطَعْتُمْ مِنْ قُوَّةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 347,
          "end": 379,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 380,
      "end": 526,
      "text": " يقولُ: ما أَطَقْتُم أن تَعُدُّوه لهم مِن الآلاتِ التي تكونُ قوةً لكم عليهم مِن السلاحِ والخيلِ، {تُرْهِبُونَ بِهِ عَدُوَّ اللَّهِ وَعَدُوَّكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 477,
          "end": 525,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 526,
      "end": 593,
      "text": " يقولُ: تُخِيفون بإعدادِكم ذلك عدوَّ اللَّهِ وعدوَّكم مِن المشركين.",
      "markers": []
    },
    {
      "id": "s007",
      "start": 597,
      "end": 637,
      "text": "وبنحوِ ما قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s008",
      "start": 641,
      "end": 657,
      "text": "ذكرُ مَن قال ذلك",
      "markers": []
    },
    {
      "id": "s009",
      "start": 661,
      "end": 689,
      "text": "حدَّثنا أبو كريبٍ، قال: ثنا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 661,
          "end": 668,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 701,
      "end": 702,
      "text": " ",
      "markers": []
    },
    {
      "id": "s011",
      "start": 772,
      "end": 902,
      "text": "، قال: سمِعْتُ أسامةَ بنَ زيدٍ، عن صالحِ بن كَيْسانَ، عن رجلٍ مِن جُهَيْنةَ يَرْفَعُ الحديثَ إلى رسولِ اللَّهِ صلى الله عليه وسلم:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 804,
          "end": 855,
          "stripped": "عن صالح بن كيسان، عن رجل من جهينة يرفع",

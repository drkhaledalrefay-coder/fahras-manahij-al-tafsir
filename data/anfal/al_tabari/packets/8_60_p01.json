    },
    {
      "id": "s013",
      "start": 955,
      "end": 1009,
      "text": " \"ألا إن الرمْىَ هو القوةُ، ألا إن الرمْىَ هو القوةُ\".",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1013,
      "end": 1068,
      "text": "حدَّثنا أبو كُريبٍ، قال: ثنا سعيدُ بن شُرَحْبِيلَ، قال:",
      "markers": [
        {
          "family": "HADITH",

  "span_count": 8,
  "spans": [
    {
      "start": 0,
      "end": 117,
      "text": "{وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ (33)}.",
      "id": "s001"
    },
    {
      "start": 117,
      "end": 147,
      "text": "\n{33} فلو عاجلهم الله بالعقاب؛",
      "id": "s002"
    },
    {
      "start": 147,
      "end": 238,
      "text": " لما أبقى منهم باقيةً، ولكنَّه تعالى دَفَعَ عنهم العذابَ بسبب وجود الرسول بين أظهرهم، فقال:",
      "id": "s003"
    },
    {
      "start": 238,
      "end": 278,
      "text": " {وما كان الله لِيُعَذِّبَهم وأنت فيهم}:",
      "id": "s004"
    },
    {
      "start": 278,
      "end": 308,
      "text": " فوجوده - صلى الله عليه وسلم -",
      "id": "s005"
    },
    {
      "start": 320,
      "end": 482,
      "text": " أمَنَةٌ لهم من العذاب، وكانوا مع قولهم هذه المقالة التي يظهِرونها على رؤوس الأشهاد يدرون بقُبحها، فكانوا يخافون من وقوعها فيهم، فيستغفرونَ الله تعالى؛ فلهذا قال ",
      "id": "s006"
    },
    {
      "start": 520,
      "end": 564,
      "text": ": {وما كان الله ليُعَذِّبَهم وهم يستغفرونَ}:",
      "id": "s007"
    },
    {
      "start": 564,
      "end": 622,
      "text": " فهذا مانعٌ يمنع من وقوع العذاب بهم بعدما انعقدتْ أسبابُه.",
      "id": "s008"
    }
  ]
}
  "source_sha256": "83ec9e8887b0cc1fb5a93d035390ac3fba700578b6380f0ee63b389e2570de72",
  "source_char_length": 799,
  "author_char_length": 679,
  "span_count": 14,
  "spans": [
    {
      "start": 0,
      "end": 85,
      "text": "{فَإِمَّا تَثْقَفَنَّهُمْ فِي الْحَرْبِ فَشَرِّدْ بِهِمْ مَنْ خَلْفَهُمْ لَعَلَّهُمْ ",
      "id": "s001"
    },
    {
      "start": 100,
      "end": 101,
      "text": " ",
      "id": "s002"
    },
    {
      "start": 124,
      "end": 173,
      "text": " (57)}.\n{57} فإذْهابُ هؤلاء ومحقُهم هو المتعيِّن؛",
      "id": "s003"
    },
    {
      "start": 173,
      "end": 210,
      "text": " لئلاَّ يسري داؤهم لغيرهم، ولهذا قال:",
      "id": "s004"
    },
    {
      "start": 210,
      "end": 249,
      "text": " {فإمَّا تَثْقَفَنَّهُم في الحربِ}؛ أي:",
      "id": "s005"
    },
    {
      "start": 249,
      "end": 306,
      "text": " تجدنَّهم في حال المحاربة؛ بحيث لا يكون لهم عهدٌ وميثاقٌ.",
      "id": "s006"
    },
    {
      "start": 306,
      "end": 338,
      "text": " {فشَرِّدْ بهم مَنْ خلفَهم}؛ أي:",
      "id": "s007"
    },
    {
      "start": 338,
      "end": 389,
      "text": " نكِّل بهم غيرهم، وأوقِعْ بهم من العقوبة ما يصيرون ",
      "id": "s008"
    },
    {
      "start": 446,
      "end": 488,
      "text": " عبرةً لمن بعدهم، {لعلَّهم}؛ أي: من خلفهم ",
      "id": "s009"
    },
    {
      "start": 495,
      "end": 496,
      "text": " ",
      "id": "s010"
    },
    {
      "start": 514,
      "end": 547,
      "text": " صنيعهم؛ لئلاَّ يصيبهم ما أصابهم.",
      "id": "s011"
    },
    {
      "start": 547,
      "end": 674,
      "text": " وهذه من فوائد العقوبات والحدود المرتَّبة على المعاصي أنها سببٌ لازدجار من لم يعمل المعاصي بل وزجراً لمن عملها أن لا يعاوِدَها.",
      "id": "s012"
    },
    {
      "start": 674,
      "end": 751,
      "text": " ودل تقييدُ هذه العقوبة في الحرب أنَّ الكافر ولو كان كثير الخيانة سريع الغدر؛",
      "id": "s013"
    },
    {
      "start": 751,
      "end": 799,
      "text": " أنه إذا أُعْطِيَ عهداً؛ لا يجوز خيانته وعقوبته.",
      "id": "s014"
    }
  ]
}
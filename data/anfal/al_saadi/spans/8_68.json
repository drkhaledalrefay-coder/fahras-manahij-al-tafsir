  "spans": [
    {
      "start": 0,
      "end": 89,
      "text": "{لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ (68)}.",
      "id": "s001"
    },
    {
      "start": 89,
      "end": 123,
      "text": "\n{68} {لولا كتابٌ من الله سَبَقَ}:",
      "id": "s002"
    },
    {
      "start": 123,
      "end": 244,
      "text": " به القضاء والقدر؛ أنَّه قد أحلَّ لكم الغنائم، وأنَّ الله رفع عنكم أيُّها الأمة العذاب، {لمسَّكم فيما أخذتم عذابٌ عظيمٌ}.",
      "id": "s003"
    },
    {
      "start": 244,
      "end": 279,
      "text": " وفي الحديث: «لو نزل عذابٌ يوم بدر؛",
      "id": "s004"
    },
    {
      "start": 279,
      "end": 300,
      "text": " ما نجا منه إلا عمر» ",
      "id": "s005"
    },
    {
      "start": 409,
      "end": 410,
      "text": ".",
      "id": "s006"
    }
  ]
}
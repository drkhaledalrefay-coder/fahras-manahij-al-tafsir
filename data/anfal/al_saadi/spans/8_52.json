  "span_count": 8,
  "spans": [
    {
      "start": 0,
      "end": 161,
      "text": "{كَدَأْبِ آلِ فِرْعَوْنَ وَالَّذِينَ مِنْ قَبْلِهِمْ كَفَرُوا بِآيَاتِ اللَّهِ فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ إِنَّ اللَّهَ قَوِيٌّ شَدِيدُ الْعِقَابِ (52)}.",
      "id": "s001"
    },
    {
      "start": 161,
      "end": 201,
      "text": "\n{52} وهذه سنة الله في الأولين والآخرين؛",
      "id": "s002"
    },
    {
      "start": 201,
      "end": 233,
      "text": " فإنَّ دأب هؤلاء المكذِّبين؛ أي:",
      "id": "s003"
    },
    {
      "start": 233,
      "end": 313,
      "text": " سنتهم وما أجرى اللَّه عليهم من الهلاك بذنوبهم، {كدأب آل فرعون والذين من قبلهم}:",
      "id": "s004"
    },
    {
      "start": 313,
      "end": 366,
      "text": " من الأمم المكذبة، {كفروا بآياتِ الله فأخَذَهم الله}:",
      "id": "s005"
    },
    {
      "start": 366,
      "end": 413,
      "text": " بالعقاب {بذنوبهم إنَّ الله قويٌّ شديد العقاب}:",
      "id": "s006"
    },
    {
      "start": 413,
      "end": 440,
      "text": " لا يعجِزُه أحدٌ يريد أخذه.",
      "id": "s007"
    },
    {
      "start": 440,
      "end": 478,
      "text": " {ما من دابَّةٍ إلا هو آخذٌ بناصيتها}.",
      "id": "s008"
    }
  ]
}
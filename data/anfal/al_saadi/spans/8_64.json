  "spans": [
    {
      "start": 0,
      "end": 85,
      "text": "{يَاأَيُّهَا النَّبِيُّ حَسْبُكَ اللَّهُ وَمَنِ اتَّبَعَكَ مِنَ الْمُؤْمِنِينَ (64)}.",
      "id": "s001"
    },
    {
      "start": 85,
      "end": 133,
      "text": "\n{64} ثم قال تعالى: {يا أيها النبيُّ حسبك الله}؛",
      "id": "s002"
    },
    {
      "start": 133,
      "end": 171,
      "text": " أي: كافيك، {ومن اتَّبعك من المؤمنين}؛",
      "id": "s003"
    },
    {
      "start": 171,
      "end": 201,
      "text": " أي: وكافي أتباعك من المؤمنين.",
      "id": "s004"
    },
    {
      "start": 201,
      "end": 283,
      "text": " وهذا وعدٌ من الله لعباده المؤمنين المتَّبعين لرسوله بالكفاية والنصرة على الأعداء؛",
      "id": "s005"
    },
    {
      "start": 283,
      "end": 326,
      "text": " فإذا أتوا بالسبب الذي هو الإيمان والاتباع؛",
      "id": "s006"
    },
    {
      "start": 326,
      "end": 418,
      "text": " فلا بدَّ أن يكفِيَهم ما أهمَّهم من أمور الدين والدنيا، وإنما تتخلَّف الكفاية بتخلُّف شرطها.",
      "id": "s007"
    }
  ]
}
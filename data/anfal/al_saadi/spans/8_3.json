  "spans": [
    {
      "start": 0,
      "end": 73,
      "text": "{الَّذِينَ يُقِيمُونَ الصَّلَاةَ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ (3)}.",
      "id": "s001"
    },
    {
      "start": 73,
      "end": 144,
      "text": "\n{3} {الذين يقيمون الصلاة}: من فرائض ونوافل، بأعمالها الظاهرة والباطنة؛",
      "id": "s002"
    },
    {
      "start": 144,
      "end": 217,
      "text": " كحضور القلب فيها، الذي هو رُوح الصلاة ولُبُّها، {ومما رزقْناهم ينفقونَ}:",
      "id": "s003"
    },
    {
      "start": 217,
      "end": 317,
      "text": " النفقاتِ الواجبةَ؛ كالزكوات والكفَّارات والنفقة على الزوجات والأقارب وما ملكت أيمانهم، والمستحبَّة؛",
      "id": "s004"
    },
    {
      "start": 317,
      "end": 344,
      "text": " كالصدقة في جميع طرق الخير.",
      "id": "s005"
    }
  ]
}
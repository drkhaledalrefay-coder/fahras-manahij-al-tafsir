  "spans": [
    {
      "start": 0,
      "end": 127,
      "text": "{ذَلِكَ بِأَنَّهُمْ شَاقُّوا اللَّهَ وَرَسُولَهُ وَمَنْ يُشَاقِقِ اللَّهَ وَرَسُولَهُ فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ (13)}.",
      "id": "s001"
    },
    {
      "start": 127,
      "end": 167,
      "text": "\n{13} ذلك لأنَّهم شاقُّوا اللهَ ورسولَه؛",
      "id": "s002"
    },
    {
      "start": 167,
      "end": 252,
      "text": " أي: حاربوهما وبارزوهما بالعداوة، {ومَن يشاقِقِ اللهَ ورسوله فإنَّ الله شديد العقاب}:",
      "id": "s003"
    },
    {
      "start": 252,
      "end": 298,
      "text": " ومن عقابه تسليطُ أوليائه على أعدائه وتقتيلهم.",
      "id": "s004"
    }
  ]
}
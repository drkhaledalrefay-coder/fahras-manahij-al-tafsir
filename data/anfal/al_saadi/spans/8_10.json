  "spans": [
    {
      "start": 0,
      "end": 151,
      "text": "{وَمَا جَعَلَهُ اللَّهُ إِلَّا بُشْرَى وَلِتَطْمَئِنَّ بِهِ قُلُوبُكُمْ وَمَا النَّصْرُ إِلَّا مِنْ عِنْدِ اللَّهِ إِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ (10)}.",
      "id": "s001"
    },
    {
      "start": 151,
      "end": 177,
      "text": "\n{10} {وما جعله الله}؛ أي:",
      "id": "s002"
    },
    {
      "start": 177,
      "end": 208,
      "text": " إنزال الملائكة {إلا بشرى}؛ أي:",
      "id": "s003"
    },
    {
      "start": 208,
      "end": 253,
      "text": " لتستبشر بذلك نفوسكم، {ولتطمئنَّ به قلوبُكم}:",
      "id": "s004"
    },
    {
      "start": 253,
      "end": 307,
      "text": " وإلاَّ؛ فالنصر بيد الله، ليس بكثرة عَدَدٍ ولا عُدَدٍ.",
      "id": "s005"
    },
    {
      "start": 307,
      "end": 423,
      "text": " {إن الله عزيزٌ}: لا يغالبُه مغالبٌ، بل هو القهار الذي يخذل من بلغوا من الكثرة وقوة العدد والآلات ما بلغوا، {حكيمٌ}:",
      "id": "s006"
    },
    {
      "start": 423,
      "end": 471,
      "text": " حيث قدَّر الأمور بأسبابها ووضع الأشياء مواضعها.",
      "id": "s007"
    }
  ]
}
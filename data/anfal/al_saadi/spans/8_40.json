  "spans": [
    {
      "start": 0,
      "end": 101,
      "text": "{وَإِنْ تَوَلَّوْا فَاعْلَمُوا أَنَّ اللَّهَ مَوْلَاكُمْ نِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ (40)}.",
      "id": "s001"
    },
    {
      "start": 101,
      "end": 191,
      "text": "\n{40} {وإن تولَّوا}: عن الطاعة، وأوضعوا في الإضاعة، {فاعلموا أنَّ الله مولاكم نعم المولى}:",
      "id": "s002"
    },
    {
      "start": 191,
      "end": 251,
      "text": " الذي يتولَّى عباده المؤمنين، ويوصِلُ إليهم مصالحهم وييسِّر ",
      "id": "s003"
    },
    {
      "start": 274,
      "end": 325,
      "text": " لهم منافعهم الدينيَّة والدنيويَّة. {ونعم النصيرُ}:",
      "id": "s004"
    },
    {
      "start": 325,
      "end": 408,
      "text": " الذي ينصُرُهم فيدفع عنهم كيدَ الفجَّار وتكالب الأشرار، ومَن كان الله مولاه وناصره؛",
      "id": "s005"
    },
    {
      "start": 408,
      "end": 444,
      "text": " فلا خوفٌ عليه، ومَنْ كان الله عليه؛",
      "id": "s006"
    },
    {
      "start": 444,
      "end": 470,
      "text": " فلا عزَّ له ولا قائمة له.",
      "id": "s007"
    }
  ]
}
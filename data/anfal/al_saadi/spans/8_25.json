  "span_count": 7,
  "spans": [
    {
      "start": 0,
      "end": 124,
      "text": "{وَاتَّقُوا فِتْنَةً لَا تُصِيبَنَّ الَّذِينَ ظَلَمُوا مِنْكُمْ خَاصَّةً وَاعْلَمُوا أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ (25)}.",
      "id": "s001"
    },
    {
      "start": 124,
      "end": 183,
      "text": "\n{25} {واتَّقوا فتنةً لا تُصيبَنَّ الذين ظلموا منكم خاصةً}:",
      "id": "s002"
    },
    {
      "start": 183,
      "end": 242,
      "text": " بل تصيب فاعل الظُّلم وغيره، وذلك إذا ظهر الظلم فلم يغيَّر؛",
      "id": "s003"
    },
    {
      "start": 242,
      "end": 275,
      "text": " فإنَّ عقوبته تعمُّ الفاعل وغيره.",
      "id": "s004"
    },
    {
      "start": 275,
      "end": 382,
      "text": " وتقوى هذه الفتنة بالنهي عن المنكر وقمع أهل الشرِّ والفساد وأن لا يُمَكَّنوا من المعاصي والظُّلم مهما أمكن.",
      "id": "s005"
    },
    {
      "start": 382,
      "end": 416,
      "text": " {واعلموا أنَّ الله شديدُ العقاب}:",
      "id": "s006"
    },
    {
      "start": 416,
      "end": 450,
      "text": " لمن تعرَّض لمساخطِهِ وجانبَ رضاه.",
      "id": "s007"
    }
  ]
}
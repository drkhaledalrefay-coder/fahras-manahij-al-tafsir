  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1142,
      "end": 1257,
      "text": "¬أخرجه البيهقي من طريق ابن إسحاق به (دلائل النبوة 3/ 140 - 141)، وسنده ضعيف لإبهام شيخ العباس بن عبد الله بن مغفل.¥",
      "attached_span_id": "s009",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1738,
      "end": 1809,
      "text": "¬أخرجه البيهقي، وهو تتمة لسابقه وحكمه مثله، ولبعضه شواهد سابقة ولاحقة.¥",
      "attached_span_id": "s015",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2000,
      "end": 2073,
      "text": "¬أخرجه البخاري من طريق موسى بن عقبة به (الصحيح، المغازي، باب 12 ح 4018).¥",
      "attached_span_id": "s019",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3332,
      "end": 3370,
      "text": "¬سنده مرسل ولبعضه شواهد سابقة ولاحقة.¥",
      "attached_span_id": "s030",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3462,
      "end": 3736,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق ابن إسحاق إذ صرح بالسماع، وكذا أخرجه الطبراني (المعجم الكبير 11/ 171 ح 11398)، وقال الهيثمي: رواه الطبراني في الأوسط والكبير باختصار، ورجال الأوسط رجال الصحيح (المجمع 7/ 28)، وطريق الطبراني في الأوسط (9/ 48 ح 8103) من طريق ابن إسحاق به.¥",
      "attached_span_id": "s031",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4116,
      "end": 4270,
      "text": "¬أخرجه الطبري بسنده ومتنه، وفي سنده ابن وكيع وهو سفيان فيه مقال ولكنه توبع في رواية ابن أبي حاتم والطبراني كما في الرواية السابقة فقد أخرجاه من طرق أخرى.¥",
      "attached_span_id": "s035",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4508,
      "end": 4590,
      "text": "¬أخرجه الطبري من طريق ابن إسحاق به، وسنده ضعيف ويتقوى بالروايات السابقة واللاحقة.¥",
      "attached_span_id": "s038",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5225,
      "end": 5319,
      "text": "¬أخرجه الطبري من طريق ابن جريج به، وسنده ضعيف ويتقوى بما سبق وبرواية علي بن أبي طلحة التالية.¥",
      "attached_span_id": "s045",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5411,
      "end": 5452,
      "text": "¬أخرجه الطبري بسند رجاله ثقات لكنه مرسل.¥",
      "attached_span_id": "s047",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6444,
      "end": 6597,
      "text": "¬أخرجه الحاكم من طريق هاشم بن القاسم عن سليمان بن المغيرة به وصححه ووافقه الذهبي (المستدرك 3/ 329)، وأصله في صحيح البخاري كما سيأتي بعد الرواية التالية.¥",
      "attached_span_id": "s058",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7463,
      "end": 7563,
      "text": "¬أخرجه البيهقي في (السنن الكبرى 6/ 356)، وأخرجه البخاري معلقًا من طريق إبراهيم بن طهمان به كما يلي.¥",
      "attached_span_id": "s067",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7687,
      "end": 8087,
      "text": "¬أخرجه البخاري تعليقًا عن إبراهيم بن طهمان به (الصحيح، الصلاة، باب القسمة وتعليق القنو في المسجد ح 421)، ووصله عمر بن محمد البجيري عن إبراهيم بن طهمان به (تغليق التعليق 2/ 228)، والبجيري هذا له مستخرج على صحيح البخاري، وهذه الرواية منه، وهذا المستخرج مغمور لم يذكره أحد، وقد عرفت هذا المستخرج حينما اتحفني فضيلة د. محمد بكر عابد بنسخة خطية من كتب البجيري فوجدته كله مستخرجًا على البخاري، والحمد لله.¥",
      "attached_span_id": "s069",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

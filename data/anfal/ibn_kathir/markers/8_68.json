  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 872,
      "end": 931,
      "text": "¬تقدم تخريجه وصحته في تفسير الآية 9 من هذه السورة الكريمة.¥",
      "attached_span_id": "s013",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2334,
      "end": 2345,
      "text": "¬أي فقراء.¥",
      "attached_span_id": "s034",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2830,
      "end": 2998,
      "text": "¬أخرجه الإمام أحمد عن أبي معاوية به (المسند 6/ 140 ح 3632)، وضعفه محققوه لأن أبا عبيدة لم يسمع من ابن مسعود، وذكروا أن لبعضه شواهد في صحيح مسلم. أي في الرواية السابقة.¥",
      "attached_span_id": "s038",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4150,
      "end": 4285,
      "text": "¬أخرجه الحاكم وصححه ووافقه الذهبي (المستدرك 2/ 329)، وفي سنده إبراهيم بن مهاجر فيه مقال كما\r\nفي التقريب، ومعظمه له شواهد سابقة ولاحقة.¥",
      "attached_span_id": "s052",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4655,
      "end": 4869,
      "text": "¬سنن الترمذي، السير، باب ما جاء في قتل الأسارى والفداء (ح 1567)، والسنن الكبرى للنسائي (ح 8662)، ومتنه يخالف قوله تعالى: {مَا كَانَ لِنَبِيٍّ أَنْ يَكُونَ لَهُ أَسْرَى حَتَّى يُثْخِنَ فِي الْأَرْضِ} [الأنفال: 67].¥",
      "attached_span_id": "s057",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4917,
      "end": 4966,
      "text": "¬الزيادة من المستدرك (2/ 140) وهو محمد بن سيرين.¥",
      "attached_span_id": "s059",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5191,
      "end": 5286,
      "text": "¬أخرجه الحاكم من طريق أزهر بن سعد السمان عن ابن عون به، وصححه ووافقه الذهبي (المستدرك 2/ 140).¥",
      "attached_span_id": "s063",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5328,
      "end": 5410,
      "text": "¬أخرجه الطبري من طريق محمد بن سيرين عن عبيدة، وسنده صحيح لكنه مرسل ويتقوى بسابقه.¥",
      "attached_span_id": "s064",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5672,
      "end": 5770,
      "text": "¬سنده حسن وقد صرح ابن إسحاق بالتحديث، وصرح بأن عطاء هو ابن أبي رباح (سيرة ابن هشام 2/ 675 - 676).¥",
      "attached_span_id": "s068",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5804,
      "end": 5854,
      "text": "¬أخرجه الطبري بسنده صحيح من طريق ابن أبي نجيح به.¥",
      "attached_span_id": "s069",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5955,
      "end": 6170,
      "text": "¬قول سعد أخرجه ابن أبي حاتم بسند صحيح من طريق خيثمة عنه، وقول سعيد بن جبير أخرجه ابن أبي حاتم بسند حسن من طريق عطاء بن دينار به، وقول الأعمش أخرجه الطبري بسند صحيح من طريق معمر عنه قال: سبق من الله أحل لهم الغنيمة.¥",
      "attached_span_id": "s070",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6262,
      "end": 6308,
      "text": "¬أخرجه ابن أبي حاتم من طريق شعبة به بسند حسن.¥",
      "attached_span_id": "s072",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6350,
      "end": 6394,
      "text": "¬أخرجه ابن أبي حاتم من طريق قبيصة عن سفيان.¥",
      "attached_span_id": "s073",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6594,
      "end": 6640,
      "text": "¬أخرجه ابن أبي حاتم بسند ثابت من طريق علي به.¥",
      "attached_span_id": "s076",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6739,
      "end": 6797,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق العوفي به ويتقوى بما سبق.¥",
      "attached_span_id": "s078",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6968,
      "end": 7268,
      "text": "¬قول أبي هريرة أخرجه الطبري وابن أبي حاتم بسند فيه بشير بن ميمون وهو متروك متهم كما في التقريب، وأخرجه الطبري من طريق آخر عن الأعمش عن أبي صالح عن أبي هريرة وصححه أحمد شاكر، وقول ابن مسعود أخرجه الطبري من طريق أبي وائل عنه وصححه أحمد شاكر، وقول قتادة والأعمش والحسن البصري أخرجه الطبري بأسانيد صحاح.¥",
      "attached_span_id": "s079",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7639,
      "end": 7684,
      "text": "¬تقدم تخريجه في تفسير آية 43 من سورة النساء.¥",
      "attached_span_id": "s084",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7822,
      "end": 8019,
      "text": "¬أخرجه الترمذي من طريق الأعمش به وقال: حسن صحيح (السنن، تفسير القرآن، باب ومن سورة الأنفال ح 3085)، وصححه الألباني في صحيح سنن الترمذي (ح 2463)، وأخرجه الإمام أحمد وصححه أحمد شاكر (المسند ح 7427).¥",
      "attached_span_id": "s087",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8347,
      "end": 8476,
      "text": "¬أخرجه أبو داود في سننه، الجهاد، باب فداء الأسير بالمال (ح 2691)، وصححه الألباني دون لفظ: الأربعمائة (صحيح سنن أبي داود ح 2340).¥",
      "attached_span_id": "s090",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8804,
      "end": 8920,
      "text": "¬أخرجه مسلم مطولًا عن سلمة بن الأكوع - رضي الله عنه - (الصحيح، الجهاد، باب التنفيل وفداء المسلمين بالأسارى ح 1755).¥",
      "attached_span_id": "s091",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

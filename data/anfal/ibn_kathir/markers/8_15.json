  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 539,
      "end": 663,
      "text": "¬قول سعيد بن جبير أخرجه ابن أبي حاتم بسند حسن من طريق عطاء بن دينار عنه وقول السدي أخرجه الطبري بسند حسن من طريق أسباط عنه.¥",
      "attached_span_id": "s005",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 821,
      "end": 887,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق جويبر عن الضحاك، ويشهد له سابقاه.¥",
      "attached_span_id": "s007",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1177,
      "end": 1207,
      "text": "¬أي جالوا جولة يطلبون الفرار.¥",
      "attached_span_id": "s010",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1497,
      "end": 1521,
      "text": "¬أي الكرارون إلى الحرب.¥",
      "attached_span_id": "s013",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1581,
      "end": 1676,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 9/ 282 ح 5384)، وضعف سنده محققوه لضعف يزيد بن أبي زياد.¥",
      "attached_span_id": "s014",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1796,
      "end": 1858,
      "text": "¬سنن الترمذي، الجهاد، باب ما جاء في الفرار من الزحف (ح 1716).¥",
      "attached_span_id": "s016",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2002,
      "end": 2066,
      "text": "¬أخرجه ابن أبي حاتم من الطريق نفسه مع الزيادة، وفيه أيضًا يزيد.¥",
      "attached_span_id": "s017",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2178,
      "end": 2332,
      "text": "¬أبو عبيد هو الصحابي الجليل ابن مسعود الثقفي، وهو صاحب يوم الجسر، المعروف بجسر أبي عبيد الذي قاتل الفرس وأنكى فيهم، وكان قائد المعركة بعد خالد بن الوليد.¥",
      "attached_span_id": "s019",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2460,
      "end": 2635,
      "text": "¬أخرجه ابن المبارك عن ابن عون عن محمد بن سيرين به (الجهاد 233)، وكذا ابن أبي شيبة (المصنف 12/ 536)، وفيه محمد بن سيرين لم يسمع عمر ولكنه توبع بواسطة أبي عثمان النهدي كما يلي:¥",
      "attached_span_id": "s021",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2724,
      "end": 2848,
      "text": "¬أخرجه ابن المبارك (الجهاد 234)، وابن أبي شيبة (المصنف 12/ 538)، وكلاهما من طريق سليمان التيمي عن أبي عثمان به، وسنده صحيح.¥",
      "attached_span_id": "s023",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2890,
      "end": 2979,
      "text": "¬أخرجه الثوري في تفسيره وابن المبارك (الجهاد 262) به، ومجاهد لم يسمع عمر، ويقويه ما سبق.¥",
      "attached_span_id": "s024",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3089,
      "end": 3167,
      "text": "¬أخرجه ابن أبي حاتم، وفي سنده إسماعيل بن إبراهيم البجلي ضعيف ويشهد له ما سبق.¥",
      "attached_span_id": "s026",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3538,
      "end": 3582,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده حسن.¥",
      "attached_span_id": "s032",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3740,
      "end": 3795,
      "text": "¬أخرجه ابن أبي حاتم بسند ضعيف من طريق جويبر عن الضحاك.¥",
      "attached_span_id": "s034",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4167,
      "end": 4334,
      "text": "¬صحيح البخاري، الوصايا باب قول الله تعالى: {إِنَّ الَّذِينَ يَأْكُلُونَ أَمْوَالَ الْيَتَامَى ظُلْمًا} [النساء: 10] (ح 2766)، وصحيح مسلم، الإيمان، باب الكبائر (ح 89).¥",
      "attached_span_id": "s038",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5254,
      "end": 5351,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه 36/ 284 (ح 21952)، قال الهيثمي: ورجال أحمد موثقون (المجمع 1/ 42).¥",
      "attached_span_id": "s048",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5677,
      "end": 5778,
      "text": "¬أخرجه الطبراني بسنده ومتنه (المعجم الكبير 2/ 95)، وضعفه الهيثمي لضعف يزيد بن ربيعة (المجمع 1/ 104).¥",
      "attached_span_id": "s053",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6147,
      "end": 6426,
      "text": "¬أخرجه الطبراني بسنده ومتنه (المعجم الكبير 5/ 89 ح 4670)، وأخرجه أبو داود من طريق موسى بن إسماعيل به (السنن، الصلاة، باب في الاستغفار ح 1517)، وصححه الألباني في صحيح سنن أبي داود (ح 1343)، وكذا الترمذي أخرجه من طريق موسى بن إسماعيل به (السنن، الدعوات، باب في دعاء الضيف ح 3577).¥",
      "attached_span_id": "s059",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6956,
      "end": 7234,
      "text": "¬بعض هذه الأقوال أخرجها الطبري وابن أبي حاتم بأسانيد ثابتة، وقول أبي سعيد أخرجه أبو داود من طريق أبي نضرة عن أبي سعيد، وهو الخدري، (السنن، الجهاد، باب في التولي يوم الزحف ح 2648)، وصححه\r\nألباني في صحيح سنن أبي داود (ح 2306)، وأخرجه الحاكم وصححه ووافقه الذهبي (المستدرك 2/ 327).¥",
      "attached_span_id": "s065",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7390,
      "end": 7474,
      "text": "¬أخرجه مسلم من حديث عمر (الصحيح، الجهاد، باب الإمداد بالملائكة في غزوة بدر ح 1763).¥",
      "attached_span_id": "s067",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7664,
      "end": 7735,
      "text": "¬أخرجه ابن المبارك به (الجهاد 232) وسنده حسن لكنه مرسل ويتقوى بما سبق.¥",
      "attached_span_id": "s070",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8335,
      "end": 8371,
      "text": "¬سنده ضعيف لإرسال يزيد بن أبي حبيب.¥",
      "attached_span_id": "s076",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8591,
      "end": 8623,
      "text": "¬تقدم تخريجه وصحته قبل روايتين.¥",
      "attached_span_id": "s079",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8791,
      "end": 8823,
      "text": "¬تقدم تخريجه في الصفحة السابقة.¥",
      "attached_span_id": "s080",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

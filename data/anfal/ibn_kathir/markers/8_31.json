  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 542,
      "end": 757,
      "text": "¬قول سعيد بن جبير أخرجه الطبري بسند صحيح من طريق أبي بشر جعفر عنه، وقول السدي أخرجه الطبري بسند حسن من طريق أسباط عنه، وهذان مرسلان يقوي أحدهما الآخر، وقول ابن جريج أخرجه الطبري بسند ضعيف ويتقوى بالمرسلين السابقين.¥",
      "attached_span_id": "s004",
      "grading": [
        "صحيح",
        "حسن",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1953,
      "end": 2003,
      "text": "¬أخرجه الطبري بسنده ومتنه، ورجاله ثقات لكنه مرسل.¥",
      "attached_span_id": "s015",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2091,
      "end": 2148,
      "text": "¬أخرجه الطبري عن يعقوب عن هشيم به، رجاله ثقات لكنه مرسل.¥",
      "attached_span_id": "s016",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2321,
      "end": 2469,
      "text": "¬أخرجه البخاري من حديث جبير بن مطعم - رضي الله عنه - (الصحيح، فرض الخمس، باب ما منَّ النبي - صلى الله عليه وسلم - على الأسارى من غير الخمس ح 3139).¥",
      "attached_span_id": "s018",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }

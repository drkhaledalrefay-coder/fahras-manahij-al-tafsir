  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 541,
      "end": 668,
      "text": "¬أخرج البخاري المعلق والموصول بسنده ومتنه (الصحيح، التفسير باب قوله: {يَسْأَلُونَكَ عَنِ الْأَنْفَالِ. . .} [الأنفال] ح 4645).¥",
      "attached_span_id": "s008",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 826,
      "end": 872,
      "text": "¬أخرجه ابن أبي حاتم بسند ثابت من طريق علي به.¥",
      "attached_span_id": "s010",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 999,
      "end": 1177,
      "text": "¬ذكرهم كلهم ابن أبي حاتم بحذف السند، وقول مجاهد وعطاء، وهو ابن أبي رباح، وقتادة وعبد الرحمن بن زيد أخرجه الطبري بأسانيد صحيحة إليهم، وقول عطاء الخراساني أخرجه في تفسيره بتحقيقي.¥",
      "attached_span_id": "s011",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1243,
      "end": 1292,
      "text": "¬سنده ضعيف لضعف الكلبي وأبي صالح ويتقوى بما سبق.¥",
      "attached_span_id": "s012",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1309,
      "end": 1430,
      "text": "¬وهو الصحابي الجليل الشاعر لبيد بن ربيعة - رضي الله عنه -، والبيت ورد في ديوانه 2/ 11 ومجاز القرآن 1/ 240 وتفسير الطبري.¥",
      "attached_span_id": "s013",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }

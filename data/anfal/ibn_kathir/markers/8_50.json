  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 394,
      "end": 479,
      "text": "¬أخرجه الطبري من طريق ابن جريج به، وأخرجه من طرق أقوى عن مجاهد فيه متابعة لابن جريج.¥",
      "attached_span_id": "s004",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 615,
      "end": 695,
      "text": "¬أخرجه الطبري من طريق ابن جريج به، وسنده ضعيف لأن ابن جريج لم يسمع من ابن عباس.¥",
      "attached_span_id": "s006",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 836,
      "end": 885,
      "text": "¬أخرجه الطبري بسند صحيح من طريق ابن أبي نجيح به.¥",
      "attached_span_id": "s008",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 954,
      "end": 993,
      "text": "¬أخرجه الثوري في تفسيره به وسنده صحيح.¥",
      "attached_span_id": "s009",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1096,
      "end": 1153,
      "text": "¬أخرجه الطبري بسند صحيح من طريق شعبة عن يعلى بن مسلم به.¥",
      "attached_span_id": "s010",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1178,
      "end": 1234,
      "text": "¬أخرجه الطبري بسند صحيح من طريق حرملة عن عمر مولى غفرة.¥",
      "attached_span_id": "s011",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1632,
      "end": 1921,
      "text": "¬صحيح البخاري، التفسير، سورة الأنفال، باب قوله: {وَإِذْ قَالُوا اللَّهُمَّ إِنْ كَانَ هَذَا هُوَ الْحَقَّ مِنْ عِنْدِكَ} [الأنفال: 32] (ح 4648)، وقد ثبت أيضًا أنها نزلت في النضر بن الحارث كما سيأتي قال الحافظ ابن حجر: ولا ينافي ذلك ما في الصحيح لاحتمال أن يكونا قالاه (فتح الباري 8/ 309).¥",
      "attached_span_id": "s012",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2384,
      "end": 2737,
      "text": "¬في سنده إبهام شيخ الأعمش، وقد صرح باسمه النسائي فأخرجه من طريق الأعمش عن المنهال بن عمرو عن سعيد بن جبير عن ابن عباس بدون ذكر آية الأنفال (السنن الكبرى، التفسير، باب سورة المعارج ح 11620)، وفي سنده المنهال بن عمرو وهو صدوق ربما وهم (التقريب ص 547). ويتقوى بالآثار التالية، فسنده حسن. وأخرجه الحاكم من طريق الأعمش وصححه ووافقه الذهبي (المستدرك 2/ 502).¥",
      "attached_span_id": "s018",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2801,
      "end": 3055,
      "text": "¬قول مجاهد أخرجه الطبري بسند صحيح من طريق ابن أبي نجيح عنه أنه قول النضر بن الحارث والطبري بسند صحيح من طريق أبي بشر عن سعيد بن جبير، وأخرجه الطبري بسند حسن من طريق أسباط عن السدي بنحو قول ابن عباس، وهذه المراسيل يقوي بعضها بعضًا، أما قول عطاء فكما يلي.¥",
      "attached_span_id": "s019",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3385,
      "end": 3481,
      "text": "¬أخرجه الطبري بسند ضعيف جدًا من طريق طلحة بن عمرو عن عطاء، وطلحة بن عمرو متروك (التقريب ص 283).¥",
      "attached_span_id": "s024",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3730,
      "end": 3788,
      "text": "¬في سنده إبهام ابن بريدة لأن بعض أبنائه لم يسمع من بريدة.¥",
      "attached_span_id": "s027",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3979,
      "end": 4045,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق سعيد بن أبي عروبة عن قتادة.¥",
      "attached_span_id": "s030",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4706,
      "end": 4821,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده صحيح أخرجه مسلم من طريق عكرمة به (الصحيح، الحج باب التلبية وصفتها (ح 1185).¥",
      "attached_span_id": "s038",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5212,
      "end": 5264,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده ضعيف بسبب الإرسال.¥",
      "attached_span_id": "s042",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5608,
      "end": 5655,
      "text": "¬أخرجه الطبري بسند ثابت من طريق علي به مقطعًا.¥",
      "attached_span_id": "s049",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5720,
      "end": 5776,
      "text": "¬هذه الأقوال أخرجها الطبري وابن أبي حاتم بأسانيد ثابتة.¥",
      "attached_span_id": "s050",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5893,
      "end": 6012,
      "text": "¬قول الضحاك أخرجه ابن أبي حاتم بسند حسن من طريق سلمة بن نبيط عنه. وقول أبي مالك أخرجه الطبري بأسانيد يقوي بعضها بعضًا.¥",
      "attached_span_id": "s052",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6466,
      "end": 6510,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده حسن.¥",
      "attached_span_id": "s058",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6562,
      "end": 6790,
      "text": "¬أخرجه الترمذي من طريق إسماعيل بن إبراهيم بن مهاجر عن عباد بن يوسف عن أبي بردة عن أبي موسى الأشعري مرفوعًا، (السنن، التفسير، باب ومن سورة الأنفال ح 3082) وسنده ضعيف لضعف إسماعيل بن إبراهيم، ويشهد له سابقه وما تقدم في صحيح مسلم.¥",
      "attached_span_id": "s059",
      "grading": [
        "صحيح",
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6836,
      "end": 6973,
      "text": "¬قول قتادة أخرجه الطبري بسند صحيح من طريق ابن أبي عروبة عنه، وقول أبي العلاء أخرجه الطبري من طريق عامر أبي الخطاب الثوري ويتقوى بما سبق.¥",
      "attached_span_id": "s060",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7349,
      "end": 7386,
      "text": "¬تقدم تخريجه في الرواية قبل السابقة.¥",
      "attached_span_id": "s063",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7746,
      "end": 7877,
      "text": "¬المسند 3/ 29 والمستدرك 4/ 261، وسنده ضعيف لأن رواية دراج عن أبي الهيثم ضعيفة، ولكن يشهد له ما تقدم في صحيح مسلم من حديث ابن عباس.¥",
      "attached_span_id": "s067",
      "grading": [
        "صحيح",
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8100,
      "end": 8257,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 6/ 20) وسنده ضعيف لضعف رشدين بن سعد، وإبهام شيخ معاوية بن سعيد، ويشهد له ما تقدم من حديث ابن عباس في صحيح مسلم وغيره.¥",
      "attached_span_id": "s070",
      "grading": [
        "صحيح",
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

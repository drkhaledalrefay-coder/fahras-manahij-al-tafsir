      "marker": "editor_footnote",
      "start": 2268,
      "end": 2344,
      "text": "¬أخرجه عنهم الطبري وابن أبي حاتم بأسانيد ثابتة وبعضها ضعيفة تتقوى بالثابتة.¥",
      "attached_span_id": "s022",
      "grading": [
        "ضعيف"

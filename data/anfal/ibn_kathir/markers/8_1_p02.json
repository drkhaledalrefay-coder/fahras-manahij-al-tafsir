  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1857,
      "end": 1915,
      "text": "¬هو صبيغ بن عسل ذكر قصته الحافظ ابن حجر (الإصابة 2/ 198).¥",
      "attached_span_id": "s022",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1940,
      "end": 2017,
      "text": "¬أخرجه الطبري بسنده ومتنه، وأخرجه الإمام مالك به (الموطأ 2/ 363) وسنده صحيح.¥",
      "attached_span_id": "s023",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2579,
      "end": 2644,
      "text": "¬أخرجه عبد الرزاق بسنده ومتنه، وسنده صحيح وصححه الحافظ ابن كثير.¥",
      "attached_span_id": "s031",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2967,
      "end": 3026,
      "text": "¬أخرجه الطبري من طريق ابن أبي نجيح به، وسنده ضعيف للإرسال.¥",
      "attached_span_id": "s034",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3126,
      "end": 3442,
      "text": "¬قول ابن مسعود أخرجه ابن أبي حاتم وابن أبي شيبة من طريق جابر بن يزيد الجعفي عن القاسم بن عبد الرحمن بن عبد الله بن مسعود عن أبيه عن ابن مسعود (المصنف، الجهاد، باب في النفل ح 15128) وسنده ضعيف لضعف جابر ويتقوى بقول مسروق فقد أخرجه ابن زنجويه بسند صحيح من طريق القاسم بن عبد الرحمن عن مسروق (الأموال 1/ 668 رقم 1162).¥",
      "attached_span_id": "s036",
      "grading": [
        "صحيح",
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3709,
      "end": 3800,
      "text": "¬أخرجه الطبري والطحاوي (شرح معاني الآثار 3/ 278) كلاهما من طريق ابن المبارك به وسنده صحيح.¥",
      "attached_span_id": "s038",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4048,
      "end": 4095,
      "text": "¬أخرجه الطبري معلقًا وبسنده ومتنه، وسنده صحيح.¥",
      "attached_span_id": "s043",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4188,
      "end": 4240,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق صالح بن حُيّ.¥",
      "attached_span_id": "s044",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4533,
      "end": 4551,
      "text": "¬أي السيف العريض.¥",
      "attached_span_id": "s047",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4786,
      "end": 4884,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 3/ 129 ح 1556)، قال محققوه: حسن لغيره. اهـ. ويتقوى بلاحقه.¥",
      "attached_span_id": "s051",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5408,
      "end": 5469,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (3/ 117 ح 1538) وحسنه محققوه.¥",
      "attached_span_id": "s060",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5557,
      "end": 5693,
      "text": "¬سنن أبي داود، الجهاد، باب في النفل (ح 2740)، وسنن الترمذي تفسير القرآن، باب ومن سورة الأنفال (ح 3079)، والسنن الكبرى، التفسير (ح 216).¥",
      "attached_span_id": "s061",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6030,
      "end": 6080,
      "text": "¬أخرجه الطيالسي بسنده ومتنه (المسند 1/ 28 ح 208).¥",
      "attached_span_id": "s066",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6288,
      "end": 6334,
      "text": "¬صحيح مسلم، الجهاد، باب الأنفال (ح 34/ 1748).¥",
      "attached_span_id": "s069",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6748,
      "end": 6827,
      "text": "¬أخرجه الطبري من طريق ابن إسحاق به، وسنده ضعيف لإبهام شيخ عبد الله بن أبي بكر.¥",
      "attached_span_id": "s073",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7226,
      "end": 7421,
      "text": "¬أخرجه الإمام أحمد من طريق محمد بن سلمة عن ابن إسحاق، ومن طريق يعقوب عن أبيه عن ابن إسحاق به وفي آخر كل طريق بلفظ: \"على السواء\" (المسند 37/ 410 ح 22747 و 37/ 414 ح 22753) وقال محققوه: حسن لغيره.¥",
      "attached_span_id": "s078",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7871,
      "end": 7881,
      "text": "¬أي غفلة.¥",
      "attached_span_id": "s081",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8463,
      "end": 8542,
      "text": "¬أخرجه الإمام أحمد بسنده نحوه (المسند 37/ 421 ح 22762)، قال محققوه: حسن لغيره.¥",
      "attached_span_id": "s085",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8774,
      "end": 8939,
      "text": "¬سنن الترمذي، السير، باب في النفل (ح 1561) مختصرًا وحسنه، وسنن ابن ماجه، الجهاد، باب في النفل (ح 2852)، موارد الظمآن (ح 1693 والمستدرك 2/ 136)، وصححه ووافقه الذهبي.¥",
      "attached_span_id": "s088",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9459,
      "end": 9705,
      "text": "¬أخرجه أبو داود، السنن، الجهاد، باب في النفل (ح 2737)، والنسائي في السنن الكبرى، التفسير\r\n(ح 217)، وتفسير الطبري وتفسير ابن مردويه (كما في تغليق التعليق 4/ 215، فقد ذكره بسنده كاملًا) وموارد الظمآن (ح 1743)، والمستدرك 2/ 131 وصححه ووافقه الذهبي.¥",
      "attached_span_id": "s094",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10348,
      "end": 10460,
      "text": "¬أخرجه عبد الرزاق عن الثوري به وسنده ضعيف جدًا لأن الكلبي قد صرح أن كل ما رواه عن أبي صالح عن ابن عباس فهو كذب.¥",
      "attached_span_id": "s102",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10897,
      "end": 10913,
      "text": "¬الأموال ص 426.¥",
      "attached_span_id": "s105",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10964,
      "end": 11004,
      "text": "¬أخرجه الطبري بسند ثابت من طريق علي به.¥",
      "attached_span_id": "s106",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11034,
      "end": 11187,
      "text": "¬قول مجاهد وعكرمة أخرجه الطبري بسندين صحيحين عنهما، وقول السدي أخرجه الطبري بسند حسن من طريق أسباط عنه، وهذه المراسيل يقوي بعضها بعضًا ويشهد لها ما سبق.¥",
      "attached_span_id": "s107",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11228,
      "end": 11290,
      "text": "¬أخرجه الطبري بسند صحيح من طريق ابن وهب عن عبد الرحمن بمعناه.¥",
      "attached_span_id": "s108",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },

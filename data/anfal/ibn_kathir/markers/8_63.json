  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1332,
      "end": 1449,
      "text": "¬صحيح البخاري، المغازي، باب غزوة الطائف (ح 4330)، وصحيح مسلم، الزكاة، باب إعطاء المؤلفة قلوبهم على الإسلام (ح 1061).¥",
      "attached_span_id": "s010",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2226,
      "end": 2338,
      "text": "¬نسبهما صاحب (العقد الفريد 2/ 214) إلى أبي تمام، ونسب ابن قتيبة البيت الثاني إلى أبي تمام (عيون الأخبار 3/ 90).¥",
      "attached_span_id": "s020",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2392,
      "end": 2404,
      "text": "¬أي خبرتهم.¥",
      "attached_span_id": "s022",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2571,
      "end": 2704,
      "text": "¬أخرجه البيهقي في شعب الإيمان (رقم 9034)، وفي سنده محمد بن مسلم الطائفي صدوق يخطئ من حفظه (التقريب ص 506)، ويتقوى برواية عبد الرزاق.¥",
      "attached_span_id": "s026",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2945,
      "end": 3117,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق أبي إسحاق السبيعي عن أبي الأحوص عن ابن مسعود، وأخرجه النسائي في السنن الكبرى (ح 11210)، والحاكم وصححه ووافقه الذهبي (المستدرك 2/ 329).¥",
      "attached_span_id": "s029",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3399,
      "end": 3454,
      "text": "¬أخرجه ابن أبي حاتم من طريق عبد الرزاق به، وسنده صحيح.¥",
      "attached_span_id": "s033",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3474,
      "end": 3533,
      "text": "¬أخرجه الحاكم وصححه ووافقه الذهبي (المستدرك 2/ 328 - 329).¥",
      "attached_span_id": "s034",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3713,
      "end": 3756,
      "text": "¬تحات ورق الشجر أي: تساقط من غصنه إذا ذبل.¥",
      "attached_span_id": "s037",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3930,
      "end": 3993,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده صحيح وسيأتي من طريق آخر صحيح.¥",
      "attached_span_id": "s040",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4348,
      "end": 4426,
      "text": "¬أخرجه الطبري بسنده ومتنه، وفي سنده إبراهيم الخوزي ضعيف ويتقوى بسابقه ولاحقه.¥",
      "attached_span_id": "s045",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4459,
      "end": 4514,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق طلحة بن مصرف به.¥",
      "attached_span_id": "s046",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4597,
      "end": 4671,
      "text": "¬أخرجه الطبري من طريق إسماعيل بن علي عن ابن عون به، وسنده صحيح إلى عُمير.¥",
      "attached_span_id": "s048",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5091,
      "end": 5243,
      "text": "¬أخرجه الطبراني (المعجم الكبير 6/ 256)، قال الهيثمي: رجاله رجال الصحيح غير سالم بن غيلان وهو ثقة (المجمع 8/ 37)، وحسن سنده المنذري في الترغيب (ح 4012).¥",
      "attached_span_id": "s051",
      "grading": [
        "صحيح",
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }

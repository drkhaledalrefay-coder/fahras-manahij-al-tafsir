  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 273,
      "end": 337,
      "text": "¬كذا في المستدرك وترجمته، وفي النسخ الخطية صحف إلى: \"أبو سعيد\".¥",
      "attached_span_id": "s004",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 743,
      "end": 815,
      "text": "¬أخرجه الحاكم بسنده ومتنه وزيادة وصححه ووافقه الذهبي (المستدرك 2/ 240).¥",
      "attached_span_id": "s006",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 949,
      "end": 1105,
      "text": "¬الحقْ أن شطره الأول في الصحيحين أما الشطر الآخر في المسند والسنن. فالشطر الأول أخرجه الشيخان صحيح البخاري، الفرائض (ح 6764)، وصحيح مسلم، الفرائض (ح 1614).¥",
      "attached_span_id": "s009",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1256,
      "end": 1543,
      "text": "¬أخرجه الترمذي من حديث جابر (السنن، الفرائض باب لا يتوارث أهل ملتين (ح 2108)، وأخرجه أبو داود من حديث عمرو بن شعيب به (السنن، الفرائض، باب هل يرث المسلم الكافر ح 2911)، وكذا أخرجه ابن ماجه (السنن، الفرائض باب ميراث أهل الإسلام ح 2731)، وقال الألباني حسن صحيح (صحيح سنن ابن ماجه ح 2207).¥",
      "attached_span_id": "s012",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1775,
      "end": 1844,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده مرسل ويتقوى بالحديث الموصول التالي:¥",
      "attached_span_id": "s015",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2010,
      "end": 2156,
      "text": "¬أخرجه أبو داود من حديث جرير بن عبد الله (السنن، الجهاد، باب النهي عن قتل من اعتصم بالسجود ح 2645)، وصححه الألباني في صحيح سنن أبي داود (ح 2304).¥",
      "attached_span_id": "s017",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2358,
      "end": 2434,
      "text": "¬ما بين المعقوفين سقط من الأصل واستدرك من (عم) و (مح) و (حم) وسنن أبي داود.¥",
      "attached_span_id": "s020",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2535,
      "end": 2659,
      "text": "¬أخرجه أبو داود بسنده ومتنه (السنن، الجهاد، باب في الإقامة بأرض الشرك ح 2787) وصححه الألباني في صحيح سنن أبي داود (ح 2420).¥",
      "attached_span_id": "s023",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3053,
      "end": 3170,
      "text": "¬سنن الترمذي، النكاح، باب ما جاء فيمن ترضون دينه فزوجوه (ح 1097) وحسنه الألباني بشاهد قبله (صحيح سنن الترمذي ح 866).¥",
      "attached_span_id": "s028",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3245,
      "end": 3307,
      "text": "¬كذا في (عم) وسنن الترمذي، وفي الأصل: \"ابن أبي وثيمة النصري\".¥",
      "attached_span_id": "s030",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3461,
      "end": 3670,
      "text": "¬أخرجه الترمذي من طريق عبد الحميد بن سليمان به (السنن، النكاح، باب ما جاء إذا جاءكم من ترضون دينه فزوجوه ح 1084) وكذا ابن ماجه (السنن، النكاح، باب الأكفاء ح 1967) وحسنه الألباني في (صحيح سنن ابن ماجه ح 1601).¥",
      "attached_span_id": "s033",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

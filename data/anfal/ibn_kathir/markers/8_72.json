  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 966,
      "end": 1016,
      "text": "¬صحيح البخاري، الفرائض، باب ذوي الأرحام (ح 6747).¥",
      "attached_span_id": "s004",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1052,
      "end": 1133,
      "text": "¬أخرجهما الطبري وطريق على يقوي طريق العوفي وكلاهما يتقوى برواية البخاري السابقة.¥",
      "attached_span_id": "s005",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1178,
      "end": 1293,
      "text": "¬قول مجاهد وقتادة أخرجهما الطبري بسندين صحيحين، وقول عكرمة أخرجه ابن أبي حاتم بسند حسن من طريق حبيب بن الزبير عنه.¥",
      "attached_span_id": "s006",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1556,
      "end": 1915,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 4/ 363)، وأخرجه الطبراني من طريق عبد الرحمن بن هلال عن جرير (المعجم الكبير ح 2438)، قال الهيثمي ورجاله رجال الصحيح (المجمع 10/ 15)، وأخرجه ابن حبان من طريق عاصم به وحسنه الأرناؤوط (الإحسان 16/ 250 ح 7260)، وأخرجه الحاكم مثل الطبراني وصححه ووافقه الذهبي (المستدرك 4/ 80 - 81)، وصححه الألباني في السلسلة الصحيحة (ح 1036).¥",
      "attached_span_id": "s010",
      "grading": [
        "صحيح",
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2180,
      "end": 2299,
      "text": "¬أخرجه أبو يعلى بسنده ومتنه (المسند 8/ 446 ح 5033) وسنده ضعيف لضعف عكرمة بن إبراهيم، ويشهد له سابقه فيكون حسنًا لغيره.¥",
      "attached_span_id": "s015",
      "grading": [
        "حسن",
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3739,
      "end": 3830,
      "text": "¬أخرجه البزار كما في كشف الأستار (ح 2718)، وسنده ضعيف لضعف علي بن زيد وهو ابن جدعان: ضعيف.¥",
      "attached_span_id": "s026",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",

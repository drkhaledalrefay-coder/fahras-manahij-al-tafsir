  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 540,
      "end": 632,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق ابن إسحاق عن محمد بن جعفر بن الزبير عن عروة بن الزبير.¥",
      "attached_span_id": "s002",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 890,
      "end": 910,
      "text": "¬ذكره الطبري بلفظه.¥",
      "attached_span_id": "s006",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1384,
      "end": 1451,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق يزيد بن سعيد النحوي عن عكرمة.¥",
      "attached_span_id": "s012",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1520,
      "end": 1665,
      "text": "¬قول الضحاك أخرجه ابن أبي حاتم بسند حسن من طريق عبيد بن سليمان عن الضحاك، وقول عطية أخرجه الطبري بسند حسن من طريق عبد الله بن إدريس عن أبيه عنه.¥",
      "attached_span_id": "s014",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2003,
      "end": 2065,
      "text": "¬أخرجه ابن أبي شيبة بسنده ومتنه، وسنده مرسل (المصنف 12/ 390).¥",
      "attached_span_id": "s019",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2301,
      "end": 2371,
      "text": "¬قاله الحصين بن الهمام المري كما في الشعر والشعراء لابن قتيبة 2/ 648.¥",
      "attached_span_id": "s024",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2701,
      "end": 2765,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق أبي جعفر الرازي عن الربيع.¥",
      "attached_span_id": "s028",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2937,
      "end": 2991,
      "text": "¬هو العباس بن مرداس السلمي كما في مجاز القرآن 1/ 242.¥",
      "attached_span_id": "s030",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3057,
      "end": 3079,
      "text": "¬ذكره الطبري باختصار.¥",
      "attached_span_id": "s032",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3174,
      "end": 3214,
      "text": "¬أخرجه الطبري بسند ثابت من طريق علي به.¥",
      "attached_span_id": "s033",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3242,
      "end": 3307,
      "text": "¬قول الضحاك وابن جريج أخرجه الطبري بأسانيد ضعيفة ويشهد له سابقه.¥",
      "attached_span_id": "s034",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3409,
      "end": 3604,
      "text": "¬قول عكرمة أخرجه الطبري بسند حسن من طريق يزيد النحوي عنه وقول عطية العوفي أخرجه ابن أبي حاتم بسند حسن من طريق عبد الله بن إدريس عن أبيه عنه، وقول الضحاك أخرجه الطبري بسند ضعيف من طريق جويبر عنه.¥",
      "attached_span_id": "s036",
      "grading": [
        "حسن",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3748,
      "end": 3810,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق هقل بن زياد عن الأوزاعي.¥",
      "attached_span_id": "s039",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4287,
      "end": 4355,
      "text": "¬سنده ضعيف بسبب ضعف عطية العوفي، ويتقوى بآثار سابقه نصّت على القصة.¥",
      "attached_span_id": "s042",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }

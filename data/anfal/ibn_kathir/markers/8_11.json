  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 691,
      "end": 784,
      "text": "¬رواية أبي طلحة - رضي الله عنه - صحيحة تقدم تخريجها في بداية تفسير آية 154 من سورة آل عمران.¥",
      "attached_span_id": "s004",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1047,
      "end": 1190,
      "text": "¬أخرجه أبو يعلى بسنده ومتنه (المسند 1/ 242 ح 280)، وأخرجه الإمام أحمد من طريق عبد الرحمن بن مهدي به (المسند 2/ 299 ح 1023) وصحح سنده محققوه ..¥",
      "attached_span_id": "s007",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1334,
      "end": 1406,
      "text": "¬أخرجه ابن أبي حاتم من طريق عبد الرحمن بن مهدي عن الثوري به. وسنده حسن.¥",
      "attached_span_id": "s009",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1454,
      "end": 1525,
      "text": "¬أخرجه ابن أبي حاتم من طريق سعيد بن بشير عن قتادة، وسعيد بن بشير ضعيف.¥",
      "attached_span_id": "s010",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2204,
      "end": 2336,
      "text": "¬نسبه الحافظ ابن كثير إلى كتاب المغازي للأموي (البداية والنهاية 3/ 284) وحسنه الألباني في تعليقه على كتاب فقه السيرة للغزالي ص 243.¥",
      "attached_span_id": "s015",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2964,
      "end": 3013,
      "text": "¬أخرجه الطبري بسند ثابت من طريق ابن أبي طلحة به.¥",
      "attached_span_id": "s019",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3468,
      "end": 3534,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق العوفي به ويتقوى بسوابقه ولواحقه.¥",
      "attached_span_id": "s021",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3574,
      "end": 3801,
      "text": "¬قول قتادة أخرجه ابن أبي حاتم بسند ضعيف من طريق سعيد بن بشير عن قتادة، وقول الضحاك أخرجه الطبري بسند ضعيف فيه إبهام شيخ الطبري، وقول السدي أخرجه الطبري بسند حسن من طريق أسباط وهو مرسل يتقوى بالمراسيل الثابتة وغيرها من الموصول.¥",
      "attached_span_id": "s022",
      "grading": [
        "حسن",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3896,
      "end": 4024,
      "text": "¬أخرج بعض هذه الآثار الطبري وابن أبي حاتم وهذه الآثار يقوي بعضها بعضًا، وقد ثبت عن ابن عباس نحو كما تقدم من رواية ابن أبي طلحة.¥",

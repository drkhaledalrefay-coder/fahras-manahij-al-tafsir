  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 348,
      "end": 392,
      "text": "¬أصلهما في الصحيح كما في الحديثين السابقين.¥",
      "attached_span_id": "s004",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 789,
      "end": 929,
      "text": "¬سنده مرسل ولم يسم الراوي عن أبي عوانة ومن بعده، وأخرجه ابن أبي حاتم بسند صحيح من طريق أبي ظبيان حصين بن جندب، ولم يذكر: يعني أسامة بن زيد.¥",
      "attached_span_id": "s011",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1038,
      "end": 1106,
      "text": "¬أخرجه ابن أبي حاتم بسند ضعيف عن الضحاك به، ويتقوى بالآثار التالية.¥",
      "attached_span_id": "s013",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1200,
      "end": 1312,
      "text": "¬ذكرهم ابن أبي حاتم بحذف السند، وقول مجاهد والحسن وقتادة وعبد الرحمن بن زيد بن أسلم أخرجه الطبري بأسانيد ثابتة.¥",
      "attached_span_id": "s014",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1446,
      "end": 1537,
      "text": "¬أخرجه ابن أبي حاتم من طريق ابن إسحاق به ولم يصرح ابن إسحاق باسم شيخه ولكنه يتقوى بما سبق.¥",
      "attached_span_id": "s016",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1644,
      "end": 1703,
      "text": "¬أخرجه ابن أبي حاتم بسند ضعيف عن الضحاك به ويتقوى بالتالي.¥",
      "attached_span_id": "s018",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1797,
      "end": 1928,
      "text": "¬قول الحسن أخرجه الطبري بسند حسن من طريق مبارك بن فضالة عن الحسن، وقول قتادة أخرجه الطبري بسند صحيح من طريق سعيد بن أبي عروبة عنه.¥",
      "attached_span_id": "s020",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2015,
      "end": 2032,
      "text": "¬يشهد له ما سبق.¥",
      "attached_span_id": "s022",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2126,
      "end": 2189,
      "text": "¬أخرجه الطبري بسند صحيح من طريق عبد الله بن وهب عن عبد الرحمن.¥",
      "attached_span_id": "s024",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2398,
      "end": 2440,
      "text": "¬تقدم تخريجه في تفسير سورة البقرة آية 10.¥",
      "attached_span_id": "s027",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2661,
      "end": 2705,
      "text": "¬تقدم تخريجه في تفسير سورة البقرة، آية 192.¥",
      "attached_span_id": "s030",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3601,
      "end": 3769,
      "text": "¬صحيح البخاري، الجهاد والسير، باب بعث النبي - صلى الله عليه وسلم - أسامة بن زيد (ح 2810)، وصحيح مسلم، الإيمان، باب تحريم قتل الكافر بعد أن قال: لا إله إلا الله (ح 96).¥",
      "attached_span_id": "s042",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }

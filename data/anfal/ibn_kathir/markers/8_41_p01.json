  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 997,
      "end": 1063,
      "text": "¬أخرجه الطبري بسند صحيح من طريق سعيد بن أبي عروبة عن قتادة بنحوه.¥",
      "attached_span_id": "s006",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2198,
      "end": 2266,
      "text": "¬أخرجه ابن أبي حاتم من طريق أبي جعفر الرازي به وسنده جيد لكنه مرسل.¥",
      "attached_span_id": "s015",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2724,
      "end": 2792,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق الضحاك به، وتشهد له الآثار التالية.¥",
      "attached_span_id": "s020",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2955,
      "end": 3146,
      "text": "¬ذكرهم ابن أبي حاتم بحذف السند إلا قول عطاء فقد أخرجه بسند حسن من طريق عبد الملك بن أبي سليمان عن عطاء، وقول إبراهيم النخعي والحسن البصري وعطاء بن أبي رباح وقتادة أخرجه الطبري بأسانيد ثابتة.¥",
      "attached_span_id": "s021",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3486,
      "end": 3580,
      "text": "¬أخرجه البيهقي من طريق عبد الله بن شقيق به (السنن الكبرى 6/ 324)، وصححه سنده الحافظ ابن كثير.¥",
      "attached_span_id": "s027",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3735,
      "end": 3820,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده ضعيف لأن الحسن لم يسمع من أبي بكر - رضي الله عنه -.¥",
      "attached_span_id": "s030",
      "grading": [
        "حسن",
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4140,
      "end": 4185,
      "text": "¬أخرجه الطبري بسند ثابت من طريق علي به نحوه.¥",
      "attached_span_id": "s032",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4444,
      "end": 4489,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده صحيح.¥",
      "attached_span_id": "s036",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4597,
      "end": 4704,
      "text": "¬أخرجه أبو عبيد (الأموال 838) وابن أبي شيبة (المصنف 12/ 431) بسند صحيح من طريق عبد الملك بن أبي سليمان به.¥",
      "attached_span_id": "s038",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5800,
      "end": 6034,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 37/ 371 - 372 ح 22699)، وحسنه محققوه بالشواهد، وكذا\r\nحسنه الحافظ ابن كثير، وأخرجه الحاكم من طريق أبي سلام الأعرج به وصححه ووافقه الذهبي (المستدرك 3/ 49، وذكره الألباني في السلسلة الصحيحة ح 985).¥",
      "attached_span_id": "s043",
      "grading": [
        "صحيح",
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6273,
      "end": 6390,
      "text": "¬المسند 2/ 184، وسنن أبي داود، الجهاد، باب فداء الأسير بالمال (ح 2694) وحسنه الألباني في صحيح سنن أبي داود (ح 2343).¥",
      "attached_span_id": "s045",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6578,
      "end": 6697,
      "text": "¬سنن أبي داود، الجهاد، باب في الإمام يستأثر بشيء من الفيء لنفسه (ح 2755) وصححه الألباني في صحيح سنن أبي داود (ح 2393).¥",
      "attached_span_id": "s047",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7038,
      "end": 7094,
      "text": "¬أخرجه الإمام أحمد (المسند 4/ 259 ح 2445) وحسنه محققوه.¥",
      "attached_span_id": "s049",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7150,
      "end": 7262,
      "text": "¬أخرجه أبو داود (السنن، الجهاد، باب ما جاء في سهم الصفيّ ح 2994)، وصححه الألباني في صحيح سنن أبي داود (ح 2587).¥",
      "attached_span_id": "s050",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7687,
      "end": 7804,
      "text": "¬أخرجه أبو داود (السنن، الجهاد، باب ما جاء في سهم الصفيّ ح 2999)، وصححه سنده الألباني في صحيح سنن أبي داود (ح 2592).¥",
      "attached_span_id": "s055",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8882,
      "end": 9075,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده ضعيف جدًا فإن عبد الغفار هو ابن القاسم أبو مريم الغفاري، يروي عن المنهال بن عمر (الجرح والتعديل 6/ 53) من رؤوس الشيعة رافضي يضع الحديث (ميزان الاعتدال 2/ 640).¥",
      "attached_span_id": "s069",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9685,
      "end": 9889,
      "text": "¬أخرجه عبد الرزاق (المصنف رقم 9382)، وأبو عبيد (الأموال 39) وابن أبي شيبة (المصنف 12/ 431)، كلهم من طريق الثوري به وسنده صحيح، وأخرجه الحاكم أيضًا من طريق الثوري به وصححه ووافقه الذهبي (المستدرك 2/ 128).¥",
      "attached_span_id": "s077",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9983,
      "end": 10026,
      "text": "¬الكراع: بضم الكاف اسم يجمع الخيل والسلاح.¥",
      "attached_span_id": "s079",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10093,
      "end": 10153,
      "text": "¬أخرجه الطبري من طريق عمر بن عبيد عن الأعمش به، وسنده مرسل.¥",
      "attached_span_id": "s080",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10729,
      "end": 10767,
      "text": "¬ما بين معقوفين زيادة من (عم) و (مح).¥",
      "attached_span_id": "s082",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10826,
      "end": 10917,
      "text": "¬كذا في (عم) و (حم) و (مح) والسيرة النبوية لابن هشام وفي الأصل: \"عقوبة سوء من غرام مماثل\".¥",
      "attached_span_id": "s084",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10944,
      "end": 10968,
      "text": "¬الشعيرة: الحب المعروف.¥",
      "attached_span_id": "s085",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

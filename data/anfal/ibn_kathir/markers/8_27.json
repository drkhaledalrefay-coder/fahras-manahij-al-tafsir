  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 152,
      "end": 247,
      "text": "¬كذا في (عم) و (مح)، وفي الأصل صحفت إلى عبد الرزاق، وعبد الله بن أبي قتادة الأنصاري تابعي ثقة.¥",
      "attached_span_id": "s002",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 925,
      "end": 1161,
      "text": "¬قول عبد الله بن أبي قتادة أخرجه سعيد بن منصور (التفسير ح 987)، والطبري وابن أبي حاتم من طريق سفيان بن عيينة عن إسماعيل بن أبي خالد عن عبد الله مختصرًا، وسنده صحيح لكنه مرسل، ومرسل الزهري أخرجه الطبري بسند فيه الحسين وهو ابن داود ضعيف.¥",
      "attached_span_id": "s005",
      "grading": [
        "صحيح",
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1423,
      "end": 1498,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده ضعيف لضعف يونس بن الحارث (التقريب ص 613).¥",
      "attached_span_id": "s008",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1594,
      "end": 1669,
      "text": "¬محمد بن المحرم ترجم له البخاري وقال: منكر الحديث (التاريخ الكبير 1/ 142).¥",
      "attached_span_id": "s010",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2077,
      "end": 2213,
      "text": "¬أخرجه الطبري بسنده ومتنه مع الخلاف في السند، وضعفه الحافظ ابن كثير سندًا ومتنًا، وفي سنده محمد المحرم منكر الحديث كما تقدم عن البخاري.¥",
      "attached_span_id": "s015",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2647,
      "end": 2702,
      "text": "¬تقدم تخريجه في تفسير الآية (9) من هذه السورة الكريمة.¥",
      "attached_span_id": "s020",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3036,
      "end": 3076,
      "text": "¬أخرجه الطبري بسند ثابت من طريق علي به.¥",
      "attached_span_id": "s025",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3161,
      "end": 3222,
      "text": "¬أخرجه الطبري بسند ثابت من طريق علي بن أبي طلحة عن ابن عباس.¥",
      "attached_span_id": "s026",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3418,
      "end": 3469,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق ابن إسحاق به.¥",
      "attached_span_id": "s028",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3617,
      "end": 3654,
      "text": "¬أخرجه الطبري بسنده عن السدي مرسلًا.¥",
      "attached_span_id": "s030",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3730,
      "end": 3793,
      "text": "¬أخرجه الطبري بسند صحيح من طريق عبد الله بن وهب عن عبد الرحمن.¥",
      "attached_span_id": "s032",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

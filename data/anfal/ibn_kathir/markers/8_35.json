  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 446,
      "end": 664,
      "text": "¬ذكرهم ابن أبي حاتم بحذف السند إلا قول ابن عمر فأخرجه بسند ضعيف من طريق عطية العوفي عن ابن عمر، ويشهد له بقية الآثار فقد صح عن ابن عباس ومجاهد وعكرمة وسعيد بن جبير وقتادة وعبد الرحمن بن زيد وذلك فيما رواه الطبري عنهم.¥",
      "attached_span_id": "s003",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 711,
      "end": 766,
      "text": "¬أخرجه الطبري بسند صحيح من طريق ابن أبي نجيح عن مجاهد.¥",
      "attached_span_id": "s004",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 864,
      "end": 911,
      "text": "¬أخرجه الطبري بسند حسن من طريق أسباط عن السدي.¥",
      "attached_span_id": "s006",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1279,
      "end": 1322,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه وسنده حسن.¥",
      "attached_span_id": "s011",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1501,
      "end": 1544,
      "text": "¬هذه الأقوال تتمة لما سبق قبل ثلاث روايات.¥",
      "attached_span_id": "s012",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1779,
      "end": 1834,
      "text": "¬أخرجه الطبري بسنده ومتنه، وفي سنده أيضًا عطية العوفي.¥",
      "attached_span_id": "s015",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1952,
      "end": 2000,
      "text": "¬أخرجه ابن أبي حاتم وفي سنده أيضًا عطية العوفي.¥",
      "attached_span_id": "s017",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2046,
      "end": 2108,
      "text": "¬أخرجه ابن أبي حاتم بسند ضعيف من طريق الحكم بن أبان عن عكرمة.¥",
      "attached_span_id": "s018",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2198,
      "end": 2258,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق ابن أبي نجيح عن مجاهد.¥",
      "attached_span_id": "s019",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2293,
      "end": 2356,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق ابن أخي الزهري عن الزهري.¥",
      "attached_span_id": "s020",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2450,
      "end": 2615,
      "text": "¬قول سعيد بن جبير أخرجه ابن أبي حاتم بسند ضعيف جدًا من طريق طلحة بن عمرو عنه لأن طلحة متروك، وقول عبد الرحمن أخرجه ابن أبي حاتم بسند صحيح من طريق أصبغ بن الفرج عنه.¥",
      "attached_span_id": "s022",
      "grading": [
        "صحيح",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2750,
      "end": 2875,
      "text": "¬قول الضحاك أخرجه ابن أبي حاتم بسند حسن من طريق سلمة بن نبيط عنه، وقول ابن جريج وابن إسحاق أخرجه الطبري بسندين ضعيفين عنهما.¥",
      "attached_span_id": "s025",
      "grading": [
        "حسن",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3063,
      "end": 3108,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده صحيح.¥",
      "attached_span_id": "s028",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 333,
      "end": 409,
      "text": "¬ذكره الطبري بلفظه، وقول عكرمة أخرجه الطبري بسند حسن من طريق داود عن عكرمة.¥",
      "attached_span_id": "s005",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1231,
      "end": 1251,
      "text": "¬ذكره الطبري بلفظه.¥",
      "attached_span_id": "s009",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1337,
      "end": 1392,
      "text": "¬أخرجه الطبري بسند صحيح من طريق ابن أبي نجيح عن مجاهد.¥",
      "attached_span_id": "s011",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1627,
      "end": 1674,
      "text": "¬أخرجه الطبري بسند حسن من طريق أسباط عن السدي.¥",
      "attached_span_id": "s013",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2795,
      "end": 2884,
      "text": "¬هذه القصَّة ذكرها ابن هشام في السيرة 2/ 606 - 607 وابن كثير في البداية والنهاية 3/ 260.¥",
      "attached_span_id": "s018",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3864,
      "end": 4092,
      "text": "¬أخرجه الطبراني عن بكر بن سهل به (المعجم الكبير 4/ 208 - 211 ح 4056) وحسنه الهيثمي (المجمع 6/ 73)، وفي سنده ابن لهيعة ويتقوى برواية الطبري فقد روي من طريق عبد الله بن وهب وابن المبارك عن ابن لهيعة دون ذكر سبب النزول وسندها حسن.¥",
      "attached_span_id": "s031",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4154,
      "end": 4224,
      "text": "¬أخرجه ابن أبي حاتم من طريق زيد بن الحباب عن ابن لهيعة به، وسنده حسن.¥",
      "attached_span_id": "s032",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5179,
      "end": 5197,
      "text": "¬سنده حسن بسابقه.¥",
      "attached_span_id": "s042",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5613,
      "end": 5678,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق العوفي به، ويتقوى بسابقه ولاحقه.¥",
      "attached_span_id": "s045",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5787,
      "end": 5847,
      "text": "¬ما بين معقوفين سقط من الأصل واستدرك من (عم) و (حم) و (مح).¥",
      "attached_span_id": "s047",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5909,
      "end": 5992,
      "text": "¬ورد في سيرة ابن هشام 2/ 322، وأخرجه الطبري من طريق سلمة بن الفضل عن ابن إسحاق به.¥",
      "attached_span_id": "s048",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6109,
      "end": 6156,
      "text": "¬أخرجه الطبري بسند حسن من طريق أسباط عن السدي.¥",
      "attached_span_id": "s050",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6524,
      "end": 6587,
      "text": "¬أخرجه الطبري بسند صحيح من طريق عبد الله بن وهب عن عبد الرحمن.¥",
      "attached_span_id": "s056",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6769,
      "end": 6805,
      "text": "¬ذكره الطبري بنحوه مع تقديم وتأخير.¥",
      "attached_span_id": "s060",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7252,
      "end": 7474,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 3/ 466 ح 2022)، وأخرجه الترمذي من طريق إسرائيل به وحسنه، (السنن، تفسير القرآن، باب ومن سورة الأنفال ح 3080)، وكذا الحاكم وصححه ووافقه الذهبي (المستدرك 2/ 235)، وجوده الحافظ ابن كثير.¥",
      "attached_span_id": "s068",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10769,
      "end": 10842,
      "text": "¬أخرجه الطبري من طريق ابن إسحاق به، وسنده حسن إذ يشهد له ما سبق وما لحق.¥",
      "attached_span_id": "s087",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10877,
      "end": 10936,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق العوفي به، ويتقوى بما سبق.¥",
      "attached_span_id": "s088",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11064,
      "end": 11306,
      "text": "¬قول السدي أخرجه الطبري بسند حسن من طريق أسباط عنه، وقول قتادة أخرجه الطبري بسند صحيح من طريق ابن أبي عروبة عنه مختصرًا وقول عبد الرحمن أخرجه الطبري بسند صحيح من طريق ابن وهب عنه، مختصرًا، وهذه الروايات يقوي بعضها بعضًا وتتقوى بما سبق أيضًا.¥",
      "attached_span_id": "s089",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

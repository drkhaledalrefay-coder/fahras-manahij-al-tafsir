    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 13933,
      "end": 13983,
      "text": "¬أخرجه الطبري بسند حسن من طريق مجاهد عن ابن عباس.¥",
      "attached_span_id": "s132",
      "grading": [
        "حسن"

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1200,
      "end": 1245,
      "text": "¬سيأتي تخريجه من عدة طرق في تفسير هذه الآية.¥",
      "attached_span_id": "s010",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1823,
      "end": 1863,
      "text": "¬أخرجه الطبري بسند ثابت من طريق علي به.¥",
      "attached_span_id": "s017",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2217,
      "end": 2285,
      "text": "¬أخرجه الطبري من طريق أسباط به، وسنده ضعيف للإرسال والسدي فيه تشيع.¥",
      "attached_span_id": "s020",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2682,
      "end": 2772,
      "text": "¬أخرجه الطبري من طريق أبي معشر به، وسنده مرسل وأبو معشر هو السندي فيه ضعف ويتقوى بما يلي.¥",
      "attached_span_id": "s024",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3018,
      "end": 3089,
      "text": "¬أخرجه الطبري من طريق ابن وهب عن عبد الرحمن سنده مفصل ويتقوى بما يليه.¥",
      "attached_span_id": "s027",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3217,
      "end": 3298,
      "text": "¬قول مجاهد وعكرمة وقتادة أخرجه الطبري بأسانيد صحيحة وهي مراسيل يقوي بعضها بعضًا.¥",
      "attached_span_id": "s028",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3671,
      "end": 3804,
      "text": "¬أخرجه الطبري بسنده ومتنه، وضعفه الأستاذ أحمد شاكر وأخرجه الطبراني (المعجم الكبير 3/ 203 ح 3128) وحسنه الهيثمي (مجمع الزوائد 6/ 77).¥",
      "attached_span_id": "s032",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4278,
      "end": 4328,
      "text": "¬أخرجه ابن أبي حاتم من طريق صفوان به، وسنده مرسل.¥",
      "attached_span_id": "s037",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4849,
      "end": 4939,
      "text": "¬أخرجه الحاكم من طريق سعيد بن المسيب عن أبيه بنحوه وصححه ووافقه الذهبي (المستدرك 2/ 327).¥",
      "attached_span_id": "s040",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5316,
      "end": 5371,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق محمد بن إسحاق به.¥",

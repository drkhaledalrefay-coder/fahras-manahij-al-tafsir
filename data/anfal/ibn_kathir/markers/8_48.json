  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 693,
      "end": 762,
      "text": "¬أخرجه ابن أبي حاتم بسند ثابت من طريق ابن أبي طلحة عن ابن عباس نحوه.¥",
      "attached_span_id": "s003",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1181,
      "end": 1258,
      "text": "¬أخرجه الطبري من طريق ابن جريج به، وسنده ضعيف لأن ابن جريج لم يسمع ابن عباس.¥",
      "attached_span_id": "s008",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1816,
      "end": 1856,
      "text": "¬أخرجه الطبري بسند ثابت من طريق علي به.¥",
      "attached_span_id": "s013",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2219,
      "end": 2259,
      "text": "¬سنده ضعيف بسبب الكلبي بالكذب أنه متهم.¥",
      "attached_span_id": "s018",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2869,
      "end": 2961,
      "text": "¬كذا في (عم) و (مح) ومغازي الواقدي، وفي الأصل (وحم) صحفت إلى ثوبه، وكذا في الطبعات المحققة.¥",
      "attached_span_id": "s023",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2993,
      "end": 3105,
      "text": "¬أخرجه الواقدي بسنده ومتنه (المغازي 1/ 70)، وسنده ضعيف لضعف الواقدي ولمعظمه شواهد تقدمت في الرواية قبل السابقة.¥",
      "attached_span_id": "s024",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3137,
      "end": 3230,
      "text": "¬المعجم الكبير 5/ 42 وضعفه الهيثمي لضعف أحد رجاله واسمه: عبد العزيز بن عمران (المجمع 6/ 82).¥",
      "attached_span_id": "s025",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3570,
      "end": 3627,
      "text": "¬أخرجه الطبري من طريق ابن إسحاق به، وسنده حسن لكنه مرسل.¥",
      "attached_span_id": "s029",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4065,
      "end": 4200,
      "text": "¬أخرجه الطبري من طريق سلمة بن الفضل عن ابن إسحاق، وذكره ابن هشام في السيرة النبوية (1/ 613) ويتقوى بالآثار والمراسيل التالية والسابقة.¥",
      "attached_span_id": "s036",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4264,
      "end": 4373,
      "text": "¬قول السدي أخرجه الطبري بسند حسن من طريق أسباط عنه، وقول الحسن البصري أخرجه الطبري بأسانيد يقوي بعضها بعضًا.¥",
      "attached_span_id": "s037",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4723,
      "end": 4793,
      "text": "¬أخرجه الطبري بسند صحيح من طريق سعيد بن أبي عروبة عن قتادة لكنه مرسل.¥",
      "attached_span_id": "s041",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5662,
      "end": 5697,
      "text": "¬ذكره ابن هشام في السيرة (1/ 633).¥",
      "attached_span_id": "s047",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6646,
      "end": 6665,
      "text": "¬أي أبعد عن الخير.¥",
      "attached_span_id": "s057",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6836,
      "end": 6862,
      "text": "¬أي يرتبهم ويصفّهم للحرب.¥",
      "attached_span_id": "s060",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6873,
      "end": 6976,
      "text": "¬أخرجه الإمام مالك بسنده نحوه (الموطأ 1/ 422 ح 245)، وسنده مرسل، وأخرجه الطبري من طريق الإمام مالك به.¥",
      "attached_span_id": "s061",
      "grading": [
        "سنده"
      ],

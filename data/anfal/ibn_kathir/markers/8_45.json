  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 671,
      "end": 846,
      "text": "¬صحيح البخاري، الجهاد، باب كان النبي - صلى الله عليه وسلم - لم يقاتل أول النهار أخَّر القتال حتى تزول الشمس (ح 2965)، وصحيح مسلم، الجهاد، باب كراهية تمني لقاء العدو (ح 1742).¥",
      "attached_span_id": "s005",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1105,
      "end": 1248,
      "text": "¬أخرجه عبد الرزاق بسنده ومتنه (المصنف رقم 9518) وسنده ضعيف لضعف عبد الرحمن بن زياد، والشق الأول له شاهد في الصحيحين كما تقدم في الحديث السابق.¥",
      "attached_span_id": "s008",
      "grading": [
        "صحيح",
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1520,
      "end": 1606,
      "text": "¬أخرجه الطبراني بسنده ومتنه (المعجم الكبير 5/ 213) وسنده ضعيف لإبهام شيخ ثابت بن زيد.¥",
      "attached_span_id": "s012",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1697,
      "end": 1784,
      "text": "¬أخرجه الترمذي من حديث عمارة بن زعكرة وقال: ليس إسناده بالقوي (السنن، الدعوات ح 3580).¥",
      "attached_span_id": "s014",
      "grading": [
        "إسناده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1942,
      "end": 1983,
      "text": "¬أخرجه الطبري بسند صحيح من طريق سعيد به.¥",
      "attached_span_id": "s018",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2164,
      "end": 2209,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده صحيح.¥",
      "attached_span_id": "s021",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2601,
      "end": 2702,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وفي سنده يزيد بن قوذر سكت عنه ابن أبي حاتم (الجرح والتعديل 9/ 284).¥",
      "attached_span_id": "s023",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

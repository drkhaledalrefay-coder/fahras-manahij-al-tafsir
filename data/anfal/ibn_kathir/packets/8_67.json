  "spans": [
    {
      "id": "s001",
      "start": 0,
      "end": 167,
      "text": "{مَا كَانَ لِنَبِيٍّ أَنْ يَكُونَ لَهُ أَسْرَى حَتَّى يُثْخِنَ فِي الْأَرْضِ تُرِيدُونَ عَرَضَ الدُّنْيَا وَاللَّهُ يُرِيدُ الْآخِرَةَ وَاللَّهُ عَزِيزٌ حَكِيمٌ (67)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 0,
          "end": 166,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 167,
      "end": 243,
      "text": "\r\nقال الإمام أحمد: حدثنا علي بن هاشم، عن حميد، عن أنس - رضي الله عنه -، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 186,
          "end": 191,
          "span_id": "s002"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 205,
          "end": 231,
          "stripped": "عن حميد، عن أنس - رضي الله",
          "span_id": "s002"
        },
        {
          "family": "SAHABA",
          "marker": "أنس",
          "name": "أنس",
          "role": "NARRATOR",
          "start": 217,
          "end": 220,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 243,
      "end": 311,
      "text": " استشار النبي - صلى الله عليه وسلم - الناس في الأسارى يوم بدر، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 259,
          "end": 277,
          "span_id": "s003"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 297,
          "end": 304,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 311,
      "end": 337,
      "text": " \"إن الله قد أمكنكم منهم\".",
      "markers": []
    },
    {
      "id": "s005",
      "start": 337,
      "end": 362,
      "text": " فقام عمر بن الخطاب فقال:",
      "markers": []
    },
    {
      "id": "s006",
      "start": 362,
      "end": 389,
      "text": " يا رسول الله اضرب أعناقهم.",
      "markers": []
    },
    {
      "id": "s007",
      "start": 389,
      "end": 475,
      "text": " فأعرض عنه النبي - صلى الله عليه وسلم -، ثم عاد رسول الله - صلى الله عليه وسلم - فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 408,
          "end": 426,
          "span_id": "s007"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 449,
          "end": 467,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 475,
      "end": 553,
      "text": " \"يا أيها الناس إن الله قد أمكنكم منهم وإنما هم إخوانكم بالأمس\" فقام عمر فقال:",
      "markers": []
    },
    {
      "id": "s009",
      "start": 553,
      "end": 662,
      "text": " يا رسول الله اضرب أعناقهم، فأعرض عنه النبي - صلى الله عليه وسلم -، ثم عاد النبي - صلى الله عليه وسلم - فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 599,
          "end": 617,
          "span_id": "s009"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 636,
          "end": 654,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 662,
      "end": 721,
      "text": " للناس مثل ذلك، فقام أبو بكر الصديق - رضي الله عنه -، فقال:",
      "markers": []
    },
    {
      "id": "s011",
      "start": 721,
      "end": 779,
      "text": " يا رسول الله نرى أن تعفو عنهم، وأن تقبل منهم الفداء، قال:",
      "markers": []
    },
    {
      "id": "s012",
      "start": 779,
      "end": 905,
      "text": " فذهب عن وجه رسول الله - صلى الله عليه وسلم - ما كان فيه من الغمِّ، فعفا عنهم وقبلَ منهم الفِداء، قال وأنزل الله -عزَّ وجلَّ-:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 804,
          "end": 822,
          "span_id": "s012"
        }
      ]
    },
    {
      "id": "s013",
      "start": 905,
      "end": 950,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ} الآية ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 906,
          "end": 943,
          "span_id": "s013"
        }
      ]
    },
    {
      "id": "s014",
      "start": 1009,
      "end": 1070,
      "text": ".\r\nوقد سبق في أول السورة حديث ابن عباس في صحيح مسلم بنحو ذلك.",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1070,
      "end": 1131,
      "text": "\r\nوقال الأعمش: عن عمرو بن مرة، عن أبي عبيدة، عن عبد الله قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1085,
          "end": 1121,
          "stripped": "عن عمرو بن مرة، عن أبي عبيدة، عن عبد",
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1131,
      "end": 1186,
      "text": " لما كان يوم بدر، قال رسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 1140,
          "end": 1147,
          "span_id": "s016"
        },
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 1149,
          "end": 1162,
          "span_id": "s016"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1165,
          "end": 1183,
          "span_id": "s016"
        }
      ]
    },
    {
      "id": "s017",
      "start": 1186,
      "end": 1215,
      "text": " \"ما تقولون في هؤلاء الأسارى؟",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1215,
      "end": 1308,
      "text": " \" فقال أبو بكر: يا رسول الله قومك وأهلك، استبقهم واستتبهم لعلّ الله أن يتوب عليهم، وقال عمر:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 1223,
          "end": 1230,
          "span_id": "s018"
        },
        {
          "family": "SAHABA",
          "marker": "عمر",
          "name": "عمر",
          "role": "SPEAKER",
          "start": 1304,
          "end": 1307,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 1308,
      "end": 1382,
      "text": " \"يا رسول الله كذبوك وأخرجوك فقدمهم فاضرب أعناقهم\" وقال عبد الله بن رواحة:",
      "markers": []
    },
    {
      "id": "s020",
      "start": 1382,
      "end": 1463,
      "text": " يا رسول الله أنت في وادٍ كثير الحطب، أضرم الوادي عليهم نارًا، ثم ألقهم فيه، قال:",
      "markers": []
    },
    {
      "id": "s021",
      "start": 1463,
      "end": 1546,
      "text": " فسكت رسول الله - صلى الله عليه وسلم - فلم يردّ عليهم شيئًا، ثم قام فدخل، فقال ناس:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1481,
          "end": 1499,
          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 1546,
      "end": 1575,
      "text": " يأخذ بقول أبي بكر، وقال ناس:",
      "markers": []
    },
    {
      "id": "s023",
      "start": 1575,
      "end": 1600,
      "text": " يأخذ بقول عمر، وقال ناس:",
      "markers": []
    },
    {
      "id": "s024",
      "start": 1600,
      "end": 1629,
      "text": " يأخذ بقول عبد الله بن رواحة.",
      "markers": []
    },
    {
      "id": "s025",
      "start": 1629,
      "end": 1682,
      "text": "\r\nثم خرج عليهم رسول الله - صلى الله عليه وسلم - فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1656,
          "end": 1674,
          "span_id": "s025"
        }
      ]
    },
    {
      "id": "s026",
      "start": 1682,
      "end": 1839,
      "text": " \"إن الله ليلين قلوب رجال حتى تكون ألين من اللّبن، وإن الله ليشدد قلوب رجال فيه حتى تكون أشد من الحجارة، وإن مثلك يا أبا بكر كمثل إبراهيم -عليه السلام-، قال:",
      "markers": []
    },
    {
      "id": "s027",
      "start": 1839,
      "end": 1918,
      "text": " {فَمَنْ تَبِعَنِي فَإِنَّهُ مِنِّي وَمَنْ عَصَانِي فَإِنَّكَ غَفُورٌ رَحِيمٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1840,
          "end": 1917,
          "span_id": "s027"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 1918,
          "end": 1931,
          "text": "[إبراهيم: 36]",
          "via": "apparatus",
          "span_id": "s027"
        }
      ]
    },
    {
      "id": "s028",
      "start": 1931,
      "end": 1980,
      "text": " وإن مثلك يا أبا بكر كمثل عيسى -عليه السلام- قال:",
      "markers": []
    },
    {
      "id": "s029",
      "start": 1980,
      "end": 2092,
      "text": " {إِنْ تُعَذِّبْهُمْ فَإِنَّهُمْ عِبَادُكَ وَإِنْ تَغْفِرْ لَهُمْ فَإِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ (118)} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1981,
          "end": 2091,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 2101,
      "end": 2148,
      "text": " وإن مثلك يا عمر، كمثل موسى -عليه السلام-، قال:",
      "markers": []
    },
    {
      "id": "s031",
      "start": 2148,
      "end": 2270,
      "text": " {رَبَّنَا اطْمِسْ عَلَى أَمْوَالِهِمْ وَاشْدُدْ عَلَى قُلُوبِهِمْ فَلَا يُؤْمِنُوا حَتَّى يَرَوُا الْعَذَابَ الْأَلِيمَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2149,
          "end": 2269,
          "span_id": "s031"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 2270,
          "end": 2280,
          "text": "[يونس: 88]",
          "via": "apparatus",
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2280,
      "end": 2326,
      "text": " وإن مثلك يا عمر، كمثل نوح -عليه السلام-، قال:",
      "markers": []
    },
    {
      "id": "s033",
      "start": 2326,
      "end": 2396,
      "text": " {رَبِّ لَا تَذَرْ عَلَى الْأَرْضِ مِنَ الْكَافِرِينَ دَيَّارًا (26)} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2327,
          "end": 2395,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 2401,
      "end": 2412,
      "text": " أنتم عالة ",
      "markers": []
    },
    {
      "id": "s035",
      "start": 2423,
      "end": 2483,
      "text": " فلا ينفكنَّ أحد منهم إلا بفداء، أو ضربة عنق\" قال ابن مسعود:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن مسعود",
          "name": "ابن مسعود",
          "role": "SPEAKER",
          "start": 2473,
          "end": 2482,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 2483,
      "end": 2691,
      "text": " قلت: يا رسول الله إلا سهيل بن بيضاء، فإنه يذكر الإسلام، فسكت رسول الله - صلى الله عليه وسلم -، فما رأيتني في يوم أخوف من أن تقع علي حجارة من السماء مني في ذلك اليوم، حتى قال رسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 2484,
          "end": 2487,
          "span_id": "s036"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2557,
          "end": 2575,
          "span_id": "s036"
        },
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 2654,
          "end": 2667,
          "span_id": "s036"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2670,
          "end": 2688,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 2691,
      "end": 2736,
      "text": " \"إلا سهيل بن بيضاء\" فأنزل الله -عزَّ وجلَّ-:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 2712,
          "end": 2717,
          "span_id": "s037"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 2712,
          "end": 2722,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 2736,
      "end": 2908,
      "text": " {مَا كَانَ لِنَبِيٍّ أَنْ يَكُونَ لَهُ أَسْرَى} إلى آخر الآية، رواه الإمام أحمد والترمذي من حديث أبي معاوية عن الأعمش به، والحاكم في مستدركه، وقال صحيح الإسناد ولم يخرجاه ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2737,
          "end": 2784,
          "span_id": "s038"
        },
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 2800,
          "end": 2804,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 3076,
      "end": 3194,
      "text": ". وروى الحافظ أبو بكر بن مردويه عن عبد الله بن عمر، وأبي هريرة -رضي الله عنهما-، عن النبي - صلى الله عليه وسلم - نحوه.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3168,
          "end": 3186,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3194,
      "end": 3226,
      "text": " وفي الباب عن أبي أيوب الأنصاري.",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3226,
      "end": 3370,
      "text": "\r\nوروى ابن مردويه أيضًا، واللفظ له والحاكم في مستدركه، من حديث عبيد الله بن موسى، حدثنا إسرائيل، عن إبراهيم بن مهاجر، عن مجاهد، عن ابن عمر، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3308,
          "end": 3313,
          "span_id": "s041"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3323,
          "end": 3365,
          "stripped": "عن إبراهيم بن مهاجر، عن مجاهد، عن ابن عمر،",
          "span_id": "s041"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 3347,
          "end": 3352,
          "span_id": "s041"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عمر",
          "name": "ابن عمر",
          "role": "SPEAKER",
          "start": 3357,
          "end": 3364,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 3370,
      "end": 3444,
      "text": " لما أسر الأسارى يوم بدر، أُسر العباس فيمن أُسر، أسره رجل من الأنصار، قال:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 3387,
          "end": 3394,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3444,
      "end": 3551,
      "text": " وقد أوعدته الأنصار أن يقتلوه، فبلغ ذلك النبي - صلى الله عليه وسلم - فقال رسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3492,
          "end": 3510,
          "span_id": "s043"
        },
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 3514,
          "end": 3527,
          "span_id": "s043"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3530,
          "end": 3548,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 3551,
      "end": 3634,
      "text": " \"إني لم أنم الليلة من أجل عمِّي العباس، وقد زعمت الأنصار أنهم قاتلوه\" فقال له عمر:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عمر",
          "name": "عمر",
          "role": "SPEAKER",
          "start": 3630,
          "end": 3633,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3634,
      "end": 3682,
      "text": " أفآتهم؟ فقال: \"نعم\"، فأتى عمر الأنصار فقال لهم:",
      "markers": []
    },
    {
      "id": "s046",
      "start": 3682,
      "end": 3738,
      "text": " أرسلوا العباس، فقالوا: لا والله لا نرسله، فقال لهم عمر:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عمر",
          "name": "عمر",
          "role": "SPEAKER",
          "start": 3734,
          "end": 3737,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3738,
      "end": 3785,
      "text": " فإن كان لرسول الله - صلى الله عليه وسلم - رضى؟",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3760,
          "end": 3778,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3785,
      "end": 3879,
      "text": " قالوا: فإن كان لرسول الله - صلى الله عليه وسلم - رضى فخذه، فأخذه عمر فلما صار في يده، قال له:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3814,
          "end": 3832,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3879,
      "end": 4010,
      "text": " يا عباس أسلم فوالله لأن تسلم أحب إليَّ من أن يسلم الخطاب، وما ذاك إلا لما رأيت رسول الله - صلى الله عليه وسلم - يعجبه إسلامك، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3971,
          "end": 3989,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 4010,
      "end": 4071,
      "text": " واستشار رسول الله - صلى الله عليه وسلم - أبا بكر فيهم، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4031,
          "end": 4049,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 4071,
      "end": 4113,
      "text": " أبو بكر عشيرتك فأرسلهم، فاستشار عمر فقال:",
      "markers": []
    },
    {
      "id": "s052",
      "start": 4113,
      "end": 4228,
      "text": " اقتلهم ففاداهم رسول الله - صلى الله عليه وسلم -، فأنزل الله {مَا كَانَ لِنَبِيٍّ أَنْ يَكُونَ لَهُ أَسْرَى} الآية ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4141,
          "end": 4159,
          "span_id": "s052"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 4163,
          "end": 4168,
          "span_id": "s052"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 4163,
          "end": 4173,
          "span_id": "s052"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4174,
          "end": 4221,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 4363,
      "end": 4401,
      "text": "، قال الحاكم: صحيح الإسناد ولم يخرجاه.",
      "markers": []
    },
    {
      "id": "s054",
      "start": 4401,
      "end": 4496,
      "text": "\r\nوقال سفيان الثوري، عن هشام بن حسان، عن محمد بن سيرين، عن عبيدة، عن علي - رضي الله عنه -، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4422,
          "end": 4459,
          "stripped": "عن هشام بن حسان، عن محمد بن سيرين، عن",
          "span_id": "s054"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 4470,
          "end": 4473,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4496,
      "end": 4554,
      "text": " جاء جبريل إلى النبي - صلى الله عليه وسلم - يوم بدر، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4519,
          "end": 4537,
          "span_id": "s055"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4540,
          "end": 4547,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4554,
      "end": 4655,
      "text": " خير أصحابك في الأسارى، إن شاؤوا الفداء، وإن شاؤوا القتل، على أن يقتل عامًا مقبلًا منهم مثلهم، قالوا:",
      "markers": []
    },
    {
      "id": "s057",
      "start": 4655,
      "end": 4733,
      "text": " الفداء ويقتل منا. رواه الترمذي والنسائي وابن حبان في صحيحه من حديث الثوري به ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 4674,
          "end": 4678,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4947,
      "end": 4985,
      "text": "، وهذا حديث غريب جدًا.\r\nوقال ابن عون، ",
      "markers": [
        {
          "family": "RAY",
          "marker": "غريب",
          "start": 4959,
          "end": 4963,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4994,
      "end": 4995,
      "text": " ",
      "markers": []
    },
    {
      "id": "s060",
      "start": 5044,
      "end": 5068,
      "text": "، عن عبيدة، عن علي، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5046,
          "end": 5068,
          "stripped": "عن عبيدة، عن علي، قال:",
          "span_id": "s060"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 5059,
          "end": 5062,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 5068,
      "end": 5123,
      "text": " قال رسول الله - صلى الله عليه وسلم - في أسارى يوم بدر:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 5069,
          "end": 5082,
          "span_id": "s061"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5085,
          "end": 5103,
          "span_id": "s061"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 5115,
          "end": 5122,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 5123,
      "end": 5205,
      "text": " \"إن شئتم قتلتموهم وإن شئتم فاديتموهم، واستمتعتم بالفداء واستشهد منكم بعدتهم\" قال:",
      "markers": []
    },
    {
      "id": "s063",
      "start": 5205,
      "end": 5269,
      "text": " فكان آخر السبعين، ثابت بن قيس قتل يوم اليمامة - رضي الله عنه - ",
      "markers": []
    },
    {
      "id": "s064",
      "start": 5364,
      "end": 5406,
      "text": "، ومنهم من روى هذا الحديث عن عبيدة مرسلًا ",
      "markers": []
    },
    {
      "id": "s065",
      "start": 5488,
      "end": 5561,
      "text": "، فالله أعلم.\r\nوقال محمد بن إسحاق، عن ابن أبي نجيح، عن عطاء، عن ابن عباس:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5523,
          "end": 5561,
          "stripped": "عن ابن أبي نجيح، عن عطاء، عن ابن عباس:",
          "span_id": "s065"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "NARRATOR",
          "start": 5543,
          "end": 5547,
          "span_id": "s065"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5552,
          "end": 5560,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 5561,
      "end": 5641,
      "text": " {مَا كَانَ لِنَبِيٍّ أَنْ يَكُونَ لَهُ أَسْرَى} فقرأ حتى بلغ {عَذَابٌ عَظِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5562,
          "end": 5609,
          "span_id": "s066"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 5611,
          "end": 5614,
          "span_id": "s066"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5623,
          "end": 5640,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 5641,
      "end": 5680,
      "text": " قال: غنائم بدر قبل أن يحلها لهم، يقول:",
      "markers": []
    },
    {
      "id": "s068",
      "start": 5680,
      "end": 5750,
      "text": " لولا أني لا أعذب من عصاني، حتى أتقدم إليه لمسكم فيما أخذتم عذاب عظيم ",
      "markers": []
    },
    {
      "id": "s069",
      "start": 5848,
      "end": 5882,
      "text": "، وكذا روى ابن أبي نجيح، عن مجاهد ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 5876,
          "end": 5881,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 5932,
      "end": 6033,
      "text": "، وقال الأعمش: سبق منه أن لا يعذب أحدًا شهد بدرًا، وروي نحوه عن سعد بن أبي وقاص، وسعيد بن جبير وعطاء ",
      "markers": []
    },
    {
      "id": "s071",
      "start": 6248,
      "end": 6284,
      "text": ".\r\nوقال شعبة، عن أبي هاشم، عن مجاهد:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6262,
          "end": 6284,
          "stripped": "عن أبي هاشم، عن مجاهد:",
          "span_id": "s071"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 6278,
          "end": 6283,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 6284,
      "end": 6340,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ} أي: لهم بالمغفرة ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6285,
          "end": 6322,
          "span_id": "s072"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 6323,
          "end": 6326,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 6386,
      "end": 6428,
      "text": ". ونحوه وعن سفيان الثوري -رَحِمَهُ اللهُ- ",
      "markers": []
    },
    {
      "id": "s074",
      "start": 6472,
      "end": 6517,
      "text": ".\r\nوقال علي بن أبي طلحة، عن ابن عباس في قوله:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "علي بن أبي طلحة",
          "name": "علي بن أبي طلحة",
          "role": "NARRATOR",
          "start": 6480,
          "end": 6495,
          "span_id": "s074"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6500,
          "end": 6508,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 6517,
      "end": 6561,
      "text": " {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ} يعني:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6518,
          "end": 6555,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 6561,
      "end": 6672,
      "text": " في أم الكتاب الأول، أن المغانم والأسارى حلال لكم {لَمَسَّكُمْ فِيمَا أَخَذْتُمْ} من الأسارى {عَذَابٌ عَظِيمٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6611,
          "end": 6642,
          "span_id": "s076"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6654,
          "end": 6671,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 6718,
      "end": 6788,
      "text": " قال الله تعالى: {فَكُلُوا مِمَّا غَنِمْتُمْ حَلَالًا طَيِّبًا} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6735,
          "end": 6781,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 6788,
      "end": 6817,
      "text": " وكذا روى العوفي عن ابن عباس ",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 6808,
          "end": 6816,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 6875,
      "end": 7046,
      "text": "، وروي مثله عن أبي هريرة، وابن مسعود، وسعيد بن جبير، وعطاء والحسن البصري، وقتادة والأعمش أيضًا، أن المراد {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ} لهذه الأُمة بإحلال الغنائم ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6981,
          "end": 7018,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 7346,
      "end": 7385,
      "text": "، وهو اختيار ابن جرير -رَحِمَهُ اللهُ-.",
      "markers": []
    },
    {
      "id": "s081",
      "start": 7385,
      "end": 7472,
      "text": "\r\nويُستشهد لهذا القول، بما أخرجاه في الصحيحين عن جابر بن عبد الله - رضي الله عنه - قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "في الصحيح",
          "start": 7419,
          "end": 7428,
          "span_id": "s081"
        },
        {
          "family": "SAHABA",
          "marker": "جابر",
          "name": "جابر",
          "role": "NARRATOR",
          "start": 7434,
          "end": 7438,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 7472,
      "end": 7510,
      "text": " قال رسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 7473,
          "end": 7486,
          "span_id": "s082"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7489,
          "end": 7507,
          "span_id": "s082"
        }
      ]
    },
    {
      "id": "s083",
      "start": 7510,
      "end": 7555,
      "text": " \"أُعطيت خمسًا لم يعطهن أحد من الأنبياء قبلي:",
      "markers": []
    },
    {
      "id": "s084",
      "start": 7555,
      "end": 7717,
      "text": " نُصرت بالرعب مسيرة شهر، وجُعلت لي الأرض مسجدًا وطهورًا، وأُحلَّت لي الغنائم ولم تحل لأحد قبلي، وأُعطيت الشفاعة، وكان النبي يبعث إلى قومه، وبُعثت إلى الناس عامة\" ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "ان النبي",
          "start": 7670,
          "end": 7678,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 7762,
      "end": 7826,
      "text": ".\r\nوقال الأعمش، عن أبي صالح، عن أبي هريرة - رضي الله عنه -، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7778,
          "end": 7809,
          "stripped": "عن أبي صالح، عن أبي هريرة - رضي",
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 7826,
      "end": 7864,
      "text": " قال رسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 7827,
          "end": 7840,
          "span_id": "s086"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7843,
          "end": 7861,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 7864,
      "end": 7900,
      "text": " \"لم تحل الغنائم لسود الرؤوس غيرنا\" ",
      "markers": []
    },
    {
      "id": "s088",
      "start": 8097,
      "end": 8202,
      "text": " ولهذا قال تعالى: {فَكُلُوا مِمَّا غَنِمْتُمْ حَلَالًا طَيِّبًا} الآية، فعند ذلك أخذوا من الأسارى الفداء.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قال تعالى",
          "start": 8104,
          "end": 8113,
          "span_id": "s088"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8115,
          "end": 8161,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 8202,
      "end": 8236,
      "text": "\r\nوقد روى الإمام أبو داود في سننه:",
      "markers": []
    },
    {
      "id": "s090",
      "start": 8236,
      "end": 8425,
      "text": " حدثنا عبد الرحمن بن المبارك العبسي، حدثنا سفيان بن حبيب، حدثنا شعبة، عن أبي العنبس، عن أبي الشعثاء، عن ابن عباس، أن رسول الله - صلى الله عليه وسلم - جعل فداء أهل الجاهلية يوم بدر أربعمائة ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8237,
          "end": 8242,
          "span_id": "s090"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8273,
          "end": 8278,
          "span_id": "s090"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 8273,
          "end": 8312,
          "stripped": "حدثنا سفيان بن حبيب، حدثنا شعبة، عن أبي",
          "span_id": "s090"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8294,
          "end": 8299,
          "span_id": "s090"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 8306,
          "end": 8343,
          "stripped": "عن أبي العنبس، عن أبي الشعثاء، عن ابن",
          "span_id": "s090"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 8340,
          "end": 8348,
          "span_id": "s090"
        },
        {
          "family": "HADITH",
          "marker": "أن رسول الله",
          "start": 8350,
          "end": 8362,
          "span_id": "s090"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 8365,
          "end": 8383,
          "span_id": "s090"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 8408,
          "end": 8415,
          "span_id": "s090"
        }
      ]
    },
    {
      "id": "s091",
      "start": 8554,
      "end": 8882,
      "text": ".\r\nوقد استمر الحكم في الأسرى عند جمهور العلماء، أن الإمام مخير فيهم إن شاء قتل كما فعل ببني قريظة، وإن شاء فادى بمال كما فعل بأسرى بدر، أو بمن أسر من المسلمين، كما فعل رسول الله - صلى الله عليه وسلم - في تلك الجارية وابنتها، اللتين كانتا في سبي سلمة بن الأكوع، حيث ردَّهما وأخذ في مقابلتهما من المسلمين الذين كانوا عند المشركين ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 8734,
          "end": 8752,
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 8998,
      "end": 9021,
      "text": "، وإن شاء استرق من أسر.",
      "markers": []
    },
    {
      "id": "s093",
      "start": 9021,
      "end": 9125,
      "text": " هذا مذهب الإمام الشافعي وطائفة من العلماء، وفي المسألة خلاف آخر بين الأئمة، مقرر في موضعه من كتب الفقه.",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s013",
      "start": 950,
      "end": 1009,
      "text": "¬تقدم تخريجه وصحته في تفسير الآية 9 من هذه السورة الكريمة.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s034",
      "start": 2412,
      "end": 2423,
      "text": "¬أي فقراء.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s038",
      "start": 2908,
      "end": 3076,
      "text": "¬أخرجه الإمام أحمد عن أبي معاوية به (المسند 6/ 140 ح 3632)، وضعفه محققوه لأن أبا عبيدة لم يسمع من ابن مسعود، وذكروا أن لبعضه شواهد في صحيح مسلم. أي في الرواية السابقة.¥",
      "grading": [
        "صحيح"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s052",
      "start": 4228,
      "end": 4363,
      "text": "¬أخرجه الحاكم وصححه ووافقه الذهبي (المستدرك 2/ 329)، وفي سنده إبراهيم بن مهاجر فيه مقال كما\r\nفي التقريب، ومعظمه له شواهد سابقة ولاحقة.¥",
      "grading": [
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s057",
      "start": 4733,
      "end": 4947,
      "text": "¬سنن الترمذي، السير، باب ما جاء في قتل الأسارى والفداء (ح 1567)، والسنن الكبرى للنسائي (ح 8662)، ومتنه يخالف قوله تعالى: {مَا كَانَ لِنَبِيٍّ أَنْ يَكُونَ لَهُ أَسْرَى حَتَّى يُثْخِنَ فِي الْأَرْضِ} [الأنفال: 67].¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s059",
      "start": 4995,
      "end": 5044,
      "text": "¬الزيادة من المستدرك (2/ 140) وهو محمد بن سيرين.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s063",
      "start": 5269,
      "end": 5364,
      "text": "¬أخرجه الحاكم من طريق أزهر بن سعد السمان عن ابن عون به، وصححه ووافقه الذهبي (المستدرك 2/ 140).¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s064",
      "start": 5406,
      "end": 5488,
      "text": "¬أخرجه الطبري من طريق محمد بن سيرين عن عبيدة، وسنده صحيح لكنه مرسل ويتقوى بسابقه.¥",
      "grading": [
        "صحيح",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s068",
      "start": 5750,
      "end": 5848,
      "text": "¬سنده حسن وقد صرح ابن إسحاق بالتحديث، وصرح بأن عطاء هو ابن أبي رباح (سيرة ابن هشام 2/ 675 - 676).¥",
      "grading": [
        "حسن",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s069",
      "start": 5882,
      "end": 5932,
      "text": "¬أخرجه الطبري بسنده صحيح من طريق ابن أبي نجيح به.¥",
      "grading": [
        "صحيح",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s070",
      "start": 6033,
      "end": 6248,
      "text": "¬قول سعد أخرجه ابن أبي حاتم بسند صحيح من طريق خيثمة عنه، وقول سعيد بن جبير أخرجه ابن أبي حاتم بسند حسن من طريق عطاء بن دينار به، وقول الأعمش أخرجه الطبري بسند صحيح من طريق معمر عنه قال: سبق من الله أحل لهم الغنيمة.¥",
      "grading": [
        "صحيح",
        "حسن"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s072",
      "start": 6340,
      "end": 6386,
      "text": "¬أخرجه ابن أبي حاتم من طريق شعبة به بسند حسن.¥",
      "grading": [
        "حسن"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s073",
      "start": 6428,
      "end": 6472,
      "text": "¬أخرجه ابن أبي حاتم من طريق قبيصة عن سفيان.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s076",
      "start": 6672,
      "end": 6718,
      "text": "¬أخرجه ابن أبي حاتم بسند ثابت من طريق علي به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s078",
      "start": 6817,
      "end": 6875,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق العوفي به ويتقوى بما سبق.¥",
      "grading": [
        "ضعيف"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s079",
      "start": 7046,
      "end": 7346,
      "text": "¬قول أبي هريرة أخرجه الطبري وابن أبي حاتم بسند فيه بشير بن ميمون وهو متروك متهم كما في التقريب، وأخرجه الطبري من طريق آخر عن الأعمش عن أبي صالح عن أبي هريرة وصححه أحمد شاكر، وقول ابن مسعود أخرجه الطبري من طريق أبي وائل عنه وصححه أحمد شاكر، وقول قتادة والأعمش والحسن البصري أخرجه الطبري بأسانيد صحاح.¥",
      "grading": [
        "حسن"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s084",
      "start": 7717,
      "end": 7762,
      "text": "¬تقدم تخريجه في تفسير آية 43 من سورة النساء.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s087",
      "start": 7900,
      "end": 8097,
      "text": "¬أخرجه الترمذي من طريق الأعمش به وقال: حسن صحيح (السنن، تفسير القرآن، باب ومن سورة الأنفال ح 3085)، وصححه الألباني في صحيح سنن الترمذي (ح 2463)، وأخرجه الإمام أحمد وصححه أحمد شاكر (المسند ح 7427).¥",
      "grading": [
        "صحيح",
        "حسن"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s090",
      "start": 8425,
      "end": 8554,
      "text": "¬أخرجه أبو داود في سننه، الجهاد، باب فداء الأسير بالمال (ح 2691)، وصححه الألباني دون لفظ: الأربعمائة (صحيح سنن أبي داود ح 2340).¥",
      "grading": [
        "صحيح"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s091",
      "start": 8882,
      "end": 8998,
      "text": "¬أخرجه مسلم مطولًا عن سلمة بن الأكوع - رضي الله عنه - (الصحيح، الجهاد، باب التنفيل وفداء المسلمين بالأسارى ح 1755).¥",
      "grading": [
        "صحيح"
      ]
    }
  ]
}
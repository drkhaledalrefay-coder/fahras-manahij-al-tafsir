  "spans": [
    {
      "id": "s001",
      "start": 0,
      "end": 202,
      "text": "{وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ وَهُمْ يَصُدُّونَ عَنِ الْمَسْجِدِ الْحَرَامِ وَمَا كَانُوا أَوْلِيَاءَهُ إِنْ أَوْلِيَاؤُهُ إِلَّا الْمُتَّقُونَ وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ (34)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 0,
          "end": 201,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 202,
      "end": 468,
      "text": "\r\nيخبر تعالى أنهم أهل لأن يعذبهم، ولكن لم يوقع ذلك بهم لبركة مقام الرسول - صلى الله عليه وسلم - بين أظهرهم، ولهذا لما خرج من بين أظهرهم أوقع الله بهم بأسه يوم بدر، فقتل صناديدهم وأسر سراتهم، وأرشدهم تعالى إلى الاستغفار من الذنوب التي هم متلبسون بها من الشرك والفساد.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 277,
          "end": 295,
          "span_id": "s002"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 357,
          "end": 364,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 468,
      "end": 548,
      "text": " وقال قتادة والسدي وغيرهما: لم يكن القوم يستغفرون، ولو كانوا يستغفرون لما عذبوا ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 474,
          "end": 479,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 675,
      "end": 841,
      "text": ".\r\nواختاره ابن جرير، فلولا ما كان بين أظهرهم من المستضعفين من المؤمنين المستغفرين لوقع بهم البأس الذي لا يرد، ولكن دفع عنهم بسبب أولئك، كما قال تعالى في يوم الحديبية:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "كما قال تعالى",
          "start": 811,
          "end": 824,
          "span_id": "s004"
        },
        {
          "family": "QURAN",
          "marker": "قال تعالى",
          "start": 815,
          "end": 824,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 841,
      "end": 1221,
      "text": " {هُمُ الَّذِينَ كَفَرُوا وَصَدُّوكُمْ عَنِ الْمَسْجِدِ الْحَرَامِ وَالْهَدْيَ مَعْكُوفًا أَنْ يَبْلُغَ مَحِلَّهُ وَلَوْلَا رِجَالٌ مُؤْمِنُونَ وَنِسَاءٌ مُؤْمِنَاتٌ لَمْ تَعْلَمُوهُمْ أَنْ تَطَئُوهُمْ فَتُصِيبَكُمْ مِنْهُمْ مَعَرَّةٌ بِغَيْرِ عِلْمٍ لِيُدْخِلَ اللَّهُ فِي رَحْمَتِهِ مَنْ يَشَاءُ لَوْ تَزَيَّلُوا لَعَذَّبْنَا الَّذِينَ كَفَرُوا مِنْهُمْ عَذَابًا أَلِيمًا (25)} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 842,
          "end": 1220,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 1228,
      "end": 1314,
      "text": ".\r\nقال ابن جرير: حدثنا ابن حميد، حدثنا يعقوب، عن جعفر بن أبي المغيرة، عن ابن أبزى قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1245,
          "end": 1250,
          "span_id": "s006"
        },
        {

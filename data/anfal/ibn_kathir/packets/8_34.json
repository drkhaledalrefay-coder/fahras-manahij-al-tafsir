    {
      "id": "s019",
      "start": 2393,
      "end": 2606,
      "text": " قال في الأنفال: {وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ (33)}، فنسختها الآية التي تليها {وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ} إلى قوله:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2410,
          "end": 2526,
          "span_id": "s019"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2553,
          "end": 2596,
          "span_id": "s019"
        }
      ]
    },
    {
      "id": "s020",
      "start": 2606,
      "end": 2696,
      "text": " {فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ}، فقوتلوا بمكة فأصابهم فيها الجوع والضر ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2607,
          "end": 2656,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 2940,
      "end": 2996,
      "text": "، وكذا رواه ابن أبي حاتم من حديث أبي تميلة يحيى بن واضح ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 2947,
          "end": 2951,
          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 3018,
      "end": 3039,
      "text": ".\r\nوقال ابن أبي حاتم:",
      "markers": []
    },
    {
      "id": "s023",
      "start": 3039,
      "end": 3224,
      "text": " حدثنا الحسن بن محمد بن الصباح، حدثنا حجاج بن محمد، عن ابن جريج وعثمان بن عطاء، عن عطاء، عن ابن عباس {وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ} ثم استثنى أهل الشرك فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3040,
          "end": 3045,
          "span_id": "s023"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3071,
          "end": 3076,
          "span_id": "s023"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 3094,
          "end": 3102,
          "span_id": "s023"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3119,
          "end": 3151,
          "stripped": "عن عطاء، عن ابن عباس {وما كان",
          "span_id": "s023"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "NARRATOR",
          "start": 3122,
          "end": 3126,
          "span_id": "s023"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 3131,
          "end": 3139,
          "span_id": "s023"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3140,
          "end": 3198,
          "span_id": "s023"
        }
      ]
    },
    {
      "id": "s024",
      "start": 3224,
      "end": 3321,
      "text": " {وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ وَهُمْ يَصُدُّونَ عَنِ الْمَسْجِدِ الْحَرَامِ} وقوله:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3225,
          "end": 3314,
          "span_id": "s024"
        }
      ]
    },
    {
      "id": "s025",
      "start": 3321,
      "end": 3527,
      "text": " {وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ وَهُمْ يَصُدُّونَ عَنِ الْمَسْجِدِ الْحَرَامِ وَمَا كَانُوا أَوْلِيَاءَهُ إِنْ أَوْلِيَاؤُهُ إِلَّا الْمُتَّقُونَ وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ (34)} أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3322,
          "end": 3523,
          "span_id": "s025"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 3524,
          "end": 3527,
          "span_id": "s025"
        }
      ]
    },
    {
      "id": "s026",
      "start": 3527,
      "end": 3575,
      "text": " وكيف لا يعذبهم الله وهم يصدون عن المسجد الحرام ",
      "markers": []
    },
    {
      "id": "s027",
      "start": 3633,
      "end": 3714,
      "text": "؟ أي: الذي بمكة يصدون المؤمنين الذين هم أهله عن الصلاة فيه والطواف به، ولهذا قال:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 3635,
          "end": 3638,
          "span_id": "s027"
        }
      ]
    },
    {
      "id": "s028",
      "start": 3714,
      "end": 3788,
      "text": " {وَمَا كَانُوا أَوْلِيَاءَهُ إِنْ أَوْلِيَاؤُهُ إِلَّا الْمُتَّقُونَ} أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3715,
          "end": 3784,
          "span_id": "s028"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 3785,
          "end": 3788,
          "span_id": "s028"
        }
      ]
    },
    {
      "id": "s029",
      "start": 3788,
      "end": 3878,
      "text": " هم ليسوا أهل المسجد الحرام وإنما أهله النبي - صلى الله عليه وسلم - وأصحابه كما قال تعالى:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3835,
          "end": 3853,
          "span_id": "s029"
        },
        {
          "family": "QURAN",
          "marker": "كما قال تعالى",
          "start": 3864,
          "end": 3877,
          "span_id": "s029"
        },
        {
          "family": "QURAN",
          "marker": "قال تعالى",
          "start": 3868,
          "end": 3877,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 3878,
      "end": 4256,
      "text": " {مَا كَانَ لِلْمُشْرِكِينَ أَنْ يَعْمُرُوا مَسَاجِدَ اللَّهِ شَاهِدِينَ عَلَى أَنْفُسِهِمْ بِالْكُفْرِ أُولَئِكَ حَبِطَتْ أَعْمَالُهُمْ وَفِي النَّارِ هُمْ خَالِدُونَ (17) إِنَّمَا يَعْمُرُ مَسَاجِدَ اللَّهِ مَنْ آمَنَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَأَقَامَ الصَّلَاةَ وَآتَى الزَّكَاةَ وَلَمْ يَخْشَ إِلَّا اللَّهَ فَعَسَى أُولَئِكَ أَنْ يَكُونُوا مِنَ الْمُهْتَدِينَ (18)} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3879,
          "end": 4255,
          "span_id": "s030"
        }
      ]
    },
    {
      "id": "s031",
      "start": 4264,
      "end": 4406,
      "text": "، وقال تعالى: {وَصَدٌّ عَنْ سَبِيلِ اللَّهِ وَكُفْرٌ بِهِ وَالْمَسْجِدِ الْحَرَامِ وَإِخْرَاجُ أَهْلِهِ مِنْهُ أَكْبَرُ عِنْدَ اللَّهِ} الآية ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "وقال تعالى",
          "start": 4266,
          "end": 4276,
          "span_id": "s031"
        },
        {
          "family": "QURAN",
          "marker": "قال تعالى",
          "start": 4267,
          "end": 4276,
          "span_id": "s031"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4278,
          "end": 4399,
          "span_id": "s031"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 4406,
          "end": 4419,
          "text": "[البقرة: 217]",
          "via": "apparatus",
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 4419,
      "end": 4471,
      "text": ".\r\nوقال الحافظ أبو بكر بن مردويه في تفسير هذه الآية:",
      "markers": []
    },
    {
      "id": "s033",
      "start": 4471,
      "end": 4651,
      "text": " حدثنا سليمان بن أحمد - هو الطبراني -، حدثنا جعفر بن إلياس بن صدقة المصري، حدثنا نعيم بن حماد، حدثنا نوح بن أبي مريم، عن يحيى بن سعيد الأنصاري، عن أنس بن مالك - رضي الله عنه - قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4472,
          "end": 4477,
          "span_id": "s033"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4510,
          "end": 4515,
          "span_id": "s033"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4546,
          "end": 4551,
          "span_id": "s033"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 4546,
          "end": 4582,
          "stripped": "حدثنا نعيم بن حماد، حدثنا نوح بن أبي",
          "span_id": "s033"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4566,
          "end": 4571,
          "span_id": "s033"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4589,
          "end": 4631,
          "stripped": "عن يحيى بن سعيد الأنصاري، عن أنس بن مالك -",
          "span_id": "s033"
        },
        {
          "family": "SAHABA",
          "marker": "أنس",
          "name": "أنس",
          "role": "NARRATOR",
          "start": 4618,
          "end": 4621,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 4651,
      "end": 4700,
      "text": " سئل رسول الله - صلى الله عليه وسلم - من أولياؤك؟",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4668,
          "end": 4686,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 4700,
      "end": 4797,
      "text": " قال: \"كل تقي\". وتلا رسول الله - صلى الله عليه وسلم -: {إِنْ أَوْلِيَاؤُهُ إِلَّا الْمُتَّقُونَ} ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4733,
          "end": 4751,
          "span_id": "s035"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4755,
          "end": 4796,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 5002,
      "end": 5028,
      "text": ".\r\nوقال الحاكم في مستدركه:",
      "markers": []
    },
    {
      "id": "s037",
      "start": 5028,
      "end": 5174,
      "text": " حدثنا أبو بكر الشافعي، حدثنا إسحاق بن الحسن، حدثنا أبو حذيفة، حدثنا سفيان، عن عبد الله بن خثيم، عن إسماعيل بن عبيد بن رفاعة، عن أبيه، عن جده قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5029,
          "end": 5034,
          "span_id": "s037"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 5029,
          "end": 5096,
          "stripped": "حدثنا أبو بكر الشافعي، حدثنا إسحاق بن الحسن، حدثنا أبو حذيفة، حدثنا",
          "span_id": "s037"
        },
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "NARRATOR",
          "start": 5035,
          "end": 5042,
          "span_id": "s037"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5052,
          "end": 5057,
          "span_id": "s037"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "NARRATOR",
          "start": 5067,
          "end": 5072,
          "span_id": "s037"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5074,
          "end": 5079,
          "span_id": "s037"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5091,
          "end": 5096,
          "span_id": "s037"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5104,
          "end": 5146,
          "stripped": "عن عبد الله بن خثيم، عن إسماعيل بن عبيد بن",
          "span_id": "s037"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5154,
          "end": 5174,
          "stripped": "عن أبيه، عن جده قال:",
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 5174,
      "end": 5224,
      "text": " جمع رسول الله - صلى الله عليه وسلم - قريشًا فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5191,
          "end": 5209,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 5224,
      "end": 5253,
      "text": " \"هل فيكم من غيركم؟ \" فقالوا:",
      "markers": []
    },
    {
      "id": "s040",
      "start": 5253,
      "end": 5300,
      "text": " فينا ابن أختنا وفينا حليفنا وفينا مولانا فقال:",
      "markers": []
    },
    {
      "id": "s041",
      "start": 5300,
      "end": 5365,
      "text": " \"حليفنا منا وابن أختنا منا ومولانا منا إن أوليائي منكم المتقون\".",
      "markers": []
    },
    {
      "id": "s042",
      "start": 5365,
      "end": 5393,
      "text": " ثم قال هذا صحيح ولم يخرجاه ",
      "markers": []
    },
    {
      "id": "s043",
      "start": 5577,
      "end": 5626,
      "text": ".\r\nوقال عروة والسدي ومحمد بن إسحاق في قوله تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 5615,
          "end": 5625,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 5626,
      "end": 5730,
      "text": " {إِنْ أَوْلِيَاؤُهُ إِلَّاالْمُتَّقُونَ} قال: هم محمد - صلى الله عليه وسلم - وأصحابه - رضي الله عنهم - ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5627,
          "end": 5667,
          "span_id": "s044"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5683,
          "end": 5701,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 5884,
      "end": 5932,
      "text": ".\r\nوقال مجاهد: هم المجاهدون من كانوا وحيث كانوا ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 5892,
          "end": 5897,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 6024,
      "end": 6025,
      "text": ".",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s003",
      "start": 548,
      "end": 675,
      "text": "¬قول قتادة أخرجه الطبري بسند صحيح من طريق سعيد بن أبي عروبة عن قتادة، وقول السدي أخرجه الطبري بسند حسن من طريق أسباط عن السدي.¥",
      "grading": [
        "صحيح",
        "حسن"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s014",
      "start": 1853,
      "end": 1908,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده ضعيف لإرسال ابن أبزى.¥",
      "grading": [
        "ضعيف",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s015",
      "start": 1963,
      "end": 2128,
      "text": "¬قول ابن عباس أخرجه الطبري بسند ضعيف من طريق العوفي عنه، وقول الضحّاك أخرجه الطبري بسند ضعيف فيه سفيان بن وكيع، وقول أبي مالك أخرجه الطبري بأسانيد يقوي بعضها بعضًا.¥",
      "grading": [
        "ضعيف"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s020",
      "start": 2696,
      "end": 2940,
      "text": "¬أخرجه الطبري بسنده ومتنه وفي آخره بلفظ: \"الجوع والحصر\"، وفي سنده ابن حميد، وهو محمد بن حميد الرازي ضعيف وقد توبع فأخرجه ابن أبي حاتم من طريق أحمد بن إسماعيل بن أبي ضرار عن أبي تميلة يحيى بن واضح به، وسنده حسن وهذان المرسلان يقوي أحدهما الآخر.¥",
      "grading": [
        "حسن",
        "ضعيف",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s021",
      "start": 2996,
      "end": 3018,
      "text": "¬كما في السند السابق.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s026",
      "start": 3575,
      "end": 3633,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده ضعيف، ومعناه صحيح.¥",
      "grading": [
        "صحيح",

          "marker": "حدثنا…حدثنا",
          "start": 1245,
          "end": 1281,
          "stripped": "حدثنا ابن حميد، حدثنا يعقوب، عن جعفر",
          "span_id": "s006"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1261,
          "end": 1266,
          "span_id": "s006"
        },
        {

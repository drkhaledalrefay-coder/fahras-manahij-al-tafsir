    {
      "id": "s001",
      "start": 0,
      "end": 157,
      "text": "{وَإِذْ قَالُوا اللَّهُمَّ إِنْ كَانَ هَذَا هُوَ الْحَقَّ مِنْ عِنْدِكَ فَأَمْطِرْ عَلَيْنَا حِجَارَةً مِنَ السَّمَاءِ أَوِ ائْتِنَا بِعَذَابٍ أَلِيمٍ (32)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 0,
          "end": 156,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 157,
      "end": 415,
      "text": "\r\nوقوله: {وَإِذْ قَالُوا اللَّهُمَّ إِنْ كَانَ هَذَا هُوَ الْحَقَّ مِنْ عِنْدِكَ فَأَمْطِرْ عَلَيْنَا حِجَارَةً مِنَ السَّمَاءِ أَوِ ائْتِنَا بِعَذَابٍ أَلِيمٍ (32)} هذا من كثرة جهلهم وشدة تكذيبهم وعنادهم وعتوهم، وهذا مما عيبوا به وكان الأَولى لهم أن يقولوا:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 166,
          "end": 322,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 415,
      "end": 547,
      "text": " اللَّهم إن كان هذا هو الحق من عندك فاهدنا له ووفقنا لاتباعه، ولكن استفتحوا على أنفسهم واستعجلوا العذاب، وتقديم العقوبة كقوله تعالى:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "كقول",
          "start": 535,
          "end": 539,
          "span_id": "s003"
        },
        {
          "family": "LUGHA",
          "marker": "كقوله",
          "start": 535,
          "end": 540,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 536,
          "end": 546,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 547,
      "end": 689,
      "text": " {وَيَسْتَعْجِلُونَكَ بِالْعَذَابِ وَلَوْلَا أَجَلٌ مُسَمًّى لَجَاءَهُمُ الْعَذَابُ وَلَيَأْتِيَنَّهُمْ بَغْتَةً وَهُمْ لَا يَشْعُرُونَ (53)} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 548,
          "end": 688,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 699,
      "end": 774,
      "text": " {وَقَالُوا رَبَّنَا عَجِّلْ لَنَا قِطَّنَا قَبْلَ يَوْمِ الْحِسَابِ (16)} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 700,
          "end": 773,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 777,
      "end": 897,
      "text": " وقوله: {سَأَلَ سَائِلٌ بِعَذَابٍ وَاقِعٍ (1) لِلْكَافِرِينَ لَيْسَ لَهُ دَافِعٌ (2) مِنَ اللَّهِ ذِي الْمَعَارِجِ (3)} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 785,
          "end": 896,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 906,
      "end": 961,
      "text": " وكذلك قال الجهلة من الأمم السالفة كما قال قوم شعيب له:",
      "markers": []
    },
    {
      "id": "s008",
      "start": 961,
      "end": 1046,
      "text": " {فَأَسْقِطْ عَلَيْنَا كِسَفًا مِنَ السَّمَاءِ إِنْ كُنْتَ مِنَ الصَّادِقِينَ (187)} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 962,
          "end": 1045,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 1055,
      "end": 1261,
      "text": " وقال هؤلاء: {اللَّهُمَّ إِنْ كَانَ هَذَا هُوَ الْحَقَّ مِنْ عِنْدِكَ فَأَمْطِرْ عَلَيْنَا حِجَارَةً مِنَ السَّمَاءِ أَوِ ائْتِنَا بِعَذَابٍ أَلِيمٍ} قال شعبة عن عبد الحميد صاحب الزيادي، عن أنس بن مالك قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1068,
          "end": 1204,
          "span_id": "s009"
        },

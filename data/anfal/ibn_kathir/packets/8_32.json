      "start": 3159,
      "end": 3235,
      "text": " وقال: {وَلَقَدْ جِئْتُمُونَا فُرَادَى كَمَا خَلَقْنَاكُمْ أَوَّلَ مَرَّةٍ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3166,
          "end": 3234,
          "span_id": "s022"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 3235,
          "end": 3248,
          "text": "[الأنعام: 94]",
          "via": "apparatus",
          "span_id": "s022"
        }
      ]
    },
    {
      "id": "s023",
      "start": 3248,
      "end": 3309,
      "text": " وقال: {سَأَلَ سَائِلٌ بِعَذَابٍ وَاقِعٍ (1) لِلْكَافِرِينَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3255,
          "end": 3308,
          "span_id": "s023"
        }
      ]
    },
    {
      "id": "s024",
      "start": 3318,
      "end": 3385,
      "text": " قال عطاء: ولقد أنزل الله فيه بضع عشرة آية من كتاب الله - عز وجل - ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 3323,
          "end": 3327,
          "span_id": "s024"
        }
      ]
    },
    {
      "id": "s025",
      "start": 3481,
      "end": 3627,
      "text": ".\r\nوقال ابن مردويه: حدثنا محمد بن إبراهيم، حدثنا الحسن بن أحمد بن الليث، حدثنا أبو غسان، حدثنا أبو تميلة، حدثنا الحسين، عن ابن بريدة، عن أبيه قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3501,
          "end": 3506,
          "span_id": "s025"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 3501,
          "end": 3543,
          "stripped": "حدثنا محمد بن إبراهيم، حدثنا الحسن بن أحمد",
          "span_id": "s025"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3524,
          "end": 3529,
          "span_id": "s025"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "NARRATOR",
          "start": 3530,
          "end": 3535,
          "span_id": "s025"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3554,
          "end": 3559,
          "span_id": "s025"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 3554,
          "end": 3592,
          "stripped": "حدثنا أبو غسان، حدثنا أبو تميلة، حدثنا",
          "span_id": "s025"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3570,
          "end": 3575,
          "span_id": "s025"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3587,
          "end": 3592,
          "span_id": "s025"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3601,
          "end": 3627,
          "stripped": "عن ابن بريدة، عن أبيه قال:",
          "span_id": "s025"
        }
      ]
    },
    {
      "id": "s026",
      "start": 3627,
      "end": 3680,
      "text": " رأيت عمرو بن العاص واقفًا يوم أُحد على فرس وهو يقول:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم أحد",
          "start": 3654,
          "end": 3662,
          "span_id": "s026"
        }
      ]
    },
    {
      "id": "s027",
      "start": 3680,
      "end": 3730,
      "text": " اللَّهم إن كان ما يقول محمد حقًا فاخسف بي وبفرسي ",
      "markers": []
    },
    {
      "id": "s028",
      "start": 3788,
      "end": 3810,
      "text": ".\r\nوقال قتادة في قوله:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 3796,
          "end": 3801,
          "span_id": "s028"
        }
      ]
    },
    {
      "id": "s029",
      "start": 3810,
      "end": 3895,
      "text": " {وَإِذْ قَالُوا اللَّهُمَّ إِنْ كَانَ هَذَا هُوَ الْحَقَّ مِنْ عِنْدِكَ} الآية، قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3811,
          "end": 3883,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 3895,
      "end": 3979,
      "text": " قال ذلك سفهة هذه الأمة وجهلتها فعاد الله بعائدته ورحمته على سفهة هذه الأمة وجهلتها ",
      "markers": []
    },
    {
      "id": "s031",
      "start": 4045,
      "end": 4178,
      "text": ".\r\nوقوله تعالى: {وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ (33)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "وقوله تعالى",
          "start": 4048,
          "end": 4059,
          "span_id": "s031"
        },
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 4049,
          "end": 4059,
          "span_id": "s031"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4061,
          "end": 4177,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 4178,
      "end": 4301,
      "text": " قال ابن أبي حاتم: حدثنا أبي، حدثنا أبو حذيفة موسى بن مسعود، حدثنا عكرمة بن عمار، عن أبي زميل سماك الحنفي، عن ابن عباس قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4197,
          "end": 4202,
          "span_id": "s032"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 4197,
          "end": 4228,
          "stripped": "حدثنا أبي، حدثنا أبو حذيفة موسى",
          "span_id": "s032"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4208,
          "end": 4213,
          "span_id": "s032"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4239,
          "end": 4244,
          "span_id": "s032"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4260,
          "end": 4301,
          "stripped": "عن أبي زميل سماك الحنفي، عن ابن عباس قال:",
          "span_id": "s032"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4288,
          "end": 4296,
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 4301,
      "end": 4337,
      "text": " كان المشركون يطوفون بالبيت ويقولون:",
      "markers": []
    },
    {
      "id": "s034",
      "start": 4337,
      "end": 4409,
      "text": " لبيك اللَّهم لبيك، لبيك لا شريك لك، فيقول النبي - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4388,
          "end": 4406,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 4409,
      "end": 4489,
      "text": " قد، قد، ويقولون: اللَّهم لبيك، لبيك لا شريك لك إلا شريكًا هو لك، تملكه وما ملك.",
      "markers": []
    },
    {
      "id": "s036",
      "start": 4489,
      "end": 4524,
      "text": " ويقولون: غفرانك غفرانك فأنزل الله:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 4513,
          "end": 4518,
          "span_id": "s036"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 4513,
          "end": 4523,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 4524,
      "end": 4599,
      "text": " {وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ} الآية قال ابن عباس:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4525,
          "end": 4579,
          "span_id": "s037"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4590,
          "end": 4598,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 4599,
      "end": 4706,
      "text": " كان فيهم أمانان: النبي - صلى الله عليه وسلم - والاستغفار فذهب النبي - صلى الله عليه وسلم - وبقي الاستغفار ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4625,
          "end": 4643,
          "span_id": "s038"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4670,
          "end": 4688,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 4821,
      "end": 4922,
      "text": ".\r\nوقال ابن جرير: حدثني الحارث، حدثني عبد العزيز، حدثنا أبو معشر، عن يزيد بن رومان ومحمد بن قيس قالا:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4871,
          "end": 4876,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 4922,
      "end": 4970,
      "text": " قالت قريش بعضها لبعض: محمد أكرمه الله من بيننا.",
      "markers": []
    },
    {
      "id": "s041",
      "start": 4970,
      "end": 5073,
      "text": " {اللَّهُمَّ إِنْ كَانَ هَذَا هُوَ الْحَقَّ مِنْ عِنْدِكَ} الآية فلما أمسوا ندموا على ما قالوا، فقالوا:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4971,
          "end": 5028,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 5073,
      "end": 5212,
      "text": " غفرانك اللَّهم. فأنزل الله: {وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ} إلى قوله: {وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ} ",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 5090,
          "end": 5095,
          "span_id": "s042"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 5090,
          "end": 5100,
          "span_id": "s042"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5102,
          "end": 5160,
          "span_id": "s042"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5171,
          "end": 5211,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 5264,
      "end": 5265,
      "text": " ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 5265,
          "end": 5278,
          "text": "[الأنفال: 34]",
          "via": "apparatus",
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 5278,
      "end": 5315,
      "text": ".\r\nوقال علي بن أبي طلحة، عن ابن عباس:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "علي بن أبي طلحة",
          "name": "علي بن أبي طلحة",
          "role": "NARRATOR",
          "start": 5286,
          "end": 5301,
          "span_id": "s044"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5306,
          "end": 5314,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 5315,
      "end": 5376,
      "text": " {وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ} يقول:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5316,
          "end": 5370,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 5376,
      "end": 5440,
      "text": " ما كان الله ليعذب قومًا وأنبياؤهم بين أظهرهم حتى يخرجهم ثم قال:",
      "markers": []
    },
    {
      "id": "s047",
      "start": 5440,
      "end": 5505,
      "text": " {وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ} يقول:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5441,
          "end": 5499,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 5505,
      "end": 5580,
      "text": " ومنهم مَن قد سبق له من الله الدخول في الإيمان وهو الاستغفار يستغفرون يعني:",
      "markers": []
    },
    {
      "id": "s049",
      "start": 5580,
      "end": 5608,
      "text": " يصلُّون. يعني بهذا أهل مكة ",
      "markers": []
    },
    {
      "id": "s050",
      "start": 5655,
      "end": 5720,
      "text": ". وروي عن مجاهد وعكرمة وعطية العوفي وسعيد بن جبير والسدي نحو ذلك ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 5665,
          "end": 5670,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 5776,
      "end": 5801,
      "text": ".\r\nوقال الضحاك وأبو مالك:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 5784,
          "end": 5790,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 5801,
      "end": 5893,
      "text": " {وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ} يعني: المؤمنين الذين كانوا بمكة ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5802,
          "end": 5860,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 6012,
      "end": 6033,
      "text": ".\r\nوقال ابن أبي حاتم:",
      "markers": []
    },
    {
      "id": "s054",
      "start": 6033,
      "end": 6095,
      "text": " حدثنا أبي، حدثنا عبد الغفار بن داود، حدثنا النضر بن عربي قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6034,
          "end": 6039,
          "span_id": "s054"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 6034,
          "end": 6064,
          "stripped": "حدثنا أبي، حدثنا عبد الغفار بن",
          "span_id": "s054"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6045,
          "end": 6050,
          "span_id": "s054"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6071,
          "end": 6076,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 6095,
      "end": 6246,
      "text": " قال ابن عباس: إن الله جعل في هذه الأُمة أمانين لا يزالون معصومين مجارين من قوارع العذاب ما داما بين أظهرهم، فأمان قبضه الله إليه وأمان بقي فيكم، قوله:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6100,
          "end": 6108,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 6246,
      "end": 6364,
      "text": " {وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ (33)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6247,
          "end": 6363,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 6364,
      "end": 6391,
      "text": "\r\nوقال أبو صالح عبد الغفار:",
      "markers": []
    },
    {
      "id": "s058",
      "start": 6391,
      "end": 6466,
      "text": " حدثني بعض أصحابنا أن النضر بن عدي حدثه هذا الحديث،  عن مجاهد، عن ابن عباس ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6444,
          "end": 6465,
          "stripped": "عن مجاهد، عن ابن عباس",
          "span_id": "s058"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 6447,
          "end": 6452,
          "span_id": "s058"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6457,
          "end": 6465,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 6510,
      "end": 6562,
      "text": ". وروى ابن مردويه، عن أبي موسى الأشعري نحوًا من هذا ",
      "markers": []
    },
    {
      "id": "s060",
      "start": 6790,
      "end": 6836,
      "text": ". وكذا روي عن قتادة وأبي العلاء النحوي المقرى ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 6804,
          "end": 6809,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 6973,
      "end": 7115,
      "text": ".\r\nوقال الترمذي: حدثنا سفيان بن وكيع، حدثنا ابن نمير، عن إسماعيل بن إبراهيم بن مهاجر، عن عبَّاد بن يوسف، عن أبي بردة بن أبي موسى، عن أبيه قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6990,
          "end": 6995,
          "span_id": "s061"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 6990,
          "end": 7029,
          "stripped": "حدثنا سفيان بن وكيع، حدثنا ابن نمير، عن",
          "span_id": "s061"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7011,
          "end": 7016,
          "span_id": "s061"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7059,
          "end": 7096,
          "stripped": "عن عباد بن يوسف، عن أبي بردة بن أبي",
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 7115,
      "end": 7153,
      "text": " قال رسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 7116,
          "end": 7129,
          "span_id": "s062"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7132,
          "end": 7150,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 7153,
      "end": 7349,
      "text": " \"أنزل الله عليَّ أمانين لأُمتي {وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ (33)} فإذا مضيت تركت فيهم الاستغفار إلى يوم القيامة\" ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7185,
          "end": 7301,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 7386,
      "end": 7570,
      "text": "، ويشهد لهذا ما رواه الإمام أحمد في مسنده والحاكم في مستدركه من حديث عبد الله بن وهب أخبرني عمرو بن الحارث، عن دراج، عن أبي الهيثم، عن أبي سعيد أن رسول الله - صلى الله عليه وسلم - قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 7402,
          "end": 7406,
          "span_id": "s064"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7494,
          "end": 7537,
          "stripped": "عن دراج، عن أبي الهيثم، عن أبي سعيد أن رسول",
          "span_id": "s064"
        },
        {
          "family": "HADITH",
          "marker": "أن رسول الله",
          "start": 7530,
          "end": 7542,
          "span_id": "s064"
        },
        {
          "family": "HADITH",
          "marker": "رسول الله",
          "role": "SPEAKER",
          "start": 7533,
          "end": 7542,
          "span_id": "s064"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7545,
          "end": 7563,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 7570,
      "end": 7648,
      "text": " \"إن الشيطان قال: وعزتك يا ربِّ لا أبرح أغوي عبادك ما دامت أرواحهم في أجسادهم.",
      "markers": []
    },
    {
      "id": "s066",
      "start": 7648,
      "end": 7706,
      "text": " فقال الربُّ: وعزتي وجلالي لا أزال أغفر لهم ما استغفروني\".",
      "markers": []
    },
    {
      "id": "s067",
      "start": 7706,
      "end": 7746,
      "text": " ثم قال الحاكم: صحيح الإسناد ولم يخرجاه ",
      "markers": []
    },
    {
      "id": "s068",
      "start": 7877,
      "end": 7937,
      "text": ".\r\nوقال الإمام أحمد: حدثنا معاوية بن عمرو، حدثنا رشدين - هو:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7898,
          "end": 7903,
          "span_id": "s068"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 7898,
          "end": 7937,
          "stripped": "حدثنا معاوية بن عمرو، حدثنا رشدين - هو:",
          "span_id": "s068"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7920,
          "end": 7925,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 7937,
      "end": 8048,
      "text": " ابن سعد -، حدثني معاوية بن سعيد التُجيبي، عمن حدثه، عن فضالة بن عبيد، عن النبي - صلى الله عليه وسلم - أنه قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7990,
          "end": 8027,
          "stripped": "عن فضالة بن عبيد، عن النبي - صلى الله",
          "span_id": "s069"
        },
        {
          "family": "HADITH",
          "marker": "النبي",
          "role": "SPEAKER",
          "start": 8011,
          "end": 8016,
          "span_id": "s069"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 8019,
          "end": 8037,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 8048,
      "end": 8100,
      "text": " \"العبد آمن من عذاب الله ما استغفر الله - عز وجل -\" ",
      "markers": []
    },
    {
      "id": "s071",
      "start": 8257,
      "end": 8258,
      "text": ".",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s012",
      "start": 1632,
      "end": 1921,
      "text": "¬صحيح البخاري، التفسير، سورة الأنفال، باب قوله: {وَإِذْ قَالُوا اللَّهُمَّ إِنْ كَانَ هَذَا هُوَ الْحَقَّ مِنْ عِنْدِكَ} [الأنفال: 32] (ح 4648)، وقد ثبت أيضًا أنها نزلت في النضر بن الحارث كما سيأتي قال الحافظ ابن حجر: ولا ينافي ذلك ما في الصحيح لاحتمال أن يكونا قالاه (فتح الباري 8/ 309).¥",
      "grading": [
        "صحيح"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s018",
      "start": 2384,
      "end": 2737,
      "text": "¬في سنده إبهام شيخ الأعمش، وقد صرح باسمه النسائي فأخرجه من طريق الأعمش عن المنهال بن عمرو عن سعيد بن جبير عن ابن عباس بدون ذكر آية الأنفال (السنن الكبرى، التفسير، باب سورة المعارج ح 11620)، وفي سنده المنهال بن عمرو وهو صدوق ربما وهم (التقريب ص 547). ويتقوى بالآثار التالية، فسنده حسن. وأخرجه الحاكم من طريق الأعمش وصححه ووافقه الذهبي (المستدرك 2/ 502).¥",
      "grading": [
        "حسن",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s019",
      "start": 2801,
      "end": 3055,
      "text": "¬قول مجاهد أخرجه الطبري بسند صحيح من طريق ابن أبي نجيح عنه أنه قول النضر بن الحارث والطبري بسند صحيح من طريق أبي بشر عن سعيد بن جبير، وأخرجه الطبري بسند حسن من طريق أسباط عن السدي بنحو قول ابن عباس، وهذه المراسيل يقوي بعضها بعضًا، أما قول عطاء فكما يلي.¥",
      "grading": [
        "صحيح",
        "حسن"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s024",
      "start": 3385,
      "end": 3481,
      "text": "¬أخرجه الطبري بسند ضعيف جدًا من طريق طلحة بن عمرو عن عطاء، وطلحة بن عمرو متروك (التقريب ص 283).¥",
      "grading": [
        "ضعيف"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s027",
      "start": 3730,
      "end": 3788,
      "text": "¬في سنده إبهام ابن بريدة لأن بعض أبنائه لم يسمع من بريدة.¥",
      "grading": [
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s030",
      "start": 3979,
      "end": 4045,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق سعيد بن أبي عروبة عن قتادة.¥",
      "grading": [
        "صحيح"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s038",
      "start": 4706,
      "end": 4821,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده صحيح أخرجه مسلم من طريق عكرمة به (الصحيح، الحج باب التلبية وصفتها (ح 1185).¥",
      "grading": [
        "صحيح",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s042",
      "start": 5212,
      "end": 5264,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده ضعيف بسبب الإرسال.¥",
      "grading": [
        "ضعيف",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s049",
      "start": 5608,
      "end": 5655,
      "text": "¬أخرجه الطبري بسند ثابت من طريق علي به مقطعًا.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s050",
      "start": 5720,
      "end": 5776,
      "text": "¬هذه الأقوال أخرجها الطبري وابن أبي حاتم بأسانيد ثابتة.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s052",
      "start": 5893,
      "end": 6012,
      "text": "¬قول الضحاك أخرجه ابن أبي حاتم بسند حسن من طريق سلمة بن نبيط عنه. وقول أبي مالك أخرجه الطبري بأسانيد يقوي بعضها بعضًا.¥",
      "grading": [
        "حسن"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s058",
      "start": 6466,
      "end": 6510,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده حسن.¥",
      "grading": [
        "حسن",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s059",
      "start": 6562,
      "end": 6790,
      "text": "¬أخرجه الترمذي من طريق إسماعيل بن إبراهيم بن مهاجر عن عباد بن يوسف عن أبي بردة عن أبي موسى الأشعري مرفوعًا، (السنن، التفسير، باب ومن سورة الأنفال ح 3082) وسنده ضعيف لضعف إسماعيل بن إبراهيم، ويشهد له سابقه وما تقدم في صحيح مسلم.¥",
      "grading": [
        "صحيح",
        "ضعيف",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s060",
      "start": 6836,
      "end": 6973,
      "text": "¬قول قتادة أخرجه الطبري بسند صحيح من طريق ابن أبي عروبة عنه، وقول أبي العلاء أخرجه الطبري من طريق عامر أبي الخطاب الثوري ويتقوى بما سبق.¥",
      "grading": [
        "صحيح"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s063",
      "start": 7349,
      "end": 7386,
      "text": "¬تقدم تخريجه في الرواية قبل السابقة.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s067",
      "start": 7746,
      "end": 7877,
      "text": "¬المسند 3/ 29 والمستدرك 4/ 261، وسنده ضعيف لأن رواية دراج عن أبي الهيثم ضعيفة، ولكن يشهد له ما تقدم في صحيح مسلم من حديث ابن عباس.¥",
      "grading": [
        "صحيح",
        "ضعيف",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s070",
      "start": 8100,
      "end": 8257,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 6/ 20) وسنده ضعيف لضعف رشدين بن سعد، وإبهام شيخ معاوية بن سعيد، ويشهد له ما تقدم من حديث ابن عباس في صحيح مسلم وغيره.¥",
      "grading": [
        "صحيح",
        "ضعيف",
        "سنده"
      ]
    }
  ]
}
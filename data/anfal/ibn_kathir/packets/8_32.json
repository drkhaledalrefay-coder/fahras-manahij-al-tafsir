    },
    {
      "id": "s010",
      "start": 1261,
      "end": 1285,
      "text": " هو أبو جهل بن هشام قال:",
      "markers": []
    },
    {
      "id": "s011",
      "start": 1285,
      "end": 1429,
      "text": " {اللَّهُمَّ إِنْ كَانَ هَذَا هُوَ الْحَقَّ مِنْ عِنْدِكَ فَأَمْطِرْ عَلَيْنَا حِجَارَةً مِنَ السَّمَاءِ أَوِ ائْتِنَا بِعَذَابٍ أَلِيمٍ} فنزلت:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",

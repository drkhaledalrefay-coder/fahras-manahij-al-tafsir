          "end": 255,
          "span_id": "s002"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 256,
          "end": 259,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 259,
      "end": 439,
      "text": " تستنصروا وتستقضوا الله وتستحكموه أن يفصل بينكم وبين أعدائكم المؤمنين فقد جاءكم ما سألتم كما قال محمد بن إسحاق وغيره عن الزهري، عن عبد الله بن ثعلبة بن صعير أن أبا جهل قال يوم بدر:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 376,
          "end": 407,
          "stripped": "عن الزهري، عن عبد الله بن ثعلبة",
          "span_id": "s003"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 431,
          "end": 438,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 439,
      "end": 502,
      "text": " اللّهم أينا كان أقطع للرحم وآتانا بما لا يعرف فأحِنْهُ الغداة.",
      "markers": []
    },
    {
      "id": "s005",
      "start": 502,
      "end": 532,
      "text": " وكان ذلك استفتاحًا منه فنزلت:",

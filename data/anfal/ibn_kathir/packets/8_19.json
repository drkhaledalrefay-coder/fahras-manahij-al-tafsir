        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 526,
          "end": 531,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 532,
      "end": 596,
      "text": " {إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ} إلى آخر الآية ",

        }
      ]
    },
    {
      "id": "s002",
      "start": 213,
      "end": 259,
      "text": "\r\nيقول تعالى للكفار: {إِنْ تَسْتَفْتِحُوا} أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",

        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1203,
          "end": 1222,
          "span_id": "s013"
        }
      ]
    },
    {
      "id": "s014",
      "start": 1288,
      "end": 1327,
      "text": ".\r\nوقال قتادة: {لِمَا يُحْيِيكُمْ} قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 1296,
          "end": 1301,
          "span_id": "s014"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1303,
          "end": 1322,
          "span_id": "s014"
        }
      ]
    },
    {
      "id": "s015",
      "start": 1327,
      "end": 1369,
      "text": " هو هذا القرآن فيه النجاة والبقاء والحياة ",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1437,
      "end": 1509,
      "text": ".\r\nوقال السدي: {لِمَا يُحْيِيكُمْ} ففي الإسلام إحياؤهم بعد موتهم بالكفر ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 1445,
          "end": 1450,
          "span_id": "s016"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1452,
          "end": 1471,
          "span_id": "s016"
        }
      ]
    },
    {
      "id": "s017",
      "start": 1562,
      "end": 1630,
      "text": ".\r\nوقال محمد بن إسحاق، عن محمد بن جعفر بن الزبير، عن عروة بن الزبير:",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1630,
      "end": 1735,
      "text": " {يَاأَيُّهَا الَّذِينَ آمَنُوا اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ} أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1631,
          "end": 1731,
          "span_id": "s018"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 1732,
          "end": 1735,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 1735,
      "end": 1835,
      "text": " للحرب التي أعزكم الله تعالى بها بعد الذل، وقواكم بها بعد الضعف، ومنعكم من عدوكم بعد القهر منهم لكم ",
      "markers": []
    },
    {
      "id": "s020",
      "start": 1886,
      "end": 1980,
      "text": ".\r\nوقوله تعالى: {وَاعْلَمُوا أَنَّ اللَّهَ يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ}، قال ابن عباس:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "وقوله تعالى",
          "start": 1889,
          "end": 1900,
          "span_id": "s020"
        },
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 1890,

    {
      "id": "s025",
      "start": 2490,
      "end": 2566,
      "text": ".\r\nوقال السدي: يحول بين الإنسان وقلبه فلا يستطيع أن يؤمن ولا يكفر إلا بإذنه ",
      "markers": [
        {

          "role": "SPEAKER",
          "start": 2203,
          "end": 2208,
          "span_id": "s022"
        }
      ]
    },
    {
      "id": "s023",
      "start": 2344,
      "end": 2374,
      "text": ".\r\nوفي رواية عن مجاهد في قوله:",
      "markers": [

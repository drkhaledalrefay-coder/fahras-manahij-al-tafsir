          "end": 2626,
          "span_id": "s026"
        },
        {
          "family": "LUGHA",
          "marker": "كقول",
          "start": 2631,
          "end": 2635,
          "span_id": "s026"
        },
        {
          "family": "LUGHA",
          "marker": "كقوله",
          "start": 2631,
          "end": 2636,
          "span_id": "s026"
        }
      ]
    },
    {
      "id": "s027",
      "start": 2637,
      "end": 2690,
      "text": " {وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنْ حَبْلِ الْوَرِيدِ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2638,
          "end": 2689,
          "span_id": "s027"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 2690,
          "end": 2697,
          "text": "[ق: 16]",
          "via": "apparatus",
          "span_id": "s027"
        }
      ]
    },
    {
      "id": "s028",
      "start": 2697,
      "end": 2698,
      "text": " ",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2745,
      "end": 2840,
      "text": ".\r\nوقد وردت الأحاديث عن رسول الله - صلى الله عليه وسلم - بما يناسب هذه الآية، وقال الإمام أحمد:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2781,
          "end": 2799,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 2840,
      "end": 2921,
      "text": " حدثنا أبو معاوية، عن الأعمش، عن أبي سفيان، عن أنس بن مالك - رضي الله عنه -، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2841,
          "end": 2846,
          "span_id": "s030"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2859,
          "end": 2900,
          "stripped": "عن الأعمش، عن أبي سفيان، عن أنس بن مالك -",
          "span_id": "s030"
        },
        {
          "family": "SAHABA",
          "marker": "أنس",
          "name": "أنس",
          "role": "NARRATOR",
          "start": 2887,
          "end": 2890,
          "span_id": "s030"
        }
      ]
    },
    {
      "id": "s031",
      "start": 2921,
      "end": 2968,
      "text": " كان النبي - صلى الله عليه وسلم - يكثر أن يقول:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "ان النبي",
          "start": 2923,
          "end": 2931,
          "span_id": "s031"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2934,
          "end": 2952,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2968,
      "end": 3004,
      "text": " \"يا مقلب القلوب ثبت قلبي على دينك\".",
      "markers": []
    },
    {
      "id": "s033",
      "start": 3004,
      "end": 3066,
      "text": " قال: فقلنا: يا رسول الله آمنا بك وبما جئت به، فهل تخاف علينا؟",
      "markers": []
    },
    {
      "id": "s034",
      "start": 3066,
      "end": 3127,
      "text": " قال: \"نعم، إن القلوب بين إصبعين من أصابع الله تعالى يقلبها\" ",
      "markers": []
    },
    {
      "id": "s035",
      "start": 3221,
      "end": 3401,
      "text": ".\r\nوهكذا رواه الترمذي في كتاب القدر من جامعه عن هناد بن السري، عن أبي معاوية محمد بن خازم الضرير، عن الأعمش، واسمه سليمان بن مهران، عن أبي سفيان واسمه طلحة بن نافع، عن أنس، ثم قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 3230,
          "end": 3234,
          "span_id": "s035"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3266,
          "end": 3305,
          "stripped": "عن هناد بن السري، عن أبي معاوية محمد بن",
          "span_id": "s035"
        },
        {
          "family": "SAHABA",
          "marker": "أنس",
          "name": "أنس",
          "role": "NARRATOR",
          "start": 3389,
          "end": 3392,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 3401,
      "end": 3540,
      "text": " حسن، وهكذا روي، عن غير واحد عن الأعمش، ورواه بعضهم عنه، عن أبي سفيان، عن جابر، عن النبي - صلى الله عليه وسلم - وحديث أبي سفيان عن أنس أصح ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3418,
          "end": 3500,
          "stripped": "عن غير واحد عن الأعمش، ورواه بعضهم عنه، عن أبي سفيان، عن جابر، عن النبي - صلى الله",
          "span_id": "s036"
        },
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 3442,
          "end": 3446,
          "span_id": "s036"
        },
        {
          "family": "SAHABA",
          "marker": "جابر",
          "name": "جابر",
          "role": "NARRATOR",
          "start": 3475,
          "end": 3479,
          "span_id": "s036"
        },
        {
          "family": "HADITH",
          "marker": "النبي",
          "role": "SPEAKER",
          "start": 3484,
          "end": 3489,
          "span_id": "s036"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3492,
          "end": 3510,
          "span_id": "s036"
        },
        {
          "family": "SAHABA",
          "marker": "أنس",
          "name": "أنس",
          "role": "NARRATOR",
          "start": 3532,
          "end": 3535,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 3722,
      "end": 3770,
      "text": ".\r\n(حديث آخر): وقال الإمام عبد بن حميد في مسنده ",
      "markers": []
    },
    {
      "id": "s038",
      "start": 3850,
      "end": 3983,
      "text": ": حدثنا عبد الملك بن عمرو، حدثنا شعبة، عن الحكم، عن ابن أبي ليلى، عن بلال - رضي الله عنه -، أن النبي - صلى الله عليه وسلم - كان يدعو:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3852,
          "end": 3857,
          "span_id": "s038"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3877,
          "end": 3882,
          "span_id": "s038"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3889,
          "end": 3918,
          "stripped": "عن الحكم، عن ابن أبي ليلى، عن",
          "span_id": "s038"
        },
        {
          "family": "HADITH",
          "marker": "أن النبي",
          "start": 3942,
          "end": 3950,
          "span_id": "s038"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3953,
          "end": 3971,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 3983,
      "end": 4019,
      "text": " \"يا مقلب القلوب ثبت قلبي على دينك\" ",
      "markers": []
    },
    {
      "id": "s040",
      "start": 4195,
      "end": 4238,
      "text": ". هذا حديث جيد الإسناد إلا أن فيه انقطاعًا.",
      "markers": []
    },
    {
      "id": "s041",
      "start": 4238,
      "end": 4279,
      "text": " وهو مع ذلك على شرط أهل السنن ولم يخرجوه.",
      "markers": []
    },
    {
      "id": "s042",
      "start": 4279,
      "end": 4309,
      "text": "\r\n(حديث آخر): قال الإمام أحمد:",
      "markers": []
    },
    {
      "id": "s043",
      "start": 4309,
      "end": 4335,
      "text": " حدثنا الوليد بن مسلم قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4310,
          "end": 4315,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 4335,
      "end": 4419,
      "text": " سمعت ابن جابر يقول: حدثني بسر بن عبيد الله الحضرمي أنه سمع أبا إدريس الخولاني يقول:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "جابر",
          "name": "جابر",
          "role": "SPEAKER",
          "start": 4345,
          "end": 4349,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 4419,
      "end": 4471,
      "text": " سمعت النواس بن سمعان الكلابي - رضي الله عنه - يقول:",
      "markers": []
    },
    {
      "id": "s046",
      "start": 4471,
      "end": 4511,
      "text": " سمعت النبي - صلى الله عليه وسلم - يقول:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4485,
          "end": 4503,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 4511,
      "end": 4631,
      "text": " \"ما من قلب إلا وهو بين أصبعين من أصابع الرحمن ربِّ العالمين إذا شاء أن يقيمه أقامه وإذا شاء أن يُزيغه أزاغه\" وكان يقول:",
      "markers": []
    },
    {
      "id": "s048",
      "start": 4631,
      "end": 4673,
      "text": " \"يا مقلب القلوب ثبِّت قلبي على دينك\" قال:",
      "markers": []
    },
    {
      "id": "s049",
      "start": 4673,
      "end": 4709,
      "text": " \"والميزان بيد الرحمن يخفضه ويرفعه\" ",
      "markers": []
    },
    {
      "id": "s050",
      "start": 4783,
      "end": 4858,
      "text": " وهكذا رواه النسائي وابن ماجه من حديث عبد الرحمن بن يزيد بن جابر فذكر مثله ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 4790,
          "end": 4794,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 4937,
      "end": 4968,
      "text": ".\r\n(حديث آخر): قال الإمام أحمد:",
      "markers": []
    },
    {
      "id": "s052",
      "start": 4968,
      "end": 5042,
      "text": " حدثنا يونس، حدثنا حماد بن زيد، عن المعلى بن زياد، عن الحسن أن عائشة قالت:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4969,
          "end": 4974,
          "span_id": "s052"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 4969,
          "end": 4999,
          "stripped": "حدثنا يونس، حدثنا حماد بن زيد،",
          "span_id": "s052"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4981,
          "end": 4986,
          "span_id": "s052"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5000,
          "end": 5042,
          "stripped": "عن المعلى بن زياد، عن الحسن أن عائشة قالت:",
          "span_id": "s052"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "NARRATOR",
          "start": 5022,
          "end": 5027,
          "span_id": "s052"
        },
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 5031,
          "end": 5036,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 5042,
      "end": 5095,
      "text": " دعوات كان رسول الله - صلى الله عليه وسلم - يدعو بها:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "ان رسول الله",
          "start": 5050,
          "end": 5062,
          "span_id": "s053"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5065,
          "end": 5083,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 5095,
      "end": 5138,
      "text": " \"يا مقلب القلوب ثبِّت قلبي على دينك\" قالت:",
      "markers": []
    },
    {
      "id": "s055",
      "start": 5138,
      "end": 5192,
      "text": " فقلت: يا رسول الله إنك تكثر أن تدعو بهذا الدعاء فقال:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 5140,
          "end": 5143,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 5192,
      "end": 5264,
      "text": " \"إن قلب الآدمي بين أصبعين من أصابع الله فإذا شاء أزاغه وإذا شاء أقامه\" ",
      "markers": []
    },
    {
      "id": "s057",
      "start": 5347,
      "end": 5378,
      "text": ".\r\n(حديث آخر): قال الإمام أحمد:",
      "markers": []
    },
    {
      "id": "s058",
      "start": 5378,
      "end": 5496,
      "text": " حدثنا هاشم، حدثنا عبد الحميد، حدثني شهر سمعت أم سلمة تحدث أن رسول الله - صلى الله عليه وسلم - كان يكثر في دعائه يقول:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5379,
          "end": 5384,
          "span_id": "s058"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 5379,
          "end": 5414,
          "stripped": "حدثنا هاشم، حدثنا عبد الحميد، حدثني",
          "span_id": "s058"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5391,
          "end": 5396,
          "span_id": "s058"
        },
        {
          "family": "HADITH",
          "marker": "أن رسول الله",
          "start": 5437,
          "end": 5449,
          "span_id": "s058"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5452,
          "end": 5470,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 5496,
      "end": 5544,
      "text": " \"اللَّهم مقلب القلوب ثبِّت قلبي على دينك\" قالت:",
      "markers": []
    },
    {
      "id": "s060",
      "start": 5544,
      "end": 5588,
      "text": " فقلت: يا رسول الله أوَ إِنّ القلوب لتقلَّب؟",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 5546,
          "end": 5549,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 5588,
      "end": 5805,
      "text": " قال: \"نعم ما خلق الله من بشر من بني آدم إلا أن قلبه بين أصبعين من أصابع الله - عز وجل - فإن شاء أقامه وإن شاء أزاغه، فنسأل الله ربنا أن لا يزيغ قلوبنا بعد إذ هدانا، ونسأله أن يهب لنا من لدنه رحمة إنه هو الوهاب\" قالت:",
      "markers": []
    },
    {
      "id": "s062",
      "start": 5805,
      "end": 5856,
      "text": " فقلت: يا رسول الله ألا تعلمني دعوة أدعو بها لنفسي؟",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 5807,
          "end": 5810,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 5856,
      "end": 5962,
      "text": " قال: \"بلى قولي اللَّهم ربِّ النبي محمد اغفر لي ذنبي، وأذهب غيظ قلبي، وأجرني من مضلَّات الفتن ما أحييتني\" ",
      "markers": []
    },
    {
      "id": "s064",
      "start": 6090,
      "end": 6121,
      "text": ".\r\n(حديث آخر): قال الإمام أحمد:",
      "markers": []
    },
    {
      "id": "s065",
      "start": 6121,
      "end": 6274,
      "text": " حدثنا أبو عبد الرحمن، حدثنا حيوة، أخبرني أبو هانئ أنه سمع أبا عبد الرحمن الحبلي، أنه سمع عبد الله بن عمرو أنه سمع رسول الله - صلى الله عليه وسلم - يقول:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6122,
          "end": 6127,
          "span_id": "s065"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 6122,
          "end": 6166,
          "stripped": "حدثنا أبو عبد الرحمن، حدثنا حيوة، أخبرني أبو",
          "span_id": "s065"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6144,
          "end": 6149,
          "span_id": "s065"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6248,
          "end": 6266,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 6274,
      "end": 6385,
      "text": " \"إن قلوب بني آدم بين أصبعين من أصابع الرحمن كقلب واحد يصرفها كيف شاء\" ثم قال رسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 6348,
          "end": 6361,
          "span_id": "s066"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6364,
          "end": 6382,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 6385,
      "end": 6509,
      "text": " \"اللَّهم مصرف القلوب صرِّف قلوبنا إلى طاعتك\" انفرد بإخراجه مسلم عن البخاري فرواه مع النسائي من حديث حيوة بن شريح المصري به ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 6462,
          "end": 6466,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 6581,
      "end": 6582,
      "text": ".",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s011",
      "start": 930,

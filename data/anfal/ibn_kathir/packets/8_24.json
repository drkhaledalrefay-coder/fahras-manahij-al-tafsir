  "spans": [
    {
      "id": "s001",
      "start": 0,
      "end": 199,
      "text": "{يَاأَيُّهَا الَّذِينَ آمَنُوا اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ وَاعْلَمُوا أَنَّ اللَّهَ يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ وَأَنَّهُ إِلَيْهِ تُحْشَرُونَ (24)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 0,
          "end": 198,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 199,
      "end": 267,
      "text": "\r\nقال البخاري: {اسْتَجِيبُوا} أجيبوا {لِمَا يُحْيِيكُمْ} لما يصلحكم.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 214,
          "end": 228,
          "span_id": "s002"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 236,
          "end": 255,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 267,
      "end": 332,
      "text": " حدثني إسحاق، حدثنا رَوح، حدثنا شعبة، عن خُبيب بن عبد الرحمن قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 281,
          "end": 286,
          "span_id": "s003"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 281,
          "end": 313,
          "stripped": "حدثنا روح، حدثنا شعبة، عن خبيب",
          "span_id": "s003"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 293,
          "end": 298,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 332,
      "end": 401,
      "text": " سمعت حفص بن عاصم يحدث، عن أبي سعيد بن المعلَّى - رضي الله عنه - قال:",
      "markers": []
    },
    {
      "id": "s005",
      "start": 401,
      "end": 488,
      "text": " كنت أصلي فمرَّ بي النبي - صلى الله عليه وسلم -، فدعاني فلم آته حتى صليت ثم أتيته فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 428,
          "end": 446,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 488,
      "end": 522,
      "text": " \"ما منعك أن تأتيني؟ ألم يقل الله:",
      "markers": []
    },
    {
      "id": "s007",
      "start": 522,
      "end": 632,
      "text": " {يَاأَيُّهَا الَّذِينَ آمَنُوا اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ}، ثم قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 523,
          "end": 623,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 632,
      "end": 729,
      "text": " لأعلمنَّك أعظم سورة في القرآن قبل أن أخرج\"، فذهب رسول الله - صلى الله عليه وسلم -ليخرج فذكرت له.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 694,
          "end": 712,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 729,
      "end": 858,
      "text": " وقال معاذ: حدثنا شعبة، عن خبيب بن عبد الرحمن سمع حفص بن عاصم سمع أبا سعيد رجلًا من أصحاب النبي - صلى الله عليه وسلم - بهذا وقال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 735,
          "end": 739,
          "span_id": "s009"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 741,
          "end": 746,
          "span_id": "s009"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 827,
          "end": 845,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 858,
      "end": 903,
      "text": " {الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ (2)} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 859,
          "end": 902,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 912,
      "end": 930,
      "text": " هي السبع المثاني ",
      "markers": []
    },
    {
      "id": "s012",
      "start": 1101,
      "end": 1181,
      "text": ". هذا لفظه بحروفه وقد تقدم الكلام على هذا الحديث بذكر طرقه في أول تفسير الفاتحة.",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1181,
      "end": 1233,
      "text": "\r\nوقال مجاهد في قوله: {لِمَا يُحْيِيكُمْ} قال: للحق ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 1188,

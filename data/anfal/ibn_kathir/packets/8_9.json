    {
      "id": "s019",
      "start": 2339,
      "end": 2509,
      "text": " {أَوَلَمَّا أَصَابَتْكُمْ مُصِيبَةٌ قَدْ أَصَبْتُمْ مِثْلَيْهَا قُلْتُمْ أَنَّى هَذَا قُلْ هُوَ مِنْ عِنْدِ أَنْفُسِكُمْ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ (165)} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2340,
          "end": 2508,
          "span_id": "s019"
        },
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 2404,
          "end": 2409,
          "span_id": "s019"
        }
      ]
    },
    {
      "id": "s020",
      "start": 2519,
      "end": 2534,
      "text": " بأخذكم الفداء ",
      "markers": []
    },
    {
      "id": "s021",
      "start": 2611,
      "end": 2728,
      "text": ". ورواه مسلم وأبو داود والترمذي وابن جرير وابن مردويه من طرق عن عكرمة بن عمار به وصححه علي بن المديني والترمذي وقالا:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 2614,
          "end": 2618,
          "span_id": "s021"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 2675,
          "end": 2680,
          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 2728,
      "end": 2771,
      "text": " لا يعرف إلا من حديث عكرمة بن عمار اليمامي ",
      "markers": []
    },
    {
      "id": "s023",
      "start": 2975,
      "end": 3050,
      "text": ".\r\nوهكذا روى علي بن أبي طلحة والعوفي عن ابن عباس أن هذه الآية الكريمة قوله:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 3015,
          "end": 3023,
          "span_id": "s023"
        }
      ]
    },
    {
      "id": "s024",
      "start": 3050,
      "end": 3120,
      "text": " {إِذْ تَسْتَغِيثُونَ رَبَّكُمْ} في دعاء النبي - صلى الله عليه وسلم - ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3051,
          "end": 3082,
          "span_id": "s024"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3099,
          "end": 3117,
          "span_id": "s024"
        }
      ]
    },
    {
      "id": "s025",
      "start": 3183,
      "end": 3195,
      "text": "، وكذا قال: ",
      "markers": []
    },
    {
      "id": "s026",
      "start": 3209,
      "end": 3210,
      "text": " ",
      "markers": []
    },
    {
      "id": "s027",
      "start": 3289,
      "end": 3360,
      "text": " والسدي وابن جريج.\r\nوقال أبو بكر بن عياش، عن أبي حصين، عن أبي صالح قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 3314,
          "end": 3321,
          "span_id": "s027"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3331,
          "end": 3360,
          "stripped": "عن أبي حصين، عن أبي صالح قال:",
          "span_id": "s027"
        }
      ]
    },
    {
      "id": "s028",
      "start": 3360,
      "end": 3483,
      "text": " لما كان يوم بدر جعل النبي - صلى الله عليه وسلم - يناشد ربه أشدَّ المناشدة يدعو، فأتاه عمر بن الخطاب - رضي الله عنه - فقال:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 3369,
          "end": 3376,
          "span_id": "s028"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3389,
          "end": 3407,
          "span_id": "s028"
        }
      ]
    },
    {
      "id": "s029",
      "start": 3483,
      "end": 3540,
      "text": " يا رسول الله بعض نشدتك فوالله ليفيَنَّ الله لك بما وعدك ",
      "markers": []
    },
    {
      "id": "s030",
      "start": 3638,
      "end": 3688,
      "text": ".\r\nقال البخاري في كتاب المغازي باب قول الله تعالى:",
      "markers": []
    },
    {
      "id": "s031",
      "start": 3688,
      "end": 3788,
      "text": " {إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ} إلى قوله: {فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3689,
          "end": 3740,
          "span_id": "s031"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3751,
          "end": 3787,
          "span_id": "s031"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 3788,
          "end": 3801,
          "text": "[البقرة: 211]",
          "via": "apparatus",
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 3801,
      "end": 3864,
      "text": ": حدثنا أبو نعيم، حدثنا إسرائيل، عن مخارق، عن طارق بن شهاب قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3803,
          "end": 3808,
          "span_id": "s032"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 3803,
          "end": 3843,
          "stripped": "حدثنا أبو نعيم، حدثنا إسرائيل، عن مخارق،",
          "span_id": "s032"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3819,
          "end": 3824,
          "span_id": "s032"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3834,
          "end": 3864,
          "stripped": "عن مخارق، عن طارق بن شهاب قال:",
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 3864,
      "end": 4016,
      "text": " سمعت ابن مسعود يقول: شهدت من المقداد بن الأسود مشهدًا لأن أكون صاحبه أحبّ إليَّ مما عدل به، أتى النبي- صلى الله عليه وسلم - وهو يدعو على المشركين فقال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن مسعود",
          "name": "ابن مسعود",
          "role": "SPEAKER",
          "start": 3870,
          "end": 3879,
          "span_id": "s033"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3968,
          "end": 3986,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 4016,
      "end": 4082,
      "text": " لا نقول كما قال قوم موسى {فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4042,
          "end": 4081,
          "span_id": "s034"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 4082,
          "end": 4095,
          "text": "[المائدة: 24]",
          "via": "apparatus",
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 4095,
      "end": 4196,
      "text": " ولكنَّا نقاتل عن يمينك وعن شمالك وبين يديك وخلفك، فرأيت النبي - صلى الله عليه وسلم - أشرق وجهه وسره ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4160,
          "end": 4178,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 4198,
      "end": 4296,
      "text": ".\r\nحدثني محمد بن عبد الله بن حوشب، حدثنا عبد الوهاب، حدثنا خالد الحذاء، عن عكرمة، عن ابن عباس قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4233,
          "end": 4238,
          "span_id": "s036"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 4233,
          "end": 4272,
          "stripped": "حدثنا عبد الوهاب، حدثنا خالد الحذاء، عن",
          "span_id": "s036"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4251,
          "end": 4256,
          "span_id": "s036"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4270,
          "end": 4296,
          "stripped": "عن عكرمة، عن ابن عباس قال:",
          "span_id": "s036"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 4273,
          "end": 4278,
          "span_id": "s036"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4283,
          "end": 4291,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 4296,
      "end": 4338,
      "text": " قال النبي - صلى الله عليه وسلم - يوم بدر:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4309,
          "end": 4327,
          "span_id": "s037"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 4330,
          "end": 4337,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 4338,
      "end": 4408,
      "text": " \"اللهم أنشدك عهدك ووعدك اللهم إن شئت لم تعبد\" فأخذ أبو بكر بيده فقال:",
      "markers": []
    },
    {
      "id": "s039",
      "start": 4408,
      "end": 4481,
      "text": " حسبك. فخرج وهو يقول: {سَيُهْزَمُ الْجَمْعُ وَيُوَلُّونَ الدُّبُرَ (45)} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4430,
          "end": 4480,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 4541,
      "end": 4542,
      "text": " ",
      "markers": []
    },
    {
      "id": "s041",
      "start": 4549,
      "end": 4610,
      "text": " ورواه النسائي عن بندار، عن عبد الوهاب، عن عبد المجيد الثقفي ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 4551,
          "end": 4555,
          "span_id": "s041"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4564,
          "end": 4609,
          "stripped": "عن بندار، عن عبد الوهاب، عن عبد المجيد الثقفي",
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 4644,
      "end": 4706,
      "text": ".\r\nوقوله تعالى: {بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ} أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "وقوله تعالى",
          "start": 4647,
          "end": 4658,
          "span_id": "s042"
        },
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 4648,
          "end": 4658,
          "span_id": "s042"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4660,
          "end": 4702,
          "span_id": "s042"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 4703,
          "end": 4706,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 4706,
      "end": 4732,
      "text": " يردف بعضهم بعضًا كما قال ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 4748,
      "end": 4749,
      "text": " ",
      "markers": []
    },
    {
      "id": "s045",
      "start": 4827,
      "end": 4864,
      "text": "، عن ابن عباس {مُرْدِفِينَ} متتابعين ",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4832,
          "end": 4840,
          "span_id": "s045"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4841,
          "end": 4854,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 4977,
      "end": 5015,
      "text": ".\r\nويحتمل أن المراد {مُرْدِفِينَ} لكم:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4997,
          "end": 5010,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 5015,
      "end": 5055,
      "text": " أي نجدة لكم كما قال العوفي عن ابن عباس:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5046,
          "end": 5054,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 5055,
      "end": 5091,
      "text": " {مُرْدِفِينَ} يقول المدد، كما تقول:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5056,
          "end": 5069,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 5091,
      "end": 5116,
      "text": " ائت الرجل فزده كذا وكذا ",
      "markers": []
    },
    {
      "id": "s050",
      "start": 5159,
      "end": 5225,
      "text": ".\r\nوهكذا قال مجاهد وابن كثير القاري وابن زيد: {مُرْدِفِينَ} ممدين ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 5172,
          "end": 5177,
          "span_id": "s050"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5205,
          "end": 5218,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 5270,
      "end": 5396,
      "text": ".\r\nوقال أبو كدينة، عن قابوس، عن أبيه، عن ابن عباس {مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ} قال: وراء كل ملك ملك ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5289,
          "end": 5340,
          "stripped": "عن قابوس، عن أبيه، عن ابن عباس {ممدكم بألف",
          "span_id": "s051"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5311,
          "end": 5319,
          "span_id": "s051"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5320,
          "end": 5374,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 5458,
      "end": 5501,
      "text": ". وفي رواية بهذا الإسناد {مُرْدِفِينَ} قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5483,
          "end": 5496,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 5501,
      "end": 5540,
      "text": " بعضهم على إثر بعض، وكذا قال أبو ظبيان ",
      "markers": []
    },
    {
      "id": "s054",
      "start": 5595,
      "end": 5612,
      "text": " والضحّاك وقتادة ",
      "markers": []
    },
    {
      "id": "s055",
      "start": 5731,
      "end": 5900,
      "text": ".\r\nوقال ابن جرير: حدثني المثنى، حدثنا إسحاق، حدثنا يعقوب بن محمد الزهري، حدثني عبد العزيز بن عمران، عن الزمعي، عن أبي الحويرث، عن محمد جبير، عن علي - رضي الله عنه - قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5763,
          "end": 5768,
          "span_id": "s055"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 5763,
          "end": 5795,
          "stripped": "حدثنا إسحاق، حدثنا يعقوب بن محمد",
          "span_id": "s055"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5776,
          "end": 5781,
          "span_id": "s055"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5831,
          "end": 5878,
          "stripped": "عن الزمعي، عن أبي الحويرث، عن محمد جبير، عن علي",
          "span_id": "s055"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 5875,
          "end": 5878,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 5900,
      "end": 6064,
      "text": " نزل جبريل في ألف من الملائكة عن ميمنة النبي - صلى الله عليه وسلم - وفيها أبو بكر، ونزل ميكائيل في ألف من الملائكة عن ميسرة النبي - صلى الله عليه وسلم - في الميسرة ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5947,
          "end": 5965,
          "span_id": "s056"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6032,
          "end": 6050,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 6155,
      "end": 6245,
      "text": ". وهذا يقتضي إن صح إسناده أن الألف مردفة بمثلها ولهذا قرأ بعضهم: {مُرْدِفِينَ} بفتح الدال ",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 6209,
          "end": 6212,
          "span_id": "s057"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6220,
          "end": 6233,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 6291,
      "end": 6356,
      "text": "، والله أعلم.\r\nوالمشهور ما رواه علي بن أبي طلحة، عن ابن عباس قال:",
      "markers": [
        {
          "family": "RAY",
          "marker": "والله أعلم",
          "start": 6293,
          "end": 6303,
          "span_id": "s058"
        },
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 6318,
          "end": 6322,
          "span_id": "s058"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6343,
          "end": 6351,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 6356,
      "end": 6465,
      "text": " وأمدَّ الله نبيه - صلى الله عليه وسلم - والمؤمنين بألف من الملائكة، فكان جبريل في خمسمائة من الملائكة مجنبة ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6376,
          "end": 6394,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 6512,
      "end": 6540,
      "text": "، وميكائيل في خمسمائة مجنبة ",
      "markers": []
    },
    {
      "id": "s061",
      "start": 6589,
      "end": 6736,
      "text": ".\r\nوروى الإمام أبو جعفر بن جرير ومسلم من حديث عكرمة بن عمار، عن أبي زُميل سماك بن وليد الحنفي، عن ابن عباس، عن عمر الحديث المتقدم، ثم قال أبو زميل:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6684,
          "end": 6722,
          "stripped": "عن ابن عباس، عن عمر الحديث المتقدم، ثم",
          "span_id": "s061"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 6687,
          "end": 6695,
          "span_id": "s061"
        },
        {
          "family": "SAHABA",
          "marker": "عمر",
          "name": "عمر",
          "role": "NARRATOR",
          "start": 6700,
          "end": 6703,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 6736,
      "end": 6855,
      "text": " حدثني ابن عباس قال: بينا رجل من المسلمين يشتدُّ في أثر رجل من المشركين أمامه إذ سمع ضربة بالسوط فوقه وصوت الفارس يقول:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6743,
          "end": 6751,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 6855,
      "end": 6907,
      "text": " أقدم حيزوم، إذ نظر إلى المشرك أمامه فخرَّ مستلقيًا.",
      "markers": []
    },
    {
      "id": "s064",
      "start": 6907,
      "end": 7040,
      "text": " قال: فنظر إليه، فإذا هو قد حطِّم وشق وجهه كضربة السوط فاخضرَّ ذلك أجمع، فجاء الأنصاري فحدث ذلك رسول الله - صلى الله عليه وسلم - قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7015,
          "end": 7033,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 7040,
      "end": 7105,
      "text": " صدقت ذلك من مدد السماء الثالثة فقتلوا يومئذٍ سبعين وأسروا سبعين ",
      "markers": []
    },
    {
      "id": "s066",
      "start": 7148,
      "end": 7189,
      "text": ".\r\nوقال البخاري: باب شهود الملائكة بدرًا.",
      "markers": []
    },
    {
      "id": "s067",
      "start": 7189,
      "end": 7313,
      "text": " حدثنا إسحاق بن إبراهيم، حدثنا جرير، عن يحيى بن سعيد، عن معاذ بن رفاعة بن رافع الزرقي، عن أبيه - وكان أبوه من أهل بدر - قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7190,
          "end": 7195,
          "span_id": "s067"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 7190,
          "end": 7233,
          "stripped": "حدثنا إسحاق بن إبراهيم، حدثنا جرير، عن يحيى",
          "span_id": "s067"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7214,
          "end": 7219,
          "span_id": "s067"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7226,
          "end": 7262,
          "stripped": "عن يحيى بن سعيد، عن معاذ بن رفاعة بن",
          "span_id": "s067"
        },
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "NARRATOR",
          "start": 7246,
          "end": 7250,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 7313,
      "end": 7362,
      "text": " جاء جبريل إلى النبي - صلى الله عليه وسلم - فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7336,
          "end": 7354,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 7362,
      "end": 7385,
      "text": " ما تعدون أهل بدر فيكم؟",
      "markers": []
    },
    {
      "id": "s070",
      "start": 7385,
      "end": 7428,
      "text": " قال: \"من أفضل المسلمين\" أو كلمة نحوها قال:",
      "markers": []
    },
    {
      "id": "s071",
      "start": 7428,
      "end": 7460,
      "text": " وكذلك من شهد بدرًا من الملائكة ",
      "markers": []
    },
    {
      "id": "s072",
      "start": 7538,
      "end": 7618,
      "text": ". انفرد بإخراجه البخاري وقد رواه الطبراني في المعجم الكبير من حديث رافع بن خديج ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 7566,
          "end": 7570,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 7648,
      "end": 7692,
      "text": " وهو خطأ، والصواب رواية البخاري، والله أعلم.",
      "markers": [
        {
          "family": "RAY",
          "marker": "والله أعلم",
          "start": 7681,
          "end": 7691,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 7692,
      "end": 7788,
      "text": "\r\nوفي الصحيحين أن رسول الله - صلى الله عليه وسلم - قال لعمر لمّا شاوره في قتل حاطب بن أبي بلتعة:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "في الصحيح",
          "start": 7695,
          "end": 7704,
          "span_id": "s074"
        },
        {
          "family": "HADITH",
          "marker": "أن رسول الله",
          "start": 7707,
          "end": 7719,
          "span_id": "s074"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7722,
          "end": 7740,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 7788,
      "end": 7853,
      "text": " \"إنه قد شهد بدرًا وما يدريك لعلَّ الله قد اطلع على أهل بدر فقال:",
      "markers": []
    },
    {
      "id": "s076",
      "start": 7853,
      "end": 7883,
      "text": " اعملوا ما شئتم فقد غفرت لكم\" ",
      "markers": []
    },
    {
      "id": "s077",
      "start": 7985,
      "end": 7986,
      "text": ".",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s020",
      "start": 2534,
      "end": 2611,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 1/ 345 - 346 ح 221) وحسن سنده محققوه.¥",
      "grading": [
        "حسن",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s022",
      "start": 2771,
      "end": 2975,
      "text": "¬صحيح مسلم، الجهاد، باب كيفية قسمة الغنيمة بين الحاضرين (ح 1763) وسنن أبي داود، الجهاد، باب في فداء الأسير بالمال (ح 2690) مختصرًا وسنن الترمذي، تفسير القرآن، باب ومن سورة الأنفال (ح 3081) وتفسير الطبري.¥",
      "grading": [
        "صحيح"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s024",
      "start": 3120,
      "end": 3183,
      "text": "¬أخرجه الطبري من الطريقين مختصرًا، وطريق علي يقوي طريق العوفي.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s026",
      "start": 3210,
      "end": 3289,
      "text": "¬كذا في (عم) و (حم) و (مح) وتفسير الطبري، وفي الأصل صُحفت إلى: \"يزيد بن تبيع\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s029",
      "start": 3540,
      "end": 3638,
      "text": "¬أخرجه الطبري بأسانيده عن السدي وابن جريج وزيد بن يثيع وأبي صالح، وهذه الأسانيد يقوي بعضها بعضًا.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s035",
      "start": 4196,
      "end": 4198,
      "text": "¬¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s039",
      "start": 4481,
      "end": 4541,
      "text": "¬أخرجهما البخاري بسنديه ومتنيه وكتابه وبابه (ح 3952، 3953).¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s041",
      "start": 4610,
      "end": 4644,
      "text": "¬السنن الكبرى، التفسير (ح 11557).¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s044",
      "start": 4749,
      "end": 4827,
      "text": "¬كذا في (عم) و (حم) وتفسير ابن أبي حاتم، وفي الأصل صحف إلى: \"هارون بن هبيرة\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s045",
      "start": 4864,
      "end": 4977,
      "text": "¬أخرجه ابن أبي حاتم من طريق هارون بن عنترة عن أبيه عن ابن عباس، وسنده حسن، وقد أخرجه الطبري من طرق أخرى كما يلي.¥",
      "grading": [
        "حسن",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s049",
      "start": 5116,
      "end": 5159,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق العوفي به.¥",
      "grading": [
        "ضعيف"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s050",
      "start": 5225,
      "end": 5270,
      "text": "¬أخرجه الطبري بأسانيد عنهم يقوي بعضها بعضًا.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s051",
      "start": 5396,
      "end": 5458,
      "text": "¬أخرجه الطبري بسند حسن من طريق محمد بن الصلت عن أبي كدينة به.¥",
      "grading": [
        "حسن"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s053",
      "start": 5540,
      "end": 5595,
      "text": "¬أخرجه الطبري بسند فيه سفيان بن وكيع، ويشهد له ما سبق.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s054",
      "start": 5612,
      "end": 5731,
      "text": "¬قول الضحاك أخرجه الطبري بسند فيه إبهام شيخ الطبري ويشهد له ما سبق، وقول قتادة أخرجه عبد الرزاق بسند صحيح عن معمر عنه.¥",
      "grading": [
        "صحيح"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s056",
      "start": 6064,
      "end": 6155,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده ضعيف جدًا بسبب عبد العزيز بن عمران متروك (التقريب ص 358).¥",
      "grading": [
        "ضعيف",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s057",
      "start": 6245,
      "end": 6291,
      "text": "¬القراءة متواترة، ولكن الإسناد السابق لم يصح.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s059",
      "start": 6465,
      "end": 6512,
      "text": "¬المجنبة: الكتيبة التي تأخذ إحدى ناحيتي الجيش.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s060",
      "start": 6540,
      "end": 6589,
      "text": "¬أخرجه الطبري بسند ثابت من طريق ابن أبي طلحة به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s065",
      "start": 7105,
      "end": 7148,
      "text": "¬تقدم تخريجه في بداية تفسير هاتين الآيتين.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s071",
      "start": 7460,
      "end": 7538,
      "text": "¬أخرجه البخاري بسنده ومتنه (الصحيح، المغازي، باب شهود الملائكة بدرًا ح 3992).¥",
      "grading": [
        "صحيح",
        "سنده"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s072",
      "start": 7618,
      "end": 7648,
      "text": "¬المعجم الكبير 4/ 277 ح 4412.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s076",
      "start": 7883,
      "end": 7985,
      "text": "¬صحيح البخاري، الجهاد، باب الجاسوس (ح 3007) وصحيح مسلم، فضائل الصحابة، باب من فضائل أهل بدر (ح 2494).¥",
      "grading": [
        "صحيح"
      ]
    }
  ]
}
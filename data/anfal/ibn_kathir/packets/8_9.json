  "spans": [
    {
      "id": "s001",
      "start": 0,
      "end": 116,
      "text": "{إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ (9)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 0,
          "end": 115,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 116,
      "end": 263,
      "text": "\r\nقال الإمام أحمد: حدثنا أبو نوح قُراد، حدثنا عكرمة بن عمار، حدثنا سماك الحنفي أبو زُميل، حدثني ابن عباس، حدثني عمر بن الخطاب - رضي الله عنه - قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 135,
          "end": 140,
          "span_id": "s002"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 135,
          "end": 198,
          "stripped": "حدثنا أبو نوح قراد، حدثنا عكرمة بن عمار، حدثنا سماك الحنفي أبو",
          "span_id": "s002"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 156,
          "end": 161,
          "span_id": "s002"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 162,
          "end": 167,
          "span_id": "s002"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 177,
          "end": 182,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 263,
      "end": 453,
      "text": " لما كان يوم بدر، نظر النبي - صلى الله عليه وسلم - إلى أصحابه وهم ثلاثمائة ونيف، ونظر إلى المشركين فإذا هم ألف وزيادة، فاستقبل النبي - صلى الله عليه وسلم - القبلة وعليه رداؤه وإزاره، ثم قال:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 272,
          "end": 279,
          "span_id": "s003"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 293,
          "end": 311,
          "span_id": "s003"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 398,
          "end": 416,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 453,
      "end": 553,
      "text": " \"اللّهم أنجز لي ما وعدتني، اللّهم إن تهلك هذه العصابة من أهل الإسلام فلا تُعبد في الأرض أبدًا\" قال:",
      "markers": []
    },
    {
      "id": "s005",
      "start": 553,
      "end": 661,
      "text": " فما زال يستغيث ربه ويدعوه حتى سقط رداؤه عن منكبيه، فأتاه أبو بكر فأخذ رداءه فرده ثم التزمه من ورائه ثم قال:",
      "markers": []
    },
    {
      "id": "s006",
      "start": 661,
      "end": 735,
      "text": " يا نبي الله كفاك مناشدتك ربك فإنه سينجز لك ما وعدك فأنزل الله - عز وجل -:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 713,
          "end": 718,
          "span_id": "s006"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 713,
          "end": 723,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 735,
      "end": 1014,
      "text": " {إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ (9)} فلما كان يومئذٍ التقوا، فهزم الله المشركين فقتل منهم سبعون رجلًا وأسر منهم سبعون رجلًا، واستشار رسول الله - صلى الله عليه وسلم - أبا بكر وعمر وعليًا فقال أبو بكر:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 736,
          "end": 851,
          "span_id": "s007"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 960,
          "end": 978,
          "span_id": "s007"
        },
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 1006,
          "end": 1013,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 1014,
      "end": 1207,
      "text": " يا رسول الله هؤلاء بنو العم والعشيرة والإخوان وإني أرى أن تأخذ منهم الفدية فيكون ما أخذناه منهم قوة لنا على الكفار، وعسى أن يهديهم الله فيكونوا لنا عضدًا فقال رسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 1170,
          "end": 1183,
          "span_id": "s008"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1186,
          "end": 1204,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 1207,
      "end": 1230,
      "text": " \"ما ترى يا ابن الخطاب؟",
      "markers": []
    },
    {
      "id": "s010",
      "start": 1230,
      "end": 1465,
      "text": " \" قال: قلت: ما أرى ما رأى أبو بكر ولكني أرى أن تمكنِّي من فلان قريب لعمر فأضرب عنقه، وتمكِّن عليًا من عقيل فيضرب عنقه، وتمكِّن حمزة من فلان أخيه فيضرب عنقه حتى يعلم الله أن ليس في قلوبنا هوادة للمشركين، هؤلاء صناديدهم وأئمتهم وقادتهم.",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 1238,
          "end": 1241,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 1465,
      "end": 1579,
      "text": " فهوي رسول الله - صلى الله عليه وسلم - ما قال أبو بكر ولم يهو ما قلتُ، وأخذ منهم الفداء، فلما كان من الغد قال عمر:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1483,
          "end": 1501,
          "span_id": "s011"
        },
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 1511,
          "end": 1518,
          "span_id": "s011"
        },
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 1530,
          "end": 1533,
          "span_id": "s011"
        },
        {
          "family": "SAHABA",
          "marker": "عمر",
          "name": "عمر",
          "role": "SPEAKER",
          "start": 1575,
          "end": 1578,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 1579,
      "end": 1645,
      "text": " فغدوت إلى النبي - صلى الله عليه وسلم - وأبي بكر وهما يبكيان فقلت:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1598,
          "end": 1616,
          "span_id": "s012"
        },
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 1641,
          "end": 1644,
          "span_id": "s012"
        }
      ]
    },
    {
      "id": "s013",
      "start": 1645,
      "end": 1719,
      "text": " ما يبكيك أنت وصاحبك، فإن وجدت بكاء بكيت، وإن لم أجد بكاء تباكيت لبكائكما.",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1719,
      "end": 1753,
      "text": " قال النبي - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1732,
          "end": 1750,
          "span_id": "s014"
        }
      ]
    },
    {
      "id": "s015",
      "start": 1753,
      "end": 1900,
      "text": " \"للذي عرض عليَّ أصحابك من أخذهم الفداء لقد عرض عليَّ عذابكم أدنى من هذه الشجرة\" لشجرة قريبة من النبي - صلى الله عليه وسلم - وأنزل الله - عز وجل -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1857,
          "end": 1875,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1900,
      "end": 2051,
      "text": " {مَا كَانَ لِنَبِيٍّ أَنْ يَكُونَ لَهُ أَسْرَى حَتَّى يُثْخِنَ فِي الْأَرْضِ} إلى {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1901,
          "end": 1978,
          "span_id": "s016"
        },
        {

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 26265,
      "end": 26288,
      "text": "¬في (ن): \"ما يكون في\".¥",
      "attached_span_id": "s270",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 26406,
      "end": 26440,
      "text": "¬(1/ 53) وقد مضى تخريجه منذ قليل.¥",
      "attached_span_id": "s271",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 27168,
      "end": 27691,
      "text": "¬وهكذا قال أهل العلم. قال ابن معين: \"يقولون: إن نافعًا لم يحدث حتى مات سالم\" وقال ابن المديني، كما في \"التمهيد\" (13/ 282) لابن عبد البر، عن الأحاديث التي اختلف فيها نافع وسالم: \"القول فيها قول سالم\". وقال النسائي: \"سالم أجل من نافع\". وقال الطحاوي في \"شرح المعاني\" (1/ 378): \"وسالم أثبت من نافع وأحفظ\".\r\nوذكر أبو داود في \"سننه\" (3434) أن سالمًا [وقع في \"المطبوعة\": الزهري. وهو خطأ] اختلف مع نافع في أربعة أحاديث. وذكر النسائي أنها ثلاثة، رجح النسائي فيها قول نافع. ورجح ابن المديني قول سالم. وانظر \"فتح الباري\" (5/ 51، 52).¥",
      "attached_span_id": "s280",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 27870,
      "end": 28012,
      "text": "¬في \"تفسيره\" (1683) والمثنى هو ابن إبراهيم، والحجاج هو ابن منهال، وحماد هو ابن سلمة، وخالد هو ابن مهران الحذاء، ورجاله ثقات كما قال ابن كثير.¥",
      "attached_span_id": "s283",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 28236,
      "end": 28261,
      "text": "¬لم يقع في رواية الطبري.¥",
      "attached_span_id": "s286",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 28307,
      "end": 28440,
      "text": "¬كذا في (ع) و (ك) و (ن) و (ى). ووقع في (ج) و (ل): \"المتكلم\"، وأشار ناسخ (ن) في الحاشية إلى هذه الكلمة. ووقع في (ز) و (ض): \"تكلم به\".¥",
      "attached_span_id": "s287",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 28539,
      "end": 28679,
      "text": "¬في (ج): \"جيد ورجاله ثقات\"، وكتب الناسخ لفظة: \"جيد\" بخط دقيق فوق السطر، وكأنها من تصرفه أو لعل ابن كثير كان كتبها ثم ضرب عليها. والله أعلم.¥",
      "attached_span_id": "s288",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 28716,
      "end": 28991,
      "text": "¬في \"تفسيره\" (1008).\r\nوأخرجه الحاكم في \"المستدرك\" (2/ 265، 266)؛ وأبو الشيخ في \"كتاب العظمة\" (698/ 19) من طريق يعلى بن عبيد، حدثنا إسماعيل بن أبي خالد، عن عمير بن سعيد، عن علي به؛ وأخرجه ابن أبي الدنيا في \"العقوبات\" (223) من طريق جرير بن عبد الحميد، عن إسماعيل به وسنده قوي.¥",
      "attached_span_id": "s289",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 29093,
      "end": 29276,
      "text": "¬كذا في (ج) و (ع) و (ك) و (ى). ووقع في (ض): \"ابن أبي حاتم\"؛ وفي (ز): \"عن خالد\" و (ل) و (ن): \"عن أبي خالد\" وكل هذا خطأ. والصواب: ما أثبته، وهو إسماعيل بن أبي خالد، أحد الثقات الأثبات.¥",
      "attached_span_id": "s290",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 29321,
      "end": 29330,
      "text": "¬من (ن).¥",
      "attached_span_id": "s291",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 17935,
      "end": 17996,
      "text": "¬صحيح مسلم، الإيمان، باب في قوله: \"إن الله لا ينام\" (ح 179).¥",
      "attached_span_id": "s204",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 18583,
      "end": 18694,
      "text": "¬أخرجه الطبري بسنده ولفظه. وفي سنده أُمية بن شبل له حديث منكر، وهو الحديث المذكور (ينظر: لسان الميزان 1/ 467).¥",
      "attached_span_id": "s210",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 19235,
      "end": 19257,
      "text": "¬في الأصل: \"أحديهما\".¥",
      "attached_span_id": "s217",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 19396,
      "end": 19478,
      "text": "¬أخرجه الطبري بسنده ومتنه وحكم عليه الحافظ ابن كثير. وفي سنده أيضًا أُمية بن شبل.¥",
      "attached_span_id": "s218",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 20137,
      "end": 20229,
      "text": "¬أخرجه ابن أبي حاتم بسنده ولفظه، وفي سنده جعفر بن أبي المغيرة وهو صدوق يهم (التقريب ص 141).¥",
      "attached_span_id": "s224",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 21078,
      "end": 21210,
      "text": "¬أخرجه البخاري من حديث أبي هريرة (الصحيح، تفسير سورة الإسراء، باب {ذُرِّيَّةَ مَنْ حَمَلْنَا مَعَ نُوحٍ ... } [الإسراء: 3] ح 4712).¥",
      "attached_span_id": "s232",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 22166,
      "end": 22366,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه وتعليقه والطبري كذلك، وفي سنديهما جعفر بن أبي المغيرة صدوق يهم كما تقدم في الصفحة السابقة وهذه الرواية عن ابن عباس مخالفة ما ثبت عنه أن الكرسي: موضع القدمين كما سيأتي.¥",
      "attached_span_id": "s241",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 22464,
      "end": 22627,
      "text": "¬أخرجه الطبري من طريق عمارة بن عمير عن أبي موسى، وعمارة لم يسمع من أبي موسى، وأخرجه بسند حسن من طريق أسباط عن السدي، وبسند حسن من طريق عمار الدهني عن مسلم البطين.¥",
      "attached_span_id": "s243",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 23012,
      "end": 23119,
      "text": "¬وجه الغلط هو رفعه إلى النبي - صلى الله عليه وسلم - والصحيح وقفه على ابن عباس ولعل الذي رفعه شجاع بن مخلد.¥",
      "attached_span_id": "s248",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 23272,
      "end": 23283,
      "text": "¬سنده حسن.¥",
      "attached_span_id": "s250",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 23473,
      "end": 23491,
      "text": "¬المستدرك 2/ 282.¥",
      "attached_span_id": "s252",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 23662,
      "end": 23720,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق إسرائيل عن السدي به.¥",
      "attached_span_id": "s254",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 23786,
      "end": 23847,
      "text": "¬أخرجه الطبرى وابن أبي حاتم بسند حسن من طريق أسباط عن السدي.¥",
      "attached_span_id": "s255",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 24019,
      "end": 24121,
      "text": "¬أخرجه ابن أبي حاتم بسند ضعيف من طريق بشر بن عمارة عن أبي روق عطية عن الضحاك به، وبشر بن عمارة: ضعيف.¥",
      "attached_span_id": "s257",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 24404,
      "end": 24472,
      "text": "¬أخرجه الطبري بسنده ومتنه وفيه عبد الرحمن بن زيد بن أسلم: وهو ضعيف.¥",
      "attached_span_id": "s262",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 24918,
      "end": 25021,
      "text": "¬في سنده القاسم بن محمد الثقفي وهو مجهول، ومحمد بن أبي السري: وهو صدوق له أوهام كثيرة (التقريب ص 504).¥",
      "attached_span_id": "s265",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 25363,
      "end": 25588,
      "text": "¬أخرجه الضياء عن طريق أبي يعلى به (ح 151)، وأخرجه ابن أبي عاصم (السنة 1/ 252)، وأبو الشيخ (العظمة ح 193)، والبزار (كشف الأستار ح 39، كلهم من طريق إسرائيل به. وقد حكم عليه الحافظ ابن كثير بالانقطاع بين عبد الله بن خليفة وعمر.¥",
      "attached_span_id": "s271",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 26442,
      "end": 26501,
      "text": "¬في سنده جويبر: وهو ابن سعيد الأزدي: متروك كما في التقريب.¥",
      "attached_span_id": "s276",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

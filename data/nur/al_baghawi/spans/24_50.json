  "spans": [
    {
      "start": 0,
      "end": 48,
      "text": "{أَفِي قُلُوبِهِمْ مَرَضٌ أَمِ ارْتَابُوا} أَيْ:",
      "id": "s001"
    },
    {
      "start": 48,
      "end": 101,
      "text": " شَكُّوا، هَذَا اسْتِفْهَامُ ذَمٍّ وَتَوْبِيخٍ، أَيْ:",
      "id": "s002"
    },
    {
      "start": 101,
      "end": 184,
      "text": " هُمْ كَذَلِكَ، {أَمْ يَخَافُونَ أَنْ يَحِيفَ اللَّهُ عَلَيْهِمْ وَرَسُولُهُ} أَيْ:",
      "id": "s003"
    },
    {
      "start": 184,
      "end": 276,
      "text": " بِظُلْمٍ، {بَلْ أُولَئِكَ هُمُ الظَّالِمُونَ} لِأَنْفُسِهِمْ بِإِعْرَاضِهِمْ عَنِ الْحَقِّ.",
      "id": "s004"
    }
  ]

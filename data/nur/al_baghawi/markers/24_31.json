  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1467,
      "end": 2012,
      "text": "¬أخرجه أبو داود في اللباس، باب في قوله تعالى: \"وقل للمؤمنات يغضضن من أبصارهن\" 6/ 60 - 61 والترمذي في الأدب، باب: ما جاء في احتجاب النساء من الرجال: 8/ 61 - 62 وقال: \"هذا حديث حسن صحيح\". وعزاه المنذري للنسائي، وأخرجه الإمام أحمد: 6/ 296 وذكره المصنف في شرح السنة: 9/ 24.\nوقال أبو داود: \"هذا لأزواج النبي صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خاصة، ألا ترى إلى اعتداد فاطمة بنت قيس عند ابن أم مكتوم، وقد قال النبي صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لفاطمة بنت قيس: \"اعتدي عند ابن أم مكتوم، فإنه رجل أعمى تضعين ثيابك عنده\"، وانظر: عون المعبود: 11/ 170.¥",
      "attached_span_id": "s007",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3560,
      "end": 3589,
      "text": "¬ما بين القوسين ساقط من \"أ\".¥",
      "attached_span_id": "s021",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3816,
      "end": 3884,
      "text": "¬أخرجه البخاري في التفسير، باب: \"وليضربن بخمرهن على جيوبهن\" 8/ 489.¥",
      "attached_span_id": "s023",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5427,
      "end": 5525,
      "text": "¬أخرجه الطبري: 18/ 121 وعزاه السيوطي في الدر المنثور: 6/ 183 لسعيد بن منصور والبيهقي وابن المنذر.¥",
      "attached_span_id": "s032",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6304,
      "end": 6571,
      "text": "¬أخرجه أبو داود في اللباس، باب العبد ينظر إلى شعر مولاته: 6/ 59 قال المنذري: \"في إسناده أبو جميع، سالم بن دينار الهجيمي البصري، قال ابن معين: ثقة، وقال أبو زرعة الرازي: مصري لين الحديث، وهو سالم بن أبي راشد\". وأخرجه البيهقي: 7/ 95، وصححه الألباني في الإرواء: 6/ 206.¥",
      "attached_span_id": "s036",
      "grading": [
        "إسناده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9021,
      "end": 9219,
      "text": "¬أخرجه البخاري في اللباس، باب إخراج المتشبهين بالنساء عن البيوت، عن أم سلمة: 10/ 333 ومسلم في السلام باب منع المخنث من الدخول على النساء الأجانب، برقم (2181): 4/ 1716 والمصنف في شرح السنة: 12/ 122.¥",
      "attached_span_id": "s054",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10895,
      "end": 11024,
      "text": "¬أخرجه مسلم في الذكر والدعاء والاستغفار، باب استحباب الاستغفار والاستكثار منه، برقم (2072): 4/ 2076 والمصنف في شرح السنة: 5/ 71.¥",
      "attached_span_id": "s065",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11689,
      "end": 12096,
      "text": "¬أخرجه أبو داود في الصلاة، باب في الاستغفار: 2/ 151 والترمذي في الدعوات، باب ما يقول إذا قام من مجلسه: 9/ 393 وقال: هذا حديث حسن صحيح غريب. وابن ماجه في الأدب، باب الاستغفار، برقم (3814) والإمام أحمد في المسند: 2/ 21 وصححه ابن حبان برقم (2459) ص (609) من موارد الظمآن، وأخرجه عبد بن حميد في المنتخب ص (251) وابن السني في عمل اليوم والليلة ص (179). وانظر: مجمع الزوائد: 2/ 113 سلسلة الأحاديث الصحيحة: 2/ 89.¥",
      "attached_span_id": "s068",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 12829,
      "end": 13001,
      "text": "¬أخرجه البخاري في الصلاة، باب ما يذكر في الفخذ: 1/ 479 - 480 وفي مواضع أخرى، ومسلم في الجهاد، باب غزوة خيبر، برقم (1365): 4/ 1426 - 1427. وذكره المصنف في شرح السنة: 9/ 21.¥",
      "attached_span_id": "s072",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 13608,
      "end": 13998,
      "text": "¬أخرجه الطحاوي في مشكل الآثار: 2/ 285 والحاكم في المستدرك: 4/ 180 والإمام أحمد في المسند: 5/ 290. وعلقه البخاري: 1/ 479 وأخرجه المصنف في شرح السنة: 9/ 21.\nقال الحافظ في الفتح: \"وصله أحمد والمصنف في \"التاريخ\" والحاكم في \"المستدرك\"، كلهم من طريق إسماعيل بن جعفر عن العلاء بن عبد الرحمن عن أبي كثير مولى محمد بن جحش عنه .. \". وصححه بشواهده الشيخ الأرناؤوط في تعليقه على شرح السنة: 9/ 21 - 22.¥",
      "attached_span_id": "s075",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 14173,
      "end": 14559,
      "text": "¬أخرجه الترمذي في الاستئذان، باب ما جاء أن الفخذ عورة: 8/ 78 - 79 وقال: \"هذا حديث حسن، ما أرى إسناده بمتصل\".\nورواه البخاري تعليقا: 1/ 478، وقال الحافظ ابن حجر في \"الفتح\": \"وحديث جرهد موصول عند مالك في الموطأ، والترمذي وحسنه، وابن حبان وصححه. وضعفه المصنف في التاريخ للاضطراب في سنده، وقد ذكرت كثيرا من طرقه في تغريق التعليق\". وانظر: مشكل الآثار: 2/ 285 - 286، شرح معاني الآثار: 1/ 474.¥",
      "attached_span_id": "s076",
      "grading": [
        "حسن",
        "سنده",
        "إسناده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 14652,
      "end": 14679,
      "text": "¬في الموضع السابق: 1/ 478.¥",
      "attached_span_id": "s077",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 15646,
      "end": 15863,
      "text": "¬أخرجه أبو داود في اللباس: باب في قوله تعالى: \"وقل للمؤمنات يغضضن من أبصارهن\": 6/ 61، والبيهقي في السنن: 3/ 226 و 229، و 7/ 94، والدارقطني: 1/ 230. وحسنه الألباني في الإرواء: 2/ 207. وذكره المصنف في شرح السنة: 9/ 25.¥",
      "attached_span_id": "s083",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    }
  ],

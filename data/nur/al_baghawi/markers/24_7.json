  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2699,
      "end": 2934,
      "text": "¬أخرجه مالك في الموطأ، باب ما جاء في اللعان برقم (34): 2/ 566 - 567، وأخرجه البخاري في الطلاق، باب: اللعان ومن طلق بعد اللعان: 9/ 446، وفي مواضع أخرى، ومسلم في أول باب اللعان، برقم: (1492) 2/ 1129 - 1130، والمصنف في شرح السنة: 9/ 250.¥",
      "attached_span_id": "s014",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3412,
      "end": 3884,
      "text": "¬لقد اشتهر بهذا اللفظ في كتب والأصول ما أخرجه ابن ماجه في كتاب الطلاق باب طلاق المكره والناسي من طريق الوليد بن مسلم عن الأوزاعي عن عطاء عن ابن عباس بلفظ: (إن الله وضع عن أمتي الخطأ والنسيان وما استكرهوا عليه) رجاله كلهم ثقات ولكن يوجد فيه انقطاع بين ابن عباس وعطاء وأشار إلى هذا البوصيري في الزوائد فقال: إسناده صحيح إن سلم من الانقطاع وقد ورد بألفاظ أخرى يقوي بعضها بعضا. انظر إرواء الغليل للشيخ الألباني 1/ 123 والمعتبر في تخريج أحاديث المنهاج، والمختصر للزركشي ص 154.¥",
      "attached_span_id": "s018",
      "grading": [
        "صحيح",
        "إسناده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4052,
      "end": 4146,
      "text": "¬أخرجه البخاري في الطلاق، باب: التلاعن في المسجد: 9/ 452 - 453، والمصنف في شرح السنة: 9/ 252.¥",
      "attached_span_id": "s020",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5812,
      "end": 5827,
      "text": "¬شديد سوادهما.¥",
      "attached_span_id": "s032",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5853,
      "end": 5877,
      "text": "¬تام الإليتين، عظيمهما.¥",
      "attached_span_id": "s033",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5902,
      "end": 5912,
      "text": "¬عظيمهما.¥",
      "attached_span_id": "s034",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6095,
      "end": 6258,
      "text": "¬أخرجه البخاري في تفسير سورة النور، باب: \"ويدرأ عنها العذاب أن تشهد أربع شهادات بالله إنه لمن الكاذبين\" 8/ 449 وفي مواضع أخرى، والمصنف في شرح السنة: 9/ 259 - 260.¥",
      "attached_span_id": "s036",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10425,
      "end": 10510,
      "text": "¬أخرجه مسلم في اللعان، برقم (1498): 2/ 1135، وأخرج بعضه المصنف في شرح السنة: 9/ 265.¥",
      "attached_span_id": "s061",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 14499,
      "end": 14594,
      "text": "¬الأصيهب: تصغير الأصهب، وهو الذي يعلوه صهبة، وهي كالشقرة، وفي \"أ\": \"بأصهب\" بدلا من \"به أصيهب\".¥",
      "attached_span_id": "s081",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 14608,
      "end": 14718,
      "text": "¬الأثيبج: تصغير الأثبج، وهو الناتئ الثبج، والثبج: ما بين الكاهل ووسط الظهر وفي \"أ\" جاءت العبارة: \"أسلح أسحب\".¥",
      "attached_span_id": "s083",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 14792,
      "end": 14822,
      "text": "¬أورق: يميل لونه للون الرماد.¥",
      "attached_span_id": "s084",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 14843,
      "end": 14896,
      "text": "¬جماليا: الجمالي: العظيم الخلق، شبه خلقه بخلق الجمل.¥",
      "attached_span_id": "s085",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 14919,
      "end": 14944,
      "text": "¬الخدلج: العظيم الساقين.¥",
      "attached_span_id": "s086",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام البغوي"

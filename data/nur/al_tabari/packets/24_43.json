          "end": 2642,
          "span_id": "s034"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 2648,
          "end": 2652,
          "span_id": "s034"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأه",
          "start": 2648,
          "end": 2653,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2655,
      "end": 2697,
      "text": " (مِن خَلَلِه) بفتحِ الخاءِ مِن غيرِ ألفٍ.",
      "markers": []
    },
    {
      "id": "s036",
      "start": 2697,
      "end": 2737,
      "text": "قال هارونُ: فذكرتُ ذلك لأبي عمرٍو، فقال:",
      "markers": []
    },
    {
      "id": "s037",
      "start": 2737,
      "end": 2777,
      "text": " إنها لحسنةٌ، ولكنَّ {خِلَالِهِ} أعَمُّ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2758,
          "end": 2769,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 2777,
      "end": 2824,
      "text": "وأما قرأةُ الأمصارِ فإنهم على القراءةِ الأُخرى:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 2782,
          "end": 2785,
          "span_id": "s038"
        },
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 2809,
          "end": 2814,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 2824,
      "end": 2859,
      "text": " {مِنْ خِلَالِهِ}. وهى التي نختارُ؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2825,
          "end": 2841,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 2859,
      "end": 2896,
      "text": " لإجماعِ الحُجَّةِ مِن القرأةِ عليها.",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 2884,
          "end": 2887,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 2896,
      "end": 2938,
      "text": "حدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2916,
          "end": 2923,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 2938,
      "end": 2961,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 2943,
          "end": 2950,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 2961,
      "end": 3006,
      "text": " {فَتَرَى الْوَدْقَ يَخْرُجُ مِنْ خِلَالِهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2962,
          "end": 3005,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 3006,
      "end": 3049,
      "text": " قال: الوَدْقُ القَطْرُ، والخِلالُ السحابُ ",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3138,
      "end": 3209,
      "text": ".وقولُه: {وَيُنَزِّلُ مِنَ السَّمَاءِ مِنْ جِبَالٍ فِيهَا مِنْ بَرَدٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3147,
          "end": 3208,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3209,
      "end": 3247,
      "text": " قيل: في ذلك قولان؛ أحدُهما، أن معناه:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 3241,
          "end": 3246,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3247,
      "end": 3334,
      "text": " وأن الله يُنَزِّلُ مِن السماءِ مِن جبالٍ في السماءِ مِن بَرَدٍ، مخلوقةٍ هنالك خِلْقةً.",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3334,
      "end": 3388,
      "text": " كأن الجبالَ على هذا القولِ، هي مِن بَرَدٍ، كما يقالُ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 3382,
          "end": 3386,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3388,
      "end": 3502,
      "text": " جبالٌ مِن طينٍ.والقولُ الآخرُ: أَن اللَّهَ يُنزِّلُ مِن السماءِ قَدْرَ جبالٍ وأمثالَ جبالٍ مِن بَرَدٍ إلى الأرضِ.",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3502,
      "end": 3535,
      "text": " كما يقالُ: عندى بَيْتان تِبْنًا.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 3507,
          "end": 3511,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3535,
      "end": 3569,
      "text": " والمعنى: قَدْرُ بيتَين من التبنِ.",
      "markers": [
        {
          "family": "RAY",
          "marker": "والمعنى",
          "start": 3536,
          "end": 3543,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 3569,
      "end": 3667,
      "text": " والبيتان ليسا مِن التُّبْنِ.وقولُه: {فَيُصِيبُ بِهِ مَنْ يَشَاءُ وَيَصْرِفُهُ عَنْ مَنْ يَشَاءُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3606,
          "end": 3666,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 3667,
      "end": 3847,
      "text": " يقولُ: فيُعذِّبُ بذلك الذي يُنَزِّلُ مِن السماءِ مِن جبالٍ فيها مِن بَرَدٍ - مَن يَشَاءُ فَيُهْلِكُه، أو يُهْلِكُ بِهِ زُرُوعَه ومالَه، {وَيَصْرِفُهُ عَنْ مَنْ يَشَاءُ} مِن خلقِه.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3804,
          "end": 3836,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 3847,
      "end": 3934,
      "text": " يعنى: عن زُرُوعِهم وأموالِهم.وقولُه: {يَكَادُ سَنَا بَرْقِهِ يَذْهَبُ بِالْأَبْصَارِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3885,
          "end": 3933,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 3934,
      "end": 4011,
      "text": " يقولُ: يكادُ شدةُ ضوءِ بَرْقِ هذا السحابِ يَذْهَبُ بأَبصارِ مَن لاقَى بصرَه.",
      "markers": []
    },
    {
      "id": "s056",
      "start": 4011,
      "end": 4050,
      "text": " و \"السَّنَا\"، مقصورٌ، وهو ضوءُ البرقِ.",
      "markers": []
    },
    {
      "id": "s057",
      "start": 4050,
      "end": 4101,
      "text": "كما حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال: ثني حجا",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4054,
          "end": 4061,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4105,
      "end": 4167,
      "text": "جٌ، عن ابن جُرَيجٍ، عن عطاءٍ الخُراسانيِّ، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4109,
          "end": 4154,
          "stripped": "عن ابن جريج، عن عطاء الخراساني، عن ابن",
          "span_id": "s058"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 4112,
          "end": 4122,
          "span_id": "s058"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "NARRATOR",
          "start": 4128,
          "end": 4132,
          "span_id": "s058"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 4151,
          "end": 4159,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4167,
      "end": 4214,
      "text": " {يَكَادُ سَنَا بَرْقِهِ}. قال: ضَوْءُ بَرْقِه ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4168,
          "end": 4192,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4325,
      "end": 4398,
      "text": ".حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، عن معمرٍ، عن قتادةَ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4326,
          "end": 4333,
          "span_id": "s060"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 4326,
          "end": 4371,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، عن",
          "span_id": "s060"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "NARRATOR",
          "start": 4334,
          "end": 4339,
          "span_id": "s060"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4347,
          "end": 4354,
          "span_id": "s060"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4369,
          "end": 4398,
          "stripped": "عن معمر، عن قتادة في قوله:",
          "span_id": "s060"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 4382,
          "end": 4387,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4398,
      "end": 4465,
      "text": " {يَكَادُ سَنَا بَرْقِهِ}. يقولُ: لَمَعانُ البرقِ يَذهبُ بالأبصارِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4399,
          "end": 4423,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4589,
      "end": 4632,
      "text": ".حدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4610,
          "end": 4617,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 4632,
      "end": 4655,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 4637,
          "end": 4644,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 4655,
      "end": 4725,
      "text": " {يَكَادُ سَنَا بَرْقِهِ يَذْهَبُ بِالْأَبْصَارِ}. قال: سَنَاه ضَوءُه ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4656,
          "end": 4704,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4739,
      "end": 4778,
      "text": "، يذهبُ بالأبصارِ.وقرأت قرأةُ الأمصارِ:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 4758,
          "end": 4761,
          "span_id": "s065"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 4763,
          "end": 4766,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 4778,
      "end": 4911,
      "text": " {يَكَادُ سَنَا بَرْقِهِ يَذْهَبُ} بفتحِ الياءِ مِن {يَذْهَبُ} سوى أبي جعفرٍ القارئَ، فإنه قرأَه بضمِّ الياءِ: (يُذْهِبُ بالأَبصارِ) ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4779,
          "end": 4812,
          "span_id": "s066"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4830,
          "end": 4840,
          "span_id": "s066"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 4869,
          "end": 4872,
          "span_id": "s066"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأه",
          "start": 4869,
          "end": 4874,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 4926,
      "end": 4969,
      "text": ".والقراءةُ التي لا أختارُ غيرَها هي فتحُها؛",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 4930,
          "end": 4935,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 4969,
      "end": 5071,
      "text": " لإجماعِ الحُجَّةِ مِن القرأةِ عليها، وأن العربَ إذا أدخَلَت الباءَ في مفعولِ \"ذَهَبتُ\" لم يقولوا إلا:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 4994,
          "end": 4997,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 5071,
      "end": 5125,
      "text": " ذَهَبتُ به. دونَ: أَذهَبْتُ به. وإذا أدخَلوا الألفَ ف",
      "markers": []
    },
    {
      "id": "s070",
      "start": 5129,
      "end": 5218,
      "text": "ي \"أذهبتُ\" لم يَكادوا أن يُدْخِلوا الباءَ في مفعولِه، فيقولون: أَذْهَبْتُه، وذَهَبتُ به. ",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [

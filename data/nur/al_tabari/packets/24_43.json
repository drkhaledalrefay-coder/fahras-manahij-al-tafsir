    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 440,
      "text": " {أَلَمْ تَرَ أَنَّ اللَّهَ يُزْجِي سَحَابًا ثُمَّ يُؤَلِّفُ بَيْنَهُ ثُمَّ يَجْعَلُهُ رُكَامًا فَتَرَى الْوَدْقَ يَخْرُجُ مِنْ خِلَالِهِ وَيُنَزِّلُ مِنَ السَّمَاءِ مِنْ جِبَالٍ فِيهَا مِنْ بَرَدٍ فَيُصِيبُ بِهِ مَنْ يَشَاءُ وَيَصْرِفُهُ عَنْ مَنْ يَشَاءُ يَكَادُ سَنَا بَرْقِهِ يَذْهَبُ بِالْأَبْصَارِ (43) يُقَلِّبُ اللَّهُ اللَّيْلَ وَالنَّهَارَ إِنَّ فِي ذَلِكَ لَعِبْرَةً لِأُولِي الْأَبْصَارِ (44)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 439,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 440,
      "end": 495,
      "text": "يقولُ تعالى ذكرُه لنبيِّه محمدٍ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 474,
          "end": 492,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 495,
      "end": 544,
      "text": " {أَلَمْ تَرَ} يا محمدُ، {أَنَّ اللَّهَ يُزْجِي}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 496,
          "end": 509,
          "span_id": "s004"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 520,
          "end": 543,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 544,
      "end": 608,
      "text": " يعني: يَسُوقُ {سَحَابًا} حيث يريدُ، {ثُمَّ يُؤَلِّفُ بَيْنَهُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 559,
          "end": 569,
          "span_id": "s005"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 581,
          "end": 607,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 608,
      "end": 640,
      "text": " يقولُ: ثم يؤلِّفُ بينَ السحابِ.",
      "markers": []
    },
    {
      "id": "s007",
      "start": 640,
      "end": 740,
      "text": "وأضافَ \"بينَ\" إلى السحابِ، ولم يَذْكُرْ معه غيرَه، و \"بينَ\" لا تكونُ مضافةً إلا إلى جماعةٍ أو اثنين؛",
      "markers": []
    },
    {
      "id": "s008",
      "start": 740,
      "end": 803,
      "text": " لأن السحابَ في معنى جمعٍ، واحِدُه سحابةٌ، كما تُجمَعُ النخلةُ:",
      "markers": []
    },
    {
      "id": "s009",
      "start": 803,
      "end": 849,
      "text": " نَخْلٌ. والتمرةُ: تمرٌ. فهو نظيرُ قولِ قائلٍ:",
      "markers": []
    },
    {
      "id": "s010",
      "start": 849,
      "end": 921,
      "text": " جَلَس فلانٌ بينَ النخلِ.وتأليفُ اللهِ السحابَ جمعُه بينَ مُتَفَرِّقِها.",
      "markers": []
    },
    {
      "id": "s011",
      "start": 921,
      "end": 964,
      "text": "وقولُه: {ثُمَّ يَجْعَلُهُ رُكَامًا}. يقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 929,
          "end": 956,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 964,
      "end": 1028,
      "text": " ثم يجعلُ السحابَ الذي يُزْجِيهِ، ويُؤلِّفُ بعضَه إلى بعضٍ - {رُ",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1032,
      "end": 1074,
      "text": "كَامًا}. يعنى: مُتَراكِمًا بعضُه على بعضٍ.",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1074,
      "end": 1115,
      "text": "وقد حدَّثنا عبدُ الحميدِ بنُ بَيانٍ، قال:",

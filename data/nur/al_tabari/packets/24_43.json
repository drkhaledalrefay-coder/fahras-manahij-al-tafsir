    },
    {
      "id": "s017",
      "start": 1265,
      "end": 1363,
      "text": " الرياحُ أربعٌ، يبعثُ اللَّهُ الريحَ الأولى، فتَقُمُّ الأرضَ قَمًّا، ثم يبعثُ الثانيةَ، فتُنْشِئُ ",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1393,
      "end": 1484,
      "text": " سحابًا، ثم يبعثُ الثالثةَ، فتُؤلِّفُ بينَه، فتجعلُه رُكامًا، ثم يبعثُ الرابعةَ فتُمْطِرُه ",
      "markers": []
    },
    {
      "id": "s019",
      "start": 1588,
      "end": 1641,
      "text": ".وقولُه: {فَتَرَى الْوَدْقَ يَخْرُجُ مِنْ خِلَالِهِ}.",

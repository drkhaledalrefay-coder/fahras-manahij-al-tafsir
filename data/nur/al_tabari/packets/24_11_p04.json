  "spans": [
    {
      "id": "s315",
      "start": 27662,
      "end": 27755,
      "text": "ءت به على نفسِها. وايمُ اللَّهِ مَا أجدُ لي ولكم مثلًا إلا كما قال أبو يوسفَ وما أحفظُ اسمَه:",
      "markers": []
    },
    {
      "id": "s316",
      "start": 27755,
      "end": 27820,
      "text": " {فَصَبْرٌ جَمِيلٌ وَاللَّهُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 27756,
          "end": 27819,
          "span_id": "s316"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 27820,
          "end": 27830,
          "text": "[يوسف: 18]",
          "via": "apparatus",
          "span_id": "s316"
        }
      ]
    },
    {
      "id": "s317",
      "start": 27830,
      "end": 27915,
      "text": ". وأنزَل اللَّهُ على رسولِه - صلى الله عليه وسلم - ساعتَئذٍ، فرُفِع عنه وإني لأتبينُ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 27860,
          "end": 27878,
          "span_id": "s317"
        }
      ]
    },
    {
      "id": "s318",
      "start": 27967,
      "end": 28013,
      "text": " السرورَ ما في وجهِه، وهو يمسحُ جبينَه، يقولُ:",
      "markers": []
    },
    {
      "id": "s319",
      "start": 28013,
      "end": 28062,
      "text": " \"أبشِري يا عائشةُ، فقد أنزَل اللَّهُ براءَتَكِ\".",
      "markers": []
    },
    {
      "id": "s320",
      "start": 28062,
      "end": 28105,
      "text": " فكنتُ أشدَّ ما كنتُ غضبًا، فقال لى أبوايَ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "اي:",
          "start": 28101,
          "end": 28105,
          "span_id": "s320"
        }
      ]
    },
    {
      "id": "s321",
      "start": 28105,
      "end": 28153,
      "text": " قُومى إلى رسولِ اللَّهِ - صلى الله عليه وسلم -.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 28132,
          "end": 28150,
          "span_id": "s321"
        }
      ]
    },
    {
      "id": "s322",
      "start": 28153,
      "end": 28297,
      "text": " فقلتُ: واللَّهِ لا أقومُ إليه، ولا أحمَدُه، ولا أحمَدُ كما، لقد سمِعتموه فما أنكَرتُموه، ولا غيَّرتموه، ولكنى أحمَدُ اللَّهُ الذي أنزَل براءتى.",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 28155,
          "end": 28158,
          "span_id": "s322"
        }
      ]
    },
    {
      "id": "s323",
      "start": 28297,
      "end": 28375,
      "text": " ولقد جاء رسولُ اللَّهِ - صلى الله عليه وسلم - بيتي، فسأل الجاريةَ عنى، فقالت:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 28323,
          "end": 28341,
          "span_id": "s323"
        }
      ]
    },
    {
      "id": "s324",
      "start": 28375,
      "end": 28470,
      "text": " واللَّهِ ما أعلمُ عليها عيبًا، إلا أنها كانت تنامُ حتى تدخلَ الشاةُ فتأكلَ حصيرَها أو عجينَها.",
      "markers": []
    },
    {
      "id": "s325",
      "start": 28470,
      "end": 28556,
      "text": " فانتهرَها بعضُ أصحابِه، وقال: اصْدُقى رسولَ اللَّهِ - صلى الله عليه وسلم - قال عروةُ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 28525,
          "end": 28543,
          "span_id": "s325"
        }
      ]
    },
    {
      "id": "s326",
      "start": 28556,
      "end": 28583,
      "text": " فعتَب على مَن قاله. فقالت:",
      "markers": []
    },
    {
      "id": "s327",
      "start": 28583,
      "end": 28642,
      "text": " لا، واللَّهِ ما أعلمُ عليها إلا ما يعلمُ الصائغُ على تبرِ ",
      "markers": []
    },
    {
      "id": "s328",
      "start": 28720,
      "end": 28772,
      "text": " الذهبِ الأحمرِ. وبلَغ ذلك الرجلَ الذي قيل له، فقال:",
      "markers": []
    },
    {
      "id": "s329",
      "start": 28772,
      "end": 28806,
      "text": " سبحانَ اللَّهِ! ما كشَفتُ كَنَفَ ",
      "markers": []
    },
    {
      "id": "s330",
      "start": 28847,
      "end": 28890,
      "text": " أنثى قطُّ. فقُتِل شهيدًا في سبيلِ اللَّهِ.",
      "markers": []
    },
    {
      "id": "s331",
      "start": 28890,
      "end": 29035,
      "text": " قالت عائشةُ: فأما زينبُ بنتُ جحشٍ، فعصَمها اللَّهُ بدينِها، فلم تقلْ إلا خيرًا، وأما أختُها حَمنَةُ، فهلَكت في من هلَك، وكان الذين تكلَّموا فيه؛",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "SPEAKER",
          "start": 28896,
          "end": 28901,
          "span_id": "s331"
        }
      ]
    },
    {
      "id": "s332",
      "start": 29035,
      "end": 29094,
      "text": " المنافقُ عبدُ اللَّهِ بنُ أُبيٍّ ابن سلولَ، وكان يستوشِيه ",
      "markers": []
    },
    {
      "id": "s333",
      "start": 29146,
      "end": 29271,
      "text": " ويجمعُه، وهو الذي تولَّى كِبْرَه، ومِسْطحٌ، وحسانُ بنُ ثابتٍ، فحلَف أبو بكرٍ ألّا ينفَعَ مِسْطَحًا بنافعةٍ، فأنزَلَ اللَّهُ:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 29255,
          "end": 29261,
          "span_id": "s333"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 29255,
          "end": 29269,
          "span_id": "s333"
        }
      ]
    },
    {
      "id": "s334",
      "start": 29271,
      "end": 29327,
      "text": " {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 29272,
          "end": 29326,
          "span_id": "s334"
        }
      ]
    },
    {
      "id": "s335",
      "start": 29327,
      "end": 29393,
      "text": " يعنى أبا بكرٍ، {أَنْ يُؤْتُوا أُولِي الْقُرْبَى وَالْمَسَاكِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 29343,
          "end": 29392,
          "span_id": "s335"
        }
      ]
    },
    {
      "id": "s336",
      "start": 29393,
      "end": 29483,
      "text": " يعنى مِسْطحًا، {أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 29409,
          "end": 29482,
          "span_id": "s336"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 29483,
          "end": 29494,
          "text": "[النور: 22]",
          "via": "apparatus",
          "span_id": "s336"
        }
      ]
    },
    {
      "id": "s337",
      "start": 29494,
      "end": 29556,
      "text": ". قال أبو بكرٍ: بلى واللَّهِ، إنا لنحبُّ أن يغفرَ اللَّهُ لنا.",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 29500,
          "end": 29507,
          "span_id": "s337"
        }
      ]
    },
    {
      "id": "s338",
      "start": 29556,
      "end": 29598,
      "text": " وعاد أبو بكرٍ لمِسْطَحٍ بما كان يصنعُ به ",
      "markers": []
    },
    {
      "id": "s339",
      "start": 29841,
      "end": 29890,
      "text": ".حدَّثنا ابن وكيعٍ، قال: ثنا محمدُ بنُ بشرٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 29842,
          "end": 29849,
          "span_id": "s339"
        }
      ]
    },
    {
      "id": "s340",
      "start": 29890,
      "end": 29916,
      "text": " ثنا محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s341",
      "start": 29916,
      "end": 30021,
      "text": " ثنا يحيى بنُ عبدَ الرحمنِ بن حاطبٍ، عن علقمةَ بن وقَاصٍ وغيرِه أيضًا، قال: خرَجت عائشةُ تريدُ المَذْهبَ ",
      "markers": []
    },
    {
      "id": "s342",
      "start": 30069,
      "end": 30196,
      "text": "، ومعها أمُّ مسطحٍ، وكان مِسطحُ بن أثاثةَ ممن قال ما قال، وكان رسولُ اللَّهِ - صلى الله عليه وسلم - خطَب الناسَ قبلَ ذلك، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "ان رسول الله",
          "start": 30129,
          "end": 30144,
          "span_id": "s342"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 30148,
          "end": 30166,
          "span_id": "s342"
        }
      ]
    },
    {
      "id": "s343",
      "start": 30196,
      "end": 30257,
      "text": " \"كيف ترَون في من يؤذيني في أهلي، ويجمعُ في بيتِه مَن يؤذيني؟",
      "markers": []
    },
    {
      "id": "s344",
      "start": 30257,
      "end": 30282,
      "text": " \". فقال سعدُ بنُ مُعاذٍ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 30275,
          "end": 30280,
          "span_id": "s344"
        }
      ]
    },
    {
      "id": "s345",
      "start": 30282,
      "end": 30333,
      "text": " أي رسولَ اللَّهِ، إن كان منا معشرَ الأوسِ جلَدْنا ",
      "markers": []
    },
    {
      "id": "s346",
      "start": 30384,
      "end": 30442,
      "text": " رأسَه، وإن كان من إخوانِنا من الخزرجِ، أمَرتَنا فأطَعناك.",
      "markers": []
    },
    {
      "id": "s347",
      "start": 30442,
      "end": 30539,
      "text": " فقال سعدُ بنُ عبادةَ: يا بنَ معاذٍ، واللَّهِ ما بك نُصْرةُ رسولِ اللَّهِ، ولكنها قد كانت ضغائنُ ",
      "markers": []
    },
    {
      "id": "s348",
      "start": 30558,
      "end": 30579,
      "text": " في الجاهليةِ وإحَنٌ ",
      "markers": []
    },
    {
      "id": "s349",
      "start": 30632,
      "end": 30665,
      "text": " لم تُحْلَلْ لنا من صدورِكم بعدُ.",
      "markers": []
    },
    {
      "id": "s350",
      "start": 30665,
      "end": 30731,
      "text": "فقال ابن معاذٍ: اللَّهُ أعلمُ ما أردتُ. فقام أُسَيدُ بنُ حُضَيرٍ، ",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 30674,
          "end": 30678,
          "span_id": "s350"
        }
      ]
    },
    {
      "id": "s351",
      "start": 30735,
      "end": 30815,
      "text": "فقال: يابنَ عبادةَ، إن سعدًا ليس شديدًا، ولكنك تجادلُ عن المنافقين، وتدفعُ عنهم.",
      "markers": []
    },
    {
      "id": "s352",
      "start": 30815,
      "end": 31006,
      "text": " وكثُر اللَّغَطُ في الحيَّينِ في المسجدَ، ورسولُ اللَّهِ - صلى الله عليه وسلم - جالسٌ على المنبرِ، فما زال النبيُّ - صلى الله عليه وسلم - يومئُ بيدِه إلى الناسِ هاهنا وهاهنا، حتى هدَأ الصوتُ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 30874,
          "end": 30892,
          "span_id": "s352"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 30932,
          "end": 30950,
          "span_id": "s352"
        }
      ]
    },
    {
      "id": "s353",
      "start": 31006,
      "end": 31103,
      "text": "وقالت عائشةُ: كان الذي تولَّى كِبْرَه، والذي يجمعُهم في بيتِه، عبدُ اللَّهِ بنُ أبُيٍّ ابن سلولُ.",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "SPEAKER",
          "start": 31012,
          "end": 31017,
          "span_id": "s353"
        }
      ]
    },
    {
      "id": "s354",
      "start": 31103,
      "end": 31167,
      "text": " قالت: فخرَجتُ إلى المَذْهَبِ ومعى أمُّ مسطحٍ، فعثَرَتْ، فقالتْ:",
      "markers": []
    },
    {
      "id": "s355",
      "start": 31167,
      "end": 31272,
      "text": " تَعِس مِسْطَحٌ! فقلت: غفَر اللَّهُ لك، أتقولين هذا لابنِك، ولصاحبِ رسولِ اللَّهِ - صلى الله عليه وسلم -؟",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 31185,
          "end": 31188,
          "span_id": "s355"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 31251,
          "end": 31269,
          "span_id": "s355"
        }
      ]
    },
    {
      "id": "s356",
      "start": 31272,
      "end": 31389,
      "text": " قالت ذلك مرَتين، وما شعَرتُ بالذي كان، فحُدِّثتُ فذهَب عنى الذي خرَجتُ له، حتى ما أجدُ منه شيئًا، ورجَعت على أبويَّ؛",
      "markers": []
    },
    {
      "id": "s357",
      "start": 31389,
      "end": 31420,
      "text": " أبى بكرٍ، وأمِّ رُومانَ، فقلت:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 31416,
          "end": 31419,
          "span_id": "s357"
        }
      ]
    },
    {
      "id": "s358",
      "start": 31420,
      "end": 31471,
      "text": " أما اتَّقَيْتُما اللَّهَ فيَّ، وما وصَلتما رَحِمى؟",
      "markers": []
    },
    {
      "id": "s359",
      "start": 31471,
      "end": 31617,
      "text": "! قال النبيُّ - صلى الله عليه وسلم - الذي قال، وتحدَّث الناسُ بالذي تحدَّثوا به، ولم تُعْلِمانِيه، فأُخْبِرَ رسولَ اللَّهِ - صلى الله عليه وسلم -؟",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 31487,
          "end": 31505,
          "span_id": "s359"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 31596,
          "end": 31614,
          "span_id": "s359"
        }
      ]
    },
    {
      "id": "s360",
      "start": 31617,
      "end": 31755,
      "text": "! قالت: أي بنيةُ، واللَّهِ لقلَّما أحبَّ رجلٌ امرأتَه قطُّ، إلا قالوا لها نحوَ الذي قالوا لك، أي بنيةُ، ارجِعى إلى بيتِك حتى نأتيَكِ فيه. ",
      "markers": []
    },
    {
      "id": "s361",
      "start": 31759,
      "end": 31794,
      "text": "فرجَعتُ وارتكَبني صالِبٌ من حُمَّى ",
      "markers": []
    },
    {
      "id": "s362",
      "start": 31874,
      "end": 31970,
      "text": "، فجاء أبواىَ فدخلا، وجاء رسولُ اللَّهِ - صلى الله عليه وسلم - حتى جلَس على سريري وِجاهى، فقالا:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 31916,
          "end": 31934,
          "span_id": "s362"
        }
      ]
    },
    {
      "id": "s363",
      "start": 31970,
      "end": 32104,
      "text": " أي بنيةُ، إن كنتِ صنَعتِ ما قال الناسُ، فاستغفِرى اللَّهَ، وإن لم تكوني صنَعتِه، فأخبِرى رسولَ اللَّهِ - صلى الله عليه وسلم - بعذرِك ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 32076,
          "end": 32094,
          "span_id": "s363"
        }
      ]
    },
    {
      "id": "s364",
      "start": 32118,
      "end": 32156,
      "text": ". قلت: ما أجدُ لى ولكم إلا كأبي يوسفَ:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 32120,
          "end": 32123,
          "span_id": "s364"
        }
      ]
    },
    {
      "id": "s365",
      "start": 32156,
      "end": 32221,
      "text": " {فَصَبْرٌ جَمِيلٌ وَاللَّهُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 32157,
          "end": 32220,
          "span_id": "s365"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 32221,
          "end": 32231,
          "text": "[يوسف: 18]",
          "via": "apparatus",
          "span_id": "s365"
        }
      ]
    },
    {
      "id": "s366",
      "start": 32231,
      "end": 32277,
      "text": ". قالت: فالتمَست اسمَ يعقوبَ، فما قدَرتُ - أو:",
      "markers": []
    },
    {
      "id": "s367",
      "start": 32277,
      "end": 32396,
      "text": " فلم أقدِرْ عليه - فشخَص بصرُ رسولُ اللَّهِ - صلى الله عليه وسلم - إلى السقفِ، وكان إذا نُزِّل عليه وَجَد قالَ اللَّهِ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 32323,
          "end": 32341,
          "span_id": "s367"
        }
      ]
    },
    {
      "id": "s368",
      "start": 32480,
      "end": 32527,
      "text": ": {إِنَّا سَنُلْقِي عَلَيْكَ قَوْلًا ثَقِيلًا} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 32482,
          "end": 32526,
          "span_id": "s368"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 32527,
          "end": 32538,
          "text": "[المزمل: 5]",
          "via": "apparatus",
          "span_id": "s368"
        }
      ]
    },
    {
      "id": "s369",
      "start": 32538,
      "end": 32655,
      "text": ". فوالذى هو أكرَمَه، وأنزَل عليه الكتابَ، ما زال يضحكُ - حتى إنى لأنظرُ إلى نواجذِه - سرورًا، ثم مسَح عن وجهِه، فقال:",
      "markers": []
    },
    {
      "id": "s370",
      "start": 32655,
      "end": 32703,
      "text": " \"يا عائشةُ، أبشرى، فقد أنزَل اللَّهُ عُذْرَكِ\".",
      "markers": []
    },
    {
      "id": "s371",
      "start": 32703,
      "end": 32779,
      "text": " قلت: بحمدِ اللَّهِ لا بحمدِك، ولا بحمدِ أصحابِك. قال اللَّهُ: {إِنَّ الَّذِ",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 32704,
          "end": 32707,
          "span_id": "s371"
        }
      ]
    },
    {
      "id": "s372",
      "start": 32783,
      "end": 32826,
      "text": "ينَ جَاءُوا بِالْإِفْكِ عُصْبَةٌ مِنْكُمْ}.",
      "markers": []
    },
    {
      "id": "s373",
      "start": 32826,
      "end": 32892,
      "text": " حتى بلَغ: {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 32837,
          "end": 32891,
          "span_id": "s373"
        }
      ]
    },
    {
      "id": "s374",
      "start": 32892,
      "end": 32917,
      "text": " وكان أبو بكرٍ حلَف ألّا ",
      "markers": []
    },
    {
      "id": "s375",
      "start": 32931,
      "end": 32932,
      "text": " ",
      "markers": []
    },
    {
      "id": "s376",
      "start": 32968,
      "end": 33012,
      "text": " بنافعةٍ، وكان بينَهما رَحِمٌ، فلما أُنزِلت:",
      "markers": []
    },
    {
      "id": "s377",
      "start": 33012,
      "end": 33056,
      "text": " {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 33013,
          "end": 33055,
          "span_id": "s377"
        }
      ]
    },
    {
      "id": "s378",
      "start": 33056,
      "end": 33095,
      "text": " حتى بلَغ: {وَاللَّهُ غَفُورٌ رَحِيمٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 33067,
          "end": 33094,
          "span_id": "s378"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 33095,
          "end": 33106,
          "text": "[النور: 22]",
          "via": "apparatus",
          "span_id": "s378"
        }
      ]
    },
    {
      "id": "s379",
      "start": 33106,
      "end": 33135,
      "text": ". قال أبو بكرٍ: بلى، أي ربِّ.",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 33112,
          "end": 33119,
          "span_id": "s379"
        }
      ]
    },
    {
      "id": "s380",
      "start": 33135,
      "end": 33206,
      "text": " فعاد إلى الذي كان المسطحٍ. {إِنَّ الَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 33163,
          "end": 33205,
          "span_id": "s380"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 33206,
          "end": 33217,
          "text": "[النور: 23]",
          "via": "apparatus",
          "span_id": "s380"
        }
      ]
    },
    {
      "id": "s381",
      "start": 33217,
      "end": 33307,
      "text": ". حتى بلَغ: {أُولَئِكَ مُبَرَّءُونَ مِمَّا يَقُولُونَ لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 33229,
          "end": 33306,
          "span_id": "s381"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 33307,
          "end": 33318,
          "text": "[النور: 26]",
          "via": "apparatus",
          "span_id": "s381"
        }
      ]
    },
    {
      "id": "s382",
      "start": 33318,
      "end": 33396,
      "text": ". قالت عائشةُ: واللَّهِ ما كنتُ أرجو أن ينزِلَ فيَّ كتابٌ، ولا أطمعُ به، ولكن ",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "SPEAKER",
          "start": 33325,
          "end": 33330,
          "span_id": "s382"
        }
      ]
    },
    {
      "id": "s383",
      "start": 33404,
      "end": 33405,
      "text": " ",
      "markers": []
    },
    {
      "id": "s384",
      "start": 33425,
      "end": 33503,
      "text": " أرجُو أن يرَى رسولُ اللَّهِ - صلى الله عليه وسلم - رؤيا تُذْهِبُ ما في نفسِه.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 33456,
          "end": 33474,
          "span_id": "s384"
        }
      ]
    },
    {
      "id": "s385",
      "start": 33503,
      "end": 33542,
      "text": " قالت: وسأَل الجاريةَ الحبَشيةَ، فقالت:",
      "markers": []
    },
    {
      "id": "s386",
      "start": 33542,
      "end": 33598,
      "text": " واللَّهِ لعائشةُ أطيبُ من طَيِّبِ الذهبِ، وما بها عيبٌ ",
      "markers": []
    },
    {
      "id": "s387",
      "start": 33617,
      "end": 33720,
      "text": "، إلا أنها ترقُدُ حتى تدخُلَ الشاةُ فتأكلَ عجينَها، ولئن كانت صنَعت ما قال الناسُ، ليخبرَنَّك اللَّهُ. ",
      "markers": []
    },
    {
      "id": "s388",
      "start": 33755,
      "end": 33756,
      "text": " ",
      "markers": []
    },
    {
      "id": "s389",
      "start": 33786,
      "end": 33797,
      "text": " من فهمِها ",
      "markers": []
    },
    {
      "id": "s390",
      "start": 33817,
      "end": 33819,
      "text": ". ",
      "markers": []
    }
  ],

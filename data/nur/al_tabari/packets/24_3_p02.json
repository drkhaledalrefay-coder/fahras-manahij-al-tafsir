    {
      "id": "M_SUNNAH",
      "name_ar": "السنة",
      "when": "قول أو فعل أو تقرير نبوي يبيّن معنى الآية أو فضلها المتصل بها.",
      "exclude": "ذكر النبي في إسناد أو سياق عابر فقط.",
      "markers": "قال رسول الله، أن النبي، رواه، أخرجه، حدثنا، ﷺ"
    },
    {

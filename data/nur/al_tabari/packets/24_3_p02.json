    },
    {
      "id": "s134",
      "start": 10249,
      "end": 10315,
      "text": "كريبٍ، قال: ثنا جابرُ بنُ نوحٍ، عن إسماعيلَ، عن الشعبيِّ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10281,
          "end": 10315,
          "stripped": "عن إسماعيل، عن الشعبي في قوله:",
          "span_id": "s134"
        },
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "SPEAKER",
          "start": 10297,
          "end": 10303,
          "span_id": "s134"
        }
      ]
    },
    {
      "id": "s135",
      "start": 10315,
      "end": 10432,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10316,
          "end": 10431,
          "span_id": "s135"
        }
      ]
    },
    {
      "id": "s136",
      "start": 10432,
      "end": 10481,
      "text": " قال: كنَّ نساءً يُكْرِين أنفسَهنَّ في الجاهليةِ ",
      "markers": []
    },
    {
      "id": "s137",
      "start": 10534,
      "end": 10641,
      "text": ".وقال آخرون: معنى ذلك: الزانى لا يزنِى إلَّا بزانيةٍ أو مشركةٍ، والزانيةُ لا يَزنِى بها إلَّا زان أو مشركٌ.",
      "markers": []
    },
    {
      "id": "s138",
      "start": 10641,
      "end": 10687,
      "text": " قالوا: ومعنى النكاحِ في هذا الموضعِ الجِماعُ.",
      "markers": []
    },
    {
      "id": "s139",
      "start": 10687,
      "end": 10721,
      "text": "ذكرُ مَن قال ذلكحدَّثنا هناد، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10703,
          "end": 10710,
          "span_id": "s139"
        }
      ]
    },
    {
      "id": "s140",
      "start": 10721,
      "end": 10788,
      "text": " ثنا أبو الأحوصِ، عن حُصينٍ، عن عكرمةَ، عن ابن عباسٍ في قولِ اللهِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10739,
          "end": 10780,
          "stripped": "عن حصين، عن عكرمة، عن ابن عباس في قول",
          "span_id": "s140"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 10753,
          "end": 10758,
          "span_id": "s140"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 10764,
          "end": 10772,
          "span_id": "s140"
        }
      ]
    },
    {
      "id": "s141",
      "start": 10788,
      "end": 10847,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10789,
          "end": 10846,
          "span_id": "s141"
        }
      ]
    },
    {
      "id": "s142",
      "start": 10847,
      "end": 10883,
      "text": " قال: لا يزنى إلا بزانيةٍ أو مشركةٍ ",
      "markers": []
    },
    {
      "id": "s143",
      "start": 11007,
      "end": 11058,
      "text": ".حدَّثنا ابن المثنى، قال: ثنا محمدُ بنُ جعفرٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11008,
          "end": 11015,
          "span_id": "s143"
        }
      ]
    },
    {
      "id": "s144",
      "start": 11058,
      "end": 11133,
      "text": " ثنا شعبةُ، عن يَعلَى بن مسلمٍ، عن سعيدِ بن جُبيرٍ أنَّه قال في هذه الآيةِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11070,
          "end": 11114,
          "stripped": "عن يعلى بن مسلم، عن سعيد بن جبير أنه",
          "span_id": "s144"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 11093,
          "end": 11107,
          "span_id": "s144"
        }
      ]
    },
    {
      "id": "s145",
      "start": 11133,
      "end": 11192,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11134,
          "end": 11191,
          "span_id": "s145"
        }
      ]
    },
    {
      "id": "s146",
      "start": 11192,
      "end": 11242,
      "text": " قال: لا يَزِني الزاني إلا بزانيةٍ مثله أو مشركةٍ ",
      "markers": []
    },
    {
      "id": "s147",
      "start": 11346,
      "end": 11394,
      "text": ".حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11347,
          "end": 11354,
          "span_id": "s147"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 11347,
          "end": 11394,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s147"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 11355,
          "end": 11360,
          "span_id": "s147"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 11368,
          "end": 11375,
          "span_id": "s147"
        }
      ]
    },
    {
      "id": "s148",
      "start": 11394,
      "end": 11462,
      "text": " أخبَرنا معمرٌ، عن ابن شُبرُمةَ، عن سعيدِ بن جُبيرٍ وعكرمةَ في قوله:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 11395,
          "end": 11402,
          "span_id": "s148"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11410,
          "end": 11452,
          "stripped": "عن ابن شبرمة، عن سعيد بن جبير وعكرمة",
          "span_id": "s148"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "NARRATOR",
          "start": 11430,
          "end": 11444,
          "span_id": "s148"
        }
      ]
    },
    {
      "id": "s149",
      "start": 11462,
      "end": 11538,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً}. قالا: هو الوطءُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11463,
          "end": 11520,
          "span_id": "s149"
        }
      ]
    },
    {
      "id": "s150",
      "start": 11563,
      "end": 11593,
      "text": ".حدَّثنا ابن عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11564,
          "end": 11571,
          "span_id": "s150"
        }
      ]
    },
    {
      "id": "s151",
      "start": 11593,
      "end": 11619,
      "text": " ثنا محمدٌ، عن معمرٍ، قال:",
      "markers": []
    },
    {
      "id": "s152",
      "start": 11619,
      "end": 11648,
      "text": " قال سعيدِ بن جُبيرٍ ومجاهدٌ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 11624,
          "end": 11638,
          "span_id": "s152"
        }
      ]
    },
    {
      "id": "s153",
      "start": 11648,
      "end": 11707,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11649,
          "end": 11706,
          "span_id": "s153"
        }
      ]
    },
    {
      "id": "s154",
      "start": 11707,
      "end": 11747,
      "text": " قالا: هو الوطءُ.حدَّثنا ابن وكيعٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11724,
          "end": 11731,
          "span_id": "s154"
        }
      ]
    },
    {
      "id": "s155",
      "start": 11747,
      "end": 11853,
      "text": " ثنا أبى، عن سَلَمةَ بن نُبيطٍ، عن الضحاكِ بن مزاحِمٍ وشعبةَ، عن يَعلَى بن مسلمٍ، عن سعيدِ بن جُبيرٍ قوله:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11757,
          "end": 11831,
          "stripped": "عن سلمة بن نبيط، عن الضحاك بن مزاحم وشعبة، عن يعلى بن مسلم، عن",
          "span_id": "s155"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "NARRATOR",
          "start": 11782,
          "end": 11788,
          "span_id": "s155"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "NARRATOR",
          "start": 11832,
          "end": 11846,
          "span_id": "s155"
        }
      ]
    },
    {
      "id": "s156",
      "start": 11853,
      "end": 11970,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11854,
          "end": 11969,
          "span_id": "s156"
        }
      ]
    },
    {
      "id": "s157",
      "start": 11970,
      "end": 12032,
      "text": " قالا: لا يَزنِي الزاني حين يَزني إلا بزانيةٍ مثلِه أو مشركةٍ.",
      "markers": []
    },
    {
      "id": "s158",
      "start": 12032,
      "end": 12065,
      "text": " قال: ولا تزنى مشركةٌ إلا بمثلها ",
      "markers": []
    },
    {
      "id": "s159",
      "start": 12177,
      "end": 12220,
      "text": ".حدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 12198,
          "end": 12205,
          "span_id": "s159"
        }
      ]
    },
    {
      "id": "s160",
      "start": 12220,
      "end": 12248,
      "text": " قال ابن زيدٍ في قولِ اللهِ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 12225,
          "end": 12232,
          "span_id": "s160"
        }
      ]
    },
    {
      "id": "s161",
      "start": 12248,
      "end": 12293,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَو",
      "markers": []
    },
    {
      "id": "s162",
      "start": 12297,
      "end": 12369,
      "text": "ْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ}.",
      "markers": []
    },
    {
      "id": "s163",
      "start": 12369,
      "end": 12496,
      "text": " قال: هؤلاءِ بغايا كنَّ في الجاهليةِ، والنكاحُ في كتابِ اللهِ الإصابةُ، لا يُصيبها إلَّا زانٍ أو مشركٌ، لا يُحرِّمُ الزنى، ولا ",
      "markers": []
    },
    {
      "id": "s164",
      "start": 12506,
      "end": 12507,
      "text": " ",
      "markers": []
    },
    {
      "id": "s165",
      "start": 12525,
      "end": 12541,
      "text": " إِلَّا مِثلَها ",
      "markers": []
    },
    {
      "id": "s166",
      "start": 12605,
      "end": 12632,
      "text": ".قال: وكان ابن عباسٍ يقولُ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 12616,
          "end": 12624,
          "span_id": "s166"
        }
      ]
    },
    {
      "id": "s167",
      "start": 12632,
      "end": 12687,
      "text": " بغايا كُنَّ في الجاهليةِ.حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s168",
      "start": 12687,
      "end": 12717,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى ",
      "markers": []
    },
    {
      "id": "s169",
      "start": 12831,
      "end": 12874,
      "text": "، عن قيسِ بن سعدٍ، عن سعيدِ بن جُبيرٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 12833,
          "end": 12874,
          "stripped": "عن قيس بن سعد، عن سعيد بن جبير، قال:",
          "span_id": "s169"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 12853,
          "end": 12867,
          "span_id": "s169"
        }
      ]
    },
    {
      "id": "s170",
      "start": 12874,
      "end": 12897,
      "text": " إذا زنَى بها فهو زانٍ.",
      "markers": []
    },
    {
      "id": "s171",
      "start": 12897,
      "end": 12937,
      "text": "حدَّثنا عليٌّ، قال: ثنا عبدُ اللهِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 12897,
          "end": 12904,
          "span_id": "s171"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 12905,
          "end": 12908,
          "span_id": "s171"
        }
      ]
    },
    {
      "id": "s172",
      "start": 12937,
      "end": 12979,
      "text": " ثنا معاويةُ، عن عليٍّ، عن ابن عباسٍ قوله:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 12951,
          "end": 12979,
          "stripped": "عن علي، عن ابن عباس قوله:",
          "span_id": "s172"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 12954,
          "end": 12957,
          "span_id": "s172"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 12964,
          "end": 12972,
          "span_id": "s172"
        }
      ]
    },
    {
      "id": "s173",
      "start": 12979,
      "end": 13038,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12980,
          "end": 13037,
          "span_id": "s173"
        }
      ]
    },
    {
      "id": "s174",
      "start": 13038,
      "end": 13109,
      "text": " قال: الزاني من أهلِ القبلةِ لا يزنِى إلا بزانيةٍ مثلِه أو مشركةٍ. قال ",
      "markers": []
    },
    {
      "id": "s175",
      "start": 13163,
      "end": 13263,
      "text": ": والزانيةُ من أهلِ القبلةِ لا تزنِى إلا بزانٍ مثلها من أهلِ القبلةِ، أو مشركٍ من غيرِ أهلِ القبلةِ.",
      "markers": []
    },
    {
      "id": "s176",
      "start": 13263,
      "end": 13312,
      "text": " ثم قال: {وَحُرِّمَ ذَلِكَ عَلَى الْمُؤْمِنِينَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13272,
          "end": 13311,
          "span_id": "s176"
        }
      ]
    },
    {
      "id": "s177",
      "start": 13463,
      "end": 13572,
      "text": ".وقال آخرونَ: كان هذا حكمَ اللهِ في كلِّ زانٍ وزانيةٍ، حتى نسَخه بقولِه: {وَأَنْكِحُوا الْأَيَامَى مِنْكُمْ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13536,
          "end": 13571,
          "span_id": "s177"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 13572,
          "end": 13583,
          "text": "[النور: 32]",
          "via": "apparatus",
          "span_id": "s177"
        }
      ]
    },
    {
      "id": "s178",
      "start": 13583,
      "end": 13629,
      "text": ". فأحلَّ نكاح كلِّ مسلمةٍ، وإنكاحَ كلِّ مسلمٍ.",
      "markers": []
    },
    {
      "id": "s179",
      "start": 13629,
      "end": 13665,
      "text": "ذكرُ مَن قال ذلكحدَّثني يعقوبُ، قال:",
      "markers": []
    },
    {
      "id": "s180",
      "start": 13665,
      "end": 13726,
      "text": " ثنا هشيمٌ، عن يحيى بن سعيدٍ، عن سعيدِ بن المسيَّبِ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 13677,
          "end": 13719,
          "stripped": "عن يحيى بن سعيد، عن سعيد بن المسيب في",
          "span_id": "s180"
        }
      ]
    },
    {
      "id": "s181",
      "start": 13726,
      "end": 13881,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ وَحُرِّمَ ذَلِكَ عَلَى الْمُؤْمِنِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13727,
          "end": 13880,
          "span_id": "s181"
        }
      ]
    },
    {
      "id": "s182",
      "start": 13881,
      "end": 13922,
      "text": " قال: يَروْن الآيةَ التي بعدَها نسَختْها:",
      "markers": []
    },
    {
      "id": "s183",
      "start": 13922,
      "end": 13992,
      "text": " {وَأَنْكِحُوا الْأَيَامَى مِنْكُمْ}. قال: فهنَّ من أيَامَى المسلمينَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13923,
          "end": 13958,
          "span_id": "s183"
        }
      ]
    },
    {
      "id": "s184",
      "start": 14262,
      "end": 14301,
      "text": ".حدَّثنا القاسمُ، قال ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 14263,
          "end": 14270,
          "span_id": "s184"
        }
      ]
    },
    {
      "id": "s185",
      "start": 14301,
      "end": 14341,
      "text": " ثنى حجاجٌ، عن ابن جُريجٍ، قال: أخبَرني ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 14316,
          "end": 14325,
          "span_id": "s185"
        }
      ]
    },
    {
      "id": "s186",
      "start": 14345,
      "end": 14383,
      "text": "يحيى بنُ سعيدٍ، عن سعيدِ بن المسيِّبِ:",
      "markers": []
    },
    {
      "id": "s187",
      "start": 14383,
      "end": 14500,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14384,
          "end": 14499,
          "span_id": "s187"
        }
      ]
    },
    {
      "id": "s188",
      "start": 14500,
      "end": 14563,
      "text": " قال: نسَختها التي بعدَها: {وَأَنْكِحُوا الْأَيَامَى مِنْكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14527,
          "end": 14562,
          "span_id": "s188"
        }
      ]
    },
    {
      "id": "s189",
      "start": 14563,
      "end": 14599,
      "text": " وقال: إنَّهنَّ من أيَامي المسلمينَ.",
      "markers": []
    },
    {
      "id": "s190",
      "start": 14599,
      "end": 14628,
      "text": "حدَّثنا ابن عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 14599,
          "end": 14606,
          "span_id": "s190"
        }
      ]
    },
    {
      "id": "s191",
      "start": 14628,
      "end": 14657,
      "text": " ثنا ابن ثورٍ، عن معمرٍ، قال:",
      "markers": []
    },
    {
      "id": "s192",
      "start": 14657,
      "end": 14696,
      "text": " وذُكِر عن يحيى، عن ابن المسيَّبِ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 14665,
          "end": 14696,
          "stripped": "عن يحيى، عن ابن المسيب، قال:",
          "span_id": "s192"
        }
      ]
    },
    {
      "id": "s193",
      "start": 14696,
      "end": 14762,
      "text": " نسَختها: {وَأَنْكِحُوا الْأَيَامَى مِنْكُمْ}.حدَّثنا الحسنُ، قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14706,
          "end": 14741,
          "span_id": "s193"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 14742,
          "end": 14749,
          "span_id": "s193"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 14750,
          "end": 14755,
          "span_id": "s193"
        }
      ]
    },
    {
      "id": "s194",
      "start": 14762,
      "end": 14858,
      "text": " أخبَرنا عبدُ الرزاقِ، قال: أخبَرنا معمرٌ، عن يحيى بن سعيدٍ، عن سعيدِ بن المسيَّبِ، قال: نسَخها ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 14763,
          "end": 14770,
          "span_id": "s194"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 14763,
          "end": 14812,
          "stripped": "أخبرنا عبد الرزاق، قال: أخبرنا معمر، عن يحيى",
          "span_id": "s194"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 14790,
          "end": 14797,
          "span_id": "s194"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 14805,
          "end": 14850,
          "stripped": "عن يحيى بن سعيد، عن سعيد بن المسيب، قال:",
          "span_id": "s194"
        }
      ]
    },
    {
      "id": "s195",
      "start": 14879,
      "end": 14914,
      "text": " قولُه: {وَأَنْكِحُوا الْأَيَامَى} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14887,
          "end": 14913,
          "span_id": "s195"
        }
      ]
    },
    {
      "id": "s196",
      "start": 14939,
      "end": 15010,
      "text": ".حدَّثني يونسُ، قال: أخبَرنا أنسُ بنُ عياضٍ، عن يحيى، قال: ذُكِر الزني ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 14960,
          "end": 14967,
          "span_id": "s196"
        }
      ]
    },
    {
      "id": "s197",
      "start": 15022,
      "end": 15105,
      "text": " عندَ سعيدِ بن المسيَبِ: {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 15047,
          "end": 15104,
          "span_id": "s197"
        }
      ]
    },
    {
      "id": "s198",
      "start": 15105,
      "end": 15157,
      "text": " قال: فسمِعتُه يقولُ: إنَّها قد نسَختها التي بعدَها.",
      "markers": []
    },
    {
      "id": "s199",
      "start": 15157,
      "end": 15192,
      "text": " ثم قرَأها سعيدٌ، قال: يقولُ اللهُ:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 15161,
          "end": 15165,
          "span_id": "s199"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأه",
          "start": 15161,
          "end": 15166,
          "span_id": "s199"
        }
      ]
    },
    {
      "id": "s200",
      "start": 15192,
      "end": 15251,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 15193,
          "end": 15250,
          "span_id": "s200"
        }
      ]
    },
    {
      "id": "s201",
      "start": 15251,
      "end": 15295,
      "text": " ثم يقولُ اللهُ: {وَأَنْكِحُوا الْأَيَامَى}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 15268,
          "end": 15294,
          "span_id": "s201"
        }
      ]
    },
    {
      "id": "s202",
      "start": 15295,
      "end": 15336,
      "text": " فهنَّ من أيَامى المسلمينَ.قال أبو جعفرٍ:",
      "markers": []
    },
    {
      "id": "s203",
      "start": 15336,
      "end": 15365,
      "text": " وأولى الأقوالِ في ذلك عندِى ",
      "markers": []
    },
    {
      "id": "s204",
      "start": 15369,
      "end": 15485,
      "text": "بالصوابِ قولُ مَن قال: عَنَى بالنكاحِ في هذا الموضعِ الوطءَ، وأنَّ الآيةَ نزَلت في البغايا المشركاتِ ذواتِ الراياتِ.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "نزلت في",
          "start": 15443,
          "end": 15451,
          "span_id": "s204"
        }
      ]
    },
    {
      "id": "s205",
      "start": 15485,
      "end": 15629,
      "text": " وذلك لقيامِ الحُجةِ على أنَّ الزانيةَ من المسلماتِ حرامٌ على كلِّ مشركٍ، وأنَّ الزانَى من المسلمينَ حرامٌ عليهِ كلُّ مشركةٍ من عبَدةِ الأوثانِ.",
      "markers": []
    },
    {
      "id": "s206",
      "start": 15629,
      "end": 15775,
      "text": " فمعلومٌ إذ كان ذلك كذلك، أنَّه لم يُعنَ بالآيةِ أنَّ الزانيَ من المؤمنينَ لا يعقِدُ عقدَ نكاحٍ على عفيفةٍ من المسلماتِ، ولا يَنكِحُ إلَّا زانيةً ",
      "markers": []
    },
    {
      "id": "s207",
      "start": 15800,
      "end": 15838,
      "text": " أو مشركةً. وإذ كان ذلك كذلك، فبيِّنٌ ",
      "markers": []
    },
    {
      "id": "s208",
      "start": 15855,
      "end": 15902,
      "text": " أنَّ معنى الآيةِ: الزانى لا يزنِى إلا بزانيةٍ ",
      "markers": []
    },
    {
      "id": "s209",
      "start": 15915,
      "end": 15916,
      "text": " ",
      "markers": []
    },
    {
      "id": "s210",
      "start": 15973,
      "end": 16049,
      "text": " الزنى، أو بمشركةٍ تستحِلُّه.وقوله: {وَحُرِّمَ ذَلِكَ عَلَى الْمُؤْمِنِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 16009,
          "end": 16048,
          "span_id": "s210"
        }
      ]
    },
    {
      "id": "s211",
      "start": 16049,
      "end": 16137,
      "text": " يقولُ: وحرِّم الزنى على المؤمنينَ باللهِ ورسولهِ، وذلك هو النكاحُ الذي قال جلَّ ثناؤُه:",
      "markers": []
    },
    {
      "id": "s212",
      "start": 16137,
      "end": 16181,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً}. ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 16138,
          "end": 16179,
          "span_id": "s212"
        }
      ]
    }
  ],

  "spans": [
    {
      "id": "s105",
      "start": 8201,
      "end": 8262,
      "text": "و، وأمُّ سُوَيْدٍ جاريةُ عمرِو بن عثمانَ المخزوميِّ، وسريفةُ ",
      "markers": []
    },
    {
      "id": "s106",
      "start": 8283,
      "end": 8406,
      "text": " جاريةُ زَمْعَةَ بن الأسودِ، وفرسةُ جاريةُ هشامِ بن ربيعةَ بن حبيبِ بن حذيفةَ بن جبلِ بن مالكِ بن عامرِ بن لُؤَيٍّ، وقريبا ",
      "markers": []
    },
    {
      "id": "s107",
      "start": 8454,
      "end": 8493,
      "text": " جاريةُ هلالِ بن أنسِ بن جابرِ بن نمرِ ",
      "markers": []
    },
    {
      "id": "s108",
      "start": 8524,
      "end": 8542,
      "text": " بن غالبِ بن فهرٍ ",
      "markers": []
    },
    {
      "id": "s109",
      "start": 8588,
      "end": 8645,
      "text": ".حدَّثنا محمدُ بنُ عبدِ الأعلى، قال: ثنا محمدُ بنُ ثورٍ، ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8589,
          "end": 8596,
          "span_id": "s109"
        }
      ]
    },
    {
      "id": "s110",
      "start": 8656,
      "end": 8657,
      "text": " ",
      "markers": []
    },
    {
      "id": "s111",
      "start": 8671,
      "end": 8707,
      "text": ".عن ابن أبي نجيحٍ، عن مجاهدٍ. وقاله ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 8672,
          "end": 8706,
          "stripped": "عن ابن أبي نجيح، عن مجاهد. وقاله",
          "span_id": "s111"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 8693,
          "end": 8698,
          "span_id": "s111"
        }
      ]
    },
    {
      "id": "s112",
      "start": 8734,
      "end": 8850,
      "text": " الزهريُّ وقتادةُ، قالوا: كان في الجاهليةِ بغايا معلومٌ ذلك منهنَّ، فأراد ناسٌ من المسلمينَ نكاحَهنَّ، فأنزَل اللهُ:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 8837,
          "end": 8843,
          "span_id": "s112"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 8837,
          "end": 8848,
          "span_id": "s112"
        }
      ]
    },
    {
      "id": "s113",
      "start": 8850,
      "end": 8973,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8851,
          "end": 8966,
          "span_id": "s113"
        }
      ]
    },
    {
      "id": "s114",
      "start": 8973,
      "end": 9020,
      "text": "حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8973,
          "end": 8980,
          "span_id": "s114"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 8973,
          "end": 9020,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s114"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 8981,
          "end": 8986,
          "span_id": "s114"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 8994,
          "end": 9001,
          "span_id": "s114"
        }
      ]
    },
    {
      "id": "s115",
      "start": 9020,
      "end": 9095,
      "text": " أخبَرنا معمرٌ، عن ابن أبي نجيحٍ، عن مجاهدٍ. وقاله الزهريُّ وقتادةُ، قالوا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 9021,
          "end": 9028,
          "span_id": "s115"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9036,
          "end": 9088,
          "stripped": "عن ابن أبي نجيح، عن مجاهد. وقاله الزهري وقتادة،",
          "span_id": "s115"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 9057,
          "end": 9062,
          "span_id": "s115"
        }
      ]
    },
    {
      "id": "s116",
      "start": 9124,
      "end": 9166,
      "text": ": كانوا في الجاهليةِ بغايا. ثم ذكَر نحوَه ",
      "markers": []
    },
    {
      "id": "s117",
      "start": 9195,
      "end": 9221,
      "text": ".حدَّثنا ابن عبدِ الأعلى، ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9196,
          "end": 9203,
          "span_id": "s117"
        }
      ]
    },
    {
      "id": "s118",
      "start": 9225,
      "end": 9296,
      "text": "قال: ثنا ابنَ ثورٍ، عن معمرٍ، عن ابن أبي نجيحٍ، القاسمِ بن أبى بَزَّةَ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9245,
          "end": 9279,
          "stripped": "عن معمر، عن ابن أبي نجيح، القاسم",
          "span_id": "s118"
        }
      ]
    },
    {
      "id": "s119",
      "start": 9296,
      "end": 9360,
      "text": " كان الرجلُ يَنكِحُ الزانيةَ في الجاهليةِ التي قد علِم ذلك منها؛",
      "markers": []
    },
    {
      "id": "s120",
      "start": 9360,
      "end": 9443,
      "text": " يتخِذُها مَأكلةً، فأراد ناسٌ من المسلمينَ نكاحَهنَّ على تلك الجهةِ، فنُهوا عن ذلك.",
      "markers": []
    },
    {
      "id": "s121",
      "start": 9443,
      "end": 9472,
      "text": "حدَّثنا الحسنُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9443,
          "end": 9450,
          "span_id": "s121"
        }
      ]
    },
    {
      "id": "s122",
      "start": 9472,
      "end": 9536,
      "text": " أخبَرنا عبد الرزاقِ، قال: أخبَرنا معمرٌ، عن ابن أبي نجيحٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 9473,
          "end": 9480,
          "span_id": "s122"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 9473,
          "end": 9520,
          "stripped": "أخبرنا عبد الرزاق، قال: أخبرنا معمر، عن ابن",
          "span_id": "s122"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 9499,
          "end": 9506,
          "span_id": "s122"
        }
      ]
    },
    {
      "id": "s123",
      "start": 9536,
      "end": 9577,
      "text": " قال القاسمُ بنُ أبي بزَّةَ. فذكَر نحوَه ",
      "markers": []
    },
    {
      "id": "s124",
      "start": 9602,
      "end": 9639,
      "text": ".حدَّثني يعقوبُ، قال: ثنا هشيمٌ، قال:",
      "markers": []
    },
    {
      "id": "s125",
      "start": 9639,
      "end": 9693,
      "text": " أخبَرنا سليمانُ التيميُّ، عن سعيدِ بن المسيَّبِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 9640,
          "end": 9647,
          "span_id": "s125"
        }
      ]
    },
    {
      "id": "s126",
      "start": 9693,
      "end": 9745,
      "text": " كنَّ نساءَ مواردَ بالمدينةِ.حدَّثنا أبو كريبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9722,
          "end": 9729,
          "span_id": "s126"
        }
      ]
    },
    {
      "id": "s127",
      "start": 9745,
      "end": 9823,
      "text": " ثنا ابن إدريسَ، قال: أخبَرنا عبدُ الملكِ بنُ أبى سليمانَ، عن سعيدِ بن جُبيرٍ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 9767,
          "end": 9774,
          "span_id": "s127"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "NARRATOR",
          "start": 9807,
          "end": 9821,
          "span_id": "s127"
        }
      ]
    },
    {
      "id": "s128",
      "start": 9852,
      "end": 9941,
      "text": "، أنَّ نساءً في الجاهليةِ كنَّ يُؤاجِرنَ أنفسَهنَّ، وكان الرجلُ أنَّما يَنكِحُ إحداهُنَّ؛",
      "markers": []
    },
    {
      "id": "s129",
      "start": 9941,
      "end": 9971,
      "text": " يريدُ أنْ يُصيب منها عَرَضًا ",
      "markers": []
    },
    {
      "id": "s130",
      "start": 9989,
      "end": 10012,
      "text": "، فنُهوا عن ذلك، ونزَل:",
      "markers": []
    },
    {
      "id": "s131",
      "start": 10012,
      "end": 10129,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",

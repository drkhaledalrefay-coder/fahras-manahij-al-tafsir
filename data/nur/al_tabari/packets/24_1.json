    {
      "id": "s002",
      "start": 5,
      "end": 90,
      "text": "تفسيرُ سورةِ النورِبِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِالقولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 78,
          "end": 89,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 90,
      "end": 195,
      "text": " {سُورَةٌ أَنْزَلْنَاهَا وَفَرَضْنَاهَا وَأَنْزَلْنَا فِيهَا آيَاتٍ بَيِّنَاتٍ لَعَلَّكُمْ تَذَكَّرُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 91,
          "end": 194,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 195,
      "end": 234,
      "text": "قال أبو جعفرٍ: يعني بقولِه تعالى ذكرُه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 216,
          "end": 227,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 234,
      "end": 283,
      "text": " {سُورَةٌ أَنْزَلْنَاهَا} وهذه السورةُ أنزَلناها.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 235,
          "end": 259,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 283,
      "end": 312,
      "text": "وإنَّما قلْنا: معني ذلك كذلك؛",
      "markers": []
    },
    {
      "id": "s007",
      "start": 312,
      "end": 386,
      "text": " لأنَّ العربَ لا تكادُ تبتدِئُ بالنكراتِ قبلَ أخبارِها إذا لم تكُن جوابًا؛",
      "markers": []
    },
    {
      "id": "s008",
      "start": 386,
      "end": 735,
      "text": " لأنَّها تُوصَلُ كما يُوصَلُ \"الذي\"، ثم يُخبرُ عنها بخبرٍ سوى الصلةِ، فيُستقبحُ الابتداءُ بها قبلَ الخبرِ إذا لم تكنْ موصولةً، إذ كان يصيرُ خبرُها إذا ابتُدِئَ بها كالصلةِ لها، ويصيرُ السامعُ خبرَها كالمتوقِّع خبرَها بعدُ، إذ كان الخبرُ عنها بعدَها كالصلةِ لها، وإذا ابتدِئَ بالخبرِ عنها قبلَها، لم يدخُلِ الشكُّ على سامعِ الكلامِ في مرادِ المتكلمِ.",
      "markers": []
    },
    {
      "id": "s009",
      "start": 735,
      "end": 839,
      "text": "وقد بيَّنا فيما مضى قبلُ أنَّ \"السورةَ\" وصفٌ لما ارتفَع، بشواهدِه، فأغنَى ذلك عن إعادتِه في هذا الموضعِ ",
      "markers": []
    },
    {
      "id": "s010",
      "start": 874,
      "end": 967,
      "text": ".وأمَّا قولُه: {وَفَرَضْنَاهَا}. فإنَّ القرأةَ اختلَفتْ في قراءتِه؛ فقرَأَتْهُ بعضُ قَرَأَةِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 889,
          "end": 905,
          "span_id": "s010"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 915,
          "end": 918,
          "span_id": "s010"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 943,
          "end": 947,
          "span_id": "s010"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 958,
          "end": 963,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 988,
      "end": 1023,
      "text": " الحجازِ والبصرةِ: (وَفَرَّضْناها) ",
      "markers": []
    },
    {
      "id": "s012",
      "start": 1078,
      "end": 1135,
      "text": ". ويتأوَّلُونَه: وفصَّلناها ونزَّلنا فيها فرائضَ مختلفةً.",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1135,
      "end": 1171,
      "text": " وكذلك كان مجاهدٌ يقرؤُه ويتأوَّلُه.",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1171,
      "end": 1200,
      "text": "حدَّثنى أحمدُ بنُ يوسفَ، قال:",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1200,
      "end": 1330,
      "text": " ثنا القاسمُ، قال: ثنا ابن مهديٍّ، عن عبدِ الوارثِ بن سعيدٍ، عن حميدٍ، عن مجاهدٍ أنَّه كان يقرؤُها: (وفرَّضْناها). يعنى بالتشديدِ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1235,
          "end": 1286,
          "stripped": "عن عبد الوارث بن سعيد، عن حميد، عن مجاهد أنه",
          "span_id": "s015"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 1274,
          "end": 1279,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1357,
      "end": 1387,
      "text": ".حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1387,
      "end": 1439,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى وحدَّثني الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1439,
      "end": 1513,
      "text": " ثنا الحسنُ، قال: ثنا ورقاءُ، جميعًا عن ابن أبي نجيحٍ، عن مجاهدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 1444,
          "end": 1449,
          "span_id": "s018"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1476,
          "end": 1513,
          "stripped": "عن ابن أبي نجيح، عن مجاهد في قوله:",
          "span_id": "s018"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 1497,
          "end": 1502,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 1513,
      "end": 1573,
      "text": " {وَفَرَضْنَاهَا}. قال: الأمرُ بالحلالِ، والنهىُ عن الحرامِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1514,
          "end": 1530,
          "span_id": "s019"
        }
      ]
    },
    {
      "id": "s020",
      "start": 1704,
      "end": 1744,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1705,
          "end": 1712,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 1744,
      "end": 1784,
      "text": " ثني حجاجٌ، عن ابن جُرَيجٍ مجاهدٍ مثلَه.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 1759,
          "end": 1769,
          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 1784,
      "end": 1826,
      "text": "وقد يَحتملُ ذلك إذا قُرئَ بالتشديدِ وجهًا ",
      "markers": []
    },
    {
      "id": "s023",
      "start": 1847,
      "end": 1907,
      "text": " غيرَ الذي ذكَرنا عن مجاهدٍ، وهو أنْ يوجَّهَ إلى أنَّ معناه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 1868,
          "end": 1873,
          "span_id": "s023"
        },
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 1901,
          "end": 1906,
          "span_id": "s023"
        }
      ]
    },
    {
      "id": "s024",
      "start": 1907,
      "end": 1970,
      "text": " وفرَّضْناها عليكم وعلى مَن بعدَكم من الناسِ إلى قيامِ الساعةِ.",
      "markers": []
    },
    {
      "id": "s025",
      "start": 1970,
      "end": 2052,
      "text": "وقرَأ ذلك عامةُ قرأَةِ المدينةِ والكوفةِ والشامِ: {وَفَرَضْنَاهَا} بتخفيفِ الراءِ ",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 1971,
          "end": 1975,
          "span_id": "s025"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 1986,
          "end": 1989,
          "span_id": "s025"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2020,
          "end": 2036,
          "span_id": "s025"
        }
      ]
    },
    {
      "id": "s026",
      "start": 2129,
      "end": 2205,
      "text": "، بمعنى: أوجَبنا ما فيها من الأحكامِ عليكم، وألزَمناكُموه، وبيَّنا ذلك لكُم.",
      "markers": []
    },
    {
      "id": "s027",
      "start": 2205,
      "end": 2337,
      "text": "والصوابُ من القولِ في ذلك أنَّهما قراءتانِ مشهورتانِ قد قرَأ بكلِّ واحدةٍ منهما علماءُ من القرأَةِ، فبأيَّتِهما قرَأ القارئُ فمصيبٌ؛",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 2261,
          "end": 2265,
          "span_id": "s027"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 2297,
          "end": 2300,
          "span_id": "s027"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 2317,
          "end": 2321,
          "span_id": "s027"
        }
      ]
    },
    {
      "id": "s028",
      "start": 2337,
      "end": 2473,
      "text": " وذلك أَنَّ الله قد فصَّلَها، وأنزَل فيها ضُروبًا من الأحكامِ، وأمَر فيها ونهَى، وفرَض على عبادِه فيها فرائضَ، ففيها المعنيانِ كِلاهُما؛",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2473,
      "end": 2524,
      "text": " التفريضُ، والفرضُ، فلذلك قلنا: بأيَّةِ القراءتينِ ",
      "markers": []
    },
    {
      "id": "s030",
      "start": 2538,
      "end": 2539,
      "text": " ",
      "markers": []
    },
    {
      "id": "s031",
      "start": 2553,
      "end": 2648,
      "text": " فمصيبٌ الصوابَ.ذكرُ مَن تأوَّل ذلك بمعنى الفَرْضِ والبيانِ من أهلِ التأويلِحدَّثني عليٌّ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 2637,
          "end": 2640,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2648,
      "end": 2750,
      "text": " ثنا أبو صالحٍ، قال: ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ في قوله: {وَفَرَضْنَاهَا}. يقولُ: بيَّنَّاها ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2682,
          "end": 2713,
          "stripped": "عن علي، عن ابن عباس في قوله:",
          "span_id": "s032"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 2685,
          "end": 2688,
          "span_id": "s032"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 2695,
          "end": 2703,
          "span_id": "s032"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2714,
          "end": 2730,
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 2871,
      "end": 2914,
      "text": ".حدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2892,
          "end": 2899,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 2914,
      "end": 2979,
      "text": " قال ابن زيدٍ في قولِه: {سُورَةٌ أَنْزَلْنَاهَا وَفَرَضْنَاهَا}. ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 2919,
          "end": 2926,
          "span_id": "s034"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2938,
          "end": 2977,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2995,
      "end": 2996,
      "text": " ",
      "markers": []
    },
    {
      "id": "s036",
      "start": 3013,
      "end": 3077,
      "text": " لهذا الذي يتلُوها مِمَّا فُرِض فيها. وقرَأ: {فِيهَا آيَاتٍ بَيّ",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 3052,
          "end": 3056,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 3081,
      "end": 3163,
      "text": "ِنَاتٍ لَعَلَّكُمْ تَذَكَّرُونَ}.وقولُه: {وَأَنْزَلْنَا فِيهَا آيَاتٍ بَيِّنَاتٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3122,
          "end": 3162,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 3163,
      "end": 3249,
      "text": " يقولُ تعالى ذكرُه: وأنزَلنا في هذه السورةِ علاماتٍ ودَلالاتٍ على الحقِّ {بَيِّنَاتٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3236,
          "end": 3248,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 3249,
      "end": 3395,
      "text": " يعنى: واضحاتٍ لَمَنْ تأمَّلها وفكَّر فيها بعقلٍ، أنَّها مِن عندِ اللهِ، فإنَّها الحقُّ المبينُ، وإنَّها تَهدِى إلى الصراطِ المستقيمِ.كما حدَّثنا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3387,
          "end": 3394,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3407,
      "end": 3439,
      "text": " القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3439,
      "end": 3500,
      "text": " ثني حجاجٌ، عن ابن جريجٍ: {وَأَنْزَلْنَا فِيهَا آيَاتٍ}. قال ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 3454,
          "end": 3462,
          "span_id": "s041"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3465,
          "end": 3494,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 3513,
      "end": 3514,
      "text": " ",
      "markers": []
    },
    {
      "id": "s043",
      "start": 3526,
      "end": 3554,
      "text": ": الحلالُ والحرامُ والحدودُ ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3614,
      "end": 3699,
      "text": ".{لَعَلَّكُمْ تَذَكَّرُونَ}. يقولُ: لتتذكَّروا بهذه الآياتِ البيناتِ التي أنزَلناها. ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3615,
          "end": 3641,
          "span_id": "s044"
        }
      ]
    }

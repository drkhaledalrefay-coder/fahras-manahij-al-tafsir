  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 33,
      "text": " القولُ في تأويلِ قوله تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 32,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 33,
      "end": 280,
      "text": " {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ أَنْ يُؤْتُوا أُولِي الْقُرْبَى وَالْمَسَاكِينَ وَالْمُهَاجِرِينَ فِي سَبِيلِ اللَّهِ وَلْيَعْفُوا وَلْيَصْفَحُوا أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ (22)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 34,
          "end": 279,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 280,
      "end": 386,
      "text": "يقولُ تعالى ذِكرُه: ولا يحلفْ باللَّهِ ذَوُو الفضلِ منكم، يعنى ذَوى التفضلِ، {وَالسَّعَةِ}. يقولُ: وذَوُو ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 357,
          "end": 370,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 418,
      "end": 463,
      "text": " الجِدَةِ.واختلَفت القرَأَةُ في قراءةِ قولِه:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 439,
          "end": 443,
          "span_id": "s004"
        },
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 450,
          "end": 455,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 463,
      "end": 510,
      "text": " {وَلَا يَأْتَلِ}؛ فقرأته عامةُ قرأةِ الأمصارِ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 464,
          "end": 480,
          "span_id": "s005"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 483,
          "end": 486,
          "span_id": "s005"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 495,
          "end": 498,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 510,
      "end": 638,
      "text": " {وَلَا يَأْتَلِ} بمعنى \"يفتعل\"، من الأَلِيَّةِ، وهى القسمُ باللهِ، سوى أبي جعفرٍ وزيدِ بن أسلمَ، فإنه ذُكر عنهما أنهما قرأ ذلك:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 511,
          "end": 527,
          "span_id": "s006"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 630,
          "end": 633,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 638,
      "end": 685,
      "text": " (ولَا يتَألَّ) بمعنى: \"يتفعل\"، من الأَلِيَّةِ ",
      "markers": []
    },
    {
      "id": "s008",
      "start": 771,
      "end": 824,
      "text": ".والصوابُ مِن القراءةِ في ذلك عندِى قراءةُ مَن قرَأَ:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 787,
          "end": 792,
          "span_id": "s008"
        },
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 807,
          "end": 812,
          "span_id": "s008"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 818,
          "end": 822,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 824,
      "end": 947,
      "text": " {وَلَا يَأْتَلِ} بمعنى: \"يفتعل\"، من الأَلِيَّةِ، وذلك أن ذلك في خطِّ المصحفِ كذلك، والقراءةُ الأُخرى مخالفةٌ خطَّ المصحفِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 825,
          "end": 841,
          "span_id": "s009"
        },
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 911,
          "end": 916,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 977,
      "end": 1028,
      "text": "، فاتباعُ المصحفِ مع قراءةِ جماعةِ القرأةِ وصحّةِ ا",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 998,
          "end": 1003,
          "span_id": "s010"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 1014,
          "end": 1017,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 1032,
      "end": 1070,
      "text": "لمقروءِ به، أولَى مِن خلافِ ذلك كلِّه ",
      "markers": []
    },
    {
      "id": "s012",
      "start": 1248,
      "end": 1359,
      "text": ".وإنما عُنِى بذلك أبو بكرٍ الصدِّيقُ رضِى اللهُ عنه في حَلِفِه باللهِ لا يُنفقُ على مِسْطَحٍ، فقال جلَّ ثناؤُه:",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1359,
      "end": 1540,
      "text": " ولا يَحلفْ مَن كان ذا فضلٍ مِن مالٍ وسَعَةٍ منكم، أيُّها المؤمنون باللهِ، أَلَّا يُعْطُوا ذَوِى قَرابتِهم، فيصِلوا به أرحامَهم، كمِسْطحٍ، وهو ابن خالةِ أبي بكرٍ، {وَالْمَسَاكِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1522,
          "end": 1539,
          "span_id": "s013"
        }
      ]
    },
    {
      "id": "s014",
      "start": 1540,
      "end": 1588,
      "text": " يقولُ: وذوى خَلَّةِ الحاجةِ. وكان مِسْطحٌ منهم؛",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1588,
      "end": 1677,
      "text": " لأنه كان فقيرًا محتاجًا، {وَالْمُهَاجِرِينَ فِي سَبِيلِ اللَّهِ}، وهم الذين هاجروا مِنْ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1614,
          "end": 1653,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1704,
      "end": 1765,
      "text": " ديارِهم وأموالِهم في جهادِ أعداءِ اللهِ، وكان مِسْطَحٌ منهم؛",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1765,
      "end": 1876,
      "text": " لأنَّه كان ممن هاجَر مِن مكةَ إلى المدينةِ، وشهِد مع رسولِ اللهِ - صلى الله عليه وسلم - بدرًا، {وَلْيَعْفُوا}.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1833,
          "end": 1851,
          "span_id": "s017"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1861,
          "end": 1875,
          "span_id": "s017"
        }
      ]
    },
    {
      "id": "s018",
      "start": 1876,
      "end": 2049,
      "text": " يقولُ: وليعفُوا عمَّا كان منهم إليهم من جُرمٍ، وذلك كجرمِ مِسْطحٍ إلى أبي بكرٍ، في إشاعتِه على ابنتِه عائشةَ ما أشاع مِن الإفكِ، {وَلْيَصْفَحُوا}. يقولُ: وليتركوا عقوبتَهم ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2006,
          "end": 2022,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 2083,
      "end": 2245,
      "text": " على ذلك، بحرمانِهم ما كانوا يؤتونَهم قبلَ ذلك، ولكن ليعودوا لهم إلى مثلِ الذي كانوا لهم عليه مِن الإفضالِ عليهم، {أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2197,
          "end": 2244,
          "span_id": "s019"
        }
      ]
    },
    {
      "id": "s020",
      "start": 2245,
      "end": 2525,
      "text": " يقولُ: ألا تحبُّون أن يستُرَ اللهُ عليكم ذنوبَكم، بإفضالِكم عليهم، فيتركَ عقوبتَكم عليها، {وَاللَّهُ غَفُورٌ} لذنوبِ مَن أطاعَه، واتبعَ أمرَه، {رَحِيمٌ} بهم أن يعذِّبَهم مع اتباعِهم أمرَه، وطاعتِهم إياه على ما كان لهم مِن زَلَّةٍ وهفوةٍ، قد استغفروه منها، وتابوا إليه مِن فعلِها.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2336,
          "end": 2355,
          "span_id": "s020"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2389,
          "end": 2398,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 2525,
      "end": 2569,
      "text": "وبنحوِ الذي قُلْنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s022",
      "start": 2569,
      "end": 2610,
      "text": "ذِكرُ مَن قال ذلكحدَّثنا ابن حُميدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2586,
          "end": 2593,
          "span_id": "s022"
        }
      ]
    },
    {
      "id": "s023",
      "start": 2610,
      "end": 2685,
      "text": " ثنا سلمةُ، عن ابن إسحاقَ، عن الزهريِّ، عن علْقمةَ بن وَقَّاصِ الليثيِّ، و ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2622,
          "end": 2682,
          "stripped": "عن ابن إسحاق، عن الزهري، عن علقمة بن وقاص الليثي،",
          "span_id": "s023"
        }
      ]
    },
    {
      "id": "s024",
      "start": 2715,
      "end": 2741,
      "text": " عن سعيدِ بن المسيَّبِ، و ",
      "markers": []
    },
    {
      "id": "s025",
      "start": 2764,
      "end": 2838,
      "text": " عن عروةَ بن الزبيرِ، وعن عبيدِ اللهِ بن عبدِ اللَّهِ بن عتبةَ، عن عائشةَ.",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 2831,
          "end": 2836,
          "span_id": "s025"
        }
      ]
    },
    {
      "id": "s026",
      "start": 2838,
      "end": 2865,
      "text": " قال: وثنى ابن إسحاقَ، قال:",
      "markers": []
    },
    {
      "id": "s027",
      "start": 2865,
      "end": 2931,
      "text": " ثنا يحيى بنُ عبادِ بن عبدِ الله بن الزُّبيرِ، عن أبيه، عن عائشةَ.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2912,
          "end": 2931,
          "stripped": "عن أبيه، عن عائشة.",
          "span_id": "s027"
        },
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 2924,
          "end": 2929,
          "span_id": "s027"
        }
      ]
    },
    {
      "id": "s028",
      "start": 2931,
      "end": 2958,
      "text": " قال: وثنى ابن إسحاقَ، قال:",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2958,
      "end": 3077,
      "text": " ثني عبدُ اللهِ بنُ أبى بكرِ بن محمدِ بن عمرِو بن حزمٍ الأنصاريُّ، عن عمرةَ بنتِ عبدِ الرحمنِ، عن عائشةَ، قالت: لما نزَ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3025,
          "end": 3077,
          "stripped": "عن عمرة بنت عبد الرحمن، عن عائشة، قالت: لما نز",
          "span_id": "s029"
        },
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 3056,
          "end": 3061,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 3081,
      "end": 3102,
      "text": "ل هذا - يَعْنى قولَه:",
      "markers": []
    },
    {
      "id": "s031",
      "start": 3102,
      "end": 3245,
      "text": " {إِنَّ الَّذِينَ جَاءُوا بِالْإِفْكِ عُصْبَةٌ مِنْكُمْ} في عائشةَ وفى من قال لها ما قال - قال أبو بكرٍ، وكان ينفقُ على مسطحٍ لقرابتِه وحاجتِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3103,
          "end": 3158,
          "span_id": "s031"
        },
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 3197,
          "end": 3204,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 3245,
      "end": 3308,
      "text": " واللهِ لا أنفقُ على مسطحٍ شيئًا أبدًا، ولا أنفعُه بنفعٍ أبدًا.",
      "markers": []
    },
    {
      "id": "s033",
      "start": 3308,
      "end": 3352,
      "text": " بعدَ الذي قال لعائشةَ ما قال، وأدخَل عليها ",
      "markers": []
    },
    {
      "id": "s034",
      "start": 3354,
      "end": 3391,
      "text": " ما أدخَل. قالت: فأنزَل اللهُ في ذلك:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 3371,
          "end": 3377,
          "span_id": "s034"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 3371,
          "end": 3382,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 3391,
      "end": 3453,
      "text": " {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3392,
          "end": 3446,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 3453,
      "end": 3513,
      "text": " قالت: فقال أبو بكرٍ: واللهِ إنِّي لأحبُّ أن يغفرَ اللهُ لى.",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 3465,
          "end": 3472,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 3513,
      "end": 3568,
      "text": " فرجَع إلى مِسْطَحٍ نفقتَه التي كان يُنفِقُ عليه، وقال:",
      "markers": []
    },
    {
      "id": "s038",
      "start": 3568,
      "end": 3598,
      "text": " واللهِ لا أنزِعُها منه أبدًا ",
      "markers": []
    },
    {
      "id": "s039",
      "start": 3631,
      "end": 3670,
      "text": "حدَّثني عليٌّ، قال ثنا عبدُ اللهِ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 3639,
          "end": 3642,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3670,
      "end": 3713,
      "text": " ثنى معاويةُ، عن عليٍّ، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3684,
          "end": 3713,
          "stripped": "عن علي، عن ابن عباس قوله:",
          "span_id": "s040"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 3687,
          "end": 3690,
          "span_id": "s040"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 3697,
          "end": 3705,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 3713,
      "end": 3769,
      "text": " {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3714,
          "end": 3768,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 3769,
      "end": 3809,
      "text": " يقول: لا تُقْسِموا أَلَّا تنفعوا أحدًا ",
      "markers": []
    },
    {
      "id": "s043",
      "start": 3920,
      "end": 3946,
      "text": ".حدَّثني محمد بن سعد، قال:",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3946,
      "end": 3976,
      "text": " ثنى أبي، قال: ثني عمِّي، قال:",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3976,
      "end": 4018,
      "text": " ثنى أبي، عن أبيه، عن أبيه ابن عباسٍ قوله:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3986,
          "end": 4018,
          "stripped": "عن أبيه، عن أبيه ابن عباس قوله:",
          "span_id": "s045"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 4003,
          "end": 4011,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 4018,
      "end": 4101,
      "text": " {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ} إلى آخرِ الآية. قال: كان نا",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4019,
          "end": 4073,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 4105,
      "end": 4309,
      "text": "سٌ مِن أصحابِ رسولِ اللهِ صلى الله عليه وسلم قد رَمَوْا عائشةَ بالقبيحِ، وأفشَوا ذلك، وتكلَّمُوا به، فأقسَم ناسٌ مِن أصحابِ رسولِ اللهِ - صلى الله عليه وسلم -، فيهم أبو بكرٍ، ألا يتصدَّقَ على رجلٍ تكلَّم ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4131,
          "end": 4149,
          "span_id": "s047"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4243,
          "end": 4261,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 4335,
      "end": 4366,
      "text": " بشيءٍ مِن هذا ولا يصلَه، فقال:",
      "markers": []
    },
    {
      "id": "s049",
      "start": 4366,
      "end": 4524,
      "text": " لا يُقْسِمُ أولو الفضلِ منكم والسعةِ أن يصِلوا أرحامَهم، وأن يُعطوهم مِن أموالِهم كالذي كانوا يفعلون قبلَ ذلك، فأمَر اللهُ أن يُغْفَرَ لهم، وأن يُعْفَى عنهم ",
      "markers": []
    },
    {
      "id": "s050",
      "start": 4630,
      "end": 4680,
      "text": ".حُدِّثتُ عن الحسينِ، قال: سمِعتُ أبا معاذٍ يقولُ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 4668,
          "end": 4672,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 4680,
      "end": 4730,
      "text": " أخبَرنا عبيدٌ، قال: سمعتُ الضحاكَ يقولُ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4681,
          "end": 4688,
          "span_id": "s051"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 4707,
          "end": 4713,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4730,
      "end": 4786,
      "text": " {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4731,
          "end": 4785,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 4786,
      "end": 4874,
      "text": " لما أنزَل اللهُ تعالى ذِكرُه عذرَ عائشةَ مِن السماءِ، قال أبو بكرٍ وآخرون مِن المسلمين:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 4845,
          "end": 4852,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4874,
      "end": 4911,
      "text": " والله لا نَصِلُ رجلًا منهم تَكَلَّم ",
      "markers": []
    },
    {
      "id": "s055",
      "start": 4931,
      "end": 4965,
      "text": " بشيءٍ من شأنِ عائشةَ، ولا ننفعُه.",
      "markers": []
    },
    {
      "id": "s056",
      "start": 4965,
      "end": 5052,
      "text": " فأنزل اللهُ: {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ}. يقولُ: ولا يحلفْ ",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 4966,
          "end": 4971,
          "span_id": "s056"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 4966,
          "end": 4976,
          "span_id": "s056"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4979,
          "end": 5033,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 5082,
      "end": 5126,
      "text": ".حدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال: ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 5103,
          "end": 5110,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 5130,
      "end": 5152,
      "text": "قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 5134,
          "end": 5141,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 5152,
      "end": 5240,
      "text": " {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ أَنْ يُؤْتُوا أُولِي الْقُرْبَى}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5153,
          "end": 5239,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 5240,
      "end": 5288,
      "text": " قال: كان مِسْطَحٌ ذا قرابةٍ، {وَالْمَسَاكِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5270,
          "end": 5287,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 5288,
      "end": 5363,
      "text": " قال: كان مسكينًا، {وَالْمُهَاجِرِينَ فِي سَبِيلِ اللَّهِ}: كان بَدْرِيًّا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5307,
          "end": 5346,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 5385,
      "end": 5415,
      "text": ".حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s063",
      "start": 5415,
      "end": 5468,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، وحدَّثني الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s064",
      "start": 5468,
      "end": 5539,
      "text": " ثنا الحسنُ، قال: ثنا ورقاءُ، جميعًا عن ابن أبي نجيحٍ، عن مجاهدٍ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 5473,
          "end": 5478,
          "span_id": "s064"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5505,
          "end": 5539,
          "stripped": "عن ابن أبي نجيح، عن مجاهد قوله:",
          "span_id": "s064"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 5526,
          "end": 5531,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 5539,
      "end": 5595,
      "text": " {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5540,
          "end": 5594,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 5595,
      "end": 5688,
      "text": " قال: أبو بكرٍ حلَف ألَّا ينفَعَ يتيمًا في حَجْرِه، كان أشاعَ ذلك، فلما نزلتْ هذه الآيةُ قال:",
      "markers": []
    },
    {
      "id": "s067",
      "start": 5688,
      "end": 5761,
      "text": " بلى أنا أحبُّ أن يغفرَ اللهُ لى، فلأكونَنَّ ليتيمى خيرَ ما كنتُ له قطُّ ",
      "markers": []
    },
    {
      "id": "s068",
      "start": 5872,
      "end": 5874,
      "text": ". ",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [

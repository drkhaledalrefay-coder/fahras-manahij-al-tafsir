    {
      "id": "s124",
      "start": 8911,
      "end": 8994,
      "text": " ثنى معاويةُ، عن عليٍّ، عن ابن عباسٍ قولَه: {كَمِشْكَاةٍ}. يقولُ: موضعُ الفَتِيلةِ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",

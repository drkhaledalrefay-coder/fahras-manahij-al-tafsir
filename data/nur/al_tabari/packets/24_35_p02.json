        },
        {
          "family": "SAHABA",
          "marker": "أبي بن كعب",
          "name": "أبي بن كعب",
          "role": "SPEAKER",
          "start": 9574,
          "end": 9586,
          "span_id": "s133"
        }
      ]
    },
    {
      "id": "s134",
      "start": 9588,
      "end": 9635,
      "text": " {مَثَلُ نُورِهِ كَمِشْكَاةٍ فِيهَا مِصْبَاحٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9589,
          "end": 9634,
          "span_id": "s134"
        }
      ]
    },
    {
      "id": "s135",
      "start": 9635,
      "end": 9705,
      "text": " قال: مثَلُ المؤمنِ قد جُعِل الإيمان والقرآنُ في صدرِه، {كَمِشْكَاةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9691,
          "end": 9704,
          "span_id": "s135"
        }
      ]
    },
    {
      "id": "s136",
      "start": 9705,
      "end": 9746,
      "text": " قال: المشكاةُ صدرُه، {فِيهَا مِصْبَاحٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9727,
          "end": 9745,
          "span_id": "s136"
        }
      ]
    },
    {
      "id": "s137",
      "start": 9746,
      "end": 9830,
      "text": " قال: والمصباحُ القرآنُ والإيمانُ الذي جُعِل في صدرِه، {الْمِصْبَاحُ فِي زُجَاجَةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9801,
          "end": 9829,
          "span_id": "s137"
        }
      ]
    },
    {
      "id": "s138",
      "start": 9830,
      "end": 9904,
      "text": " قال: والزجاجةُ قلبُه، {الزُّجَاجَةُ كَأَنَّهَا كَوْكَبٌ دُرِّيٌّ يُوقَد}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9853,
          "end": 9903,
          "span_id": "s138"
        }
      ]
    },
    {
      "id": "s139",
      "start": 9904,
      "end": 9974,
      "text": " قال: فمثلُه مما استنار فيه القرآن والإيمانُ كأنه {كَوْكَبٌ دُرِّيٌّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9954,
          "end": 9973,
          "span_id": "s139"
        }
      ]
    },
    {
      "id": "s140",
      "start": 9974,
      "end": 10063,
      "text": " يقولُ: مُضِيءٌ، {يُوقَدُ مِنْ شَجَرَةٍ مُبَارَكَةٍ} والشجرةُ المباركةُ أصلُه، المباركةُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9991,
          "end": 10026,
          "span_id": "s140"
        }
      ]
    },
    {
      "id": "s141",
      "start": 10063,
      "end": 10142,
      "text": " الإخلاص للهِ وحدَه وعبادتُه، لا شريكَ له، {لَا شَرْقِيَّةٍ وَلَا غَرْبِيَّةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10106,
          "end": 10141,
          "span_id": "s141"
        }
      ]
    },
    {
      "id": "s142",
      "start": 10142,
      "end": 10244,
      "text": " قال: فمثلُه مثلُ شجرةٍ الْتَفَّ بها الشجرُ، فهي خضراءُ ناعمةٌ، لا تُصِيبُها الشمسُ على أيِّ حالٍ كانت",
      "markers": []
    },
    {
      "id": "s143",
      "start": 10248,
      "end": 10375,
      "text": "، لا إذا طلَعَت، ولا إذا غرَبَت، وكذلك هذا المؤمنُ، قد أُجِير من أن يُصِيبَه شيءٌ مِن الغِيَرِ - وقد ابْتُلى بها - فيُثَبِّتُه ",
      "markers": []
    },
    {
      "id": "s144",
      "start": 10396,
      "end": 10430,
      "text": " اللهُ فيها، فهو بينَ أربعِ خلالٍ؛",
      "markers": []
    },
    {
      "id": "s145",
      "start": 10430,
      "end": 10562,
      "text": " إن أُعْطِى شكَر، وإن ابْتُلِى صبَر، وإن حكَم عدَل، وإن قال صدَق، فهو في سائرِ الناسِ كالرجلِ الحيِّ يَمْشِى في قبورِ الأمواتِ، قال:",
      "markers": []
    },
    {
      "id": "s146",
      "start": 10562,
      "end": 10618,
      "text": " {نُورٌ عَلَى نُورٍ} فهو يَتَقَلَّبُ في خمسةٍ من النورِ؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10563,
          "end": 10582,
          "span_id": "s146"
        }
      ]
    },
    {
      "id": "s147",
      "start": 10618,
      "end": 10717,
      "text": " فكلامُه نورٌ، وعملُه نورٌ، ومَدْخَلُه نورٌ، ومَخْرَجُه نورٌ، ومصيرُه إلى النورِ يومَ القيامةِ إلى ",
      "markers": []
    },
    {
      "id": "s148",
      "start": 10730,
      "end": 10738,
      "text": " الجنةِ ",
      "markers": []
    },
    {
      "id": "s149",
      "start": 10864,
      "end": 10904,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10865,
          "end": 10872,
          "span_id": "s149"
        }
      ]
    },
    {
      "id": "s150",
      "start": 10904,
      "end": 11011,
      "text": " ثني يحيَى بنُ اليَمانِ، عن أبي جعفرٍ الرازيِّ، عن الربيعِ بن أنسٍ، عن أبي العاليةِ، عن أبيِّ بن كعبٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10929,
          "end": 10974,
          "stripped": "عن أبي جعفر الرازي، عن الربيع بن أنس، عن",
          "span_id": "s150"
        },
        {
          "family": "TABIIN",
          "marker": "الربيع",
          "name": "الربيع",
          "role": "NARRATOR",
          "start": 10955,
          "end": 10961,
          "span_id": "s150"
        },
        {
          "family": "SAHABA",
          "marker": "أنس",
          "name": "أنس",
          "role": "NARRATOR",
          "start": 10966,
          "end": 10969,
          "span_id": "s150"
        },
        {
          "family": "SAHABA",
          "marker": "أبي بن كعب",
          "name": "أبي بن كعب",
          "role": "SPEAKER",
          "start": 10992,
          "end": 11004,
          "span_id": "s150"
        }
      ]
    },
    {
      "id": "s151",
      "start": 11011,
      "end": 11053,
      "text": " المشكاةُ صدرُ المؤمن، {فِيهَا مِصْبَاحٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11034,
          "end": 11052,
          "span_id": "s151"
        }
      ]
    },
    {
      "id": "s152",
      "start": 11053,
      "end": 11089,
      "text": " قال: القرآنُ.قال: ثنا الحسينُ، قال:",
      "markers": []
    },
    {
      "id": "s153",
      "start": 11089,
      "end": 11200,
      "text": " ثني حجاجٌ، عن أبي جعفرٍ، عن الربيعِ، عن أبي العاليةِ، عن أبيِّ بن كعبٍ نحوَ حديثِ عبدِ الأعلى، عن عبيدِ اللهِ.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11101,
          "end": 11150,
          "stripped": "عن أبي جعفر، عن الربيع، عن أبي العالية، عن أبي",
          "span_id": "s153"
        },
        {
          "family": "TABIIN",
          "marker": "الربيع",
          "name": "الربيع",
          "role": "NARRATOR",
          "start": 11118,
          "end": 11124,
          "span_id": "s153"
        },
        {
          "family": "SAHABA",
          "marker": "أبي بن كعب",
          "name": "أبي بن كعب",
          "role": "NARRATOR",
          "start": 11147,
          "end": 11159,
          "span_id": "s153"
        }
      ]
    },
    {
      "id": "s154",
      "start": 11200,
      "end": 11239,
      "text": "حدَّثني عليٌّ، قال: ثنا أبو صالحٍ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 11208,
          "end": 11211,
          "span_id": "s154"
        }
      ]
    },
    {
      "id": "s155",
      "start": 11239,
      "end": 11268,
      "text": " ثني معاويةُ، عن عليٍّ، عن اب",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11253,
          "end": 11268,
          "stripped": "عن علي، عن اب",
          "span_id": "s155"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 11256,
          "end": 11259,
          "span_id": "s155"
        }
      ]
    },
    {
      "id": "s156",
      "start": 11272,
      "end": 11310,
      "text": "ن عباسٍ: {مَثَلُ نُورِهِ كَمِشْكَاةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11281,
          "end": 11309,
          "span_id": "s156"
        }
      ]
    },
    {
      "id": "s157",
      "start": 11310,
      "end": 11443,
      "text": " قال: مثلُ هُداه في قلبِ المؤمنِ، كما يَكادُ الزيتُ الصافى يُضِيءُ قبلَ أَن تَمَسَّه النارُ، فإذا مسَّته النارُ ازداد ضوءًا على ضوئه ",
      "markers": []
    },
    {
      "id": "s158",
      "start": 11462,
      "end": 11673,
      "text": "، كذلك يكونُ قلبُ المؤمنِ، يَعْمَلُ بالهُدى قبلَ أن يَأْتِيَه العلمُ، فإذا جاءه العلمُ ازْداد هُدًى على هُدًى، ونورًا على نورٍ، كما قال إبراهيمُ صلواتُ اللهِ عليه قبلَ أن تَجِيئَه المعرفةُ: {قَالَ هَذَا رَبِّي} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11652,
          "end": 11672,
          "span_id": "s158"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 11673,
          "end": 11686,
          "text": "[الأنعام: 76]",
          "via": "apparatus",
          "span_id": "s158"
        }
      ]
    },
    {
      "id": "s159",
      "start": 11686,
      "end": 11798,
      "text": ". حينَ رأَى الكوكبَ، مِن غيرِ أن يُخْبِرَه أحدٌ أن له ربًّا، فلما أخبَره اللهُ أنه ربُّه، ازداد هُدًى على هُدًى ",
      "markers": []
    },
    {
      "id": "s160",
      "start": 11858,
      "end": 11887,
      "text": ".حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s161",
      "start": 11887,
      "end": 11915,
      "text": " ثنى أبى، قال: ثنى عمى، قال:",
      "markers": []
    },
    {
      "id": "s162",
      "start": 11915,
      "end": 11953,
      "text": " ثنى أبى، عن أبيه، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11925,
          "end": 11953,
          "stripped": "عن أبيه، عن ابن عباس قوله:",
          "span_id": "s162"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 11937,
          "end": 11945,
          "span_id": "s162"
        }
      ]
    },
    {
      "id": "s163",
      "start": 11953,
      "end": 12040,
      "text": " {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَثَلُ نُورِهِ كَمِشْكَاةٍ فِيهَا مِصْبَاحٌ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11954,
          "end": 12039,
          "span_id": "s163"
        }
      ]
    },
    {
      "id": "s164",
      "start": 12040,
      "end": 12093,
      "text": " وذلك أن اليهودَ قالوا لمحمدٍ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 12072,
          "end": 12090,
          "span_id": "s164"
        }
      ]
    },
    {
      "id": "s165",
      "start": 12093,
      "end": 12135,
      "text": " كيف يَخْلُصُ نورُ اللهِ مِن دونِ السماءِ؟",
      "markers": []
    },
    {
      "id": "s166",
      "start": 12135,
      "end": 12172,
      "text": " فضرَب اللهُ مَثَلَ ذلك لنورِه، فقال:",
      "markers": []
    },
    {
      "id": "s167",
      "start": 12172,
      "end": 12259,
      "text": " {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَثَلُ نُورِهِ كَمِشْكَاةٍ فِيهَا مِصْبَاحٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12173,
          "end": 12258,
          "span_id": "s167"
        }
      ]
    },
    {
      "id": "s168",
      "start": 12259,
      "end": 12292,
      "text": " والمشكاةُ كَوَّةُ البيتِ فيها مص",
      "markers": []
    },
    {
      "id": "s169",
      "start": 12296,
      "end": 12373,
      "text": "باحٌ، {الْمِصْبَاحُ فِي زُجَاجَةٍ الزُّجَاجَةُ كَأَنَّهَا كَوْكَبٌ دُرِّيٌّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12302,
          "end": 12372,
          "span_id": "s169"
        }
      ]
    },
    {
      "id": "s170",
      "start": 12373,
      "end": 12489,
      "text": " والمصباحُ السِّراجُ يكونُ في الزجاجةِ، وهو مَثَلٌ ضرَبه اللهُ لطاعتِه، فسمَّى طاعتَه نورًا، وسمَّاها أنواعًا شتَّى.",
      "markers": []
    },
    {
      "id": "s171",
      "start": 12489,
      "end": 12579,
      "text": " قولَه: {يُوقَدُ مِنْ شَجَرَةٍ مُبَارَكَةٍ زَيْتُونَةٍ لَا شَرْقِيَّةٍ وَلَا غَرْبِيَّةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12497,
          "end": 12578,
          "span_id": "s171"
        }
      ]
    },
    {
      "id": "s172",
      "start": 12579,
      "end": 12661,
      "text": " قال: هي شجرةٌ لا يَفِيءُ عليها ظلُّ شرقٍ، ولا ظلُّ غربٍ، ضاحيةٌ، ذلك أصفى الزيتِ ",
      "markers": []
    },
    {
      "id": "s173",
      "start": 12677,
      "end": 12736,
      "text": "، {يَكَادُ زَيْتُهَا يُضِيءُ وَلَوْ لَمْ تَمْسَسْهُ نَارٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12679,
          "end": 12735,
          "span_id": "s173"
        }
      ]
    },
    {
      "id": "s174",
      "start": 12764,
      "end": 12834,
      "text": ".قال معمرٌ: وقال الحسنُ: ليست مِن شجرِ الدنيا، ليست شرقيةً ولا غربيةً ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 12781,
          "end": 12786,
          "span_id": "s174"
        }
      ]
    },
    {
      "id": "s175",
      "start": 12944,
      "end": 13037,
      "text": ".وقال آخرون: هو مَثَلٌ للمؤمنِ، غيرَ أن المصباحَ وما فيه مثلٌ لفؤادِه، والمشكاةَ مثلٌ لجوفِه.",
      "markers": []
    },
    {
      "id": "s176",
      "start": 13037,
      "end": 13074,
      "text": "ذكرُ مَن قال ذلكحدَّثنا القاسمُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 13053,
          "end": 13060,
          "span_id": "s176"
        }
      ]
    },
    {
      "id": "s177",
      "start": 13074,
      "end": 13124,
      "text": " ثنا الحسينُ، قال: ثني حجاجٌ، عن ابن جُرَيجٍ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 13107,
          "end": 13117,
          "span_id": "s177"
        }
      ]
    },
    {
      "id": "s178",
      "start": 13124,
      "end": 13155,
      "text": " قال مجاهدٌ وابنُ عباسٍ جميعًا:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 13129,
          "end": 13134,
          "span_id": "s178"
        }
      ]
    },
    {
      "id": "s179",
      "start": 13155,
      "end": 13198,
      "text": " المصباحُ وما فيه مثلُ فؤادِ المؤمن وجوفِه؛",
      "markers": []
    },
    {
      "id": "s180",
      "start": 13198,
      "end": 13245,
      "text": " المصباحُ مثلُ الفؤادِ، والكَوَّةُ مثلُ الجوفِ.",
      "markers": []
    },
    {
      "id": "s181",
      "start": 13245,
      "end": 13292,
      "text": "قال ابن جريجٍ: {كَمِشْكَاةٍ}: كوةٍ غيرِ نافذةٍ.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 13249,
          "end": 13257,
          "span_id": "s181"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13260,
          "end": 13273,
          "span_id": "s181"
        }
      ]
    },
    {
      "id": "s182",
      "start": 13292,
      "end": 13316,
      "text": "قال ابن جريجٍ: وقال ابن ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 13296,
          "end": 13304,
          "span_id": "s182"
        }
      ]
    },
    {
      "id": "s183",
      "start": 13320,
      "end": 13353,
      "text": "عباسٍ قولَه: {نُورٌ عَلَى نُورٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13333,
          "end": 13352,
          "span_id": "s183"
        }
      ]
    },
    {
      "id": "s184",
      "start": 13353,
      "end": 13393,
      "text": " يعنى: إيمانُ المؤمنِ وعملُه.وقال آخرون:",
      "markers": []
    },
    {
      "id": "s185",
      "start": 13393,
      "end": 13430,
      "text": " بل ذلك مثلٌ للقرآنِ في قلبِ المؤمنِ.",
      "markers": []
    },
    {
      "id": "s186",
      "start": 13430,
      "end": 13466,
      "text": "ذكرُ مَن قال ذلكحدَّثني يعقوبُ، قال:",
      "markers": []
    },
    {
      "id": "s187",
      "start": 13466,
      "end": 13516,
      "text": " ثنا ابن عليةَ، عن أبي رَجاءٍ، عن الحسنِ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 13482,
          "end": 13516,
          "stripped": "عن أبي رجاء، عن الحسن في قوله:",
          "span_id": "s187"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 13500,
          "end": 13505,
          "span_id": "s187"
        }
      ]
    },
    {
      "id": "s188",
      "start": 13516,
      "end": 13586,
      "text": " {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَثَلُ نُورِهِ كَمِشْكَاةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13517,
          "end": 13585,
          "span_id": "s188"
        }
      ]
    },
    {
      "id": "s189",
      "start": 13586,
      "end": 13690,
      "text": " قال: ككَوَّةٍ، {فِيهَا مِصْبَاحٌ الْمِصْبَاحُ فِي زُجَاجَةٍ الزُّجَاجَةُ كَأَنَّهَا كَوْكَبٌ دُرِّيٌّ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13602,
          "end": 13689,
          "span_id": "s189"
        }
      ]
    },
    {
      "id": "s190",
      "start": 13791,
      "end": 13835,
      "text": ".حدَّثني يونُسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 13813,
          "end": 13820,
          "span_id": "s190"
        }
      ]
    },
    {
      "id": "s191",
      "start": 13835,
      "end": 13864,
      "text": " قال ابن زِيدٍ في قولِ اللهِ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 13840,
          "end": 13848,
          "span_id": "s191"
        }
      ]
    },
    {
      "id": "s192",
      "start": 13864,
      "end": 13922,
      "text": " {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَثَلُ نُورِهِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13865,
          "end": 13921,
          "span_id": "s192"
        }
      ]
    },
    {
      "id": "s193",
      "start": 13922,
      "end": 14045,
      "text": " نورِ القرآنِ الذي أنْزَل على رسولِه وعبادِه، فهذا مثلُ القرآنِ، {كَمِشْكَاةٍ فِيهَا مِصْبَاحٌ الْمِصْبَاحُ فِي زُجَاجَةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13987,
          "end": 14044,
          "span_id": "s193"
        }
      ]
    },
    {
      "id": "s194",
      "start": 14045,
      "end": 14199,
      "text": " فقرَأ حتى بلَغ: {مُبَارَكَةٍ} فهذا مثلُ القرآنِ، يُسْتَضاءُ به في نورِه ويَعْلَمونه ويَأْخُذون به، وهو كما هو، لا يَنْقُصُ، فهذا مثلٌ ضرَبه اللهُ لنورِه.",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 14047,
          "end": 14051,
          "span_id": "s194"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14062,
          "end": 14075,
          "span_id": "s194"
        }
      ]
    },
    {
      "id": "s195",
      "start": 14199,
      "end": 14239,
      "text": " وفى قولِه: {يَكَادُ زَيْتُهَا يُضِيءُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14211,
          "end": 14238,
          "span_id": "s195"
        }
      ]
    },
    {
      "id": "s196",
      "start": 14239,
      "end": 14340,
      "text": " قال: الضوءُ إشراقُ ذلك الزيتِ، والمشكاةُ التي فيها الفَتيلةُ التي في المصباحِ، والقناديلُ تلك المصاب",
      "markers": []
    },
    {
      "id": "s197",
      "start": 14344,
      "end": 14348,
      "text": "يحُ ",
      "markers": []
    },
    {
      "id": "s198",
      "start": 14492,
      "end": 14522,
      "text": ".حدَّثنا محمدُ بنُ بشارٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 14493,
          "end": 14500,
          "span_id": "s198"
        }
      ]
    },
    {
      "id": "s199",
      "start": 14522,
      "end": 14582,
      "text": " ثنا عبدُ الرحمنِ، قال: ثنا سفيانُ، عن أبي إسحاقَ، عن سعيدِ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 14558,
          "end": 14580,
          "stripped": "عن أبي إسحاق، عن سعيد",
          "span_id": "s199"
        }
      ]
    },
    {
      "id": "s200",
      "start": 14714,
      "end": 14764,
      "text": " بن عياضٍ في قولِه: {كَمِشْكَاةٍ}. قال: الكَوَّةُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14734,
          "end": 14747,
          "span_id": "s200"
        }
      ]
    },
    {
      "id": "s201",
      "start": 14888,
      "end": 14932,
      "text": ".حدَّثنا ابن بشارٍ، قال: ثنا أبو عامرٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 14889,
          "end": 14896,
          "span_id": "s201"
        }
      ]
    },
    {
      "id": "s202",
      "start": 14932,
      "end": 14964,
      "text": " ثنا قُرَّةُ، عن عطيةَ في قولِه:",
      "markers": []
    },
    {
      "id": "s203",
      "start": 14964,
      "end": 15018,
      "text": " {كَمِشْكَاةٍ}. قال: قال ابن عمرَ: المشكاةُ الكَوَّةُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14965,
          "end": 14978,
          "span_id": "s203"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عمر",
          "name": "ابن عمر",
          "role": "SPEAKER",
          "start": 14989,
          "end": 14996,
          "span_id": "s203"
        }
      ]
    },
    {
      "id": "s204",
      "start": 15079,
      "end": 15155,
      "text": ".وقال آخرون: المشكاةُ القنديلُ.ذكرُ مَن قال ذلكحدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s205",
      "start": 15155,
      "end": 15228,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابن أبي نجيحٍ، عن مجاهدٍ في قولِ اللهِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 15186,
          "end": 15228,
          "stripped": "عن ابن أبي نجيح، عن مجاهد في قول الله:",
          "span_id": "s205"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 15207,
          "end": 15212,
          "span_id": "s205"
        }
      ]
    },
    {
      "id": "s206",
      "start": 15228,
      "end": 15288,
      "text": " {كَمِشْكَاةٍ}. قال: القنديلُ، ثم العمودُ الذي فيه القنديلُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 15229,
          "end": 15242,
          "span_id": "s206"
        }
      ]
    },
    {
      "id": "s207",
      "start": 15347,
      "end": 15365,
      "text": ".حدَّثني الحارثُ، ",
      "markers": []
    }
  ],

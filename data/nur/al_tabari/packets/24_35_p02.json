      "grading": []
    },
    {
      "label_ar": "إضافة المحقق — ليست من كلام الطبري",
      "attached_span_id": "s120",
      "start": 8574,
      "end": 8715,
      "text": "[{يَكَادُ زَيْتُهَا يُضِيءُ}: يكادُ محمدٌ - صلى الله عليه وسلم - يَبِينُ للناسِ، وإن لم يَتَكَلَّمْ، أنه نبيٌّ، كما يكادُ ذلك الزيتُ يُضِيءُ]",
      "grading": []
    }
  ]

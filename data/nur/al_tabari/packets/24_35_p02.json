  "spans": [
    {
      "id": "s103",
      "start": 7176,
      "end": 7275,
      "text": "عباسٍ قولَه: {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَثَلُ نُورِهِ كَمِشْكَاةٍ فِيهَا مِصْبَاحٌ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7189,
          "end": 7274,
          "span_id": "s103"
        }
      ]
    },
    {
      "id": "s104",
      "start": 7275,
      "end": 7305,
      "text": " وذلك أن اليهودَ قالوا لمحمدٍ:",
      "markers": []
    },
    {
      "id": "s105",
      "start": 7305,
      "end": 7339,
      "text": " كيف يَخْلُصُ نورُ اللهِ مِن دونِ ",
      "markers": []
    },
    {
      "id": "s106",
      "start": 7366,
      "end": 7409,
      "text": " السماء؟ فضرَب اللهُ مثلَ ذلك لنورِه، فقال:",
      "markers": []
    },
    {
      "id": "s107",
      "start": 7409,
      "end": 7479,
      "text": " {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَثَلُ نُورِهِ كَمِشْكَاةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7410,
          "end": 7478,
          "span_id": "s107"
        }
      ]
    },
    {
      "id": "s108",
      "start": 7479,
      "end": 7559,
      "text": " قال: وهو مثلٌ ضرَبه اللهُ لطاعتِه، فسمَّى طاعتَه نورًا، ثم سماها أنوارًا شتَّى ",
      "markers": []
    },
    {
      "id": "s109",
      "start": 7674,
      "end": 7781,
      "text": ".وقولُه: {كَمِشْكَاةٍ}. اخْتَلَف أهلُ التأويلِ في معنى \"المشكاة\" و \"المصباح\"، وما المرادُ بذلك، وبالزجاجةِ؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7683,
          "end": 7696,
          "span_id": "s109"
        }
      ]
    },
    {
      "id": "s110",
      "start": 7781,
      "end": 7833,
      "text": " فقال بعضُهم: المشكاةُ كلُّ كَوَّةٍ لا مَنْفَذَ لها.",
      "markers": []
    },
    {
      "id": "s111",
      "start": 7833,
      "end": 7898,
      "text": " وقالوا: هذا مثلٌ ضرَبه اللهُ لقلبِ محمدٍ - صلى الله عليه وسلم -.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7877,
          "end": 7895,
          "span_id": "s111"
        }
      ]
    },
    {
      "id": "s112",
      "start": 7898,
      "end": 7937,
      "text": "ذكرُ مَن قال ذلكحدَّثنا ابن حميدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7914,
          "end": 7921,
          "span_id": "s112"
        }
      ]
    },
    {
      "id": "s113",
      "start": 7937,
      "end": 7974,
      "text": " ثنا يعقوبُ، عن حفصٍ، عن شِمْرٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7950,
          "end": 7974,
          "stripped": "عن حفص، عن شمر، قال:",
          "span_id": "s113"
        }
      ]
    },
    {
      "id": "s114",
      "start": 7974,
      "end": 8016,
      "text": " جاء ابن عباسٍ إلى كعبِ الأحبارِ، فقال له:",
      "markers": [
        {
          "family": "ISRAILIYYAT",
          "marker": "كعب الأحبار",
          "start": 7993,
          "end": 8005,
          "span_id": "s114"
        }
      ]
    },
    {
      "id": "s115",
      "start": 8016,
      "end": 8090,
      "text": " حدَّثْنى عن قولِ اللهِ: {مَثَلُ نُورِهِ كَمِشْكَاةٍ}. قال: {كَمِشْكَاةٍ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8041,
          "end": 8069,
          "span_id": "s115"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8076,
          "end": 8089,
          "span_id": "s115"
        }
      ]
    },
    {
      "id": "s116",
      "start": 8120,
      "end": 8144,
      "text": "، وهى الكَوَّةُ، ضرَبها ",
      "markers": []
    },
    {
      "id": "s117",
      "start": 8170,
      "end": 8196,
      "text": " مثلًا لمحمدٍ - صلى الله ع",
      "markers": []
    },
    {
      "id": "s118",
      "start": 8200,
      "end": 8332,
      "text": "ليه وسلم -، المشكاةُ {فِيهَا مِصْبَاحٌ} المصباحُ قلبُه، {فِي زُجَاجَةٍ} الزجاجةُ صدرُه، {الزُّجَاجَةُ كَأَنَّهَا كَوْكَبٌ دُرِّيٌّ}؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8221,
          "end": 8239,
          "span_id": "s118"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8256,
          "end": 8271,
          "span_id": "s118"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8288,
          "end": 8331,
          "span_id": "s118"
        }
      ]
    },
    {
      "id": "s119",
      "start": 8332,
      "end": 8409,
      "text": " شبَّه صدرَ النبيِّ - صلى الله عليه وسلم - بالكوكبِ الدُّرِّيِّ، ثم رجَع إلى ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 8354,
          "end": 8372,
          "span_id": "s119"
        }
      ]
    },
    {
      "id": "s120",
      "start": 8421,
      "end": 8574,
      "text": " المصباحِ إلى قلبِه، فقال: {يُوقَدُ مِنْ شَجَرَةٍ مُبَارَكَةٍ زَيْتُونَةٍ لَا شَرْقِيَّةٍ وَلَا غَرْبِيَّةٍ} لم تَمَسَّها شمسُ المشرقِ ولا شمسُ المغربِ، ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8448,
          "end": 8529,
          "span_id": "s120"
        }
      ]
    },
    {
      "id": "s121",
      "start": 8715,
      "end": 8716,
      "text": " ",
      "markers": []
    },
    {
      "id": "s122",
      "start": 8733,
      "end": 8783,
      "text": " {وَلَوْ لَمْ تَمْسَسْهُ نَارٌ نُورٌ عَلَى نُورٍ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8734,
          "end": 8782,
          "span_id": "s122"
        }
      ]
    },
    {
      "id": "s123",
      "start": 8870,
      "end": 8911,
      "text": ".حدَّثني عليٌّ، قال: ثنا عبدُ اللهِ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",

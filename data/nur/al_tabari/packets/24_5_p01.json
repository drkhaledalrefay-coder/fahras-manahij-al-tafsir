  "definitions": [
    {
      "id": "M_QURAN",
      "name_ar": "القرآن بالقرآن",
      "when": "آية أخرى تبيّن معنى الآية المفسَّرة.",
      "exclude": "اقتباس آية داخل حديث أو مجرد نظير موضوعي.",
      "markers": "كما قال تعالى، وقال تعالى، قوله تعالى، {…}، [سورة: ن]"

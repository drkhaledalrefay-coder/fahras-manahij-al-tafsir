  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 176,
      "text": " {إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (5)}اختلَف أهلُ التأويلِ في الذي استُثنى منه قولُه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 129,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 176,
      "end": 236,
      "text": " {إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا}؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 177,
          "end": 235,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 236,
      "end": 266,
      "text": " فقال بعضُهم: استُثنى من قوله:",
      "markers": []
    },
    {
      "id": "s005",
      "start": 266,
      "end": 341,
      "text": " {وَلَا تَقْبَلُوا لَهُمْ شَهَادَةً أَبَدًا وَأُولَئِكَ هُمُالْفَاسِقُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 267,
          "end": 340,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 341,
      "end": 422,
      "text": " وقالوا: إذا تاب القاذفُ قُبلت شهادتُه، وزال عنه اسمُ الفسقِ، حدَّ فيه أولم يُحد.",
      "markers": []
    },
    {
      "id": "s007",
      "start": 422,
      "end": 479,
      "text": "ذكرُ مَن قال ذلكحدَّثنا أحمد بنُ حمادٍ الدُّولابيُّ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 438,
          "end": 445,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 479,
      "end": 556,
      "text": " ثنا سفيانُ، عن الزُّهريِّ، عن سعيدٍ - إن شاء اللهُ - أن عمرَ قال لأبي بكرةَ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 492,
          "end": 524,
          "stripped": "عن الزهري، عن سعيد - إن شاء",
          "span_id": "s008"
        },
        {
          "family": "SAHABA",
          "marker": "عمر",
          "name": "عمر",
          "role": "SPEAKER",
          "start": 536,
          "end": 539,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 556,
      "end": 588,
      "text": " إن تبتَ قبلتُ شهادتَك، أو تُبْ ",
      "markers": []
    },
    {
      "id": "s010",
      "start": 603,
      "end": 611,
      "text": " تُقبلْ ",
      "markers": []
    },
    {
      "id": "s011",
      "start": 650,
      "end": 659,
      "text": " شهادتُك ",
      "markers": []
    },
    {
      "id": "s012",
      "start": 777,
      "end": 966,
      "text": ".حدَّثنا ابن حميدٍ، قال: ثنا سلمةُ، عن ابن إسحاقُ، عن الزُّهريِّ، عن سعيدَ بن المسيَّبِ، أن عمرَ بنَ الخطابِ ضرَب أبا بكرةَ وشِبلَ بنَ معبدٍ ونافعَ بنَ الحارثِ بنِ كَلدَةَ، حدَّهم وقال لهم:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 778,
          "end": 785,
          "span_id": "s012"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 813,
          "end": 868,
          "stripped": "عن ابن إسحاق، عن الزهري، عن سعيد بن المسيب، أن",
          "span_id": "s012"
        }
      ]
    },
    {
      "id": "s013",
      "start": 966,
      "end": 1028,
      "text": " من أكذَب نفسَه أجزتُ شهادتَه فيما استُقبل، ومن لم يفعلْ لم أُ",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1032,
      "end": 1097,
      "text": "جِزْ شهادته. فأكذَب شبلٌ نفسَه ونافعٌ، وأَبَى أبو بكرةَ أن يفعلَ.",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1097,
      "end": 1136,
      "text": " قال الزهريُّ: هو واللهِ سنةٌ فاحفَظوه ",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1391,
      "end": 1422,
      "text": ".حدَّثنا ابن أبى الشواربِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1392,
          "end": 1399,
          "span_id": "s016"
        }
      ]
    },
    {
      "id": "s017",
      "start": 1422,
      "end": 1449,
      "text": " ثنا يزيدُ بنُ زُريعٍ، قال:",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1449,
      "end": 1478,
      "text": " ثنا داودُ، عن الشعبيِّ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "SPEAKER",
          "start": 1464,
          "end": 1470,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 1478,
      "end": 1541,
      "text": " إذا تاب - يعنى القاذفُ - ولم يُعلم منه إلا خيرٌ، جازت شهادتُه ",
      "markers": []
    },
    {
      "id": "s020",
      "start": 1649,
      "end": 1679,
      "text": ".حدَّثنا عمرانُ بنُ موسى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1650,
          "end": 1657,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 1679,
      "end": 1731,
      "text": " ثنا عبدُ الوارثِ، قال: ثنا داودُ، عن الشعبيِّ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "SPEAKER",
          "start": 1717,
          "end": 1723,
          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 1731,
      "end": 1785,
      "text": " على الإمامِ أن يستَتيبَ القاذفَ بعد الجَلدِ، فإن تاب ",
      "markers": []
    },
    {
      "id": "s023",
      "start": 1793,
      "end": 1794,
      "text": " ",
      "markers": []
    },
    {
      "id": "s024",
      "start": 1828,
      "end": 1857,
      "text": " منه خيرٌ، جازت شهادتُه، وإن ",
      "markers": []
    },
    {
      "id": "s025",
      "start": 1889,
      "end": 1925,
      "text": " لم يتبْ فهو خليعٌ لا تجوزُ شهادتُه.",
      "markers": []
    },
    {
      "id": "s026",
      "start": 1925,
      "end": 1972,
      "text": "حدَّثنا ابن المثنى، قال: ثنا عبدُ الوارثِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1925,
          "end": 1932,
          "span_id": "s026"
        }
      ]
    },
    {
      "id": "s027",
      "start": 1972,
      "end": 2012,
      "text": " ثنا داودُ، عن عامرٍ أنه قال في القاذفِ:",
      "markers": []
    },
    {
      "id": "s028",
      "start": 2012,
      "end": 2052,
      "text": " إذا تاب وعُلم منه خيرٌ، إن شهادتَه جائز",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2056,
      "end": 2122,
      "text": "ةٌ، وإن لم يتبْ فهو خليعٌ لا تجوزُ شهادتُه، وتوبتُه إكذابُه نفسَه.",
      "markers": []
    },
    {
      "id": "s030",
      "start": 2122,
      "end": 2174,
      "text": "قال: ثنا ابن أبى عديٍّ، عن داودَ، عن الشعبيِّ نحوَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2146,
          "end": 2174,
          "stripped": "عن داود، عن الشعبي نحوه.",
          "span_id": "s030"
        },
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "NARRATOR",
          "start": 2159,
          "end": 2165,
          "span_id": "s030"
        }
      ]
    },
    {
      "id": "s031",
      "start": 2174,
      "end": 2211,
      "text": "حدَّثنا أبو كريبٍ وأبو السائبِ، قالا:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2174,
          "end": 2181,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2211,
      "end": 2294,
      "text": " ثنا ابن إدريسَ، قال: أخبَرنا داودُ بنُ أبى هندٍ، عن الشعبيِّ، قال في القاذفِ: إذا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2233,
          "end": 2240,
          "span_id": "s032"
        },
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "SPEAKER",
          "start": 2264,
          "end": 2270,
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 2315,
      "end": 2377,
      "text": " تاب وأكذَب نفسَه قُبلت شهادتُه، وإلا كان خليعًا لا شهادةَ له؛",
      "markers": []
    },
    {
      "id": "s034",
      "start": 2377,
      "end": 2444,
      "text": " لأن الله يقولُ: {لَوْلَا جَاءُوا عَلَيْهِ بِأَرْبَعَةِ شُهَدَاءَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2394,
          "end": 2443,
          "span_id": "s034"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 2444,
          "end": 2455,
          "text": "[النور: 13]",
          "via": "apparatus",
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2455,
      "end": 2492,
      "text": " إلى آخرِ الآيةِ.حدَّثني يعقوبُ، قال:",
      "markers": []
    },
    {
      "id": "s036",
      "start": 2492,
      "end": 2581,
      "text": " ثنا هشيمٌ، قال: أخبَرنا داودُ بنُ أبي هندٍ، عن الشعبيِّ أنه كان يقولُ في شهادةِ القاذفِ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2509,
          "end": 2516,
          "span_id": "s036"
        },
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "SPEAKER",
          "start": 2540,
          "end": 2546,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 2581,
      "end": 2617,
      "text": " إذا رجَع عن قوله حينَ يُضَرَبُ، أو ",
      "markers": []
    },
    {
      "id": "s038",
      "start": 2631,
      "end": 2760,
      "text": " أَكْذَب نفسَه، قُبِلت شهادتُه.قال: ثنا هشيمٌ، عن إسماعيلَ بن أبي خالدٍ، عن الشعبيِّ أنه كان يقولُ: يقبَلُ اللهُ توبتَه وتردُّون ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2678,
          "end": 2730,
          "stripped": "عن إسماعيل بن أبي خالد، عن الشعبي أنه كان يقول:",
          "span_id": "s038"
        },
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "SPEAKER",
          "start": 2707,
          "end": 2713,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 2776,
      "end": 2814,
      "text": " شهادتَه! وكان يقبَلُ شهادتَه إذا تاب ",
      "markers": []
    },
    {
      "id": "s040",
      "start": 3013,
      "end": 3076,
      "text": ".قال: أخبَرنا إسماعيلُ، عن الشعبيِّ أنه كان يقولُ في القاذفِ: إ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3019,
          "end": 3026,
          "span_id": "s040"
        },
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "SPEAKER",
          "start": 3040,
          "end": 3046,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 3080,
      "end": 3125,
      "text": "ذا شهِد قبلَ أن يُضربَ الحدَّ، قُبلت شهادتُه.",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3125,
      "end": 3247,
      "text": "قال: ثنا هشيمٌ قال: أخبَرنا عُبيدة، عن إبراهيم، وإسماعيلُ بنُ سالمٍ، عن الشعبيِّ، أنهما قالا في القاذفِ: إذا شهِد قبلَ أن ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3145,
          "end": 3152,
          "span_id": "s042"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3161,
          "end": 3220,
          "stripped": "عن إبراهيم، وإسماعيل بن سالم، عن الشعبي، أنهما قالا في",
          "span_id": "s042"
        },
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "NARRATOR",
          "start": 3197,
          "end": 3203,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3264,
      "end": 3265,
      "text": " ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3344,
      "end": 3352,
      "text": " جائزةٌ ",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3398,
      "end": 3479,
      "text": ".حدَّثني يعقوبُ، قال: قال أبو بشرٍ، يعنى ابنَ عُليةَ، سمِعتُ ابن أبي نجيحٍ يقولُ:",
      "markers": []
    },
    {
      "id": "s046",
      "start": 3479,
      "end": 3524,
      "text": " القاذفُ إذا تاب تجوزُ شهادتُه. وقال: كلُّنا ",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3601,
      "end": 3609,
      "text": " نقوله. ",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3653,
      "end": 3654,
      "text": " ",
      "markers": []
    },
    {
      "id": "s049",
      "start": 3673,
      "end": 3696,
      "text": ": عطاءٌ وطاوسٌ ومجاهدٌ ",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3851,
      "end": 3910,
      "text": ".حدَّثنا ابن بشارٍ وابنُ المثنى، قالا: ثنا محمدُ بنُ خالدِ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3852,
          "end": 3859,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3970,
      "end": 4030,
      "text": " ابن عثمةَ، قال: ثنا سعيدُ بنُ بشيرٍ، عن قتادةَ، عن عمرَ بن ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4008,
          "end": 4029,
          "stripped": "عن قتادة، عن عمر بن",
          "span_id": "s051"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 4011,
          "end": 4016,
          "span_id": "s051"
        },
        {
          "family": "SAHABA",
          "marker": "عمر",
          "name": "عمر",
          "role": "NARRATOR",
          "start": 4022,
          "end": 4025,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4055,
      "end": 4056,
      "text": " ",
      "markers": []
    },
    {
      "id": "s053",
      "start": 4107,
      "end": 4137,
      "text": "، قال: إذا تاب القاذفُ جُلد و ",
      "markers": []
    },
    {
      "id": "s054",
      "start": 4179,
      "end": 4221,
      "text": " جازت شهادتُه. قال أبو موسى: هكذا قال ابن ",
      "markers": []
    },
    {
      "id": "s055",
      "start": 4244,
      "end": 4296,
      "text": " عثمةَ.حدَّثنا ابن بشارٍ وابن المثنى، قالا: ثنا ابن ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4251,
          "end": 4258,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4322,
      "end": 4403,
      "text": " عثمةَ، قال: ثنا سعيدٌ بنُ بشيرٍ، عن قتادةَ، عن سليمانَ بن يسارٍ والشعبيِّ، قالا:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4356,
          "end": 4397,
          "stripped": "عن قتادة، عن سليمان بن يسار والشعبي،",
          "span_id": "s056"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 4359,
          "end": 4364,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4403,
      "end": 4445,
      "text": " إذا تاب القاذفُ عندَ الجلدِ جازت شهادتهُ ",
      "markers": []
    },
    {
      "id": "s058",
      "start": 4565,
      "end": 4611,
      "text": ".حدَّثنا ابن بشارٍ، قال: ثنا عبدُ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4566,
          "end": 4573,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4611,
      "end": 4695,
      "text": " ثنا سعيدٌ، عن قتادةَ، أن عمرَ بنَ عبدِ اللهِ بن أبي طلحةَ جلَد رجلًا في قذفٍ، فقال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 4626,
          "end": 4631,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4695,
      "end": 4728,
      "text": " أَكذِبْ نفسَك حتى تجوزَ شهادتُك ",
      "markers": []
    },
    {
      "id": "s061",
      "start": 4770,
      "end": 4817,
      "text": ".حدَّثنا ابن بشارٍ، قال: ثنا عبدُ الرحمنِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4771,
          "end": 4778,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4817,
      "end": 4850,
      "text": " ثنا سفيانُ، عن أبي الهيثمِ، قال:",
      "markers": []
    },
    {
      "id": "s063",
      "start": 4850,
      "end": 4926,
      "text": " سمِعتُ إبراهيمَ والشعبيَّ يتذاكران شهادةَ القاذفِ، فقال الشعبيُّ لإبراهيمَ:",
      "markers": []
    },
    {
      "id": "s064",
      "start": 4926,
      "end": 4960,
      "text": " لمَ لا تقبلُ شهادتَه؟ فقال: لأنى ",
      "markers": []
    },
    {
      "id": "s065",
      "start": 4977,
      "end": 4996,
      "text": " لا أدرى تاب أم لا ",
      "markers": []
    },
    {
      "id": "s066",
      "start": 5123,
      "end": 5124,
      "text": ".",
      "markers": []
    },
    {
      "id": "s067",
      "start": 5128,
      "end": 5155,
      "text": "قال: ثنا عبدُ الرحمنِ، قال:",
      "markers": []
    },
    {
      "id": "s068",
      "start": 5155,
      "end": 5185,
      "text": " ثنا عبدُ اللهِ بنُ المباركِ، ",
      "markers": []
    },
    {
      "id": "s069",
      "start": 5437,
      "end": 5438,
      "text": " ",
      "markers": []
    },
    {
      "id": "s070",
      "start": 5451,
      "end": 5452,
      "text": ".",
      "markers": []
    },
    {
      "id": "s071",
      "start": 5486,
      "end": 5487,
      "text": " ",
      "markers": []
    },
    {
      "id": "s072",
      "start": 5500,
      "end": 5540,
      "text": "، عن ابن جُريجٍ، عن عمرانَ بن موسى، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5502,
          "end": 5540,
          "stripped": "عن ابن جريج، عن عمران بن موسى، قال:",
          "span_id": "s072"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 5505,
          "end": 5514,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 5540,
      "end": 5600,
      "text": " شهِدتُ عمرَ بنَ عبدِ العزيزِ أجاز شهادةَ القاذفِ ومعه رجلٌ ",
      "markers": []
    },
    {
      "id": "s074",
      "start": 5720,
      "end": 5771,
      "text": ".حدَّثنا ابن المثنى، قال: ثنا محمدُ بنُ جعفرٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5721,
          "end": 5728,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 5771,
      "end": 5798,
      "text": " ثنا شعبةُ، عن الحكمِ، قال:",
      "markers": []
    },
    {
      "id": "s076",
      "start": 5798,
      "end": 5834,
      "text": " قال الشعبيُّ: إذا تاب جازت شهادتُه.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "SPEAKER",
          "start": 5803,
          "end": 5809,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 5834,
      "end": 5878,
      "text": " قال ابن المثنى: قال: عندى. يعني: في القذفِ ",
      "markers": []
    },
    {
      "id": "s078",
      "start": 5922,
      "end": 5983,
      "text": ".حدَّثنا أبو كريبٍ، قال: ثنا ابن إدريسَ، قال: أخبَرنا مِسعرٌ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5923,
          "end": 5930,
          "span_id": "s078"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 5968,
          "end": 5975,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 6002,
      "end": 6013,
      "text": "، عن عمران ",
      "markers": []
    },
    {
      "id": "s080",
      "start": 6031,
      "end": 6101,
      "text": " ابن عميرٍ، أن عبدَ اللهِ بنَ عتبةَ كان يُجيزُ شهادةَ القاذفِ إذا تاب ",
      "markers": []
    },
    {
      "id": "s081",
      "start": 6300,
      "end": 6361,
      "text": ".حدَّثني يعقوبُ، قال: ثنا هشيمٌ، عن جُويبرٍ، عن الضحاكَ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6333,
          "end": 6361,
          "stripped": "عن جويبر، عن الضحاك، قال:",
          "span_id": "s081"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 6348,
          "end": 6354,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 6361,
      "end": 6405,
      "text": " إذا تاب وأصلَح قُبلت شهادتُه. يعنى القاذفَ ",
      "markers": []
    },
    {
      "id": "s083",
      "start": 6445,
      "end": 6475,
      "text": ".حدَّثنا ابن عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6446,
          "end": 6453,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 6475,
      "end": 6535,
      "text": " أخبَرنا ابن ثورٍ، عن معمرٍ، عن قتادةَ، عن ابن المسيبِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6476,
          "end": 6483,
          "span_id": "s084"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6494,
          "end": 6535,
          "stripped": "عن معمر، عن قتادة، عن ابن المسيب، قال:",
          "span_id": "s084"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 6507,
          "end": 6512,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 6535,
      "end": 6566,
      "text": " تُقبلُ شهادةُ القاذفِ إذا تاب.",
      "markers": []
    },
    {
      "id": "s086",
      "start": 6566,
      "end": 6609,
      "text": "حدَّثنا الحسنُ، قال: ثنا عبدُ الرزاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6566,
          "end": 6573,
          "span_id": "s086"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 6574,
          "end": 6579,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 6609,
      "end": 6657,
      "text": " أخبَرنا معمرٌ، عن قتادةَ، عن ابن المسيبِ مثلَه ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6610,
          "end": 6617,
          "span_id": "s087"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6625,
          "end": 6656,
          "stripped": "عن قتادة، عن ابن المسيب مثله",
          "span_id": "s087"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 6628,
          "end": 6633,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 6752,
      "end": 6782,
      "text": ".حدَّثنا ابن عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6753,
          "end": 6760,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 6782,
      "end": 6808,
      "text": " ثنا محمدٌ، عن معمرٍ، قال ",
      "markers": []
    },
    {
      "id": "s090",
      "start": 6829,
      "end": 6936,
      "text": ": قال الزُّهريُّ: إذا حُدَّ القاذفُ، فإنه ينبغى للإمامِ أن يستتيبَه، فإن تاب قُبلت شهادتُه، وإلا لم تُقبلْ.",
      "markers": []
    },
    {
      "id": "s091",
      "start": 6936,
      "end": 7046,
      "text": " قال: كذلك فعَل عمرُ بنُ الخطابِ بالذين شَهِدوا على المغيرةِ بن شعبةَ، فتابوا إلَّا أبا بكرةَ، فكان لا تُقبلُ ",
      "markers": []
    },
    {
      "id": "s092",
      "start": 7063,
      "end": 7072,
      "text": " شهادتُه ",
      "markers": []
    },
    {
      "id": "s093",
      "start": 7209,
      "end": 7249,
      "text": ".وقال آخرون: الاستثناءُ في ذلك من قولِه ",
      "markers": []
    },
    {
      "id": "s094",
      "start": 7266,
      "end": 7307,
      "text": ": {وَأُولَئِكَ هُمُ الْفَاسِقُونَ}. وأما ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7268,
          "end": 7300,
          "span_id": "s094"
        }
      ]
    },
    {
      "id": "s095",
      "start": 7324,
      "end": 7399,
      "text": " قوله: {وَلَا تَقْبَلُوا لَهُمْ شَهَادَةً أَبَدًا}. فقد وُصِل بالأبدِ، ولا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7331,
          "end": 7374,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 7415,
      "end": 7481,
      "text": " يجوزُ قَبولُها أبدًا.ذكر من قال ذلكحدَّثنا ابن أبي الشواربِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7451,
          "end": 7458,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 7481,
      "end": 7507,
      "text": " ثنا يزيُد بنُ زريعٍ، قال:",
      "markers": []
    },
    {
      "id": "s098",
      "start": 7507,
      "end": 7536,
      "text": " ثنا أشعثُ بنُ سَوَّارٍ، قال:",
      "markers": []
    },
    {
      "id": "s099",
      "start": 7536,
      "end": 7621,
      "text": " ثنى الشعبيُّ، قال: كان شريحٌ يُجيزُ شهادةَ صاحبِ كلِّ عملٍ إذا تاب إلا القاذفَ. قال ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "SPEAKER",
          "start": 7541,
          "end": 7547,
          "span_id": "s099"
        }
      ]
    },
    {
      "id": "s100",
      "start": 7638,
      "end": 7704,
      "text": ": توبتُه فيما بينَه وبينَ ربِّه، ولا نُجيزُ شهادتَه.حدَّثنا حميدُ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7690,
          "end": 7697,
          "span_id": "s100"
        }
      ]
    },
    {
      "id": "s101",
      "start": 7721,
      "end": 7767,
      "text": " بنُ مَسعَدةَ، قال: ثنا يزيدُ، قال: ثنا أشعتُ ",
      "markers": []
    },
    {
      "id": "s102",
      "start": 7784,
      "end": 7849,
      "text": " بنُ سَوَّارٍ، قال: ثنا الشعبيُّ، عن شُريحٍ بنحوِه، غيرَ أنه قال:",
      "markers": []
    },
    {
      "id": "s103",
      "start": 7849,
      "end": 7889,
      "text": " صاحبُ كلِّ حدٍّ إذا كان عدلًا يوم شهِد ",
      "markers": []
    },
    {
      "id": "s104",
      "start": 7928,
      "end": 8011,
      "text": ".حدَّثني أبو السائبِ، قال: ثنا أبو معاويةَ، عن الأعمشِ، عن إبراهيمَ، عن شريحٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7972,
          "end": 8011,
          "stripped": "عن الأعمش، عن إبراهيم، عن شريح، قال:",
          "span_id": "s104"
        }
      ]
    },
    {
      "id": "s105",
      "start": 8011,
      "end": 8049,
      "text": " كان لا يُجيزُ شهادةَ القاذفِ، ويقولُ:",
      "markers": []
    },
    {
      "id": "s106",
      "start": 8049,
      "end": 8080,
      "text": " توبتُه فيما بينَه وبينَ ربِّه.",
      "markers": []
    },
    {
      "id": "s107",
      "start": 8080,
      "end": 8117,
      "text": "حدَّثنا أبو كريبٍ وأبو السائبِ، قالا:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8080,
          "end": 8087,
          "span_id": "s107"
        }
      ]
    },
    {
      "id": "s108",
      "start": 8117,
      "end": 8196,
      "text": " ثنا ابن إدريسَ، عن مُطرِّفٍ، عن أبي عثمانَ، عن شريحٍ في القاذفِ: يقبلُ اللهُ ت",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 8134,
          "end": 8187,
          "stripped": "عن مطرف، عن أبي عثمان، عن شريح في القاذف: يقبل",
          "span_id": "s108"
        },
        {
          "family": "SAHABA",
          "marker": "عثمان",
          "name": "عثمان",
          "role": "NARRATOR",
          "start": 8154,
          "end": 8159,
          "span_id": "s108"
        }
      ]
    }
  ],

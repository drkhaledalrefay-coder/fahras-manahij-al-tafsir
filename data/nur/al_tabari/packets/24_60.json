        }
      ]
    },
    {
      "id": "s025",
      "start": 2603,
      "end": 2683,
      "text": " ثني حجاجٌ، قال: قال ابن جريجٍ في قولِه: {وَالْقَوَاعِدُ مِنَ النِّسَاءِ}: التي ",
      "markers": [
        {
          "family": "TABIIN",

  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 257,
      "text": " {وَالْقَوَاعِدُ مِنَ النِّسَاءِ اللَّاتِي لَا يَرْجُونَ نِكَاحًا فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَنْ يَضَعْنَ ثِيَابَهُنَّ غَيْرَ مُتَبَرِّجَاتٍ بِزِينَةٍ وَأَنْ يَسْتَعْفِفْنَ خَيْرٌ لَهُنَّ وَاللَّهُ سَمِيعٌ عَلِيمٌ (60)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 256,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 257,
      "end": 418,
      "text": "يقولُ تعالى ذكرُه: واللَّواتى قد قَعَدْنَ عن الولدِ مِن الكِبَرِ مِن النساءِ، فلا يَحِضْنَ ولا يَلِدْنَ - واحِدتُهنَّ قاعدٌ - {اللَّاتِي لَا يَرْجُونَ نِكَاحًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 383,
          "end": 417,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 418,
      "end": 547,
      "text": " يقولُ: اللاتي قد يَئِسْنَ مِن البُعُولةِ، فلا يَطْمَعْنَ في الأزواجِ، {فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَنْ يَضَعْنَ ثِيَابَهُنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 489,
          "end": 546,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 547,
      "end": 613,
      "text": " يقولُ: فليس عليهنَّ حَرَجٌ ولا إثمٌ {أَنْ يَضَعْنَ ثِيَابَهُنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 584,
          "end": 612,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 613,
      "end": 797,
      "text": "يعني: جَلَابِيبَهنَّ، وهى القِناعُ الذي يكونُ فوقَ الخِمارِ، والرداءُ الذي يكونُ فوقَ الثيابِ، لا حرَجَ عليهنَّ أن يَضَعْنَ ذلك عندَ المحارمِ مِن الرجالِ، وغيرِ المحارمِ مِن الغُرباءِ ",
      "markers": []
    },
    {
      "id": "s007",
      "start": 817,
      "end": 887,
      "text": "، غيرَ مُتَبرِّجاتٍ بزينةٍ.وبنحوِ الذي قُلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s008",
      "start": 887,
      "end": 922,
      "text": "ذكرُ مَن قال ذلكحدَّثني عليٌّ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 911,
          "end": 914,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 922,
      "end": 1028,
      "text": " ثنا أبو صالحٍ، قال: ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ قولَه: {وَالْقَوَاعِدُ مِنَ النِّسَاءِ اللَّاتِي ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 956,
          "end": 1000,
          "stripped": "عن علي، عن ابن عباس قوله: {والقواعد",
          "span_id": "s009"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 959,
          "end": 962,
          "span_id": "s009"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 969,
          "end": 977,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 1032,
      "end": 1193,
      "text": "لَا يَرْجُونَ نِكَاحًا}: وهى المرأةُ، لا جُناحَ عليها أن تجلسَ في بيتِها بدِرْعٍ وخِمارٍ، وتَضَعَ عنها الجلبابَ، ما لم تَتَبرَّجْ لِما يكرَهُ اللَّهُ، وهو قولُه:",
      "markers": []
    },
    {
      "id": "s011",
      "start": 1193,
      "end": 1284,
      "text": " {فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَنْ يَضَعْنَ ثِيَابَهُنَّ غَيْرَ مُتَبَرِّجَاتٍ بِزِينَةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1194,
          "end": 1283,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 1284,
      "end": 1332,
      "text": " ثم قال: {وَأَنْ يَسْتَعْفِفْنَ خَيْرٌ لَهُنَّ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1293,
          "end": 1331,
          "span_id": "s012"
        }
      ]
    },
    {
      "id": "s013",
      "start": 1451,
      "end": 1502,
      "text": ".حُدِّثْتُ عن الحسينِ، قال: سمِعتُ أبا معاذٍ يقولُ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 1490,
          "end": 1494,
          "span_id": "s013"
        }

    },
    {
      "id": "s023",
      "start": 2500,
      "end": 2564,
      "text": " يقولُ: إِذا كان زِيُّهِنَّ حَسَنًا لم يَطْمَعْ فيهن المُنافقون.",
      "markers": []
    },
    {
      "id": "s024",
      "start": 2564,
      "end": 2603,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",

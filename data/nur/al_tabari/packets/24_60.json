    },
    {
      "id": "s018",
      "start": 2027,
      "end": 2052,
      "text": ". وكان بالمدينةِ رجالٌ مِ",
      "markers": []
    },
    {
      "id": "s019",
      "start": 2056,
      "end": 2098,
      "text": "ن المنافِقين إذا مَرَّتْ بهم امرأةٌ سيئةُ ",
      "markers": []
    },
    {
      "id": "s020",
      "start": 2115,
      "end": 2164,
      "text": " الهيئةِ والزَّيِّ، حَسِبَ المنافقون أنها مريبةٌ ",
      "markers": []
    },
    {
      "id": "s021",
      "start": 2208,
      "end": 2327,
      "text": "، وأنها مِن بُغْيِتهم، فكانوا يُؤْذُون المؤمناتِ بالرَّفَثِ، ولا يَعْلَمون الحُرَّةَ مِن الأَمَةِ، فأنزَل اللهُ في ذلك:",
      "markers": [
        {
          "family": "NUZUL",

        }
      ]
    },
    {
      "id": "s026",
      "start": 2715,
      "end": 2761,
      "text": " قَعَدَت مِن الولدِ وكَبِرَت. قال ابن جُرَيجٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 2749,
          "end": 2759,
          "span_id": "s026"
        }
      ]
    },
    {
      "id": "s027",
      "start": 2761,
      "end": 2809,
      "text": " قال مجاهدٌ: {اللَّاتِي لَا يَرْجُونَ نِكَاحًا}.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 2766,
          "end": 2771,
          "span_id": "s027"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2774,
          "end": 2808,
          "span_id": "s027"
        }
      ]
    },
    {
      "id": "s028",
      "start": 2809,
      "end": 2907,
      "text": " قال: لا يُرِدْنَه، {فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَنْ يَضَعْنَ ثِيَابَهُنَّ}. قال: جَلابِيبَهنَّ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2829,
          "end": 2886,
          "span_id": "s028"
        }
      ]
    },
    {
      "id": "s029",
      "start": 3091,
      "end": 3134,
      "text": ".حدَّثني يونسُ، قال: أخبرَنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3112,
          "end": 3119,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 3134,
      "end": 3157,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 3139,
          "end": 3146,
          "span_id": "s030"
        }
      ]
    },
    {
      "id": "s031",
      "start": 3157,
      "end": 3312,
      "text": " {وَالْقَوَاعِدُ مِنَ النِّسَاءِ اللَّاتِي لَا يَرْجُونَ نِكَاحًا فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَنْ يَضَعْنَ ثِيَابَهُنَّ غَيْرَ مُتَبَرِّجَاتٍ بِزِينَةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3158,
          "end": 3311,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 3312,
      "end": 3506,
      "text": " قال: وَضْعُ الخِمارِ. قال: للتى لا تَرْجُو نِكاحًا، التي قد بَلَغَت ألا يكون لها في الرجالِ حاجةٌ، ولا للرجالِ فيها حاجةٌ، فإذا بَلَغْنَ ذلك وَضَعْن الخِمارَ، غيرَ مُتَبَرِّجاتٍ بزينةٍ، ثم قال:",
      "markers": []
    },
    {
      "id": "s033",
      "start": 3506,
      "end": 3570,
      "text": " {وَأَنْ يَسْتَعْفِفْنَ خَيْرٌ لَهُنَّ} كان أبي يقولُ هذا كلَّه ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3507,
          "end": 3545,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 3634,
      "end": 3687,
      "text": ".حدَّثنا ابن بشارٍ، قال: ثنا يحيى وعبدُ الرحمن، قالا:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3635,
          "end": 3642,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 3687,
      "end": 3731,
      "text": " ثنا سفيانُ، عن علقمةَ بن مَرْثَدٍ، عن زرٍّ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3700,
          "end": 3728,
          "stripped": "عن علقمة بن مرثد، عن زر",
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 3748,
      "end": 3789,
      "text": "، عن أبي وائلٍ، عن عبدِ اللَّهِ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3750,
          "end": 3789,
          "stripped": "عن أبي وائل، عن عبد الله في قوله:",
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 3789,
      "end": 3848,
      "text": " {فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَنْ يَضَعْنَ ثِيَابَهُنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3790,
          "end": 3847,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 3848,
      "end": 3889,
      "text": " قال: الجِلْبابَ أو الرداءَ. شكَّ سفيانُ ",
      "markers": []
    },
    {
      "id": "s039",
      "start": 4025,
      "end": 4053,
      "text": ".قال: ثنا عبدُ الرحمنِ، قال:",
      "markers": []
    },
    {
      "id": "s040",
      "start": 4053,
      "end": 4102,
      "text": " ثنا سفيانُ، عن الأعمشِ، عن مالكِ بن الحارثِ، عن ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4066,
          "end": 4101,
          "stripped": "عن الأعمش، عن مالك بن الحارث، عن",
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 4106,
      "end": 4145,
      "text": "عبدِ الرحمنِ بن يزيدَ، عن عبدِ اللَّهِ:",
      "markers": []
    },
    {
      "id": "s042",
      "start": 4145,
      "end": 4204,
      "text": " {فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَنْ يَضَعْنَ ثِيَابَهُنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4146,
          "end": 4203,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 4204,
      "end": 4262,
      "text": " قال: الرِّداءُ.حدَّثني يحيى بنُ إبراهيمَ المسعوديُّ، قال:",
      "markers": []
    },
    {
      "id": "s044",
      "start": 4262,
      "end": 4354,
      "text": " ثنا أبي، عن أبيه، عن جَدِّه، عن الأعمش، عن مالكِ بن الحارثِ، عن عبدِ الرحمنِ بن يزيدَ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4272,
          "end": 4314,
          "stripped": "عن أبيه، عن جده، عن الأعمش، عن مالك بن",
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 4354,
      "end": 4384,
      "text": " قال عبدُ اللهِ في هذه الآيةِ:",
      "markers": []
    },
    {
      "id": "s046",
      "start": 4384,
      "end": 4443,
      "text": " {فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَنْ يَضَعْنَ ثِيَابَهُنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4385,
          "end": 4442,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 4443,
      "end": 4495,
      "text": " قال: هي المِلْحَفَةُ.حدَّثنا محمدُ بنُ المثنى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4465,
          "end": 4472,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 4495,
      "end": 4521,
      "text": " ثنا محمدُ بنُ جعفرٍ، قال:",
      "markers": []
    },
    {
      "id": "s049",
      "start": 4521,
      "end": 4548,
      "text": " ثنا شعبةُ، عن الحكمِ، قال:",
      "markers": []
    },
    {
      "id": "s050",
      "start": 4548,
      "end": 4610,
      "text": " سمِعتُ أبا وائلٍ، قال: سمِعتُ عبدَ اللهِ يقولُ في هذه الآيةِ:",
      "markers": []
    },
    {
      "id": "s051",
      "start": 4610,
      "end": 4686,
      "text": " {فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَنْ يَضَعْنَ ثِيَابَهُنَّ}. قال: الجِلْبابَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4611,
          "end": 4668,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4757,
      "end": 4762,
      "text": ".قال ",
      "markers": []
    },
    {
      "id": "s053",
      "start": 4780,
      "end": 4820,
      "text": ": حدَّثنا يحيى بنُ سعيدٍ، عن شعبةَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4782,
          "end": 4789,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4820,
      "end": 4873,
      "text": " أخبَرني الحَكَمُ، عن أبي وائلٍ، عن عبدِ اللهِ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4839,
          "end": 4873,
          "stripped": "عن أبي وائل، عن عبد الله مثله.",
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4873,
      "end": 4902,
      "text": "حدَّثنا الحسنُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4873,
          "end": 4880,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4902,
      "end": 5020,
      "text": " أخبَرنا عبدُ الرزاقِ، عن الثوريِّ، عن الأعمشِ، عن مالكِ بن الحارثِ، عن عبدِ الرحمنِ بن يزيدَ، عن ابن مسعودٍ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4903,
          "end": 4910,
          "span_id": "s056"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4925,
          "end": 4973,
          "stripped": "عن الثوري، عن الأعمش، عن مالك بن الحارث، عن",
          "span_id": "s056"
        },
        {
          "family": "SAHABA",
          "marker": "ابن مسعود",
          "name": "ابن مسعود",
          "role": "SPEAKER",
          "start": 5000,
          "end": 5009,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 5020,
      "end": 5099,
      "text": " {أَنْ يَضَعْنَ ثِيَابَهُنَّ غَيْرَ مُتَبَرِّجَاتٍ بِزِينَةٍ}. قال: هو الرداءُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5021,
          "end": 5081,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 5170,
      "end": 5200,
      "text": ".قال الحسنُ: قال عبدُ الرزاقِ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 5175,
          "end": 5180,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 5200,
      "end": 5289,
      "text": " قال الثوريُّ: وأخبرَني أبو حَصِينٍ وسالمٌ الأفطسُ، عن سعيدِ بن جُبَيرٍ، قال: هو الرداءُ ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 5255,
          "end": 5270,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 5314,
      "end": 5373,
      "text": ".حدَّثنا ابن حميدٍ، قال: ثنا جريرٌ، عن مغيرةَ، عن الشعبيِّ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5315,
          "end": 5322,
          "span_id": "s060"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5350,
          "end": 5373,
          "stripped": "عن مغيرة، عن الشعبي:",
          "span_id": "s060"
        },
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "SPEAKER",
          "start": 5364,
          "end": 5370,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 5373,
      "end": 5435,
      "text": " {أَنْ يَضَعْنَ ثِيَابَهُنَّ غَيْرَ مُتَبَرِّجَاتٍ بِزِينَةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5374,
          "end": 5434,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 5435,
      "end": 5514,
      "text": " قال: تَضَعُ الجلبابَ المرأةُ التي قد عَجَزَت ولم تَزَوَّجُ. قال الشعبيُّ: فإن ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "SPEAKER",
          "start": 5500,
          "end": 5506,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 5533,
      "end": 5574,
      "text": " أبيَّ بنَ كعبٍ يقرأُ: (أن يَضَعْنَ مِنْ ",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 5550,
          "end": 5553,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 5591,
      "end": 5603,
      "text": " ثِيابِهنَّ ",
      "markers": []
    },
    {
      "id": "s065",
      "start": 5663,
      "end": 5697,
      "text": ".حدَّثني يعقوبُ بنُ إبراهيمَ، قال:",
      "markers": []
    },
    {
      "id": "s066",
      "start": 5697,
      "end": 5749,
      "text": " ثنا ابن عُلَيَّةَ، قال: قلتُ لابنِ أبي نجيحٍ قولَه:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 5722,
          "end": 5725,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 5749,
      "end": 5840,
      "text": " {فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَنْ يَضَعْنَ ثِيَابَهُنَّ غَيْرَ مُتَبَرِّجَاتٍ بِزِينَةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5750,
          "end": 5839,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 5840,
      "end": 5882,
      "text": " قال: الجلبابُ. قال يعقوبُ: قال أبو يونسَ:",
      "markers": []
    },
    {
      "id": "s069",
      "start": 5882,
      "end": 5907,
      "text": " قلتُ له: عن مجاهدٍ؟ قال:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 5883,
          "end": 5886,
          "span_id": "s069"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 5895,
          "end": 5900,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 5907,
      "end": 5960,
      "text": " نعم، في الدارِ والحجرة.حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s071",
      "start": 5960,
      "end": 6013,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، وحدَّثني الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s072",
      "start": 6013,
      "end": 6084,
      "text": " ثنا الحسنُ، قال: ثنا ورقاءُ، جميعًا عن ابن أبي نجيحٍ، عن مجاهدٍ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 6018,
          "end": 6023,
          "span_id": "s072"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6050,
          "end": 6084,
          "stripped": "عن ابن أبي نجيح، عن مجاهد قوله:",
          "span_id": "s072"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 6071,
          "end": 6076,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 6084,
      "end": 6150,
      "text": " {فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَنْ يَضَعْنَ ثِيَابَهُنَّ}. قال: ج",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6085,
          "end": 6142,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 6154,
      "end": 6168,
      "text": "َلابِيبَهُنَّ ",
      "markers": []
    },
    {
      "id": "s075",
      "start": 6204,
      "end": 6254,
      "text": ".وقولُه: {غَيْرَ مُتَبَرِّجَاتٍ بِزِينَةٍ}. يقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6213,
          "end": 6246,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 6254,
      "end": 6387,
      "text": " ليس عليهنَّ جناحٌ في وَضْعِ أَرْدِيتِهِنَّ إذا لم يُرِدْنَ بوضعِ ذلك عنهن أن يُبْدِينَ ما عليهنَّ مِن الزينةِ للرجالِ.والتَّبَرُّجُ ",
      "markers": []
    },
    {
      "id": "s077",
      "start": 6401,
      "end": 6467,
      "text": " هو أن تُظْهِرَ المرأةُ مِن مَحاسنِها ما ينبَغِي لها أن تَسْتُرَه.",
      "markers": []
    },
    {
      "id": "s078",
      "start": 6467,
      "end": 6521,
      "text": "وقوله: {وَأَنْ يَسْتَعْفِفْنَ خَيْرٌ لَهُنَّ}. يقولُ: ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6474,
          "end": 6512,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 6535,
      "end": 6536,
      "text": " ",
      "markers": []
    },
    {
      "id": "s080",
      "start": 6558,
      "end": 6643,
      "text": " عن وَضْعِ جَلابيبِهنَّ وأَرْدِيتِهنَّ، فيُلْبِسْنَها، خيرٌ لهنَّ مِن أَن يَضَعْنَها.",
      "markers": []
    },
    {
      "id": "s081",
      "start": 6643,
      "end": 6687,
      "text": "وبنحوِ الذي قُلْنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s082",
      "start": 6687,
      "end": 6732,
      "text": "ذكرُ مَن قال ذلكحدَّثنا محمدُ بنُ عمرٍو، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6703,
          "end": 6710,
          "span_id": "s082"
        }
      ]
    },
    {
      "id": "s083",
      "start": 6732,
      "end": 6785,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، وحدَّثنى الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s084",
      "start": 6785,
      "end": 6850,
      "text": " ثنا الحسنُ، قال: ثنا ورقاءُ، جميعًا عن ابن أبي نجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 6790,
          "end": 6795,
          "span_id": "s084"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6822,
          "end": 6850,
          "stripped": "عن ابن أبي نجيح، عن مجاهد:",
          "span_id": "s084"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 6843,
          "end": 6848,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 6850,
      "end": 6924,
      "text": " {وَأَنْ يَسْتَعْفِفْنَ خَيْرٌ لَهُنَّ}. قال: أَن يَلْبِسْنَ جَلَابِيبَهن ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6851,
          "end": 6889,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 6986,
      "end": 7047,
      "text": ".حدَّثنا ابن حميدٍ، قال: ثنا جريرٌ، عن مُغِيرةً، عن الشعبيِّ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6987,
          "end": 6994,
          "span_id": "s086"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7022,
          "end": 7047,
          "stripped": "عن مغيرة، عن الشعبي:",
          "span_id": "s086"
        },
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "SPEAKER",
          "start": 7038,
          "end": 7044,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 7047,
      "end": 7092,
      "text": " {وَأَنْ يَسْتَعْفِفْنَ خَيْرٌ لَهُنَّ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7048,
          "end": 7086,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 7092,
      "end": 7128,
      "text": " تَرْكُ ذلك. يعنى تركَ وضعِ الثيابِ.",
      "markers": []
    },
    {
      "id": "s089",
      "start": 7128,
      "end": 7175,
      "text": "حدَّثني يونسُ، قال: أخبرَنا ابن وهبٍ، قال: قال ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 7148,
          "end": 7155,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 7179,
      "end": 7263,
      "text": "ابن زيدٍ في قولِه: {وَأَنْ يَسْتَعْفِفْنَ خَيْرٌ لَهُنَّ}. قال: والاسْتِعفافُ شَلُّ ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 7179,
          "end": 7186,
          "span_id": "s090"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7198,
          "end": 7236,
          "span_id": "s090"
        }
      ]
    },
    {
      "id": "s091",
      "start": 7343,
      "end": 7388,
      "text": " الخمارِ على رأسِها، كان أبي يقولُ هذا كلَّه.",
      "markers": []
    },
    {
      "id": "s092",
      "start": 7422,
      "end": 7423,
      "text": " ",
      "markers": []
    },
    {
      "id": "s093",
      "start": 7450,
      "end": 7642,
      "text": " بألسنتِكم، {عَلِيمٌ} بما تُضْمِرُه صُدُورُكم، فاتَّقُوه أن تَنْطِقوا بألسنتِكم ما قد نَهاكم عن أن تَنْطِقوا بها، أو تُضْمِروا في صُدُورِكم ما قد كَرِهَه لكم، فتَسْتَوْجِبوا بذلك منه عُقوبَةً ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7462,
          "end": 7471,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 7661,
      "end": 7663,
      "text": ". ",
      "markers": []
    }
  ],

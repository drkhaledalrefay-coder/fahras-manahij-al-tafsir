    },
    {
      "id": "s014",
      "start": 1502,
      "end": 1553,
      "text": " أخبرَنا عبيدٌ، قال: سمِعتُ الضحاكَ يقولُ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 1503,
          "end": 1510,
          "span_id": "s014"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 1530,
          "end": 1536,
          "span_id": "s014"
        }
      ]
    },
    {
      "id": "s015",
      "start": 1553,
      "end": 1693,
      "text": " {يَضَعْنَ ثِيَابَهُنَّ}: يعنى الجلبابَ، وهو القِناعُ، وهذا للكبيرةِ التي قد قَعَدَت عن الولدِ، فلا يَضُرُّها أَلا تَجَلْبَبَ فوقَ الخِمارِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1554,
          "end": 1577,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1788,
      "end": 1920,
      "text": ". وأما كلُّ امرأةٍ مسلمةٍ حُرَّةٍ، فعليها إذا بَلَغَت المَحِيضَ أَن تُدْنِيَ الجِلْبابَ على الخِمارِ، وقال اللهُ في سورةِ \"الأحزاب\":",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1920,
      "end": 2014,
      "text": " {يُدْنِينَ عَلَيْهِنَّ مِنْ جَلَابِيبِهِنَّ ذَلِكَ أَدْنَى أَنْ يُعْرَفْنَ فَلَا يُؤْذَيْنَ} ",

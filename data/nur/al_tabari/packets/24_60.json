          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 2327,
      "end": 2500,
      "text": " {يَاأَيُّهَا النَّبِيُّ قُلْ لِأَزْوَاجِكَ وَبَنَاتِكَ وَنِسَاءِ الْمُؤْمِنِينَ يُدْنِينَ عَلَيْهِنَّ مِنْ جَلَابِيبِهِنَّ ذَلِكَ أَدْنَى أَنْ يُعْرَفْنَ فَلَا يُؤْذَيْنَ}.",
      "markers": [
        {

    },
    {
      "id": "s009",
      "start": 646,
      "end": 732,
      "text": " الخبيثاتُ مِن القولِ للخبيثين مِن الرجالِ، والخبيثون مِن الرجالِ للخبيثاتِ مِن القول.",
      "markers": []

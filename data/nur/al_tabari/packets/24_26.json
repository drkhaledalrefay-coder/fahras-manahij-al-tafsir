          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 576,
      "end": 646,
      "text": " {الْخَبِيثَاتُ لِلْخَبِيثِينَ وَالْخَبِيثُونَ لِلْخَبِيثَاتِ}. يقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 577,
          "end": 638,
          "span_id": "s008"
        }

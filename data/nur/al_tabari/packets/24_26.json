    },
    {
      "id": "s033",
      "start": 2381,
      "end": 2444,
      "text": " يقولُ: الخبيثاتُ والطيباتُ: القولُ السيءُ والحَسَنُ؛ للمؤمنين ",
      "markers": []
    },
    {
      "id": "s034",
      "start": 2471,
      "end": 2492,
      "text": " الحَسَنُ، وللكافرين ",
      "markers": []
    },
    {
      "id": "s035",
      "start": 2549,
      "end": 2601,
      "text": " السيئُ، {أُولَئِكَ مُبَرَّءُونَ مِمَّا يَقُولُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2558,
          "end": 2600,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 2601,
      "end": 2659,
      "text": " وذلك بأنَّه ما قال الكافرون مِن كلمةٍ طيبةٍ فهى للمؤمنين ",
      "markers": []
    },
    {
      "id": "s037",
      "start": 2691,
      "end": 2778,
      "text": "، وما قال المؤمنون مِن كلمةٍ خبيثةٍ فهي للكافرين، كلٌّ برئٌ مما ليسَ بحقٍّ مِن الكلامِ ",
      "markers": []
    },
    {
      "id": "s038",
      "start": 2956,
      "end": 2986,
      "text": ".حدَّثنا ابن عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2957,
          "end": 2964,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 2986,
      "end": 3076,
      "text": " ثنا ابن ثَوْرٍ، عن معمرٍ، عن ابن أبي نجيحٍ، عن مجاهدٍ: {الْخَبِيثَاتُ لِلْخَبِيثِينَ}. قا",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3003,
          "end": 3033,
          "stripped": "عن معمر، عن ابن أبي نجيح، عن",
          "span_id": "s039"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3034,
          "end": 3039,
          "span_id": "s039"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3042,
          "end": 3072,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3080,
      "end": 3169,
      "text": "ل: الخبيثاتُ مِن الكلامِ للخبيثين مِن الناسِ، والخبيثون مِن الناسِ للخبيثاتِ مِن الكلامِ ",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3228,
      "end": 3324,
      "text": ".حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، قال أخبَرنا معمرٌ، عن ابن أبي نجيحٍ عن مجاهدٍ مثلَه ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3229,
          "end": 3236,
          "span_id": "s041"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 3229,
          "end": 3297,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال أخبرنا معمر، عن ابن",
          "span_id": "s041"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "NARRATOR",
          "start": 3237,
          "end": 3242,
          "span_id": "s041"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3250,
          "end": 3257,
          "span_id": "s041"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3276,
          "end": 3283,
          "span_id": "s041"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3291,
          "end": 3323,
          "stripped": "عن ابن أبي نجيح عن مجاهد مثله",
          "span_id": "s041"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 3311,
          "end": 3316,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 3349,
      "end": 3400,
      "text": ".حُدِّثْتُ عن الحسينِ، قال: سمِعتُ أبا معاذٍ يقولُ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 3388,
          "end": 3392,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3400,
      "end": 3451,
      "text": " أخبَرنا عبيدٌ، قال: سمِعتُ الضحاكَ يقولُ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3401,
          "end": 3408,
          "span_id": "s043"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 3428,
          "end": 3434,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 3451,
      "end": 3730,
      "text": " {الْخَبِيثَاتُ لِلْخَبِيثِينَ} الآية. يقولُ: الخبيثاتُ مِن القولِ للخبيثين من الرجالِ، والخبيثون مِن الرجالِ للخبيثاتِ مِن القولِ، والطيباتُ مِن القولِ للطيبين مِن الرجالِ، والطيبون مِن الرجالِ للطيباتِ مِن القولِ، فهذا في الكلامِ، وهم الذين قالوا لعائشةَ ما قالوا، هم الخبيثون.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3452,
          "end": 3482,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3730,
      "end": 3772,
      "text": " والطيبون هم المبرَّءُون مما قال الخبيثون.",
      "markers": []
    },
    {
      "id": "s046",
      "start": 3772,
      "end": 3817,
      "text": "حدَّثنا أبو زرعةَ، قال: ثنا أبو نُعَيمٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3772,
          "end": 3779,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3817,
      "end": 3870,
      "text": " ثنا سلمةُ، يعنى ابنَ نُبَيْطٍ الأشجعيَّ، عن الضحاكِ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 3862,
          "end": 3868,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3870,
      "end": 3992,
      "text": " {الْخَبِيثَاتُ لِلْخَبِيثِينَ}. قال: الخبيثاتُ مِن الكلامِ للخبيثين مِن الناسِ، والطيباتُ مِن الكلامِ للطيبين مِن الناسِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3871,
          "end": 3901,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 4092,
      "end": 4100,
      "text": ".قال: ثن",
      "markers": []
    },
    {
      "id": "s050",
      "start": 4104,
      "end": 4178,
      "text": "ا قبيصةُ، قال: ثنا سفيانُ، عن ابن أبي نجيحٍ وعثمانَ بن الأسودٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 4171,
          "end": 4176,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 4178,
      "end": 4303,
      "text": " {الْخَبِيثَاتُ لِلْخَبِيثِينَ وَالْخَبِيثُونَ لِلْخَبِيثَاتِ وَالطَّيِّبَاتُ لِلطَّيِّبِينَ وَالطَّيِّبُونَ لِلطَّيِّبَاتِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4179,
          "end": 4302,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4303,
      "end": 4476,
      "text": " قال: الخبيثاتُ مِن الكلامِ للخبيثين مِن الناسِ، والخبيثون مِن الناسِ للخبيثاتِ مِن القولِ، والطيباتُ مِن القولِ للطيبين مِن الناسِ، والطيبون مِن الناسِ للطيباتِ مِن القولِ.",
      "markers": []
    },
    {
      "id": "s053",
      "start": 4476,
      "end": 4530,
      "text": "قال: ثنا سفيانُ، عن خُصيفٍ، عن سعيدِ بن جُبَيْرٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4493,
          "end": 4530,
          "stripped": "عن خصيف، عن سعيد بن جبير، قال:",
          "span_id": "s053"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 4507,
          "end": 4523,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4530,
      "end": 4655,
      "text": " {الْخَبِيثَاتُ لِلْخَبِيثِينَ وَالْخَبِيثُونَ لِلْخَبِيثَاتِ وَالطَّيِّبَاتُ لِلطَّيِّبِينَ وَالطَّيِّبُونَ لِلطَّيِّبَاتِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4531,
          "end": 4654,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4655,
      "end": 4827,
      "text": " قال: الخبيثاتُ مِن القولِ للخبيثين مِن الناسِ، والخبيثون مِن الناسِ للخبيثاتِ مِن القولِ، والطيباتُ مِن القولِ للطيبين مِن الناسِ، والطيبون مِن الناسِ للطيباتِ مِن القولِ ",
      "markers": []
    },
    {
      "id": "s056",
      "start": 4953,
      "end": 4977,
      "text": ".قال: ثنى محمدُ بنُ أبى ",
      "markers": []
    },
    {
      "id": "s057",
      "start": 5017,
      "end": 5124,
      "text": " بكرِ بن مُقَدَّمٍ، قال: أخبَرنا يحيى بنُ سعيدٍ، عن عبدِ الملكِ، يعنى ابنَ أبى سليمانَ، عن القاسمِ بن أبى ب",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 5042,
          "end": 5049,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 5128,
      "end": 5167,
      "text": "َزَّةَ، عن سعيدِ بن جُبَيرٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5136,
          "end": 5167,
          "stripped": "عن سعيد بن جبير، عن مجاهد:",
          "span_id": "s058"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "NARRATOR",
          "start": 5139,
          "end": 5154,
          "span_id": "s058"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 5160,
          "end": 5165,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 5167,
      "end": 5247,
      "text": " {وَالْخَبِيثُونَ لِلْخَبِيثَاتِ}. قال: الخبيثاتُ مِن القولِ للخبيثين مِن الناس ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5168,
          "end": 5200,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 5497,
      "end": 5543,
      "text": ".قال: ثنا عباسُ بنُ الوليدِ النَّرْسِيُّ، قال:",
      "markers": []
    },
    {
      "id": "s061",
      "start": 5543,
      "end": 5572,
      "text": " ثنا يزيدُ بنُ زُرَيْعٍ، قال:",
      "markers": []
    },
    {
      "id": "s062",
      "start": 5572,
      "end": 5719,
      "text": " ثنا سعيدٌ، عن قتادةَ: {الْخَبِيثَاتُ لِلْخَبِيثِينَ وَالْخَبِيثُونَ لِلْخَبِيثَاتِ وَالطَّيِّبَاتُ لِلطَّيِّبِينَ وَالطَّيِّبُونَ لِلطَّيِّبَاتِ}.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 5587,
          "end": 5592,
          "span_id": "s062"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5595,
          "end": 5718,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 5719,
      "end": 5827,
      "text": " يقولُ: الخبيثاتُ مِن القولِ والعملِ للخبيثين مِن الناسِ، والخبيثون مِن الناسِ للخبيثاتِ مِن القولِ والعملِ ",
      "markers": []
    },
    {
      "id": "s064",
      "start": 5966,
      "end": 6033,
      "text": ".حدَّثنا ابن وكيعٍ، قال: ثنا أبي، عن طلحةَ بن عمروٍ، عن عطاءٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5967,
          "end": 5974,
          "span_id": "s064"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6000,
          "end": 6033,
          "stripped": "عن طلحة بن عمرو، عن عطاء، قال:",
          "span_id": "s064"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 6022,
          "end": 6026,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 6033,
      "end": 6103,
      "text": " {وَالطَّيِّبَاتُ لِلطَّيِّبِينَ وَالطَّيِّبُونَ لِلطَّيِّبَاتِ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6034,
          "end": 6097,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 6103,
      "end": 6148,
      "text": " الطيباتُ مِن القولِ للطيبين مِن الناسِ، والط",
      "markers": []
    },
    {
      "id": "s067",
      "start": 6152,
      "end": 6274,
      "text": "يبون مِن الناسِ للطيباتِ مِن القولِ، والخبيثاتُ مِن القولِ للخبيثين مِن الناسِ، والخبيثون مِن الناسِ للخبيثاتِ مِن القولِ ",
      "markers": []
    },
    {
      "id": "s068",
      "start": 6402,
      "end": 6427,
      "text": ".وقال آخرون: بل معنى ذلك:",
      "markers": []
    },
    {
      "id": "s069",
      "start": 6427,
      "end": 6515,
      "text": " الخبيثاتُ مِن النساءِ للخبيثين مِن الرجال، والخبيثون مِن الرجالِ للخبيثاتِ مِن النساءِ.",
      "markers": []
    },
    {
      "id": "s070",
      "start": 6515,
      "end": 6550,
      "text": "ذِكرُ مَن قال ذلكحدَّثني يونس، قال:",
      "markers": []
    },
    {
      "id": "s071",
      "start": 6550,
      "end": 6598,
      "text": " أخبَرنا ابن وهبٍ، قال: قال ابن زَيْدٍ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6551,
          "end": 6558,
          "span_id": "s071"
        },
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 6578,
          "end": 6587,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 6598,
      "end": 6723,
      "text": " {الْخَبِيثَاتُ لِلْخَبِيثِينَ وَالْخَبِيثُونَ لِلْخَبِيثَاتِ وَالطَّيِّبَاتُ لِلطَّيِّبِينَ وَالطَّيِّبُونَ لِلطَّيِّبَاتِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6599,
          "end": 6722,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 6723,
      "end": 6811,
      "text": " قال: نزَلت في عائشةَ حينَ رماها المنافقُ بالبهتانِ والفِرْيْةِ، فبرَّأها اللهُ مِن ذلك.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "نزلت في",
          "start": 6729,
          "end": 6737,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 6811,
      "end": 7080,
      "text": " وكان عبدُ اللهِ بنُ أُبيٍّ هو خبيثٌ، وكان هو أَوْلَى بأن تكونَ له الخبيثةُ ويكونَ لها، وكان رسولُ اللهِ - صلى الله عليه وسلم - طيبًا، وكان أَوْلَى أن تكونَ له الطيبةُ، وكانت عائشةُ الطيبةَ، وكانَ أَوْلَى أن يكونَ لها الطيبُ، {أُولَئِكَ مُبَرَّءُونَ مِمَّا يَقُولُونَ}.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "ان رسول الله",
          "start": 6901,
          "end": 6914,
          "span_id": "s074"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6918,
          "end": 6936,
          "span_id": "s074"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7037,
          "end": 7079,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 7080,
      "end": 7146,
      "text": " قال: هاهنا بُرِّئتْ عائشةُ. {لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7109,
          "end": 7145,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 7265,
      "end": 7317,
      "text": ".وأَوْلَى هذه الأقوالِ في تأويلِ الآية قولُ مَن قال:",
      "markers": []
    },
    {
      "id": "s077",
      "start": 7317,
      "end": 7466,
      "text": " عَنَى بالخبيثاتِ: الخبيثاتِ مِن القولِ، وذلك قبيحُه وسيئُه، للخبيثين مِن الرجالِ والنساءِ، والخبيثون مِن الناسِ للخبيثاتِ مِن القولِ هم بها أَوْلَى؛",
      "markers": []
    },
    {
      "id": "s078",
      "start": 7466,
      "end": 7584,
      "text": " لأنَّهم أهلُها، والطيباتُ مِن القولِ، وذلك حسنُه وجميلُه، للطيبين مِن الناسِ، والطيبون مِن الناسِ للطيباتِ مِن القول؛",
      "markers": []
    },
    {
      "id": "s079",
      "start": 7584,
      "end": 7623,
      "text": " لأنَّهم أهلها وأحقُّ بها.وإنما قُلْنا:",
      "markers": []
    },
    {
      "id": "s080",
      "start": 7623,
      "end": 7658,
      "text": " هذا القولُ أَوْلَى بتأويلِ الآيةِ؛",
      "markers": []
    },
    {
      "id": "s081",
      "start": 7658,
      "end": 7909,
      "text": " لأنَّ الآياتِ قبلَ ذلك إنما جاءَت بتوبيخِ اللَّهِ للقائلين في عائشةَ الإفكَ، والرامين المحصناتِ الغافلاتِ المؤمناتِ، وإخبارِهم ما خَصَّهم به على إفكِهم، فكان ختمُ الخبرِ عن أَوْلَى الفريقين بالإفكِ مِن الرامي والمرميِّ به، أشبهَ مِن الخبرِ عن غيرِهم.",
      "markers": []
    },
    {
      "id": "s082",
      "start": 7909,
      "end": 8196,
      "text": "وقولُه: {أُولَئِكَ مُبَرَّءُونَ}. يقولُ: الطَّيبون مِن الناسِ مبرَّءون مِن خبيثاتِ القولِ، إن قالوها فإنَّ اللَّهَ يَصفحُ لهم عنها، ويَغْفِرُها لهم، وإن قِيلت فيهم ضرَّت قائلَها ولم تَضرَّهم، كما لو قال الطَّيِّبَ مِن القول الخبيثُ مِن الناسِ لم يَنْفَعُه الله به؛ لأنَّ الله لا يتقبَّلُ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7917,
          "end": 7941,
          "span_id": "s082"
        }
      ]
    },
    {
      "id": "s083",
      "start": 8200,
      "end": 8225,
      "text": "ه، ولو قِيلت له لضرَّتْه؛",
      "markers": []
    },
    {
      "id": "s084",
      "start": 8225,
      "end": 8277,
      "text": " لأنه يَلْحَقُه عارُها في الدنيا وذلُّها في الآخِرة.",
      "markers": []
    },
    {
      "id": "s085",
      "start": 8277,
      "end": 8328,
      "text": "كما حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8281,
          "end": 8288,
          "span_id": "s085"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 8281,
          "end": 8328,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s085"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 8289,
          "end": 8294,
          "span_id": "s085"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 8302,
          "end": 8309,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 8328,
      "end": 8376,
      "text": " أخبَرنا مَعْمَرٌ، عن ابن أبي نَجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 8329,
          "end": 8336,
          "span_id": "s086"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 8347,
          "end": 8376,
          "stripped": "عن ابن أبي نجيح، عن مجاهد:",
          "span_id": "s086"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 8369,
          "end": 8374,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 8376,
      "end": 8479,
      "text": " {أُولَئِكَ مُبَرَّءُونَ مِمَّا يَقُولُونَ}: فَمَن كان طيِّبًا فهو مُبَرَّأٌ مِن كلِّ قولٍ خبيثٍ، يقول:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8377,
          "end": 8419,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 8479,
      "end": 8586,
      "text": " يغفِرُه اللهُ. ومَن كان خبيثًا فهو مُبَرَّأٌ مِن كلِّ قولٍ صالحٍ، فإنه يَرُدُّه الله عليه، لا يَقبلُه منه ",
      "markers": []
    },
    {
      "id": "s089",
      "start": 8643,
      "end": 8711,
      "text": ".وقد قِيل: عُنِى بقولِه: {أُولَئِكَ مُبَرَّءُونَ مِمَّا يَقُولُونَ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8668,
          "end": 8710,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 8711,
      "end": 8758,
      "text": " عائشةُ وصفوانُ بنُ المُعَطَّلِ الذي رُمِيت به.",
      "markers": []
    },
    {
      "id": "s091",
      "start": 8758,
      "end": 8792,
      "text": " فعلى هذا القولِ قيل: {أُولَئِكَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8780,
          "end": 8791,
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 8792,
      "end": 8855,
      "text": " فجُمِع، والمرادُ ذانِك، كما قيل: {فَإِنْ كَانَ لَهُ إِخْوَةٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8826,
          "end": 8854,
          "span_id": "s092"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 8855,
          "end": 8867,
          "text": "[النساء: 11]",
          "via": "apparatus",
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 8867,
      "end": 8913,
      "text": ". والمرادُ أخوَان.وقولُه: {لَهُمْ مَغْفِرَةٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8893,
          "end": 8912,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 8913,
      "end": 9029,
      "text": " يقولُ: لهؤلاءِ الطيِّبين مِن الناسِ مغفرةٌ مِن اللهِ لذنوبِهم، والخبيثِ مِن القولِ إن كان منهم، {وَرِزْقٌ كَرِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9010,
          "end": 9028,
          "span_id": "s094"
        }
      ]
    },
    {
      "id": "s095",
      "start": 9029,
      "end": 9130,
      "text": " يقولُ: ولهم أيضًا مع المغفرةِ عَطيةٌ مِن الله كريمةٌ، وذلك الجنةُ وما أُعِدَّ لهم فيها مِن الكرامةِ.",
      "markers": []
    },
    {
      "id": "s096",
      "start": 9130,
      "end": 9158,
      "text": "كما حدَّثنا أبو زرْعةَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9134,
          "end": 9141,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 9158,
      "end": 9220,
      "text": " ثنا العباسُ بنُ الوليدِ النَّرْسِيُّ، قال: ثنا يَزِيدُ بنُ زُ",
      "markers": []
    },
    {
      "id": "s098",
      "start": 9224,
      "end": 9259,
      "text": "رَيْعٍ، قال: ثنا سعيدٌ، عن قتادَةَ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 9251,
          "end": 9257,
          "span_id": "s098"
        }
      ]
    },
    {
      "id": "s099",
      "start": 9259,
      "end": 9337,
      "text": " {لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ}: مغفرةٌ لذنوبِهم، ورزقٌ كريمٌ في الجنةِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9260,
          "end": 9296,
          "span_id": "s099"
        }
      ]
    },
    {
      "id": "s100",
      "start": 9438,
      "end": 9440,
      "text": ". ",
      "markers": []
    }
  ],

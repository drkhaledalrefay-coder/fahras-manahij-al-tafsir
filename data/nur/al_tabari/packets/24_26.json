    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 240,
      "text": " {الْخَبِيثَاتُ لِلْخَبِيثِينَ وَالْخَبِيثُونَ لِلْخَبِيثَاتِ وَالطَّيِّبَاتُ لِلطَّيِّبِينَ وَالطَّيِّبُونَ لِلطَّيِّبَاتِ أُولَئِكَ مُبَرَّءُونَ مِمَّا يَقُولُونَ لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ (26)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 239,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 240,
      "end": 275,
      "text": "اختلَف أهلُ التأويلِ في تأويلِ ذلك؛",
      "markers": []
    },
    {
      "id": "s004",
      "start": 275,
      "end": 463,
      "text": " فقال بعضُهم: معناه: الخبيثاتُ مِن القولِ للخبيثين مِن الرجال، والخبيثون مِن الرجالِ للخبيثاتِ مِن القولِ، والطيباتُ مِن القولِ للطيبين مِن الناسِ، والطيبون مِن الناسِ للطيباتِ مِن القولِ.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 289,
          "end": 294,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 463,
      "end": 508,
      "text": "ذِكرُ مَن قال ذلكحدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s006",
      "start": 508,
      "end": 538,
      "text": " ثنى أبي، قال: ثني عمِّي، قال:",
      "markers": []
    },
    {
      "id": "s007",
      "start": 538,
      "end": 576,
      "text": " ثنى أبي، عن أبيه، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 548,
          "end": 576,
          "stripped": "عن أبيه، عن ابن عباس قوله:",

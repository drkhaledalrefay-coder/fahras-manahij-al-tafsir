  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 32,
      "text": " القول في تأويلِ قوله تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 21,
          "end": 31,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 32,
      "end": 460,
      "text": " {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَثَلُ نُورِهِ كَمِشْكَاةٍ فِيهَا مِصْبَاحٌ الْمِصْبَاحُ فِي زُجَاجَةٍ الزُّجَاجَةُ كَأَنَّهَا كَوْكَبٌ دُرِّيٌّ يُوقَدُ مِنْ شَجَرَةٍ مُبَارَكَةٍ زَيْتُونَةٍ لَا شَرْقِيَّةٍ وَلَا غَرْبِيَّةٍ يَكَادُ زَيْتُهَا يُضِيءُ وَلَوْ لَمْ تَمْسَسْهُ نَارٌ نُورٌ عَلَى نُورٍ يَهْدِي اللَّهُ لِنُورِهِ مَنْ يَشَاءُ وَيَضْرِبُ اللَّهُ الْأَمْثَالَ لِلنَّاسِ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ (35)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 33,
          "end": 459,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 460,
      "end": 527,
      "text": "يعني تعالى ذكرُه بقولِه: {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 485,
          "end": 526,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 527,
      "end": 611,
      "text": " هادى مَن في السماواتِ والأرضِ، فهم بنورِه إلى الحقِّ يَهْتَدون، وبهداه مِن حَيْرةِ ",
      "markers": []
    },
    {
      "id": "s005",
      "start": 628,
      "end": 686,
      "text": " الضَّلالة يَعْتَصِمون.واختلف أهلُ التأويلِ في تأويلِ ذلك؛",
      "markers": []
    },
    {
      "id": "s006",
      "start": 686,
      "end": 718,
      "text": " فقال بعضُهم فيه نحوَ الذي قلنا.",
      "markers": []
    },
    {
      "id": "s007",
      "start": 718,
      "end": 753,
      "text": "ذكرُ مَن قال ذلكحدَّثني عليٌّ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 742,
          "end": 745,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 753,
      "end": 817,
      "text": " ثنا عبدُ اللهِ، قال: ثنى معاويةُ، عن عليٍّ، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 788,
          "end": 817,
          "stripped": "عن علي، عن ابن عباس قوله:",
          "span_id": "s008"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 791,
          "end": 794,
          "span_id": "s008"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 801,
          "end": 809,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 817,
      "end": 867,
      "text": " {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ}. يقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 818,
          "end": 859,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 867,
      "end": 902,
      "text": " اللهُ سبحانَه هادى أهلِ السماواتِ ",
      "markers": []
    },
    {
      "id": "s011",
      "start": 909,
      "end": 910,
      "text": " ",
      "markers": []
    },
    {
      "id": "s012",
      "start": 922,
      "end": 930,
      "text": " الأرضِ ",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1080,
      "end": 1115,
      "text": ".حدَّثني سليمانُ بنُ عمرَ بن خالدٍ ",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1163,
      "end": 1176,
      "text": " الرَّقِّيُّ ",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1211,
      "end": 1273,
      "text": "، قال: ثنا وهبُ بنُ راشدٍ، عن فَرْقَدٍ، عن أنسِ بن مالكٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1238,
          "end": 1273,
          "stripped": "عن فرقد، عن أنس بن مالك، قال:",
          "span_id": "s015"
        },
        {
          "family": "SAHABA",
          "marker": "أنس",
          "name": "أنس",
          "role": "NARRATOR",
          "start": 1254,
          "end": 1257,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1273,
      "end": 1302,
      "text": " إن إلهى يقولُ: نُورى هُداىَ ",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1392,
      "end": 1417,
      "text": ".وقال آخرون: بل معنى ذلك:",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1417,
      "end": 1487,
      "text": " اللهُ مدبِّرُ السماواتِ والأرضِ.ذكرُ مَن قال ذلكحدَّثنا القاسمُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1466,
          "end": 1473,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 1487,
      "end": 1537,
      "text": " ثنا الحسينُ، قال: ثني حجاجٌ، عن ابن جُرَيجٍ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 1520,
          "end": 1530,
          "span_id": "s019"
        }
      ]
    },
    {
      "id": "s020",
      "start": 1537,
      "end": 1569,
      "text": " قال مجاهدُ وابنُ عباسٍ في قوله:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 1542,
          "end": 1547,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 1569,
      "end": 1636,
      "text": " {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ}: يُدَبِّرُ الأمر فيهما؛ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1570,
          "end": 1611,
          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 1664,
      "end": 1665,
      "text": " ",
      "markers": []
    },
    {
      "id": "s023",
      "start": 1846,
      "end": 1888,
      "text": ".وقال آخرون: بل عُنِى بذلك النورِ الضياءُ.",
      "markers": []
    },
    {
      "id": "s024",
      "start": 1888,
      "end": 1931,
      "text": " وقالوا: معنى ذلك: ضياءُ السماواتِ والأرضِ.",
      "markers": []
    },
    {
      "id": "s025",
      "start": 1931,
      "end": 1982,
      "text": "ذكرُ مَن قال ذلكحدَّثني عبدُ الأعلى بنُ واصلٍ، قال:",
      "markers": []
    },
    {
      "id": "s026",
      "start": 1982,
      "end": 2013,
      "text": " ثنا عبيدُ اللهِ بنُ موسى، قال:",
      "markers": []
    },
    {
      "id": "s027",
      "start": 2013,
      "end": 2052,
      "text": " ثنا أبو جعفرٍ الرازيُّ، عن الربيعِ بن ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الربيع",
          "name": "الربيع",
          "role": "NARRATOR",
          "start": 2041,
          "end": 2047,
          "span_id": "s027"
        }
      ]
    },
    {
      "id": "s028",
      "start": 2056,
      "end": 2110,
      "text": "أنسٍ، عن أبي العاليةِ، عن أبيٍّ بن كعبٍ في قولِ اللهِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2062,
          "end": 2098,
          "stripped": "عن أبي العالية، عن أبي بن كعب في",
          "span_id": "s028"
        },
        {
          "family": "SAHABA",
          "marker": "أبي بن كعب",
          "name": "أبي بن كعب",
          "role": "NARRATOR",
          "start": 2082,
          "end": 2094,
          "span_id": "s028"
        }
      ]
    },
    {
      "id": "s029",
      "start": 2110,
      "end": 2158,
      "text": " {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2111,
          "end": 2152,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 2158,
      "end": 2207,
      "text": " فبدَأ بنورِ نفسِه، فذكَره، ثم ذكَر نورَ المؤمنِ ",
      "markers": []
    },
    {
      "id": "s031",
      "start": 2463,
      "end": 2510,
      "text": ".وإنما اخْتَرْنا القولَ الذي اخْتَرْناه في ذلك؛",
      "markers": []
    },
    {
      "id": "s032",
      "start": 2510,
      "end": 2661,
      "text": " لأنه عَقِيبَ قوله: {وَلَقَدْ أَنْزَلْنَا إِلَيْكُمْ آيَاتٍ مُبَيِّنَاتٍ وَمَثَلًا مِنَ الَّذِينَ خَلَوْا مِنْ قَبْلِكُمْ وَمَوْعِظَةً لِلْمُتَّقِينَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2530,
          "end": 2660,
          "span_id": "s032"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 2661,
          "end": 2672,
          "text": "[النور: 34]",
          "via": "apparatus",
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 2672,
      "end": 2837,
      "text": ".فكان ذلك بأن يكونَ خبرًا عن موقعٍ يَقَعُ تنزيلُه مِن خلقِه، ومِن مدح ما ابْتَدَأَ بذكرِ مدحِه، أولى وأشبهُ، ما لم يَأْتِ ما يَدُلُّ على انقضاءِ الخبرِ عنه من غيرِه.",
      "markers": []
    },
    {
      "id": "s034",
      "start": 2837,
      "end": 2871,
      "text": "فإذ كان ذلك كذلك، فتأويلُ الكلامِ:",
      "markers": []
    },
    {
      "id": "s035",
      "start": 2871,
      "end": 3039,
      "text": " ولقد أَنْزَلْنا إليكم أيُّها الناسُ آياتٍ مبيِّناتٍ الحقَّ من الباطلِ، ومثلًا من الذين خَلَوا من قبلِكم وموعظةً للمتقين، فهدَيْناكم بها، وبيَّنا لكم معالمَ دينِكم بها؛",
      "markers": []
    },
    {
      "id": "s036",
      "start": 3039,
      "end": 3076,
      "text": " لأنى هادى أهلِ السماواتِ وأهلِ الأرض",
      "markers": []
    },
    {
      "id": "s037",
      "start": 3080,
      "end": 3138,
      "text": "ِ. وترَك وصلَ الكلامِ باللامِ، وابْتَدأ الخبرَ عن هدايتِه ",
      "markers": []
    },
    {
      "id": "s038",
      "start": 3154,
      "end": 3195,
      "text": " خلقَه ابتداءً، وفيه المعنى الذي ذكَرْتُ؛",
      "markers": []
    },
    {
      "id": "s039",
      "start": 3195,
      "end": 3327,
      "text": " استغناءً بدَلالةِ الكلامِ عليه مِن ذكرِه، ثم ابْتَدَأ في الخبرِ عن مثلِ هدايتِه خلقَه بالآياتِ المبيناتِ التي أنْزَلها إليهم، فقال:",
      "markers": []
    },
    {
      "id": "s040",
      "start": 3327,
      "end": 3374,
      "text": " {مَثَلُ نُورِهِ كَمِشْكَاةٍ فِيهَا مِصْبَاحٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3328,
          "end": 3373,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 3374,
      "end": 3442,
      "text": " يقولُ: مَثَلُ ما أنار مِن الحقِّ بهذا التنزيلِ في بيانِه كمِشْكاةٍ.",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3442,
      "end": 3498,
      "text": "وقد اخْتَلَف أهلُ التأويلِ في المعنيِّ بالهاءِ في قولِه:",
      "markers": []
    },
    {
      "id": "s043",
      "start": 3498,
      "end": 3546,
      "text": " {مَثَلُ نُورِهِ}. علام عائدةٌ، ومِن ذكرِ ما هي؟",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3499,
          "end": 3515,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 3546,
      "end": 3580,
      "text": " فقال بعضُهم: هي مِن ذكرِ المؤمنِ.",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3580,
      "end": 3666,
      "text": " وقالوا: معنى الكلام: مثلُ نورِ المؤمنِ الذي في قلبِه من الإيمان والقرآنِ مثلُ مشكاةٍ.",
      "markers": []
    },
    {
      "id": "s046",
      "start": 3666,
      "end": 3717,
      "text": "ذكرُ مَن قال ذلكحدَّثنا عبدُ الأعلى بنُ واصلٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3682,
          "end": 3689,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3717,
      "end": 3748,
      "text": " ثنا عبيدُ اللهِ بنُ موسى، قال:",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3748,
      "end": 3797,
      "text": " أخبَرنا أبو جعفرٍ الرازيُّ، عن الربيعِ بن أنسٍ، ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3749,
          "end": 3756,
          "span_id": "s048"
        },
        {
          "family": "TABIIN",
          "marker": "الربيع",
          "name": "الربيع",
          "role": "NARRATOR",
          "start": 3780,
          "end": 3786,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3813,
      "end": 3814,
      "text": " ",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3828,
      "end": 3860,
      "text": "، عن أبيٍّ بن كعبٍ في قولِ الله:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "أبي بن كعب",
          "name": "أبي بن كعب",
          "role": "NARRATOR",
          "start": 3833,
          "end": 3845,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3860,
      "end": 3908,
      "text": " {مَثَلُ نُورِهِ}. قال: ذكَر نورَ المؤمنِ، فقال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3861,
          "end": 3877,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 3908,
      "end": 3952,
      "text": " {مَثَلُ نُورِهِ}. يقولُ: مثلُ نورِ المؤمنِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3909,
          "end": 3925,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 3952,
      "end": 3986,
      "text": " قال: وكان أُبيٌّ يَقْرَؤُها كذلك:",
      "markers": []
    },
    {
      "id": "s054",
      "start": 3986,
      "end": 4053,
      "text": " (مثلُ المؤمن). قال: هو المؤمنُ قد جعَل الإيمانَ والقرآنَ في صدرِه ",
      "markers": []
    },
    {
      "id": "s055",
      "start": 4122,
      "end": 4162,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4123,
          "end": 4130,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4162,
      "end": 4231,
      "text": " ثني حجاجٌ، عن أبي جعفرٍ الرازيِّ، عن أبي العاليةِ، عن أبيٍّ بن كعبٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4174,
          "end": 4220,
          "stripped": "عن أبي جعفر الرازي، عن أبي العالية، عن أبي",
          "span_id": "s056"
        },
        {
          "family": "SAHABA",
          "marker": "أبي بن كعب",
          "name": "أبي بن كعب",
          "role": "SPEAKER",
          "start": 4217,
          "end": 4229,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4231,
      "end": 4289,
      "text": " {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَثَلُ نُورِهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4232,
          "end": 4288,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4289,
      "end": 4328,
      "text": " قال: بدَأ بنورِ نفسِه، فذكَره، ثم قال:",
      "markers": []
    },
    {
      "id": "s059",
      "start": 4328,
      "end": 4375,
      "text": " {مَثَلُ نُورِهِ} يقولُ: مثلُ نورِ مَن آمَن به.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4329,
          "end": 4345,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4375,
      "end": 4407,
      "text": " قال: وكذلك كان يَقْرَأُ أُبيٌّ.",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 4393,
          "end": 4398,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4407,
      "end": 4459,
      "text": " قال: هو عبدٌ جعَل اللهُ القرآنَ والإيمانَ في صدرِه.",
      "markers": []
    },
    {
      "id": "s062",
      "start": 4459,
      "end": 4505,
      "text": "حدَّثنا ابن بشارٍ، قال: ثنا عبدُ الرحمنِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4459,
          "end": 4466,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 4505,
      "end": 4557,
      "text": " ثنا سفيانُ، عن عطاءِ بن السائبِ، عن سعيدِ بن جبيرٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4518,
          "end": 4557,
          "stripped": "عن عطاء بن السائب، عن سعيد بن جبير:",
          "span_id": "s063"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "NARRATOR",
          "start": 4521,
          "end": 4525,
          "span_id": "s063"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 4542,
          "end": 4555,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 4557,
      "end": 4599,
      "text": " {مَثَلُ نُورِهِ}. قال: مثلُ نورِ المؤمنِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4558,
          "end": 4574,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4627,
      "end": 4668,
      "text": ".حدَّثني عليُّ بنُ الحسنِ الأزْديُّ، قال:",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4668,
      "end": 4737,
      "text": " ثنا يحيى بنُ اليَمانِ، عن أبي سِنانٍ، عن ثابتٍ، عن الضحاكِ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4692,
          "end": 4737,
          "stripped": "عن أبي سنان، عن ثابت، عن الضحاك في قوله:",
          "span_id": "s066"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 4720,
          "end": 4726,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 4737,
      "end": 4774,
      "text": " {مَثَلُ نُورِهِ}. قال: نورِ المؤمنِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4738,
          "end": 4754,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 4774,
      "end": 4832,
      "text": "وقال آخرون: بل عُنِى بالنورِ محمدٌ - صلى الله عليه وسلم -.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4811,
          "end": 4829,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 4832,
      "end": 4862,
      "text": " وقالوا: الهاءُ التي في قولِه:",
      "markers": []
    },
    {
      "id": "s070",
      "start": 4862,
      "end": 4903,
      "text": " {مَثَلُ نُورِهِ}. عائدةٌ على اسمِ اللهِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4863,
          "end": 4879,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 4903,
      "end": 4942,
      "text": "ذكرُ مَن قال ذلكحدَّثنا ابن حميدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4919,
          "end": 4926,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 4942,
      "end": 4990,
      "text": " ثنا يعقوبُ القُمِّيُّ، عن حفصٍ، عن شِمْرٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4966,
          "end": 4990,
          "stripped": "عن حفص، عن شمر، قال:",
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 4990,
      "end": 5032,
      "text": " جاء ابن عباسٍ إلى كعبِ الأحبارِ، فقال له:",
      "markers": [
        {
          "family": "ISRAILIYYAT",
          "marker": "كعب الأحبار",
          "start": 5009,
          "end": 5021,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 5032,
      "end": 5067,
      "text": " حدَّثْنى عن قولِ اللهِ عزَّ وجلَّ:",
      "markers": []
    },
    {
      "id": "s075",
      "start": 5067,
      "end": 5124,
      "text": " {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ} الآية. فقال كع",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5068,
          "end": 5109,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 5128,
      "end": 5189,
      "text": "بٌ: {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَثَلُ نُورِهِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5132,
          "end": 5188,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 5189,
      "end": 5232,
      "text": " مثلُ محمدٍ - صلى الله عليه وسلم - كمشكاةٍ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5203,
          "end": 5221,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 5383,
      "end": 5424,
      "text": ".حدَّثني عليُّ بنُ الحسنِ الأزْديُّ، قال:",
      "markers": []
    },
    {
      "id": "s079",
      "start": 5424,
      "end": 5510,
      "text": " ثنا يحيى بنُ اليَمانِ، عن أشعثَ، عن جعفرِ بن أبى المغيرةِ، عن سعيدِ بن جبيرٍ في قوله:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5448,
          "end": 5504,
          "stripped": "عن أشعث، عن جعفر بن أبى المغيرة، عن سعيد بن جبير في",
          "span_id": "s079"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 5487,
          "end": 5500,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 5510,
      "end": 5563,
      "text": " {مَثَلُ نُورِهِ}. قال: محمدٍ - صلى الله عليه وسلم - ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5511,
          "end": 5527,
          "span_id": "s080"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5542,
          "end": 5560,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 5626,
      "end": 5686,
      "text": ".وقال آخرون: بل عُنِى بذلك هُدَى اللهِ وبيانُه، وهو القرآنُ.",
      "markers": []
    },
    {
      "id": "s082",
      "start": 5686,
      "end": 5717,
      "text": " قالوا: والهاءُ مِن ذكرِ اللهِ.",
      "markers": []
    },
    {
      "id": "s083",
      "start": 5717,
      "end": 5922,
      "text": " قالوا: ومعنى الكلامِ: اللهُ هادى أهلِ السماواتِ والأرضِ بآياتِه المبيِّناتِ، وهى النورُ الذي اسْتَنار به السماواتُ والأرضُ، مثلُ هداه وآياتِه التي هَدَى بها خلقَه، ووعَظهم بها في قلوبِ المؤمنين - كمشكاةٍ.",
      "markers": []
    },
    {
      "id": "s084",
      "start": 5922,
      "end": 5957,
      "text": "ذكرُ مَن قال ذلكحدَّثني عليٌّ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 5946,
          "end": 5949,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 5957,
      "end": 6014,
      "text": " ثنا أبو صالحٍ، قال: ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5991,
          "end": 6014,
          "stripped": "عن علي، عن ابن عباس:",
          "span_id": "s085"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 5994,
          "end": 5997,
          "span_id": "s085"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6004,
          "end": 6012,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 6014,
      "end": 6060,
      "text": " {مَثَلُ نُورِهِ}. مثلُ هُداه في قلبِ المؤمنِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6015,
          "end": 6031,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 6191,
      "end": 6225,
      "text": ".حدَّثني يعقوبُ بنُ إبراهيمَ، قال:",
      "markers": []
    },
    {
      "id": "s088",
      "start": 6225,
      "end": 6275,
      "text": " ثنا ابن عليةَ، عن أبي رَجاءٍ، عن الحسنِ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6241,
          "end": 6275,
          "stripped": "عن أبي رجاء، عن الحسن في قوله:",
          "span_id": "s088"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 6259,
          "end": 6264,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 6275,
      "end": 6334,
      "text": " {مَثَلُ نُورِهِ}. قال: مثلُ هذا القرآنِ في القلبِ كمشكاةٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6276,
          "end": 6292,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 6446,
      "end": 6490,
      "text": ".حدَّثني يونُسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6468,
          "end": 6475,
          "span_id": "s090"
        }
      ]
    },
    {
      "id": "s091",
      "start": 6490,
      "end": 6512,
      "text": " قال ابن زيدٍ في قوله:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 6495,
          "end": 6502,
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 6512,
      "end": 6648,
      "text": " {مَثَلُ نُورِهِ}: نورِ القرآنِ الذي أنْزَل على رسولِه - صلى الله عليه وسلم - وعبادِه، هذا مثلُ القرآنِ، {كَمِشْكَاةٍ فِيهَا مِصْبَاحٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6513,
          "end": 6529,
          "span_id": "s092"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6569,
          "end": 6587,
          "span_id": "s092"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6617,
          "end": 6647,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 6674,
      "end": 6702,
      "text": ".قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6680,
          "end": 6687,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 6702,
      "end": 6734,
      "text": " أخبرني عبدُ اللهِ بنُ عَيَّاشٍ ",
      "markers": []
    },
    {
      "id": "s095",
      "start": 6792,
      "end": 6845,
      "text": "، قال: قال زيدُ بنُ أسلمَ في قولِ اللهِ تبارك وتعالى:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "زيد بن أسلم",
          "name": "زيد بن أسلم",
          "role": "SPEAKER",
          "start": 6803,
          "end": 6816,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 6845,
      "end": 6903,
      "text": " {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَثَلُ نُورِهِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6846,
          "end": 6902,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 6903,
      "end": 6952,
      "text": " ونورُه الذي ذكَر القرآنُ، ومَثَلُه الذي ضرَب له ",
      "markers": []
    },
    {
      "id": "s098",
      "start": 7002,
      "end": 7027,
      "text": ".وقال آخرون: بل معنى ذلك:",
      "markers": []
    },
    {
      "id": "s099",
      "start": 7027,
      "end": 7074,
      "text": " مثلُ نورِ اللهِ. وقالوا: يعنى بالنورِ الطاعةَ.",
      "markers": []
    },
    {
      "id": "s100",
      "start": 7074,
      "end": 7118,
      "text": "ذكرُ مَن قال ذلكحدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s101",
      "start": 7118,
      "end": 7146,
      "text": " ثنى أبى، قال: ثنى عمى، قال:",
      "markers": []
    },
    {
      "id": "s102",
      "start": 7146,
      "end": 7172,
      "text": " ثنى أبى، عن أبيه، عن ابن ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7156,
          "end": 7171,
          "stripped": "عن أبيه، عن ابن",
          "span_id": "s102"
        }
      ]
    }
  ],

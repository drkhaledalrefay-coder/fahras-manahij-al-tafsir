      "start": 2564,
      "end": 2688,
      "text": " {لَوْلَا إِذْ سَمِعْتُمُوهُ ظَنَّ الْمُؤْمِنُونَ وَالْمُؤْمِنَاتُ بِأَنْفُسِهِمْ خَيْرًا}: يَعْنى بذلك المؤمنين والمؤمناتِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2565,
          "end": 2654,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 2718,
      "end": 2760,
      "text": ".وقولُه: {وَقَالُوا هَذَا إِفْكٌ مُبِينٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2727,
          "end": 2759,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 2760,
      "end": 2921,
      "text": " يقولُ: وقال المؤمنون والمؤمناتُ: هذا الذي سمِعنا مِن القولِ الذي رُمِىَ به عائشةُ مِن الفاحشةِ، كذبٌ وإثمٌ، يَبِينُ لمن عقَل وفكَّر فيه، أنه كذبٌ وإثمٌ وبهتانٌ.",
      "markers": []
    },
    {
      "id": "s041",
      "start": 2921,
      "end": 2951,
      "text": "كما حدَّثنا ابن بَشَّارٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2925,
          "end": 2932,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 2951,
      "end": 2995,
      "text": " ثنا هَوْذَةُ، قال: أخبَرنا عوفٌ، عن الحسنِ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2971,
          "end": 2978,
          "span_id": "s042"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 2988,
          "end": 2993,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 2995,
      "end": 3036,
      "text": " {وَقَالُوا هَذَا إِفْكٌ مُبِينٌ}. قالوا:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2996,
          "end": 3028,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 3036,
      "end": 3076,
      "text": " إنَّ هذا لا ينبغى أن يَتكلَّمَ به إلا م",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3080,
      "end": 3138,
      "text": "َن أقام عليه أربعةً مِن الشهودِ وأُقِيم عليه حدُّ الزِّنى ",
      "markers": []
    },
    {

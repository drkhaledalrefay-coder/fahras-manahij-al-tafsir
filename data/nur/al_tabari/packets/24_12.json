    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 161,
      "text": " {لَوْلَا إِذْ سَمِعْتُمُوهُ ظَنَّ الْمُؤْمِنُونَ وَالْمُؤْمِنَاتُ بِأَنْفُسِهِمْ خَيْرًا وَقَالُوا هَذَا إِفْكٌ مُبِينٌ (12)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 160,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 161,
      "end": 311,
      "text": "وهذا عِتابٌ مِن اللَّهِ تعالى ذِكْرُه أهلَ الإيمانِ به فيما وقَع في أنفسِهم من إرجافِ مَن أرجَف في أمرِ عائشةَ، بما أرجَف به، يقولُ لهم تعالَى ذِكرُه:",
      "markers": []
    },
    {
      "id": "s004",
      "start": 311,
      "end": 445,
      "text": " هلَّا أيُّها الناسُ إذْ سمِعتُم ما قال أهلُ الإفكِ في عائشةَ، {ظَنَّ الْمُؤْمِنُونَ} منكم {وَالْمُؤْمِنَاتُ بِأَنْفُسِهِمْ خَيْرًا}. ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 374,
          "end": 396,
          "span_id": "s004"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 402,
          "end": 443,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 488,
      "end": 489,
      "text": " ",
      "markers": []
    },
    {
      "id": "s006",
      "start": 516,
      "end": 553,
      "text": "، ولم يظنُّوا به أنَّه أتَى الفاحشةَ.",
      "markers": []
    },
    {
      "id": "s007",
      "start": 553,
      "end": 626,
      "text": "وقال: {بِأَنْفُسِهِمْ}. لأنَّ أهلَ الإسلامِ كلَّهم بمنزلةِ نَفْسِ واحدةٍ؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 559,
          "end": 575,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 626,
      "end": 695,
      "text": " لأنَّهم أهلُ ملةٍ واحدةٍ.وبنحوِ الذي قلْنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s009",
      "start": 695,
      "end": 738,
      "text": "ذِكرُ مَن قال ذلكحدَّثنا ابن حُمَيْدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 712,
          "end": 719,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 738,
      "end": 865,
      "text": " ثنا سَلَمَةُ، عن محمدِ بن إسحاقَ، عن أبيه، عن بعضِ رجالِ بني النجارِ، أن أبا أيوبَ خالدَ بنَ زيدٍ، قالت له امرأتُه أمُّ أيوبَ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 753,
          "end": 794,
          "stripped": "عن محمد بن إسحاق، عن أبيه، عن بعض رجال",
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 865,
      "end": 902,
      "text": " أما تسمعُ ما يقولُ الناسُ في عائشةَ؟",
      "markers": []
    },
    {
      "id": "s012",
      "start": 902,
      "end": 957,
      "text": " قال: بلى، وذلك الكذبُ، أكنتِ فاعلةً ذلك يا أمَّ أيوبَ؟",
      "markers": []
    },
    {
      "id": "s013",
      "start": 957,
      "end": 992,
      "text": " قالت: لا واللَّهِ ما كنتُ لأفعلَه.",
      "markers": []
    },
    {
      "id": "s014",
      "start": 992,
      "end": 1028,
      "text": " قال: فعائشةُ واللَّهِ خيرٌ منك. قال",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1032,
      "end": 1080,
      "text": ": فلمَّا نزَل القرآنُ، ذكَر اللَّهُ مَن قال مِن ",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1114,
      "end": 1147,
      "text": " الفاحشةِ ما قال مِن أهلِ الإفكِ:",
      "markers": []

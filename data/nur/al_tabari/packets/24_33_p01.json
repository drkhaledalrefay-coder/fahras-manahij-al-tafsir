          "end": 1407,
          "span_id": "s017"
        }
      ]
    },
    {
      "id": "s018",
      "start": 1641,
      "end": 1670,
      "text": ".حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s019",
      "start": 1670,
      "end": 1700,
      "text": " ثنى أبي، قال: ثني عمِّي، قال:",
      "markers": []
    },
    {
      "id": "s020",
      "start": 1700,
      "end": 1737,
      "text": " ثنى أبي، عن أبيه، عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1710,
          "end": 1737,
          "stripped": "عن أبيه، عن ابن عباس، قال:",
          "span_id": "s020"

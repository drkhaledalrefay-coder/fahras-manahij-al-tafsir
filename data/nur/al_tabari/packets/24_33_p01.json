          "role": "SPEAKER",
          "start": 1722,
          "end": 1730,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 1737,
      "end": 1832,
      "text": " لا ينبغى لرجلٍ إذا كان عندَه المملوكُ الصالحُ الذي له المالُ، يريدُ أن يكاتَبَ، ألَّا يكاتبَه.",
      "markers": []
    },
    {
      "id": "s022",
      "start": 1832,
      "end": 1883,
      "text": "وقال آخرون: ذلك غيرُ واجبٍ على السيدِ، وإنما قولُه:",
      "markers": []
    },
    {
      "id": "s023",
      "start": 1883,
      "end": 1976,
      "text": " {فَكَاتِبُوهُمْ} نَدْبٌ من اللهِ سادةَ العبيدِ إلى كتابةِ من علِم فيه منهم خيرًا، لا إيجابٌ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",

          "end": 1900,
          "span_id": "s023"
        }
      ]
    },
    {
      "id": "s024",
      "start": 1976,
      "end": 2011,
      "text": "ذكرُ مَن قال ذلكحدَّثني يونسُ، قال:",
      "markers": []
    },
    {
      "id": "s025",
      "start": 2011,
      "end": 2052,
      "text": " أخبَرنا ابن وهبٍ، قال: قال مالكُ بنُ أنس",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2012,
          "end": 2019,
          "span_id": "s025"
        }
      ]
    },
    {
      "id": "s026",
      "start": 2056,
      "end": 2239,
      "text": "ٍ: الأمرُ عندَنا أن ليس على سيِّدِ العبدِ أن يكاتبَه إذا سأله ذلك، ولم أسمَعْ بأحدٍ من الأئمةِ أكرَه أحدًا على أن يكاتِبَ عبدَه، وقد سمِعتُ بعضَ أهلِ العلمِ إذا سُئِل عن ذلك، فقيل له:",
      "markers": []
    },
    {
      "id": "s027",
      "start": 2239,
      "end": 2278,
      "text": " إنَّ الله تبارك وتعالى يقولُ في كتابه:",
      "markers": []
    },
    {
      "id": "s028",
      "start": 2278,
      "end": 2359,
      "text": " {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا} - يتلو هاتين الآيتين: {وَإِذَا ",

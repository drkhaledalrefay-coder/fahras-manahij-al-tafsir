    {
      "id": "s031",
      "start": 2520,
      "end": 2613,
      "text": ". قال مالكٌ: فإنَّما ذلك أمرٌ أذِن اللهُ فيه للناسِ، وليس بواجبٍ على الناسِ، ولا يلزمُ أحدًا ",
      "markers": []
    },
    {
      "id": "s032",
      "start": 2629,
      "end": 2749,
      "text": ".وقال الثوريُّ: إذا أراد العبدُ من سيِّدِه أن يكاتبَه، فإن شاءَ السيِّدُ أن يكاتبَه كاتبَه، ولا يُجْبَرُ السيدُ على ذلك.",
      "markers": []
    },
    {
      "id": "s033",
      "start": 2749,
      "end": 2782,
      "text": "حدَّثني بذلك عليٌّ، عن زيدٍ، عنه ",
      "markers": []
    },
    {
      "id": "s034",
      "start": 2810,
      "end": 2854,
      "text": ".وحدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2832,
          "end": 2839,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2854,
      "end": 2877,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 2859,
          "end": 2866,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 2877,
      "end": 2927,
      "text": " {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2878,
          "end": 2926,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 2927,
      "end": 2999,
      "text": " قال: ليس بواجبٍ عليه أن يكاتبَه، إنَّما هذا أمرٌ أذِن اللهُ فيه ودليلٌ ",
      "markers": []
    },
    {
      "id": "s038",
      "start": 3001,
      "end": 3076,
      "text": ".وأولَى القولين في ذلك عندِى بالصوابِ قولُ مَن قال: واجبٌ على سيِّد العبدِ ",
      "markers": []
    },
    {
      "id": "s039",
      "start": 3080,
      "end": 3133,
      "text": "أن يكاتِبَه إذا علِم فيه خيرًا وسأله العبدُ الكتابةَ.",
      "markers": []
    },
    {
      "id": "s040",
      "start": 3133,
      "end": 3263,
      "text": " وذلك أن ظاهرَ قولِه: {فَكَاتِبُوهُمْ} ظاهرُ أمرٍ، وأمرُ اللهِ فرضٌ الانتهاءُ إليه، ما لم يكنْ دليل من كتابٍ أو سنةٍ على أنه ندبٌ؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3155,
          "end": 3171,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 3263,
      "end": 3350,
      "text": " لما قد بيَّنا من العلةِ في كتابِنا المسمَّى \"البيانُ عن أصولِ الأحكامِ\".وأمَّا الخيرُ ",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3381,
      "end": 3493,
      "text": " الذي أمَر اللهُ تعالى ذكرُه عبادَه بكتابةِ عبيدِهم إذا علِموه فيهم، فهو القُدْرةُ على الاحترافِ والكسبِ لأداءِ ",
      "markers": []
    },
    {
      "id": "s043",
      "start": 3527,
      "end": 3584,
      "text": " ما كوتِبُوا عليه.ذكرُ مَن قال ذلكحدَّثنا ابن بشارٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3561,
          "end": 3568,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 3584,
      "end": 3754,
      "text": " ثنا عبدُ الرحمنِ، قال: ثنا سفيانُ، عن عبدِ الكريمِ الجزَرِيِّ، عن نافعٍ، عن ابن عمرَ، أنَّه كرِه أن يكاتِبَ مملوكَه إذا لم تكنْ له حرفةٌ، قال: تُطعِمُنى أوساخَ النَّاسِ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3620,
          "end": 3670,
          "stripped": "عن عبد الكريم الجزري، عن نافع، عن ابن عمر،",
          "span_id": "s044"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عمر",
          "name": "ابن عمر",
          "role": "NARRATOR",
          "start": 3661,
          "end": 3668,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3824,
      "end": 3865,
      "text": "؟حدَّثني عليٌّ، قال: ثنا عبدُ اللهِ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 3833,
          "end": 3836,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3865,
      "end": 3907,
      "text": " ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ قوله:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3879,
          "end": 3907,
          "stripped": "عن علي، عن ابن عباس قوله:",
          "span_id": "s046"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 3882,
          "end": 3885,
          "span_id": "s046"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 3892,
          "end": 3900,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3907,
      "end": 3957,
      "text": " {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3908,
          "end": 3956,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3957,
      "end": 4020,
      "text": " يقولُ: إن علمتم لهم حيلةً، ولا تُلقُوا مُؤْنتَهم على المسلمين ",
      "markers": []
    },
    {
      "id": "s049",
      "start": 4163,
      "end": 4184,
      "text": ".حدَّثني يونسُ، قال: ",
      "markers": []
    },
    {
      "id": "s050",
      "start": 4201,
      "end": 4202,
      "text": " ",
      "markers": []
    },
    {
      "id": "s051",
      "start": 4227,
      "end": 4253,
      "text": "، قال: أخبَرنا أشهبُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4234,
          "end": 4241,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4253,
      "end": 4283,
      "text": " سُئل مالكُ بنُ أنسٍ عن قولِه:",
      "markers": []
    },
    {
      "id": "s053",
      "start": 4283,
      "end": 4333,
      "text": " {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4284,
          "end": 4332,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4333,
      "end": 4371,
      "text": " فقال: إنَّه ليقالُ: الخيرُالقوةُ على ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 4347,
          "end": 4351,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4401,
      "end": 4410,
      "text": " الأداءِ ",
      "markers": []
    },
    {
      "id": "s056",
      "start": 4443,
      "end": 4486,
      "text": ".حدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4464,
          "end": 4471,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4486,
      "end": 4520,
      "text": " ثني ابن زيدٍ، عن أبيه قولَ اللهِ:",
      "markers": []
    },
    {
      "id": "s058",
      "start": 4520,
      "end": 4570,
      "text": " {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4521,
          "end": 4569,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4570,
      "end": 4598,
      "text": " قال: الخيرُ القوةُ على ذلك ",
      "markers": []
    },
    {
      "id": "s060",
      "start": 4648,
      "end": 4673,
      "text": ".وقال آخرون: بل معنى ذلك:",
      "markers": []
    },
    {
      "id": "s061",
      "start": 4673,
      "end": 4710,
      "text": " إن علِمتُم فيهم صدقًا ووفاءً وأداءً.",
      "markers": []
    },
    {
      "id": "s062",
      "start": 4710,
      "end": 4745,
      "text": "ذكرُ من قال ذلكحدَّثني يعقوبُ، قال:",
      "markers": []
    },
    {
      "id": "s063",
      "start": 4745,
      "end": 4800,
      "text": " ثنا ابن عليةَ، قال: أخبَرنا يونسُ، عن الحسنِ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4766,
          "end": 4773,
          "span_id": "s063"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 4784,
          "end": 4789,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 4800,
      "end": 4850,
      "text": " {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4801,
          "end": 4849,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4850,
      "end": 4887,
      "text": " قال: صدقًا، ووفاءً، وأداءً، وأمانةً ",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4978,
      "end": 5021,
      "text": ".قال: ثنا ابن عُلَيةَ، قال: ثنا عبدُ اللهِ ",
      "markers": []
    },
    {
      "id": "s067",
      "start": 5039,
      "end": 5124,
      "text": " بنُ أبي نجيحٍ، عن مجاهدٍ وطاوسٍ أنَّهما قالا في قولِه: {فَكَاتِبُوهُمْ إِنْ عَلِمْتُ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 5058,
          "end": 5063,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 5128,
      "end": 5169,
      "text": "مْ فِيهِمْ خَيْرًا}. قالا: مالًا وأمانةً ",
      "markers": []
    },
    {
      "id": "s069",
      "start": 5389,
      "end": 5438,
      "text": ".حدَّثنا أبو كريبٍ، قال: ثنا جابرُ بنُ نوحٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5390,
          "end": 5397,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 5438,
      "end": 5479,
      "text": " ثنا إسماعيلُ بن أبي خالدٍ، عن أبي صالحٍ:",
      "markers": []
    },
    {
      "id": "s071",
      "start": 5479,
      "end": 5543,
      "text": " {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}. قال: أداءً و ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5480,
          "end": 5528,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 5565,
      "end": 5573,
      "text": " أمانةً ",
      "markers": []
    },
    {
      "id": "s073",
      "start": 5651,
      "end": 5682,
      "text": ".حدَّثنا محمدُ بنُ المثنى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5652,
          "end": 5659,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 5682,
      "end": 5708,
      "text": " ثنا محمدُ بنُ جعفرٍ، قال:",
      "markers": []
    },
    {
      "id": "s075",
      "start": 5708,
      "end": 5737,
      "text": " ثنا شعبةُ، عن المغيرةِ، قال:",
      "markers": []
    },
    {
      "id": "s076",
      "start": 5737,
      "end": 5770,
      "text": " كان إبراهيم يقولُ في هذه الآيةِ:",
      "markers": []
    },
    {
      "id": "s077",
      "start": 5770,
      "end": 5820,
      "text": " {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5771,
          "end": 5819,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 5820,
      "end": 5851,
      "text": " قال: صدقًا ووفاءً. أو أحدَهما ",
      "markers": []
    },
    {
      "id": "s079",
      "start": 5936,
      "end": 5980,
      "text": ".حدَّثنا أبو بكرٍ، قال: ثنا ابن إدريسَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5937,
          "end": 5944,
          "span_id": "s079"
        },
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 5945,
          "end": 5952,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 5980,
      "end": 6034,
      "text": " سمِعتُ عبدَ الملكِ بنَ أبي سليمانَ، عن عطاءٍ في قوله:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 6020,
          "end": 6024,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 6034,
      "end": 6103,
      "text": " {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}. قال: أداءً ومالًا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6035,
          "end": 6083,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 6131,
      "end": 6148,
      "text": ".حدَّثنا الحسنُ ب",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6132,
          "end": 6139,
          "span_id": "s082"
        }
      ]
    },
    {
      "id": "s083",
      "start": 6152,
      "end": 6192,
      "text": "نُ يحيى، قال: أخبَرنا عبدُ الرزاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6166,
          "end": 6173,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 6192,
      "end": 6240,
      "text": " أخبَرنا ابن جُرَيجٍ، قال: قال عمرُو بنُ دينارٍ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6193,
          "end": 6200,
          "span_id": "s084"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 6201,
          "end": 6211,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 6240,
      "end": 6275,
      "text": " أحسَبُه كلَّ ذلك؛ المالَ والصلاحَ ",
      "markers": []
    },
    {
      "id": "s086",
      "start": 6315,
      "end": 6344,
      "text": ".حدَّثني عليُّ بنُ سهلٍ، قال:",
      "markers": []
    },
    {
      "id": "s087",
      "start": 6344,
      "end": 6371,
      "text": " ثنا زيدٌ، قال: ثنا سفيانُ ",
      "markers": []
    },
    {
      "id": "s088",
      "start": 6405,
      "end": 6441,
      "text": ": {إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6407,
          "end": 6440,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 6441,
      "end": 6488,
      "text": " يعني: صدقًا ووفاءً وأمانةً.حدَّثني يونسُ، قال:",
      "markers": []
    },
    {
      "id": "s090",
      "start": 6488,
      "end": 6533,
      "text": " أخبَرنا ابن وهبٍ، قال: قال ابن زيدٍ في قوله:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6489,
          "end": 6496,
          "span_id": "s090"
        },
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 6516,
          "end": 6523,
          "span_id": "s090"
        }
      ]
    },
    {
      "id": "s091",
      "start": 6533,
      "end": 6573,
      "text": " {إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6534,
          "end": 6567,
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 6573,
      "end": 6642,
      "text": " إن علمتَ فيه خيرًا لنفسِك، يؤدِّى إليك ويَصدُقُك ما حدَّثك، فكاتبْه.",
      "markers": []
    },
    {
      "id": "s093",
      "start": 6642,
      "end": 6666,
      "text": "وقال آخرون: بل معني ذلك:",
      "markers": []
    },
    {
      "id": "s094",
      "start": 6666,
      "end": 6732,
      "text": " إنْ علِمتم لهم مالًا.ذكرُ مَن قال ذلكحدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s095",
      "start": 6732,
      "end": 6762,
      "text": " ثنى أبي، قال: ثني عمِّي، قال:",
      "markers": []
    },
    {
      "id": "s096",
      "start": 6762,
      "end": 6802,
      "text": " ثنى أبي، عن أبيه، عن ابن عباسٍ في قوله:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6772,
          "end": 6802,
          "stripped": "عن أبيه، عن ابن عباس في قوله:",
          "span_id": "s096"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6784,
          "end": 6792,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 6802,
      "end": 6852,
      "text": " {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6803,
          "end": 6851,
          "span_id": "s097"
        }
      ]
    },
    {
      "id": "s098",
      "start": 6852,
      "end": 6882,
      "text": " يقولُ: إِنْ علِمتم لهم مالًا.",
      "markers": []
    },
    {
      "id": "s099",
      "start": 6882,
      "end": 6920,
      "text": "حدَّثنا القاسم، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6882,
          "end": 6889,
          "span_id": "s099"
        }
      ]
    },
    {
      "id": "s100",
      "start": 6920,
      "end": 6966,
      "text": " ثني حجاجٌ، عن ابن جُرَيجٍ، قال قال ابن عباسٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 6935,
          "end": 6945,
          "span_id": "s100"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6956,
          "end": 6964,
          "span_id": "s100"
        }
      ]
    },
    {
      "id": "s101",
      "start": 6966,
      "end": 7013,
      "text": " {إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}. قال: مالًا ",
      "markers": [

  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 32,
      "text": " القولُ في تأويل قوله تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 21,
          "end": 31,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 32,
      "end": 286,
      "text": " {وَلْيَسْتَعْفِفِ الَّذِينَ لَا يَجِدُونَ نِكَاحًا حَتَّى يُغْنِيَهُمُ اللَّهُ مِنْ فَضْلِهِ وَالَّذِينَ يَبْتَغُونَ الْكِتَابَ مِمَّا مَلَكَتْ أَيْمَانُكُمْ فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 33,
          "end": 285,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 286,
      "end": 463,
      "text": "يقولُ تعالى ذكرُه: وليتعَفَّفِ الَّذِينَ لا يَجِدُون ما ينكحون به النساءَ عن إتيانِ ما حرَّم اللهُ عليهم من الفواحشِ حتى يُغنيَهم اللهُ من سَعَةِ فضلِه، ويوسِّعَ عليهم من رزقِه.",
      "markers": []
    },
    {
      "id": "s004",
      "start": 463,
      "end": 538,
      "text": "وقولُه: {وَالَّذِينَ يَبْتَغُونَ الْكِتَابَ مِمَّا مَلَكَتْ أَيْمَانُكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 471,
          "end": 537,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 538,
      "end": 653,
      "text": " يقولُ جلَّ ثناؤُه: والذين يلتمِسون المكاتبةَ منكم مِن مماليكِكم، {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 604,
          "end": 652,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 653,
      "end": 736,
      "text": "واختلَف أهلُ العلمِ في وجهِ مكاتبةِ الرجلِ عبدَه الذي قد علِم فيه خيرًا، وهل قولُه:",
      "markers": []
    },
    {
      "id": "s007",
      "start": 736,
      "end": 825,
      "text": " {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا} على وجهِ الفرضِ، أم هو على وجهِ الندبِ؟",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 737,
          "end": 785,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 825,
      "end": 914,
      "text": " فقال بعضُهم: فرضٌ على الرجلِ أن يكاتبَ عبدَه الذي قد علِم فيه خيرًا، إذا سأله العبد ذلك.",
      "markers": []
    },
    {
      "id": "s009",
      "start": 914,
      "end": 950,
      "text": "ذكرُ مَن قال ذلكحدَّثنا الحسنُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 930,
          "end": 937,
          "span_id": "s009"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 938,
          "end": 943,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 950,
      "end": 1028,
      "text": " أخبَرنا عبدُ الرزاقِ، قال: أخبَرنا ابن جُرَيجٍ، قال: قلتُ لعطاءٍ: أواجبٌ عليّ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 951,
          "end": 958,
          "span_id": "s010"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 951,
          "end": 1003,
          "stripped": "أخبرنا عبد الرزاق، قال: أخبرنا ابن جريج، قال:",
          "span_id": "s010"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 978,
          "end": 985,
          "span_id": "s010"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 986,
          "end": 996,
          "span_id": "s010"
        },
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 1004,
          "end": 1007,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 1032,
      "end": 1062,
      "text": "َ إذا علمِتُ مالًا أن أكاتبَه؟",
      "markers": []
    },
    {
      "id": "s012",
      "start": 1062,
      "end": 1088,
      "text": " قال: ما أرَاه إلا واجبًا.",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1088,
      "end": 1118,
      "text": " وقالها عمرُو بنُ دينارٍ، قال:",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1118,
      "end": 1158,
      "text": " قلتُ لعطاءٍ: أتأثِرُه عن أحدٍ؟ قال: لا ",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 1119,
          "end": 1122,
          "span_id": "s014"
        }
      ]
    },
    {
      "id": "s015",
      "start": 1256,
      "end": 1286,
      "text": ".حدَّثنا محمدُ بنُ بشارٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1257,
          "end": 1264,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1286,
      "end": 1311,
      "text": " ثنا محمدُ بنُ بكرٍ، قال:",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1311,
      "end": 1422,
      "text": " ثنا سعيدٌ، عن قتَادةَ، عن أنسِ بن مالكٍ، أنَّ سيرينَ أراد أن يكاتبَه، فتلكَّأ عليه، فقال له عمرُ: لتُكاتبنَّه ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",

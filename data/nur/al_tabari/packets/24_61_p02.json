  "spans": [
    {
      "id": "s111",
      "start": 9225,
      "end": 9280,
      "text": "ا عَلَى أَنْفُسِكُمْ أَنْ تَأْكُلُوا مِنْ بُيُوتِكُمْ}.",
      "markers": []
    },
    {
      "id": "s112",
      "start": 9280,
      "end": 9316,
      "text": " أنه بمعنى: ولا عليكم أيُّها الناسُ.",
      "markers": []
    },
    {
      "id": "s113",
      "start": 9316,
      "end": 9394,
      "text": " ثم جمَع هؤلاء والزَّمْنَى الذين ذكَرهم قبلُ في الخطابِ، فقال: أن تأكُلوا مِن ",
      "markers": []
    },
    {
      "id": "s114",
      "start": 9409,
      "end": 9509,
      "text": " بيوتِ أنفسِكم. وكذلك تفعلُ العربُ إذا جمعَت بينَ خبرِ الغائبِ والمخاطَبِ، غلَّبَتِ المخاطَبَ فقالت:",
      "markers": []
    },
    {
      "id": "s115",
      "start": 9509,
      "end": 9561,
      "text": " أنت وأخوك قُمْتُما، وأنت وزيدٌ جلَستُما. ولا تقولُ ",
      "markers": []
    },
    {
      "id": "s116",
      "start": 9576,
      "end": 9588,
      "text": ": أنت وأخوك ",
      "markers": []
    },
    {
      "id": "s117",
      "start": 9604,
      "end": 9652,
      "text": " جلَسا. وكذلك قولُه: {وَلَا عَلَى أَنْفُسِكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9625,
          "end": 9651,
          "span_id": "s117"
        }
      ]
    },
    {
      "id": "s118",
      "start": 9652,
      "end": 9711,
      "text": " والخبرُ عن الأعمى والأعرجِ والمريضِ، غَلَّب المخاطبَ فقال:",
      "markers": []
    },
    {
      "id": "s119",
      "start": 9711,
      "end": 9754,
      "text": " {أَنْ تَأْكُلُوا}. ولم يَقُلْ: أن يأكُلوا.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9712,
          "end": 9729,
          "span_id": "s119"
        }
      ]
    },
    {
      "id": "s120",
      "start": 9754,
      "end": 9806,
      "text": "فإن قال قائلٌ: فهذا الأكْلُ مِن بيوتِهم قد عَلِمناه ",
      "markers": []
    },
    {
      "id": "s121",
      "start": 9824,
      "end": 9840,
      "text": " كان لهم حلالًا ",
      "markers": []
    },
    {
      "id": "s122",
      "start": 9866,
      "end": 9933,
      "text": " كان مِلْكًا لهم، أَوَ كان أيضًا حلالًا لهم الأكلُ مِن مالِ غيرِهم؟",
      "markers": []
    },
    {
      "id": "s123",
      "start": 9933,
      "end": 9995,
      "text": "قيل له: ليس الأمرُ في ذلك على ما توهَّمْتَ، ولكنه كما ذكَرناه ",
      "markers": []
    },
    {
      "id": "s124",
      "start": 10013,
      "end": 10025,
      "text": " عن عُبَيدِ ",
      "markers": []
    },
    {
      "id": "s125",
      "start": 10041,
      "end": 10222,
      "text": " اللَّهِ بن عبدِ اللَّهِ، أنهم كانوا إذا غابُوا في مَغازيهم، وتَخلَّف أهلُ الزَّمانةِ منهم، دفَع الغازِي مِفْتَاحَ مَسْكنِه إلى المُتَخَلِّفِ منهم، فأطلَق له في الأكلِ مما يَخْلُفُ ",
      "markers": []
    },
    {
      "id": "s126",
      "start": 10242,
      "end": 10246,
      "text": " في ",
      "markers": []
    },
    {
      "id": "s127",
      "start": 10250,
      "end": 10275,
      "text": "منزلِه مِن الطعامِ، فكان ",
      "markers": []
    },
    {
      "id": "s128",
      "start": 10297,
      "end": 10298,
      "text": " ",
      "markers": []
    },
    {
      "id": "s129",
      "start": 10385,
      "end": 10483,
      "text": " الأكلَ مِن ذلك وربُّه غائبٌ، فأعلَمه اللَّهُ أنه لا حرجَ عليه في الأكلِ منه، وأذِن لهم في أكْلِه.",
      "markers": []
    },
    {
      "id": "s130",
      "start": 10483,
      "end": 10511,
      "text": " فإذ كان ذلك كذلك تَبَيَّنَ ",
      "markers": []
    },
    {
      "id": "s131",
      "start": 10526,
      "end": 10557,
      "text": " ألا معنَى لقولِ مَن قال: إنما ",
      "markers": []
    },
    {
      "id": "s132",
      "start": 10569,
      "end": 10651,
      "text": " أُنزلت هذه الآيةُ مِن أجلِ كراهةِ المُسْتَتْبِعِ أَكلَ طعامِ غيرِ المُسْتَتْبَعِ؛",
      "markers": []
    },
    {
      "id": "s133",
      "start": 10651,
      "end": 10671,
      "text": " لان ذلك لو كان كما ",
      "markers": []
    },
    {
      "id": "s134",
      "start": 10692,
      "end": 10714,
      "text": " قال مَن قال ذلك لقيل:",
      "markers": []
    },
    {
      "id": "s135",
      "start": 10714,
      "end": 10801,
      "text": " ليس عليكم حَرَجٌ أن تأكُلوا مِن طعامِ غيرِ مَن أضافَكم، أو مِن طعامِ آباءِ مَن دَعاكم.",
      "markers": []
    },
    {
      "id": "s136",
      "start": 10801,
      "end": 10873,
      "text": " ولم يَقُلْ: {أَنْ تَأْكُلُوا مِنْ بُيُوتِكُمْ أَوْ بُيُوتِ آبَائِكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10814,
          "end": 10872,
          "span_id": "s136"
        }
      ]
    },
    {
      "id": "s137",
      "start": 10873,
      "end": 10902,
      "text": " وكذلك لا وجهَ لقولِ مَن قال:",
      "markers": []
    },
    {
      "id": "s138",
      "start": 10902,
      "end": 10974,
      "text": " معنى ذلك: ليس على الأعمى حَرَجٌ في التخلفِ عن الجهادِ في سبيلِ اللَّهِ؛",
      "markers": []
    },
    {
      "id": "s139",
      "start": 10974,
      "end": 11118,
      "text": " لأن قولَه: هو {أَنْ تَأْكُلُوا} خبرُ و {لَيْسَ}، {أَنْ} في موضعِ نصبٍ على أنها خبرٌ لها، فهي متعلقةٌ بـ {لَيْسَ}، فمعلومٌ بذلك أن معنى الكلامِ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10989,
          "end": 11006,
          "span_id": "s139"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11014,
          "end": 11022,
          "span_id": "s139"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11024,
          "end": 11030,
          "span_id": "s139"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11079,
          "end": 11087,
          "span_id": "s139"
        }
      ]
    },
    {
      "id": "s140",
      "start": 11118,
      "end": 11149,
      "text": " ليس على الأعمى حرجٌ أن يأكُلَ ",
      "markers": []
    },
    {
      "id": "s141",
      "start": 11166,
      "end": 11245,
      "text": " مِن بيتِه. لا ما قاله الذين ذكَرنا، من أنه لا حرجَ عليه في التخلفِ عن الجهادِ.",
      "markers": []
    },
    {
      "id": "s142",
      "start": 11245,
      "end": 11271,
      "text": "فإذ كان الأمرُ في ذلك على ",
      "markers": []
    },
    {
      "id": "s143",
      "start": 11275,
      "end": 11312,
      "text": "ما وصَفنا، تَبَيَّنَ أن معنى الكلامِ:",
      "markers": []
    },
    {
      "id": "s144",
      "start": 11312,
      "end": 11445,
      "text": " لا ضِيقَ على الأعمى، ولا على الأعرجِ، ولا على المريضِ، ولا عليكم أيُّها الناسُ، أن تأكُلوا مِن بيوتِ أنفسِكم، أو مِن بيوتِ آبائِكم، ",
      "markers": []
    },
    {
      "id": "s145",
      "start": 11468,
      "end": 11469,
      "text": " ",
      "markers": []
    },
    {
      "id": "s146",
      "start": 11483,
      "end": 11667,
      "text": "، أو مِن بيوتِ إخوانِكم، أو مِن بيوتِ أخواتِكم، أو مِن بيوتِ أعْمامِكم، أو مِن بيوتِ عَمَّاتِكم، أو مِن بيوتِ أخوالِكم، أو مِن بيوتِ خالاتِكم، أو مِن البيوتِ التي مَلَكْتُم مَفاتِحَها ",
      "markers": []
    },
    {
      "id": "s147",
      "start": 11697,
      "end": 11771,
      "text": "، أو مِن بيوتِ صديِقكم، إذا أذِنوا لكم في ذلك عندَ مَغِيبِهم ومَشْهَدِهِم.",
      "markers": []
    },
    {
      "id": "s148",
      "start": 11771,
      "end": 11865,
      "text": "والمفاتُحِ: الخزائنُ، واحِدُها: مِفْتَحٌ، إذا أُرِيدَ به المصدرُ، وإذا كان مِن المفاتيحِ التي ",
      "markers": []
    },
    {
      "id": "s149",
      "start": 11888,
      "end": 11898,
      "text": " يُفْتَحُ ",
      "markers": []
    },
    {
      "id": "s150",
      "start": 11915,
      "end": 11944,
      "text": " بها، فهى مِفْتَحٌ ومَفاتِحُ ",
      "markers": []
    },
    {
      "id": "s151",
      "start": 11973,
      "end": 12043,
      "text": ". وهى ههنا على التأويلِ الذي اخْتَرناه جمعُ مِفْتَحٍ الذي يُفْتَحُ به.",
      "markers": []
    },
    {
      "id": "s152",
      "start": 12043,
      "end": 12073,
      "text": "وكان قتادةُ يتأوَّلُ في قولِه:",
      "markers": []
    },
    {
      "id": "s153",
      "start": 12073,
      "end": 12129,
      "text": " {أَوْ صَدِيقِكُمْ}. ما حدَّثنا به الحسنُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12074,
          "end": 12092,
          "span_id": "s153"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 12097,
          "end": 12104,
          "span_id": "s153"
        }
      ]
    },
    {
      "id": "s154",
      "start": 12129,
      "end": 12172,
      "text": " أخبَرنا عبدُ الرزاقِ، عن معمرٍ، عن قتادةَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 12130,
          "end": 12137,
          "span_id": "s154"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 12152,
          "end": 12172,
          "stripped": "عن معمر، عن قتادة:",
          "span_id": "s154"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 12165,
          "end": 12170,
          "span_id": "s154"
        }
      ]
    },
    {
      "id": "s155",
      "start": 12172,
      "end": 12257,
      "text": " {أَوْ صَدِيقِكُمْ}: فلو أكَلْتَ مِن بيتِ صديقِك مِن غيرِ أمرِه، لم يَكُنْ بذلك بأسٌ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12173,
          "end": 12191,
          "span_id": "s155"
        }
      ]
    },
    {
      "id": "s156",
      "start": 12257,
      "end": 12288,
      "text": " قال معمرٌ: قلتُ لقتادةَ: أَوَ ",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 12269,
          "end": 12272,
          "span_id": "s156"
        }
      ]
    },
    {
      "id": "s157",
      "start": 12312,
      "end": 12339,
      "text": " لَا أشربُ مِن هذا الحُبِّ ",
      "markers": []
    },
    {
      "id": "s158",
      "start": 12404,
      "end": 12418,
      "text": "؟ قال: أنت لي ",
      "markers": []
    },
    {
      "id": "s159",
      "start": 12434,
      "end": 12441,
      "text": " صديقٌ ",
      "markers": []
    },
    {
      "id": "s160",
      "start": 12606,
      "end": 12688,
      "text": ".وأما قولُه: {لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَأْكُلُوا جَمِيعًا أَوْ أَشْتَاتًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12619,
          "end": 12687,
          "span_id": "s160"
        }
      ]
    },
    {
      "id": "s161",
      "start": 12688,
      "end": 12727,
      "text": " فإن أهلَ التأويلِ اختَلفوا في تأويلِه؛",
      "markers": []
    },
    {
      "id": "s162",
      "start": 12727,
      "end": 12775,
      "text": " فقال بعضُهم: كان الغنيُّ مِن الناسِ يَتَحوَّبُ ",
      "markers": []
    },
    {
      "id": "s163",
      "start": 12791,
      "end": 12841,
      "text": " أن يأكُلَ مع الفقيرِ، فرَخَّص لهم في الأكلِ معهم.",
      "markers": []
    },
    {
      "id": "s164",
      "start": 12841,
      "end": 12878,
      "text": "ذكرُ مَن قال ذلكحدَّثنا القاسمُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 12857,
          "end": 12864,
          "span_id": "s164"
        }
      ]
    },
    {
      "id": "s165",
      "start": 12878,
      "end": 12965,
      "text": " ثنا الحسينُ، قال: ثني حجاجٌ، عن ابن جريجٍ، عن عطاءٍ الخُرَاسانيِّ، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 12908,
          "end": 12952,
          "stripped": "عن ابن جريج، عن عطاء الخراساني، عن ابن",
          "span_id": "s165"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 12911,
          "end": 12919,
          "span_id": "s165"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "NARRATOR",
          "start": 12925,
          "end": 12929,
          "span_id": "s165"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 12949,
          "end": 12957,
          "span_id": "s165"
        }
      ]
    },
    {
      "id": "s166",
      "start": 12965,
      "end": 13009,
      "text": " {أَنْ تَأْكُلُوا جَمِيعًا أَوْ أَشْتَاتًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12966,
          "end": 13008,
          "span_id": "s166"
        }
      ]
    },
    {
      "id": "s167",
      "start": 13009,
      "end": 13114,
      "text": " قال: كان الغنيُّ يدخُلُ على الفقيرِ من ذَوِى قرابتِه وصديقِه، فيَدْعُوه إلى طعامِه ليأكُلَ معه، فيقولُ: ",
      "markers": []
    },
    {
      "id": "s168",
      "start": 13128,
      "end": 13129,
      "text": " ",
      "markers": []
    },
    {
      "id": "s169",
      "start": 13151,
      "end": 13198,
      "text": " لأَجْنَحُ أن أكُلَ معك - والجُنْحُ: الحَرَجُ -",
      "markers": []
    },
    {
      "id": "s170",
      "start": 13210,
      "end": 13211,
      "text": " ",
      "markers": []
    },
    {
      "id": "s171",
      "start": 13233,
      "end": 13285,
      "text": " وأنت فقيرٌ. فأُمِروا أن يأكُلوا جميعًا أو أشْتاتًا ",
      "markers": []
    },
    {
      "id": "s172",
      "start": 13415,
      "end": 13496,
      "text": ".وقال آخرون: بل عُنِى بذلك حيٌّ مِن أحياءِ العربِ، كانوا لا يأكُلُ أحدُهم وحدَه، ",
      "markers": []
    },
    {
      "id": "s173",
      "start": 13570,
      "end": 13571,
      "text": " ",
      "markers": []
    },
    {
      "id": "s174",
      "start": 13585,
      "end": 13610,
      "text": "، ومَن شاء منهم مع غيرِه.",
      "markers": []
    },
    {
      "id": "s175",
      "start": 13610,
      "end": 13645,
      "text": "ذكرُ مَن قال ذلكحدَّثني عليٌّ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 13634,
          "end": 13637,
          "span_id": "s175"
        }
      ]
    },
    {
      "id": "s176",
      "start": 13645,
      "end": 13707,
      "text": " ثنا أبو صالحٍ، قال: ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 13679,
          "end": 13707,
          "stripped": "عن علي، عن ابن عباس، قال:",
          "span_id": "s176"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 13682,
          "end": 13685,
          "span_id": "s176"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 13692,
          "end": 13700,
          "span_id": "s176"
        }
      ]
    },
    {
      "id": "s177",
      "start": 13707,
      "end": 13813,
      "text": " كانوا يأنَفُون ويَتَحَرَّجون أن يأكُلَ الرجلُ الطعامَ وحدَه حتى يكونَ معه غيرُه، فرَخَّص اللهُ لهم، فقال:",
      "markers": []
    },
    {
      "id": "s178",
      "start": 13813,
      "end": 13883,
      "text": " {لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَأْكُلُوا جَمِيعًا أَوْ أَشْتَاتًا} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13814,
          "end": 13882,
          "span_id": "s178"
        }
      ]
    },
    {
      "id": "s179",
      "start": 13906,
      "end": 13946,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 13907,
          "end": 13914,
          "span_id": "s179"
        }
      ]
    },
    {
      "id": "s180",
      "start": 13946,
      "end": 13994,
      "text": " ثني حجاجٌ، عن ابن جريجٍ، قال: كانت بنو كِنانةَ ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 13961,
          "end": 13969,
          "span_id": "s180"
        }
      ]
    },
    {
      "id": "s181",
      "start": 14039,
      "end": 14103,
      "text": " يَسْتَحْيِي الرجلُ منهم أن يأكُلَ وحدَه، حتى نزلَتْ هذه الآيةُ ",
      "markers": []
    },
    {
      "id": "s182",
      "start": 14125,
      "end": 14176,
      "text": ".حُدِّثْتُ عن الحسينِ، قال: سمِعتُ أبا معاذٍ يقولُ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 14164,
          "end": 14168,
          "span_id": "s182"
        }
      ]
    },
    {
      "id": "s183",
      "start": 14176,
      "end": 14218,
      "text": " أخبَرنا عبيدٌ، قال: سمِعتُ الضحاكَ يقولُ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 14177,
          "end": 14184,
          "span_id": "s183"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 14204,
          "end": 14210,
          "span_id": "s183"
        }
      ]
    },
    {
      "id": "s184",
      "start": 14218,
      "end": 14326,
      "text": " كانوا لا يأكُلون إلا جميعًا، ولا يأكُلون مُتَفرِّقين، وكان ذلك فيهم دِينًا، فأنزَل اللهُ: ليس عليكم حَرَجٌ ",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 14295,
          "end": 14301,
          "span_id": "s184"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 14295,
          "end": 14306,
          "span_id": "s184"
        }
      ]
    },
    {
      "id": "s185",
      "start": 14340,
      "end": 14344,
      "text": " في ",
      "markers": []
    },
    {
      "id": "s186",
      "start": 14348,
      "end": 14422,
      "text": "مُؤاكَلةِ المريضِ والأعمى، وليس عليكم حَرجٌ أن تأكُلوا جميعًا أو أشْتاتًا ",
      "markers": []
    },
    {
      "id": "s187",
      "start": 14481,
      "end": 14524,
      "text": ".حدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 14502,
          "end": 14509,
          "span_id": "s187"
        }
      ]
    },
    {
      "id": "s188",
      "start": 14524,
      "end": 14547,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 14529,
          "end": 14536,
          "span_id": "s188"
        }
      ]
    },
    {
      "id": "s189",
      "start": 14547,
      "end": 14617,
      "text": " {لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَأْكُلُوا جَمِيعًا أَوْ أَشْتَاتًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14548,
          "end": 14616,
          "span_id": "s189"
        }
      ]
    },
    {
      "id": "s190",
      "start": 14617,
      "end": 14715,
      "text": " قال: كان مِن العربِ مِن لا يأكُلُ أبدًا جميعًا، ومنهم مَن لا يأكُلُ إلا جميعًا، فقال اللَّهُ ذلك ",
      "markers": []
    },
    {
      "id": "s191",
      "start": 14779,
      "end": 14827,
      "text": ".حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 14780,
          "end": 14787,
          "span_id": "s191"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 14780,
          "end": 14827,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s191"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 14788,
          "end": 14793,
          "span_id": "s191"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 14801,
          "end": 14808,
          "span_id": "s191"
        }
      ]
    },
    {
      "id": "s192",
      "start": 14827,
      "end": 14858,
      "text": " أخبَرنا معمرٌ، عن قتادةَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 14828,
          "end": 14835,
          "span_id": "s192"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 14846,
          "end": 14851,
          "span_id": "s192"
        }
      ]
    },
    {
      "id": "s193",
      "start": 14858,
      "end": 15043,
      "text": " نزلَت: {لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَأْكُلُوا جَمِيعًا أَوْ أَشْتَاتًا} في حيٍّ مِن العربِ كان الرجلُ منهم لا يأكُلُ طعامَه وحدَه، كان يحمِلُه بعضَ يومٍ حتى يَجِدَ مَن يأكُلُه معه.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14866,
          "end": 14934,
          "span_id": "s193"
        }
      ]
    },
    {
      "id": "s194",
      "start": 15043,
      "end": 15083,
      "text": " قال: وأحسَبُ أنه ذكَر أنهم مِن كِنانَة ",
      "markers": []
    },
    {
      "id": "s195",
      "start": 15223,
      "end": 15224,
      "text": ".",
      "markers": []
    },
    {
      "id": "s196",
      "start": 15306,
      "end": 15307,
      "text": " ",
      "markers": []
    },
    {
      "id": "s197",
      "start": 15321,
      "end": 15331,
      "text": "، فرَخَّص ",
      "markers": []
    },
    {
      "id": "s198",
      "start": 15348,
      "end": 15356,
      "text": " لهم في ",
      "markers": []
    },
    {
      "id": "s199",
      "start": 15378,
      "end": 15441,
      "text": " أن يأكُلوا كيف شاءوا.ذكرُ مَن قال ذلكحدَّثني أبو السائبِ، قال:",
      "markers": []
    },
    {
      "id": "s200",
      "start": 15441,
      "end": 15501,
      "text": " ثنا حفصٌ، عن عمرانَ بن سليمانَ، عن أبي صالحٍ وعكرمةَ، قالا:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 15452,
          "end": 15501,
          "stripped": "عن عمران بن سليمان، عن أبي صالح وعكرمة، قالا:",
          "span_id": "s200"
        }
      ]
    },
    {
      "id": "s201",
      "start": 15501,
      "end": 15596,
      "text": " كانت الأنصارُ إذا نزَل بهم الضيفُ، لا يأكُلون حتى يأكُلَ الضيفُ معهم، فرُخِّصَ لهم، قال اللهُ:",
      "markers": []
    },
    {
      "id": "s202",
      "start": 15596,
      "end": 15641,
      "text": " لا جُناحَ عليكم أن تأكلوا جميعًا أو أشتاتًا ",
      "markers": []
    },
    {
      "id": "s203",
      "start": 15701,
      "end": 15743,
      "text": ".وأَولى الأقوالِ في ذلك بالصوابِ أن يقالَ:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 15737,
          "end": 15741,
          "span_id": "s203"
        }
      ]
    },
    {
      "id": "s204",
      "start": 15743,
      "end": 15768,
      "text": " إن الله وضَع الحَرَج عن ",
      "markers": []
    },
    {
      "id": "s205",
      "start": 15785,
      "end": 15914,
      "text": " المسلمين، أن يأكُلوا جميعًا معًا إذا شاءوا، أو أشْتاتًا مُتَفرِّقين إذا أرادوا، وجائزٌ أن يكونَ ذلك نزَل بسببٍ مَن كان يتحوَّبُ ",
      "markers": []
    },
    {
      "id": "s206",
      "start": 15930,
      "end": 16150,
      "text": " مِن الأغنياءِ الأكلَ مع الفقيرِ، وجائزٌ أن يكونَ نزَل بسببِ القومِ الذين ذُكر أنهم كانوا لا يَطْعَمون وُحْدانًا، وبسببِ غيرِ ذلك، ولا خبرَ بشيءٍ مِن ذلك يقطَعُ العُذْرَ، ولا دلالةَ في ظاهرِ التنزيلِ على حقيقةِ شيءٍ منه.",
      "markers": []
    },
    {
      "id": "s207",
      "start": 16150,
      "end": 16239,
      "text": " والصوابُ التسليمُ لِما دلَّ عليه ظاهرُ التنزيلِ، والتوقفُ فيما لم يَكُنْ على صحتِه دليل.",
      "markers": []
    },
    {
      "id": "s208",
      "start": 16239,
      "end": 16338,
      "text": "وقولُه: {فَإِذَا دَخَلْتُمْ بُيُوتًا فَسَلِّمُوا عَلَى أَنْفُسِكُمْ تَحِيَّةً مِنْ عِنْدِ اللَّهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 16247,
          "end": 16337,
          "span_id": "s208"
        }
      ]
    },
    {
      "id": "s209",
      "start": 16338,
      "end": 16393,
      "text": " اختَلف أهلُ التأويلِ في ذلك؛ فقال بعضُهم: معناه: فإذا ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 16381,
          "end": 16386,
          "span_id": "s209"
        }
      ]
    }
  ],

  "spans": [
    {
      "id": "s110",
      "start": 9224,
      "end": 9265,
      "text": "ْتُرْنَ بذلك شعورَهن وأعناقَهن وقُرْطَهن.",
      "markers": []
    },
    {
      "id": "s111",
      "start": 9265,
      "end": 9336,
      "text": "حدَّثنا ابن وكيعٍ، قال: ثنا زيدُ بنُ حُبابٍ، عن إبراهيمَ بن نافعٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9265,
          "end": 9272,
          "span_id": "s111"
        }
      ]
    },
    {
      "id": "s112",
      "start": 9336,
      "end": 9408,
      "text": " ثنا الحسنُ بنُ مسلمِ بن يَنَّاقٍ، عن صفيةَ بنتِ شيبةَ، عن عائشةَ، قالت:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9371,
          "end": 9408,
          "stripped": "عن صفية بنت شيبة، عن عائشة، قالت:",
          "span_id": "s112"
        },
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 9395,
          "end": 9400,
          "span_id": "s112"
        }
      ]
    },
    {
      "id": "s113",
      "start": 9408,
      "end": 9482,
      "text": " لمَّا نزَلت هذه الآيةُ: {وَلْيَضْرِبْنَ بِخُمُرِهِنَّ عَلَى جُيُوبِهِنّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9433,
          "end": 9481,
          "span_id": "s113"
        }
      ]
    },
    {
      "id": "s114",
      "start": 9482,
      "end": 9543,
      "text": " قال: شَقَقْن البُرُدَ مما يَلِى الحَواشِىَ، فاخْتَمَرْنَ به ",
      "markers": []
    },
    {
      "id": "s115",
      "start": 9680,
      "end": 9836,
      "text": ".حدَّثني يونُسُ، قال: أخبَرنا ابن وهبٍ، أن قُرَّةَ بنَ عبدِ الرحمنِ أخبَره، عن ابن شهابٍ، عن عروةَ، عن عائشةَ زوجِ النبيِّ - صلى الله عليه وسلم - أنها قالت:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 9702,
          "end": 9709,
          "span_id": "s115"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9756,
          "end": 9804,
          "stripped": "عن ابن شهاب، عن عروة، عن عائشة زوج النبي -",
          "span_id": "s115"
        },
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 9783,
          "end": 9788,
          "span_id": "s115"
        },
        {
          "family": "HADITH",
          "marker": "النبي",
          "role": "SPEAKER",
          "start": 9795,
          "end": 9800,
          "span_id": "s115"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 9805,
          "end": 9823,
          "span_id": "s115"
        }
      ]
    },
    {
      "id": "s116",
      "start": 9836,
      "end": 9903,
      "text": " يَرْحَمُ اللَّهُ النساءَ المهاجراتِ الأُوَلَ، لمّا أنزَلَ اللَّهُ:",
      "markers": []
    },
    {
      "id": "s117",
      "start": 9903,
      "end": 9970,
      "text": " {وَلْيَضْرِبْنَ بِخُمُرِهِنَّ عَلَى جُيُوبِهِنّ} شَقَقْن أَكْثَفَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9904,
          "end": 9952,
          "span_id": "s117"
        }
      ]
    },
    {
      "id": "s118",
      "start": 10041,
      "end": 10068,
      "text": " مُرُوطِهن، فاخْتَمَرْن به ",
      "markers": []
    },
    {
      "id": "s119",
      "start": 10271,
      "end": 10335,
      "text": ".وقولُه: {وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10280,
          "end": 10334,
          "span_id": "s119"
        }
      ]
    },
    {
      "id": "s120",
      "start": 10335,
      "end": 10455,
      "text": " يقولُ تعالى ذكرُه: ولا يُبْدِين زينتَهنَّ التي هي غيرُ ظاهرةٍ، بل الخفيةُ منها؛ وذلك الخَلْخالُ والقُرْطُ والدُّمْلُجُ ",
      "markers": []
    },
    {
      "id": "s121",
      "start": 10504,
      "end": 10671,
      "text": "، وما أُمِرَت بتغطيتِه بخمارِها مِن فوقِ الجَيْبِ، وما وراءَ ما أُبِيح لها كشفُه وإبرازُه في الصلاةِ وللأجْنَبِيّين مِن الناسِ، والذراعين إلى فوقِ ذلك - إلا لبعولتِهن.",
      "markers": []
    },
    {
      "id": "s122",
      "start": 10671,
      "end": 10720,
      "text": "وبنحوِ الذي قلنا في تأويلِ ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s123",
      "start": 10720,
      "end": 10759,
      "text": "ذكرُ مَن قال ذلكحدَّثنا ابن بشارٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10736,
          "end": 10743,
          "span_id": "s123"
        }
      ]
    },
    {
      "id": "s124",
      "start": 10759,
      "end": 10841,
      "text": " ثنا عبدُ الرحمنِ، قال: ثنا سفيانُ، عن منصورٍ، عن طلحةَ بن مُصَرِّفٍ، عن إبراهيمَ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10795,
          "end": 10831,
          "stripped": "عن منصور، عن طلحة بن مصرف، عن",
          "span_id": "s124"
        }
      ]
    },
    {
      "id": "s125",
      "start": 10841,
      "end": 10914,
      "text": " {وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ أَوْ آبَائِهِنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10842,
          "end": 10913,
          "span_id": "s125"
        }
      ]
    },
    {
      "id": "s126",
      "start": 10914,
      "end": 10940,
      "text": " قال: هذه ما فوقَ الذراعِ ",
      "markers": []
    },
    {
      "id": "s127",
      "start": 11047,
      "end": 11098,
      "text": ".حدَّثنا ابن المثنى، قال: ثنا محمدُ بنُ جعفرٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11048,
          "end": 11055,
          "span_id": "s127"
        }
      ]
    },
    {
      "id": "s128",
      "start": 11098,
      "end": 11125,
      "text": " ثنا شعبةُ، عن منصورٍ، قال:",
      "markers": []
    },
    {
      "id": "s129",
      "start": 11125,
      "end": 11191,
      "text": " سمِعْتُ رجلًا يُحَدِّثُ عن طلحةَ، عن إبراهيمَ، قال في هذه الآيةِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11150,
          "end": 11183,
          "stripped": "عن طلحة، عن إبراهيم، قال في هذه",
          "span_id": "s129"
        }
      ]
    },
    {
      "id": "s130",
      "start": 11191,
      "end": 11268,
      "text": " {وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ أَوْ آبَائِهِنَّ أَوْ ",
      "markers": []
    },
    {
      "id": "s131",
      "start": 11272,
      "end": 11318,
      "text": "آبَاءِ بُعُولَتِهِنَّ}. قال: ما فوقَ الجَيْبِ.",
      "markers": []
    },
    {
      "id": "s132",
      "start": 11318,
      "end": 11366,
      "text": " قال شعبةُ: كتَب به منصورٌ إليَّ، وقرأْتُه عليه.",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 11353,
          "end": 11356,
          "span_id": "s132"
        }
      ]
    },
    {
      "id": "s133",
      "start": 11366,
      "end": 11448,
      "text": "حدَّثني يعقوبُ، قال: ثنا ابن عُلَيةَ، عن سعيدِ بن أبى عَروبةَ، عن قتادةَ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11404,
          "end": 11448,
          "stripped": "عن سعيد بن أبى عروبة، عن قتادة في قوله:",
          "span_id": "s133"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 11432,
          "end": 11437,
          "span_id": "s133"
        }
      ]
    },
    {
      "id": "s134",
      "start": 11448,
      "end": 11504,
      "text": " {وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11449,
          "end": 11503,
          "span_id": "s134"
        }
      ]
    },
    {
      "id": "s135",
      "start": 11504,
      "end": 11552,
      "text": " قال: تُبْدِى لهؤلاء الرأسَ. حدَّثني عليٌّ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 11541,
          "end": 11544,
          "span_id": "s135"
        }
      ]
    },
    {
      "id": "s136",
      "start": 11552,
      "end": 11614,
      "text": " ثنا أبو صالحٍ، قال: ثنى معاويةُ، عن عليٍّ، عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",

          "span_id": "s136"
        }
      ]
    },
    {
      "id": "s137",
      "start": 11614,
      "end": 11680,
      "text": " {وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ} إلى قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11615,
          "end": 11669,
          "span_id": "s137"
        }
      ]
    },
    {
      "id": "s138",
      "start": 11680,
      "end": 11732,
      "text": " {عَوْرَاتِ النِّسَاءِ}. قال: الزينةُ التي تُبدِيها ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11681,
          "end": 11703,
          "span_id": "s138"
        }
      ]
    },
    {
      "id": "s139",
      "start": 11750,
      "end": 11869,
      "text": " لهؤلاء؛ قُرْطاها وقِلادتُها وسِوَارَاها، فأما خَلْخالَاها ومِعْضَدُها ونحرُها وشعَرُها، فإنها لا تُبْدِيه إلا لزوجِها ",
      "markers": []
    },
    {
      "id": "s140",
      "start": 11901,
      "end": 11941,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11902,
          "end": 11909,
          "span_id": "s140"
        }
      ]
    },
    {
      "id": "s141",
      "start": 11941,
      "end": 11973,
      "text": " ثنى حجّاجٌ، قال: قال ابن جريجٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 11963,
          "end": 11971,
          "span_id": "s141"
        }
      ]
    },
    {
      "id": "s142",
      "start": 11973,
      "end": 11998,
      "text": " قال ابن مسعودٍ في قولِه:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن مسعود",
          "name": "ابن مسعود",
          "role": "SPEAKER",
          "start": 11978,
          "end": 11987,
          "span_id": "s142"
        }
      ]
    },
    {
      "id": "s143",
      "start": 11998,
      "end": 12054,
      "text": " {وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنّ} -",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11999,
          "end": 12052,
          "span_id": "s143"
        }
      ]
    },
    {
      "id": "s144",
      "start": 12068,
      "end": 12069,
      "text": " ",
      "markers": []
    },
    {
      "id": "s145",
      "start": 12081,
      "end": 12136,
      "text": " قال: الطَّوْقَ والقُرْطَيْن.يقولُ اللَّهُ تعالى ذكرُه:",
      "markers": []
    },
    {
      "id": "s146",
      "start": 12136,
      "end": 12292,
      "text": " قلْ للمؤمناتِ الحَرائرِ: لا يُظْهِرْنَ هذه الزينةَ الخفيةَ التي ليست بالظاهرةِ {إِلَّا لِبُعُولَتِهِنَّ} وهم أزواجُهن، واحدُهم بَعْلٌ، {أَوْ} لـ {آبَائِهِن",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12216,
          "end": 12241,
          "span_id": "s146"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12272,
          "end": 12278,
          "span_id": "s146"
        }
      ]
    },
    {
      "id": "s147",
      "start": 12296,
      "end": 12331,
      "text": "َّ}، أو لـ {آبَاءِ بُعُولَتِهِنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12307,
          "end": 12330,
          "span_id": "s147"
        }
      ]
    },
    {
      "id": "s148",
      "start": 12331,
      "end": 12448,
      "text": " يقولُ: أو لآباءِ أزواجِهن {أَوْ} {أَبْنَائِهِنَّ أَوْ} لـ {أَبْنَاءِ بُعُولَتِهِنَّ أَوْ} لـ {بَنِي إِخْوَانِهِنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12358,
          "end": 12364,
          "span_id": "s148"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12365,
          "end": 12386,
          "span_id": "s148"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12390,
          "end": 12421,
          "span_id": "s148"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12425,
          "end": 12447,
          "span_id": "s148"
        }
      ]
    },
    {
      "id": "s149",
      "start": 12448,
      "end": 12504,
      "text": "ويعنى بقولِه: {أَو} لـ {إِخْوَانِهِنَّ}: أو لإخْوتِهنَّ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12462,
          "end": 12467,
          "span_id": "s149"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12471,
          "end": 12487,
          "span_id": "s149"
        }
      ]
    },
    {
      "id": "s150",
      "start": 12560,
      "end": 12596,
      "text": " - {أَوْ} لـ {بَنِي أَخَوَاتِهِنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12563,
          "end": 12569,
          "span_id": "s150"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12573,
          "end": 12595,
          "span_id": "s150"
        }
      ]
    },
    {
      "id": "s151",
      "start": 12596,
      "end": 12647,
      "text": "{أَوْ نِسَائِهِنّ}. قيل: عُنِى بذلك نساءُ المسلمين.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12596,
          "end": 12614,
          "span_id": "s151"
        }
      ]
    },
    {
      "id": "s152",
      "start": 12647,
      "end": 12684,
      "text": "ذكرُ مَن قال ذلكحدَّثنا القاسمُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 12663,
          "end": 12670,
          "span_id": "s152"
        }
      ]
    },
    {
      "id": "s153",
      "start": 12684,
      "end": 12735,
      "text": " ثنا الحسينُ، قال: ثنى حجّاجٌ، عن ابن جُريجٍ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 12718,
          "end": 12727,
          "span_id": "s153"
        }
      ]
    },
    {
      "id": "s154",
      "start": 12735,
      "end": 12838,
      "text": " {أَوْ نِسَائِهِنَّ}. قال: بلَغَنى أنهن نساءُ المسلمين، لا يَحِلُّ لمسلمةٍ أن تُرِىَ مُشركةً عِرْيتَها ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12736,
          "end": 12755,
          "span_id": "s154"
        }
      ]
    },
    {
      "id": "s155",
      "start": 12876,
      "end": 12949,
      "text": "، إلا أن تكونَ أمَةً لها، فذلك قولُه: {أَوْ مَا مَلَكَتْ أَيْمَانُهُنَّ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12914,
          "end": 12948,
          "span_id": "s155"
        }
      ]
    },
    {
      "id": "s156",
      "start": 12985,
      "end": 13093,
      "text": "قال: ثنى الحسينُ، قال: ثنى عيسى بنُ يونُسَ، عن هشامِ بن الغازِ، عن عُبادةَ بن نُسَيٍّ، أنه كرِه أن تَقْبَلَ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 13029,
          "end": 13075,
          "stripped": "عن هشام بن الغاز، عن عبادة بن نسي، أنه",
          "span_id": "s156"
        }
      ]
    },
    {
      "id": "s157",
      "start": 13171,
      "end": 13248,
      "text": " النصرانيةُ المسلمةَ، أَو تَرَى عَوْرَتَها، ويَتَأَوَّلُ {أَوْ نِسَائِهِنَّ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13228,
          "end": 13247,
          "span_id": "s157"
        }
      ]
    },
    {
      "id": "s158",
      "start": 13280,
      "end": 13317,
      "text": ".قال: ثنا عيسى بنُ يونُسَ، عن هشامٍ، ",
      "markers": []
    },
    {
      "id": "s159",
      "start": 13321,
      "end": 13412,
      "text": "عن عُبادةَ، قال: كتَب عمرُ بنُ الخطابِ إلى أبى عُبيدةَ بن الجرَّاحِ - رضِى اللَّهُ عنهما -:",
      "markers": []
    },
    {
      "id": "s160",
      "start": 13412,
      "end": 13521,
      "text": " أما بعدُ، فقد بلَغَنى أن نساءً يَدْخُلْنَ الحَمَّاماتِ، ومعهن نساءُ أهلِ الكتابِ، فامْنَعْ ذلك، وحُلْ دونَه.",
      "markers": [
        {
          "family": "ISRAILIYYAT",
          "marker": "أهل الكتاب",
          "start": 13481,
          "end": 13492,
          "span_id": "s160"
        }
      ]
    },
    {
      "id": "s161",
      "start": 13521,
      "end": 13576,
      "text": " قال: ثم إن أبا عُبيدةَ قام في ذلك المقامِ مُبْتَهِلًا:",
      "markers": []
    },
    {
      "id": "s162",
      "start": 13576,
      "end": 13704,
      "text": " اللهم أيُّما امرأةٍ تَدْخُلُ الحمامَ مِن غيرِ علَّةٍ ولا سَقَمٍ، تُرِيدُ البياضَ لوجهِها، فسوِّدْ وجهَها يومَ تَبْيَضُّ الوجوه ",
      "markers": []
    },
    {
      "id": "s163",
      "start": 13905,
      "end": 13949,
      "text": ".وقولُه: {أَوْ مَا مَلَكَتْ أَيْمَانُهُنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13914,
          "end": 13948,
          "span_id": "s163"
        }
      ]
    },
    {
      "id": "s164",
      "start": 13949,
      "end": 13985,
      "text": " اختلَف أهلُ التأويلِ في تأويلِ ذلك؛",
      "markers": []
    },
    {
      "id": "s165",
      "start": 13985,
      "end": 14083,
      "text": " فقال بعضُهم: أو مَمالِيكِهِن، فإنه لا بأسَ عليها أن تُظْهِرَ لهم مِن زينتِها ما تُظْهِرُه لهؤلاء.",
      "markers": []
    },
    {
      "id": "s166",
      "start": 14083,
      "end": 14120,
      "text": "ذكرُ مَن قال ذلكحدَّثنا القاسمُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 14099,
          "end": 14106,
          "span_id": "s166"
        }
      ]
    },
    {
      "id": "s167",
      "start": 14120,
      "end": 14169,
      "text": " ثنا الحسينُ، قال: ثنى حجاجٌ، عن ابن جُريجٍ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 14153,
          "end": 14162,
          "span_id": "s167"
        }
      ]
    },
    {
      "id": "s168",
      "start": 14169,
      "end": 14238,
      "text": " أخْبَرنى عمرُو بنُ دينارٍ، عن مَخْلَدٍ التَّميميِّ أنه قال في قولِه:",
      "markers": []
    },
    {
      "id": "s169",
      "start": 14238,
      "end": 14312,
      "text": " {أَوْ مَا مَلَكَتْ أَيْمَانُهُنَّ}. قال: في القراءةِ الأُولى: (أيمانُكم) ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14239,
          "end": 14273,
          "span_id": "s169"
        },
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 14285,
          "end": 14290,
          "span_id": "s169"
        }
      ]
    },
    {
      "id": "s170",
      "start": 14384,
      "end": 14409,
      "text": ".وقال آخرون: بل معنى ذلك:",
      "markers": []
    },
    {
      "id": "s171",
      "start": 14409,
      "end": 14450,
      "text": " أو ما مَلَكت أيمانُهن من إماءِ المشركين.",
      "markers": []
    },
    {
      "id": "s172",
      "start": 14450,
      "end": 14500,
      "text": " كما قد ذكَرنا عن ابن جريجٍ قبلُ، مِن أنه لما قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 14468,
          "end": 14476,
          "span_id": "s172"
        }
      ]
    },
    {
      "id": "s173",
      "start": 14500,
      "end": 14563,
      "text": " {أَوْ نِسَائِهِنَّ} عنَى بهن النساءَ المسلماتِ دونَ المشركاتِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14501,
          "end": 14520,
          "span_id": "s173"
        }
      ]
    },
    {
      "id": "s174",
      "start": 14563,
      "end": 14615,
      "text": " ثم قال: أو ما ملَكت أيمانُهن مِن الإماءِ المشركاتِ.",
      "markers": []
    },
    {
      "id": "s175",
      "start": 14615,
      "end": 14644,
      "text": "القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 14632,
          "end": 14643,
          "span_id": "s175"
        }
      ]
    },
    {
      "id": "s176",
      "start": 14644,
      "end": 14937,
      "text": " {أَوِ التَّابِعِينَ غَيْرِ أُولِي الْإِرْبَةِ مِنَ الرِّجَالِ أَوِ الطِّفْلِ الَّذِينَ لَمْ يَظْهَرُوا عَلَى عَوْرَاتِ النِّسَاءِ وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا يُخْفِينَ مِنْ زِينَتِهِنَّ وَتُوبُوا إِلَى اللَّهِ جَمِيعًا أَيُّهَ الْمُؤْمِنُونَ لَعَلَّكُمْ تُفْلِحُونَ (31)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 14645,
          "end": 14936,
          "span_id": "s176"
        }
      ]
    },
    {
      "id": "s177",
      "start": 14937,
      "end": 15077,
      "text": "يقولُ تعالى ذكرُه: والذين يَتَّبِعونكم لطعامٍ يَأْكُلونه عندَكم، ممَّن لا إرْبَ له في النساءِ مِن الرجالِ، ولا حاجةَ به إليهن ولا يُرِيدُهن.",
      "markers": []
    },
    {
      "id": "s178",
      "start": 15077,
      "end": 15119,
      "text": "وبنحوِ الذي قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s179",
      "start": 15119,
      "end": 15163,
      "text": "ذكرُ مَن قال ذلكحدَّثنى محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s180",
      "start": 15163,
      "end": 15191,
      "text": " ثنى أبى، قال: ثنى عمى، قال:",
      "markers": []
    },
    {
      "id": "s181",
      "start": 15191,
      "end": 15229,
      "text": " ثنى أبى، عن أبيه، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 15201,
          "end": 15229,
          "stripped": "عن أبيه، عن ابن عباس قوله:",
          "span_id": "s181"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 15213,
          "end": 15221,
          "span_id": "s181"
        }
      ]
    },
    {
      "id": "s182",
      "start": 15229,
      "end": 15310,
      "text": " {أَوِ التَّابِعِينَ غَيْرِ أُولِي الْإِرْبَةِ مِنَ الرِّجَالِ}. قال: كان الرجلُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 15230,
          "end": 15292,
          "span_id": "s182"
        }
      ]
    },
    {
      "id": "s183",
      "start": 15345,
      "end": 15366,
      "text": " يَتْبَعُ الرجلَ في ا",
      "markers": []
    },
    {
      "id": "s184",
      "start": 15370,
      "end": 15488,
      "text": "لزمانِ الأولِ، لا يَغارُ عليه، ولا تَرْهَبُ المرأةُ أَن تَضَعَ خمارَها عندَه، وهو الأحمقُ الذي لا حاجةَ له في النساءِ ",
      "markers": []
    },
    {
      "id": "s185",
      "start": 15548,
      "end": 15588,
      "text": ".حدَّثني عليٌّ، قال: ثنا أبو صالحٍ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 15557,
          "end": 15560,
          "span_id": "s185"
        }
      ]
    },
    {
      "id": "s186",
      "start": 15588,
      "end": 15631,
      "text": " ثنى معاويةُ، عن عليٍّ، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 15602,
          "end": 15631,
          "stripped": "عن علي، عن ابن عباس قوله:",
          "span_id": "s186"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 15605,
          "end": 15608,
          "span_id": "s186"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 15615,
          "end": 15623,
          "span_id": "s186"
        }
      ]
    },
    {
      "id": "s187",
      "start": 15631,
      "end": 15695,
      "text": " {أَوِ التَّابِعِينَ غَيْرِ أُولِي الْإِرْبَةِ مِنَ الرِّجَالِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 15632,
          "end": 15694,
          "span_id": "s187"
        }
      ]
    },
    {
      "id": "s188",
      "start": 15695,
      "end": 15935,
      "text": " فهذا الرجلُ يَتْبَعُ القومَ وهو مُغَفَّلٌ في عقلِه، لا يَكْتَرِثُ للنساءِ، ولا يَشْتَهِيهنَّ، فالزينةُ التي تُبْدِيها لهؤلاء قُرْطاها، وقِلادتُها، وسِوارَاها، وأما خَلْخالاها، ومِعْضَداها، ونَحرُها، وشعَرُها، فإنها لا تُبْدِيه إلا لزوجِها ",
      "markers": []
    },
    {
      "id": "s189",
      "start": 16091,
      "end": 16139,
      "text": ".حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 16092,
          "end": 16099,
          "span_id": "s189"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 16092,
          "end": 16139,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s189"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 16100,
          "end": 16105,
          "span_id": "s189"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 16113,
          "end": 16120,
          "span_id": "s189"
        }
      ]
    },
    {
      "id": "s190",
      "start": 16139,
      "end": 16174,
      "text": " أخبَرنا معمرٌ، عن قتادةَ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 16140,
          "end": 16147,
          "span_id": "s190"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 16158,
          "end": 16163,
          "span_id": "s190"
        }
      ]
    },
    {
      "id": "s191",
      "start": 16174,
      "end": 16242,
      "text": " {أَوِ التَّابِعِينَ}. قال: هو التابعُ يَتْبَعُك يُصِيبُ مِن طعامِك ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 16175,
          "end": 16195,
          "span_id": "s191"
        }
      ]
    },
    {
      "id": "s192",
      "start": 16267,
      "end": 16314,
      "text": ".حدَّثنا ابن بشارٍ، قال: ثنا عبدُ الرحمنِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 16268,
          "end": 16275,
          "span_id": "s192"
        }
      ]
    },
    {
      "id": "s193",
      "start": 16314,
      "end": 16390,
      "text": " ثنا إسماعيلُ ابن عُلَيَّةَ، عن ابن أبى نَجيحٍ، عن مجاهدٍ: {أَوِ التَّابِعِي",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 16343,
          "end": 16390,
          "stripped": "عن ابن أبى نجيح، عن مجاهد: {أو التابعي",
          "span_id": "s193"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 16365,
          "end": 16370,
          "span_id": "s193"
        }
      ]
    },
    {
      "id": "s194",
      "start": 16394,
      "end": 16440,
      "text": "نَ غَيْرِ أُولِي الْإِرْبَةِ مِنَ الرِّجَالِ}.",
      "markers": []
    },
    {
      "id": "s195",
      "start": 16440,
      "end": 16487,
      "text": " قال: الذي يُرِيدُ الطعامَ ولا يُرِيدُ النساءَ.",
      "markers": []
    },
    {
      "id": "s196",
      "start": 16487,
      "end": 16514,
      "text": "قال: ثنا عبدُ الرحمنِ، قال:",
      "markers": []
    },
    {
      "id": "s197",
      "start": 16514,
      "end": 16562,
      "text": " ثنا سفيانُ، عن ابن أبي نَجيحٍ، عن مجاهدٍ مثلَه ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 16527,
          "end": 16561,
          "stripped": "عن ابن أبي نجيح، عن مجاهد مثله",
          "span_id": "s197"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 16549,
          "end": 16554,
          "span_id": "s197"
        }
      ]
    },
    {
      "id": "s198",
      "start": 16582,
      "end": 16612,
      "text": ".حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s199",
      "start": 16612,
      "end": 16665,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، وحدَّثنى الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s200",
      "start": 16665,
      "end": 16739,
      "text": " ثنا الحسنُ، قال: ثنا وَرْقاءُ، جميعًا عن ابن أبي نَجيحٍ، عن مجاهدٍ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 16670,
          "end": 16675,
          "span_id": "s200"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 16704,
          "end": 16739,
          "stripped": "عن ابن أبي نجيح، عن مجاهد قوله:",
          "span_id": "s200"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 16726,
          "end": 16731,
          "span_id": "s200"
        }
      ]
    },
    {
      "id": "s201",
      "start": 16739,
      "end": 16803,
      "text": " {أَوِ التَّابِعِينَ غَيْرِ أُولِي الْإِرْبَةِ مِنَ الرِّجَالِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 16740,
          "end": 16802,
          "span_id": "s201"
        }
      ]
    },
    {
      "id": "s202",
      "start": 16803,
      "end": 16860,
      "text": " الذين لا يُهِمُّهم إلا بطونُهم، ولا يُخافون على النساءِ ",
      "markers": []
    },
    {
      "id": "s203",
      "start": 16938,
      "end": 16978,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 16939,
          "end": 16946,
          "span_id": "s203"
        }
      ]
    },
    {
      "id": "s204",
      "start": 16978,
      "end": 17022,
      "text": " ثنى حجّاجٌ، عن ابن جُريجٍ، عن مجاهدٍ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 16991,
          "end": 17022,
          "stripped": "عن ابن جريج، عن مجاهد مثله.",
          "span_id": "s204"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 16994,
          "end": 17003,
          "span_id": "s204"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 17009,
          "end": 17014,
          "span_id": "s204"
        }
      ]
    },
    {
      "id": "s205",
      "start": 17022,
      "end": 17061,
      "text": "حدَّثنا إسماعيلُ بنُ موسى السديُّ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 17022,
          "end": 17029,
          "span_id": "s205"
        },
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "SPEAKER",
          "start": 17048,
          "end": 17053,
          "span_id": "s205"
        }
      ]
    },
    {
      "id": "s206",
      "start": 17061,
      "end": 17104,
      "text": " ثنا شَريكٌ، عن منصورٍ، عن مجاهدٍ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 17074,
          "end": 17104,
          "stripped": "عن منصور، عن مجاهد في قوله:",
          "span_id": "s206"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 17088,
          "end": 17093,
          "span_id": "s206"
        }
      ]
    },
    {
      "id": "s207",
      "start": 17104,
      "end": 17150,
      "text": " {غَيْرِ أُولِي الْإِرْبَةِ}. قال: الأَبْلَهُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 17105,
          "end": 17132,
          "span_id": "s207"
        }
      ]
    },
    {
      "id": "s208",
      "start": 17230,
      "end": 17276,
      "text": ".حدَّثنا أبو كُريبٍ، قال: ثنا ابن إدريسَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 17231,
          "end": 17238,
          "span_id": "s208"
        }
      ]
    },
    {
      "id": "s209",
      "start": 17276,
      "end": 17311,
      "text": " سمِعْتُ ليثًا، عن مجاهدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 17295,
          "end": 17300,
          "span_id": "s209"
        }
      ]
    },
    {
      "id": "s210",
      "start": 17311,
      "end": 17394,
      "text": " {غَيْرِ أُولِي الْإِرْبَةِ}. قال: هو الأبْلَهُ الذي لا يَعْرِفُ شيئًا مِن النساءِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 17312,
          "end": 17339,
          "span_id": "s210"
        }
      ]
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s114",
      "start": 9543,
      "end": 9680,
      "text": "¬أخرجه الحاكم، 2/ 397، والبيهقى 2/ 234 من طريق زيد بن الحباب به، والبخارى (4759)، والنسائى في الكبرى (11363) من طريق إبراهيم بن نافع به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s117",
      "start": 9970,
      "end": 10041,
      "text": "¬في ف: \"أكتف\". وأكثف، ويروى أكنف: أسترها وأصفقها. النهاية 4/ 153، 206.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s118",
      "start": 10068,
      "end": 10271,
      "text": "¬أخرجه أبو داود (4102) من طريق ابن وهب، والطبرانى - كما في الفتح 8/ 489 - من طريق قرة به، وأخرجه البخارى (4758)، وابن المنذر وابن مردويه - كما في الفتح 8/ 489 - ، والبيهقى 7/ 8<br>8 من طريق ابن شهاب به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s120",
      "start": 10455,
      "end": 10504,
      "text": "¬الدُّملُج: المعضد من الحُلى. تاج العروس (دملج).¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s126",
      "start": 10940,
      "end": 11047,
      "text": "¬تفسير سفيان ص 225، ومن طريقه ابن أبي حاتم في تفسيره 8/ 2576 عن منصور، عن إبراهيم، ولم يذكرا طلحة بن مصرف.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s138",
      "start": 11732,
      "end": 11750,
      "text": "¬في م: \"يبدينها\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s139",
      "start": 11869,
      "end": 11901,
      "text": "¬جزء من الأثر المتقدم في ص 259.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s144",
      "start": 12069,
      "end": 12081,
      "text": "¬سقط من: م.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s149",
      "start": 12504,
      "end": 12560,
      "text": "¬في م: \"لأخواتهن\". وبعده في ص، م، ف: \"أو لبنى إخوانهن\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s154",
      "start": 12838,
      "end": 12876,
      "text": "¬في ت 1: \"عدوتها\"، وفى ت 2: \"عورتها\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s155",
      "start": 12949,
      "end": 12985,
      "text": "¬ذكره البغوي في تفسيره 6/ 35 بنحوه.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s156",
      "start": 13093,
      "end": 13171,
      "text": "¬قبلت القابلةُ المرأةَ إذا قبلت الولد، أي: تلقته عند الولادة. اللسان (ق ب ل).¥",
      "grading": []
    },
    {

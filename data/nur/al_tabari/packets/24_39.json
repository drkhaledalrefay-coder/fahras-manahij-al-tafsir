  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 244,
      "text": " {وَالَّذِينَ كَفَرُوا أَعْمَالُهُمْ كَسَرَابٍ بِقِيعَةٍ يَحْسَبُهُ الظَّمْآنُ مَاءً حَتَّى إِذَا جَاءَهُ لَمْ يَجِدْهُ شَيْئًا وَوَجَدَ اللَّهَ عِنْدَهُ فَوَفَّاهُ حِسَابَهُ وَاللَّهُ سَرِيعُ الْحِسَابِ (39)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 243,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 244,
      "end": 297,
      "text": "وهذا مَثَلٌ ضرَبه اللهُ لأعمالِ أهلِ الكفرِ به، فقال:",
      "markers": []
    },
    {
      "id": "s004",
      "start": 297,
      "end": 405,
      "text": " والذين جَحَدوا توحيدَ ربِّهم، وكذَّبوا بهذا القرآنِ وبمَن جاء به، مَثَلُ أعمالِهم التي عمِلوها {كَسَرَابٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 393,
          "end": 404,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 405,
      "end": 505,
      "text": " يقولُ: مِثْلُ سرابٍ.والسرابُ: ما لَصِقَ بالأرضِ، وذلك يكونُ نِصْفَ النهارِ، وحينَ يَشْتَدُّ الحرُّ.",
      "markers": []
    },
    {
      "id": "s006",
      "start": 505,
      "end": 603,
      "text": "والآلُ: ما كان كالماءِ بينَ السماءِ والأرضِ، وذلك يكونُ أَوّلَ النهارِ، يَرْفَعُ كُلَّ شيءٍ ضُحًى.",
      "markers": []
    },
    {
      "id": "s007",
      "start": 603,
      "end": 659,
      "text": "وقولُه: {بِقِيعَةٍ}. وهى جمع قاعٍ، كالجِيرَةِ جمعُ جارٍ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 611,
          "end": 622,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 659,
      "end": 699,
      "text": " والقاعُ: ما انْبَسَط من الأرضِ واتَّسع.",
      "markers": []
    },
    {
      "id": "s009",
      "start": 699,
      "end": 757,
      "text": " وفيه يكونُ السرابُ.وقولُه: {يَحْسَبُهُ الظَّمْآنُ مَاءً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 727,
          "end": 756,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 757,
      "end": 860,
      "text": " يقولُ: يَظُنُّ العَطْشَانُ مِن الناسِ السرابَ ماءً، {حَتَّى إِذَا جَاءَهُ} والهاءُ من ذكْرِ \"السرابِ\".",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 810,
          "end": 832,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 860,
      "end": 967,
      "text": " والمعنى: حتى إذا جاءَ الظمآنُ السرابَ، مُلْتَمِسًا ماءً يَسْتَغِيتُ به مِن عطشِه، {لَمْ يَجِدْهُ شَيْئًا}.",
      "markers": [
        {
          "family": "RAY",
          "marker": "والمعنى",
          "start": 861,
          "end": 868,
          "span_id": "s011"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 943,
          "end": 966,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 967,
      "end": 1028,
      "text": " يقولُ: لم يَجِدِ السرابَ شيئًا، فكذلك الكافرون باللهِ؛ مِن أ",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1032,
      "end": 1298,
      "text": "عمالِهم التي عمِلوها، في غُرُورٍ، يَحْسَبون أنها مُنَجِّيَتُهم عندَ اللهِ مِن عذابِه، كما حَسِب الظمآنُ الذي رَأى السرابِ، فظَنَّه ماءً يَرْوِيه مِن ظَمَئِه، حتى إذا هَلَك وصار إلى الحاجةِ إلى عملِه الذي كان يَرَى أنه نافِعُه عندَ اللهِ، لم يَجِدْهُ يَنْفَعُه شيئًا؛",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1298,
      "end": 1500,
      "text": " لأنه كان عَمِلَه على كفرٍ باللهِ، {وَوَجَدَ اللَّهَ} هذا الكافرُ، عندَ هلاكِه بالمِرْصَادِ، {فَوَفَّاهُ} يومَ القيامةِ حسابَ أعمالِه التي عمِلها في الدنيا، وجازاه بها جزاءَه الذي يَسْتَحِقُه عليها منه.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1333,
          "end": 1351,
          "span_id": "s014"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1391,
          "end": 1403,
          "span_id": "s014"
        }
      ]
    },
    {
      "id": "s015",
      "start": 1500,
      "end": 1526,
      "text": "فإن قال قائلٌ: وكيفَ قيلَ:",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1526,
      "end": 1572,
      "text": " {حَتَّى إِذَا جَاءَهُ لَمْ يَجِدْهُ شَيْئًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1527,
          "end": 1571,
          "span_id": "s016"
        }
      ]
    },
    {
      "id": "s017",
      "start": 1572,
      "end": 1635,
      "text": " فإن لم يَكُنِ السرابُ شيئًا، فعلامَ أُدْخِلَت الهاءُ في قولِه:",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1635,
      "end": 1784,
      "text": " {حَتَّى إِذَا جَاءَهُ}؟قيل: إنه شيءٌ يُرَى مِن بعيدٍ كالضَّبابِ الذي يُرَى كَثيفًا مِن بعيدٍ، والهَبَاءِ، فإذا قَرُب منه المرءُ رَقَّ وصار كالهواءِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1636,
          "end": 1658,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 1784,
      "end": 1814,
      "text": "وقد يَحْتَمِلُ أن يكونَ معناه:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 1808,
          "end": 1813,
          "span_id": "s019"
        }
      ]
    },
    {
      "id": "s020",
      "start": 1814,
      "end": 1865,
      "text": " حتى إذا جاء موضعَ السرابِ لم يَجِدِ السرابَ شيئًا.",
      "markers": []
    },
    {
      "id": "s021",
      "start": 1865,
      "end": 1904,
      "text": " فاكتفى بذكرِ \"السرابِ\" من ذكرِ موضعِه.",
      "markers": []
    },
    {
      "id": "s022",
      "start": 1904,
      "end": 1963,
      "text": "{وَاللَّهُ سَرِيعُ الْحِسَابِ}. يقولُ: واللهُ سريعٌ حسابُه؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1904,
          "end": 1934,
          "span_id": "s022"
        }
      ]
    },
    {
      "id": "s023",
      "start": 1963,
      "end": 2052,
      "text": " لأنه تعالى ذكرُه لا يَحتاجُ إلى عَقْدِ أصابعَ، ولا حفظٍ بقلبٍ، ولكنه عالمٌ بذلك كلِّه، ق",
      "markers": []
    },
    {
      "id": "s024",
      "start": 2056,
      "end": 2099,
      "text": "بلَ أن يَعْمَلَه العبدُ، ومن بعدِ ما عمِله.",
      "markers": []
    },
    {
      "id": "s025",
      "start": 2099,
      "end": 2146,
      "text": "وبنحوِ الذي قلنا في معنى ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s026",
      "start": 2146,
      "end": 2197,
      "text": "ذكرُ مَن قال ذلكحدَّثني عبدُ الأعلى بنُ واصلٍ، قال:",
      "markers": []
    },
    {
      "id": "s027",
      "start": 2197,
      "end": 2228,
      "text": " ثنا عبيدُ اللهِ بنُ موسى، قال:",
      "markers": []
    },
    {
      "id": "s028",
      "start": 2228,
      "end": 2316,
      "text": " أخبَرنا أبو جعفرٍ الرازيُّ، عن الربيعِ بن أنسٍ، عن أبي العاليةِ، عن أبيِّ بن كعبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2229,
          "end": 2236,
          "span_id": "s028"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",

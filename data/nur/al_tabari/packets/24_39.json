    },
    {
      "id": "s029",
      "start": 2316,
      "end": 2342,
      "text": " ثم ضرَب مثلًا آخرَ، فقال:",
      "markers": []
    },
    {
      "id": "s030",
      "start": 2342,
      "end": 2400,
      "text": " {وَالَّذِينَ كَفَرُوا أَعْمَالُهُمْ كَسَرَابٍ بِقِيعَةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2343,
          "end": 2399,
          "span_id": "s030"
        }
      ]
    },
    {
      "id": "s031",
      "start": 2400,
      "end": 2509,
      "text": " قال: وكذلك الكافرُ يَجِيءُ يومَ القيامةِ، وهو يَحْسَبُ أن له عند اللهِ خيرًا، فلا يَجِدُ، فيُدْخِلُه النارَ ",
      "markers": []
    },
    {
      "id": "s032",
      "start": 2598,
      "end": 2638,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2599,
          "end": 2606,
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 2638,
      "end": 2715,
      "text": " ثني حجاجٌ، عن أبي جعفرٍ الرازيِّ، عن أبي العاليةِ، عن أُبيِّ بن كعبٍ بنحوِه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2650,
          "end": 2697,
          "stripped": "عن أبي جعفر الرازي، عن أبي العالية، عن أبي",
          "span_id": "s033"
        },
        {
          "family": "SAHABA",
          "marker": "أبي بن كعب",
          "name": "أبي بن كعب",
          "role": "NARRATOR",
          "start": 2693,
          "end": 2706,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 2715,
      "end": 2755,
      "text": "حدَّثني عليٌّ، قال: ثنا عبدُ اللهِ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 2723,
          "end": 2726,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2755,
      "end": 2801,
      "text": " ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2769,
          "end": 2801,
          "stripped": "عن علي، عن ابن عباس في قوله:",
          "span_id": "s035"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 2772,
          "end": 2775,
          "span_id": "s035"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 2782,
          "end": 2790,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 2801,
      "end": 2863,
      "text": " {أَعْمَالُهُمْ كَسَرَابٍ بِقِيعَةٍ}. يقولُ: الأرضِ المستويةِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2802,
          "end": 2837,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 2930,
      "end": 2959,
      "text": ".حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s038",
      "start": 2959,
      "end": 2987,
      "text": " ثنى أبي، قال: ثنى عمي، قال:",
      "markers": []
    },
    {
      "id": "s039",
      "start": 2987,
      "end": 3028,
      "text": " ثنى أبي، عن أبيه، عن ابن عباسٍ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2997,
          "end": 3028,
          "stripped": "عن أبيه، عن ابن عباس في قوله:",
          "span_id": "s039"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 3009,
          "end": 3017,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3028,
      "end": 3076,
      "text": " {وَالَّذِينَ كَفَرُوا أَعْمَالُهُمْ كَسَرَابٍ ب",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3080,
      "end": 3132,
      "text": "ِقِيعَةٍ} إلى قولِه: {وَاللَّهُ سَرِيعُ الْحِسَابِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3101,
          "end": 3131,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 3132,
      "end": 3301,
      "text": " قال: هو مَثَلٌ ضرَبه اللهُ لرجلٍ عطِش فاشْتَدَّ عطشُه، فرأى سرابًا، فحسِبه ماءً، فطلَبه وظنَّ أنه قد قدَر عليه، حتى أتاه، فلمَّا أتاه لم يَجِدْه شيئًا، وقُبِض عندَ ذلك.",
      "markers": []
    },
    {
      "id": "s043",
      "start": 3301,
      "end": 3387,
      "text": " يقولُ: الكافرُ كذلك، يَحْسَبُ أن عملَه مُغْنٍ عنه، أو نافعُه شيئًا، ولا يكونُ آمِنًا ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3416,
      "end": 3558,
      "text": " على شيءٍ حتى يَأتِيَه الموتُ، فإذا أتاه الموتُ لم يَجِدْ عملَه أغْنَى عنه شيئًا، ولم يَنْفَعْه إلا كما نفَع العطشانَ المُشْتَدَّ إلى السرابِ ",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3621,
      "end": 3651,
      "text": ".حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s046",
      "start": 3651,
      "end": 3704,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، وحدَّثنى الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3704,
      "end": 3787,
      "text": " ثنا الحسنُ، قال: ثنا وَرْقَاءُ، جميعًا عن ابن أبي نَجيحٍ، عن مجاهدٍ في قولِ اللهِ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 3709,
          "end": 3714,
          "span_id": "s047"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3744,
          "end": 3787,
          "stripped": "عن ابن أبي نجيح، عن مجاهد في قول الله:",
          "span_id": "s047"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 3766,
          "end": 3771,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3787,
      "end": 3850,
      "text": " {كَسَرَابٍ بِقِيعَةٍ}. قال: بقاعٍ مِن الأرضِ، والسرابُ عمَلُه.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3788,
          "end": 3809,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3850,
      "end": 3883,
      "text": " زاد الحارثُ في حديثِه عن الحسنِ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 3876,
          "end": 3881,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 3883,
      "end": 3959,
      "text": " والسرابُ عملُ الكافرِ، {إِذَا جَاءَهُ لَمْ يَجِدْهُ شَيْئًا}، إتيانُه إياه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3907,
          "end": 3944,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3959,
      "end": 4044,
      "text": " موتُه وفراقُه الدنيا. {وَوَجَدَ اللَّهَ} عندَ فراقِه الدنيا، {فَوَفَّاهُ حِسَابَهُ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3982,
          "end": 4000,
          "span_id": "s051"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4021,
          "end": 4043,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4195,
      "end": 4268,
      "text": ".حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، عن معمرٍ، عن قتادةَ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4196,
          "end": 4203,
          "span_id": "s052"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 4196,
          "end": 4241,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، عن",
          "span_id": "s052"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "NARRATOR",
          "start": 4204,
          "end": 4209,
          "span_id": "s052"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4217,
          "end": 4224,
          "span_id": "s052"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4239,
          "end": 4268,
          "stripped": "عن معمر، عن قتادة في قوله:",
          "span_id": "s052"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 4252,
          "end": 4257,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 4268,
      "end": 4348,
      "text": " {كَسَرَابٍ بِقِيعَةٍ}. قال: بِقِيعةٍ مِن الأرضِ، {يَحْسَبُهُ الظَّمْآنُ مَاءً}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4269,
          "end": 4290,
          "span_id": "s053"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4318,
          "end": 4347,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4348,
      "end": 4390,
      "text": " هو مثلٌ ضرَبه اللهُ لعملِ الكافرِ، يقولُ:",
      "markers": []
    },
    {
      "id": "s055",
      "start": 4390,
      "end": 4489,
      "text": " يَحْسَبُ أنه في شيءٍ، كما يَحْسَبُ هذا السرابَ ماءً، {حَتَّى إِذَا جَاءَهُ لَمْ يَجِدْهُ شَيْئًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4444,
          "end": 4488,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4489,
      "end": 4584,
      "text": " وكذلك الكافرُ إذا مات لم يَجِدْ عملَه شيئًا، {وَوَجَدَ اللَّهَ عِنْدَهُ فَوَفَّاهُ حِسَابَهُ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4535,
          "end": 4583,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4662,
      "end": 4706,
      "text": ".حدَّثني يونُسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4684,
          "end": 4691,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4706,
      "end": 4730,
      "text": " قال ابن زِيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 4711,
          "end": 4719,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4730,
      "end": 4793,
      "text": " {وَالَّذِينَ كَفَرُوا} إلى قولِه: {وَوَجَدَ اللَّهَ عِنْدَهُ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4731,
          "end": 4753,
          "span_id": "s059"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4765,
          "end": 4792,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4793,
      "end": 4870,
      "text": " قال: هذا مثلٌ ضرَبه اللهُ للذين كَفروا، {أَعْمَالُهُمْ كَسَرَابٍ بِقِيعَةٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4834,
          "end": 4869,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4870,
      "end": 4938,
      "text": " قد رأى السرابَ، ووثِق بنفسِه أنه ماءٌ، فلما جاءَه لم يَجِدْه شيئًا.",
      "markers": []
    },
    {
      "id": "s062",
      "start": 4938,
      "end": 5110,
      "text": " قال: وهؤلاء ظنُّوا أن أعمالَهم صالحةٌ، وأنهم سيَرْجِعون منها إلى خيرٍ، فلم يَرْجِعوا منها إلا كما رجَع صاحبُ السرابِ، فهذا مثلٌ ضرَبه اللهُ جلَّ ثناؤُه وتقَدَّستْ أسماؤُه ",
      "markers": []
    },
    {
      "id": "s063",
      "start": 5178,
      "end": 5180,
      "text": ". ",
      "markers": []
    }
  ],

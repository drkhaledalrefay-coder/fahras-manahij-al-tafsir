  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 699,
      "text": " {لَيْسَ عَلَى الْأَعْمَى حَرَجٌ وَلَا عَلَى الْأَعْرَجِ حَرَجٌ وَلَا عَلَى الْمَرِيضِ حَرَجٌ وَلَا عَلَى أَنْفُسِكُمْ أَنْ تَأْكُلُوا مِنْ بُيُوتِكُمْ أَوْ بُيُوتِ آبَائِكُمْ أَوْ بُيُوتِ أُمَّهَاتِكُمْ أَوْ بُيُوتِ إِخْوَانِكُمْ أَوْ بُيُوتِ أَخَوَاتِكُمْ أَوْ بُيُوتِ أَعْمَامِكُمْ أَوْ بُيُوتِ عَمَّاتِكُمْ أَوْ بُيُوتِ أَخْوَالِكُمْ أَوْ بُيُوتِ خَالَاتِكُمْ أَوْ مَا مَلَكْتُمْ مَفَاتِحَهُ أَوْ صَدِيقِكُمْ لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَأْكُلُوا جَمِيعًا أَوْ أَشْتَاتًا فَإِذَا دَخَلْتُمْ بُيُوتًا فَسَلِّمُوا عَلَى أَنْفُسِكُمْ تَحِيَّةً مِنْ عِنْدِ اللَّهِ مُبَارَكَةً طَيِّبَةً كَذَلِكَ يُبَيِّنُ اللَّهُ لَكُمُ الْآيَاتِ لَعَلَّكُمْ تَعْقِلُونَ (61)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 698,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 699,
      "end": 745,
      "text": "قال أبو جعفرٍ: اختَلف أهلُ التأويلِ في تأويلِ ",
      "markers": []
    },
    {
      "id": "s004",
      "start": 765,
      "end": 804,
      "text": " هذه الآيةِ وفي المعنى الذي أُنزلت فيه؛",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "نزلت في",
          "start": 795,
          "end": 802,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 804,
      "end": 1000,
      "text": " فقال بعضُهم: أُنزلت هذه الآيةُ تَرْخِيصًا للمسلمين في الأكْلِ مع العُمْيانِ والعُرْجانِ والمَرْضَى وأهلِ الزَّمانةِ مِن طعامِهم، مِن أجلِ أنهم كانوا قد امتَنَعوا مِن أن يأكُلُوا معهم مِن طعامِهم؛",
      "markers": []
    },
    {
      "id": "s006",
      "start": 1000,
      "end": 1028,
      "text": " خشيةَ أن يكونوا قد أَتَوا ب",
      "markers": []
    },
    {
      "id": "s007",
      "start": 1032,
      "end": 1060,
      "text": "أكْلِهم معهم مِن طعامِهم ما ",
      "markers": []
    },
    {
      "id": "s008",
      "start": 1079,
      "end": 1244,
      "text": " نَهاهم اللَّهُ عنه بقولِه: {يَاأَيُّهَا الَّذِينَ آمَنُوا لَا تَأْكُلُوا أَمْوَالَكُمْ بَيْنَكُمْ بِالْبَاطِلِ إِلَّا أَنْ تَكُونَ تِجَارَةً عَنْ تَرَاضٍ مِنْكُمْ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1107,
          "end": 1243,
          "span_id": "s008"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 1244,
          "end": 1256,
          "text": "[النساء: 29]",
          "via": "apparatus",
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 1256,
      "end": 1292,
      "text": ".ذكرُ مَن قال ذلكحدَّثني عليٌّ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 1281,
          "end": 1284,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 1292,
      "end": 1352,
      "text": " ثنى عبدُ اللَّهِ، قال: ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1329,
          "end": 1352,
          "stripped": "عن علي، عن ابن عباس:",
          "span_id": "s010"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 1332,
          "end": 1335,
          "span_id": "s010"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 1342,
          "end": 1350,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 1352,
      "end": 1405,
      "text": " {لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَأْكُلُوا جَمِيعًا ",
      "markers": []
    },
    {
      "id": "s012",
      "start": 1442,
      "end": 1487,
      "text": " أَوْ أَشْتَاتًا}: وذلك لَمَّا أنزَل اللَّهُ:",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1487,
      "end": 1573,
      "text": " {يَاأَيُّهَا الَّذِينَ آمَنُوا لَا تَأْكُلُوا أَمْوَالَكُمْ بَيْنَكُمْ بِالْبَاطِلِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1488,
          "end": 1572,
          "span_id": "s013"
        }
      ]
    },
    {
      "id": "s014",
      "start": 1573,
      "end": 1658,
      "text": " فقال المسلمون: إن اللَّهَ قد نَهانا أن نأكُلَ أموالَنا بينَنا بالباطلِ، والطعامُ هو ",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1670,
      "end": 1759,
      "text": " من أفضلِ الأموالِ، فلا يَحِلُّ لأحدٍ مِنَّا أن يأكُلَ عندَ أحدٍ. فَكَفَّ الناسُ عن ذلك، ",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1775,
      "end": 1776,
      "text": " ",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1789,
      "end": 1878,
      "text": " بعدَ ذلك: {لَيْسَ عَلَى الْأَعْمَى حَرَجٌ} إلى قولِه: {أَوْ مَا مَلَكْتُمْ مَفَاتِحَهُ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1800,
          "end": 1832,
          "span_id": "s017"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1844,
          "end": 1877,
          "span_id": "s017"
        }
      ]
    },
    {
      "id": "s018",
      "start": 2045,
      "end": 2052,
      "text": ".حُدِّث",
      "markers": []
    },
    {
      "id": "s019",
      "start": 2056,
      "end": 2099,
      "text": "ْتُ عن الحسينِ، قال: سمعتُ أبا معاذٍ يقولُ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 2087,
          "end": 2091,
          "span_id": "s019"
        }
      ]
    },
    {
      "id": "s020",
      "start": 2099,
      "end": 2150,
      "text": " أخبَرنا عبيدٌ، قال: سمِعتُ الضحاكَ يقولُ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2100,
          "end": 2107,
          "span_id": "s020"
        },
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 2127,
          "end": 2133,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 2150,
      "end": 2190,
      "text": " {لَيْسَ عَلَى الْأَعْمَى حَرَجٌ} الآية:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2151,
          "end": 2183,
          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 2190,
      "end": 2310,
      "text": " كان أهلُ المدينةِ قبلَ أن يُبْعَثَ النبيُّ - صلى الله عليه وسلم - لا يُخالِطُهم في طعامِهم أعمى ولا مريضٌ، فقال بعضُهم:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2236,
          "end": 2254,
          "span_id": "s022"
        }
      ]
    },
    {
      "id": "s023",
      "start": 2310,
      "end": 2371,
      "text": " إنما كان بهم التَّقَذُّرُ والتَّقَزُّزُ. وقال بعضُهم: قالوا ",
      "markers": []
    },
    {
      "id": "s024",
      "start": 2391,
      "end": 2569,
      "text": ": المريضُ لا يَسْتَوْفِي الطعامَ كما يَسْتَوْفِي الصحيحُ، والأعرجُ المُنْحَبِسُ لا يستطيعُ المُزاحمةَ على الطعامِ، والأعمى لا يُبْصِرُ طَيِّبَ الطعامِ. فأنزَل اللَّهُ: ليس عليكم ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "في الصحيح",
          "start": 2436,
          "end": 2446,
          "span_id": "s024"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 2543,
          "end": 2549,
          "span_id": "s024"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 2543,
          "end": 2556,
          "span_id": "s024"
        }
      ]
    },
    {
      "id": "s025",
      "start": 2595,
      "end": 2640,
      "text": " حرَجٌ في مُؤاكَلةِ المريضِ والأعمى والأعرجِ ",
      "markers": []
    },
    {
      "id": "s026",
      "start": 2699,
      "end": 2732,
      "text": ".فمعنى الكلامِ على تأويلِ هؤلاءِ:",
      "markers": []
    },
    {
      "id": "s027",
      "start": 2732,
      "end": 2816,
      "text": " ليس عليكم أيُّها الناسُ في الأعمى حَرَجٌ أن تأكُلوا منه ومعه، ولا في الأعرجِ حَرجٌ ",
      "markers": []
    },
    {
      "id": "s028",
      "start": 2830,
      "end": 2893,
      "text": "، ولا في المريضِ حَرَجٌ، ولا في أنفسِكم، أن تأكُلوا من بيوتِكم.",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2893,
      "end": 2945,
      "text": " فَوَجَّهوا معنى \"على\" في هذا الموضعِ إلى معنى \"في\".",
      "markers": []
    },
    {
      "id": "s030",
      "start": 2945,
      "end": 3077,
      "text": "وقال آخرون: بل نزلَت هذه الآيةُ تَرْخِيصًا لأهلِ الزَّمانةِ، في الأكلِ من بُيُوتِ مَن سَمَّى اللَّهُ في هذه الآيةِ؛ لأن قومًا كانوا ",
      "markers": []
    },
    {
      "id": "s031",
      "start": 3081,
      "end": 3292,
      "text": "من أصحابِ رسولِ اللَّهِ - صلى الله عليه وسلم -، إذا لم يَكُنْ عندَهم في بيوتِهم ما يُطْعِمونهم، ذهَبوا بهم إلى بيوتِ آبائِهم وأمهاتِهم، أو بعضِ مَن سَمَّى اللَّهُ في هذه الآيةِ، فكان أهلُ الزَّمانةِ يتحوَّبُونَ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3107,
          "end": 3125,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 3310,
      "end": 3366,
      "text": " من أن يَطْعَموا ذلك الطعامَ؛ لأنه أطعمَهم غيرُ مالِكِه ",
      "markers": []
    },
    {
      "id": "s033",
      "start": 3398,
      "end": 3444,
      "text": ".ذكرُ مَن قال ذلكحدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s034",
      "start": 3444,
      "end": 3497,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، وحدَّثني الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s035",
      "start": 3497,
      "end": 3562,
      "text": " ثنا الحسنُ، قال: ثنا ورقاءُ، جميعًا عن ابن أبي نجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 3502,
          "end": 3507,
          "span_id": "s035"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3534,
          "end": 3562,
          "stripped": "عن ابن أبي نجيح، عن مجاهد:",
          "span_id": "s035"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3555,
          "end": 3560,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 3562,
      "end": 3638,
      "text": " لا جُناحَ عليكم {أَنْ تَأْكُلُوا مِنْ بُيُوتِكُمْ أَوْ بُيُوتِ آبَائِكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3579,
          "end": 3637,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 3638,
      "end": 3687,
      "text": " قال: كان رجالٌ زَمْنَى. قال ابن عمرٍو في حديثِه:",
      "markers": []
    },
    {
      "id": "s038",
      "start": 3687,
      "end": 3763,
      "text": " عُمْيانٌ وعُرْجانٌ. وقال الحارثُ: عُمْىٌ عُرْجٌ أولو حاجةٍ. يَسْتَتْبِعُهم ",
      "markers": []
    },
    {
      "id": "s039",
      "start": 3806,
      "end": 3878,
      "text": " رجالٌ إلى بيوتِهم، فإن لم يَجِدوا طعامًا ذَهَبوا بهم إلى بيوتِ آبائِهم ",
      "markers": []
    },
    {
      "id": "s040",
      "start": 3892,
      "end": 3916,
      "text": "، ومَن عَدَّدَ منهم مِن ",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3931,
      "end": 3969,
      "text": " البيوتِ، فكَرِةَ ذلك المُسْتَتْبَعون ",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3990,
      "end": 4015,
      "text": "، فأَنزَل اللَّهُ في ذلك:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 3992,
          "end": 3999,
          "span_id": "s042"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 3992,
          "end": 4006,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 4015,
      "end": 4078,
      "text": " {لَيْسَ عَلَيْكُمْ جُنَاحٌ}. وأحَلَّ لهم الطعامَ حيثُ وَجَدوه ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4016,
          "end": 4043,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 4239,
      "end": 4326,
      "text": ".حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، عن معمرٍ، عن ابن أبي نجيحٍ، عن مجاهدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4240,
          "end": 4247,
          "span_id": "s044"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 4240,
          "end": 4285,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، عن",
          "span_id": "s044"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "NARRATOR",
          "start": 4248,
          "end": 4253,
          "span_id": "s044"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4261,
          "end": 4268,
          "span_id": "s044"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4283,
          "end": 4313,
          "stripped": "عن معمر، عن ابن أبي نجيح، عن",
          "span_id": "s044"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 4314,
          "end": 4319,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 4326,
      "end": 4366,
      "text": " كان الرجلُ يذهَبُ بالأعْمَى والمريضِ و ",
      "markers": []
    },
    {
      "id": "s046",
      "start": 4386,
      "end": 4439,
      "text": " الأعْرجِ إلى بيتِ أبيه، أو إلى بيتِ أخيه، أو عمِّه، ",
      "markers": []
    },
    {
      "id": "s047",
      "start": 4449,
      "end": 4450,
      "text": " ",
      "markers": []
    },
    {
      "id": "s048",
      "start": 4464,
      "end": 4520,
      "text": "، أو خالتِه، فكان الزَّمْنَى يتَحرَّجون مِن ذلك، يقولون:",
      "markers": []
    },
    {
      "id": "s049",
      "start": 4520,
      "end": 4555,
      "text": " إنما يذهَبون بنا إلى بيوتِ غيرِهم.",
      "markers": []
    },
    {
      "id": "s050",
      "start": 4555,
      "end": 4586,
      "text": " فنزلَت هذه الآيةُ رُخْصةً لهم ",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 4556,
          "end": 4562,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 4653,
      "end": 4693,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4654,
          "end": 4661,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4693,
      "end": 4764,
      "text": " ثنى حجاجٌ، عن ابن جريجٍ، عن مجاهدٍ نحوَ حديثِ ابن عمرٍو، عن أبي عاصمٍ.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4705,
          "end": 4743,
          "stripped": "عن ابن جريج، عن مجاهد نحو حديث ابن",
          "span_id": "s052"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 4708,
          "end": 4716,
          "span_id": "s052"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 4722,
          "end": 4727,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 4764,
      "end": 4906,
      "text": "وقال آخرون: بل نزلَت تَرْخِيصًا لأهلِ الزَّمانةِ الذين وصَفهم اللَّهُ في هذه الآيةِ، أن يأكُلوا مِن بيوتِ مَن خَلَّفهم في بيوتِه مِن الغُزاةِ.",
      "markers": []
    },
    {
      "id": "s054",
      "start": 4906,
      "end": 4951,
      "text": "ذكرُ مَن قال ذلكحدَّثنا الحسنُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4922,
          "end": 4929,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4951,
      "end": 4991,
      "text": " أخبَرنا عبدُ الرزاقِ، عن مَعْمَرٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4952,
          "end": 4959,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4991,
      "end": 5049,
      "text": " قلتُ للزهريِّ في قولِه: {لَيْسَ عَلَى الْأَعْمَى حَرَجٌ}:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 4992,
          "end": 4995,
          "span_id": "s056"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5016,
          "end": 5048,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 5049,
      "end": 5116,
      "text": " ما بالُ الأعمى ذُكِر ههنا، والأعرجِ والمريضِ؟ فقال: أخبَرني عبيدُ ",
      "markers": []
    },
    {
      "id": "s058",
      "start": 5136,
      "end": 5251,
      "text": " اللَّهِ بنُ عبدِ اللَّهِ أَن المسلمين كانوا إذا غَزَوا خَلَّفوا زَمْناهم، وكانوا يَدْفَعون إليهم مفاتيحَ أبوابِهم ",
      "markers": []
    },
    {
      "id": "s059",
      "start": 5270,
      "end": 5323,
      "text": "، يقولون: قد أحْلَلْنا لكم أن تأكُلوا مما في بيوتِنا.",
      "markers": []
    },
    {
      "id": "s060",
      "start": 5323,
      "end": 5360,
      "text": " وكانوا يَتَحَرَّجون مِن ذلك، يقولون:",
      "markers": []
    },
    {
      "id": "s061",
      "start": 5360,
      "end": 5419,
      "text": " لا ندخُلُها وهم غَيَبٌ. فأُنزِلَت هذه الآيةُ رُخْصَةً لهم ",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 5385,
          "end": 5392,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 5573,
      "end": 5602,
      "text": ".وقال آخرون: بل عُنِى بقولِه:",
      "markers": []
    },
    {
      "id": "s063",
      "start": 5602,
      "end": 5697,
      "text": " {لَيْسَ عَلَى الْأَعْمَى حَرَجٌ وَلَا عَلَى الْأَعْرَجِ حَرَجٌ وَلَا عَلَى الْمَرِيضِ حَرَجٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5603,
          "end": 5696,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 5697,
      "end": 5742,
      "text": " في التَّخَلُّفِ عن الجهادِ في سبيلِ اللَّهِ.",
      "markers": []
    },
    {
      "id": "s065",
      "start": 5742,
      "end": 5818,
      "text": " قالوا: وقولُه: {وَلَا عَلَى أَنْفُسِكُمْ أَنْ تَأْكُلُوا مِنْ بُيُوتِكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5758,
          "end": 5817,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 5818,
      "end": 5879,
      "text": " كلامٌ مُنقطِعٌ عما قبلَه.ذكرُ مَن قال ذلكحدَّثني يونسُ، قال:",
      "markers": []
    },
    {
      "id": "s067",
      "start": 5879,
      "end": 5925,
      "text": " أخبَرنا ابن وهبٍ، قال: قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 5880,
          "end": 5887,
          "span_id": "s067"
        },
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 5907,
          "end": 5914,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 5925,
      "end": 6020,
      "text": " {لَيْسَ عَلَى الْأَعْمَى حَرَجٌ وَلَا عَلَى الْأَعْرَجِ حَرَجٌ وَلَا عَلَى الْمَرِيضِ حَرَجٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5926,
          "end": 6019,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 6020,
      "end": 6058,
      "text": " قال: هذا في الجهادِ في سبيلِ اللَّهِ.",
      "markers": []
    },
    {
      "id": "s070",
      "start": 6058,
      "end": 6149,
      "text": " وفى قولِه: {وَلَا عَلَى أَنْفُسِكُمْ أَنْ تَأْكُلُوا مِنْ بُيُوتِكُمْ} إلى قولِه: {أَوْ صَ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6070,
          "end": 6129,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 6153,
      "end": 6213,
      "text": "دِيقِكُمْ}. قال: هذا شيءٌ قد انقطَع، إنما كان هذا في أوَّلَ ",
      "markers": []
    },
    {
      "id": "s072",
      "start": 6228,
      "end": 6285,
      "text": "، لم يَكُنْ لهم أبوابٌ، وكانت السُّتُورُ مُرْخاةً، فربما ",
      "markers": []
    },
    {
      "id": "s073",
      "start": 6317,
      "end": 6413,
      "text": " دخَل الرجلُ البيتَ وليس فيه أحدٌ، فربَّما وجَد الطعامَ وهو جائعٌ، فَسَوَّغه اللَّهُ أن يأكُلَه.",
      "markers": []
    },
    {
      "id": "s074",
      "start": 6413,
      "end": 6439,
      "text": " قال: وقد ذهَب ذلك اليومُ؛",
      "markers": []
    },
    {
      "id": "s075",
      "start": 6439,
      "end": 6505,
      "text": " البيوتُ اليومَ فيها أهلُها، وإذا خَرَجوا أغْلَقوها، فقد ذهَب ذلك ",
      "markers": []
    },
    {
      "id": "s076",
      "start": 6609,
      "end": 6738,
      "text": ".وقال آخرون: بل نزَلت هذه الآيةُ تَرْخيصًا للمسلمين الذين كانوا يَتَّقون مُؤاكَلةَ أهلِ الزَّمانةِ في مُؤاكَلتِهم إذا شاءُوا ذلك.",
      "markers": []
    },
    {
      "id": "s077",
      "start": 6738,
      "end": 6777,
      "text": "ذكرُ مَن قال ذلكحدَّثنا ابن بشارٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6754,
          "end": 6761,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 6777,
      "end": 6852,
      "text": " ثنا عبدُ الرحمنِ، قال: ثنا سفيانُ، عن قيسِ بن مسلمٍ، عن مِقْسَمٍ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6813,
          "end": 6852,
          "stripped": "عن قيس بن مسلم، عن مقسم في قوله:",
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 6852,
      "end": 6891,
      "text": " {لَيْسَ عَلَى الْأَعْمَى حَرَجٌ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6853,
          "end": 6885,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 6891,
      "end": 6946,
      "text": " كانوا يَتَّقُون أن يأكُلوا مع الأعمى والأعرجِ، فنزَلت:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 6939,
          "end": 6945,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 6946,
      "end": 7016,
      "text": " {لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَأْكُلُوا جَمِيعًا أَوْ أَشْتَاتًا} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6947,
          "end": 7015,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 7143,
      "end": 7173,
      "text": ".واختَلفوا أيضًا في معنى قولِه",
      "markers": []
    },
    {
      "id": "s083",
      "start": 7177,
      "end": 7213,
      "text": ": {أَوْ مَا مَلَكْتُمْ مَفَاتِحَهُ}؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7179,
          "end": 7212,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 7213,
      "end": 7300,
      "text": " فقال بعضُهم: عَنَى بذلك وكيلَ الرجلِ وقَيِّمَه، أنه لا بأسَ عليه أن يأكُلَ مِن ثَمَرِ ",
      "markers": []
    },
    {
      "id": "s085",
      "start": 7332,
      "end": 7388,
      "text": " ضَيْعَتِه ونحوِ ذلك.ذكرُ مَن قال ذلكحدَّثني عليٌّ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 7377,
          "end": 7380,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 7388,
      "end": 7454,
      "text": " ثنا أبو صالحٍ، قال: ثنا معاويةُ، عن عليٍّ، عن ابن عباسٍ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7422,
          "end": 7454,
          "stripped": "عن علي، عن ابن عباس في قوله:",
          "span_id": "s086"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 7425,
          "end": 7428,
          "span_id": "s086"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 7435,
          "end": 7443,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 7454,
      "end": 7581,
      "text": " {أَوْ مَا مَلَكْتُمْ مَفَاتِحَهُ}: وهو الرجلُ يُوَكِّلُ الرجلَ بضَيْعتِه، فرخَّص اللَّهُ له أن يأكُلَ مِن ذلك الطعامِ والتمرِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7455,
          "end": 7488,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 7599,
      "end": 7614,
      "text": " ويشربَ اللبنَ ",
      "markers": []
    },
    {
      "id": "s089",
      "start": 7635,
      "end": 7712,
      "text": ".وقال آخرون: بل عُنِى بذلك منزلُ الرجلِ نفسه، أنه لا بأسَ عليه أن يأكُلَ منه ",
      "markers": []
    },
    {
      "id": "s090",
      "start": 7724,
      "end": 7767,
      "text": ".ذكرُ مَن قال ذلكحُدِّثْتُ عن الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s091",
      "start": 7767,
      "end": 7813,
      "text": " سمِعتُ أبا معاذٍ يقولُ: أخبَرنا عُبَيدٌ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 7779,
          "end": 7783,
          "span_id": "s091"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 7792,
          "end": 7799,
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 7813,
      "end": 7844,
      "text": " سمِعتُ الضحاكَ يقولُ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 7821,
          "end": 7827,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 7844,
      "end": 7885,
      "text": " {أَوْ مَا مَلَكْتُمْ مَفَاتِحَهُ}. يعني:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7845,
          "end": 7878,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 7885,
      "end": 7941,
      "text": " بيتَ أحدِهم، فإنه يَمْلِكُه، والعبيدُ منهم مما مَلَكوا ",
      "markers": []
    },
    {
      "id": "s095",
      "start": 8049,
      "end": 8122,
      "text": ".حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، عن معمرٍ، عن قتادةَ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8050,
          "end": 8057,
          "span_id": "s095"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 8050,
          "end": 8095,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، عن",
          "span_id": "s095"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "NARRATOR",
          "start": 8058,
          "end": 8063,
          "span_id": "s095"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 8071,
          "end": 8078,
          "span_id": "s095"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 8093,
          "end": 8122,
          "stripped": "عن معمر، عن قتادة في قوله:",
          "span_id": "s095"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 8106,
          "end": 8111,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 8122,
      "end": 8173,
      "text": " {أَوْ مَا مَلَكْتُمْ مَفَاتِحَهُ}: مما تَخْتَرِنُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8123,
          "end": 8156,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 8229,
      "end": 8242,
      "text": " يا بنَ آدمَ ",
      "markers": []
    },
    {
      "id": "s098",
      "start": 8329,
      "end": 8369,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 8330,
          "end": 8337,
          "span_id": "s098"
        }
      ]
    },
    {
      "id": "s099",
      "start": 8369,
      "end": 8410,
      "text": " ثنى حجاجٌ، عن ابن جريجٍ، عن مجاهدٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 8381,
          "end": 8410,
          "stripped": "عن ابن جريج، عن مجاهد، قال:",
          "span_id": "s099"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 8384,
          "end": 8392,
          "span_id": "s099"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 8398,
          "end": 8403,
          "span_id": "s099"
        }
      ]
    },
    {
      "id": "s100",
      "start": 8410,
      "end": 8481,
      "text": " {أَوْ مَا مَلَكْتُمْ مَفَاتِحَهُ}. قال: خزائنَ لأنفسِهم، ليست لغيرِهم ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8411,
          "end": 8444,
          "span_id": "s100"
        }
      ]
    },
    {
      "id": "s101",
      "start": 8517,
      "end": 8562,
      "text": ".وأشبهُ الأقوالِ التي ذكَرنا في تأويلِ قولِه:",
      "markers": []
    },
    {
      "id": "s102",
      "start": 8562,
      "end": 8606,
      "text": " {لَيْسَ عَلَى الْأَعْمَى حَرَجٌ} إلى قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8563,
          "end": 8595,
          "span_id": "s102"
        }
      ]
    },
    {
      "id": "s103",
      "start": 8606,
      "end": 8719,
      "text": " {أَوْ صَدِيقِكُمْ} القولُ الذي ذكَرنا عن الزهريِّ، عن عُبيدِ اللَّهِ بن عبدِ اللَّهِ، وذلك أن أظهرِ معاني قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8607,
          "end": 8625,
          "span_id": "s103"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 8645,
          "end": 8682,
          "stripped": "عن الزهري، عن عبيد الله بن عبد",
          "span_id": "s103"
        }
      ]
    },
    {
      "id": "s104",
      "start": 8719,
      "end": 8784,
      "text": " {لَيْسَ عَلَى الْأَعْمَى حَرَجٌ وَلَا عَلَى الْأَعْرَجِ حَرَجٌ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8720,
          "end": 8783,
          "span_id": "s104"
        }
      ]
    },
    {
      "id": "s105",
      "start": 8784,
      "end": 8915,
      "text": " أنه لا حَرَجَ على هؤلاء الذين سُمُّوا في هذه الآيةِ أن يأكُلوا مِن بيوتِ مَن ذكَره اللَّهُ فيها، على ما أباحَ لهم مِن الأكلِ منها.",
      "markers": []
    },
    {
      "id": "s106",
      "start": 8915,
      "end": 9016,
      "text": " فإذ كان ذلك أظهرَ مَعانِيه، فتَوْجِيهُ معناه إلى الأغلبِ الأعرفِ مِن مَعانيه أولَى من تَوْجيهِه إلى ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 8955,
          "end": 8960,
          "span_id": "s106"
        }
      ]
    },
    {
      "id": "s107",
      "start": 9030,
      "end": 9079,
      "text": " الأَنْكَرِ منها. فإذ كان ذلك كذلك، كان ما خالَف ",
      "markers": []
    },
    {
      "id": "s108",
      "start": 9097,
      "end": 9124,
      "text": " مِن التأويلِ قولَ مَن قال:",
      "markers": []
    },
    {
      "id": "s109",
      "start": 9124,
      "end": 9178,
      "text": " معناه: ليس في الأعمى والأعرجِ حَرَجٌ - أولى بالصوابِ.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 9125,
          "end": 9130,
          "span_id": "s109"
        }
      ]
    },
    {
      "id": "s110",
      "start": 9178,
      "end": 9221,
      "text": "وكذلك أيضًا الأغلبُ مِن تأويلِ قولِه: {وَلَ",
      "markers": []
    }
  ],

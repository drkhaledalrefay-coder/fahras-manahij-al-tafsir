    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 279,
      "text": " {أَوْ كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ يَغْشَاهُ مَوْجٌ مِنْ فَوْقِهِ مَوْجٌ مِنْ فَوْقِهِ سَحَابٌ ظُلُمَاتٌ بَعْضُهَا فَوْقَ بَعْضٍ إِذَا أَخْرَجَ يَدَهُ لَمْ يَكَدْ يَرَاهَا وَمَنْ لَمْ يَجْعَلِ اللَّهُ لَهُ نُورًا فَمَا لَهُ مِنْ نُورٍ (40)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 278,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 279,
      "end": 344,
      "text": "وهذا مَثَلٌ آخرُ ضرَبَه اللهُ لأعمالِ الكفارِ، يقولُ تعالى ذكرُه:",
      "markers": []
    },
    {
      "id": "s004",
      "start": 344,
      "end": 494,
      "text": " ومَثَلُ أعمالِ هؤلاء الكفارِ، في أنها عُمِلَت على خَطَأٍ وفسادٍ، وضلالةٍ وحيرةٍ مِن عُمَّالِها فيها، وعلى غير هُدًى - مثَلُ ظُلماتٍ في بحرٍ لُجِّيٍّ.",
      "markers": []
    },
    {
      "id": "s005",
      "start": 494,
      "end": 605,
      "text": " ونُسِب البحرُ إلى اللُّجَّةِ، وصفًا له بأنه عميقٌ كثيرُ الماءِ، ولُجَّةُ البحرِ مُعْظَمُه، {يَغْشَاهُ مَوْجٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 586,
          "end": 604,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 605,
      "end": 657,
      "text": " يقولُ: يَغْشَى البحرَ موجٌ. {مِنْ فَوْقِهِ مَوْجٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 634,
          "end": 656,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 657,
      "end": 724,
      "text": " يقولُ: مِن فوقِ الموجِ موجٌ آخرُ يَغْشاه، {مِنْ فَوْقِهِ سَحَابٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 700,
          "end": 723,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 724,
      "end": 793,
      "text": " يقولُ: مِن فوقِ الموجِ الثاني الذي يَغْشَى الموجَ الأَوَّلَ، سَحابٌ.",
      "markers": []
    },
    {
      "id": "s009",
      "start": 793,
      "end": 889,
      "text": " فجعَل الظُّلُماتِ مَثَلًا لأعمالِهم، والبحرَ اللُّجِّيَّ مثَلًا لقلبِ الكافِرِ، يقولُ: عَمَلُه ",
      "markers": []
    },
    {
      "id": "s010",
      "start": 903,
      "end": 1028,
      "text": " بنِيَّةِ قلبٍ قد غمَره الجهلُ، وتَغَشَّتْه الضلالةُ والحَيْرةُ، كما يَغْشَى هذا البحرَ اللُّجيَّ موجٌ مِن فوقِه موجٌ مِن فوق",
      "markers": []
    },
    {
      "id": "s011",
      "start": 1032,
      "end": 1292,
      "text": "ِه سَحابٌ. فكذلك قلبُ هذا الكافرِ الذي مثَلُ عملِه مثَلُ هذه الظلماتِ، يَغْشاه الجهلُ باللهِ، بأن الله ختَم عليه، فلا يَعْقِلُ عن اللهِ، وعلى سمعِه، فلا يَسْمَعُ مواعظَ اللهِ، وجعَل على بصرِه غِشاوةً، فلا يُبْصِرُ به حُجَجَ اللهِ، فتلك ظلماتٌ بعضُها فوقَ بعضٍ.",
      "markers": []
    },
    {
      "id": "s012",
      "start": 1292,
      "end": 1334,
      "text": "وبنحوِ الذي قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s013",
      "start": 1334,
      "end": 1378,
      "text": "ذكرُ مَن قال ذلكحدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1378,
      "end": 1406,
      "text": " ثنى أبي، قال: ثنى عمي، قال:",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1406,

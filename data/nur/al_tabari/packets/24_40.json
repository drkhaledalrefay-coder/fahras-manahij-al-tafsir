          "start": 2556,
          "end": 2599,
          "stripped": "عن الربيع بن أنس، عن أبي العالية، عن أبي",
          "span_id": "s030"
        },
        {
          "family": "TABIIN",
          "marker": "الربيع",
          "name": "الربيع",
          "role": "NARRATOR",
          "start": 2559,
          "end": 2565,
          "span_id": "s030"
        },
        {
          "family": "SAHABA",
          "marker": "أنس",
          "name": "أنس",
          "role": "NARRATOR",
          "start": 2570,
          "end": 2573,
          "span_id": "s030"
        },
        {
          "family": "SAHABA",
          "marker": "أبي بن كعب",
          "name": "أبي بن كعب",
          "role": "SPEAKER",
          "start": 2596,
          "end": 2608,
          "span_id": "s030"
        }
      ]
    },
    {
      "id": "s031",
      "start": 2619,
      "end": 2682,
      "text": " {أَوْ كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ يَغْشَاهُ مَوْجٌ} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2620,
          "end": 2675,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2682,
      "end": 2720,
      "text": " قال: ضرَب مثلًا آخَرَ للكافِرِ، فقال:",
      "markers": []
    },
    {
      "id": "s033",
      "start": 2720,
      "end": 2766,
      "text": " {أَوْ كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2721,
          "end": 2759,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 2766,
      "end": 2925,
      "text": " قال: فهو يَتَقَلَّبُ في خمسٍ مِن الظُّلَم، فكلامُه ظُلْمَةٌ، وعملُه ظلمةٌ، ومَدْخَلُه ظلمةٌ، ومَخْرَجُه ظلمةٌ، ومصيرُه إلى الظلماتِ يومَ القيامةِ، إلى النارِ ",
      "markers": []
    },
    {
      "id": "s035",
      "start": 3014,
      "end": 3054,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3015,
          "end": 3022,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 3054,
      "end": 3076,
      "text": " ثني حجاجٌ، عن أبي جعف",
      "markers": []
    },
    {
      "id": "s037",
      "start": 3080,
      "end": 3104,
      "text": "رٍ الرازيِّ، عن الربيعِ ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الربيع",
          "name": "الربيع",
          "role": "NARRATOR",
          "start": 3096,
          "end": 3102,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 3152,
      "end": 3197,
      "text": "، عن أبي العاليةِ، عن أُبيِّ بنُ كعبٍ بنحوِه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3154,
          "end": 3197,
          "stripped": "عن أبي العالية، عن أبي بن كعب بنحوه.",
          "span_id": "s038"
        },
        {
          "family": "SAHABA",
          "marker": "أبي بن كعب",
          "name": "أبي بن كعب",
          "role": "NARRATOR",
          "start": 3174,
          "end": 3188,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 3197,
      "end": 3240,
      "text": "حدَّثني يونُسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3218,
          "end": 3225,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3240,
      "end": 3263,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 3245,
          "end": 3252,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 3263,
      "end": 3330,
      "text": " {أَوْ كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ يَغْشَاهُ مَوْجٌ} إلى قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3264,
          "end": 3319,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 3330,
      "end": 3372,
      "text": " {ظُلُمَاتٌ بَعْضُهَا فَوْقَ بَعْضٍ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3331,
          "end": 3366,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3372,
      "end": 3402,
      "text": " شرٌّ بعضُه فوقَ بعضٍ. وقولُه:",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3402,
      "end": 3448,
      "text": " {إِذَا أَخْرَجَ يَدَهُ لَمْ يَكَدْ يَرَاهَا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3403,
          "end": 3447,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3448,
      "end": 3514,
      "text": " يقولُ: إذا أَخْرَج الناظرُ يدَه في هذه الظلماتِ لم يَكَدْ يَراها ",
      "markers": []
    },
    {
      "id": "s046",
      "start": 3578,
      "end": 3587,
      "text": ".فإن قال ",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3606,
      "end": 3672,
      "text": " قائل: وكيف قيلَ: {لَمْ يَكَدْ يَرَاهَا}. مع شدةِ هذه الظُّلْمِةِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3624,
          "end": 3646,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3692,
      "end": 3732,
      "text": ".التي وصَف، وقد علِمْتَ أن قولَ القائلِ:",
      "markers": []
    },
    {
      "id": "s049",
      "start": 3732,
      "end": 3840,
      "text": " لم أكَدْ أَرَى فلانًا. إنما هو إثباتٌ منه لنفسِه رؤيتَه بعدَ جَهْدٍ وشدةٍ، ومِن دونِ الظلماتِ التي وُصِفَت ",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3854,
      "end": 3922,
      "text": " في هذه الآيةِ ما لا يَرَى الناظرُ يدَه إذا أخْرَجها فيه، فكيف فيها؟",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخرجه",
          "start": 3898,
          "end": 3905,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3922,
      "end": 3982,
      "text": "قيل: في ذلك أقوالٌ، نَذْكُرُها ثم نُخْبِرُ بالصوابِ مِن ذلك؛",
      "markers": []
    },
    {
      "id": "s052",
      "start": 3982,
      "end": 4013,
      "text": " أحدُها: أن يكونَ معنى الكلامِ:",
      "markers": []
    },
    {
      "id": "s053",
      "start": 4013,
      "end": 4055,
      "text": " إذا أخْرَج يدَه رائيًا لها، لم يَكَدْ أن ",
      "markers": []
    },
    {
      "id": "s054",
      "start": 4067,
      "end": 4100,
      "text": " يراها. أي: لم يَعْرِفْ مِن أينَ ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 4075,
          "end": 4078,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4104,
      "end": 4185,
      "text": "يراها، فيكونُ مِن المُقَدَّمِ الذي معناه التأخيرُ، ويكونُ تأويلُ الكلامِ على ذلك:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 4139,
          "end": 4144,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4185,
      "end": 4224,
      "text": " إذا أخْرَج يدَه لم يَقْرُبْ أن يرَاها.",
      "markers": []
    },
    {
      "id": "s057",
      "start": 4224,
      "end": 4276,
      "text": "والثاني: أن يكونَ معناه: إذا أَخْرَج يدَه لم يَرَها.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 4242,
          "end": 4247,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4276,
      "end": 4381,
      "text": " ويكون قولُه: {لَمْ يَكَدْ}. في دخولِه في الكلامِ، نظيرَ دخولِ الظَّنِّ فيما هو يقينٌ من الكلامِ، كقولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4290,
          "end": 4303,
          "span_id": "s058"
        },
        {
          "family": "LUGHA",
          "marker": "كقول",
          "start": 4374,
          "end": 4378,
          "span_id": "s058"
        },
        {
          "family": "LUGHA",
          "marker": "كقوله",
          "start": 4374,
          "end": 4380,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4381,
      "end": 4418,
      "text": " {وَظَنُّوا مَا لَهُمْ مِنْ مَحِيصٍ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4382,
          "end": 4417,
          "span_id": "s059"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 4418,
          "end": 4428,
          "text": "[فصلت: 48]",
          "via": "apparatus",
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4428,
      "end": 4511,
      "text": ". ونحوَ ذلك.والثالثُ: أن يكونَ قد رآها بعدَ بُطءٍ وجَهْدٍ، كما يقولُ القائلُ لآخرَ:",
      "markers": []
    },
    {
      "id": "s061",
      "start": 4511,
      "end": 4539,
      "text": " ما كِدْتُ أراك مِن الظلمةِ.",
      "markers": []
    },
    {
      "id": "s062",
      "start": 4539,
      "end": 4572,
      "text": " وقد رآه، ولكنْ بعدَ إياسٍ وشدةٍ.",
      "markers": []
    },
    {
      "id": "s063",
      "start": 4572,
      "end": 4663,
      "text": "وهذا القولُ الثالثُ أظهرُ معاني الكلمةِ من جهةِ ما تَسْتَعْمِلُ العربُ \"أَكادُ\" في كلامِها.",
      "markers": []
    },
    {
      "id": "s064",
      "start": 4663,
      "end": 4719,
      "text": " والقولُ الآخرُ الذي قلنا أنه يَتَوَجَّهُ إلى أنه بمعنى:",
      "markers": []
    },
    {
      "id": "s065",
      "start": 4719,
      "end": 4785,
      "text": " لم يَرَها. قول أَوْضَحُ مِن جهةِ التفسيرِ، وهو أَخْفَى مَعانِيهِ.",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4785,
      "end": 4823,
      "text": "وإنما حسُنَ ذلك في هذا الموضعِ - أعنى:",
      "markers": []
    },
    {
      "id": "s067",
      "start": 4823,
      "end": 4857,
      "text": " أن يقولَ: {لَمْ يَكَدْ يَرَاهَا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4834,
          "end": 4856,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 4857,
      "end": 4923,
      "text": " مع شدةِ الظلمةِ التي ذكَر - لأن ذلك مَثَلٌ، لا خبرٌ عن كائنٍ كان.",
      "markers": []
    },
    {
      "id": "s069",
      "start": 4923,
      "end": 4966,
      "text": "{وَمَنْ لَمْ يَجْعَلِ اللَّهُ لَهُ نُورًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4923,
          "end": 4965,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 4966,
      "end": 5068,
      "text": " يقولُ: مَن لم يَرْزُقُهُ اللهُ إِيمانًا وهُدًى مِن الضلالةِ ومعرفةً بكتابِه، {فَمَا لَهُ مِنْ نُورٍ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5044,
          "end": 5067,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 5068,
      "end": 5116,
      "text": " يقولُ: فما له من إيمانٍ وهدًى ومعرفةٍ بكتابِه. ",
      "markers": []
    }
  ],

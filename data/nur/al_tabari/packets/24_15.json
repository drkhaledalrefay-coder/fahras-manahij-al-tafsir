  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 32,
      "text": " القولُ في تأويل قوله تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 21,
          "end": 31,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 32,
      "end": 190,
      "text": " {إِذْ تَلَقَّوْنَهُ بِأَلْسِنَتِكُمْ وَتَقُولُونَ بِأَفْوَاهِكُمْ مَا لَيْسَ لَكُمْ بِهِ عِلْمٌ وَتَحْسَبُونَهُ هَيِّنًا وَهُوَ عِنْدَ اللَّهِ عَظِيمٌ (15)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 33,
          "end": 189,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 190,
      "end": 285,
      "text": "يقول تعالى ذكره: لمسَّكم فيما أَفَضْتُم فيه من شأنِ عائشةَ عذابٌ عظيمٌ حينَ تلقَّونه بألسنتِكم.",
      "markers": []
    },
    {
      "id": "s004",
      "start": 285,
      "end": 309,
      "text": "و {إِذْ} مِن صلةِ قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 287,
          "end": 293,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 309,
      "end": 427,
      "text": " {لَمَسَّكُمْ}.ويعنى بقولِه: {تَلَقَّوْنَهُ}: تتلقَّوْن الإفكَ الذي جاءت به العصبةُ مِن أهلِ الإفكِ، فتقبلونه، ويرويه ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 310,
          "end": 323,
          "span_id": "s005"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 338,
          "end": 353,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 469,
      "end": 522,
      "text": " بعضُكم عن بعضٍ.يقالُ: تلقَّيتُ هذا الكلامَ عن فلانٍ.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 477,
          "end": 522,
          "stripped": "عن بعض.يقال: تلقيت هذا الكلام عن فلان.",
          "span_id": "s006"
        },
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 485,
          "end": 489,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 522,
      "end": 601,
      "text": " بمعنى: أخذتُه مِنه. وقيل ذلك لأنَّ الرجلَ منهم فيما ذُكِر يَلْقى آخرَ، فيقولُ:",
      "markers": []
    },
    {
      "id": "s008",
      "start": 601,
      "end": 635,
      "text": " أَوَمَا بلغَك كذا وكذا عن عائشةَ؟",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 628,
          "end": 633,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 635,
      "end": 720,
      "text": " ليُشِيعَ عليها بذلك الفاحشةَ.وذُكِر أنها في قراءةِ أُبيٍّ: (إذ تتلقَّوْنَهُ) بتاءين ",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 680,
          "end": 685,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 775,
      "end": 821,
      "text": "، وعليها قَرَأَةُ الأمصارِ، غيرَ أنهم قرءُوها:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 784,
          "end": 789,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 821,
      "end": 875,
      "text": " {تَلَقَّوْنَهُ} بتاءٍ واحدةٍ؛ لأنها كذلك في مصاحفِهم.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 822,
          "end": 837,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 875,
      "end": 958,
      "text": "وقد رُوِى عن عائشةَ في ذلك ما حدَّثني به محمدُ بنُ عبدِ اللهِ بن عبدِ الحكَمِ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 888,
          "end": 893,
          "span_id": "s012"
        }
      ]
    },
    {
      "id": "s013",
      "start": 958,
      "end": 1029,
      "text": " ثنا خالدُ بنُ نِزارٍ، عن نافعٍ، عن ابن أبي مُلَيْكَةَ، عن عائشةَ زوجِ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 981,
          "end": 1016,
          "stripped": "عن نافع، عن ابن أبي مليكة، عن",
          "span_id": "s013"
        },
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 1017,
          "end": 1022,
          "span_id": "s013"
        }
      ]
    },
    {
      "id": "s014",
      "start": 1033,
      "end": 1091,
      "text": "النبيِّ - صلى الله عليه وسلم - أنها كانت تقرأُ هذه الآيةَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1043,
          "end": 1061,
          "span_id": "s014"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 1075,
          "end": 1078,
          "span_id": "s014"
        }
      ]
    },
    {
      "id": "s015",
      "start": 1091,
      "end": 1140,
      "text": " (إذْ تَلِقُونَهُ). تقولُ: إنما هو وَلْقُ الكذبِ.",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1140,
      "end": 1175,
      "text": "وتقولُ: إنما كانوا يَلِقُون الكذبَ.",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1175,
      "end": 1225,
      "text": " قال ابن أبي مُليكةَ: وهى أعلمُ بما فيها أُنزِلَت.",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1225,
      "end": 1263,
      "text": " قال نافعٌ: وسمِعتُ بعضَ العربِ يقولُ:",
      "markers": []
    },
    {
      "id": "s019",
      "start": 1263,
      "end": 1306,
      "text": " اللَّيْقُ الكذبُ.حدَّثنا ابن حُمَيدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1281,
          "end": 1288,
          "span_id": "s019"
        }
      ]
    },
    {
      "id": "s020",
      "start": 1306,
      "end": 1332,
      "text": " ثنا يحيى بنُ واضِحٍ، قال:",
      "markers": []
    },
    {
      "id": "s021",
      "start": 1332,
      "end": 1372,
      "text": " ثنا نافعُ بنُ عمرَ بن عبدِ اللَّهِ ابن ",
      "markers": []
    },
    {
      "id": "s022",
      "start": 1398,
      "end": 1399,
      "text": " ",
      "markers": []
    },
    {
      "id": "s023",
      "start": 1461,
      "end": 1520,
      "text": " الجُمَحِيُّ، عن ابن أبي مليكةَ، عن عائشةَ أنها كانت تقرأُ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1475,
          "end": 1520,
          "stripped": "عن ابن أبي مليكة، عن عائشة أنها كانت تقرأ:",
          "span_id": "s023"
        },
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 1497,
          "end": 1502,
          "span_id": "s023"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 1515,
          "end": 1518,
          "span_id": "s023"
        }
      ]
    },
    {
      "id": "s024",
      "start": 1520,
      "end": 1586,
      "text": " (إذْ تَلِقُونَهُ بِألْسِنَتِكُمْ). وهى أعلمُ بذلك وفيها أُنزِلَت.",
      "markers": []
    },
    {
      "id": "s025",
      "start": 1586,
      "end": 1632,
      "text": " قال ابن أبي مُلَيْكَةَ: هو مِن وَلْقِ الكذبِ ",
      "markers": []
    },
    {
      "id": "s026",
      "start": 1864,
      "end": 1921,
      "text": ".قال أبو جعفرٍ: وكأنَّ عائشةَ وَجَّهت معنى ذلك بقراءتِها:",
      "markers": []
    },
    {
      "id": "s027",
      "start": 1921,
      "end": 1966,
      "text": " (تلقُونَهُ) بكسرِ اللامِ وتخفيفِ القافِ إلى:",
      "markers": []
    },
    {
      "id": "s028",
      "start": 1966,
      "end": 2014,
      "text": " إذ تستمرّون في كذبِكم عليها، وإفكِكم بألسنتِكم.",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2014,
      "end": 2053,
      "text": " كما يقالُ: وَلَق فلانٌ في السيرِ فهو ي",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 2019,
          "end": 2023,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 2057,
      "end": 2097,
      "text": "َلقُ. إذا استمرَّ فيه، وكما قال الراجزُ ",
      "markers": []
    },
    {
      "id": "s031",
      "start": 2206,
      "end": 2243,
      "text": ":إِنَّ الجُلَيْدَ زَلِقٌ وَزُمَّلِقٌ ",
      "markers": []
    },
    {
      "id": "s032",
      "start": 2336,
      "end": 2354,
      "text": "جاءتْ بِهِ عَنْسٌ ",
      "markers": []
    },
    {
      "id": "s033",
      "start": 2454,
      "end": 2571,
      "text": " مِنَ الشَّأْمِ تَلِقْمُجَوَّعُ البَطْنِ كِلابِيُّ الخُلُقْوقد رُوِى عن العربِ في الوَلْقِ، الكذبُ، الأَلْقُ والإلقُ؛",
      "markers": []
    },
    {
      "id": "s034",
      "start": 2571,
      "end": 2616,
      "text": " بفتحِ الألفِ وكسرِها، ويقالُ في \"فعلتُ\" منه:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 2595,
          "end": 2599,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2616,
      "end": 2652,
      "text": " أَلَقْتُ، فأنا أَلِقُ. وقال بعضُهم ",
      "markers": []
    },
    {
      "id": "s036",
      "start": 2699,
      "end": 2732,
      "text": ":مَن لِي بالمُزَرَّرِ اليَلامِقِ ",
      "markers": []
    },
    {
      "id": "s037",
      "start": 2776,
      "end": 2796,
      "text": " ... صاحِبِ إدْهانٍ ",
      "markers": []
    },
    {
      "id": "s038",
      "start": 2829,
      "end": 2876,
      "text": " وأَلْقِ آلِقِوالقراءةُ التي لا أستجيزُ غيرَها:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 2846,
          "end": 2851,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 2876,
      "end": 2928,
      "text": " {إِذْ تَلَقَّوْنَهُ} على ما ذكرتُ مِن قراءةِ قرآةِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2877,
          "end": 2897,
          "span_id": "s039"
        },
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 2915,
          "end": 2920,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 2945,
      "end": 2992,
      "text": " الأمصارِ؛ لإجماعِ الحجةِ مِن القَرَأَةِ عليها.",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 2977,
          "end": 2982,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 2992,
      "end": 3048,
      "text": "وبنحوِ الذي قُلنا مِن التأويلِ في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3048,
      "end": 3077,
      "text": "ذِكرُ مَن قال ذلكحدَّثنا القا",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3065,
          "end": 3072,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3081,
      "end": 3108,
      "text": "سمُ، قال: ثنا الحسينُ، قال:",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3108,
      "end": 3146,
      "text": " ثنى حجاجٌ، عن ابن جُرَيجٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3120,
          "end": 3146,
          "stripped": "عن ابن جريج، عن مجاهد:",
          "span_id": "s044"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 3123,
          "end": 3133,
          "span_id": "s044"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3139,
          "end": 3144,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3146,
      "end": 3216,
      "text": " {إِذْ تَلَقَّوْنَهُ بِأَلْسِنَتِكُمْ}. قال: تَرْوُونه بعضُكم عن بعضٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3147,
          "end": 3184,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3267,
      "end": 3297,
      "text": ".حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3297,
      "end": 3350,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، وحدَّثني الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3350,
      "end": 3415,
      "text": " ثنا الحسنُ، قال: ثنا ورقاءُ، جميعًا عن ابن أبي نجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 3355,
          "end": 3360,
          "span_id": "s048"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3387,
          "end": 3415,
          "stripped": "عن ابن أبي نجيح، عن مجاهد:",
          "span_id": "s048"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3408,
          "end": 3413,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3415,
      "end": 3468,
      "text": " {إِذْ تَلَقَّوْنَهُ}. قال: تَرْوُونه بعضُكم عن بعضٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3416,
          "end": 3436,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 3717,
      "end": 3787,
      "text": ".وقولُه: {وَتَقُولُونَ بِأَفْوَاهِكُمْ مَا لَيْسَ لَكُمْ بِهِ عِلْمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3726,
          "end": 3786,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3787,
      "end": 3881,
      "text": " يقولُ تعالى ذِكرُه: وتقولون بأفواهِكم ما ليسَ لكم به علمٌ مِن الأمرِ الذي تَرْوُونه، فتقولون:",
      "markers": []
    },
    {
      "id": "s052",
      "start": 3881,
      "end": 3916,
      "text": " سمِعْنا أن عائشةَ فعَلتْ كذا وكذا.",
      "markers": []
    },
    {
      "id": "s053",
      "start": 3916,
      "end": 3977,
      "text": " ولا تعلمون حقيقةَ ذلك ولا صحتَه، {وَتَحْسَبُونَهُ هَيِّنًا}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3950,
          "end": 3976,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 3977,
      "end": 4046,
      "text": " وتظنون أن قولَكم ذلك، وروايتَكموه بألسنتِكم، وتلقِّيَكموه بعضُكم من ",
      "markers": []
    },
    {
      "id": "s055",
      "start": 4062,
      "end": 4101,
      "text": " بعضٍ، هيِّنٌ سهلٌ، لا إثمَ عليكم فيه و",
      "markers": []
    },
    {
      "id": "s056",
      "start": 4105,
      "end": 4146,
      "text": "لا حرجَ، {وَهُوَ عِنْدَ اللَّهِ عَظِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4114,
          "end": 4145,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4146,
      "end": 4226,
      "text": " يقولُ: وتلقِّيكم ذلك كذلك، وقولُكموه بأفواهِكم - عندَ اللَّهِ عظيمٌ مِن الأمرِ؛",
      "markers": []
    },
    {
      "id": "s058",
      "start": 4226,
      "end": 4295,
      "text": " لأنَّكم كنتُم تؤذون به رسولَ اللهِ - صلى الله عليه وسلم - وحليلَتَه ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4264,
          "end": 4282,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4317,
      "end": 4319,
      "text": ". ",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [

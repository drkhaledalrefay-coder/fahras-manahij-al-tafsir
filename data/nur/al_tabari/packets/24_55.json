          "span_id": "s025"
        }
      ]
    },
    {
      "id": "s026",
      "start": 2399,
      "end": 2515,
      "text": " يقرؤُه: {وَلَيُبَدِّلَنَّهُمْ} بتَخْفِيفِ الدالِ.والصوابُ مِن القراءةِ في ذلك التشديدُ، على المعنى الذي وصفتُ قبلُ؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2408,
          "end": 2430,
          "span_id": "s026"
        },
        {

    {
      "id": "s014",
      "start": 1442,
      "end": 1517,
      "text": "، بمعنى: كما اسْتَخْلَفَ الله الذين مِن قبلِهم مِن الأممِ. وقَرأ ذلك عاصمُ ",
      "markers": [

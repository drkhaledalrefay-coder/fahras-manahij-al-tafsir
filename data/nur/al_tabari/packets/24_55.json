          "end": 1174,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 1175,
      "end": 1222,
      "text": " وَعَدْتُك أن أُكْرِمَك، ووعدتُك لأُكْرِمَنَّك.",
      "markers": []
    },
    {
      "id": "s011",

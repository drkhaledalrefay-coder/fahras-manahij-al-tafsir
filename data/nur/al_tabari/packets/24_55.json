      "start": 2735,
      "end": 2846,
      "text": "ومِن الدليلِ على ما قُلنا، مِن أن التَّخْفيفَ إنما هو ما كان في إبْدالِ شيءٍ مكانَ آخَرَ - قولُ أَبي النَّجْمِ ",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2861,
      "end": 2920,
      "text": ":عَزْلَ الأميرِ للأميرِ المُبْدَلِوقولُه: {يَعْبُدُونَنِي}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2903,
          "end": 2919,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 2920,
      "end": 3013,
      "text": " يقولُ: يَخْضَعون لى بالطاعةِ، ويَتَذَلُّلون لأمْرِى ونَهْيِى، {لَا يُشْرِكُونَ بِي شَيْئًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2983,
          "end": 3012,
          "span_id": "s030"
        }
      ]
    },
    {
      "id": "s031",
      "start": 3013,
      "end": 3076,
      "text": " يقولُ: لا يُشْرِكون في عبادتِهم إياى الأوثانَ والأصنامَ، ولا ش",
      "markers": []
    },
    {
      "id": "s032",
      "start": 3080,
      "end": 3092,
      "text": "يئًا غيرَها ",
      "markers": []
    },
    {
      "id": "s033",
      "start": 3122,
      "end": 3200,
      "text": "، بل يُخْلِصون لى العبادةَ، فيُفْرِدونها لى، دونَ كلِّ ما عُبِد مِن شيءٍ غيرى.",
      "markers": []
    },
    {
      "id": "s034",
      "start": 3200,
      "end": 3441,
      "text": "وذُكِر أن هذه الآيةَ نزَلت على رسولِ اللهِ - صلى الله عليه وسلم - مِن أجلِ شِكايةِ بعضِ أصحابهِ إليه، في بعضِ الأوقاتِ التي كانوا فيها مِن العدوِّ في خوفٍ شديدٍ، مما هم فيه من الرُّعْبِ والخوفِ، وما يَلْقَون بسببِ ذلك مِن الأذَى والمَكْروهِ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3245,
          "end": 3263,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 3441,
      "end": 3480,
      "text": "ذكرُ الروايةِ بذلكحدَّثنا القاسمُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3459,
          "end": 3466,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 3480,
      "end": 3558,
      "text": " ثنا الحسيُن، قال: ثني حجاجٌ، عن أبي جعفرٍ، عن الربيعِ، عن أبي العاليةِ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3510,
          "end": 3558,
          "stripped": "عن أبي جعفر، عن الربيع، عن أبي العالية قوله:",
          "span_id": "s036"
        },
        {
          "family": "TABIIN",
          "marker": "الربيع",
          "name": "الربيع",
          "role": "NARRATOR",
          "start": 3527,
          "end": 3533,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 3558,
      "end": 3634,
      "text": " {وَعَدَ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَعَمِلُوا الصَّالِحَاتِ} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3559,
          "end": 3627,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 3634,
      "end": 3735,
      "text": " قال: مَكَث النبيُّ - صلى الله عليه وسلم - عَشْرَ سنينَ خائفًا، يَدْعُو إِلى اللَّهِ سِرًّا وعلانيةً.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3656,
          "end": 3674,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 3735,
      "end": 3772,
      "text": " قال: ثم أُمِر بالهجرةِ إلى المدينةِ.",
      "markers": []
    },
    {
      "id": "s040",
      "start": 3772,
      "end": 3807,
      "text": " قال: فمكَث بها هو وأصحابُه خائفين ",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3837,
      "end": 3884,
      "text": "، يُصْبِحون في السلاحِ ويُمْشون فيه، فقال رجلٌ:",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3884,
      "end": 3938,
      "text": " ما يأتى علينا يومٌ نأمَنُ فيه ونَضَعُ عَنَّا السلاحَ؟",
      "markers": []
    },
    {
      "id": "s043",
      "start": 3938,
      "end": 3992,
      "text": " فقال النبيُّ - صلى الله عليه وسلم -: \"لا تَغْبُرُونَ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3954,
          "end": 3972,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 4082,
      "end": 4101,
      "text": " إِلا يَسِيرًا حتى ",
      "markers": []
    },
    {
      "id": "s045",
      "start": 4105,
      "end": 4178,
      "text": "يَجْلِسَ الرجلُ منكم في الملأ العظيمِ مُحْتَبِيًا فيه، ليس فيه حَدِيدةٌ\".",
      "markers": []
    },
    {
      "id": "s046",
      "start": 4178,
      "end": 4260,
      "text": " فأنزَل اللَّهُ هذه الآيةَ: {وَعَدَ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ} إلى قولِه:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 4179,
          "end": 4185,
          "span_id": "s046"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 4179,
          "end": 4192,
          "span_id": "s046"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4206,
          "end": 4249,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 4260,
      "end": 4296,
      "text": " {وَمَنْ كَفَرَ بَعْدَ ذَلِكَ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4261,
          "end": 4290,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 4296,
      "end": 4361,
      "text": " يقولُ: مَن كَفَر بهذه النعمةِ، {فَأُولَئِكَ هُمُ الْفَاسِقُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4328,
          "end": 4360,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 4361,
      "end": 4391,
      "text": " وليس يعنى الكفرَ باللهِ. قال:",
      "markers": []
    },
    {
      "id": "s050",
      "start": 4391,
      "end": 4543,
      "text": " فأظهَره اللهُ على جزيرةِ العربِ، فآمَنوا، ثم تَجَبَّروا، فَغَيَّرَ اللهُ ما بهم، وكَفَروا بهذه النعمةِ، فأدخَل اللهُ عليهم الخوفَ الذي كان رَفَعه عنهم.",
      "markers": []
    },
    {
      "id": "s051",
      "start": 4543,
      "end": 4571,
      "text": " قال القاسمُ: قال أبو عليٍّ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 4565,
          "end": 4568,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4571,
      "end": 4616,
      "text": " بِقَتْلِهِم عثمانَ بنَ عفانَ رضِي اللهُ عنه ",
      "markers": []
    },
    {
      "id": "s053",
      "start": 4831,
      "end": 4895,
      "text": ".واختَلف أهلُ التأويلِ في معنى الكفرِ الذي ذكَره اللهُ في قولِه:",
      "markers": []
    },
    {
      "id": "s054",
      "start": 4895,
      "end": 4996,
      "text": " {وَمَنْ كَفَرَ بَعْدَ ذَلِكَ}؛ فقال أبو العاليةِ ما ذكَرنا عنه مِن أنه كفرٌ بالنعمةِ لا كفرٌ باللهِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4896,
          "end": 4925,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4996,
      "end": 5051,
      "text": "ورُوِى عن حُذَيفةَ في ذلك ما حدَّثنا به ابن بشارٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5025,
          "end": 5032,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 5051,
      "end": 5100,
      "text": " ثنا عبدُ الرحمنِ، قال: ثنا سفيانُ، عن حبيبٍ، عن ",
      "markers": []
    },
    {
      "id": "s057",
      "start": 5181,
      "end": 5265,
      "text": " أبي الشَّعْثاءِ، قال: كنتُ جالسًا مع حُذَيفةَ وعبدِ اللهِ بن مسعودٍ، فقال حُذَيفةُ:",
      "markers": []
    },
    {
      "id": "s058",
      "start": 5265,
      "end": 5374,
      "text": " ذهَب النِّفاقُ، وإنما كان النفاقُ على عهدِ رسول اللهِ - صلى الله عليه وسلم -، وإنما هو الكفرُ بعدَ الإيمانِ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5322,
          "end": 5340,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 5374,
      "end": 5404,
      "text": " قال: فضَحِك عبدُ اللهِ، فقال:",
      "markers": []
    },
    {
      "id": "s060",
      "start": 5404,
      "end": 5437,
      "text": " لِمَ تقولُ ذلك؟ قال: علِمتُ ذلك.",
      "markers": []
    },
    {
      "id": "s061",
      "start": 5437,
      "end": 5567,
      "text": " قال: {وَعَدَ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَعَمِلُوا الصَّالِحَاتِ لَيَسْتَخْلِفَنَّهُمْ فِي الْأَرْضِ}. حتى بَلَغ آخِرَها ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5443,
          "end": 5547,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 5680,
      "end": 5748,
      "text": ".حدَّثنا ابن المُثَنَّى، قال: ثنا ابن أَبي عَدِيٍّ، قال: ثنا شعبةُ، ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5681,
          "end": 5688,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 5762,
      "end": 5763,
      "text": " ",
      "markers": []
    },
    {
      "id": "s064",
      "start": 5806,
      "end": 5832,
      "text": "، عن أبي الشَّعْثاءِ، قال:",
      "markers": []
    },
    {
      "id": "s065",
      "start": 5832,
      "end": 5880,
      "text": " فَعَدْتُ إلى ابن مسعودٍ وحُذَيفةَ، فقال حذيفةُ:",
      "markers": []
    },
    {
      "id": "s066",
      "start": 5880,
      "end": 5937,
      "text": " ذهَب النِّفاقُ فلا نفاقَ، وإنما هو الكفرُ بعدَ الإيمانِ.",
      "markers": []
    },
    {
      "id": "s067",
      "start": 5937,
      "end": 5972,
      "text": " فقال عبدُ اللَّهِ: تعلمُ ما تقولُ؟",
      "markers": []
    },
    {
      "id": "s068",
      "start": 5972,
      "end": 6035,
      "text": " قال: فتَلا هذه الآيةَ: {إِنَّمَا كَانَ قَوْلَ الْمُؤْمِنِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5996,
          "end": 6034,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 6035,
      "end": 6078,
      "text": " حتى بلغ: {فَأُولَئِكَ هُمُ الْفَاسِقُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6045,
          "end": 6077,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 6078,
      "end": 6107,
      "text": " قال: فضَحِك عبدُ اللهِ. قال:",
      "markers": []
    },
    {
      "id": "s071",
      "start": 6107,
      "end": 6150,
      "text": " فلَقِيتُ أبا الشَّعْثاءِ بعدَ ذلك بأيامٍ، ",
      "markers": []
    },
    {
      "id": "s072",
      "start": 6154,
      "end": 6192,
      "text": "فقلتُ: مِن أيِّ شيءٍ ضَحِك عبدُ اللهِ؟",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 6155,
          "end": 6158,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 6192,
      "end": 6326,
      "text": " قال: لا أدرى، إن الرجلَ ربما ضَحِك مِن الشيءِ الذي يُعْجِبُه، وربما ضَحِك من الشيءِ الذي لا يُعْجِبُه، فمِنْ أَيِّ شيءٍ ضحِك لا أدرى.",
      "markers": []
    },
    {
      "id": "s074",
      "start": 6326,
      "end": 6430,
      "text": "والذي قاله أبو العاليةِ مِن التأويلِ أشبهُ بتأويلِ الآيةِ، وذلك أن الله وعَد الإنعامَ على هذه الأُمَّةِ ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "أبو العالية",
          "name": "أبو العالية",
          "role": "SPEAKER",
          "start": 6337,
          "end": 6348,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 6451,
      "end": 6518,
      "text": " بما أخبرَ في هذه الآيةِ أنه مُنْعِمٌ به عليهم، ثم قال عَقِيبَ ذلك:",
      "markers": []
    },
    {
      "id": "s076",
      "start": 6518,
      "end": 6570,
      "text": " فمَن كفَر هذه النعمةَ بعدَ ذلك، فأولئك هم الفاسقون.",
      "markers": []
    },
    {
      "id": "s077",
      "start": 6570,
      "end": 6609,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6570,
          "end": 6577,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 6609,
      "end": 6653,
      "text": " ثنى حجاجٌ، عن ابن جُرَيجٍ، عن مجاهدٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6621,
          "end": 6653,
          "stripped": "عن ابن جريج، عن مجاهد قوله:",
          "span_id": "s078"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 6624,
          "end": 6634,
          "span_id": "s078"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 6640,
          "end": 6645,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 6653,
      "end": 6699,
      "text": " {يَعْبُدُونَنِي لَا يُشْرِكُونَ بِي شَيْئًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6654,
          "end": 6698,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 6699,
      "end": 6742,
      "text": " قال: تلك أمةُ محمد - صلى الله عليه وسلم - ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6721,
          "end": 6739,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 6799,
      "end": 6846,
      "text": ".حدَّثنا ابن بشارٍ، قال: ثنا عبدُ الرحمنِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6800,
          "end": 6807,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 6846,
      "end": 6879,
      "text": " ثنا سفيانُ، عن لَيثٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6859,
          "end": 6879,
          "stripped": "عن ليث، عن مجاهد:",
          "span_id": "s082"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 6872,
          "end": 6877,
          "span_id": "s082"
        }
      ]
    },
    {

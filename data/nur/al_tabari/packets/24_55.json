    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 401,
      "text": " {وَعَدَ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَعَمِلُوا الصَّالِحَاتِ لَيَسْتَخْلِفَنَّهُمْ فِي الْأَرْضِ كَمَا اسْتَخْلَفَ الَّذِينَ مِنْ قَبْلِهِمْ وَلَيُمَكِّنَنَّ لَهُمْ دِينَهُمُ الَّذِي ارْتَضَى لَهُمْ وَلَيُبَدِّلَنَّهُمْ مِنْ بَعْدِ خَوْفِهِمْ أَمْنًا يَعْبُدُونَنِي لَا يُشْرِكُونَ بِي شَيْئًا وَمَنْ كَفَرَ بَعْدَ ذَلِكَ فَأُولَئِكَ هُمُ الْفَاسِقُونَ (55)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 400,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 401,
      "end": 523,
      "text": "يقولُ تعالى ذكرُه: {وَعَدَ اللَّهُ الَّذِينَ آمَنُوا} باللهِ ورسولهِ {مِنْكُمْ} أيُّها الناسُ، {وَعَمِلُوا الصَّالِحَاتِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 420,
          "end": 454,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 470,
          "end": 480,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 496,
          "end": 522,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 523,
      "end": 616,
      "text": " يقولُ: وأطاعوا اللَّهَ ورسولَه فيما أمَراه ونَهَياه - {لَيَسْتَخْلِفَنَّهُمْ فِي الْأَرْضِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 578,
          "end": 615,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 616,
      "end": 755,
      "text": " يقولُ: لَيُورِثنَّهم اللهُ أرضَ المشركين مِن العربِ والعَجَمِ، فيجعلُهم مُلُوكَها وساستَها، {كَمَا اسْتَخْلَفَ الَّذِينَ مِنْ قَبْلِهِمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 709,
          "end": 754,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 755,
      "end": 924,
      "text": " يقولُ: كما فعَل مِن قَبْلِهم ذلك ببنى إسرائيلَ، إذ أهْلَك الجبابرةَ بالشامِ، وجعَلهم مُلُوكَها وسُكَّانَها، {وَلَيُمَكِّنَنَّ لَهُمْ دِينَهُمُ الَّذِي ارْتَضَى لَهُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 864,
          "end": 923,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 924,
      "end": 1028,
      "text": " يقولُ: وَلَيُوَطِّئَنَّ لهم دينَهم، يعنى مِلَّتَهم التي ارْتَضاها لهم، فأمَرهم بها.وقيل: {وَعَدَ اللَّه",
      "markers": []
    },
    {
      "id": "s008",
      "start": 1032,
      "end": 1092,
      "text": "ُ الَّذِينَ آمَنُوا}. ثم تَلَقَّى ذلك بجوابِ اليمينِ بقولِه:",
      "markers": []
    },
    {
      "id": "s009",
      "start": 1092,
      "end": 1175,
      "text": " {لَيَسْتَخْلِفَنَّهُمْ}؛ لأن الوعدَ قولٌ يَصْلُحُ فيه \"أن\" وجوابُ اليمينِ، كقولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1093,
          "end": 1116,
          "span_id": "s009"
        },
        {
          "family": "LUGHA",
          "marker": "كقول",
          "start": 1168,

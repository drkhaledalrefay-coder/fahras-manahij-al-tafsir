    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s107",
      "start": 7552,
      "end": 7804,
      "text": "¬أخرجه ابن أبي شيبة 9/ 405، ومسلم (1495)، وابن ماجه (2068)، والبيهقى 8/ 337 من طريق عبدة به. وأخرجه أحمد 7/ 105، 312 (4001، 4281)، ومسلم (10/ 1495)، وأبو داود (2253)، وأبو يعلى (5161)، والواحدى في أسباب النزول ص 238، والبيهقى 7/ 405 من طريق الأعمش به.¥",
      "grading": []
    },
    {

  "spans": [
    {
      "id": "s104",
      "start": 7178,
      "end": 7235,
      "text": "رجلٌ فقال: لو أن رجلًا وجد مع امرأته رجلًا فقتله قتلتموه ",
      "markers": []
    },
    {
      "id": "s105",
      "start": 7256,
      "end": 7343,
      "text": "؟ وإن تكلَّم جلدتموه؟ فذُكر ذلك لرسولِ اللهِ - صلى الله عليه وسلم -، فأنزَل اللهُ آيةَ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7303,
          "end": 7321,
          "span_id": "s105"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 7325,
          "end": 7331,
          "span_id": "s105"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 7325,
          "end": 7336,
          "span_id": "s105"
        }
      ]
    },
    {
      "id": "s106",
      "start": 7394,
      "end": 7498,
      "text": " اللعانِ. ثم جاء الرجلُ بعدُ، فقذَف امرأتَه، فلاعَن رسولُ اللهِ - صلى الله عليه وسلم - ما بينَهما، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7460,
          "end": 7478,
          "span_id": "s106"
        }
      ]
    },
    {
      "id": "s107",
      "start": 7498,
      "end": 7552,
      "text": " \"عسى أن تجئَ به أسودَ جَعدًا\". فجاءت به أسودَ جَعدًا ",
      "markers": []
    },
    {
      "id": "s108",
      "start": 7804,
      "end": 7912,
      "text": ".حدَّثنا ابن وكيعٍ، قال: ثنا جريرُ بنُ عبدِ الحميدِ، عن عبدِ الملكِ بن أبى سليمانَ، عن سعيدِ بن جُبيرٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7805,
          "end": 7812,
          "span_id": "s108"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 7891,
          "end": 7905,
          "span_id": "s108"
        }
      ]
    },
    {
      "id": "s109",
      "start": 7912,
      "end": 7968,
      "text": " سألتُ ابنَ عمرَ، فقلتُ: يا أبا عبدِ الرحمنِ، أيُفرَّقُ ",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 7931,
          "end": 7934,
          "span_id": "s109"
        }
      ]
    },
    {
      "id": "s110",
      "start": 8008,
      "end": 8051,
      "text": " بينَ المتلاعنَين؟ فقال: نعم، سبحانَ اللهِ!",
      "markers": []
    },
    {
      "id": "s111",
      "start": 8051,
      "end": 8080,
      "text": " إن أولَ من سأل عن ذلك فلانٌ؛",
      "markers": []
    },
    {
      "id": "s112",
      "start": 8080,
      "end": 8142,
      "text": " أتى النبيَّ - صلى الله عليه وسلم - فسأله، فقال: أرأيتَ لو أن ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 8095,
          "end": 8113,
          "span_id": "s112"
        }
      ]
    },
    {
      "id": "s113",
      "start": 8156,
      "end": 8199,
      "text": " أحدَنا رأى صاحبتَه على فاحشةٍ، كيف يصنعُ؟ ",
      "markers": []
    },
    {
      "id": "s114",
      "start": 8203,
      "end": 8226,
      "text": "فلم يُجبه في ذلك شيئًا.",
      "markers": []
    },
    {
      "id": "s115",
      "start": 8226,
      "end": 8252,
      "text": " قال: فأتاه بعدَ ذلك فقال:",
      "markers": []
    },
    {
      "id": "s116",
      "start": 8252,
      "end": 8286,
      "text": " إن الذي سألتُ عنه قد ابتُليتُ به.",
      "markers": []
    },
    {
      "id": "s117",
      "start": 8286,
      "end": 8375,
      "text": " فأنزَل اللهُ هذه الآيةَ في سورةِ \"النورِ\"، فدعا الرجلَ فوعَظه وذكَّره، وأخبَره أن عذابَ ",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 8287,
          "end": 8293,
          "span_id": "s117"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 8287,
          "end": 8298,
          "span_id": "s117"
        }
      ]
    },
    {
      "id": "s118",
      "start": 8406,
      "end": 8407,
      "text": " ",
      "markers": []
    },
    {
      "id": "s119",
      "start": 8443,
      "end": 8497,
      "text": ". قال: والذي بعَثك بالحقِّ، لقد رأيتُ وما كذبتُ عليها.",
      "markers": []
    },
    {
      "id": "s120",
      "start": 8497,
      "end": 8601,
      "text": " قال: ودعا المرأةَ فوعَظها، وأخبَرها أن عذابَ الدنيا أهونُ من عذابِ الآخرةِ. فقالت: والذي بعَثك بالحقِّ ",
      "markers": []
    },
    {
      "id": "s121",
      "start": 8628,
      "end": 8629,
      "text": " ",
      "markers": []
    },
    {
      "id": "s122",
      "start": 8665,
      "end": 8777,
      "text": ". قال فبدأ الرجلُ، فشهد أربعَ شهاداتٍ باللهِ إنه لمن الصادقين، والخامسةَ أن لعنةَ اللهِ عليه إن كان من الكاذبين.",
      "markers": []
    },
    {
      "id": "s123",
      "start": 8777,
      "end": 8894,
      "text": " ثم إن المرأةَ شهِدت أربع شهاداتٍ باللهِ إنه لمن الكاذبين، والخامسةَ أن غضَبَ اللهِ عليها إن كان من الصادقين، وفرَّق ",
      "markers": []
    },
    {
      "id": "s124",
      "start": 8911,
      "end": 8920,
      "text": " بينَهما ",
      "markers": []
    },
    {
      "id": "s125",
      "start": 9300,
      "end": 9369,
      "text": ".حدَّثنا ابن المثنى، قال: ثنا ابن أبي عديٍّ، عن داودَ، عن عامرٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9301,
          "end": 9308,
          "span_id": "s125"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9345,
          "end": 9369,
          "stripped": "عن داود، عن عامر، قال:",
          "span_id": "s125"
        }
      ]
    },
    {
      "id": "s126",
      "start": 9369,
      "end": 9499,
      "text": " لما أُنزِل: {وَالَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ ثُمَّ لَمْ يَأْتُوا بِأَرْبَعَةِ شُهَدَاءَ فَاجْلِدُوهُمْ ثَمَانِينَ جَلْدَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9382,
          "end": 9498,
          "span_id": "s126"
        }
      ]
    },
    {
      "id": "s127",
      "start": 9499,
      "end": 9593,
      "text": " قال عاصمُ ابن عديٍّ: إن أنا رأيتُ فتكلَّمتُ جُلِدتُ ثمانين، وإن أنا سكَتُّ سكَتُّ على الغيظِ؟",
      "markers": []
    },
    {
      "id": "s128",
      "start": 9593,
      "end": 9654,
      "text": " قال: فكأنَّ ذلك شقَّ على رسولِ اللهِ - صلى الله عليه وسلم -.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 9633,
          "end": 9651,
          "span_id": "s128"
        }
      ]
    },
    {
      "id": "s129",
      "start": 9654,
      "end": 9769,
      "text": " قال: فأنزِلت هذه الآيةُ: {وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ وَلَمْ يَكُنْ لَهُمْ شُهَدَاءُ إِلَّا أَنْفُسُهُمْ}.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 9660,
          "end": 9666,
          "span_id": "s129"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9680,
          "end": 9768,
          "span_id": "s129"
        }
      ]
    },
    {
      "id": "s130",
      "start": 9769,
      "end": 9889,
      "text": " قال: فما لبِثُوا إلا جمعةً حتى كان بينَ رجلٍ من قومِه وبيَن امرأتِه، فلاعَن رسولُ اللهِ - صلى الله عليه وسلم - بينَهما ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 9860,
          "end": 9878,
          "span_id": "s130"
        }
      ]
    },
    {
      "id": "s131",
      "start": 10014,
      "end": 10055,
      "text": ".حدَّثني عليٌّ، قال: ثنا عبدُ اللهِ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 10023,
          "end": 10026,
          "span_id": "s131"
        }
      ]
    },
    {
      "id": "s132",
      "start": 10055,
      "end": 10098,
      "text": " ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10069,
          "end": 10098,
          "stripped": "عن علي، عن ابن عباس قوله:",
          "span_id": "s132"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 10072,
          "end": 10075,
          "span_id": "s132"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 10082,
          "end": 10090,
          "span_id": "s132"
        }
      ]
    },
    {
      "id": "s133",
      "start": 10098,
      "end": 10194,
      "text": " {وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ وَلَمْ يَكُنْ لَهُمْ شُهَدَاءُ إِلَّا أَنْفُسُهُمْ} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10099,
          "end": 10187,
          "span_id": "s133"
        }
      ]
    },
    {
      "id": "s134",
      "start": 10194,
      "end": 10248,
      "text": " والخامسةُ: أن يُقالَ له: إن عليك لعنةَ اللهِ إن كنتَ ",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 10209,
          "end": 10214,
          "span_id": "s134"
        }
      ]
    },
    {
      "id": "s135",
      "start": 10252,
      "end": 10334,
      "text": "من الكاذبين. وإن أقرت المرأةُ بقولِه رُجمت، وإن أنكَرت شهِدت أربعَ شهاداتٍ باللهِ:",
      "markers": []
    },
    {
      "id": "s136",
      "start": 10334,
      "end": 10377,
      "text": " إنه لمن الكاذبين. والخامسةَ أن يُقالَ لها:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 10366,
          "end": 10371,
          "span_id": "s136"
        }
      ]
    },
    {
      "id": "s137",
      "start": 10377,
      "end": 10403,
      "text": " غضَبُ اللهِ عليكِ إن كان ",
      "markers": []
    },
    {
      "id": "s138",
      "start": 10425,
      "end": 10453,
      "text": " من الصادقين. فيُدرَأُ عنها ",
      "markers": []
    },
    {
      "id": "s139",
      "start": 10483,
      "end": 10553,
      "text": " العذابُ، ويُفرَّقُ بينَهما، فلا يجتمعان أبدًا، ويُلحقُ الولدُ بأمِّه ",
      "markers": []
    },
    {
      "id": "s140",
      "start": 10579,
      "end": 10619,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10580,
          "end": 10587,
          "span_id": "s140"
        }
      ]
    },
    {
      "id": "s141",
      "start": 10619,
      "end": 10662,
      "text": " ثني حجاجٌ، عن ابن جُريجٍ، عن عكرمةَ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10631,
          "end": 10662,
          "stripped": "عن ابن جريج، عن عكرمة قوله:",
          "span_id": "s141"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 10634,
          "end": 10643,
          "span_id": "s141"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 10649,
          "end": 10654,
          "span_id": "s141"
        }
      ]
    },
    {
      "id": "s142",
      "start": 10662,
      "end": 10759,
      "text": " {وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ}. قال: هلالُ بنُ أميَّةَ، والذي رُميَتْ به شريكُ بن سحماءَ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10663,
          "end": 10700,
          "span_id": "s142"
        }
      ]
    },
    {
      "id": "s143",
      "start": 10803,
      "end": 10822,
      "text": "، والذي اسْتَفْتَى ",
      "markers": []
    },
    {
      "id": "s144",
      "start": 10839,
      "end": 10840,
      "text": " ",
      "markers": []
    },
    {
      "id": "s145",
      "start": 10875,
      "end": 10911,
      "text": ".قال: ثني حجاجٌ، عن ابن جُريجٍ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 10895,
          "end": 10904,
          "span_id": "s145"
        }
      ]
    },
    {
      "id": "s146",
      "start": 10911,
      "end": 11053,
      "text": " أخبَرني الزهريُّ عن الملاعنةِ والسنةِ فيها، عن حديثِ سهلِ بن سعدٍ، أن رجلًا من الأنصارِ جاء إلى النبيِّ - صلى الله عليه وسلم -، فقال: أرأيتَ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10929,
          "end": 10978,
          "stripped": "عن الملاعنة والسنة فيها، عن حديث سهل بن سعد،",
          "span_id": "s146"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11018,
          "end": 11036,
          "span_id": "s146"
        }
      ]
    },
    {
      "id": "s147",
      "start": 11086,
      "end": 11147,
      "text": " رجلًا وجَد مع امرأتِه رجلًا، أيقتلُه فتقتلونه، أم كيف يفعلُ؟",
      "markers": []
    },
    {
      "id": "s148",
      "start": 11147,
      "end": 11239,
      "text": " فأنزَل اللهُ في شأنِه ما ذكَر من أمرِ المتلاعنَين، فقال رسولُ اللهِ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 11148,
          "end": 11154,
          "span_id": "s148"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 11148,
          "end": 11159,
          "span_id": "s148"
        },
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 11200,
          "end": 11214,
          "span_id": "s148"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11218,
          "end": 11236,
          "span_id": "s148"
        }
      ]
    },
    {
      "id": "s149",
      "start": 11239,
      "end": 11272,
      "text": " \" وقد قضَى اللهُ فيك وفى امرأتِك",
      "markers": []
    },
    {
      "id": "s150",
      "start": 11276,
      "end": 11403,
      "text": "\". فتلاعَنا وأنا شاهدٌ، ثم فارَقها عندَ رسولِ اللهِ - صلى الله عليه وسلم -، فكانت السُّنةُ بعدَها أن يُفرَّقَ بينَ المتلاعنَين.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11330,
          "end": 11348,
          "span_id": "s150"
        }
      ]
    },
    {
      "id": "s151",
      "start": 11403,
      "end": 11517,
      "text": " وكانت حاملةً، فأنكَره، فكان ابنُها يُدعَى إلى أمَّه، ثم جرَت السُّنةُ أن ابنَها يرتُها، وترِثُ ما فرَض اللهُ لها ",
      "markers": []
    },
    {
      "id": "s152",
      "start": 11614,
      "end": 11643,
      "text": ".حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s153",
      "start": 11643,
      "end": 11671,
      "text": " ثنى أبي، قال: ثنى عمي، قال:",
      "markers": []
    },
    {
      "id": "s154",
      "start": 11671,
      "end": 11709,
      "text": " ثنى أبي، عن أبيه، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11681,
          "end": 11709,
          "stripped": "عن أبيه، عن ابن عباس قوله:",
          "span_id": "s154"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 11693,
          "end": 11701,
          "span_id": "s154"
        }
      ]
    },
    {
      "id": "s155",
      "start": 11709,
      "end": 11759,
      "text": " {وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ}. إلى قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11710,
          "end": 11747,
          "span_id": "s155"
        }
      ]
    },
    {
      "id": "s156",
      "start": 11759,
      "end": 11797,
      "text": " {إِنْ كَانَ مِنَ الْكَاذِبِينَ}. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11760,
          "end": 11791,
          "span_id": "s156"
        }
      ]
    },
    {
      "id": "s157",
      "start": 11797,
      "end": 11939,
      "text": " إذا شهِد الرجلُ خمسَ شهاداتٍ، فقد برئَ كلُّ واحدٍ من الآخرِ، وعِدَّتُها إن كانت حاملًا أن تضعَ حملَها، ولا يُجلَدُ واحدٌ منهما، وإن لم تحلفْ ",
      "markers": []
    },
    {
      "id": "s158",
      "start": 11957,
      "end": 11970,
      "text": " أُقيم عليها ",
      "markers": []
    },
    {
      "id": "s159",
      "start": 11992,
      "end": 12008,
      "text": " الحدُّ والرجمُ ",
      "markers": []
    },
    {
      "id": "s160",
      "start": 12036,
      "end": 12038,
      "text": ". ",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [

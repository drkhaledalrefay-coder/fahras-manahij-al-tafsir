        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 10034,
          "end": 10081,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s136"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 10042,
          "end": 10047,
          "span_id": "s136"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 10055,
          "end": 10062,
          "span_id": "s136"
        }
      ]
    },
    {
      "id": "s137",
      "start": 10081,
      "end": 10137,
      "text": " أخبَرنا الثوريُّ، عن ابن أبي نجيحٍ، عن مجاهدٍ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 10082,
          "end": 10089,
          "span_id": "s137"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10100,
          "end": 10137,
          "stripped": "عن ابن أبي نجيح، عن مجاهد في قوله:",
          "span_id": "s137"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 10121,
          "end": 10126,
          "span_id": "s137"
        }
      ]
    },
    {
      "id": "s138",
      "start": 10137,
      "end": 10196,
      "text": " {وَلْيَشْهَدْ عَذَابَهُمَا طَائِفَةٌ مِنَ الْمُؤْمِنِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10138,
          "end": 10195,
          "span_id": "s138"
        }
      ]
    },
    {
      "id": "s139",
      "start": 10196,
      "end": 10232,
      "text": " قال: الطائفةُ رجلٌ واحدٌ فما فوقَه ",
      "markers": []
    },
    {
      "id": "s140",
      "start": 10277,
      "end": 10320,
      "text": ".وقال آخرون: أقلُّه في هذا الموضعِ رَجُلان.",
      "markers": []
    },
    {
      "id": "s141",
      "start": 10320,
      "end": 10369,
      "text": "ذكرُ مَن قال ذلكحدَّثني يعقوبُ بنُ إبراهيمَ، قال:",
      "markers": []
    },
    {
      "id": "s142",
      "start": 10369,
      "end": 10411,
      "text": " ثنا ابن عُليَّةَ، قال: ثنا ابن أبي نجيحٍ ",
      "markers": []
    },
    {
      "id": "s143",
      "start": 10428,
      "end": 10497,
      "text": " في قولِه: {وَلْيَشْهَدْ عَذَابَهُمَا طَائِفَةٌ مِنَ الْمُؤْمِنِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10439,
          "end": 10496,
          "span_id": "s143"
        }
      ]
    },
    {
      "id": "s144",
      "start": 10497,
      "end": 10527,
      "text": " قال: قال عطاءٌ: أقلُّه رجلان ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 10507,
          "end": 10511,
          "span_id": "s144"
        }
      ]
    },
    {
      "id": "s145",
      "start": 10660,
      "end": 10700,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10661,
          "end": 10668,
          "span_id": "s145"
        }
      ]
    },
    {
      "id": "s146",
      "start": 10700,
      "end": 10732,
      "text": " ثني حجاجٌ، عن ابن جُرَيجٍ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 10715,
          "end": 10725,
          "span_id": "s146"
        }
      ]
    },
    {
      "id": "s147",
      "start": 10732,
      "end": 10798,
      "text": " أخبَرني عمرُ بنُ عطاءٍ، عن عِكرمةَ، قال: ليحضُرْ رَجلانِ فصاعدًا ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 10760,
          "end": 10766,
          "span_id": "s147"
        }
      ]
    },
    {
      "id": "s148",
      "start": 10846,
      "end": 10884,
      "text": ".وقال آخرون: أقلُّ ذلك ثلاثةٌ فصاعدًا.",
      "markers": []
    },
    {
      "id": "s149",
      "start": 10884,
      "end": 10921,
      "text": "ذكرُ مَن قال ذلكحدَّثنا القاسمُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10900,
          "end": 10907,
          "span_id": "s149"
        }
      ]
    },
    {
      "id": "s150",
      "start": 10921,
      "end": 11023,
      "text": " ثنا الحسينُ، قال: ثنا عيسى بنُ يونسَ، عن ابن أبي ذئبٍ، عن الزُّهريِّ، قال: الطائفةُ الثلاثةُ فصاعدًا ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10960,
          "end": 11013,
          "stripped": "عن ابن أبي ذئب، عن الزهري، قال: الطائفة الثلاثة",
          "span_id": "s150"
        }
      ]
    },
    {
      "id": "s151",
      "start": 11107,
      "end": 11143,
      "text": ".حدَّثنا محمدُ بنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11108,
          "end": 11115,
          "span_id": "s151"
        }
      ]
    },
    {
      "id": "s152",
      "start": 11143,
      "end": 11193,
      "text": " ثنا محمدُ بنُ ثورٍ، عن معمرٍ، عن قتادةَ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11164,
          "end": 11193,
          "stripped": "عن معمر، عن قتادة في قوله:",
          "span_id": "s152"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 11177,
          "end": 11182,
          "span_id": "s152"
        }
      ]
    },
    {
      "id": "s153",
      "start": 11193,
      "end": 11269,
      "text": " {وَلْيَشْهَدْ عَذَابَهُمَا طَائِفَةٌ مِنَ الْمُؤْمِنِينَ}. قال: نفَرٌ من ال",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11194,
          "end": 11251,
          "span_id": "s153"
        }
      ]
    },
    {
      "id": "s154",
      "start": 11273,
      "end": 11328,
      "text": "مسلمينَ.حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11281,
          "end": 11288,
          "span_id": "s154"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 11281,
          "end": 11328,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s154"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 11289,
          "end": 11294,
          "span_id": "s154"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 11302,
          "end": 11309,
          "span_id": "s154"
        }
      ]
    },
    {
      "id": "s155",
      "start": 11328,
      "end": 11360,
      "text": " أخبَرنا معمرٌ، عن قتادةَ مثلَه ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 11329,
          "end": 11336,
          "span_id": "s155"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 11347,
          "end": 11352,
          "span_id": "s155"
        }
      ]
    },
    {
      "id": "s156",
      "start": 11434,
      "end": 11485,
      "text": ".حدَّثني أبو السائبِ، قال: ثنا حفصُ بنُ غياثٍ، قال:",
      "markers": []
    },
    {
      "id": "s157",
      "start": 11485,
      "end": 11511,
      "text": " ثنا أشعتُ، عن أبيهِ، قال:",
      "markers": []
    },
    {
      "id": "s158",
      "start": 11511,
      "end": 11572,
      "text": " أتيتُ أبا بَرْزَةَ الأسلميَّ في حاجةٍ، وقد أخرَج جاريةً إلى ",
      "markers": []
    },
    {
      "id": "s159",
      "start": 11583,
      "end": 11584,
      "text": " ",
      "markers": []
    },
    {
      "id": "s160",
      "start": 11602,
      "end": 11632,
      "text": "، وقد زنَتْ، فدعا رجلًا، فقال:",
      "markers": []
    },
    {
      "id": "s161",
      "start": 11632,
      "end": 11670,
      "text": " اضرِبْها خمسينَ. فدعا جماعةً، ثم قرأ:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 11666,
          "end": 11669,
          "span_id": "s161"
        }
      ]
    },
    {
      "id": "s162",
      "start": 11670,
      "end": 11729,
      "text": " {وَلْيَشْهَدْ عَذَابَهُمَا طَائِفَةٌ مِنَ الْمُؤْمِنِينَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11671,
          "end": 11728,
          "span_id": "s162"
        }
      ]
    },
    {
      "id": "s163",
      "start": 11871,
      "end": 11905,
      "text": ".حدَّثنا أبو هشامٍ الرفاعيُّ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11872,
          "end": 11879,
          "span_id": "s163"
        }
      ]
    },
    {
      "id": "s164",
      "start": 11905,
      "end": 12024,
      "text": " ثنا يحيى، عن أشعثَ، عن أبيهِ، أَنَّ أَبا بَرْزَةَ أَمَر ابنَه أن يضرِبَ جاريةً له وَلَدَتْ من الزنى ضربًا غير مبرِّحٍ.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11916,
          "end": 11954,
          "stripped": "عن أشعث، عن أبيه، أن أبا برزة",
          "span_id": "s164"
        }
      ]
    },
    {
      "id": "s165",
      "start": 12024,
      "end": 12066,
      "text": " قال: فألقَى عليها ثوبًا وعنده قومٌ، وقرأ ",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 12062,
          "end": 12065,
          "span_id": "s165"
        }
      ]
    },
    {
      "id": "s166",
      "start": 12116,
      "end": 12163,
      "text": ": {وَلْيَشْهَدْ عَذَابَهُمَا} الآية.وقال آخرون:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12118,
          "end": 12145,
          "span_id": "s166"
        }
      ]
    },
    {
      "id": "s167",
      "start": 12163,
      "end": 12219,
      "text": " بل أقلُّ ذلك أربعةٌ.ذكرُ مَن قال ذلكحدَّثني يونسُ، قال:",
      "markers": []
    },
    {
      "id": "s168",
      "start": 12219,
      "end": 12293,
      "text": " أخبَرنا ابن وهبٍ قال: قال ابن زيدٍ في قولِه: {وَلْيَشْهَدْ عَذَابَهُمَا ط",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 12220,
          "end": 12227,
          "span_id": "s168"
        },
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 12246,
          "end": 12253,
          "span_id": "s168"
        }
      ]
    },
    {
      "id": "s169",
      "start": 12297,
      "end": 12353,
      "text": "َائِفَةٌ مِنَ الْمُؤْمِنِينَ}. قال: فقال: الطائفةُ التي ",
      "markers": []
    },
    {
      "id": "s170",
      "start": 12373,
      "end": 12384,
      "text": " يَجبُ بها ",
      "markers": []
    },
    {
      "id": "s171",
      "start": 12413,
      "end": 12428,
      "text": " الحدُّ أربعةٌ ",
      "markers": []
    },
    {
      "id": "s172",
      "start": 12476,
      "end": 12521,
      "text": ".وأولى الأقوالِ في ذلك بالصوابِ قولُ مَن قال:",
      "markers": []
    },
    {
      "id": "s173",
      "start": 12521,
      "end": 12567,
      "text": " أقلُّ ما ينبغِى حضورُ ذلك من عَددِ المسلمينَ:",
      "markers": []
    },
    {
      "id": "s174",
      "start": 12567,
      "end": 12613,
      "text": " الواحدُ فصاعدًا. وذلك أَنَّ الله عمَّ بقولِه:",
      "markers": []
    },
    {
      "id": "s175",
      "start": 12613,
      "end": 12709,
      "text": " {وَلْيَشْهَدْ عَذَابَهُمَا طَائِفَةٌ}. والطائفةُ قد تقعُ عندَ العربِ على الواحدِ فصاعدًا. فإذا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12614,
          "end": 12651,
          "span_id": "s175"
        }
      ]
    },
    {
      "id": "s176",
      "start": 12723,
      "end": 12937,
      "text": " كان ذلك كذلك، ولم يكنِ اللهُ تعالى ذكرُه وضَع دلالةً على أنَّ مرادَه من ذلك خاصٌّ من العددِ - كان معلومًا أنَّ حُضورَ ما وقَع عليه أدنى اسمِ الطائفةِ ذلك المحضرَ مُخرِجٌ مُقيمَ الحدَّ ممَّا أمَره اللهُ بهِ بقولِه:",
      "markers": []
    },
    {
      "id": "s177",
      "start": 12937,
      "end": 12996,
      "text": " {وَلْيَشْهَدْ عَذَابَهُمَا طَائِفَةٌ مِنَ الْمُؤْمِنِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12938,
          "end": 12995,
          "span_id": "s177"
        }
      ]
    },
    {
      "id": "s178",
      "start": 12996,
      "end": 13141,
      "text": " غيرَ أَنِّي وإن كان الأمرُ على ما وصَفتُ، أستحِبُّ ألا يُقصَّرَ بعددِ من يحضُرُ ذلك الموضعَ عن أربعةِ أنفسٍ، عددِ مَن تُقبَلُ شهادتُه على الزنى؛",
      "markers": []
    },
    {
      "id": "s179",
      "start": 13141,
      "end": 13264,
      "text": " لأنَّ ذلك إذا كان كذلك، فلا خلافَ بينَ الجميعِ أنَّه قد أدَّى المقيمُ الحدَّ ما عليهِ في ذلك، وهم فيما دونَ ذلك مختلفونَ. ",
      "markers": []
    }
  ],

    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 289,
      "text": " {لَا تَجْعَلُوا دُعَاءَ الرَّسُولِ بَيْنَكُمْ كَدُعَاءِ بَعْضِكُمْ بَعْضًا قَدْ يَعْلَمُ اللَّهُ الَّذِينَ يَتَسَلَّلُونَ مِنْكُمْ لِوَاذًا فَلْيَحْذَرِ الَّذِينَ يُخَالِفُونَ عَنْ أَمرِهِ أَنْ تُصِيبَهُمْ فِتْنَةٌ أَوْ يُصِيبَهُمْ عَذَابٌ أَلِيمٌ (63)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 288,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 289,
      "end": 351,
      "text": "يقولُ تعالى ذكرُه لأصحابِ نبيِّه محمدٍ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 330,
          "end": 348,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 351,
      "end": 444,
      "text": " لا تَجْعَلُوا أَيُّها المؤمنون {دُعَاءَ الرَّسُولِ بَيْنَكُمْ كَدُعَاءِ بَعْضِكُمْ بَعْضًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 383,
          "end": 443,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 444,
      "end": 478,
      "text": "واختَلف أهلُ التأويلِ في معنى ذلك؛",
      "markers": []
    },
    {
      "id": "s006",
      "start": 478,
      "end": 566,
      "text": " فقال بعضُهم: نَهَى اللهُ بهذه الآيةِ المؤمنين أن يَتعرَّضوا لدعاءِ الرسولِ عليهم، وقال ",
      "markers": []
    },
    {
      "id": "s007",
      "start": 583,
      "end": 588,
      "text": " لهم ",
      "markers": []
    },

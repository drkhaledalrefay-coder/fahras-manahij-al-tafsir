    },
    {
      "id": "s035",
      "start": 2755,
      "end": 2795,
      "text": " من تَعْظيمِه وتوقيرِه بالقولِ والدعاءِ.",
      "markers": []
    },
    {
      "id": "s036",
      "start": 2795,
      "end": 2870,
      "text": "وقولُه: {قَدْ يَعْلَمُ اللَّهُ الَّذِينَ يَتَسَلَّلُونَ مِنْكُمْ لِوَاذًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2803,
          "end": 2869,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 2870,
      "end": 2952,
      "text": " يقولُ تعالى ذكرُه: إنكم أيُّها المُنصرِفون عن نبيِّكم بغيرِ إِذْنِهِ، تَسَتُّرًا ",
      "markers": []
    },
    {
      "id": "s038",
      "start": 2989,
      "end": 3076,
      "text": " وخُفْيَةً منه، وإن خَفِي أمرُ مَن يفعلُ ذلك منكم على رسولِ اللهِ - صلى الله عليه وسلم ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3057,
          "end": 3075,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 3080,
      "end": 3128,
      "text": "-، فإن الله يعلمُ ذلك ولا يخفَى عليه، فليَتَّقِ ",
      "markers": []
    },
    {
      "id": "s040",
      "start": 3150,
      "end": 3362,
      "text": " مَن يفعلُ ذلك منكم، الذين يُخالفِون أمرَ اللهِ في الانْصرافِ عن رسولِ اللهِ - صلى الله عليه وسلم - إلا بإذْنِه - أن تُصِيبَهم فتنةٌ مِن اللهِ، أو يُصِيبَهم عذابٌ أَلِيمٌ، فيُطْبَعَ على قلوبِهم، فيكفَّروا باللهِ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3229,
          "end": 3247,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 3362,
      "end": 3405,
      "text": "وبنحوِ الذي قُلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3405,
      "end": 3444,
      "text": "ذكرُ مَن قال ذلكحدَّثنا ابن حميدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3421,
          "end": 3428,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3444,
      "end": 3471,
      "text": " ثنا الحكمُ بنُ بشيرٍ، قال:",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3471,
      "end": 3495,
      "text": " ثنا عمرُو بنُ قيسٍ، عن ",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3509,
      "end": 3547,
      "text": " جُوَيبرٍ، عن الضحاكِ في قولِ اللَّهِ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "NARRATOR",
          "start": 3523,
          "end": 3529,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3547,
      "end": 3621,
      "text": " {قَدْ يَعْلَمُ اللَّهُ الَّذِينَ يَتَسَلَّلُونَ مِنْكُمْ لِوَاذًا}. قال: ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3548,
          "end": 3614,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3637,
      "end": 3638,
      "text": " ",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3658,
      "end": 3765,
      "text": " بعضُهم ببعضٍ، فيقومون، فقال: {فَلْيَحْذَرِ الَّذِينَ يُخَالِفُونَ عَنْ أَمرِهِ أَنْ تُصِيبَهُمْ فِتْنَةٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3688,
          "end": 3764,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3765,
      "end": 3803,
      "text": " قال: يُطبَعُ على قلبِه، فلا يُؤْمَنُ ",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3823,
      "end": 3861,
      "text": " أن يُظهِرَ الكفرَ بلسانِه، فتُضْرَبَ ",
      "markers": []
    },
    {
      "id": "s051",
      "start": 3887,
      "end": 3896,
      "text": " عُنُقُه ",
      "markers": []
    },
    {
      "id": "s052",
      "start": 3947,
      "end": 3987,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3948,
          "end": 3955,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 3987,
      "end": 4029,
      "text": " ثني حجاجٌ، عن ابن جريجٍ، عن مجاهدٍ قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3999,
          "end": 4029,
          "stripped": "عن ابن جريج، عن مجاهد قوله:",
          "span_id": "s053"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 4002,
          "end": 4010,
          "span_id": "s053"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 4016,
          "end": 4021,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4029,
      "end": 4100,
      "text": " {قَدْ يَعْلَمُ اللَّهُ الَّذِينَ يَتَسَلَّلُونَ مِنْكُمْ لِوَاذًا}. قا",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4030,
          "end": 4096,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4104,
      "end": 4115,
      "text": "ل: خِلافًا ",
      "markers": []
    },
    {
      "id": "s056",
      "start": 4209,
      "end": 4252,
      "text": ".حدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4230,
          "end": 4237,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4252,
      "end": 4275,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 4257,
          "end": 4264,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4275,
      "end": 4343,
      "text": " {قَدْ يَعْلَمُ اللَّهُ الَّذِينَ يَتَسَلَّلُونَ مِنْكُمْ لِوَاذًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4276,
          "end": 4342,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4343,
      "end": 4426,
      "text": " قال: هؤلاء المُنافقون الذين يرجِعون بغيرِ إذنِ رسولِ اللهِ - صلى الله عليه وسلم -.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4405,
          "end": 4423,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4426,
      "end": 4560,
      "text": " قال: اللِّواذُ: يلوذُ عنه ويروغُ ويذهبُ بغيرِ إذنِ النبيِّ - صلى الله عليه وسلم - {فَلْيَحْذَرِ الَّذِينَ يُخَالِفُونَ عَنْ أَمرِهِ}:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4488,
          "end": 4506,
          "span_id": "s060"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4509,
          "end": 4559,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4560,
      "end": 4663,
      "text": " الذين يصنَعون هذا، {أَنْ تُصِيبَهُمْ فِتْنَةٌ أَوْ يُصِيبَهُمْ عَذَابٌ أَلِيمٌ}. الفتنةُ هاهنا الكفرُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4580,
          "end": 4640,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4753,
      "end": 4810,
      "text": ".واللِّواذُ مصدرُ: لَاوَذْتُ بفلانٍ مُلَاوَذةٌ ولِوَاذًا.",
      "markers": []
    },
    {
      "id": "s063",
      "start": 4810,
      "end": 4873,
      "text": " ولذلك ظهَرت الواوُ. ولو كان مصدرًا لـ \"لُذْتُ\" لقيل: لِيَاذًا ",
      "markers": []
    },
    {
      "id": "s064",
      "start": 4896,
      "end": 4924,
      "text": ". كما يقالُ: قُمْتُ قِيامًا.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 4902,
          "end": 4906,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4924,
      "end": 4967,
      "text": " وإذا قيل: قَاوَمْتُك. قيل: قِوامًا طويلًا.",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4967,
      "end": 5011,
      "text": "واللِّوَاذُ هو أن يلوذَ القومُ بعضُهم ببعضٍ؛",
      "markers": []
    },
    {
      "id": "s067",
      "start": 5011,
      "end": 5056,
      "text": " يستترُ هذا بهذا، وهذا بهذا، كما قال الضحاكُ.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 5048,
          "end": 5054,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 5056,
      "end": 5099,
      "text": "وقولُه: {أَوْ يُصِيبَهُمْ عَذَابٌ أَلِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5064,
          "end": 5098,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 5099,
      "end": 5124,
      "text": " يقولُ: أو يصيبَهم في عاج",
      "markers": []
    },
    {
      "id": "s070",
      "start": 5128,
      "end": 5174,
      "text": "لِ الدنيا عذابٌ مِن اللهِ موجِعٌ، على صنيعِهم ",
      "markers": []
    },
    {
      "id": "s071",
      "start": 5200,
      "end": 5215,
      "text": " ذلك، وخلافِهم ",
      "markers": []
    },
    {
      "id": "s072",
      "start": 5244,
      "end": 5285,
      "text": " أمرَ رسولِ اللهِ - صلى الله عليه وسلم -.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5264,
          "end": 5282,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 5285,
      "end": 5344,
      "text": "وقولُه: {فَلْيَحْذَرِ الَّذِينَ يُخَالِفُونَ عَنْ أَمرِهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5293,
          "end": 5343,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 5344,
      "end": 5404,
      "text": " وأُدخلت {عَنْ} لأن معنى الكلامِ: فليَحْذَرِ الذين يَلوذُون ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5353,
          "end": 5359,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 5422,
      "end": 5458,
      "text": " عن أمرِه، ويُدْبِرون عنه مُعرضِين. ",
      "markers": []
    }
  ],

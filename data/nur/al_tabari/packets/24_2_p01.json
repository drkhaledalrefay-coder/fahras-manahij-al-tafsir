  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 286,
      "text": " {الزَّانِيَةُ وَالزَّانِي فَاجْلِدُوا كُلَّ وَاحِدٍ مِنْهُمَا مِائَةَ جَلْدَةٍ وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللَّهِ إِنْ كُنْتُمْ تُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَلْيَشْهَدْ عَذَابَهُمَا طَائِفَةٌ مِنَ الْمُؤْمِنِينَ (2)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 285,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 286,
      "end": 366,
      "text": "يقولُ تعالى ذكرُه: مَن زنَى مِن الرجالِ، أو زنَتْ مِن النساءِ، وهو حُرٌّ بِكْرٌ ",
      "markers": []
    },
    {
      "id": "s004",
      "start": 388,
      "end": 437,
      "text": " غيرُ مُحْصَنٍ بزوجٍ، فاجلِدوه ضربًا مائةَ جلدةٍ؛",
      "markers": []
    },
    {
      "id": "s005",
      "start": 437,
      "end": 534,
      "text": " عقوبةً لِما صنَع، وأتَى مِن معصيةِ اللهِ، {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 480,
          "end": 533,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 534,
      "end": 566,
      "text": " يقولُ تعالى ذكرُه: لا تأخذْكُم ",
      "markers": []
    },
    {
      "id": "s007",
      "start": 598,
      "end": 647,
      "text": " بالزاني والزانيةِ، أيُّها المؤمنونَ، {رَأْفَةٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 636,
          "end": 646,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 647,
      "end": 684,
      "text": " وهى رقةُ الرحمةِ، {فِي دِينِ اللهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 666,
          "end": 683,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 684,
      "end": 768,
      "text": " يعني: في طاعةِ اللهِ فيما أَمَرَكُم بِهِ مِن إقامةِ الحدِّ عليهما، على ما ألزَمكُم ",
      "markers": []
    },
    {
      "id": "s010",
      "start": 790,
      "end": 828,
      "text": " به.واختلَف أهلُ التأويلِ في المنهيِّ ",
      "markers": []
    },
    {
      "id": "s011",
      "start": 851,
      "end": 884,
      "text": " عنه المؤمنونَ مِن أخْذِ الرأفةِ ",
      "markers": []
    },
    {
      "id": "s012",
      "start": 903,
      "end": 931,
      "text": " بهما؛ فقال بعضُهم: هو تركُ ",
      "markers": []
    },
    {
      "id": "s013",
      "start": 945,
      "end": 1015,
      "text": " إقامة حدِّ اللهِ عليهما، فأمَّا إذا أُقيم عليهما الحدُّ، فلم تأخذْهم ",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1057,
      "end": 1083,
      "text": " بهما رأفةٌ في دينِ اللهِ.",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1083,
      "end": 1123,
      "text": " ذكرُ مَن قال ذلكحدَّثنا أبو هشامٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1100,
          "end": 1107,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1123,
      "end": 1198,
      "text": " ثنا يحيى بنُ أبى زَائدةً، عن نافعِ بن عمرَ، عن ابن أبي مُلَيكةَ، عن عبيدِ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1150,
          "end": 1191,
          "stripped": "عن نافع بن عمر، عن ابن أبي مليكة، عن",
          "span_id": "s016"
        },
        {
          "family": "SAHABA",
          "marker": "عمر",
          "name": "عمر",
          "role": "NARRATOR",
          "start": 1162,
          "end": 1165,
          "span_id": "s016"
        }
      ]
    },
    {
      "id": "s017",
      "start": 1225,
      "end": 1259,
      "text": " اللهِ بن عبدِ اللهِ بن عمرَ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عمر",
          "name": "عمر",
          "role": "SPEAKER",
          "start": 1249,
          "end": 1252,
          "span_id": "s017"
        }
      ]
    },
    {
      "id": "s018",
      "start": 1259,
      "end": 1294,
      "text": " جَلَدَ ابن عمرَ جاريةً له أحدَثتْ؛",
      "markers": []
    },
    {
      "id": "s019",
      "start": 1294,
      "end": 1339,
      "text": " فجلد رِجلَيها. قال نافعٌ: وحسِبتُ أنَّه قال:",
      "markers": []
    },
    {
      "id": "s020",
      "start": 1339,
      "end": 1413,
      "text": " وظهْرَها. فقلتُ: {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللَّهِ}.",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 1351,
          "end": 1354,
          "span_id": "s020"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1357,
          "end": 1412,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 1413,
      "end": 1482,
      "text": " فقال: وأخَذتْنى بها رأفةٌ! إِنَّ الله لَم يَأْمُرْنِى أَنْ أقتُلَها ",
      "markers": []
    },
    {
      "id": "s022",
      "start": 1602,
      "end": 1660,
      "text": ".حدَّثني يعقوبُ، قال: ثنا ابن عُليَّةَ، عن ابن جريجٍ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 1645,
          "end": 1653,
          "span_id": "s022"
        }
      ]
    },
    {
      "id": "s023",
      "start": 1660,
      "end": 1712,
      "text": " سمِعتُ عبدَ اللهِ بنَ أبي مُليكةَ يقولُ: ثنى عبيدُ ",
      "markers": []
    },
    {
      "id": "s024",
      "start": 1734,
      "end": 1853,
      "text": " اللهِ بنُ عبدِ اللهِ بن عمرَ، أَنَّ عبدَ اللهِ بنَ عمرَ حدَّ جاريةً له، فقال للجالدِ، وأشار إلى رِجلِها، وإلى أسفلِها.",
      "markers": []
    },
    {
      "id": "s025",
      "start": 1853,
      "end": 1949,
      "text": " قلت: فأينَ قولُ اللهِ: {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللَّهِ} قال: أفأقتُلُها ",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 1854,
          "end": 1857,
          "span_id": "s025"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1877,
          "end": 1932,
          "span_id": "s025"
        }
      ]
    },
    {
      "id": "s026",
      "start": 2019,
      "end": 2052,
      "text": "؟!حدَّثنا ابن بشَّارٍ، قال: ثنا ع",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2021,
          "end": 2028,
          "span_id": "s026"
        }
      ]
    },
    {
      "id": "s027",
      "start": 2056,
      "end": 2114,
      "text": "بدُ الرحمنِ، قال: ثنا سفيانُ، عن ابن أبي نجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2086,
          "end": 2114,
          "stripped": "عن ابن أبي نجيح، عن مجاهد:",
          "span_id": "s027"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 2107,
          "end": 2112,
          "span_id": "s027"
        }
      ]
    },
    {
      "id": "s028",
      "start": 2114,
      "end": 2171,
      "text": " (وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللَّهِ).",
      "markers": []
    },
    {
      "id": "s029",
      "start": 2171,
      "end": 2214,
      "text": " قال: أن تقيمَ الحدَّ.حدَّثنا القاسمُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2193,
          "end": 2200,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 2214,
      "end": 2247,
      "text": " ثنا الحسينُ، قال: ثني حجاجٌ، عن ",
      "markers": []
    },
    {
      "id": "s031",
      "start": 2259,
      "end": 2329,
      "text": " ابن جُرَيجٍ: {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللَّهِ}.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 2260,
          "end": 2270,
          "span_id": "s031"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2273,
          "end": 2328,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2329,
      "end": 2360,
      "text": " قال: لا تُضيِّعوا حدودَ اللهِ.",
      "markers": []
    },
    {
      "id": "s033",
      "start": 2360,
      "end": 2387,
      "text": "قال ابن جريجٍ: وقال مجاهدٌ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 2364,
          "end": 2372,
          "span_id": "s033"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 2380,
          "end": 2385,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 2387,
      "end": 2493,
      "text": " {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ}: لا تُضيِّعوا الحدودَ في أن تُقيمُوها، وقالها عطاءُ بنُ أبي رَباحٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2388,
          "end": 2425,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2550,
      "end": 2551,
      "text": ".",
      "markers": []
    },
    {
      "id": "s036",
      "start": 2599,
      "end": 2600,
      "text": " ",
      "markers": []
    },
    {
      "id": "s037",
      "start": 2737,
      "end": 2805,
      "text": "، عن عطاءٍ: {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللَّهِ}.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 2742,
          "end": 2746,
          "span_id": "s037"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2749,
          "end": 2804,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 2805,
      "end": 2854,
      "text": " قال: يقامُ حدُّ اللهِ ولا يُعطَّلُ، وليس بالقتل ",
      "markers": []
    },
    {
      "id": "s039",
      "start": 3053,
      "end": 3076,
      "text": ".حدَّثنا ابن المثنَّى، ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3054,
          "end": 3061,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3080,
      "end": 3147,
      "text": "قال: ثنا محمدُ بنُ فضيلٍ، عن داودَ، عن سعيدِ بن جبيرٍ، قال: الجلدُ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3106,
          "end": 3139,
          "stripped": "عن داود، عن سعيد بن جبير، قال:",
          "span_id": "s040"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 3119,
          "end": 3132,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 3209,
      "end": 3256,
      "text": ".حدَّثني عُبيدُ بنُ إسماعيلَ الهَبَّاريُّ، قال:",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3256,
      "end": 3311,
      "text": " ثنا محمدُ بن فضيلٍ، عن المغيرةِ، عن إبراهيمَ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3277,
          "end": 3311,
          "stripped": "عن المغيرة، عن إبراهيم في قوله:",
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3311,
      "end": 3380,
      "text": " {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللهِ}. قال: الضرْبُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3312,
          "end": 3365,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 3432,
      "end": 3462,
      "text": ".حدَّثنا ابن عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3433,
          "end": 3440,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3462,
      "end": 3501,
      "text": " ثنا المعتمرُ، قال: سمِعتُ عمرانَ، قال:",
      "markers": []
    },
    {
      "id": "s046",
      "start": 3501,
      "end": 3583,
      "text": " قلتُ لأبي مجلَزٍ: {الزَّانِيَةُ وَالزَّانِي فَاجْلِدُوا كُلَّ وَاحِدٍ مِنْهُمَا}.",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 3502,
          "end": 3505,
          "span_id": "s046"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3520,
          "end": 3582,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3583,
      "end": 3673,
      "text": " إلى قولِه: {وَالْيَوْمِ الْآخِر}. إنا لنرحَمُهم أن يُجلدَ الرجلُ حدًّا، أو تُقطَعَ يَدُه.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3595,
          "end": 3616,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3673,
      "end": 3764,
      "text": " قال: إنَّما ذاك أنَّه ليس للسلطانِ إذا رُفِعوا إليه أن يدعَهم رحمةً لهم حتى يُقيمَ الحدَّ ",
      "markers": []
    },
    {
      "id": "s049",
      "start": 3874,
      "end": 3904,
      "text": ".حدَّثنا الحسنُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3875,
          "end": 3882,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 3904,
      "end": 3987,
      "text": " أخبَرنا عبدُ الرزاقِ، قال: أخبَرنا الثوريُّ، عن ابن أبي نجيحٍ، عن مجاهدٍ في قولهِ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3905,
          "end": 3912,
          "span_id": "s050"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 3905,
          "end": 3956,
          "stripped": "أخبرنا عبد الرزاق، قال: أخبرنا الثوري، عن ابن",
          "span_id": "s050"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3932,
          "end": 3939,
          "span_id": "s050"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3950,
          "end": 3987,
          "stripped": "عن ابن أبي نجيح، عن مجاهد في قوله:",
          "span_id": "s050"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3971,
          "end": 3976,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3987,
      "end": 4068,
      "text": " {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللَّهِ}. قال: لا تُقامُ الحدودُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3988,
          "end": 4043,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4252,
      "end": 4295,
      "text": ".حدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4273,
          "end": 4280,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 4295,
      "end": 4318,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 4300,
          "end": 4307,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4318,
      "end": 4418,
      "text": " {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ}: فتَدَعُوهما مِن حدودِ اللهِ التي أمَر بها، وافترَضها عليهما.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4319,
          "end": 4356,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4418,
      "end": 4445,
      "text": "قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4423,
          "end": 4430,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4445,
      "end": 4533,
      "text": " أخبرنا ابن لهيعةَ، عن خالدِ بنِ أبي عمرانَ، أنَّه سأَل سليمانَ بنَ يسارٍ عن قولِ اللهِ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4446,
          "end": 4452,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4533,
      "end": 4591,
      "text": " {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللَّهِ}. ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4534,
          "end": 4589,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4607,
      "end": 4608,
      "text": " ",
      "markers": []
    },
    {
      "id": "s059",
      "start": 4661,
      "end": 4697,
      "text": " في العقوبةِ؟ قال: ذلك فيهما جميعًا.",
      "markers": []
    },
    {
      "id": "s060",
      "start": 4697,
      "end": 4744,
      "text": "حدَّثنا عمرُو بنُ عبدِ الحميدِ الأمُلِيُّ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4697,
          "end": 4704,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4744,
      "end": 4816,
      "text": " ثنا يحيى بنُ زكريَّا، عن عبدِ الملكِ بن أبي سليمانَ، عن عطاءٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 4801,
          "end": 4805,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4816,
      "end": 4874,
      "text": " {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللَّهِ}. ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4817,
          "end": 4872,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 4915,
      "end": 4916,
      "text": " ",
      "markers": []
    },
    {
      "id": "s064",
      "start": 4956,
      "end": 4994,
      "text": "، وليس بالقتلِ.حدَّثنا ابن حميدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4971,
          "end": 4978,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4994,
      "end": 5034,
      "text": " ثنا جريرٌ، عن عطاءٍ، عن عامرٍ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5006,
          "end": 5034,
          "stripped": "عن عطاء، عن عامر في قوله:",
          "span_id": "s065"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "NARRATOR",
          "start": 5009,
          "end": 5013,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 5034,
      "end": 5112,
      "text": " {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللَّهِ}. قال: الضربُ الشديدُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5035,
          "end": 5090,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 5211,
      "end": 5236,
      "text": ".وقال آخرون: بل معنى ذلك:",
      "markers": []
    },
    {
      "id": "s068",
      "start": 5236,
      "end": 5310,
      "text": " ولا تَأخُذكم بهما رأفةٌ فتُخَفِّفُوا الضربَ عنهما، ولكن أوجِعُوهما ضربًا.",
      "markers": []
    },
    {
      "id": "s069",
      "start": 5310,
      "end": 5350,
      "text": "ذكرُ مَن قال ذلكحدَّثنا ابن المثنى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5326,
          "end": 5333,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 5350,
      "end": 5374,
      "text": " ثنا يحيى بنُ أبى بكيرٍ ",
      "markers": []
    },
    {
      "id": "s071",
      "start": 5440,
      "end": 5502,
      "text": "، قال: ثنا أبو جعفرٍ، عن قَتادةَ، عن الحسنِ وسعيدِ بن المسيبِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5462,
          "end": 5502,
          "stripped": "عن قتادة، عن الحسن وسعيد بن المسيب:",
          "span_id": "s071"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 5465,
          "end": 5471,
          "span_id": "s071"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "NARRATOR",
          "start": 5477,
          "end": 5482,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 5502,
      "end": 5580,
      "text": " {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللَّهِ}. قال: الجلدُ الشديدٌ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5503,
          "end": 5558,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 5737,
      "end": 5791,
      "text": ".قال: ثنا محمدُ بنُ جعفرٍ، عن شعبةَ، عن حَمَّادٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5764,
          "end": 5791,
          "stripped": "عن شعبة، عن حماد، قال:",
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 5791,
      "end": 5866,
      "text": " يُحَدُّ القاذفُ والشاربُ وعليهما ثِيابُهما، وأمَّا الزانى فتُخلَعُ ثيابُه.",
      "markers": []
    },
    {
      "id": "s075",
      "start": 5866,
      "end": 5955,
      "text": " وتلَا هذه الآيةَ: {وَلَا تَأْخُذْكُمْ بِهِمَا رَأْفَةٌ فِي دِينِ اللَّهِ}. فقلتُ لحمادٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5885,
          "end": 5940,
          "span_id": "s075"
        },
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 5943,
          "end": 5946,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 5979,
      "end": 6021,
      "text": ": أهذا في الحكْمِ؟ قال: في الحكمِ والجلدِ ",
      "markers": []
    },
    {
      "id": "s077",
      "start": 6185,
      "end": 6233,
      "text": ".حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6186,
          "end": 6193,
          "span_id": "s077"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 6186,
          "end": 6233,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s077"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 6194,
          "end": 6199,
          "span_id": "s077"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6207,
          "end": 6214,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 6233,
      "end": 6268,
      "text": " أخبَرنا معمرٌ، عن الزُّهريِّ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6234,
          "end": 6241,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 6268,
      "end": 6329,
      "text": " يُجتهدُ في حدِّ الزانى والفِريةِ، ويُخفَّفُ في حدِّ الشرابِ ",
      "markers": []
    },
    {
      "id": "s080",
      "start": 6345,
      "end": 6399,
      "text": ". وقال قَتادةُ: يخففُ في الشرابِ، ويُجتهَدُ في الزاني ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 6352,
          "end": 6358,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 6448,
      "end": 6493,
      "text": ".وأولى القولينِ في ذلك بالصوابِ قولُ مَن قال:",
      "markers": []
    },
    {
      "id": "s082",
      "start": 6493,
      "end": 6590,
      "text": " معنى ذلك: ولا تأخُذْكم بهما رأفةٌ في إقامةِ حدِّ اللهِ عليهما، الذي افترَض عليكم إقامتَه عليهما.",
      "markers": []
    },
    {
      "id": "s083",
      "start": 6590,
      "end": 6634,
      "text": "وإنَّما قلْنا: ذلك أولى التأويلينِ بالصوابِ؛",
      "markers": []
    },
    {
      "id": "s084",
      "start": 6634,
      "end": 6681,
      "text": " لدلالةِ قولِ اللهِ بعدَه: {فِي دِينِ اللَّهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6661,
          "end": 6680,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 6681,
      "end": 6719,
      "text": " يعني: في طاعةِ اللهِ التي أمَركم بها.",
      "markers": []
    },
    {
      "id": "s086",
      "start": 6719,
      "end": 6806,
      "text": " ومعلومٌ أَنَّ دينَ اللهِ الذي أمَر بهِ في الزانيينِ إقامةُ الحدِّ عليهما، على ما أمَر ",
      "markers": []
    },
    {
      "id": "s087",
      "start": 6826,
      "end": 6897,
      "text": " مِن جلدِ كلِّ واحدٍ منهما مائةَ جَلدةٍ، مع أنَّ الشدَّةَ في الضربِ لا ",
      "markers": []
    },
    {
      "id": "s088",
      "start": 6917,
      "end": 7031,
      "text": " حدَّ لها يُوقَفُ عليه، وكلُّ ضرْبٍ أوجَع فهو شديدٌ، وليس للذي يُوجِعُ في الشدَّةِ حدٌّ لا زيادةَ فيهِ فيُؤمرَ به.",
      "markers": []
    },
    {
      "id": "s089",
      "start": 7031,
      "end": 7115,
      "text": " وغيرُ جائزٍ وصْفُه جلَّ ثناؤُه بأَنَّه أمَر بما لا سبيلَ للمأمورِ بهِ إلى معرِفتِه.",
      "markers": []
    },
    {
      "id": "s090",
      "start": 7115,
      "end": 7172,
      "text": " وإذا كان ذلك كذلك، فالذي للمأمورينَ (1) إلى معرفتِه السب",
      "markers": []
    },
    {
      "id": "s091",
      "start": 7176,
      "end": 7249,
      "text": "يلُ هو عددُ الجَلْدِ على ما أمَر بهِ، وذلك هو إقامةُ الحدِّ على ما قلْنا.",
      "markers": []
    },
    {
      "id": "s092",
      "start": 7249,
      "end": 7356,
      "text": "وللعربِ في الرأفةِ لغتانِ؛ الرأفةُ بتسكينِ الهمزةِ، والرآفةُ بمدِّها، كالسأمةِ والسآمةِ، والكأبةِ والكآبةِ.",
      "markers": []
    },
    {
      "id": "s093",
      "start": 7356,
      "end": 7416,
      "text": " وكأنَّ الرأفةَ المرةُ الواحدةُ، والرآفةَ المصدرُ، كما قِيل:",
      "markers": []
    },
    {
      "id": "s094",
      "start": 7416,
      "end": 7467,
      "text": " ضَؤُلَ ضآلةً، مِثل فَعُلَ فَعالةً، وقَبُح قَباحةً.",
      "markers": []
    },
    {
      "id": "s095",
      "start": 7467,
      "end": 7563,
      "text": "وقولُه: {إِنْ كُنْتُمْ تُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ}. يقولُ: إِنْ كُنتُم تصدِّقون ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7475,
          "end": 7533,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 7575,
      "end": 7576,
      "text": " ",
      "markers": []
    },
    {
      "id": "s097",
      "start": 7605,
      "end": 7631,
      "text": " ربِّكم، وباليومِ الآخرِ، ",
      "markers": []
    },
    {
      "id": "s098",
      "start": 7638,
      "end": 7639,
      "text": " ",
      "markers": []
    },
    {
      "id": "s099",
      "start": 7669,
      "end": 7813,
      "text": " فيه مبعوثُون لحشرِ القيامةِ، وللثوابِ والعقابِ، فإِنَّ مَن كان بذلك مُصدِّقًا، فإنَّه لا يخالفُ الله في أمرِه ونهيهِ، خوفَ عقابهِ على مَعاصيهِ.",
      "markers": []
    },
    {
      "id": "s100",
      "start": 7813,
      "end": 7879,
      "text": "وقولِه: {وَلْيَشْهَدْ عَذَابَهُمَا طَائِفَةٌ مِنَ الْمُؤْمِنِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7821,
          "end": 7878,
          "span_id": "s100"
        }
      ]
    },
    {
      "id": "s101",
      "start": 7879,
      "end": 7961,
      "text": " يقولُ تعالى ذكرُه: وليحضُرْ جَلدَ الزانيينِ البكْرَينِ وحدَّهما إذا أُقيم عليهما ",
      "markers": []
    },
    {
      "id": "s102",
      "start": 7993,
      "end": 8046,
      "text": "، طائفةٌ من المؤمنين.والعربُ تُسمِّى الواحدَ فما زاد:",
      "markers": []
    },
    {
      "id": "s103",
      "start": 8046,
      "end": 8125,
      "text": " طائفةً.وقولُه: {مِنَ الْمُؤْمِنِينَ}. يقولُ: مِن أهلِ الإيمانِ باللهِ ورسولِه.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8062,
          "end": 8083,
          "span_id": "s103"
        }
      ]
    },
    {
      "id": "s104",
      "start": 8125,
      "end": 8178,
      "text": "وقد اختلَف أهلُ التأويلِ في مبلغِ عددِ الطائفةِ الذي ",
      "markers": []
    },
    {
      "id": "s105",
      "start": 8196,
      "end": 8197,
      "text": " ",
      "markers": []
    }
  ],

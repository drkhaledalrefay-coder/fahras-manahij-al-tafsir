      "start": 2472,
      "end": 2565,
      "text": " {وَالَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ ثُمَّ لَمْ يَأْتُوا بِأَرْبَعَةِ شُهَدَاءَ} إلى قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2473,
          "end": 2554,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 2565,
      "end": 2657,
      "text": " {إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2566,
          "end": 2656,
          "span_id": "s036"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 2657,
          "end": 2670,
          "text": "[النور: 4، 5]",
          "via": "apparatus",
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 2670,
      "end": 2708,
      "text": ". فجعَل في هذه توبةً، وقال في الأُخرى:",
      "markers": []
    },
    {
      "id": "s038",
      "start": 2708,
      "end": 2776,
      "text": " {إِنَّ الَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ الْغَافِلَاتِ} إلى قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2709,
          "end": 2765,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 2776,
      "end": 2816,
      "text": " {وَلَهُمْ عَذَابٌ عَظِيمٌ}؟ قال ميمونٌ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2777,
          "end": 2803,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 2816,
      "end": 2904,
      "text": " أمَّا الأُولَى فعسَى أن تكونَ قد قارَفت، وأمَّا هذه، فهي التي لم تقارِفْ شيئًا مِن ذلك.",
      "markers": []
    },
    {
      "id": "s041",
      "start": 2904,
      "end": 2943,
      "text": "حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2904,
          "end": 2911,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 2943,
      "end": 2991,
      "text": " ثنا هشيمٌ، قال: أخبَرنا العوّامُ بنُ حوشبٍ، عن ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2960,
          "end": 2967,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3010,
      "end": 3011,
      "text": " ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3028,
      "end": 3076,
      "text": "، عن ابن عباسٍ، قال: فسَّر سورةَ \"النورِ\"، فلما ",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 3033,
          "end": 3041,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3080,
      "end": 3179,
      "text": "أتَى على هذه الآيةِ: {إِنَّ الَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ الْغَافِلَاتِ الْمُؤْمِنَاتِ} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3101,
          "end": 3172,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3179,
      "end": 3282,
      "text": " قال: هذا في شأنِ عائشةَ وأزواجِ النبيِّ - صلى الله عليه وسلم -، وهى مبهمةٌ، وليستْ لهم توبةٌ، ثم قرَأ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3222,
          "end": 3240,
          "span_id": "s046"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 3277,
          "end": 3281,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3282,
      "end": 3365,
      "text": " {وَالَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ ثُمَّ لَمْ يَأْتُوا بِأَرْبَعَةِ شُهَدَاءَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3283,
          "end": 3364,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3365,
      "end": 3442,
      "text": " إلى قولِه: {إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا} الآية.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3377,
          "end": 3435,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 3442,
      "end": 3500,
      "text": " قال: فجعلَ لهؤلاءِ توبةً، ولم يجعلْ لمن قذَف أولئك توبةً.",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3500,
      "end": 3590,
      "text": " قال: فهَمَّ بعضُ القومِ أن يقومَ إليه فيُقَبِّلَ رأسَه مِن حُسْنِ ما فسَّر سورةَ \"النور\" ",
      "markers": []
    },
    {
      "id": "s051",
      "start": 3732,
      "end": 3775,
      "text": ".حدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3753,
          "end": 3760,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 3775,
      "end": 3925,
      "text": " قال ابن زِيدٍ: {إِنَّ الَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ الْغَافِلَاتِ الْمُؤْمِنَاتِ لُعِنُوا فِي الدُّنْيَا وَالْآخِرَةِ وَلَهُمْ عَذَابٌ عَظِيمٌ}.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 3780,
          "end": 3788,
          "span_id": "s052"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3791,
          "end": 3924,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 3925,
      "end": 3967,
      "text": " قال: هذا في عائشةَ، ومَن صنَع هذا اليومَ ",
      "markers": []
    },
    {
      "id": "s054",
      "start": 3992,
      "end": 4054,
      "text": " في المسلماتِ، فله ما قال اللهُ، ولكنَّ عائشةَ كانت إمامَ ذلك ",
      "markers": []
    },
    {
      "id": "s055",
      "start": 4122,
      "end": 4281,
      "text": ".وقال آخرون: نزَلت هذه الآيةُ في أزواجِ النبيِّ - صلى الله عليه وسلم -، فكان ذلك كذلك حتى نزَلت الآيةُ التي في أوَّلِ السورةِ، فأوجَب الجَلْدَ وقَبِلَ التوبةَ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4172,
          "end": 4190,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4281,
      "end": 4326,
      "text": "ذِكرُ مَن قال ذلكحدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s057",
      "start": 4326,
      "end": 4355,
      "text": " ثنى أبي، قال: ثني عمِّي قال:",
      "markers": []
    },
    {
      "id": "s058",
      "start": 4355,
      "end": 4393,
      "text": " ثنى أبي، عن أبيه، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4365,
          "end": 4393,
          "stripped": "عن أبيه، عن ابن عباس قوله:",
          "span_id": "s058"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 4377,
          "end": 4385,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4393,
      "end": 4470,
      "text": " {إِنَّ الَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ الْغَافِلَاتِ الْمُؤْمِنَاتِ} إلى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4394,
          "end": 4465,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4470,
      "end": 4615,
      "text": " {عَذَابٌ عَظِيمٌ}. يعنى أزواجَ النبيِّ - صلى الله عليه وسلم -، رَماهنَّ أهلُ النفاقِ، فأوجَب اللهُ لهم اللعنةَ والغضبَ، وباءُوا بسخطٍ مِن اللهِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4471,
          "end": 4488,
          "span_id": "s060"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4512,
          "end": 4530,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4615,
      "end": 4679,
      "text": " فكان ذلك في أزواجِ النبيِّ صلى الله عليه وسلم، ثم نزَل بعد ذلك:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4643,
          "end": 4661,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4679,
      "end": 4771,
      "text": " {وَالَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ ثُمَّ لَمْ يَأْتُوا بِأَرْبَعَةِ شُهَدَاءَ} إلى قوله ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4680,
          "end": 4761,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 4801,
      "end": 4837,
      "text": ": {فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4803,
          "end": 4836,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 4837,
      "end": 4900,
      "text": " فأنزل اللهُ الجلدَ والتوبةَ، فالتوبةُ تُقبلُ، والشهادة تُردُّ ",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 4838,
          "end": 4843,
          "span_id": "s064"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 4838,
          "end": 4848,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4928,
      "end": 4986,
      "text": ".وأَوْلَى هذه الأقوالِ في ذلك عندِى بالصوابِ قولُ مَن قال:",
      "markers": []
    },
    {
      "id": "s066",
      "start": 4986,
      "end": 5087,
      "text": " نزَلت هذه الآيةُ في شأنِ عائشةَ، والحكمُ بها عامٌّ في كلِّ من كان بالصفةِ التي وصَفه اللهُ بها فيها.",
      "markers": []
    },
    {
      "id": "s067",
      "start": 5087,
      "end": 5124,
      "text": "وإنما قلنا: ذلك أولى تأويلاتِه بالصوا",
      "markers": []
    },
    {
      "id": "s068",
      "start": 5128,
      "end": 5158,
      "text": "بِ؛ لأنَّ اللَّهَ عمَّ بقولِه:",
      "markers": []
    },
    {
      "id": "s069",
      "start": 5158,
      "end": 5508,
      "text": " {إِنَّ الَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ الْغَافِلَاتِ الْمُؤْمِنَاتِ} كلَّ محصنةٍ غافلةٍ مؤمنةٍ، رَماها رامٍ بالفاحشةِ، مِن غيرِ أن يخصَّ بذلك بعضًا دونَ بعضٍ، فكلُّ رامٍ محصنةً بالصفةِ التي ذكَر اللهُ جلَّ ثناؤُه في هذه الآيةِ، فملعونٌ في الدنيا والآخرةِ، وله عذابٌ عظيمٌ، إلا أن يتوبَ من ذنبِه ذلك قبلَ وفاتِه، فإنَّ الله دلَّ باستثنائِه بقولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5159,
          "end": 5230,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 5508,
      "end": 5663,
      "text": " {إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا} على أنَّ ذلك حكمُ رامى كلِّ محصنةٍ بأيِّ صفةٍ كانت المحصنةُ المؤمنةُ المرميَّةُ، وعلى أن قولَه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5509,
          "end": 5567,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 5663,
      "end": 5734,
      "text": " {لُعِنُوا فِي الدُّنْيَا وَالْآخِرَةِ وَلَهُمْ عَذَابٌ عَظِيمٌ} معناه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5664,
          "end": 5727,
          "span_id": "s071"
        },
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 5728,
          "end": 5733,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 5734,
      "end": 5766,
      "text": " لهم ذلك إن هلَكوا ولم يَتوبوا. ",
      "markers": []
    }
  ],

    },
    {
      "id": "s017",
      "start": 1158,
      "end": 1236,
      "text": " قالت: فبينما رسولُ اللهِ - صلى الله عليه وسلم - عندى جالسٌ، إذ أُوحِيَ إليه، ",
      "markers": [
        {
          "family": "HADITH",

        {
          "family": "RAY",
          "marker": "قلت",
          "start": 785,
          "end": 788,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 807,
      "end": 838,
      "text": " الزنى أشدُّ أم قذفُ المحصنَةِ؟",
      "markers": []
    },
    {
      "id": "s011",
      "start": 838,
      "end": 876,
      "text": " فقال: الزني. فقلتُ: أليس يقولُ اللهُ:",

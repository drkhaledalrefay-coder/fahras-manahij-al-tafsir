        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 174,
      "text": " {إِنَّ الَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ الْغَافِلَاتِ الْمُؤْمِنَاتِ لُعِنُوا فِي الدُّنْيَا وَالْآخِرَةِ وَلَهُمْ عَذَابٌ عَظِيمٌ (23)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 173,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 174,
      "end": 395,
      "text": "يقولُ تعالى ذِكرُه: {إِنَّ الَّذِينَ يَرْمُونَ} بالفاحشةِ {الْمُحْصَنَاتِ}، يَعْنى العفيفاتِ، {الْغَافِلَاتِ} عن الفواحشِ، {الْمُؤْمِنَاتِ} باللهِ ورسولِه وما جاء به مِن عندِ اللهِ، {لُعِنُوا فِي الدُّنْيَا وَالْآخِرَةِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 194,
          "end": 221,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 232,
          "end": 248,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 268,
          "end": 283,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 297,
          "end": 313,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 356,
          "end": 394,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 395,
      "end": 506,
      "text": " يقولُ: أُبْعِدوا من رحمةِ اللَّهِ في الدنيا والآخرةِ {وَلَهُمْ} في الآخرةِ {عَذَابٌ عَظِيمٌ} وذلك عذابُ جهنمَ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 449,
          "end": 459,
          "span_id": "s004"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 471,
          "end": 488,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 506,
      "end": 561,
      "text": "واختلَف أهلُ التأويلِ في المحصناتِ اللاتى هذا حكمُهنَّ؛",
      "markers": []
    },
    {
      "id": "s006",
      "start": 561,
      "end": 685,
      "text": " فقال بعضُهم: إنما ذلك لعائشة خاصةً، وحكمٌ مِن اللهِ فيها وفى من رماها، دون سائرِ نساءِ أمةِ نبيِّنا - صلى الله عليه وسلم -.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 664,
          "end": 682,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 685,
      "end": 732,
      "text": "ذِكرُ مَن قال ذلكحدَّثنا ابن أبى الشواربِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 702,
          "end": 709,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 732,
      "end": 765,
      "text": " ثنا عبدُ الواحدِ بنُ زيادٍ، قال:",
      "markers": []
    },
    {
      "id": "s009",
      "start": 765,
      "end": 807,
      "text": " ثنا حُصَيْفٌ، قال: قلتُ لسعيدِ بن جُبيرٍ:",

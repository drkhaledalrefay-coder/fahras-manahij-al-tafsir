    {
      "id": "s020",
      "start": 1467,
      "end": 1524,
      "text": " كانت جاريةٌ لعبدِ اللهِ بن أبيٍّ ابن سَلُولَ، يقالُ لها:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 1514,
          "end": 1518,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 1524,
      "end": 1574,
      "text": " مُسَيْكةُ. فآجَرها، أو أكْرَهها - الطبريُّ يشكُّ ",
      "markers": []
    },
    {
      "id": "s022",
      "start": 1587,
      "end": 1658,
      "text": " - فأتَتِ النبيَّ - صلى الله عليه وسلم - فشكَت ذلك إليه، فأَنْزَل الله:",
      "markers": [

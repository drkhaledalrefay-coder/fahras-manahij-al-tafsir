  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 33,
      "text": " القولُ في تأويلِ قوله تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 32,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 33,
      "end": 236,
      "text": " {وَلَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ إِنْ أَرَدْنَ تَحَصُّنًا لِتَبْتَغُوا عَرَضَ الْحَيَاةِ الدُّنْيَا وَمَنْ يُكْرِهْهُنَّ فَإِنَّ اللَّهَ مِنْ بَعْدِ إِكْرَاهِهِنَّ غَفُورٌ رَحِيمٌ (33)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 34,
          "end": 235,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 236,
      "end": 374,
      "text": "يقولُ تعالى ذكرُه: زوَّجُوا الصالحين من عبادِكم وإمائِكم، ولا تُكْرِهُوا إماءَكم {عَلَى الْبِغَاءِ} وهو الزنى، {إِنْ أَرَدْنَ تَحَصُّنًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 317,
          "end": 335,
          "span_id": "s003"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 347,
          "end": 373,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 374,
      "end": 411,
      "text": " يقولُ: إن أرَدْنَ تعفُّفًا عن الزنى ",
      "markers": []
    },
    {
      "id": "s005",
      "start": 431,
      "end": 477,
      "text": "، {لِتَبْتَغُوا عَرَضَ الْحَيَاةِ الدُّنْيَا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 433,
          "end": 476,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 477,
      "end": 554,
      "text": " يقولُ: لتَلتَمِسوا بإكراهِكم إياهن على الزنى {عَرَضَ الْحَيَاةِ الدُّنْيَا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 523,
          "end": 553,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 554,
      "end": 589,
      "text": " وذلك ما تَعْرِضُ لهم إليه الحاجةُ؛",
      "markers": []
    },
    {
      "id": "s008",
      "start": 589,
      "end": 646,
      "text": " مِن رِياشِها وزينتِها وأموالِها، {وَمَنْ يُكْرِهْهُنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 623,
          "end": 645,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 646,
      "end": 736,
      "text": " يقولُ: ومَن يُكْرِهْ فتياتِه على البِغاءِ، فإِن الله مِن بعدِ إكراهِه إياهن على ذلك، لهن ",
      "markers": []
    },
    {
      "id": "s010",
      "start": 754,
      "end": 804,
      "text": " غفورٌ رحيمٌ، ووِزْرُ ما كان مِن ذلك عليهم دونَهن.",
      "markers": []
    },
    {
      "id": "s011",
      "start": 804,
      "end": 919,
      "text": "وذُكِر أن هذه الآيةَ أُنْزِلَت في عبدِ اللهِ بن أَبِيٍّ ابْنِ سَلُولَ حِينَ أَكْرَهُ أَمَتَهُ مُسَيْكَةَ على الزني.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "نزلت في",
          "start": 827,
          "end": 837,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 919,
      "end": 970,
      "text": "ذكرُ مَن قال ذلكحدَّثنا الحسنُ بنُ الصَّبَاحِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 935,
          "end": 942,
          "span_id": "s012"
        }
      ]
    },
    {
      "id": "s013",
      "start": 970,
      "end": 1028,
      "text": " ثنا حجاجُ بنُ محمدٍ، عن ابن جُرَيْجٍ، قال: أخبَرني أبو ال",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 995,
          "end": 1006,
          "span_id": "s013"
        }
      ]
    },
    {
      "id": "s014",
      "start": 1032,
      "end": 1075,
      "text": "زبيرِ، أنه سمِع جابرَ بنَ عبدِ اللهِ يقولُ:",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1075,
      "end": 1113,
      "text": " جاءت مُسَيْكةُ لبعضِ الأنصارِ، فقالت:",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1113,
      "end": 1143,
      "text": " إن سيدى يُكْرِهُنى على الزنى.",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1143,
      "end": 1210,
      "text": " فنزَلَت في ذلك: {وَلَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ} ",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 1144,
          "end": 1151,
          "span_id": "s017"
        },
        {
          "family": "NUZUL",
          "marker": "نزلت في",
          "start": 1145,
          "end": 1154,
          "span_id": "s017"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1160,
          "end": 1209,
          "span_id": "s017"
        }
      ]
    },
    {
      "id": "s018",
      "start": 1354,
      "end": 1397,
      "text": ".حدَّثني يحيى بنُ إبراهيمَ المسعوديُّ، قال:",
      "markers": []
    },
    {
      "id": "s019",
      "start": 1397,
      "end": 1467,
      "text": " ثنا أبي، عن أبيه، عن جدِّه، عن الأعمشِ، عن أبي سفيانَ، عن جابرٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1407,
          "end": 1467,
          "stripped": "عن أبيه، عن جده، عن الأعمش، عن أبي سفيان، عن جابر، قال:",

      "start": 2532,
      "end": 2605,
      "text": " فأنْزَل اللهُ في ذلك: {وَلَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ}.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 2533,
          "end": 2540,
          "span_id": "s033"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 2533,
          "end": 2545,
          "span_id": "s033"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2555,
          "end": 2604,
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 2605,
      "end": 2668,
      "text": "قال ابن جريجٍ: وأخبَرني عمرُو بنُ دينارٍ، عن عكرمةَ، قال: كانت ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 2609,
          "end": 2617,
          "span_id": "s034"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 2650,
          "end": 2655,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2691,
      "end": 2761,
      "text": " أَمَةٌ لعبدِ اللهِ بن أبيٍّ، أمَرَها فزنَت، فجاءَت ببُرْدٍ، فقال لها:",
      "markers": []
    },
    {
      "id": "s036",
      "start": 2761,
      "end": 2883,
      "text": " ارْجِعي فازْنى. فقالت: واللهِ لا أَفْعَلُ، إن يَكُ هذا خيرًا فقد اسْتَكْثَرْتُ منه، وإن يَكُ شرًّا فقد آن لى أن أَدَعَهُ ",
      "markers": []
    },
    {
      "id": "s037",
      "start": 3064,
      "end": 3076,
      "text": ".قال ابن جري",
      "markers": []
    },
    {
      "id": "s038",
      "start": 3080,
      "end": 3116,
      "text": "جٍ: وقال مجاهدٌ نحوَ ذلك، وزاد، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3089,
          "end": 3094,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 3116,
      "end": 3158,
      "text": " البغاءُ الزني، وَاللهُ {غَفُورٌ رَحِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3140,
          "end": 3157,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3158,
      "end": 3212,
      "text": " قال: للمُكْرَهاتِ على الزنى، وفيها نزَلَت هذه الآيةُ.",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3212,
      "end": 3258,
      "text": "حدَّثنا الحسنُ، قال: أخبَرنا عبد الرزاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3212,
          "end": 3219,
          "span_id": "s041"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 3212,
          "end": 3258,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s041"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 3220,
          "end": 3225,
          "span_id": "s041"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3233,
          "end": 3240,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 3258,
      "end": 3392,
      "text": " أخبَرنا معمرٌ، عن الزهريِّ، أن رجلًا مِن قريشٍ أُسر يومَ بدرٍ، وكان عبدُ اللهِ بنُ أَبِيٍّ أَسَرَه، وكان لعبدِ اللهِ جاريةٌ يقال لها:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3259,
          "end": 3266,
          "span_id": "s042"
        },
        {
          "family": "SIRA",
          "marker": "يوم بدر",
          "start": 3311,
          "end": 3319,
          "span_id": "s042"
        },
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 3383,
          "end": 3387,
          "span_id": "s042"
        }
      ]
    },
    {
      "id": "s043",
      "start": 3392,
      "end": 3537,
      "text": " مُعاذةُ. فكان القرشيُّ الأسيرُ يُرِيدُها على نفسها، وكانت مسلمةً، فكانت تَمْتَنِعُ منه لإسلامِها، وكان ابن أبيٍّ يُكْرِهُها على ذلك ويَضْرِبُها؛",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3537,
      "end": 3599,
      "text": " رجاءَ أن تَحْمِلَ للقرشيِّ فيَطْلُبَ فِداءَ ولدِه، فقال الله:",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3599,
      "end": 3675,
      "text": " {وَلَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ إِنْ أَرَدْنَ تَحَصُّنًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3600,
          "end": 3674,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3675,
      "end": 3772,
      "text": " قال الزهريُّ: {وَمَنْ يُكْرِهْهُنَّ فَإِنَّ اللَّهَ مِنْ بَعْدِ إِكْرَاهِهِنَّ غَفُورٌ رَحِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3690,
          "end": 3771,
          "span_id": "s046"
        }
      ]
    },
    {
      "id": "s047",
      "start": 3772,
      "end": 3809,
      "text": " يقولُ: غفورٌ لهنّ ما أُكْرِهْن عليه ",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3935,
      "end": 4032,
      "text": ".حدَّثنا أبو كُريبٍ، قال: ثنا ابن يَمانٍ، عن أشعثَ، عن جعفرٍ، عن سعيدِ بن جبيرٍ أنه كان يَقْرَأُ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3936,
          "end": 3943,
          "span_id": "s048"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3977,
          "end": 4018,
          "stripped": "عن أشعث، عن جعفر، عن سعيد بن جبير أنه",
          "span_id": "s048"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "NARRATOR",
          "start": 4000,
          "end": 4013,
          "span_id": "s048"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 4025,
          "end": 4030,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 4032,
      "end": 4094,
      "text": " {فَإِنَّ اللَّهَ مِنْ بَعْدِ إِكْرَاهِهِنَّ غَفُورٌ رَحِيمٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4033,
          "end": 4093,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 4171,
      "end": 4211,
      "text": ".حدَّثنا عليٌّ، قال: ثنا أبو صالحٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4172,
          "end": 4179,
          "span_id": "s050"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 4180,
          "end": 4183,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 4211,
      "end": 4254,
      "text": " ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4225,
          "end": 4254,
          "stripped": "عن علي، عن ابن عباس قوله:",
          "span_id": "s051"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 4228,
          "end": 4231,
          "span_id": "s051"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 4238,
          "end": 4246,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4254,
      "end": 4330,
      "text": " {وَلَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ إِنْ أَرَدْنَ تَحَصُّنًا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4255,
          "end": 4329,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 4330,
      "end": 4447,
      "text": " يقولُ: ولا تُكْرِهوا إماءَكم على الزنى، فإن فعَلْتُم فإن الله سبحانه لهن غفورٌ رحيمٌ، وإثمُهن على مَن أَكْرَهَهُنَّ ",
      "markers": []
    },
    {
      "id": "s054",
      "start": 4558,
      "end": 4587,
      "text": ".حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s055",
      "start": 4587,
      "end": 4615,
      "text": " ثنى أبي، قال: ثنى عمي، قال:",
      "markers": []
    },
    {
      "id": "s056",
      "start": 4615,
      "end": 4653,
      "text": " ثنى أبي، عن أبيه، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4625,
          "end": 4653,
          "stripped": "عن أبيه، عن ابن عباس قوله:",
          "span_id": "s056"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 4637,
          "end": 4645,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4653,
      "end": 4720,
      "text": " {وَلَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ} إلى آخرِ الآيةِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4654,
          "end": 4703,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4720,
      "end": 4773,
      "text": " قال: كانوا في الجاهليةِ يُكْرِهون إماءَهم على الزنى؛",
      "markers": []
    },
    {
      "id": "s059",
      "start": 4773,
      "end": 4941,
      "text": " يَأْخُذون أجورهن، فقال اللهُ: لا تُكْرِهوهن على الزنى مِن أجلِ المنَالةِ في الدنيا، (ومَن يُكْرِهْهن فإن الله مِن بعدِ إكراهِهن غفورٌ رحيمٌ لهن). يعنى: إذا أُكْرِهْنَ ",
      "markers": []
    },
    {
      "id": "s060",
      "start": 4965,
      "end": 4995,
      "text": ".حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s061",
      "start": 4995,
      "end": 5093,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن ابن أبي نجيحٍ، عن مجاهدٍ: {وَلَا تُكْرِهُوا فَتَيَاتِكُمْ}. قال ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5026,
          "end": 5088,
          "stripped": "عن ابن أبي نجيح، عن مجاهد: {ولا تكرهوا فتياتكم}.",
          "span_id": "s061"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 5047,
          "end": 5052,
          "span_id": "s061"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5055,
          "end": 5087,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 5113,
      "end": 5124,
      "text": ": إماءَكم، ",
      "markers": []
    },
    {
      "id": "s063",
      "start": 5128,
      "end": 5163,
      "text": "{عَلَى الْبِغَاءِ}: على الزنى. قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5128,
          "end": 5146,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 5163,
      "end": 5293,
      "text": " عبدُ اللهِ بنُ أبيٍّ ابن سَلُولَ أمر أمةً له بالزنى، فجاءَته بدينارٍ أو ببُرْدٍ - شكٍّ أبو عاصمٍ - فأعْطَته، فقال: ارْجِعي فازني ",
      "markers": []
    },
    {
      "id": "s065",
      "start": 5302,
      "end": 5303,
      "text": " ",
      "markers": []
    },
    {
      "id": "s066",
      "start": 5318,
      "end": 5349,
      "text": ". فقالت: واللهِ ما أنا براجعةٍ.",
      "markers": []
    },
    {
      "id": "s067",
      "start": 5349,
      "end": 5391,
      "text": " واللهُ غفورٌ رحيمٌ للمُكْرَهات على الزنى.",
      "markers": []
    },
    {
      "id": "s068",
      "start": 5391,
      "end": 5420,
      "text": " ففى هذا أُنْزِلَت هذه الآية.",
      "markers": []
    },
    {
      "id": "s069",
      "start": 5420,
      "end": 5458,
      "text": "حدَّثني الحارثُ، قال: ثنا الحسنُ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 5446,
          "end": 5451,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 5458,
      "end": 5530,
      "text": " ثنا وَرْقاءُ، عن ابن أبي نجيحٍ، عن مجاهدٍ بنحوه، إلا أنه قال في حديثِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5473,
          "end": 5515,
          "stripped": "عن ابن أبي نجيح، عن مجاهد بنحوه، إلا أنه",
          "span_id": "s070"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 5494,
          "end": 5499,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 5530,
      "end": 5586,
      "text": " أمَر أمَةً له بالزنى، فزنَت، فجاءته ببُرْدٍ فأَعْطَتْه ",
      "markers": []
    },
    {
      "id": "s072",
      "start": 5725,
      "end": 5765,
      "text": ". ولم يَشُكَّ.حُدِّثْتُ عن الحسينِ، قال:",
      "markers": []
    },
    {
      "id": "s073",
      "start": 5765,
      "end": 5812,
      "text": " سَمِعْتُ أبا مُعاذٍ يقولُ: أخبَرنا عبيدٌ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 5779,
          "end": 5784,
          "span_id": "s073"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 5793,
          "end": 5800,
          "span_id": "s073"
        }
      ]
    },
    {
      "id": "s074",
      "start": 5812,
      "end": 5844,
      "text": " سمِعْتُ الضحاكَ يقولُ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الضحاك",
          "name": "الضحاك",
          "role": "SPEAKER",
          "start": 5821,
          "end": 5827,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 5844,
      "end": 5895,
      "text": " {وَلَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5845,
          "end": 5894,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 5895,
      "end": 5975,
      "text": " يقولُ: على الزنى، {فَإِنَّ اللَّهَ مِنْ بَعْدِ إِكْرَاهِهِنَّ غَفُورٌ رَحِيمٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5914,
          "end": 5974,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 5975,
      "end": 6017,
      "text": " يقولُ: غفورٌ لهن؛ للمُكْرَهاتِ على الزنى.",
      "markers": []
    },
    {
      "id": "s078",
      "start": 6017,
      "end": 6060,
      "text": "حدَّثني يونُسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 6038,
          "end": 6045,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 6060,
      "end": 6083,
      "text": " قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 6065,
          "end": 6072,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 6083,
      "end": 6149,
      "text": " {وَمَنْ يُكْرِهْهُنَّ فَإِنَّ اللَّهَ مِنْ بَعْدِ إِكْرَاهِهِنَّ ",
      "markers": []
    },
    {
      "id": "s081",
      "start": 6153,
      "end": 6169,
      "text": "غَفُورٌ رَحِيمٌ ",
      "markers": []
    },
    {
      "id": "s082",
      "start": 6192,
      "end": 6250,
      "text": "}. قال: غفورٌ رحيمٌ لهن حيَن أُكْرِهْنَ، وقُسِرْن على ذلك ",
      "markers": []
    },
    {
      "id": "s083",
      "start": 6314,
      "end": 6376,
      "text": ".حدَّثنا ابن حميدٍ، قال: ثنا جريرٌ، عن منصورٍ، عن مجاهدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6315,
          "end": 6322,
          "span_id": "s083"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6350,
          "end": 6376,
          "stripped": "عن منصور، عن مجاهد، قال:",
          "span_id": "s083"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 6364,
          "end": 6369,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 6376,
      "end": 6643,
      "text": " كانوا يَأْمُرون وَلائدَهم يُباغِين، يَفْعَلْن ذلك، فيُصِبْنَ، فيَأْتِينَهم بكسبهن، فكانت لعبدِ اللهِ بن أبيٍّ ابن سَلُولَ جاريةٌ، فكانت تُباغِى، فكرِهَت وحلَفَت ألا تَفْعَلَه، فأكْرَهها أهلُها، فانْطَلَقت فباغَت ببُرْدٍ أخضرَ، فأتتْهم به، فأنْزَل اللهُ تبارك وتعالى:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 6616,
          "end": 6623,
          "span_id": "s084"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 6616,
          "end": 6628,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 6643,
      "end": 6700,
      "text": " {وَلَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ} الآية ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6644,
          "end": 6693,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 6780,
      "end": 6782,
      "text": ". ",
      "markers": []
    }
  ],

  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 193,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ وَحُرِّمَ ذَلِكَ عَلَى الْمُؤْمِنِينَ (3)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 192,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 193,
      "end": 229,
      "text": " اختلَف أهلُ التأويلِ في تأويلِ ذلك؛",
      "markers": []
    },
    {
      "id": "s004",
      "start": 229,
      "end": 455,
      "text": " فقال بعضُهم: نزَلتْ هذه الآيةُ في بعضِ مَن استأذنَ رسولَ اللهِ - صلى الله عليه وسلم - في نكاحِ نسوةٍ كُنَّ معروفاتٍ بالزنى من أهلِ الشركِ، وكُنَّ أصحابَ راياتٍ يُكْرِينَ أنفسَهنَّ، فأنزَل اللهُ تحريمَهنَّ على المؤمنينَ، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 295,
          "end": 313,
          "span_id": "s004"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 411,
          "end": 417,
          "span_id": "s004"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 411,
          "end": 422,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 455,
      "end": 488,
      "text": " الزانى من المؤمنينَ لا يتزوَّجُ ",
      "markers": []
    },
    {
      "id": "s006",
      "start": 574,
      "end": 690,
      "text": " إلا زانيةً أو مشركةً؛ لأنَّهنَّ كذلك، والزانيةُ من أولئك البغايا لا يَنكِحُها إلَّا زانٍ من المؤمنينَ أو المشركينَ ",
      "markers": []
    },
    {
      "id": "s007",
      "start": 712,
      "end": 855,
      "text": "، أو مشركٌ مثلُها؛ لأنَّهنَّ كنَّ مشركاتٍ، {وَحُرِّمَ ذَلِكَ عَلَى الْمُؤْمِنِينَ} فحرَّم اللهُ نكاحَهنَّ في قولِ أهلِ هذه المقالة بهذه الآيةِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 755,
          "end": 794,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 855,
      "end": 906,
      "text": "ذكرُ مَن قال ذلكحدَّثنا محمدُ بنُ عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 871,
          "end": 878,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 906,
      "end": 935,
      "text": " ثنا المعتمرُ، عن أبيهِ، قال:",
      "markers": []
    },
    {
      "id": "s010",
      "start": 935,
      "end": 974,
      "text": " ثنى الحضْرمِيُّ، عن القاسمِ بن محمدٍ، ",
      "markers": []
    },
    {
      "id": "s011",
      "start": 998,
      "end": 999,
      "text": " ",
      "markers": []
    },
    {
      "id": "s012",
      "start": 1034,
      "end": 1099,
      "text": "، أنَّ رجلًا من المسلمينَ استأذَن نبيَّ اللهِ في امرأةٍ يقال لها:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 1090,
          "end": 1094,
          "span_id": "s012"
        }
      ]
    },
    {
      "id": "s013",
      "start": 1099,
      "end": 1138,
      "text": " أمُّ مَهْزُولٍ. كانتْ تُسافِحُ الرجلَ ",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1158,
      "end": 1266,
      "text": "، وتَشترِطُ له أَنْ تُنفِقَ عليهِ، وأنَّه استأذَن فيها نبيَّ اللهِ - صلى الله عليه وسلم -، وذكَر له أمْرَها.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1227,
          "end": 1245,
          "span_id": "s014"
        }
      ]
    },
    {
      "id": "s015",
      "start": 1266,
      "end": 1312,
      "text": " قال: فقرأ نبيُّ اللهِ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 1273,
          "end": 1276,
          "span_id": "s015"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1291,
          "end": 1309,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1312,
      "end": 1410,
      "text": " {وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ}. أو قال: فأُنزِلتُ: {وَالزَّانِيَةُ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1313,
          "end": 1372,
          "span_id": "s016"
        },
        {

    {
      "id": "s022",
      "start": 1987,
      "end": 1995,
      "text": " عن ذلك ",
      "markers": []
    },
    {
      "id": "s023",
      "start": 2033,
      "end": 2052,
      "text": ".قال: أخبَرنا سليما",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2039,
          "end": 2046,
          "span_id": "s023"
        }
      ]
    },
    {
      "id": "s024",
      "start": 2056,
      "end": 2094,
      "text": "نُ التيميُّ، عن سعيدِ بن المسيبِ، قال:",
      "markers": []
    },
    {
      "id": "s025",
      "start": 2094,
      "end": 2155,
      "text": " كنَّ نساءَ مواردَ بالمدينةِ.حدَّثنا أحمدُ بنُ المقدامِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2123,
          "end": 2130,
          "span_id": "s025"
        }
      ]
    },
    {
      "id": "s026",
      "start": 2155,
      "end": 2190,
      "text": " ثنا المعتمرُ، قال: سمعتُ أبي، قال:",
      "markers": []
    },
    {
      "id": "s027",
      "start": 2190,
      "end": 2238,
      "text": " ثنا قَتادةُ، عن سعيدٍ بن المسيبِ في هذه الآيةِ:",
      "markers": []
    },
    {
      "id": "s028",
      "start": 2238,
      "end": 2299,
      "text": " {وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2239,
          "end": 2298,
          "span_id": "s028"
        }
      ]
    },
    {
      "id": "s029",
      "start": 2299,
      "end": 2343,
      "text": " قال: نزَلتُ في نساءِ مواردَ كنَّ بالمدينةِ.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "نزلت في",
          "start": 2305,
          "end": 2314,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 2343,
      "end": 2403,
      "text": "حدَّثنا ابن المثنى، قال: ثنا عمرُو بنُ عاصمٍ الكلابيُّ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2343,
          "end": 2350,
          "span_id": "s030"
        }
      ]
    },
    {
      "id": "s031",
      "start": 2403,
      "end": 2454,
      "text": " ثنا معتمرٌ، عن أبيهِ، عن قَتادةَ، عن سعيدٍ بنحوِه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2416,
          "end": 2454,
          "stripped": "عن أبيه، عن قتادة، عن سعيد بنحوه.",
          "span_id": "s031"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "NARRATOR",
          "start": 2429,
          "end": 2435,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2454,
      "end": 2489,
      "text": "حدَّثنا محمدُ بنُ المثنى، قال: ثنا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2454,
          "end": 2461,
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 2511,
      "end": 2586,
      "text": " عبدُ الأعلى، قال: ثنا داودُ، عن رجلٍ، عن عمرِو بن شعيبٍ، قال: كان لمرثَدٍ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2541,
          "end": 2573,
          "stripped": "عن رجل، عن عمرو بن شعيب، قال:",
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 2638,
      "end": 2669,
      "text": " صديقةٌ في الجاهليةِ يقالُ لها:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 2659,
          "end": 2663,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2669,
      "end": 2712,
      "text": " عَنَاقِ. وكان رجلًا شديدًا، وكان يقالُ له:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 2703,
          "end": 2707,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 2712,
      "end": 2749,
      "text": " دُلْدُلٌ. وكان يأتِى مكَّةَ فيحمِلُ ",
      "markers": []
    },
    {
      "id": "s037",
      "start": 2768,
      "end": 2868,
      "text": " ضَعَفَةَ المسلمينَ إلى رسولِ اللهِ - صلى الله عليه وسلم -، فلقِى صديقتَه، فدَعتْه إلى نفسِها، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2806,
          "end": 2824,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 2868,
      "end": 2904,
      "text": " إِنَّ الله قد حرَّم الزني. فقالتْ: ",
      "markers": []
    },
    {
      "id": "s039",
      "start": 2921,
      "end": 2922,
      "text": " ",
      "markers": []
    },
    {
      "id": "s040",
      "start": 2986,
      "end": 3013,
      "text": "؟ فخشِيَ أَنْ تُشِيعَ عليه ",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3034,
      "end": 3046,
      "text": "، فرجَع إلى ",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3102,
      "end": 3103,
      "text": " ",
      "markers": []
    },
    {
      "id": "s043",
      "start": 3121,
      "end": 3185,
      "text": " فقال: يا رسولَ اللهِ، كانتْ لي صديقةٌ في الجاهليةِ، فهل ترى لى ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3201,
      "end": 3346,
      "text": " نكاحَها؟ قال: فأنزَل اللهُ: {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ}.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 3216,
          "end": 3222,
          "span_id": "s044"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 3216,
          "end": 3227,
          "span_id": "s044"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3230,
          "end": 3345,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3346,
      "end": 3382,
      "text": " قال: كنَّ نساءً معلوماتٍ يُدْعَوْن ",
      "markers": []
    },
    {
      "id": "s046",
      "start": 3434,
      "end": 3446,
      "text": " القليقياتِ ",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3689,
      "end": 3740,
      "text": ".حدَّثنا ابن المثنى، قال: ثنا محمدُ بنُ جعفرٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3690,
          "end": 3697,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3740,
      "end": 3779,
      "text": " ثنا شعبةُ، عن إبراهيمَ بن مهاجرٍ، قال:",
      "markers": []
    },
    {
      "id": "s049",
      "start": 3779,
      "end": 3814,
      "text": " سمعتُ مجاهدًا يقولُ في هذه الآيةِ:",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3814,
      "end": 3873,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3815,
          "end": 3872,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3873,
      "end": 3903,
      "text": " قال: كنَّ بغايا في الجاهليةِ ",
      "markers": []
    },
    {
      "id": "s052",
      "start": 3995,
      "end": 4029,
      "text": ".حدَّثني يعقوبُ بنُ إبراهيمَ، قال:",
      "markers": []
    },
    {
      "id": "s053",
      "start": 4029,
      "end": 4101,
      "text": " ثنا هشيمٌ، عن عبدِ الملكِ، عمَّن أخبَره، عن مجاهدٍ، نحوًا من حديثِ ابن ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4041,
          "end": 4095,
          "stripped": "عن عبد الملك، عمن أخبره، عن مجاهد، نحوا من حديث",
          "span_id": "s053"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 4074,
          "end": 4079,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4105,
      "end": 4160,
      "text": "المثنى، إلَّا أنَّه قال: كانتِ امرأةٌ منهنَّ يقالُ لها:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 4150,
          "end": 4154,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4160,
      "end": 4188,
      "text": " أمُّ مهزولٍ. يعنى في قولِه:",
      "markers": []
    },
    {
      "id": "s056",
      "start": 4188,
      "end": 4247,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4189,
          "end": 4246,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4247,
      "end": 4279,
      "text": " قال: فكنَّ نساءً معلوماتٍ. قال:",
      "markers": []
    },
    {
      "id": "s058",
      "start": 4279,
      "end": 4392,
      "text": " فكان الرجلُ من فقراءِ المسلمينَ يتزوَّجُ المرأةَ منهنَّ لتنفقَ عليه، فنهاهم اللهُ عن ذلك. هذا في حديثِ التيميِّ ",
      "markers": []
    },
    {
      "id": "s059",
      "start": 4524,
      "end": 4554,
      "text": ".حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s060",
      "start": 4554,
      "end": 4607,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، وحدَّثنى الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s061",
      "start": 4607,
      "end": 4686,
      "text": " ثنا الحسنُ، قال: ثنا ورقاءُ، جميعًا عن ابن أبي نجيحٍ، عن مجاهدٍ في قولِ اللهِ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 4612,
          "end": 4617,
          "span_id": "s061"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4644,
          "end": 4686,
          "stripped": "عن ابن أبي نجيح، عن مجاهد في قول الله:",
          "span_id": "s061"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 4665,
          "end": 4670,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4686,
      "end": 4729,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4687,
          "end": 4728,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 4729,
      "end": 4773,
      "text": " قال: رجالٌ كانوا يريدُون الزنى بنساءٍ زوان ",
      "markers": []
    },
    {
      "id": "s064",
      "start": 4795,
      "end": 4840,
      "text": " بغايا متعالماتٍ كنَّ في الجاهليةِ، فقيل لهم:",
      "markers": []
    },
    {
      "id": "s065",
      "start": 4840,
      "end": 4900,
      "text": " هذا حرامٌ. فأرادوا نكاحَهنَّ، فحرَّم اللهُ عليهم نكاحَهنَّ ",
      "markers": []
    },
    {
      "id": "s066",
      "start": 5000,
      "end": 5040,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5001,
          "end": 5008,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 5040,
      "end": 5125,
      "text": " ثنى حجاجٌ، عن ابن جُرَيجٍ، عن مجاهدٍ بنحوِه، إلَّا أنَّه قال: بغايا مُعْلِناتٌ كنَّ ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5052,
          "end": 5097,
          "stripped": "عن ابن جريج، عن مجاهد بنحوه، إلا أنه",
          "span_id": "s067"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 5055,
          "end": 5065,
          "span_id": "s067"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 5071,
          "end": 5076,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 5129,
      "end": 5147,
      "text": "كذلك في الجاهليةِ ",
      "markers": []
    },
    {
      "id": "s069",
      "start": 5190,
      "end": 5334,
      "text": ".حدَّثنا ابن وكيعٍ، قال: ثنا أبى، عن هشامِ بن عروةَ، عن أبيهِ، وإسماعيلَ بن أبي خالدٍ، عن الشعبيِّ، وابنِ أبي ذئبٍ، عن شعبةَ، عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5191,
          "end": 5198,
          "span_id": "s069"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5224,
          "end": 5269,
          "stripped": "عن هشام بن عروة، عن أبيه، وإسماعيل بن أبي",
          "span_id": "s069"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5277,
          "end": 5329,
          "stripped": "عن الشعبي، وابن أبي ذئب، عن شعبة، عن ابن عباس،",
          "span_id": "s069"
        },
        {
          "family": "TABIIN",
          "marker": "الشعبي",
          "name": "الشعبي",
          "role": "NARRATOR",
          "start": 5280,
          "end": 5286,
          "span_id": "s069"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5319,
          "end": 5327,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 5334,
      "end": 5419,
      "text": " كنَّ بغايا في الجاهليةِ، على أبوابِهنَّ راياتٌ مثلُ راياتِ البَيطارِ يُعْرَفْنَ بها ",
      "markers": []
    },
    {
      "id": "s071",
      "start": 5610,
      "end": 5640,
      "text": ".حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s072",
      "start": 5640,
      "end": 5729,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، عن قيسِ بن سعدٍ، عن عطاءِ بن أبي رباحٍ، عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5671,
          "end": 5729,
          "stripped": "عن قيس بن سعد، عن عطاء بن أبي رباح، عن ابن عباس، قال:",
          "span_id": "s072"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "NARRATOR",
          "start": 5691,
          "end": 5695,
          "span_id": "s072"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 5714,
          "end": 5722,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 5729,
      "end": 5791,
      "text": " نساءٌ بغايا متعالماتٌ، حرَّم اللهُ نكاحَهنَّ، لا يَنكِحُهنَّ ",
      "markers": []
    },
    {
      "id": "s074",
      "start": 5812,
      "end": 5861,
      "text": " إِلَّا زانٍ من المؤمنينَ، أو مشركٌ من المشركينَ.",
      "markers": []
    },
    {
      "id": "s075",
      "start": 5861,
      "end": 5889,
      "text": "حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s076",
      "start": 5889,
      "end": 5917,
      "text": " ثنى أبي، قال: ثنى عمي، قال:",
      "markers": []
    },
    {
      "id": "s077",
      "start": 5917,
      "end": 5955,
      "text": " ثنى أبي، عن أبيه، عن ابن عباسٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5927,
          "end": 5955,
          "stripped": "عن أبيه، عن ابن عباس قوله:",
          "span_id": "s077"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 5939,
          "end": 5947,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 5955,
      "end": 6110,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ وَحُرِّمَ ذَلِكَ عَلَى الْمُؤْمِنِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5956,
          "end": 6109,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 6110,
      "end": 6149,
      "text": " قال: كانتْ بيوتٌ تُسمَّى المواخيرَ في ",
      "markers": []
    },
    {
      "id": "s080",
      "start": 6153,
      "end": 6343,
      "text": "الجاهليةِ، وكانوا يُؤاجرُونَ فيها فتياتهنَّ، وكانتْ بيوتًا معلومةً للزنى، لا يدخُلُ عليهنَّ ولا يأتيهنَّ إِلَّا زانٍ من أهلِ القبلةِ، أو مشركٌ من أهلِ الأوثانِ، فحرَّم الله ذلك على المؤمنين ",
      "markers": []
    },
    {
      "id": "s081",
      "start": 6400,
      "end": 6474,
      "text": ".حدَّثني يعقوبُ، قال: ثنا ابن عُليَّةَ، عن ابن جُرَيجٍ، عن عطاءٍ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6440,
          "end": 6474,
          "stripped": "عن ابن جريج، عن عطاء في قوله:",
          "span_id": "s081"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 6443,
          "end": 6453,
          "span_id": "s081"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 6459,
          "end": 6463,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 6474,
      "end": 6591,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6475,
          "end": 6590,
          "span_id": "s082"
        }
      ]
    },
    {
      "id": "s083",
      "start": 6591,
      "end": 6631,
      "text": " قال: بغايا متعالماتٌ كنَّ في الجاهليةِ؛",
      "markers": []
    },
    {
      "id": "s084",
      "start": 6631,
      "end": 6679,
      "text": " بغيُّ آلِ فلانٍ، وبغيُّ آلِ فلانٍ، فأنزَل الله:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 6667,
          "end": 6673,
          "span_id": "s084"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 6667,
          "end": 6678,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 6679,
      "end": 6834,
      "text": " {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ وَحُرِّمَ ذَلِكَ عَلَى الْمُؤْمِنِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6680,
          "end": 6833,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 6834,
      "end": 6892,
      "text": " فحكَم اللهُ بذلك من أمرِ الجاهليةِ على الإسلامِ. فقال له ",
      "markers": []
    },
    {
      "id": "s087",
      "start": 6910,
      "end": 6911,
      "text": " ",
      "markers": []
    },
    {
      "id": "s088",
      "start": 6984,
      "end": 7022,
      "text": ": أبلَغك ذلك عن ابن عباسٍ؟ فقال: نعمْ ",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 7000,
          "end": 7008,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 7134,
      "end": 7173,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7135,
          "end": 7142,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 7177,
      "end": 7210,
      "text": ": ثني حجاجٌ، عن ابن جُرَيجٍ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 7193,
          "end": 7203,
          "span_id": "s090"
        }
      ]
    },
    {
      "id": "s091",
      "start": 7210,
      "end": 7251,
      "text": " سمِعتُ عطاءَ بنَ أبي رباحٍ يقولُ في ذلك:",
      "markers": []
    },
    {
      "id": "s092",
      "start": 7251,
      "end": 7330,
      "text": " كنَّ بغايا متعالماتٍ؛ بغيَّ آلِ فلانٍ، وبغيَّ آلِ فلانٍ، وكنَّ زوانيَ مشركاتٍ.",
      "markers": []
    },
    {
      "id": "s093",
      "start": 7330,
      "end": 7491,
      "text": " فقال: {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ وَحُرِّمَ ذَلِكَ عَلَى الْمُؤْمِنِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7337,
          "end": 7490,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 7491,
      "end": 7543,
      "text": " قال: أَحْكَمَ اللهُ من أمرِ الجاهليةِ بهذا، قيل له:",
      "markers": []
    },
    {
      "id": "s095",
      "start": 7543,
      "end": 7579,
      "text": " أبلَغك هذا عن ابن عباسٍ؟ قال: نعمْ ",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 7558,
          "end": 7566,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 7622,
      "end": 7651,
      "text": ".قال ابن جريجٍ: وقال عكرِمةُ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 7627,
          "end": 7635,
          "span_id": "s096"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 7643,
          "end": 7649,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 7651,
      "end": 7686,
      "text": " إِنَّه كان يُسمِّى تسعًا، يَعُدُّ ",
      "markers": []
    },
    {
      "id": "s098",
      "start": 7712,
      "end": 7780,
      "text": " صواحبَ الراياتِ، وكنَّ أكثرَ من ذلك، ولكنَّ هؤلاءِ أصحابُ الراياتِ:",
      "markers": []
    },
    {
      "id": "s099",
      "start": 7780,
      "end": 7886,
      "text": " أَمُّ مَهْزُولٍ جاريةُ السائبِ بن أبى السائبِ المخزوميِّ، وأمُّ عِلْيطٍ جاريةُ صفوانَ بن أميةَ، وحَنَّةُ ",
      "markers": []
    },
    {
      "id": "s100",
      "start": 7940,
      "end": 8011,
      "text": " القبطيةُ جاريةُ العاصِ بن وائلٍ، ومَرِيَّةٌ جاريةُ مالكِ بن عُمَيْلةَ ",
      "markers": []
    },
    {
      "id": "s101",
      "start": 8059,
      "end": 8075,
      "text": " بن السَّبَّاقِ ",
      "markers": []
    },
    {
      "id": "s102",
      "start": 8116,
      "end": 8141,
      "text": " بن عبدِ الدارِ، وحلالةُ ",
      "markers": []
    },
    {
      "id": "s103",
      "start": 8156,
      "end": 8173,
      "text": " جاريةُ سُهَيْلِ ",
      "markers": []
    },
    {
      "id": "s104",
      "start": 8189,
      "end": 8197,
      "text": " بن عمرٍ",
      "markers": []
    }
  ],

          "span_id": "s016"
        }
      ]
    },
    {
      "id": "s017",
      "start": 1582,
      "end": 1616,
      "text": ".حدَّثني يعقوبُ بنُ إبراهيمَ، قال:",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1616,
      "end": 1687,
      "text": " ثنى هُشَيمٌ، عن التيميِّ، عن القاسمِ بن محمدٍ، عن عبدِ اللهِ بن عمرٍو ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1630,
          "end": 1666,
          "stripped": "عن التيمي، عن القاسم بن محمد، عن",
          "span_id": "s018"
        },
        {
          "family": "SAHABA",
          "marker": "عبد الله بن عمرو",
          "name": "عبد الله بن عمرو",
          "role": "NARRATOR",
          "start": 1667,
          "end": 1686,
          "span_id": "s018"
        }
      ]
    },
    {
      "id": "s019",
      "start": 1705,
      "end": 1835,
      "text": " قولَه: {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ}. قال: ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",

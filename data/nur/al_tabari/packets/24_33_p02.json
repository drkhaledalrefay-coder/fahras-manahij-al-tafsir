      "start": 8839,
      "end": 8899,
      "text": ".وأولَى هذه الأقوالِ بالصوابِ في معنى ذلك عندِى قولُ من قال:",
      "markers": []
    },
    {
      "id": "s131",
      "start": 8899,
      "end": 8959,
      "text": " معناه: {فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا} أي:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 8900,
          "end": 8905,
          "span_id": "s131"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8907,
          "end": 8955,
          "span_id": "s131"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 8956,
          "end": 8959,
          "span_id": "s131"
        }
      ]
    },
    {
      "id": "s132",
      "start": 8959,
      "end": 9042,
      "text": " قوةً على الاحترافِ والاكتسابِ، ووفاءً بما أوْجَبَ على نفسِه وألزمَها، وصدقَ لهجةٍ.",
      "markers": []
    },
    {
      "id": "s133",
      "start": 9042,
      "end": 9148,
      "text": " وذلك أنَّ هذه المعانىَ هي الأسبابُ التي بمولَى العبدِ الحاجةُ إليها إذا كاتَب عبدَه، مما يكونُ في العبدِ؛",
      "markers": []
    },
    {
      "id": "s134",
      "start": 9148,
      "end": 9220,
      "text": " فأَمَّا المالُ وإن كان من الخير، فإنَّه لا يكونُ في العبدِ، وإنَّما يكو",
      "markers": []
    },
    {
      "id": "s135",
      "start": 9224,
      "end": 9353,
      "text": "نُ عندَه أو له، لا فيه، واللهُ إنَّما أوجَبَ علينا مكاتبةَ العبدِ إذا علِمنا فيه خيرًا، لا إذا علِمنا عنده أو لَه، فلذلك لم نقلْ:",
      "markers": []
    },
    {
      "id": "s136",
      "start": 9353,
      "end": 9398,
      "text": " إنَّ الخيرَ في هذا الموضعِ معنيٌّ به المالُ.",
      "markers": []
    },
    {
      "id": "s137",
      "start": 9398,
      "end": 9455,
      "text": "وقولُه: {وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9406,
          "end": 9454,
          "span_id": "s137"
        }
      ]
    },
    {
      "id": "s138",
      "start": 9455,
      "end": 9512,
      "text": " يقولُ تعالى ذِكْرُه: وأعطُوهم من مالِ اللهِ الذي أعطاكم.",
      "markers": []
    },
    {
      "id": "s139",
      "start": 9512,
      "end": 9583,
      "text": "ثم اختلَفَ أهلُ التأويلِ في المأمورِ بإعطائِه من مالِ اللهِ الذي أعطاه؛",
      "markers": []
    },
    {
      "id": "s140",
      "start": 9583,
      "end": 9622,
      "text": " مَنْ هو؟ وفى المالِ؛ أيُّ الأموالِ هو؟",
      "markers": []
    },
    {
      "id": "s141",
      "start": 9622,
      "end": 9803,
      "text": " فقال بعضُهم: الذي أمِرَ بإعطاءِ المكاتَبِ مِن مالِ اللهِ هو مولَى العبدِ المكاتَبِ، ومالُ اللهِ الذي أمِرَ بإعطائِه منه هو مالُ الكِتابةِ، والقدرُ الذي أُمِر أن يعطيَه منه الربُعُ.",
      "markers": []
    },
    {
      "id": "s142",
      "start": 9803,
      "end": 9841,
      "text": " وقال آخرون: بل ما شاء من ذلك المولَى.",
      "markers": []
    },
    {
      "id": "s143",
      "start": 9841,
      "end": 9886,
      "text": "ذكرُ مَن قال ذلكحدَّثني عمرُو بنُ عليٍّ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 9875,
          "end": 9878,
          "span_id": "s143"
        }
      ]
    },
    {
      "id": "s144",
      "start": 9886,
      "end": 9914,
      "text": " ثنا عمرانُ بنُ عيينةَ، قال:",
      "markers": []
    },
    {
      "id": "s145",
      "start": 9914,
      "end": 9994,
      "text": " ثنا عطاءُ بن السائبِ، عن أبي عبدِ الرحمنِ السُّلَمِيُّ، عن عليٍّ في قولِ اللهِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9937,
          "end": 9994,
          "stripped": "عن أبي عبد الرحمن السلمي، عن علي في قول الله:",
          "span_id": "s145"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 9974,
          "end": 9977,
          "span_id": "s145"
        }
      ]
    },
    {
      "id": "s146",
      "start": 9994,
      "end": 10065,
      "text": " {وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ}. قال: ربعُ المكاتبةِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 9995,
          "end": 10043,
          "span_id": "s146"
        }
      ]
    },
    {
      "id": "s147",
      "start": 10286,
      "end": 10317,
      "text": ".حدَّثنا الحسنُ بنُ عرفةَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 10287,
          "end": 10294,
          "span_id": "s147"
        }
      ]
    },
    {
      "id": "s148",
      "start": 10317,
      "end": 10345,
      "text": " ثنا عبدُ الرحمنِ بنُ محمدٍ ",
      "markers": []
    },
    {
      "id": "s149",
      "start": 10376,
      "end": 10466,
      "text": " المحاربيُّ، عن عطاءِ بن السائبِ، عن أبي عبدِ الرحمنِ السُّلَميِّ، عن عليٍّ في قولِ اللهِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10389,
          "end": 10466,
          "stripped": "عن عطاء بن السائب، عن أبي عبد الرحمن السلمي، عن علي في قول الله:",
          "span_id": "s149"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "NARRATOR",
          "start": 10392,
          "end": 10396,
          "span_id": "s149"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 10446,
          "end": 10449,
          "span_id": "s149"
        }
      ]
    },
    {
      "id": "s150",
      "start": 10466,
      "end": 10516,
      "text": " {وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10467,
          "end": 10515,
          "span_id": "s150"
        }
      ]
    },
    {
      "id": "s151",
      "start": 10516,
      "end": 10549,
      "text": " قال: ربعُ الكتابةِ يحُطُّها عنه.",
      "markers": []
    },
    {
      "id": "s152",
      "start": 10549,
      "end": 10582,
      "text": "حدَّثني يعقوبُ بنُ إبراهيمَ، قال:",
      "markers": []
    },
    {
      "id": "s153",
      "start": 10582,
      "end": 10683,
      "text": " ثنا ابن عُلَيةَ، عن ليثٍ، عن عبد الأعلَى، عن أبي عبدِ الرحمن، عن عليٍّ رَضِى الله عنه في قولِ اللهِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 10600,
          "end": 10647,
          "stripped": "عن ليث، عن عبد الأعلى، عن أبي عبد الرحمن، عن",
          "span_id": "s153"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 10648,
          "end": 10651,
          "span_id": "s153"
        }
      ]
    },
    {
      "id": "s154",
      "start": 10683,
      "end": 10733,
      "text": " {وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 10684,
          "end": 10732,
          "span_id": "s154"
        }
      ]
    },
    {
      "id": "s155",
      "start": 10733,
      "end": 10763,
      "text": " قال: الربعُ من أوَّلِ نجومِه ",
      "markers": []
    },
    {
      "id": "s156",
      "start": 11020,
      "end": 11122,
      "text": ".قال: أخبَرنا ابن عُليَّةَ، قال عطاءُ بنُ السائبِ، عن أبي عبدِ الرحمنِ السُّلَميِّ، عن عليٍّ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 11026,
          "end": 11033,
          "span_id": "s156"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 11052,
          "end": 11056,
          "span_id": "s156"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11071,
          "end": 11122,
          "stripped": "عن أبي عبد الرحمن السلمي، عن علي في قوله:",
          "span_id": "s156"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 11107,
          "end": 11110,
          "span_id": "s156"
        }
      ]
    },
    {
      "id": "s157",
      "start": 11122,
      "end": 11172,
      "text": " {وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11123,
          "end": 11171,
          "span_id": "s157"
        }
      ]
    },
    {
      "id": "s158",
      "start": 11172,
      "end": 11240,
      "text": " قال: الربعُ من مكاتبِته.حدَّثنا محمدُ بنُ إسماعيلَ الأحمَسيُّ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11197,
          "end": 11204,
          "span_id": "s158"
        }
      ]
    },
    {
      "id": "s159",
      "start": 11240,
      "end": 11269,
      "text": " ثنا محمدُ بنُ عبيدٍ، قال: ثن",
      "markers": []
    },
    {
      "id": "s160",
      "start": 11273,
      "end": 11333,
      "text": "ى عبدُ الملكِ بنُ أبي سليمانَ، عن عبدِ الملكِ بن أعينَ، قال:",
      "markers": []
    },
    {
      "id": "s161",
      "start": 11333,
      "end": 11415,
      "text": " كاتَبَ أبو عبدِ الرحمنِ غلامًا في أربعةِ آلافِ درهمٍ، ثم وضَعَ له الربعَ، ثم قال:",
      "markers": []
    },
    {
      "id": "s162",
      "start": 11415,
      "end": 11513,
      "text": " لولا أنِّى رأيتُ عليًّا رضوانُ اللهِ عليه كاتَبَ غلامًا له ثم وضَعَ له الربعَ، ما وضعتُ لك شيئًا.",
      "markers": []
    },
    {
      "id": "s163",
      "start": 11513,
      "end": 11563,
      "text": "حدَّثنا ابن المثنى، قال: ثنا محمدُ بنُ جعفرٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11513,
          "end": 11520,
          "span_id": "s163"
        }
      ]
    },
    {
      "id": "s164",
      "start": 11563,
      "end": 11695,
      "text": " ثنا شعبةُ، عن عبدِ الأعلى، عن أبي عبدِ الرحمنِ السُّلَميِّ، أنه كاتَبَ غلامًا له على ألفٍ ومائتين، فترَكَ الربعَ وأشهدَنى، فقال لى:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 11575,
          "end": 11623,
          "stripped": "عن عبد الأعلى، عن أبي عبد الرحمن السلمي،",
          "span_id": "s164"
        }
      ]
    },
    {
      "id": "s165",
      "start": 11695,
      "end": 11755,
      "text": " كان صديقُك يفعلُ هذا. يعنى عليًّا رضوانُ اللهِ عليه، يقولُ ",
      "markers": []
    },
    {
      "id": "s166",
      "start": 11771,
      "end": 11822,
      "text": ": {وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 11773,
          "end": 11821,
          "span_id": "s166"
        }
      ]
    },
    {
      "id": "s167",
      "start": 11897,
      "end": 11943,
      "text": ".حدَّثنا ابن بشارٍ، قال: ثنا عبدُ الرحمن، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 11898,
          "end": 11905,
          "span_id": "s167"
        }
      ]
    },
    {
      "id": "s168",
      "start": 11943,
      "end": 11976,
      "text": " ثنا سفيانُ، عن عبدِ الملكِ، قال:",
      "markers": []
    },
    {
      "id": "s169",
      "start": 11976,
      "end": 12019,
      "text": " ثنى فَضالةُ بنُ أبى أميَّةَ، عن أبيه، قال:",
      "markers": []
    },
    {
      "id": "s170",
      "start": 12019,
      "end": 12097,
      "text": " كاتَبنى عمرُ بنُ الخطابِ رضِى اللهُ عنه، فاستقرَضَ لى من حَفْصةً مائتى درهمٍ.",
      "markers": []
    },
    {
      "id": "s171",
      "start": 12097,
      "end": 12128,
      "text": " قلتُ: ألَا تجعلُها في مكاتبتي؟",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 12098,
          "end": 12101,
          "span_id": "s171"
        }
      ]
    },
    {
      "id": "s172",
      "start": 12128,
      "end": 12166,
      "text": " قال: إنِّي لا أدرِى أدرِكُ ذاك أم لا ",
      "markers": []
    },
    {
      "id": "s173",
      "start": 12364,
      "end": 12392,
      "text": "؟قال: ثنا عبدُ الرحمنِ، قال:",
      "markers": []
    },
    {
      "id": "s174",
      "start": 12392,
      "end": 12440,
      "text": " ثنا سفيانُ، بلَغنى أنه كاتبَه على مائةِ أوقيةٍ:",
      "markers": []
    },
    {
      "id": "s175",
      "start": 12440,
      "end": 12478,
      "text": " قال: ثنا سفيانُ، عن عبدِ الملكِ، قال:",
      "markers": []
    },
    {
      "id": "s176",
      "start": 12478,
      "end": 12519,
      "text": " ذكرتُ ذلك لعكرِمةَ، فقال: هو قولُ اللهِ:",
      "markers": []
    },
    {
      "id": "s177",
      "start": 12519,
      "end": 12569,
      "text": " {وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12520,
          "end": 12568,
          "span_id": "s177"
        }
      ]
    },
    {
      "id": "s178",
      "start": 12569,
      "end": 12608,
      "text": "حدَّثني عليٌّ، قال: ثنا أبو صالحٍ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 12577,
          "end": 12580,
          "span_id": "s178"
        }
      ]
    },
    {
      "id": "s179",
      "start": 12608,
      "end": 12659,
      "text": " ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ في قولِ اللهِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 12622,
          "end": 12651,
          "stripped": "عن علي، عن ابن عباس في قول",
          "span_id": "s179"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 12625,
          "end": 12628,
          "span_id": "s179"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 12635,
          "end": 12643,
          "span_id": "s179"
        }
      ]
    },
    {
      "id": "s180",
      "start": 12659,
      "end": 12709,
      "text": " {وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12660,
          "end": 12708,
          "span_id": "s180"
        }
      ]
    },
    {
      "id": "s181",
      "start": 12709,
      "end": 12741,
      "text": " يقولُ: ضعُوا عنهم من مكاتبِتهم ",
      "markers": []
    },
    {
      "id": "s182",
      "start": 12864,
      "end": 12893,
      "text": ".حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s183",
      "start": 12893,
      "end": 12923,
      "text": " ثنى أبي، قال: ثني عمِّى، قال:",
      "markers": []
    },
    {
      "id": "s184",
      "start": 12923,
      "end": 12955,
      "text": " ثنى أبي، عن أبيه، عن ابن عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 12933,
          "end": 12955,
          "stripped": "عن أبيه، عن ابن عباس:",
          "span_id": "s184"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 12945,
          "end": 12953,
          "span_id": "s184"
        }
      ]
    },
    {
      "id": "s185",
      "start": 12955,
      "end": 13005,
      "text": " {وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12956,
          "end": 13004,
          "span_id": "s185"
        }
      ]
    },
    {
      "id": "s186",
      "start": 13005,
      "end": 13044,
      "text": " يقولُ: ضَعُوا عنهم مما قاطعتموهم عليه.",
      "markers": []
    },
    {
      "id": "s187",
      "start": 13044,
      "end": 13088,
      "text": "حدَّثنا أبو كريبٍ، قال: ثنا ابن إدريسَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 13044,
          "end": 13051,
          "span_id": "s187"
        }
      ]
    },
    {
      "id": "s188",
      "start": 13088,
      "end": 13142,
      "text": " سمِعتُ عبدَ الملكِ بنَ أبى سليمانَ، عن عطاءٍ في قوله:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 13128,
          "end": 13132,
          "span_id": "s188"
        }
      ]
    },
    {
      "id": "s189",
      "start": 13142,
      "end": 13192,
      "text": " {وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13143,
          "end": 13191,
          "span_id": "s189"
        }
      ]
    },
    {
      "id": "s190",
      "start": 13192,
      "end": 13223,
      "text": " قال: مما أخرَج اللهُ لكم منهم ",
      "markers": []
    },
    {
      "id": "s191",
      "start": 13277,
      "end": 13317,
      "text": ".حدَّثني أبو السائبِ، قال: ثنا ابن إدريس",
      "markers": []
    },
    {
      "id": "s192",
      "start": 13321,
      "end": 13343,
      "text": "َ، عن ليثٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 13324,
          "end": 13343,
          "stripped": "عن ليث، عن مجاهد:",
          "span_id": "s192"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 13336,
          "end": 13341,
          "span_id": "s192"
        }
      ]
    },
    {
      "id": "s193",
      "start": 13343,
      "end": 13393,
      "text": " {وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13344,
          "end": 13392,
          "span_id": "s193"
        }
      ]
    },
    {
      "id": "s194",
      "start": 13393,
      "end": 13420,
      "text": " قال: آتِهِم مما في يدَيْك ",
      "markers": []
    },
    {
      "id": "s195",
      "start": 13469,
      "end": 13511,
      "text": ".حدَّثني الحسينُ بنُ عمرٍو العنقزيُّ، قال:",
      "markers": []
    },
    {
      "id": "s196",
      "start": 13511,
      "end": 13557,
      "text": " ثنى أبي، عن أسباطَ، عن السديِّ، عن أبيه، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 13521,
          "end": 13557,
          "stripped": "عن أسباط، عن السدي، عن أبيه، قال:",
          "span_id": "s196"
        },
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "NARRATOR",
          "start": 13535,
          "end": 13540,
          "span_id": "s196"
        }
      ]
    },
    {
      "id": "s197",
      "start": 13557,
      "end": 13738,
      "text": " كاتبتْنى زينبُ بنتُ قيسِ بن مَخْرمةَ، من بنى المطَّلبِ بن عبدِ منافٍ، على عشرةِ آلافٍ، فتركَتْ لى ألفًا، وكانت زينبُ قد صلَّت مع رسولِ اللهِ - صلى الله عليه وسلم - القبلتين جميعًا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 13701,
          "end": 13719,
          "span_id": "s197"
        }
      ]
    },
    {
      "id": "s198",
      "start": 13785,
      "end": 13815,
      "text": ".حدَّثنا مجاهدُ بنُ موسى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 13786,
          "end": 13793,
          "span_id": "s198"
        }
      ]
    },
    {
      "id": "s199",
      "start": 13815,
      "end": 13917,
      "text": " ثنا يزيدُ، قال: أخبَرنا أبو مسعودٍ الجُرَيْرِيُّ، عن أبي نَضْرةَ، عن أبي سعيدٍ مولى أبى أَسِيدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 13832,
          "end": 13839,
          "span_id": "s199"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 13866,
          "end": 13903,
          "stripped": "عن أبي نضرة، عن أبي سعيد مولى أبى",
          "span_id": "s199"
        }
      ]
    },
    {
      "id": "s200",
      "start": 13917,
      "end": 14009,
      "text": " كاتَبنى أبو أَسِيدٍ على ثنتى عشرةَ مائةً، فجئتُه بها، فأخَذ منها ألفًا، وردَّ عليَّ مائتين ",
      "markers": []
    },
    {
      "id": "s201",
      "start": 14052,
      "end": 14153,
      "text": ".حدَّثنا ابن حميدٍ، قال: ثنا هارونُ بن المغيرةِ، عن عنبسةَ، عن سالمٍ الأفطسِ، عن سعيدِ بن جبيرٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 14053,
          "end": 14060,
          "span_id": "s201"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 14101,
          "end": 14153,
          "stripped": "عن عنبسة، عن سالم الأفطس، عن سعيد بن جبير، قال:",
          "span_id": "s201"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 14133,
          "end": 14146,
          "span_id": "s201"
        }
      ]
    },
    {
      "id": "s202",
      "start": 14153,
      "end": 14221,
      "text": " كان ابن عمرَ إذا كاتَب مكاتَبَه، لم يضعْ عنه شيئًا من أوَّلِ نجومه؛",
      "markers": []
    },
    {
      "id": "s203",
      "start": 14221,
      "end": 14313,
      "text": " مخافَة أن يعجِزَ فيَرجِعَ إليه صدقتَه، ولكنَّه إذا كان في آخرِ مكاتبِته، وضَع عنه ما أحبَّ ",
      "markers": []
    }
  ],

    {
      "id": "s001",
      "start": 4,
      "end": 91,
      "text": " {وَالْخَامِسَةُ}. يقولُ: والشهادةُ الخامسةُ {أَنَّ لَعْنَتَ اللَّهِ عَلَيْهِ}، يَقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5,
          "end": 21,
          "span_id": "s001"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 49,
          "end": 82,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 91,
      "end": 145,
      "text": " أن لعنةَ اللهِ له واجبةٌ، وعليه حالَّةٌ، إن كان فيما ",
      "markers": []
    },
    {
      "id": "s003",
      "start": 155,
      "end": 156,
      "text": " ",
      "markers": []
    },
    {
      "id": "s004",
      "start": 181,
      "end": 315,
      "text": " من الفاحشةِ من الكاذبين.وبنحوِ الذي قلنا في ذلك جاءت الآثارُ عن رسولِ اللهِ - صلى الله عليه وسلم -، وقالت به جماعةٌ من أهلِ التأويلِ.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 260,
          "end": 278,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 315,
      "end": 363,
      "text": "ذكرُ الرواية بذلك وذُكِر السببِ الذي فيه أُنزلت ",
      "markers": []
    },
    {
      "id": "s006",
      "start": 388,
      "end": 431,
      "text": " هذه الآيةُحدَّثني يعقوبُ بن إبراهيمَ، قال:",
      "markers": []
    },
    {
      "id": "s007",
      "start": 431,
      "end": 481,
      "text": " ثنا ابن عُليَّةَ، قال: ثنا أيوبُ، عن عكرمةَ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 469,
          "end": 474,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 481,
      "end": 610,
      "text": " لما نزَلت: {وَالَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ ثُمَّ لَمْ يَأْتُوا بِأَرْبَعَةِ شُهَدَاءَ فَاجْلِدُوهُمْ ثَمَانِينَ جَلْدَةً}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 493,
          "end": 609,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 610,
      "end": 638,
      "text": " قال سعدُ بنُ عبادةَ: اللهِ ",
      "markers": []
    },
    {
      "id": "s010",
      "start": 664,
      "end": 693,
      "text": " إن أنا رأيتُ لكاعِ متفخذَها ",
      "markers": []
    },
    {
      "id": "s011",
      "start": 711,
      "end": 825,
      "text": " رجلٌ، فقلتُ بما رأيتُ، إن في ظهرى لثمانين، إلى ما أجمعُ أربعةً، قد ذهَب، فقال رسولُ اللهِ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 719,
          "end": 722,
          "span_id": "s011"
        },
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 786,
          "end": 800,
          "span_id": "s011"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 804,
          "end": 822,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 825,
      "end": 857,
      "text": " \"يا معشرَ الأنصارِ، ألا تسمعون ",
      "markers": []
    },
    {
      "id": "s013",
      "start": 893,
      "end": 894,
      "text": " ",
      "markers": []
    },
    {
      "id": "s014",
      "start": 908,
      "end": 958,
      "text": " يقولُ سيدُكم؟ \". قالوا يا رسولَ اللهِ، لا تلُمَه.",
      "markers": []
    },
    {
      "id": "s015",
      "start": 958,
      "end": 1029,
      "text": " وذكَروا من غيرتِه؛ فما تزوَّج امرأةً قطُّ إلا بكرًا، ولا طلَّق امرأةً ",
      "markers": []
    },
    {
      "id": "s016",
      "start": 1033,
      "end": 1058,
      "text": "قطُّ فرجَع فيها أحدٌ منا.",
      "markers": []
    },
    {
      "id": "s017",
      "start": 1058,
      "end": 1098,
      "text": " فقال رسولُ الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 1060,
          "end": 1074,
          "span_id": "s017"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1077,
          "end": 1095,
          "span_id": "s017"
        }
      ]
    },
    {
      "id": "s018",
      "start": 1098,
      "end": 1123,
      "text": " \"فإن الله يأبى إلا ذاك\".",
      "markers": []
    },
    {
      "id": "s019",
      "start": 1123,
      "end": 1154,
      "text": " فقال: صدَق اللهُ ورسولُه. قال:",
      "markers": []
    },
    {
      "id": "s020",
      "start": 1154,
      "end": 1223,
      "text": " فلم يلبَثوا أن جاء ابن عمٍّ له فرمى امرأتَه، فشقَّ ذلك على المسلمين.",
      "markers": []
    },
    {
      "id": "s021",
      "start": 1223,
      "end": 1340,
      "text": " فقال: لا واللهِ، لا يَجْعلُ اللَّهُ في ظهرى ثمانين أبدًا، لقد نظرتُ حتى أيقَنتُ، ولقد استسمَعتُ حتى استشفَيتُ. قال: ",
      "markers": []
    },
    {
      "id": "s022",
      "start": 1354,
      "end": 1355,
      "text": " ",
      "markers": []
    },
    {
      "id": "s023",
      "start": 1388,
      "end": 1435,
      "text": " القرآنَ باللعانِ، فقيل له: احلِفْ. فحلَف. قال ",
      "markers": []
    },
    {
      "id": "s024",
      "start": 1467,
      "end": 1506,
      "text": ": \"قفوه عندَ الخامسةِ، فإنها مُوجِبةٌ\".",
      "markers": []
    },
    {
      "id": "s025",
      "start": 1506,
      "end": 1643,
      "text": " فقال: لا يُدخلُه الله النارَ بهذا أبدًا، كما درَأ عنه جلدَ ثمانين، لقد نظرتُ حتى أيقنتُ، ولقد استسمَعتُ حتى استشفيتُ، فحلَف. ثم قيل لها ",
      "markers": []
    },
    {
      "id": "s026",
      "start": 1655,
      "end": 1673,
      "text": ": احلفى. فحلَفتْ، ",
      "markers": []
    },
    {
      "id": "s027",
      "start": 1681,
      "end": 1682,
      "text": " ",
      "markers": []
    },
    {
      "id": "s028",
      "start": 1712,
      "end": 1758,
      "text": ": \"قِفوها عندَ الخامسةِ، فإنها مُوجبةٌ\". فقيل ",
      "markers": []
    },
    {
      "id": "s029",
      "start": 1772,
      "end": 1818,
      "text": " لها: إنها مُوجِبةً. فتلكَّأتْ ساعةً، ثم قالت:",
      "markers": []
    },
    {
      "id": "s030",
      "start": 1818,
      "end": 1884,
      "text": " لا أُخزِى قومِى. فحلَفت. فقال رسولُ اللهِ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 1845,
          "end": 1859,
          "span_id": "s030"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 1863,
          "end": 1881,
          "span_id": "s030"
        }
      ]
    },
    {
      "id": "s031",
      "start": 1884,
      "end": 1964,
      "text": " \"إن جاءت به كذا وكذا فهو لزوجها، وإن جاءت به كذا وكذا فهو للذى قيل فيه ما قيل\".",
      "markers": []
    },
    {
      "id": "s032",
      "start": 1964,
      "end": 2043,
      "text": " قال: فجاءت به غلامًا كأنه جملٌ أورقُ، فكان بعدُ أميرًا بمصرَ، لا يُعرفُ نسبُه ",
      "markers": []
    },
    {
      "id": "s033",
      "start": 2075,
      "end": 2080,
      "text": "، أو ",
      "markers": []
    },
    {
      "id": "s034",
      "start": 2102,
      "end": 2121,
      "text": " لا يُدرَى من أبوه ",
      "markers": []
    },
    {
      "id": "s035",
      "start": 2195,
      "end": 2227,
      "text": ".حدَّثنا خلَّادُ بنُ أسلمَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2196,
          "end": 2203,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 2227,
      "end": 2259,
      "text": " أخبَرنا النضرُ بنُ شُميلٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2228,
          "end": 2235,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 2259,
      "end": 2312,
      "text": " أخبَرنا عبادٌ، قال: سمِعتُ عكرمة، عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2260,
          "end": 2267,
          "span_id": "s037"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 2297,
          "end": 2305,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 2312,
      "end": 2525,
      "text": " لما نزَلت هذه الآيةُ: {وَالَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ ثُمَّ لَمْ يَأْتُوا بِأَرْبَعَةِ شُهَدَاءَ فَاجْلِدُوهُمْ ثَمَانِينَ جَلْدَةً وَلَا تَقْبَلُوا لَهُمْ شَهَادَةً أَبَدًا وَأُولَئِكَ هُمُ الْفَاسِقُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2335,
          "end": 2524,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 2525,
      "end": 2574,
      "text": " قال سعدُ بنُ عبادةَ: لهكذا أُنزلت يا رسولَ الله؟",
      "markers": []
    },
    {
      "id": "s040",
      "start": 2574,
      "end": 2729,
      "text": " لو أتيتُ لَكاعِ قد تفخَّذها رجلٌ، لم يكنْ لى أن أَهِيجَه ولا أُحرِّكَه حتى آتِىَ بأربعةِ شهداءَ، فوالله ما كنتُ لآتِىَ بأربعةِ شهداءَ حتى يفرُغَ من حاجته.",
      "markers": []
    },
    {
      "id": "s041",
      "start": 2729,
      "end": 2794,
      "text": " فقال رسول اللهِ - صلى الله عليه وسلم -: \"يا معشرَ الأنصارِ، أما ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 2731,
          "end": 2744,
          "span_id": "s041"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2748,
          "end": 2766,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 2831,
      "end": 2861,
      "text": " تسمَعُون إلى ما يقولُ سيدُكم؟",
      "markers": []
    },
    {
      "id": "s043",
      "start": 2861,
      "end": 2965,
      "text": " \". قالوا: لا تلُمْه فإنه رجلٌ غيورٌ، ما تزوَّج فينا قطُّ إلا عذراءَ، ولا طلَّق امرأةً له، فاجترَأ رجلٌ ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 2981,
      "end": 3009,
      "text": " منا أن يتزوّجَها. قال سعدٌ:",
      "markers": []
    },
    {
      "id": "s045",
      "start": 3009,
      "end": 3077,
      "text": " يا رسولَ اللهِ، بأبي وأمِّى، واللهِ إنى لأعرفُ أنها من الله، وأنها ",
      "markers": []
    },
    {
      "id": "s046",
      "start": 3081,
      "end": 3157,
      "text": "حقٌّ، ولكنْ عجِبت لو وجدتُ لَكاعِ قد تفخَّذها رجلٌ، لم يكنْ لى أن أَهيجَه و ",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3256,
      "end": 3257,
      "text": " ",
      "markers": []
    },
    {
      "id": "s048",
      "start": 3271,
      "end": 3344,
      "text": " ما لبِثُوا إلا يسيرًا حتى جاء هلالُ بنُ أميةَ من حديقةٍ له، فرأى بعينيه ",
      "markers": []
    },
    {
      "id": "s049",
      "start": 3362,
      "end": 3475,
      "text": " وسمِع بأذنيه، فأمسَك حتى أصبحَ، فلما أصبَح غدا على رسولِ اللهِ - صلى الله عليه وسلم - وهو جالسٌ مع أصحابه، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3428,
          "end": 3446,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 3475,
      "end": 3563,
      "text": " يا رسولَ اللهِ، إنى جئتُ أهلى عِشاءً فوجدتُ رجلًا مع أهلى، رأيت بعينيَّ، وسمعت بأذنيَّ.",
      "markers": []
    },
    {
      "id": "s051",
      "start": 3563,
      "end": 3669,
      "text": " فكرِةَ رسولُ اللهِ - صلى الله عليه وسلم - ما أتاه به وثَقُل عليه جدًّا حتى عُرف ذلك في وجهِه، فقال هلالٌ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3585,
          "end": 3603,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 3669,
      "end": 3711,
      "text": " واللهِ يا رسولَ اللهِ، إنى لأرى الكراهةَ ",
      "markers": []
    },
    {
      "id": "s053",
      "start": 3743,
      "end": 3816,
      "text": " في وجهِك مما أتيتُك به، واللهُ يعلمُ أني صادقٌ، وما قلت إلا حقًّا، وإني ",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 3796,
          "end": 3799,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 3839,
      "end": 3868,
      "text": " لأرجُو أن يجعلَ اللهُ فرجًا.",
      "markers": []
    },
    {
      "id": "s055",
      "start": 3868,
      "end": 3976,
      "text": " قال: واجتمعت الأنصارُ، فقالوا: ابتُلينا بما قال سعدٌ، أيُجلدُ هلالُ بنُ أميةَ، وتبطُلُ شهادتُه في المسلمين؟",
      "markers": []
    },
    {
      "id": "s056",
      "start": 3976,
      "end": 4101,
      "text": " فهمَّ رسولُ اللهِ - صلى الله عليه وسلم -، بضربِه، فإنه لكذلك يريدُ أن يأمُرَ بضربِه، ورسولُ الله - صلى الله عليه وسلم - جالس",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3997,
          "end": 4015,
          "span_id": "s056"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4076,
          "end": 4094,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4105,
      "end": 4168,
      "text": "ٌ مع أصحابهِ، إذ نزل عليه الوحى، فأمسَك أصحابُه عن كلامِه حينَ ",
      "markers": []
    },
    {
      "id": "s058",
      "start": 4185,
      "end": 4234,
      "text": " عرَفوا أن الوحىَ قد نزَل، حتى فرَغ، فأنزل اللهُ:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 4222,
          "end": 4227,
          "span_id": "s058"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 4222,
          "end": 4232,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4234,
      "end": 4328,
      "text": " {وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ وَلَمْ يَكُنْ لَهُمْ شُهَدَاءُ إِلَّا أَنْفُسُهُمْ} إلى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4235,
          "end": 4323,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4328,
      "end": 4392,
      "text": " {أَنَّ غَضَبَ اللَّهِ عَلَيْهَا إِنْ كَانَ مِنَ الصَّادِقِينَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4329,
          "end": 4391,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4392,
      "end": 4429,
      "text": " فقال رسولُ اللهِ صلى الله عليه وسلم:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 4394,
          "end": 4408,
          "span_id": "s061"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4410,
          "end": 4428,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4429,
      "end": 4475,
      "text": " \"أبشِرْ يا هِلالُ، فإن الله قد جعلَ فَرَجًا\".",
      "markers": []
    },
    {
      "id": "s063",
      "start": 4475,
      "end": 4509,
      "text": " فقال: قد كنتُ أرجُو ذلك من اللهِ.",
      "markers": []
    },
    {
      "id": "s064",
      "start": 4509,
      "end": 4550,
      "text": " فقال رسولُ اللهِ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 4511,
          "end": 4525,
          "span_id": "s064"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4529,
          "end": 4547,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 4550,
      "end": 4643,
      "text": " \"أرسِلوا إليها\". فجاءت، فلما اجتمعا عندَ رسولِ اللهِ - صلى الله عليه وسلم - قيل لها، فكذَبت.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4606,
          "end": 4624,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 4643,
      "end": 4729,
      "text": " فقال رسولُ اللهِ: \"إن الله يعلَمُ أن أحدَ كما كاذبٌ، فهل منكما تائبٌ؟ \". فقال هلالٌ: ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 4645,
          "end": 4659,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 4745,
      "end": 4746,
      "text": " ",
      "markers": []
    },
    {
      "id": "s068",
      "start": 4760,
      "end": 4806,
      "text": "، بأبي وأمِّي، لقد صدَقتُ، وما قلتُ إلا حقًّا.",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 4791,
          "end": 4794,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 4806,
      "end": 4847,
      "text": " فقال رسولُ اللهِ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 4808,
          "end": 4822,
          "span_id": "s069"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4826,
          "end": 4844,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 4847,
      "end": 4895,
      "text": " \"لاعِنُوا بينهما\". قيل لهلالٍ، يا هلالُ، اشهدْ.",
      "markers": []
    },
    {
      "id": "s071",
      "start": 4895,
      "end": 4949,
      "text": " فشهِد أربعَ شهاداتٍ باللهِ إنه لمن الصادقين. فقيل له ",
      "markers": []
    },
    {
      "id": "s072",
      "start": 4964,
      "end": 4965,
      "text": " ",
      "markers": []
    },
    {
      "id": "s073",
      "start": 5000,
      "end": 5102,
      "text": ": يا هلالُ، اتقِ الله، فإن عذابَ اللهِ أشدُّ من عذابِ الناسِ، وإنها الموجبةُ التي توجِبُ عليك العذابَ.",
      "markers": []
    },
    {
      "id": "s074",
      "start": 5102,
      "end": 5125,
      "text": " فقال هلالٌ: والله لا ي",
      "markers": []
    },
    {
      "id": "s075",
      "start": 5129,
      "end": 5144,
      "text": "عذِّبُنى اللهُ ",
      "markers": []
    },
    {
      "id": "s076",
      "start": 5422,
      "end": 5487,
      "text": " عليها، كما لم يَجلدْني عليها رسولُ اللهِ - صلى الله عليه وسلم -.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5466,
          "end": 5484,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 5487,
      "end": 5543,
      "text": " فشهِد الخامسةَ: أن لعنةَ اللهِ عليه إن كان من الكاذبين.",
      "markers": []
    },
    {
      "id": "s078",
      "start": 5543,
      "end": 5608,
      "text": " ثم قيل لها: اشهدى. فشهِدت أربعَ شهاداتٍ باللهِ إنه لمن الكاذبين.",
      "markers": []
    },
    {
      "id": "s079",
      "start": 5608,
      "end": 5726,
      "text": " فقيل لها عندَ الخامسةِ: اتقى الله، فإن عذابَ اللهِ أَشدُّ من عذابِ الناسِ، وإن هذه الموجبةُ التي تُوجبُ عليك العذابَ.",
      "markers": []
    },
    {
      "id": "s080",
      "start": 5726,
      "end": 5774,
      "text": " فتلكَّأت ساعةً، ثم قالت: واللهِ لا أفضَحُ قومى.",
      "markers": []
    },
    {
      "id": "s081",
      "start": 5774,
      "end": 5835,
      "text": " فشهِدت الخامسةَ: أن غَضَبَ اللَّهِ عليها إن كان من الصادقين.",
      "markers": []
    },
    {
      "id": "s082",
      "start": 5835,
      "end": 5943,
      "text": " ففرَّق بينَهما رسولُ اللهِ - صلى الله عليه وسلم -، وقضَى أن الولدَ لها، ولا يُدعَى لأبٍ، ولا يُرمَى ولدُها ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5865,
          "end": 5883,
          "span_id": "s082"
        }
      ]
    },
    {
      "id": "s083",
      "start": 5945,
      "end": 5986,
      "text": ".حدَّثني أحمدُ بنُ محمدٍ الطُّوسيُّ، قال:",
      "markers": []
    },
    {
      "id": "s084",
      "start": 5986,
      "end": 6024,
      "text": " ثنا أبو أحمدَ الحسينُ بنُ محمدٍ، قال:",
      "markers": []
    },
    {
      "id": "s085",
      "start": 6024,
      "end": 6085,
      "text": " ثنا جريرُ بنُ حازمٍ، عن أيوبَ، عن عكرمةَ، عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6046,
          "end": 6085,
          "stripped": "عن أيوب، عن عكرمة، عن ابن عباس، قال:",
          "span_id": "s085"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 6059,
          "end": 6064,
          "span_id": "s085"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6070,
          "end": 6078,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 6085,
      "end": 6149,
      "text": " لمَّا قذَف هلالُ بنُ أميَّةَ امرأتَه، قيل له: واللهِ لَيجلِدَنّ",
      "markers": []
    },
    {
      "id": "s087",
      "start": 6153,
      "end": 6204,
      "text": "َك رسولُ اللهِ - صلى الله عليه وسلم - ثمانين جلدةً.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6170,
          "end": 6188,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 6204,
      "end": 6329,
      "text": " قال: الله أعدلُ ذلك، أن يضربَنى ضربةً وقد علِم أنى قد رأيتُ حتى استيقنتُ، وسمِعتُ حتى استثبَتُّ، لا واللهِ لا يضربُنى أبدًا.",
      "markers": []
    },
    {
      "id": "s089",
      "start": 6329,
      "end": 6421,
      "text": " فنزَلت آيةُ الملاعنةِ، فدعا بهما رسولُ اللهِ - صلى الله عليه وسلم - حينَ نزَلت الآية، فقال:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 6330,
          "end": 6336,
          "span_id": "s089"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6377,
          "end": 6395,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 6421,
      "end": 6468,
      "text": " \"الله يعلم أن أحدَ كما كاذبٌ، فهل منكما تائبٌ؟",
      "markers": []
    },
    {
      "id": "s091",
      "start": 6468,
      "end": 6502,
      "text": " \". فقال هلالٌ: واللهِ إنى لصادقٌ.",
      "markers": []
    },
    {
      "id": "s092",
      "start": 6502,
      "end": 6547,
      "text": " فقال له: \"أحلِفْ باللهِ الذي لا إلهَ إلا هو:",
      "markers": []
    },
    {
      "id": "s093",
      "start": 6547,
      "end": 6618,
      "text": " إني لصادقٌ\". يقولُ ذلك أربع مراتٍ، فإن كنتُ كاذبًا فعليَّ لعنةُ اللهِ.",
      "markers": []
    },
    {
      "id": "s094",
      "start": 6618,
      "end": 6659,
      "text": " فقال رسولُ اللهِ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 6620,
          "end": 6634,
          "span_id": "s094"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6638,
          "end": 6656,
          "span_id": "s094"
        }
      ]
    },
    {
      "id": "s095",
      "start": 6659,
      "end": 6697,
      "text": " \"قِفوه عندَ الخامسةِ، فإنها مُوجبةٌ\".",
      "markers": []
    },
    {
      "id": "s096",
      "start": 6697,
      "end": 6748,
      "text": " فحلَف، ثم قالت أربعًا: واللهِ الذي لا إلهَ إلا هو:",
      "markers": []
    },
    {
      "id": "s097",
      "start": 6748,
      "end": 6800,
      "text": " إنه لمن الكاذبين، فإن كان صادقًا فعليها غضبُ اللهِ.",
      "markers": []
    },
    {
      "id": "s098",
      "start": 6800,
      "end": 6840,
      "text": " وقال رسولُ الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 6802,
          "end": 6816,
          "span_id": "s098"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6819,
          "end": 6837,
          "span_id": "s098"
        }
      ]
    },
    {
      "id": "s099",
      "start": 6840,
      "end": 6879,
      "text": " \"قِفوها عندَ الخامسةِ، فإنها مُوجبةٌ\".",
      "markers": []
    },
    {
      "id": "s100",
      "start": 6879,
      "end": 6931,
      "text": " فتردَّدت وهمَّت بالاعترافِ، ثم قالت: لا أفضحُ قومى ",
      "markers": []
    },
    {
      "id": "s101",
      "start": 7025,
      "end": 7071,
      "text": ".حدَّثنا أبو كريبٍ وأبو هشامٍ الرفاعيُّ، قالا:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7026,
          "end": 7033,
          "span_id": "s101"
        }
      ]
    },
    {
      "id": "s102",
      "start": 7071,
      "end": 7138,
      "text": " ثنا عبدةُ، عن الأعمشِ، عن إبراهيمَ، عن علقمةَ، عن عبدِ اللهِ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 7083,
          "end": 7133,
          "stripped": "عن الأعمش، عن إبراهيم، عن علقمة، عن عبد الله،",
          "span_id": "s102"
        }
      ]
    },
    {
      "id": "s103",
      "start": 7138,
      "end": 7174,

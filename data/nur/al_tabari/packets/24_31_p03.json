      "exclude": "شرح المحقق في الحاشية، أو بيت للزينة.",
      "markers": "أي، معناه، والعرب تقول، قال الشاعر، وأنشد"
    },
    {
      "id": "M_QIRAAT",
      "name_ar": "القراءات",
      "when": "اختلاف قراءة يُستخدم لبيان اللفظ أو المعنى.",

  "spans": [
    {
      "id": "s211",
      "start": 17521,
      "end": 17566,
      "text": ".حدَّثني يعقوبُ، قال: ثنا ابن عُلَيَّةَ، قال:",
      "markers": []
    },
    {
      "id": "s212",
      "start": 17566,
      "end": 17605,
      "text": " ثنا ابن أبى نجيحٍ، عن مجاهدٍ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 17589,
          "end": 17594,
          "span_id": "s212"
        }
      ]
    },
    {
      "id": "s213",
      "start": 17605,
      "end": 17650,
      "text": " {غَيْرِ أُولِي الْإِرْبَةِ مِنَ الرِّجَالِ}.",

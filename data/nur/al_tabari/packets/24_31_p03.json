      "start": 19415,
      "end": 19463,
      "text": "حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، قال: ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 19415,
          "end": 19422,
          "span_id": "s236"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 19415,
          "end": 19462,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s236"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 19423,
          "end": 19428,
          "span_id": "s236"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 19436,
          "end": 19443,
          "span_id": "s236"
        }
      ]
    },
    {
      "id": "s237",
      "start": 19467,
      "end": 19521,
      "text": "أخبَرنا معمرٌ، عن الزهريِّ، عن عروةَ، عن عائشةَ، قالت:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 19467,
          "end": 19474,
          "span_id": "s237"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 19482,
          "end": 19521,
          "stripped": "عن الزهري، عن عروة، عن عائشة، قالت:",
          "span_id": "s237"
        },
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 19508,
          "end": 19513,
          "span_id": "s237"
        }
      ]
    },
    {
      "id": "s238",
      "start": 19521,
      "end": 19732,
      "text": " كان رجلٌ يَدْخُلُ على أزواجِ النبيِّ - صلى الله عليه وسلم - مُخَنَّتٌ، فكانوا يَعُدُّونه مِن غيرِ أُولى الإرْبِة، فدخَل عليه النبيُّ - صلى الله عليه وسلم - يومًا وهو عندَ بعضِ نسائِه، وهو يَنْعَتُ امرأةً، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 19561,
          "end": 19579,
          "span_id": "s238"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 19657,
          "end": 19675,
          "span_id": "s238"
        }
      ]
    },
    {
      "id": "s239",
      "start": 19732,
      "end": 19796,
      "text": " إنها إذا أقْبَلَت أقْبَلَت بأربعٍ، وإذا أدْبَرت أدْبَرت بثمانٍ.",
      "markers": []
    },
    {
      "id": "s240",
      "start": 19796,
      "end": 19836,
      "text": " فقال النبيُّ - صلى الله عليه وسلم -: \" ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 19812,
          "end": 19830,
          "span_id": "s240"
        }
      ]
    },
    {
      "id": "s241",
      "start": 19847,
      "end": 19848,
      "text": " ",
      "markers": []
    },
    {
      "id": "s242",
      "start": 19884,
      "end": 19942,
      "text": " هذا يَعْلَمُ ما ههنا، لا يَدْخُلَنَّ هذا عليكم\". فحجَبوه ",
      "markers": []
    },
    {
      "id": "s243",
      "start": 20195,
      "end": 20257,
      "text": ".حدَّثني سعدُ بنُ عبدِ اللَّهِ بن عبدِ الحكمِ المِصْريُّ، قال:",
      "markers": []
    },
    {
      "id": "s244",
      "start": 20257,
      "end": 20292,
      "text": " ثنا حفصُ بنُ عمرَ العَدَنيُّ، قال:",
      "markers": []
    },
    {
      "id": "s245",
      "start": 20292,
      "end": 20334,
      "text": " ثنا الحكمُ بنُ أبانٍ، عن عكرمةَ في قولِه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 20318,
          "end": 20323,
          "span_id": "s245"
        }
      ]
    },
    {
      "id": "s246",
      "start": 20334,
      "end": 20382,
      "text": " {أَوِ التَّابِعِينَ غَيْرِ أُولِي الْإِرْبَةِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 20335,
          "end": 20381,
          "span_id": "s246"
        }
      ]
    },
    {
      "id": "s247",
      "start": 20382,
      "end": 20424,
      "text": " قال: هو المُخَنَّثُ الذي لا يقومُ زُبُّه ",
      "markers": []
    },
    {
      "id": "s248",
      "start": 20612,
      "end": 20646,
      "text": ".واختلَفت القرأةُ في قراءةِ قولِه:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 20624,
          "end": 20627,
          "span_id": "s248"
        },
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 20633,
          "end": 20638,
          "span_id": "s248"
        }
      ]
    },
    {
      "id": "s249",
      "start": 20646,
      "end": 20733,
      "text": " {غَيْرِ أُولِي الْإِرْبَةِ}؛ فقرَأ ذلك بعضُ أهلِ الشامِ، وبعضُ أهلِ المدينةِ والكوفةِ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 20647,
          "end": 20674,
          "span_id": "s249"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 20677,
          "end": 20681,
          "span_id": "s249"
        }
      ]
    },
    {
      "id": "s250",
      "start": 20733,
      "end": 20769,
      "text": " (غيرَ أُولى الإرْبةِ) بنصبِ \"غيرِ\" ",
      "markers": []
    },
    {
      "id": "s251",
      "start": 20827,
      "end": 20854,
      "text": ". ولنصبِ \"غيرِ\" ههنا وجهان؛",
      "markers": []
    },
    {
      "id": "s252",
      "start": 20854,
      "end": 20895,
      "text": " أحدُهما: على القطعِ مِن {التَّابِعِينَ}؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 20879,
          "end": 20894,
          "span_id": "s252"
        }
      ]
    },
    {
      "id": "s253",
      "start": 20895,
      "end": 20938,
      "text": " لأن {التَّابِعِينَ} معرفةٌ و \"غيرُ\" نكرةٌ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 20900,
          "end": 20915,
          "span_id": "s253"
        }
      ]
    },
    {
      "id": "s254",
      "start": 20938,
      "end": 21007,
      "text": " والآخرُ: على الاستثناءِ، وتوجيهِ \"غيرِ\" إلى معنى: \"إلا\"، فكأنه قيل: ",
      "markers": []
    },
    {
      "id": "s255",
      "start": 21038,
      "end": 21039,
      "text": " ",
      "markers": []
    },
    {
      "id": "s256",
      "start": 21092,
      "end": 21108,
      "text": " بخفضِ {غَيْرِ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 21099,
          "end": 21107,
          "span_id": "s256"
        }
      ]
    },
    {
      "id": "s257",
      "start": 21204,
      "end": 21313,
      "text": " على أنها نعتٌ لـ {التَّابِعِينَ}، وجاز نعتُ {التَّابِعِينَ} بـ {غَيْر}، و \"التابعون\" معرفةٌ، و \"غيرُ\" نكرةٌ؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 21222,
          "end": 21237,
          "span_id": "s257"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 21249,
          "end": 21264,
          "span_id": "s257"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 21268,
          "end": 21275,
          "span_id": "s257"
        }
      ]
    },
    {
      "id": "s258",
      "start": 21313,
      "end": 21355,
      "text": " لأن {التَّابِعِينَ} معرفةٌ غيرُ مؤقَّتةٍ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 21318,
          "end": 21333,
          "span_id": "s258"
        }
      ]
    },
    {
      "id": "s259",
      "start": 21355,
      "end": 21389,
      "text": " فتأويلُ الكلامِ على هذه القراءةِ:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 21382,
          "end": 21387,
          "span_id": "s259"
        }
      ]
    },
    {
      "id": "s260",
      "start": 21389,
      "end": 21511,
      "text": " أو الذين هذه صفتُهم.والقولُ في ذلك عندى أنهما قراءتان مُتقارِبتا المعنَى، مستفيضةٌ القراءةُ بهما في الأمصارِ، فبأيتِهما ق",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 21475,
          "end": 21480,
          "span_id": "s260"
        }
      ]
    },
    {
      "id": "s261",
      "start": 21515,
      "end": 21645,
      "text": "رَأ القارئُ فمصيبٌ، غيرَ أنَّ الخفضَ في {غَيْر} أَقوَى في العربيةِ، فالقراءةُ به أعجبُ إليَّ و\"الإرْبَةُ\" الفِعْلَةُ مِن الأَرَبِ؛",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 21555,
          "end": 21562,
          "span_id": "s261"
        },
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 21586,
          "end": 21591,
          "span_id": "s261"
        }
      ]
    },
    {
      "id": "s262",
      "start": 21645,
      "end": 21716,
      "text": " مثلُ الجلِسةِ مِن الجُلُوسِ، والمِشيةُ مِن المَشْي، وهى الحاجةُ، يقال:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 21711,
          "end": 21715,
          "span_id": "s262"
        }
      ]
    },
    {
      "id": "s263",
      "start": 21716,
      "end": 21750,
      "text": " لا أَرَب لى فيك: لا حاجةَ لى فيك.",
      "markers": []
    },
    {
      "id": "s264",
      "start": 21750,
      "end": 21817,
      "text": " وكذا: أَرِبْتُ لكذا وكذا. إذا احتَجتَ إليه، فأنا آرَبُ له أَرَبًا.",
      "markers": []
    },
    {
      "id": "s265",
      "start": 21817,
      "end": 21860,
      "text": "فأما \"الأُرْبَةُ\" بضمِّ الألفِ، فالعُقْدةُ.",
      "markers": []
    },
    {
      "id": "s266",
      "start": 21860,
      "end": 21938,
      "text": "وقولُه: {أَوِ الطِّفْلِ الَّذِينَ لَمْ يَظْهَرُوا عَلَى عَوْرَاتِ النِّسَاءِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 21868,
          "end": 21937,
          "span_id": "s266"
        }
      ]
    },
    {
      "id": "s267",
      "start": 21938,
      "end": 22035,
      "text": " يقولُ تعالى ذكرُه: أو الطفلِ الذين لم يَكْشِفوا عن عَوْراتِ النساءِ بجِماعِهن، فيَظْهَروا عليها ",
      "markers": []
    },
    {
      "id": "s268",
      "start": 22051,
      "end": 22065,
      "text": "؛ لصِغَرِهنَّ ",
      "markers": []
    },
    {
      "id": "s269",
      "start": 22132,
      "end": 22175,
      "text": ".وبنحوِ الذي قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s270",
      "start": 22175,
      "end": 22220,
      "text": "ذكرُ مَن قال ذلكحدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s271",
      "start": 22220,
      "end": 22273,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، وحدَّثنى الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s272",
      "start": 22273,
      "end": 22346,
      "text": " ثنا الحسنُ، قال: ثنا وَرْقاءُ، جميعًا عن ابن أبي نجيحٍ، عن مجاهدٍ قولَه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 22278,
          "end": 22283,
          "span_id": "s272"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 22312,
          "end": 22346,
          "stripped": "عن ابن أبي نجيح، عن مجاهد قوله:",
          "span_id": "s272"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 22333,
          "end": 22338,
          "span_id": "s272"
        }
      ]
    },
    {
      "id": "s273",
      "start": 22346,
      "end": 22431,
      "text": " {عَلَى عَوْرَاتِ النِّسَاءِ}. قال: لم يَدْرُوا ما ثَمَّ؛ من الصِّغَرِ قبلَ الحُلُمِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 22347,
          "end": 22375,
          "span_id": "s273"
        }
      ]
    },
    {
      "id": "s274",
      "start": 22591,
      "end": 22631,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 22592,
          "end": 22599,
          "span_id": "s274"
        }
      ]
    },
    {
      "id": "s275",
      "start": 22631,
      "end": 22673,
      "text": " ثنى حجاجٌ، عن ابن جريجٍ، عن مجاهدٍ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 22643,
          "end": 22673,
          "stripped": "عن ابن جريج، عن مجاهد مثله.",
          "span_id": "s275"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 22646,
          "end": 22654,
          "span_id": "s275"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 22660,
          "end": 22665,
          "span_id": "s275"
        }
      ]
    },
    {
      "id": "s276",
      "start": 22673,
      "end": 22759,
      "text": "وقولُه: {وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا يُخْفِينَ مِنْ زِينَتِهِنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 22681,
          "end": 22758,
          "span_id": "s276"
        }
      ]
    },
    {
      "id": "s277",
      "start": 22759,
      "end": 22900,
      "text": " يقولُ تعالى ذكرُه: ولا يَجْعَلْنَ في أرجلِهن مِن الحُلِيِّ ما إذا مشَيْن أو حرَّكْنَهن، علِم الناسُ الذين مشَيْن بينَهم ما يُخْفِين مِن ذلك.",
      "markers": []
    },
    {
      "id": "s278",
      "start": 22900,
      "end": 22942,
      "text": "وبنحوِ الذي قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s279",
      "start": 22942,
      "end": 22987,
      "text": "ذكرُ مَن قال ذلكحدَّثنا ابن عبدِ الأعلى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 22958,
          "end": 22965,
          "span_id": "s279"
        }
      ]
    },
    {
      "id": "s280",
      "start": 22987,
      "end": 23015,
      "text": " ثنا المعتمرُ، عن أبيه، قال:",
      "markers": []
    },
    {
      "id": "s281",
      "start": 23015,
      "end": 23063,
      "text": " زعَم حَضْرَميٌّ أن امرأةً اتَّخَذَت بُرَتَيْنِ ",
      "markers": []
    },
    {
      "id": "s282",
      "start": 23131,
      "end": 23161,
      "text": " مِن فضةٍ، واتَّخَذَت جَزْعًا ",
      "markers": []
    },
    {
      "id": "s283",
      "start": 23207,
      "end": 23297,
      "text": "، فمرَّت على قومٍ، فضرَبَت برجلِها، فوقَع الخَلْخالُ على الجَزْعِ فصوَّت، فأنْزَل اللَّهُ:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 23281,
          "end": 23288,
          "span_id": "s283"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 23281,
          "end": 23295,
          "span_id": "s283"
        }
      ]
    },
    {
      "id": "s284",
      "start": 23297,
      "end": 23376,
      "text": " {وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا يُخْفِينَ مِنْ زِينَتِهِنَّ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 23298,
          "end": 23375,
          "span_id": "s284"
        }
      ]
    },
    {
      "id": "s285",
      "start": 23424,
      "end": 23471,
      "text": ".حدَّثنا ابن بشارٍ، قال: ثنا عبدُ الرحمنِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 23425,
          "end": 23432,
          "span_id": "s285"
        }
      ]
    },
    {
      "id": "s286",
      "start": 23471,
      "end": 23509,
      "text": " ثنا سفيانُ، عن السديِّ، عن أبى مالكٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 23484,
          "end": 23509,
          "stripped": "عن السدي، عن أبى مالك:",
          "span_id": "s286"
        },
        {
          "family": "TABIIN",
          "marker": "السدي",
          "name": "السدي",
          "role": "NARRATOR",
          "start": 23487,
          "end": 23492,
          "span_id": "s286"
        }
      ]
    },
    {
      "id": "s287",
      "start": 23509,
      "end": 23559,
      "text": " {وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا ",
      "markers": []
    },
    {
      "id": "s288",
      "start": 23563,
      "end": 23699,
      "text": "يُخْفِينَ مِنْ زِينَتِهِنَّ}. قال: كان في أرجلِهن خَرَزٌ، فكنَّ إذا مرَرْن بالمجالسِ حرَّكْن أرجلَهن ليُعْلَمَ مَا يُخْفِين مِن زينتهِن ",
      "markers": []
    },
    {
      "id": "s289",
      "start": 23826,
      "end": 23869,
      "text": ".حدَّثني عليٌّ، قال: ثنا عبدُ اللَّهِ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 23835,
          "end": 23838,
          "span_id": "s289"
        }
      ]
    },
    {
      "id": "s290",
      "start": 23869,
      "end": 23906,
      "text": " ثنى معاويةُ، عن عليٍّ، عن ابن عباسٍ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 23883,
          "end": 23906,
          "stripped": "عن علي، عن ابن عباس:",
          "span_id": "s290"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 23886,
          "end": 23889,
          "span_id": "s290"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 23896,
          "end": 23904,
          "span_id": "s290"
        }
      ]
    },
    {
      "id": "s291",
      "start": 23906,
      "end": 24110,
      "text": " {وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ}: فهو أن تَقْرَعَ الخَلْخالَ بالآخرِ عندَ الرجالِ، أو يكونَ في رجلَيْها خَلاخِلُ، فتُحَرِّكَهن عندَ الرجالِ، فنهَى اللَّهُ سبحانَه وتعالى عن ذلك؛ لأنه مِن عملِ الشيطانِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 23907,
          "end": 23941,
          "span_id": "s291"
        }
      ]
    },
    {
      "id": "s292",
      "start": 24227,
      "end": 24275,
      "text": ".حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرزاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 24228,
          "end": 24235,
          "span_id": "s292"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 24228,
          "end": 24275,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s292"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 24236,
          "end": 24241,
          "span_id": "s292"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 24249,
          "end": 24256,
          "span_id": "s292"
        }
      ]
    },
    {
      "id": "s293",
      "start": 24275,
      "end": 24380,
      "text": " أخبَرنا معمرٌ، عن قتادةَ: {وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا يُخْفِينَ مِنْ زِينَتِهِنَّ}.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 24276,
          "end": 24283,
          "span_id": "s293"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 24294,
          "end": 24299,
          "span_id": "s293"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 24302,
          "end": 24379,
          "span_id": "s293"
        }
      ]
    },
    {
      "id": "s294",
      "start": 24380,
      "end": 24454,
      "text": " قال: هو الخَلْخالُ، لا تَضْرِبِ امرأةٌ برجلِها ليُسْمَعَ صوتُ خَلْخالِها ",
      "markers": []
    },
    {
      "id": "s295",
      "start": 24532,
      "end": 24583,
      "text": ".حدَّثني يونُسُ، قال: أخبَرنا ابن وهبٍ، قال: قال اب",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 24554,
          "end": 24561,
          "span_id": "s295"
        }
      ]
    },
    {
      "id": "s296",
      "start": 24587,
      "end": 24682,
      "text": "ن زيدٍ في قولِه: {وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا يُخْفِينَ مِنْ زِينَتِهِنَّ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 24604,
          "end": 24681,
          "span_id": "s296"
        }
      ]
    },
    {
      "id": "s297",
      "start": 24682,
      "end": 24745,
      "text": " قال: الأجْراسُ مِن حُلِيِّهن يَجْعَلْنها في أرجلِهن، في مكانِ ",
      "markers": []
    },
    {
      "id": "s298",
      "start": 24771,
      "end": 24846,
      "text": " الخَلاخلِ، فنَهاهُن اللَّهُ أَن يَضْرِبْن بأرجلِهن لتُسْمَعَ تلك الأجراسُ.",
      "markers": []
    },
    {
      "id": "s299",
      "start": 24846,
      "end": 24912,
      "text": "وقولُه: {وَتُوبُوا إِلَى اللَّهِ جَمِيعًا أَيُّهَ الْمُؤْمِنُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 24854,
          "end": 24911,
          "span_id": "s299"
        }
      ]
    },
    {
      "id": "s300",
      "start": 24912,
      "end": 24995,
      "text": " يقولُ تعالى ذِكرُه: وارجِعوا أيُّها المؤمنون إلى طاعةِ اللَّهِ فيما أمَركم ونهاكم؛",
      "markers": []
    },
    {
      "id": "s301",
      "start": 24995,
      "end": 25053,
      "text": " من غَضِّ البصَرِ، وحفظِ الفرجِ، وتركِ دخولِ بيوتِ غيرِكم ",
      "markers": []
    },
    {
      "id": "s302",
      "start": 25074,
      "end": 25157,
      "text": " من غيرِ استئذانٍ ولا تسليمٍ، وغيرِ ذلك من أمرِه ونهيهِ، {لَعَلَّكُمْ تُفْلِحُونَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 25131,
          "end": 25156,
          "span_id": "s302"
        }
      ]
    },
    {
      "id": "s303",
      "start": 25157,
      "end": 25241,
      "text": " يقولُ: لتفلِحوا وتدرِكوا طَلِباتِكم لديْهِ، إذا أنتم أطعتُموه فيما أمرَكم ونَهاكم. ",
      "markers": []
    }
  ],
  "editor_footnote_evidence": [

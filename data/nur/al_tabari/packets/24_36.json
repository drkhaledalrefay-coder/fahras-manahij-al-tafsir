          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 1401,
          "end": 1409,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 1420,
      "end": 1487,
      "text": " {فِي بُيُوتٍ أَذِنَ اللَّهُ أَنْ تُرْفَعَ}: وهى المساجدُ تُكْرَمُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1421,
          "end": 1463,
          "span_id": "s016"
        }
      ]
    },
    {
      "id": "s017",
      "start": 1519,
      "end": 1545,
      "text": "، ونُهى عن اللَّغْوِ فيها ",
      "markers": []
    },
    {
      "id": "s018",
      "start": 1604,
      "end": 1633,
      "text": ".حدَّثني محمدُ بنُ سعدٍ، قال:",
      "markers": []
    },
    {
      "id": "s019",
      "start": 1633,
      "end": 1661,
      "text": " ثنى أبي، قال: ثنى عمي، قال:",
      "markers": []
    },
    {
      "id": "s020",
      "start": 1661,
      "end": 1702,
      "text": " ثنى أبي، عن أبيه، عن ابن عباسٍ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",

    {
      "id": "s028",
      "start": 2159,
      "end": 2199,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2160,
          "end": 2167,
          "span_id": "s028"
        }
      ]
    },
    {
      "id": "s029",
      "start": 2199,
      "end": 2241,
      "text": " ثني حجاجٌ، عن ابن جريجٍ، عن مجاهدٍ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2211,
          "end": 2241,
          "stripped": "عن ابن جريج، عن مجاهد مثله.",
          "span_id": "s029"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 2214,
          "end": 2222,
          "span_id": "s029"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 2228,
          "end": 2233,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 2241,
      "end": 2291,
      "text": "حدَّثنا الحسنُ، قال: أخبَرنا عبدُ الرَّزَاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2241,
          "end": 2248,
          "span_id": "s030"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 2241,
          "end": 2291,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s030"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 2249,
          "end": 2254,
          "span_id": "s030"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2262,
          "end": 2269,
          "span_id": "s030"
        }
      ]
    },
    {
      "id": "s031",
      "start": 2291,
      "end": 2326,
      "text": " أخبَرنا معمرٌ، عن الحسنِ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2292,
          "end": 2299,
          "span_id": "s031"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 2310,
          "end": 2315,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2326,
      "end": 2388,
      "text": " {فِي بُيُوتٍ أَذِنَ اللَّهُ أَنْ تُرْفَعَ}. قال: في المساجدِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2327,
          "end": 2369,
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 2417,
      "end": 2477,
      "text": ".قال: أخبَرنا معمرٌ، عن أبي إسحاقَ، عن عمرِو بن ميمونٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2423,
          "end": 2430,
          "span_id": "s033"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 2438,
          "end": 2477,
          "stripped": "عن أبي إسحاق، عن عمرو بن ميمون، قال:",
          "span_id": "s033"
        }
      ]
    },
    {
      "id": "s034",
      "start": 2477,
      "end": 2538,
      "text": " أدركتُ أصحابَ رسولِ اللهِ - صلى الله عليه وسلم - وهم يقولون:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2506,
          "end": 2524,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 2538,
      "end": 2609,
      "text": " المساجدُ بيوتُ اللهِ، وإنه حقٌّ على اللهِ أن يُكْرِمَ مَنْ زارَه فيها ",
      "markers": []
    },
    {
      "id": "s036",
      "start": 2634,
      "end": 2680,
      "text": ".حدَّثنا ابن حميدٍ، قال: ثنا ابن المباركِ، عن ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 2635,
          "end": 2642,
          "span_id": "s036"
        }
      ]
    },
    {
      "id": "s037",
      "start": 2695,
      "end": 2696,
      "text": " ",
      "markers": []
    },
    {
      "id": "s038",
      "start": 2895,
      "end": 2949,
      "text": " في قولِه: {فِي بُيُوتٍ أَذِنَ اللَّهُ أَنْ تُرْفَعَ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 2906,
          "end": 2948,
          "span_id": "s038"
        }
      ]
    },
    {
      "id": "s039",
      "start": 2949,
      "end": 2986,
      "text": " قال: هي المساجدُ.حدَّثني يونسُ، قال:",
      "markers": []
    },
    {
      "id": "s040",
      "start": 2986,
      "end": 3032,
      "text": " أخبَرنا ابن وهبٍ، قال: قال ابن زيدٍ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2987,
          "end": 2994,
          "span_id": "s040"
        },
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 3014,
          "end": 3021,
          "span_id": "s040"
        }
      ]
    },
    {
      "id": "s041",
      "start": 3032,
      "end": 3077,
      "text": " {فِي بُيُوتٍ أَذِنَ اللَّهُ أَنْ تُرْفَعَ}. ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3033,
          "end": 3075,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 3081,
      "end": 3133,
      "text": "قال: المساجدُ.وقال آخرون: عَنَى بذلك البيوتَ كلَّها.",
      "markers": []
    },
    {
      "id": "s043",
      "start": 3133,
      "end": 3238,
      "text": "ذكرُ مَن قال ذلكحدَّثنا ابن حُميدٍ ونصرُ بنُ عبدِ الرحمنِ الأَوْدِيُّ، قالا: حدَّثنا حَكَّامُ بنُ سَلْمٍ ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3149,
          "end": 3156,
          "span_id": "s043"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 3210,
          "end": 3217,
          "span_id": "s043"
        }
      ]
    },
    {
      "id": "s044",
      "start": 3275,
      "end": 3313,
      "text": "، عن إسماعيلَ بن أبي خالدٍ، عن عكرمةَ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3277,
          "end": 3313,
          "stripped": "عن إسماعيل بن أبي خالد، عن عكرمة:",
          "span_id": "s044"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 3306,
          "end": 3311,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3313,
      "end": 3381,
      "text": " {فِي بُيُوتٍ أَذِنَ اللَّهُ أَنْ تُرْفَعَ}. قال: هي البيوتُ كلُّها ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3314,
          "end": 3356,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3457,
      "end": 3502,
      "text": ".وإنما اخْتَرْنا القولَ الذي اخترْناه في ذلك؛",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3502,
      "end": 3635,
      "text": " لدَلالةِ قولِه: {يُسَبِّحُ لَهُ فِيهَا بِالْغُدُوِّ وَالْآصَالِ رِجَالٌ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3519,
          "end": 3634,
          "span_id": "s047"
        }
      ]
    },
    {
      "id": "s048",
      "start": 3635,
      "end": 3682,
      "text": " على أنها بيوتٌ بُنِيَتْ للصلاةِ، فلذلك قُلْنا:",
      "markers": []
    },
    {
      "id": "s049",
      "start": 3682,
      "end": 3735,
      "text": " هي المساجدُ.واخْتَلَف أهلُ التأويلِ في تأويلِ قولِه:",
      "markers": []
    },
    {
      "id": "s050",
      "start": 3735,
      "end": 3780,
      "text": " {أَذِنَ اللَّهُ أَنْ تُرْفَعَ}، فقال بعضُهم:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3736,
          "end": 3766,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 3780,
      "end": 3810,
      "text": " معناه: أذِن اللهُ أن تُبْنَى.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 3781,
          "end": 3786,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 3810,
      "end": 3855,
      "text": "ذكرُ مَن قال ذلكحدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s053",
      "start": 3855,
      "end": 3908,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، وحدَّثني الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s054",
      "start": 3908,
      "end": 3974,
      "text": " ثنا الحسنُ، قال: ثنا ورقاءُ، جميعًا عن ابن أبي نَجيحٍ، عن مجاهدٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 3913,
          "end": 3918,
          "span_id": "s054"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 3945,
          "end": 3974,
          "stripped": "عن ابن أبي نجيح، عن مجاهد:",
          "span_id": "s054"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3967,
          "end": 3972,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 3974,
      "end": 4020,
      "text": " {أَذِنَ اللَّهُ أَنْ تُرْفَعَ}. قال: تُبْنَى ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3975,
          "end": 4005,
          "span_id": "s055"
        }
      ]
    },
    {
      "id": "s056",
      "start": 4093,
      "end": 4102,
      "text": ".حدَّثنا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4094,
          "end": 4101,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4106,
      "end": 4137,
      "text": "القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": []
    },
    {
      "id": "s058",
      "start": 4137,
      "end": 4180,
      "text": " ثني حجاجٌ، عن ابن جُريجٍ، عن مجاهدٍ مثلَه.",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4149,
          "end": 4180,
          "stripped": "عن ابن جريج، عن مجاهد مثله.",
          "span_id": "s058"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 4152,
          "end": 4161,
          "span_id": "s058"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 4167,
          "end": 4172,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4180,
      "end": 4223,
      "text": "وقال آخرون: معناه: أذِن اللهُ أن تُعَظَّمَ.",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 4192,
          "end": 4197,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4223,
      "end": 4268,
      "text": "ذكرُ مَن قال ذلكحدَّثنا الحسنُ بنُ يحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4239,
          "end": 4246,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4268,
      "end": 4334,
      "text": " أخبَرنا عبدُ الرَّزَّاقِ، قال: أخبَرنا معمرٌ، عن الحسنِ في قولِه:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4269,
          "end": 4276,
          "span_id": "s061"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 4269,
          "end": 4323,
          "stripped": "أخبرنا عبد الرزاق، قال: أخبرنا معمر، عن الحسن",
          "span_id": "s061"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4300,
          "end": 4307,
          "span_id": "s061"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 4318,
          "end": 4323,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 4334,
      "end": 4397,
      "text": " {أَذِنَ اللَّهُ أَنْ تُرْفَعَ}. يقولُ: أن تُعَظَّمَ لِذِكْرِه ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4335,
          "end": 4365,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 4429,
      "end": 4507,
      "text": ".وأوْلَى القولَيْن في ذلك عندى بالصوابِ القولُ الذي قاله مجاهدٌ، وهو أن معناه:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 4486,
          "end": 4491,
          "span_id": "s063"
        },
        {
          "family": "LUGHA",
          "marker": "معناه",
          "start": 4501,
          "end": 4506,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 4507,
      "end": 4537,
      "text": " أذِن اللهُ أن تُرْفَعَ بناءً.",
      "markers": []
    },
    {
      "id": "s065",
      "start": 4537,
      "end": 4618,
      "text": " كما قال جلَّ ثناؤُه: {وَإِذْ يَرْفَعُ إِبْرَاهِيمُ الْقَوَاعِدَ مِنَ الْبَيْتِ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4559,
          "end": 4617,
          "span_id": "s065"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 4618,
          "end": 4631,
          "text": "[البقرة: 127]",
          "via": "apparatus",
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 4631,
      "end": 4701,
      "text": ". وذلك أن ذلك هو الأَغْلَبُ مِن معنى الرَّفْعِ في البيوتِ والأبْنيَةِ.",
      "markers": []
    },
    {
      "id": "s067",
      "start": 4701,
      "end": 4744,
      "text": "وقولُه: {وَيُذْكَرَ فِيهَا اسْمُهُ}. يقولُ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4709,
          "end": 4736,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 4744,
      "end": 4783,
      "text": " وأذِن لعبادِه أن يَذْكُروا اسمَه فيها.",
      "markers": []
    },
    {
      "id": "s069",
      "start": 4783,
      "end": 4838,
      "text": " وقد قِيلَ: عَنَى به أنه أذِن لهم بتلاوةِ القرآنِ فيها.",
      "markers": []
    },
    {
      "id": "s070",
      "start": 4838,
      "end": 4873,
      "text": "ذكرُ مَن قال ذلكحدَّثني عليُّ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 4862,
          "end": 4865,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 4873,
      "end": 4936,
      "text": " ثنا عبدُ اللهِ، قال: ثنى معاويةُ، عن عليٍّ، عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4908,
          "end": 4936,
          "stripped": "عن علي، عن ابن عباس، قال:",
          "span_id": "s071"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 4911,
          "end": 4914,
          "span_id": "s071"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4921,
          "end": 4929,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 4936,
      "end": 5001,
      "text": " ثم قال: {وَيُذْكَرَ فِيهَا اسْمُهُ}. يقولُ: يُتْلَى فيها كتابُه ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4945,
          "end": 4972,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 5060,
      "end": 5126,
      "text": ".وهذا القولُ قريبُ المعنى مما قُلْناه في ذلك؛ لأن تلاوةَ كتابِ الل",
      "markers": []
    },
    {
      "id": "s074",
      "start": 5130,
      "end": 5224,
      "text": "هِ مِن معاني ذكرِ اللهِ، غير أن الذي قلنا به أَظْهَرُ مَعْنَيَيْهِ، فلذلك اخْتَرْنا القولَ به.",
      "markers": []
    },
    {
      "id": "s075",
      "start": 5224,
      "end": 5348,
      "text": "وقولُه: {يُسَبِّحُ لَهُ فِيهَا بِالْغُدُوِّ وَالْآصَالِ رِجَالٌ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5232,
          "end": 5347,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 5348,
      "end": 5384,
      "text": " اخْتَلَفَت القرأةُ في قراءةِ قولِه:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 5362,
          "end": 5365,
          "span_id": "s076"
        },
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 5371,
          "end": 5376,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 5384,
      "end": 5434,
      "text": " {يُسَبِّحُ لَهُ}؛ فقرَأ ذلك عامةُ قرأةِ الأمصارِ:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5385,
          "end": 5401,
          "span_id": "s077"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 5404,
          "end": 5408,
          "span_id": "s077"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 5419,
          "end": 5422,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 5434,
      "end": 5479,
      "text": " {يُسَبِّحُ لَهُ} بضَمِّ الياءِ وكسرِ الباءِ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5435,
          "end": 5451,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 5568,
      "end": 5690,
      "text": "، بمعنى: يُصَلِّي له فيها رجالٌ، وبجَعْلِ {يُسَبِّحُ} فِعْلًا لـ \"الرجالِ\" وخبرًا عنهم، ويُرْفَعُ به \"الرجالُ\"، سوى عاصمٍ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5610,
          "end": 5621,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 5709,
      "end": 5741,
      "text": " وابنِ عامرٍ، فإنهما قَرَأا ذلك:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 5730,
          "end": 5735,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 5741,
      "end": 5868,
      "text": " (يُسَبَّحُ له) بضمِّ الياءِ وفتحِ الباءِ، على ما لم يُسَمَّ فاعِلُه، ثم يَرْفَعان \"الرجالَ\" بخبرٍ ثانٍ مُضْمَرٍ، كأنهما أرادا:",
      "markers": []
    },
    {
      "id": "s082",
      "start": 5868,
      "end": 5943,
      "text": " يُسَبَّحُ اللهِ في البيوتِ التي أذِن اللهُ أن تُرْفَعَ، يُسبَّحُ له رجالٌ.",
      "markers": []
    },
    {
      "id": "s083",
      "start": 5943,
      "end": 6076,
      "text": " فرَفَعا الرجالَ بفِعْلٍ مُضْمَرٍ.والقراءةُ التي هي أَوْلاهما بالصوابِ قراءةُ مَن كسَر الباءَ، وجعَله خبرًا لـ \"الرجالِ\" وفِعلًا لهم.",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 5980,
          "end": 5985,
          "span_id": "s083"
        },
        {
          "family": "QIRAAT",
          "marker": "قراءة",
          "start": 6014,
          "end": 6019,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 6076,
      "end": 6150,
      "text": " وإنما كان الاختيارُ رفعَ \"الرجالِ\" بمُضْمَرٍ مِن الفعلِ لو كان الخبرُ عن ",
      "markers": []
    },
    {
      "id": "s085",
      "start": 6154,
      "end": 6186,
      "text": "\"البيوتِ\" لا يَتِمُّ إلا بقولِه:",
      "markers": []
    },
    {
      "id": "s086",
      "start": 6186,
      "end": 6271,
      "text": " {يُسَبِّحُ لَهُ فِيهَا}. فأمَّا والخبرُ عنها دونَ ذلك تامٌّ، فلا وجهَ لتوجيهِ قولِه:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6187,
          "end": 6210,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 6271,
      "end": 6326,
      "text": " {يُسَبِّحُ لَهُ} إلى غيره؛ إلى غيرِ الخبرِ عن الرجالِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6272,
          "end": 6288,
          "span_id": "s087"
        }
      ]
    },
    {
      "id": "s088",
      "start": 6326,
      "end": 6390,
      "text": "وعَنَى بقولِه: {يُسَبِّحُ لَهُ فِيهَا بِالْغُدُوِّ وَالْآصَالِ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6341,
          "end": 6389,
          "span_id": "s088"
        }
      ]
    },
    {
      "id": "s089",
      "start": 6390,
      "end": 6451,
      "text": " يُصَلَّى له في هذه البيوتِ بالغَدَوَاتِ والعَشِيَّاتِ رجالٌ.",
      "markers": []
    },
    {
      "id": "s090",
      "start": 6451,
      "end": 6493,
      "text": "وبنحوِ الذي قلنا في ذلك قال أهلُ التأويلِ.",
      "markers": []
    },
    {
      "id": "s091",
      "start": 6493,
      "end": 6551,
      "text": "ذكرُ مَن قال ذلكحدَّثني عليُّ بنُ الحسنِ الأَزْدَيُّ، قال:",
      "markers": []
    },
    {
      "id": "s092",
      "start": 6551,
      "end": 6651,
      "text": " ثنا المُعافَى بنُ عِمرانَ، عن سفيانَ، عن عمَّارٍ الدُّهْنيِّ، عن سعيدِ بن جبيرٍ، عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6579,
          "end": 6635,
          "stripped": "عن سفيان، عن عمار الدهني، عن سعيد بن جبير، عن",
          "span_id": "s092"
        },
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "NARRATOR",
          "start": 6617,
          "end": 6630,
          "span_id": "s092"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6636,
          "end": 6644,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 6651,
      "end": 6685,
      "text": " كلُّ تسبيحٍ في القرآنِ فهو صلاةٌ ",
      "markers": []
    },
    {
      "id": "s094",
      "start": 6839,
      "end": 6880,
      "text": ".حدَّثني عليٌّ، قال: ثنا عبدُ اللهِ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 6848,
          "end": 6851,
          "span_id": "s094"
        }
      ]
    },
    {
      "id": "s095",
      "start": 6880,
      "end": 6922,
      "text": " ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6894,
          "end": 6922,
          "stripped": "عن علي، عن ابن عباس، قال:",
          "span_id": "s095"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 6897,
          "end": 6900,
          "span_id": "s095"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6907,
          "end": 6915,
          "span_id": "s095"
        }
      ]
    },
    {
      "id": "s096",
      "start": 6922,
      "end": 6980,
      "text": " ثم قال: {يُسَبِّحُ لَهُ فِيهَا بِالْغُدُوِّ وَالْآصَالِ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6931,
          "end": 6979,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 6980,
      "end": 7168,
      "text": " يقولُ: يُصَلِّي له فيها بالغَداةِ والعَشِيِّ، يعنى بالغُدُوِّ صلاةَ الغَداةِ، ويعنى بالآصالِ صلاةَ العصرِ، وهما أَوَّلُ ما افْتَرَض اللهُ مِن الصلاةِ، فأَحَبَّ أن يَذْكُرَهما، ويُذَكِّرَ ",
      "markers": []
    },
    {
      "id": "s098",
      "start": 7185,
      "end": 7186,
      "text": " ",
      "markers": []
    },
    {
      "id": "s099",
      "start": 7310,
      "end": 7357,
      "text": ".حدَّثنا الحسنُ، قال: أخبَرنا عبد الرزاقِ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7311,
          "end": 7318,
          "span_id": "s099"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 7311,
          "end": 7357,
          "stripped": "حدثنا الحسن، قال: أخبرنا عبد الرزاق، قال:",
          "span_id": "s099"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 7319,
          "end": 7324,
          "span_id": "s099"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 7332,
          "end": 7339,
          "span_id": "s099"
        }
      ]
    },
    {
      "id": "s100",
      "start": 7357,
      "end": 7465,
      "text": " أخبَرنا معمرٌ، عن الحسنِ: {يُسَبِّحُ لَهُ فِيهَا بِالْغُدُوِّ وَالْآصَالِ رِجَالٌ}: أذِن اللهُ أن تُبْنَى، ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 7358,
          "end": 7365,
          "span_id": "s100"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 7376,
          "end": 7381,
          "span_id": "s100"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7384,
          "end": 7440,
          "span_id": "s100"
        }
      ]
    },
    {
      "id": "s101",
      "start": 7479,
      "end": 7480,
      "text": " ",
      "markers": []
    },
    {
      "id": "s102",
      "start": 7555,
      "end": 7579,
      "text": " فيها بالغدوِّ والآصالِ ",
      "markers": []
    },
    {
      "id": "s103",
      "start": 7602,
      "end": 7662,
      "text": ".حُدِّثتُ عن الحسينُ، قال: سَمِعْتُ أبا معاذٍ يقولُ في قوله:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "معاذ",
          "name": "معاذ",
          "role": "SPEAKER",
          "start": 7642,
          "end": 7646,
          "span_id": "s103"
        }
      ]
    },
    {
      "id": "s104",
      "start": 7662,
      "end": 7737,
      "text": " {يُسَبِّحُ لَهُ فِيهَا بِالْغُدُوِّ وَالْآصَالِ}: يعنى الصلاةَ المفروضةَ. ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7663,
          "end": 7711,
          "span_id": "s104"
        }
      ]
    }
  ],

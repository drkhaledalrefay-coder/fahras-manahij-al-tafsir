          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 1746,
      "end": 1776,
      "text": " يعنى كلَّ مسجدٍ يُصَلَّى فيه؛",
      "markers": []
    },
    {
      "id": "s023",
      "start": 1776,
      "end": 1821,
      "text": " جامعٍ أو غيرِه.حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {

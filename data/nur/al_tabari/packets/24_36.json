          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 1702,
      "end": 1746,
      "text": " {فِي بُيُوتٍ أَذِنَ اللَّهُ أَنْ تُرْفَعَ}:",
      "markers": [
        {
          "family": "QURAN",

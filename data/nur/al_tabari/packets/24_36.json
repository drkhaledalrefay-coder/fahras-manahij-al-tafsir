      "markers": "نزلت في، سبب نزول، فأنزل الله، فنزلت"
    },
    {
      "id": "M_SIRA",
      "name_ar": "المغازي والسيرة",
      "when": "واقعة من السيرة تُستخدم لشرح خطاب الآية أو تطبيقه.",
      "exclude": "ورود اسم غزوة عرضاً.",
      "markers": "يوم بدر، غزوة، يوم أحد، خرج رسول الله"

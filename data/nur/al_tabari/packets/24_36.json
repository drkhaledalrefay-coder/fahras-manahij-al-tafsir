  "spans": [
    {
      "id": "s001",
      "start": 4,
      "end": 34,
      "text": " القولُ في تأويلِ قولِه تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قوله تعالى",
          "start": 22,
          "end": 33,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 34,
      "end": 461,
      "text": " {فِي بُيُوتٍ أَذِنَ اللَّهُ أَنْ تُرْفَعَ وَيُذْكَرَ فِيهَا اسْمُهُ يُسَبِّحُ لَهُ فِيهَا بِالْغُدُوِّ وَالْآصَالِ (36) رِجَالٌ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ وَإِقَامِ الصَّلَاةِ وَإِيتَاءِ الزَّكَاةِ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ وَالْأَبْصَارُ (37) لِيَجْزِيَهُمُ اللَّهُ أَحْسَنَ مَا عَمِلُوا وَيَزِيدَهُمْ مِنْ فَضْلِهِ وَاللَّهُ يَرْزُقُ مَنْ يَشَاءُ بِغَيْرِ حِسَابٍ (38)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 35,
          "end": 460,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 461,
      "end": 529,
      "text": "يعنى تعالى ذكرُه بقولِه: {فِي بُيُوتٍ أَذِنَ اللَّهُ أَنْ تُرْفَعَ}:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 486,
          "end": 528,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 529,
      "end": 625,
      "text": " اللهُ نورُ السماواتِ والأرضِ، مَثَلُ نورِه كمشكاةٍ فيها مصباحٌ في بيوتٍ أذِن اللهُ أن تُرْفَعَ.",
      "markers": []
    },
    {
      "id": "s005",
      "start": 625,
      "end": 671,
      "text": "كما حدَّثني يونسُ، قال: أخبَرنا ابن وهبٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 649,
          "end": 656,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 671,
      "end": 736,
      "text": " قال ابن زيدٍ: المشكاةُ التي فيها الفَتِيلَةُ التي فيها المصباحُ.",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن زيد",
          "name": "ابن زيد",
          "role": "SPEAKER",
          "start": 676,
          "end": 683,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 736,
      "end": 786,
      "text": " قال: المصابيحُ في بيوتٍ أذِنِ اللهُ أَن تُرْفَعَ ",
      "markers": []
    },
    {
      "id": "s008",
      "start": 841,
      "end": 919,
      "text": ".قال أبو جعفرٍ: قد يَحْتَمِلُ أن تكونَ \"في\" مِنْ صلةِ {يُوقَدُ} فيكونَ المعنى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 895,
          "end": 904,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 919,
      "end": 1029,
      "text": " يُوقدُ مِن شجرةٍ مُبارَكة، ذلك المصباحُ في بيوتٍ أَذِن اللهُ أن تُرفَعَ.وعَنَى بالبيوتِ المساجدَ.وقد اخْتَلف ",
      "markers": []
    },
    {
      "id": "s010",
      "start": 1033,
      "end": 1087,
      "text": "أهلُ التأويلِ في ذلك؛ فقال بعضُهم بالذي قُلْنا في ذلك.",
      "markers": []
    },
    {
      "id": "s011",
      "start": 1087,
      "end": 1162,
      "text": "ذكرُ مَن قال ذلكحدَّثنا ابن حُميدٍ ونصرُ بنُ عبدِ الرحمنِ الأوْدِيُّ، قالا:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1103,
          "end": 1110,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 1162,
      "end": 1230,
      "text": " ثنا حَكَّامٌ، عن إسماعيلَ بن أبي خالدٍ، عن أبي صالحٍ في قولِ اللهِ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1177,
          "end": 1222,
          "stripped": "عن إسماعيل بن أبي خالد، عن أبي صالح في قول",
          "span_id": "s012"
        }
      ]
    },
    {
      "id": "s013",
      "start": 1230,
      "end": 1289,
      "text": " {فِي بُيُوتٍ أَذِنَ اللَّهُ أَنْ تُرْفَعَ}. قال: المساجدُ ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1231,
          "end": 1273,
          "span_id": "s013"
        }
      ]
    },
    {
      "id": "s014",
      "start": 1334,
      "end": 1374,
      "text": ".حدَّثني عليٌّ، قال: ثنا أبو صالحٍ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "SPEAKER",
          "start": 1343,
          "end": 1346,
          "span_id": "s014"
        }
      ]
    },
    {
      "id": "s015",
      "start": 1374,
      "end": 1420,
      "text": " ثني معاويةُ، عن عليٍّ، عن ابن عباسٍ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1388,
          "end": 1420,
          "stripped": "عن علي، عن ابن عباس في قوله:",
          "span_id": "s015"
        },
        {

    {
      "id": "s001",
      "start": 4,
      "end": 207,
      "text": " القولُ في تأويل قوله: {يَاأَيُّهَا الَّذِينَ آمَنُوا لَا تَدْخُلُوا بُيُوتًا غَيْرَ بُيُوتِكُمْ حَتَّى تَسْتَأْنِسُوا وَتُسَلِّمُوا عَلَى أَهْلِهَا ذَلِكُمْ خَيْرٌ لَكُمْ لَعَلَّكُمْ تَذَكَّرُونَ (27)}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 27,
          "end": 206,
          "span_id": "s001"
        }
      ]
    },
    {
      "id": "s002",
      "start": 207,
      "end": 235,
      "text": "اختلَف أهلُ التأويلِ في ذلك؛",
      "markers": []
    },
    {
      "id": "s003",
      "start": 235,
      "end": 322,
      "text": " فقال بعضُهم: تأويلُه: يأيها الذين آمنوا لا تَدخُلوا بيوتًا غيرَ بيوتِكم حتى تستأذِنوا.",
      "markers": []
    },
    {
      "id": "s004",
      "start": 322,
      "end": 371,
      "text": "ذكرُ مَن قال ذلكحدَّثني يعقوبُ بنُ إبراهيمَ، قال:",
      "markers": []
    },
    {
      "id": "s005",
      "start": 371,
      "end": 443,
      "text": " ثنا هشيمٌ، عن أبي بشرٍ، عن سعيدِ بن جبيرٍ، عن ابن عباسٍ أنه كان يقرَأُ:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 383,
          "end": 417,
          "stripped": "عن أبي بشر، عن سعيد بن جبير، عن",
          "span_id": "s005"
        },
        {

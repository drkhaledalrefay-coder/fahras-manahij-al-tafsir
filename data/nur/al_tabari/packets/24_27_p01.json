    },
    {
      "id": "s006",
      "start": 443,
      "end": 493,
      "text": " (لا تَدْخُلُوا بيوتًا غيرَ بيوتِكم حتى تستأذِنوا ",
      "markers": []
    },
    {
      "id": "s007",
      "start": 512,
      "end": 587,
      "text": " وتُسَلِّموا على أهلِها). قال: وإنما {تَسْتَأْنِسُوا} وَهُمٌ مِن الكتَّابِ ",

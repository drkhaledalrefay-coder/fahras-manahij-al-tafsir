    {
      "id": "s031",
      "start": 2784,
      "end": 2834,
      "text": " ثنى هشيمٌ، قال: أخبَرنا مغيرةُ، عن إبراهيمَ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 2801,
          "end": 2808,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 2834,
      "end": 2904,
      "text": " في مصحفِ ابن مسعودٍ: (حتى تُسَلِّموا علَى أَهْلِها وَتَسْتَأْذِنُوا) ",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن مسعود",
          "name": "ابن مسعود",
          "role": "SPEAKER",
          "start": 2844,
          "end": 2853,
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 3022,
      "end": 3044,
      "text": ". قال: ثنا هشيمٌ، قال:",
      "markers": []
    },
    {
      "id": "s034",
      "start": 3044,
      "end": 3076,
      "text": " أخبَرنا جعفرُ بنُ إياسٍ، عن سعي",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3045,
          "end": 3052,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 3080,
      "end": 3113,
      "text": "دٍ، عن ابن عباسٍ أنه كان يقرؤُها:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 3087,
          "end": 3095,
          "span_id": "s035"
        }
      ]
    },
    {
      "id": "s036",
      "start": 3113,
      "end": 3232,
      "text": " (يَأَيُّهَا الَّذِينَ آمَنُوا لا تَدْخُلُوا بُيُوتا غيرَ بُيُوتِكُمْ حتى تُسَلِّمُوا عَلَى أَهْلِها وَتَسْتَأْذِنُوا).",
      "markers": []
    },
    {
      "id": "s037",
      "start": 3232,
      "end": 3283,
      "text": " قال: وإنما {تَسْتَأْنِسُوا} وَهُمٌ مِن الكُتَّابِ.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 3244,
          "end": 3260,
          "span_id": "s037"
        }
      ]
    },
    {
      "id": "s038",
      "start": 3283,
      "end": 3311,
      "text": "قال: ثنا هشيمٌ، قال مُغيرةُ:",
      "markers": []
    },
    {
      "id": "s039",
      "start": 3311,
      "end": 3369,
      "text": " قال مجاهدٌ: جاء ابن عمرَ مِن حاجةٍ، وقد آذاه الرَّمْضاءُ ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 3316,
          "end": 3321,
          "span_id": "s039"
        }
      ]
    },
    {
      "id": "s040",
      "start": 3428,
      "end": 3467,
      "text": "، فأتَى فُسطاطَ امرأةٍ مِن قريشٍ، فقال:",
      "markers": []
    },
    {
      "id": "s041",
      "start": 3467,
      "end": 3510,
      "text": " السلامُ عليكم، أدخلُ؟ فقالت: ادخُل بسلامٍ.",
      "markers": []
    },
    {
      "id": "s042",
      "start": 3510,
      "end": 3554,
      "text": " فأعاد، فأعادَت، وهو يراوحُ بين قدمَيه، قال:",
      "markers": []
    },
    {
      "id": "s043",
      "start": 3554,
      "end": 3590,
      "text": " قولِى: ادخُلْ. قالت: ادخُلْ. فدخَل ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 3634,
      "end": 3800,
      "text": ".قال: ثنا هشيمٌ، قال: أخبَرنا منصورٌ، عن ابن سيرينَ، وأخبَرنا يونسُ بنُ عُبيدٍ، عن عمرِو بن سعيدٍ الثقفيِّ، أن رجلًا استأذَن على النبيِّ - صلى الله عليه وسلم -، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3656,
          "end": 3663,
          "span_id": "s044"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 3688,
          "end": 3695,
          "span_id": "s044"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3773,
          "end": 3791,
          "span_id": "s044"
        }
      ]
    },
    {
      "id": "s045",
      "start": 3800,
      "end": 3913,
      "text": " أَلِجُ أو أَنَلِجُ؟ فقال النبيُّ - صلى الله عليه وسلم - لأمَةٍ له يقالُ لها رَوْضَةُ: \"قومِي إلى هذا فَكَلِّميه ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3836,
          "end": 3854,
          "span_id": "s045"
        },
        {
          "family": "LUGHA",
          "marker": "يقال",
          "start": 3867,
          "end": 3871,
          "span_id": "s045"
        }
      ]
    },
    {
      "id": "s046",
      "start": 3941,
      "end": 3995,
      "text": "، فإِنَّهُ لا يُحْسِنُ يَسْتَأْذِنُ، فَقُولى له يقولُ:",
      "markers": []
    },
    {
      "id": "s047",
      "start": 3995,
      "end": 4062,
      "text": " السلامُ عليكم، أدْخُلُ؟ \". فسمِعها الرجلُ فقالها، فقال: \"ادْخُلْ\" ",
      "markers": []
    },
    {
      "id": "s048",
      "start": 4157,
      "end": 4211,
      "text": ".حدَّثنا الحسينُ، قال: ثنا حجاجٌ، عن ابن جُرَيجٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4158,
          "end": 4165,
          "span_id": "s048"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 4194,
          "end": 4204,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 4211,
      "end": 4257,
      "text": " قال ابن عباسٍ قولَه: {حَتَّى تَسْتَأْنِسُوا}.",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 4216,
          "end": 4224,
          "span_id": "s049"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4233,
          "end": 4256,
          "span_id": "s049"
        }
      ]
    },
    {
      "id": "s050",
      "start": 4257,
      "end": 4297,
      "text": " قال: الاستئذانُ، ثم نُسِخ واسْتُثْنِىَ:",
      "markers": []
    },
    {
      "id": "s051",
      "start": 4297,
      "end": 4370,
      "text": " {لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَدْخُلُوا بُيُوتًا غَيْرَ مَسْكُونَةٍ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4298,
          "end": 4369,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 4460,
      "end": 4511,
      "text": ".حدَّثنا ابن حميدٍ، قال: ثنا يَحيى بنُ واضِحٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4461,
          "end": 4468,
          "span_id": "s052"
        }
      ]
    },
    {
      "id": "s053",
      "start": 4511,
      "end": 4559,
      "text": " ثنا أبو حمزةَ، عن المُغيرةِ، عن إبراهيمَ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4527,
          "end": 4559,
          "stripped": "عن المغيرة، عن إبراهيم قوله:",
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 4559,
      "end": 4605,
      "text": " {لَا تَدْخُلُوا بُيُوتًا غَيْرَ بُيُوتِكُمْ}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4560,
          "end": 4604,
          "span_id": "s054"
        }
      ]
    },
    {
      "id": "s055",
      "start": 4605,
      "end": 4649,
      "text": " قال: حتى تُسلِّموا على أهلِها وتَستَأذِنوا.",
      "markers": []
    },
    {
      "id": "s056",
      "start": 4649,
      "end": 4679,
      "text": "حدَّثنا الحسنُ بنُ يَحيى، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4649,
          "end": 4656,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 4679,
      "end": 4733,
      "text": " أخبَرنا عبدُ الرزاقِ، قال: أخبَرنا معمرٌ، عن قَتادةَ:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4680,
          "end": 4687,
          "span_id": "s057"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 4680,
          "end": 4733,
          "stripped": "أخبرنا عبد الرزاق، قال: أخبرنا معمر، عن قتادة:",
          "span_id": "s057"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4707,
          "end": 4714,
          "span_id": "s057"
        },
        {
          "family": "TABIIN",
          "marker": "قتادة",
          "name": "قتادة",
          "role": "SPEAKER",
          "start": 4725,
          "end": 4731,
          "span_id": "s057"
        }
      ]
    },
    {
      "id": "s058",
      "start": 4733,
      "end": 4789,
      "text": " {حَتَّى تَسْتَأْنِسُوا}. قال: حتى تَستأذنوا وتُسلِّموا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 4734,
          "end": 4757,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 4813,
      "end": 4853,
      "text": ".حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 4814,
          "end": 4821,
          "span_id": "s059"
        }
      ]
    },
    {
      "id": "s060",
      "start": 4853,
      "end": 4931,
      "text": " ثنا هشيمٌ، قال: أخبرَنا أشعتُ بنُ سَوَّارٍ، عن كُرْدُوسٍ، عن ابن مسعودٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 4870,
          "end": 4877,
          "span_id": "s060"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 4898,
          "end": 4931,
          "stripped": "عن كردوس، عن ابن مسعود، قال:",
          "span_id": "s060"
        },
        {
          "family": "SAHABA",
          "marker": "ابن مسعود",
          "name": "ابن مسعود",
          "role": "SPEAKER",
          "start": 4915,
          "end": 4924,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 4931,
      "end": 4978,
      "text": " عليكم أن تَستأذِنوا على أمهاتِكم وأَخَوَاتِكم ",
      "markers": []
    },
    {
      "id": "s062",
      "start": 5069,
      "end": 5125,
      "text": ".قال أشعثُ، عن عديِّ بن ثابتٍ، أنَّ امرأةً مِن الأنصارِ ",
      "markers": []
    },
    {
      "id": "s063",
      "start": 5129,
      "end": 5222,
      "text": "قالت: يا رسولَ اللهِ، إِنَّى أكونُ في منزلِى على الحالِ التي لا أُحِبُّ أن يَرانى أحدٌ عليها؛",
      "markers": []
    },
    {
      "id": "s064",
      "start": 5222,
      "end": 5304,
      "text": " والدٌ ولا ولَدٌ، وإنه لا يَزالُ يَدخُلُ عليَّ رجُلٌ مِن أهلى وأنا على تلك الحالِ.",
      "markers": []
    },
    {
      "id": "s065",
      "start": 5304,
      "end": 5452,
      "text": " قال: فنزَلت: {يَاأَيُّهَا الَّذِينَ آمَنُوا لَا تَدْخُلُوا بُيُوتًا غَيْرَ بُيُوتِكُمْ حَتَّى تَسْتَأْنِسُوا وَتُسَلِّمُوا عَلَى {أَهْلِهَا} الآية ",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 5310,
          "end": 5316,
          "span_id": "s065"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5434,
          "end": 5445,
          "span_id": "s065"
        }
      ]
    },
    {
      "id": "s066",
      "start": 5553,
      "end": 5642,
      "text": ".وقال آخرون: معنى ذلك: حتى تُؤنِسوا أهلَ البيتِ بالتَّنَحْنُحِ والتَّنَخُّمِ وما أشْبهَه؛",
      "markers": []
    },
    {
      "id": "s067",
      "start": 5642,
      "end": 5685,
      "text": " حتى يَعلَموا أنكم تُريدون الدُّخولَ عليهم.",
      "markers": []
    },
    {
      "id": "s068",
      "start": 5685,
      "end": 5724,
      "text": "ذكرُ مَن قال ذلكحدَّثنا ابن حميدٍ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5701,
          "end": 5708,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 5724,
      "end": 5823,
      "text": " ثنا حَكَّامٌ، عن عَنبسةَ، عن محمدِ بن عبدِ الرحمنِ، عن القاسمِ بن أبي بَزَّةَ، عن مجاهدٍ في قولِه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5739,
          "end": 5823,
          "stripped": "عن عنبسة، عن محمد بن عبد الرحمن، عن القاسم بن أبي بزة، عن مجاهد في قوله:",
          "span_id": "s069"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "SPEAKER",
          "start": 5807,
          "end": 5812,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 5823,
      "end": 5921,
      "text": " {لَا تَدْخُلُوا بُيُوتًا غَيْرَ بُيُوتِكُمْ حَتَّى تَسْتَأْنِسُوا وَتُسَلِّمُوا عَلَى أَهْلِهَا}.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5824,
          "end": 5920,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 5921,
      "end": 5979,
      "text": " قال: حتى تَتَنَحْنَحوا وتتَنَخَّموا.حدَّثني الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s072",
      "start": 5979,
      "end": 6045,
      "text": " ثنا الحسنُ، قال: ثنا وَرقاءُ، عن ابن أبي نَجيحٍ، عن مجاهدٍ مثلَه ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 5984,
          "end": 5989,
          "span_id": "s072"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6010,
          "end": 6044,
          "stripped": "عن ابن أبي نجيح، عن مجاهد مثله",
          "span_id": "s072"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 6032,
          "end": 6037,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 6216,
      "end": 6246,
      "text": ".حدَّثني محمدُ بنُ عمرٍو، قال:",
      "markers": []
    },
    {
      "id": "s074",
      "start": 6246,
      "end": 6299,
      "text": " ثنا أبو عاصمٍ، قال: ثنا عيسى، وحدَّثني الحارثُ، قال:",
      "markers": []
    },
    {
      "id": "s075",
      "start": 6299,
      "end": 6380,
      "text": " ثنا الحسنُ، قال: ثنا وَرْقاءُ، جميعًا عن ابن أبي نجيحٍ، عن مجاهدٍ في قولِ اللهِ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "SPEAKER",
          "start": 6304,
          "end": 6309,
          "span_id": "s075"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6338,
          "end": 6380,
          "stripped": "عن ابن أبي نجيح، عن مجاهد في قول الله:",
          "span_id": "s075"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 6359,
          "end": 6364,
          "span_id": "s075"
        }
      ]
    },
    {
      "id": "s076",
      "start": 6380,
      "end": 6426,
      "text": " {حَتَّى تَسْتَأْنِسُوا}. قال: حتى تَحَسَّسوا ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6381,
          "end": 6404,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 6443,
      "end": 6494,
      "text": " وتُسلِّموا.حدَّثنا القاسمُ، قال: ثنا الحسينُ، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6455,
          "end": 6462,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 6494,
      "end": 6538,
      "text": " ثني حجاجٌ، عن ابن جُرَيجٍ، عن مجاهدٍ قولَه:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 6506,
          "end": 6538,
          "stripped": "عن ابن جريج، عن مجاهد قوله:",
          "span_id": "s078"
        },
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "NARRATOR",
          "start": 6509,
          "end": 6519,
          "span_id": "s078"
        },
        {
          "family": "TABIIN",
          "marker": "مجاهد",
          "name": "مجاهد",
          "role": "NARRATOR",
          "start": 6525,
          "end": 6530,
          "span_id": "s078"
        }
      ]
    },
    {
      "id": "s079",
      "start": 6538,
      "end": 6594,
      "text": " {حَتَّى تَسْتَأْنِسُوا}. قال: تَنَحْنَحُوا وتَنَخَّموا.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6539,
          "end": 6562,
          "span_id": "s079"
        }
      ]
    },
    {
      "id": "s080",
      "start": 6594,
      "end": 6630,
      "text": "قال: ثني حجاجٌ، عن ابن جُرَيجٍ، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 6613,
          "end": 6623,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 6630,
      "end": 6687,
      "text": " سمِعتُ عطاءَ بنَ أَبِي رَبَاحٍ يُخبرُ عن ابن عباسٍ، قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6672,
          "end": 6680,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 6687,
      "end": 6719,
      "text": " ثلاثُ آياتٍ قد جحَدهنَّ الناسُ؛",
      "markers": []
    },
    {
      "id": "s083",
      "start": 6719,
      "end": 6781,
      "text": " قال اللَّهُ: {إِنَّ أَكْرَمَكُمْ عِنْدَ اللَّهِ أَتْقَاكُمْ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 6733,
          "end": 6780,
          "span_id": "s083"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 6781,
          "end": 6794,
          "text": "[الحجرات: 13]",
          "via": "apparatus",
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 6794,
      "end": 6850,
      "text": ". قال: ويقولون: إِنَّ أكرَمَهم عندَ اللهِ أعظمُهم شأنًا ",
      "markers": []
    },
    {
      "id": "s085",
      "start": 6900,
      "end": 6939,
      "text": ". قال: والإِذْنُ كلُّه قد جحَده الناسُ.",
      "markers": []
    },
    {
      "id": "s086",
      "start": 6939,
      "end": 7009,
      "text": " فقلتُ له: أَستَأْذِنُ على أَخَواتي أيتامٍ في حَجرى معى في بيتٍ واحدٍ؟",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 6941,
          "end": 6944,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 7009,
      "end": 7051,
      "text": " قال: نعم. فردَدْتُ على مَن حضَرني، فأبَى.",
      "markers": []
    },
    {
      "id": "s088",
      "start": 7051,
      "end": 7084,
      "text": " قال: أتُحبُّ أن تَراها عُريانةً؟",
      "markers": []
    },
    {
      "id": "s089",
      "start": 7084,
      "end": 7126,
      "text": " قلتُ: لا. قال: فاستأذِنْ. فراجعتُه أيضًا.",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 7085,
          "end": 7088,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 7126,
      "end": 7174,
      "text": " قال: أتحبُّ أن تُطيعَ اللَّهَ؟ قلتُ: نعم. قال: ",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 7158,
          "end": 7161,
          "span_id": "s090"
        }
      ]
    },
    {
      "id": "s091",
      "start": 7178,
      "end": 7213,
      "text": "فاستأذِنْ. فقال لى سعيدُ بنُ جبيرٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 7197,
          "end": 7211,
          "span_id": "s091"
        }
      ]
    },
    {
      "id": "s092",
      "start": 7213,
      "end": 7263,
      "text": " إنك لَتُرَدِّدُ عليه. قلتُ: أردتُ أن يُرخِّصَ لى ",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 7236,
          "end": 7239,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 7436,
      "end": 7487,
      "text": ".قال ابن جُرَيجٍ: وأخبَرنى ابن طاوسٍ، عن أبيه، قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 7441,
          "end": 7451,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 7487,
      "end": 7550,
      "text": " ما مِن امرأةٍ أَكْرَهُ إليَّ أن أرَى، كأنه يقولُ: عِرْيَتَهَا ",
      "markers": []
    },
    {
      "id": "s095",
      "start": 7586,
      "end": 7619,
      "text": "، أو عُرْيَانةً، مِن ذاتِ مَحرمٍ.",
      "markers": []
    },
    {
      "id": "s096",
      "start": 7619,
      "end": 7646,
      "text": " قال: وكان يُشدِّدُ في ذلك ",
      "markers": []
    },
    {
      "id": "s097",
      "start": 7684,
      "end": 7728,
      "text": ".قال ابن جُرَيجٍ: وقال عطاءُ بنُ أبي رَباحٍ:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 7689,
          "end": 7699,
          "span_id": "s097"
        },
        {
          "family": "TABIIN",
          "marker": "عطاء",
          "name": "عطاء",
          "role": "SPEAKER",
          "start": 7707,
          "end": 7711,
          "span_id": "s097"
        }
      ]
    },
    {
      "id": "s098",
      "start": 7728,
      "end": 7797,
      "text": " {وَإِذَا بَلَغَ الْأَطْفَالُ مِنْكُمُ الْحُلُمَ فَلْيَسْتَأْذِنُوا} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7729,
          "end": 7796,
          "span_id": "s098"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 7797,
          "end": 7808,
          "text": "[النور: 59]",
          "via": "apparatus",
          "span_id": "s098"
        }
      ]
    },
    {
      "id": "s099",
      "start": 7808,
      "end": 7886,
      "text": ". فواجبٌ على الناسِ أجمعينَ إذا احتَلموا أن يَستأذِنوا على مَن كان مِن الناسِ.",
      "markers": []
    },
    {
      "id": "s100",
      "start": 7886,
      "end": 7987,
      "text": " قلتُ لعطاءٍ: أواجبٌ على الرجلِ أن يَستأذنَ على أمِّه ومَنْ وراءها مِن ذاتِ قرابتِه؟ قال: نعم. قلتُ: ",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 7887,
          "end": 7890,
          "span_id": "s100"
        },
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 7981,
          "end": 7984,
          "span_id": "s100"
        }
      ]
    },
    {
      "id": "s101",
      "start": 8001,
      "end": 8002,
      "text": " ",
      "markers": []
    },
    {
      "id": "s102",
      "start": 8070,
      "end": 8156,
      "text": "؟ قال: قولُه: {وَإِذَا بَلَغَ الْأَطْفَالُ مِنْكُمُ الْحُلُمَ فَلْيَسْتَأْذِنُوا} (4).",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8084,
          "end": 8151,
          "span_id": "s102"
        }
      ]
    },
    {
      "id": "s103",
      "start": 8156,
      "end": 8198,
      "text": "قال ابن جُرَيجٍ: وأخبرنى ابن زيادٍ، أن صفو",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "ابن جريج",
          "name": "ابن جريج",
          "role": "SPEAKER",
          "start": 8160,
          "end": 8170,
          "span_id": "s103"
        }
      ]
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s006",
      "start": 493,
      "end": 512,
      "text": "¬في م: \"تستأنسوا\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s007",
      "start": 587,
      "end": 1136,
      "text": "¬أخرجه البيهقى في الشعب (8802) مِن طريق هشيم به، وأخرجه ابن أبي حاتم في تفسيره 8/ 2566، والبيهقي في الشعب (8801)، والضياء في المختارة 10/ 91 (87) مِن طريق أبي بشر به بنحوه، وعزاه السيوطي في الدر المنثور 5/ 38 إلى الفريابي وسعيد بن منصور وعبد بن حميد وابن المنذر وابن الأنباري في المصاحف.وقال أبو حيان في البحر المحيط 6/ 445: ومن روى عن ابن عباس أن قوله: {تَسْتَأْنِسُوا} خطأ أووهم مِن الكاتب وأنه قرأ (حتى تستأذنوا) فهو طاعن في الإسلام ملحد <br>في الدين، وابن عباس برئ مِن هذا القول ... . وقال ابن كثير في تفسيره 6/ 38: وهذا غريب جدًّا عن ابن عباس.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s011",
      "start": 1389,
      "end": 1406,
      "text": "¬في م: \"الكاتب\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s012",
      "start": 1434,
      "end": 1662,
      "text": "¬ذكره ابن كثير في تفسيره 6/ 38 عن المصنف، وأخرجه البيهقى في الشعب (8804)، والضياء في المختارة 10/ 90 (86) مِن طريق شعبة به، وأخرجه الحاكم، 2/ 396، والبيهقي في الشعب (8803) مِن طريق شعبة، عن أبي بشر، عن مجاهد، عن ابن عباس بنحوه.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s020",
      "start": 2120,
      "end": 2152,
      "text": "¬ذكره ابن كثير في تفسيره 6/ 38.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s025",
      "start": 2381,
      "end": 2415,
      "text": "¬تفسير سفيان ص 224 بنحوه مختصرًا.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s029",
      "start": 2669,
      "end": 2744,
      "text": "¬عزاه السيوطي في الدر المنثور 5/ 38 إلى المصنف وسعيد بن منصور وابن مردويه.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s032",
      "start": 2904,
      "end": 3022,
      "text": "¬أخرجه البيهقى في الشعب (8800) مِن طريق مغيرة به، وعزاه السيوطي في الدر المنثور 5/ 38 إلى سعيد بن منصور وعبد بن حميد.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s039",
      "start": 3369,
      "end": 3428,
      "text": "¬الرَّمضاء: اسم للأرض الشديدة الحرارة. تاج العروس (ر م ض).¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s043",
      "start": 3590,
      "end": 3634,
      "text": "¬ذكره ابن كثير في تفسيره 6/ 39 عن مغيرة به.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s045",
      "start": 3913,
      "end": 3941,
      "text": "¬في الدر المنثور: \"فعلميه\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s047",
      "start": 4062,
      "end": 4157,
      "text": "¬ذكره ابن كثير في تفسيره 6/ 39 عن هشيم <br>به، وعزاه السيوطي في الدر المنثور 5/ 38 إلى المصنف.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s051",
      "start": 4370,
      "end": 4460,
      "text": "¬أخرجه النحاس في ناسخه ص 586، 587، وابن الجوزى في نواسخ القرآن ص 407 مِن طرق عن ابن عباس.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s058",
      "start": 4789,
      "end": 4813,
      "text": "¬تفسير عبد الرزاق ص 55.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s061",
      "start": 4978,
      "end": 5069,
      "text": "¬ذكره ابن كثير في تفسيره 6/ 40 عن هشيم به، وعزاه السيوطي في الدر المنثور 5/ 39 إلى المصنف.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s065",
      "start": 5452,
      "end": 5553,
      "text": "¬ذكره ابن كثير في تفسيره 6/ 40 عن أشعث به، وعزاه السيوطي في الدر المنثور 5/ 38 إلى المصنف والفريابي.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s072",
      "start": 6045,
      "end": 6216,
      "text": "¬تفسير مجاهد ص 491، ومن طريقه ابن أبي حاتم في تفسيره 8/ 2566، والبيهقي في الشعب (8807)، وعزاه السيوطي في <br>الدر المنثور 5/ 38 إلى ابن أبي شيبة وعبد بن حميد وابن المنذر.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s076",
      "start": 6426,
      "end": 6443,
      "text": "¬في م: \"تجسسوا\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s084",
      "start": 6850,
      "end": 6900,
      "text": "¬في ص، ف، وتفسير ابن كثير: \"بيتا\"، وفى ت 1: \"لى\".¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s092",
      "start": 7263,
      "end": 7436,
      "text": "¬أخرجه سنيد الحسين بن داود - كما في التمهيد 16/ 232 - وأخرجه أبو عبيد في ناسخه ص 314، وابن أبي حاتم في تفسيره 8/ 2632، والنحاس في ناسخه ص 594 من طريق عطاء به، وسيأتي ص 354.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s094",
      "start": 7550,
      "end": 7586,
      "text": "¬عِرْيَتها: عورتها. اللسان (ع ر ا).¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s096",
      "start": 7646,
      "end": 7684,
      "text": "¬أخرجه سنيد - كما في التمهيد 16/ 232.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام الطبري",
      "attached_span_id": "s101",
      "start": 8002,
      "end": 8070,
      "text": "¬في ص، ت 1، ت 2، ف: \"أتزوجت\"، وفى م: \"أبروجب\". والمثبت مِن التمهيد.¥",

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 427,
      "end": 469,
      "text": "¬في ص، ت 1، ف: \"ترونه\" وفى ت 2: \"تردونه\".¥",
      "attached_span_id": "s005",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 720,
      "end": 775,
      "text": "¬مختصر الشواذ لابن خالويه ص 102، والبحر المحيط 6/ 438.¥",
      "attached_span_id": "s009",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1399,
      "end": 1461,
      "text": "¬في مصادر ترجمته: \"جميل بن عامر\". وينظر تهذيب الكمال 29/ 287.¥",
      "attached_span_id": "s022",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1632,
      "end": 1864,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره، 8/ 2548، والطبراني 23/ 143 (200) من طريق نافع بن عمر الجمحى به. وأخرجه البخاري (4752)، والطبراني 23/ 143 (201) من طريق ابن أبي مليكة به. وعزاه السيوطي في الدر المنثور 5/ 33 إلى ابن المنذر وابن مردويه.¥",
      "attached_span_id": "s025",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2097,
      "end": 2206,
      "text": "¬معاني القرآن للفراء 2/ 248. ونسبه في اللسان (ز ل ق) إلى القلاخ بن حزن المنقرى، ونسبه في (و ل ق) إلى الشماخ.¥",
      "attached_span_id": "s030",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2243,
      "end": 2336,
      "text": "¬رجل زلق زملق: هو الذي ينزل قبل أن يجامع. والزملق أيضا: الخفيف الطائش. اللسان (ز ل ق، زملق).¥",
      "attached_span_id": "s031",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2354,
      "end": 2454,
      "text": "¬في ت 2، ف: \"عيس\". والعنس: الناقة القوية. والعيس: الإبل البيض مع شقرة يسيرة. اللسان (ع ن س، ع ي س).¥",
      "attached_span_id": "s032",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2652,
      "end": 2699,
      "text": "¬معاني القرآن للفراء، 2/ 248، واللسان (و ل ق) ¥",
      "attached_span_id": "s035",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2732,
      "end": 2776,
      "text": "¬اليلمق: القباء، فارسي معرب. اللسان (يلمق).¥",
      "attached_span_id": "s036",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2796,
      "end": 2829,
      "text": "¬الإدهان: الغش: اللسان (د هـ ن).¥",
      "attached_span_id": "s037",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2928,
      "end": 2945,
      "text": "¬سقط من: م، ت 2.¥",
      "attached_span_id": "s039",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3216,
      "end": 3267,
      "text": "¬أخرجه الطبراني 23/ 142 (199) من طريق ابن جريج به.¥",
      "attached_span_id": "s045",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3468,
      "end": 3717,
      "text": "¬تفسير مجاهد ص 490، ومن طريقه الفريابي - كما في التغليق 4/ 265 - والطبراني في الكبير 23/ 142 (198). وأخرجه ابن أبي حاتم في تفسيره 8/ 2548 من طريق شبل عن ابن أبي نجيح به. وعزاه السيوطي في الدر المنثور 5/ 33 إلى ابن أبي شيبة وعبد بن حميد وابن المنذر.¥",
      "attached_span_id": "s049",
      "grading": [],

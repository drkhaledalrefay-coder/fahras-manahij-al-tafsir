    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7235,
      "end": 7256,
      "text": "¬في ت 2: \"فقتلتموه\".¥",
      "attached_span_id": "s104",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7343,
      "end": 7394,
      "text": "¬في ص، ت 1، ت 2، ت 3، ف: \"آيات\" وهي لفظة ابن ماجه.¥",
      "attached_span_id": "s105",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7552,
      "end": 7804,
      "text": "¬أخرجه ابن أبي شيبة 9/ 405، ومسلم (1495)، وابن ماجه (2068)، والبيهقى 8/ 337 من طريق عبدة به. وأخرجه أحمد 7/ 105، 312 (4001، 4281)، ومسلم (10/ 1495)، وأبو داود (2253)، وأبو يعلى (5161)، والواحدى في أسباب النزول ص 238، والبيهقى 7/ 405 من طريق الأعمش به.¥",
      "attached_span_id": "s107",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7968,
      "end": 8008,
      "text": "¬في ص، ت 1، ت 2: \"يفرق\"، وفي ف: \"تفرق\".¥",
      "attached_span_id": "s109",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8142,
      "end": 8156,
      "text": "¬في ف: \"كان\".¥",
      "attached_span_id": "s112",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8407,
      "end": 8443,
      "text": "¬في ت 2: \"الله أشد من عذاب الدنيا\".¥",
      "attached_span_id": "s118",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8629,
      "end": 8665,
      "text": "¬في ت 2: \"ما رأى شيئًا وإنه لكاذب\".¥",

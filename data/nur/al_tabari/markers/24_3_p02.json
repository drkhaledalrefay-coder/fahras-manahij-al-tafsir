    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11242,
      "end": 11346,
      "text": "¬أخرجه ابن أبي شيبة 4/ 271 <br>عن محمد بن جعفر به، وعزاه السيوطي في الدر المنثور 5/ 19 إلى عبد بن حميد.¥",
      "attached_span_id": "s146",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"

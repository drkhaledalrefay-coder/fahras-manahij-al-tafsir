  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7352,
      "end": 7396,
      "text": "¬أخرجه ابن أبي شيبة 7/ 201 من طريق شعبة به.¥",

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 934,
      "end": 1093,
      "text": "¬أخرجه البخارى في الأدب المفرد (1057)، والنحاس في الناسخ والمنسوخ ص 593، من طريق ليث به، وعزاه <br>السيوطي في الدر المنثور 5/ 56 إلى ابن أبي شيبة وابن المنذر.¥",
      "attached_span_id": "s009",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1414,
      "end": 1656,
      "text": "¬أخرجه أبو عبيد في الناسخ ص 313، وابن أبي حاتم في تفسيره 8/ 2633 من طريق عبد الرحمن به، وأخرجه ابن أبي شيبة 4/ 400، والنحاس في الناسخ والمنسوخ ص 592 من طريق سفيان به، وعزاه السيوطي في الدر المنثور 5/ 56 إلى الفريابي وعبد بن حميد وابن المنذر.¥",
      "attached_span_id": "s014",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2504,
      "end": 2579,
      "text": "¬أخرجه أبو عبيد في الناسخ ص 312 من طريق حجاج به، وفى ص 319 عن ابن جريج به.¥",
      "attached_span_id": "s026",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3485,
      "end": 3618,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره 8/ 2634، 2635، والبيهقى 7/ 96 من طريق أبي صالح به، وعزاه السيوطي في الدر المنثور 5/ 56 إلى ابن المنذر.¥",
      "attached_span_id": "s039",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3739,
      "end": 3823,
      "text": "¬في النسخ: \"عن\"، وسيأتي في تفسير الآية (14) من سورة \"ق\"، وينظر تهذيب الكمال 4/ 397.¥",
      "attached_span_id": "s041",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4136,
      "end": 4301,
      "text": "¬أخرجه البخارى في الأدب المفرد (1052) من طريق ابن شهاب به، وعلقه ابن عبد البر في التمهيد 16/ 234 عن ابن وهب به، وعزاه السيوطي في الدر المنثور 5/ 56 إلى عبد بن حميد.¥",
      "attached_span_id": "s044",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4571,
      "end": 4594,
      "text": "¬تقدم تخريجه في ص 244.¥",
      "attached_span_id": "s049",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4850,
      "end": 4965,
      "text": "¬أخرجه ابن أبي حاتم في تفسيره 8/ 2633، 2637 من طريق يزيد بن زريع به، وذكره أبو عبيد في الناسخ ص 318، 319 عن الحسن.¥",
      "attached_span_id": "s054",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5058,
      "end": 5117,
      "text": "¬في ص، ت 1، ت 2، ف: \"بن عائشة\". وينظر تهذيب الكمال 29/ 90.¥",
      "attached_span_id": "s057",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5534,
      "end": 5729,
      "text": "¬أخرجه أبو عبيد في الناسخ ص 315 عن عبد الرحمن به، وأخرجه ابن أبي شيبة 4/ 400، وابن أبي حاتم في تفسيره 8/ 2633، والنحاس في ناسخه ص 595، وابن الجوزى في النواسخ ص 410، 411، جميعهم من طريق سفيان به.¥",
      "attached_span_id": "s065",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5869,
      "end": 6041,
      "text": "¬أخرجه أبو عبيد في الناسخ ص 316 عن عبد الرحمن به، وأخرجه ابن الجوزي في النواسخ ص 410 من طريق أبي عوانة به عن ابن عباس، وعزاه السيوطي في الدر المنثور 5/ 56 إلى عبد بن حميد.¥",
      "attached_span_id": "s068",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6265,
      "end": 6324,
      "text": "¬أخرجه النحاس في ناسخه ص 591، 592 من طريق محمد بن بشار به.¥",
      "attached_span_id": "s072",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6502,
      "end": 6570,
      "text": "¬أخرجه ابن أبي شيبة 4/ 400، وابن أبي حاتم 8/ 2636 من طريق حنظلة به.¥",
      "attached_span_id": "s075",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6950,
      "end": 7244,
      "text": "¬أخرجه البزار (1055) عن محمد بن المثنى به، وأخرجه أبو يعلى (868) من طريق عثمان بن عمر به، وأخرجه ابن أبي شيبة 2/ 439، والبيهقى 1/ 372 من طريق عبد العزيز بن أبى رواد به، وعبد الرزاق في المصنف (2153) من طريق تميم بن غيلان به، <br>وعزاه السيوطي في الدر المنثور 5/ 57 إلى ابن أبي حاتم وابن المنذر.¥",
      "attached_span_id": "s081",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7393,
      "end": 7477,
      "text": "¬هي قراءة ابن كثير ونافع وأبي عمرو وابن عامر وحفص عن عاصم. السبعة لابن مجاهد ص 459.¥",
      "attached_span_id": "s084",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7789,
      "end": 7846,
      "text": "¬هي قراءة حمزة والكسائي وأبى بكر عن عاصم. المصدر السابق.¥",
      "attached_span_id": "s089",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8635,
      "end": 8660,
      "text": "¬في ص، ت 2، ف: \"يدخلهم\".¥",
      "attached_span_id": "s098",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام الطبري"
    }
  ],

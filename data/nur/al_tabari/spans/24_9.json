  "spans": [
    {
      "start": 4,
      "end": 72,
      "text": " وقولُه: {وَالْخَامِسَةَ أَنَّ غَضَبَ اللَّهِ عَلَيْهَا إِنْ} الآية.",
      "id": "s001"
    },
    {
      "start": 72,
      "end": 146,
      "text": " يقولُ: والشهادةَ الخامسةُ: أن غضَبَ اللهِ عليها إن كان زوجُها فيما رماها ",
      "id": "s002"
    },
    {
      "start": 162,
      "end": 196,
      "text": " به من الزنى {مِنَ الصَّادِقِينَ}.",
      "id": "s003"
    },
    {
      "start": 196,
      "end": 257,
      "text": "ورُفِع قولُه: (الخامسة) في كلتا الآيتين، بـ \"أن\" التي تليها. ",
      "id": "s004"
    }
  ]
}
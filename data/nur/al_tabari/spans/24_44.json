  "spans": [
    {
      "start": 4,
      "end": 56,
      "text": " وقولُه: {يُقَلِّبُ اللَّهُ اللَّيْلَ وَالنَّهَارَ}.",
      "id": "s001"
    },
    {
      "start": 56,
      "end": 139,
      "text": " يقولُ: يُعَقَّبُ اللهُ بينَ الليلِ والنهارِ ويُصَرِّفُهما، إذا أذهَب هذا جاء بهذا ",
      "id": "s002"
    },
    {
      "start": 153,
      "end": 155,
      "text": "، ",
      "id": "s003"
    },
    {
      "start": 180,
      "end": 181,
      "text": " ",
      "id": "s004"
    },
    {
      "start": 195,
      "end": 249,
      "text": "، {إِنَّ فِي ذَلِكَ لَعِبْرَةً لِأُولِي الْأَبْصَارِ}.",
      "id": "s005"
    },
    {
      "start": 249,
      "end": 437,
      "text": " يقولُ: إن في إنشاءِ اللهِ السحابَ، وإنزالهِ منه الوَدْقَ، ومِن السماءِ البَرَدَ، وفى تَقْلِيبِه الليلَ والنهارَ - لَعبرةً لمن اعْتَبَرَ به، وعِظَةً لمن اتَّعظَ به، مِمَّن له فَهْمٌ وعقلٌ؛",
      "id": "s006"
    },
    {
      "start": 437,
      "end": 528,
      "text": " لأن ذلك يُنْبِيُّ ويدُلُّ على أن له مُدَبِّرًا ومُصَرِّفًا ومُقَلِّبًا لا يُشْبِهُه شيءٌ. ",
      "id": "s007"
    }
  ]
}
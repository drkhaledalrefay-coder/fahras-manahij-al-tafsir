    },
    {
      "id": "s024",
      "start": 2676,
      "end": 2742,
      "text": " {يُنَبَّأُ الْإِنْسَانُ يَوْمَئِذٍ بِمَا قَدَّمَ وَأَخَّرَ (13)} ",

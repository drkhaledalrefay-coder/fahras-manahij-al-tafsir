  "spans": [
    {
      "id": "s057",
      "start": 7224,
      "end": 7251,
      "text": "مثلًا إلا كما قال أبو يوسف:",
      "markers": []
    },
    {
      "id": "s058",
      "start": 7251,
      "end": 7316,
      "text": " {فَصَبْرٌ جَمِيلٌ وَاللَّهُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7252,
          "end": 7315,
          "span_id": "s058"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 7316,
          "end": 7326,
          "text": "[يوسف: 18]",
          "via": "apparatus",
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 7326,
      "end": 7366,
      "text": " قالت: ثم تحولت فاضطجعت على فراشي، قالت:",
      "markers": []
    },
    {
      "id": "s060",
      "start": 7366,
      "end": 7618,
      "text": " وأنا والله حينئذٍ أعلم أني بريئة وأن الله تعالى مبرئي ببراءتي، ولكن والله ما كنت أظن أن ينزل في شأني وحي يتلى، ولشأني كان أحقر في نفسي من أن يتكلم الله فيّ بأمر يتلى، ولكن كنت أرجو أن يرى رسول الله - صلى الله عليه وسلم - في النوم رؤيا يبرئني الله بها.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7567,
          "end": 7585,
          "span_id": "s060"
        }
      ]
    },
    {
      "id": "s061",
      "start": 7618,
      "end": 7868,
      "text": " قالت: فوالله ما رام رسول الله - صلى الله عليه وسلم - مجلسه ولا خرج من أهل البيت أحد حتى أنزل الله تعالى على نبيه، فأخذه ما كان يأخذه من البرحاء عند الوحي، حتى إنه ليتحدر منه مثل الجمان من العرق، وهو في اليوم الشاتي من ثقل القول الذي أنزل عليه، قالت:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7651,
          "end": 7669,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 7868,
      "end": 7956,
      "text": " فلما سُرّي عن رسول الله - صلى الله عليه وسلم - وهو يضحك، فكان أول كلمة تكلم بها أن قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7895,
          "end": 7913,
          "span_id": "s062"
        }
      ]
    },
    {
      "id": "s063",
      "start": 7956,
      "end": 8009,
      "text": " \"أبشري يا عائشة أما الله - عز وجل - فقد برأك\"، قالت:",
      "markers": []
    },
    {
      "id": "s064",
      "start": 8009,
      "end": 8041,
      "text": " فقالت لي أُمي: قومي إليه، فقلت:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 8037,
          "end": 8040,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 8041,
      "end": 8133,
      "text": " والله لا أقوم إليه ولا أحمد إلا الله - عز وجل - هو الذي أنزل براءتي، وأنزل الله - عز وجل -:",
      "markers": []
    },
    {
      "id": "s066",
      "start": 8133,
      "end": 8189,
      "text": " {إِنَّ الَّذِينَ جَاءُوا بِالْإِفْكِ عُصْبَةٌ مِنْكُمْ.",
      "markers": []
    },
    {
      "id": "s067",
      "start": 8189,
      "end": 8249,
      "text": " . .} العشر آيات كلها، فأنزل الله هذه الآيات في براءتي قالت:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 8212,
          "end": 8217,
          "span_id": "s067"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 8212,
          "end": 8222,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 8249,
      "end": 8326,
      "text": " فقال أبو بكر - رضي الله عنه - وكان ينفق على مسطح بن أثاثة لقرابته منه وفقره:",
      "markers": []
    },
    {
      "id": "s069",
      "start": 8326,
      "end": 8396,
      "text": " والله لا أنفق عليه شيئًا أبدًا بعد الذي قال لعائشة، فأنزل الله تعالى:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 8379,
          "end": 8384,
          "span_id": "s069"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 8379,
          "end": 8389,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 8396,
      "end": 8493,
      "text": " {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ أَنْ يُؤْتُوا أُولِي الْقُرْبَى} إلى قوله:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8397,
          "end": 8483,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 8493,
      "end": 8568,
      "text": " {أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8494,
          "end": 8567,
          "span_id": "s071"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 8568,
          "end": 8579,
          "text": "[النور: 22]",
          "via": "apparatus",
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 8579,
      "end": 8672,
      "text": " فقال أبو بكر: والله إني لأحب أن يغفر الله لي، فرجع إلى مسطح النفقة التي كان ينفق عليه، وقال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 8585,
          "end": 8592,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 8672,
      "end": 8699,
      "text": " والله لا أنزعها منه أبدًا.",
      "markers": []
    },
    {
      "id": "s074",
      "start": 8699,
      "end": 8815,
      "text": "\r\nقالت عائشة: وكان رسول الله - صلى الله عليه وسلم - سأل زينب بنت جحش زوج النبي - صلى الله عليه وسلم - عن أمري، فقال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "SPEAKER",
          "start": 8706,
          "end": 8711,
          "span_id": "s074"
        },
        {
          "family": "HADITH",
          "marker": "ان رسول الله",
          "start": 8715,
          "end": 8727,
          "span_id": "s074"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 8730,
          "end": 8748,
          "span_id": "s074"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 8780,
          "end": 8798,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 8815,
      "end": 8843,
      "text": " \"يا زينب ماذا علمت أو رأيت؟",
      "markers": []
    },
    {
      "id": "s076",
      "start": 8843,
      "end": 8919,
      "text": " \" فقالت: يا رسول الله أحمي سمعي وبصري، والله ما علمت إلا خيرًا، قالت عائشة:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "SPEAKER",
          "start": 8913,
          "end": 8918,
          "span_id": "s076"
        }
      ]
    },
    {
      "id": "s077",
      "start": 8919,
      "end": 9005,
      "text": " وهي التي كانت تساميني من أزواج النبي - صلى الله عليه وسلم - فعصمها الله تعالى بالورع.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 8959,
          "end": 8977,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 9005,
      "end": 9057,
      "text": " وطفقت أختها حمنة بنت جحش تحارب لها، فهلكت فيمن هلك.",
      "markers": []
    },
    {
      "id": "s079",
      "start": 9057,
      "end": 9111,
      "text": " قال ابن شهاب: فهذا ما انتهى إلينا من أمر هؤلاء الرهط.",
      "markers": []
    },
    {
      "id": "s080",
      "start": 9111,
      "end": 9159,
      "text": " أخرجه البخاري ومسلم في صحيحيهما من حديث الزهري ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخرجه",
          "start": 9112,
          "end": 9117,
          "span_id": "s080"
        }
      ]
    },
    {
      "id": "s081",
      "start": 9313,
      "end": 9357,
      "text": ". وهكذا رواه ابن إسحاق، عن الزهري، كذلك قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 9321,
          "end": 9325,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 9357,
      "end": 9529,
      "text": " وحدثني يحيى بن عباد بن عبد الله بن الزبير، عن أبيه، عن عائشة - رضي الله عنها -، وحدثني عبد الله بن أبي بكر بن محمد بن عمرو بن حزم الأنصاري، عن عمرة، عن عائشة بنحو ما تقدم ",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9401,
          "end": 9429,
          "stripped": "عن أبيه، عن عائشة - رضي الله",
          "span_id": "s082"
        },
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 9413,
          "end": 9418,
          "span_id": "s082"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9498,
          "end": 9528,
          "stripped": "عن عمرة، عن عائشة بنحو ما تقدم",
          "span_id": "s082"
        },
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 9510,
          "end": 9515,
          "span_id": "s082"
        }
      ]
    },
    {
      "id": "s083",
      "start": 9569,
      "end": 9599,
      "text": "، والله أعلم.\r\nثم قال البخاري:",
      "markers": [
        {
          "family": "RAY",
          "marker": "والله أعلم",
          "start": 9571,
          "end": 9581,
          "span_id": "s083"
        }
      ]
    },
    {
      "id": "s084",
      "start": 9599,
      "end": 9637,
      "text": " وقال أبو أُسامة، عن هشام بن عروة قال:",
      "markers": []
    },
    {
      "id": "s085",
      "start": 9637,
      "end": 9682,
      "text": " أخبرني أبي، عن عائشة - رضي الله عنها - قالت:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 9653,
          "end": 9658,
          "span_id": "s085"
        }
      ]
    },
    {
      "id": "s086",
      "start": 9682,
      "end": 9818,
      "text": " لما ذكر من شأني الذي ذكر وما علمت به، قام رسول الله - صلى الله عليه وسلم - فيّ خطيبًا، فتشهّد فحمد الله وأثنى عليه بما هو أهله، ثم قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 9737,
          "end": 9755,
          "span_id": "s086"
        }
      ]
    },
    {
      "id": "s087",
      "start": 9818,
      "end": 9855,
      "text": " \"أما بعد؛ أشيروا عليّ في أناس أبنوا ",
      "markers": []
    },
    {
      "id": "s088",
      "start": 9873,
      "end": 9953,
      "text": " أهلي، وايمُ الله ما علمت على أهلي إلا خيرًا، وما علمت على أهلي من سوء، وأبنوهم ",
      "markers": []
    },
    {
      "id": "s089",
      "start": 9967,
      "end": 10094,
      "text": " بمن والله ما علمت عليه من سوء قط، ولا يدخل بيتي قط إلا وأنا حاضر، ولا غبت في سفر إلا غاب معي\"، فقام سعد بن معاذ الأنصاري فقال:",
      "markers": []
    },
    {
      "id": "s090",
      "start": 10094,
      "end": 10223,
      "text": " يا رسول الله - صلى الله عليه وسلم -، ائذن لنا أن نضرب أعناقهم، فقام رجل من الخزرج وكانت أُم حسان بن ثابت من رهط ذلك الرجل، فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 10110,
          "end": 10128,
          "span_id": "s090"
        }
      ]
    },
    {
      "id": "s091",
      "start": 10223,
      "end": 10406,
      "text": " كذبت أما والله لو كانوا من الأوس ما أحببت أن تضرب أعناقهم، حتى كاد أن يكون بين الأوس والخزرج شر في المسجد وما علمت، فلما كان مساء ذلك اليوم خرجت لبعض حاجتي ومعي أم مسطح، فعثرت فقالت:",
      "markers": []
    },
    {
      "id": "s092",
      "start": 10406,
      "end": 10444,
      "text": " تعس مسطح، فقلت لها: أي أم تسبين ابنك؟",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 10418,
          "end": 10421,
          "span_id": "s092"
        }
      ]
    },
    {
      "id": "s093",
      "start": 10444,
      "end": 10474,
      "text": " فسكتت، ثم عثرت الثانية فقالت:",
      "markers": []
    },
    {
      "id": "s094",
      "start": 10474,
      "end": 10512,
      "text": " تعسَ مسطح فقلت لها: أي أم تسبين ابنك؟",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 10486,
          "end": 10489,
          "span_id": "s094"
        }
      ]
    },
    {
      "id": "s095",
      "start": 10512,
      "end": 10563,
      "text": " ثم عثرت الثالثة فقالت: تعس مسطح فانتهرتُها، فقالت:",
      "markers": []
    },
    {
      "id": "s096",
      "start": 10563,
      "end": 10592,
      "text": " والله ما أسبه إلا فيك، فقلت:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 10588,
          "end": 10591,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 10592,
      "end": 10617,
      "text": " في أي شأني؟ قالت: فبقرت ",
      "markers": []
    },
    {
      "id": "s098",
      "start": 10635,
      "end": 10665,
      "text": " لي الحديث، فقلت: وقد كان هذا؟",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 10648,
          "end": 10651,
          "span_id": "s098"
        }
      ]
    },
    {
      "id": "s099",
      "start": 10665,
      "end": 10790,
      "text": " قالت: نعم والله، فرجعت إلى بيتي كأن الذي خرجت له لا أجد منه قليلًا ولا كثيرًا، ووعكت وقلت لرسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 10752,
          "end": 10755,
          "span_id": "s099"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 10769,
          "end": 10787,
          "span_id": "s099"
        }
      ]
    },
    {
      "id": "s100",
      "start": 10790,
      "end": 10907,
      "text": " أرسلني إلى بيت أبي، فأرسل معي الغلام، فدخلت الدار فوجدت أم رومان في السفل، وأبا بكر فوق البيت يقرأ، فقالت أُم رومان:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 10886,
          "end": 10889,
          "span_id": "s100"
        }
      ]
    },
    {
      "id": "s101",
      "start": 10907,
      "end": 10994,
      "text": " ما جاء بك بنية، فأخبرتها وذكرت لها الحديث، وإذا هو لم يبلغ منها مثل ما بلغ مني، فقالت:",
      "markers": []
    },
    {
      "id": "s102",
      "start": 10994,
      "end": 11108,
      "text": " يا بنية خففي عليك الشأن، فإنه واللهِ لقل ما كانت امرأة حسناء عند رجل يحبها لها ضرائر إلا حسدنها، وقيل فيها، فقلت:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 11104,
          "end": 11107,
          "span_id": "s102"
        }
      ]
    },
    {
      "id": "s103",
      "start": 11108,
      "end": 11130,
      "text": " وقد علم به أبي؟ قالت:",
      "markers": []
    },
    {
      "id": "s104",
      "start": 11130,
      "end": 11175,
      "text": " نعم. قلت: ورسول الله - صلى الله عليه وسلم -؟",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 11136,
          "end": 11139,
          "span_id": "s104"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11154,
          "end": 11172,
          "span_id": "s104"
        }
      ]
    },
    {
      "id": "s105",
      "start": 11175,
      "end": 11291,
      "text": " قالت: نعم ورسول الله - صلى الله عليه وسلم -، فاستعبرت وبكيت، فسمع أبو بكر صوتي وهو فوق البيت يقرأ، فنزل فقال لأُمي:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11199,
          "end": 11217,
          "span_id": "s105"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 11270,
          "end": 11273,
          "span_id": "s105"
        }
      ]
    },
    {
      "id": "s106",
      "start": 11291,
      "end": 11367,
      "text": " ما شأنها؟ قالت: بلغها الذي ذكر من شأنها، ففاضت عيناه - رضي الله عنه - وقال:",
      "markers": []
    },
    {
      "id": "s107",
      "start": 11367,
      "end": 11409,
      "text": " أقسمت عليك - أي بنية - إلا رجعت إلى بيتك؛",
      "markers": []
    },
    {
      "id": "s108",
      "start": 11409,
      "end": 11486,
      "text": " فرجعت، ولقد جاء رسول الله - صلى الله عليه وسلم - بيتي فسأل عني خادمتي فقالت:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11438,
          "end": 11456,
          "span_id": "s108"
        }
      ]
    },
    {
      "id": "s109",
      "start": 11486,
      "end": 11599,
      "text": " لا والله ما علمت عليها عيبًا إلا أنها كانت ترقد حتى تدخل الشاة فتأكل خميرها أو عجينها، وانتهرها بعض أصحابه فقال:",
      "markers": []
    },
    {
      "id": "s110",
      "start": 11599,
      "end": 11657,
      "text": " اصدقي رسول الله - صلى الله عليه وسلم - حتى أسقطوا لها به.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11618,
          "end": 11636,
          "span_id": "s110"
        }
      ]
    },
    {
      "id": "s111",
      "start": 11657,
      "end": 11776,
      "text": " فقالت: سبحان الله، والله ما علمت عليها إلا ما يعلم الصائغ عن تبر الذهب الأحمر، وبلغ الأمر ذلك الرجل الذي قيل له، فقال:",
      "markers": []
    },
    {
      "id": "s112",
      "start": 11776,
      "end": 11815,
      "text": " سبحان الله، والله ما كشفت كنف أنثى قط.",
      "markers": []
    },
    {
      "id": "s113",
      "start": 11815,
      "end": 11846,
      "text": "\r\nقالت عائشة - رضي الله عنها -:",
      "markers": []
    },
    {
      "id": "s114",
      "start": 11846,
      "end": 11879,
      "text": " فقتل شهيدًا في سبيل الله، وقالت:",
      "markers": []
    },
    {
      "id": "s115",
      "start": 11879,
      "end": 12047,
      "text": " وأصبح أبواي عندي فلم يزالا حتى دخل عليّ رسول الله - صلى الله عليه وسلم - وقد صلى العصر، ثم دخل وقد اكتنفني أبواي عن يميني وعن شمالي فحمد الله تعالى وأثنى عليه، ثم قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 11932,
          "end": 11950,
          "span_id": "s115"
        }
      ]
    },
    {
      "id": "s116",
      "start": 12047,
      "end": 12146,
      "text": " \"أما بعد؛ يا عائشة إن كنت قارفت سوءًا أو ظلمت فتوبي إلى الله، فإن الله يقبل التوبة عن عباده\" قالت:",
      "markers": []
    },
    {
      "id": "s117",
      "start": 12146,
      "end": 12195,
      "text": " وقد جاءت امرأة من الأنصار فهي جالسة بالباب فقلت:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 12191,
          "end": 12194,
          "span_id": "s117"
        }
      ]
    },
    {
      "id": "s118",
      "start": 12195,
      "end": 12235,
      "text": " ألا تستحيي من هذه المرأة أن تذكر شيئًا؟",
      "markers": []
    },
    {
      "id": "s119",
      "start": 12235,
      "end": 12297,
      "text": " فوعظ رسول الله - صلى الله عليه وسلم - فالتفت إلى أبي فقلت له:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 12253,
          "end": 12271,
          "span_id": "s119"
        },
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 12290,
          "end": 12293,
          "span_id": "s119"
        }
      ]
    },
    {
      "id": "s120",
      "start": 12297,
      "end": 12340,
      "text": " أجبه قال: فماذا أقول؟ فالتفت إلى أمي فقلت:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 12336,
          "end": 12339,
          "span_id": "s120"
        }
      ]
    },
    {
      "id": "s121",
      "start": 12340,
      "end": 12430,
      "text": " أجيبيه قالت: ماذا أقول؟ فلما لم يجيباه تشهّدت فحمدت الله وأثنيت عليه بما هو أهله، ثم قلت:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 12426,
          "end": 12429,
          "span_id": "s121"
        }
      ]
    },
    {
      "id": "s122",
      "start": 12430,
      "end": 12457,
      "text": " أما بعد فوالله إن قلت لكم:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 12449,
          "end": 12452,
          "span_id": "s122"
        }
      ]
    },
    {
      "id": "s123",
      "start": 12457,
      "end": 12566,
      "text": " إني لم أفعل والله - عز وجل - يشهد أني لصادقة ما ذاك بنافعي عندكم، لقد تكلمتم به وأشربته قلوبكم، وإن قلت لكم:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 12558,
          "end": 12561,
          "span_id": "s123"
        }
      ]
    },
    {
      "id": "s124",
      "start": 12566,
      "end": 12611,
      "text": " إني قد فعلت، والله يعلم أني لم أفعل، لتقولن:",
      "markers": []
    },
    {
      "id": "s125",
      "start": 12611,
      "end": 12721,
      "text": " قد باءت به على نفسها، وإنني والله ما أجد لي ولكم مثلًا، والتمست اسم يعقوب فلم أقدر عليه إلا أبا يوسف حين قال:",
      "markers": []
    },
    {
      "id": "s126",
      "start": 12721,
      "end": 12786,
      "text": " {فَصَبْرٌ جَمِيلٌ وَاللَّهُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 12722,
          "end": 12785,
          "span_id": "s126"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 12786,
          "end": 12796,
          "text": "[يوسف: 18]",
          "via": "apparatus",
          "span_id": "s126"
        }
      ]
    },
    {
      "id": "s127",
      "start": 12796,
      "end": 12916,
      "text": "، وأنزل الله على رسوله - صلى الله عليه وسلم - من ساعته، فسكتنا فرفع عنه وإني لأتبين السرور في وجهه وهو يمسح جبينه ويقول:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 12821,
          "end": 12839,
          "span_id": "s127"
        }
      ]
    },
    {
      "id": "s128",
      "start": 12916,
      "end": 12960,
      "text": " \"أبشري يا عائشة فقد أنزل الله براءتك\" قالت:",
      "markers": []
    },
    {
      "id": "s129",
      "start": 12960,
      "end": 12997,
      "text": " وكنت أشد ما كنت غضبًا فقال لي أبواي:",
      "markers": [
        {
          "family": "LUGHA",
          "marker": "اي:",
          "start": 12994,
          "end": 12997,
          "span_id": "s129"
        }
      ]
    },
    {
      "id": "s130",
      "start": 12997,
      "end": 13130,
      "text": " قومي إليه، فقلت: لا والله لا أقوم إليه ولا أحمده ولا أحمدكما، ولكن أحمد الله الذي أنزل براءتي، لقد سمعتموه فما أنكرتموه ولا غيرتموه.",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 13010,
          "end": 13013,
          "span_id": "s130"
        }
      ]
    },
    {
      "id": "s131",
      "start": 13130,
      "end": 13395,
      "text": "\r\nوكانت عائشة تقول: أما زينب بنت جحش فقد عصمها الله بدينها فلم تقل إلا خيرًا، وأما أختها حمنة بنت جحش فهلكت فيمن هلك، وكان الذي يتكلم به مسطح وحسان بن ثابت، وأمِا المنافق عبد الله بن أُبي بن سلول، وهو الذي كان يستوشيه ويجمعه، وهو الذي تولى كبره منهم هو وحمنة، قالت:",
      "markers": []
    },
    {
      "id": "s132",
      "start": 13395,
      "end": 13459,
      "text": " وحلف أبو بكر أن لا ينفع مسطحًا، بنافعة أبدًا، فأنزل الله تعالى:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 13442,
          "end": 13447,
          "span_id": "s132"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 13442,
          "end": 13452,
          "span_id": "s132"
        }
      ]
    },
    {
      "id": "s133",
      "start": 13459,
      "end": 13508,
      "text": " {وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ} يعني:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13460,
          "end": 13502,
          "span_id": "s133"
        }
      ]
    },
    {
      "id": "s134",
      "start": 13508,
      "end": 13584,
      "text": " أبا بكر {وَالسَّعَةِ أَنْ يُؤْتُوا أُولِي الْقُرْبَى وَالْمَسَاكِينَ} يعني:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13517,
          "end": 13578,
          "span_id": "s134"
        }
      ]
    },
    {
      "id": "s135",
      "start": 13584,
      "end": 13676,
      "text": " مسطحًا إلى قوله: {أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 13602,
          "end": 13675,
          "span_id": "s135"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 13676,
          "end": 13687,
          "text": "[النور: 22]",
          "via": "apparatus",
          "span_id": "s135"
        }
      ]
    },
    {
      "id": "s136",
      "start": 13687,
      "end": 13763,
      "text": " فقال أبو بكر: بلى والله يا ربنا إنا لنحب أن تغفر لنا، وعاد له بما كان يصنع ",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 13693,
          "end": 13700,
          "span_id": "s136"
        }
      ]
    },
    {
      "id": "s137",
      "start": 13809,
      "end": 13907,
      "text": ". هكذا رواه البخاري من هذا الوجه معلقًا بصيغة الجزم عن أبي أسامة حماد بن أُسامة أحد الأئمة الثقات.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 13816,
          "end": 13820,
          "span_id": "s137"
        }
      ]
    },
    {
      "id": "s138",
      "start": 13907,
      "end": 13991,
      "text": " وقد رواه ابن جرير في تفسيره عن سفيان بن وكيع، عن أبي أُسامة به مطولًا مثله أو نحوه.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 13912,
          "end": 13916,
          "span_id": "s138"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 13936,
          "end": 13977,
          "stripped": "عن سفيان بن وكيع، عن أبي أسامة به مطولا",
          "span_id": "s138"
        }
      ]
    },
    {
      "id": "s139",
      "start": 13991,
      "end": 14051,
      "text": " ورواه ابن أبي حاتم، عن أبي سعيد الأشج، عن أبي أُسامة ببعضه ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 13993,
          "end": 13997,
          "span_id": "s139"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 14012,
          "end": 14050,
          "stripped": "عن أبي سعيد الأشج، عن أبي أسامة ببعضه",
          "span_id": "s139"
        }
      ]
    },
    {
      "id": "s140",
      "start": 14100,
      "end": 14198,
      "text": ".\r\nوقال الإمام أحمد: حدثنا هشيم، أخبرنا عمر بن أبي سلمة، عن أبيه، عن عائشة - رضي الله عنها - قالت:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 14121,
          "end": 14126,
          "span_id": "s140"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 14121,
          "end": 14150,
          "stripped": "حدثنا هشيم، أخبرنا عمر بن أبي",
          "span_id": "s140"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 14133,
          "end": 14139,
          "span_id": "s140"
        },
        {
          "family": "SAHABA",
          "marker": "عمر",
          "name": "عمر",
          "role": "NARRATOR",
          "start": 14140,
          "end": 14143,
          "span_id": "s140"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 14157,
          "end": 14185,
          "stripped": "عن أبيه، عن عائشة - رضي الله",
          "span_id": "s140"
        },
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 14169,
          "end": 14174,
          "span_id": "s140"
        }
      ]
    },
    {
      "id": "s141",
      "start": 14198,
      "end": 14296,
      "text": " لما نزل عذري من السماء جاءني النبي - صلى الله عليه وسلم - فأخبرني بذلك، فقلت: نحمد الله لا نحمدك ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 14236,
          "end": 14254,
          "span_id": "s141"
        },
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 14272,
          "end": 14275,
          "span_id": "s141"
        }
      ]
    },
    {
      "id": "s142",
      "start": 14437,
      "end": 14548,
      "text": ".\r\nوقال الإمام أحمد: حدثني ابن أبي عدي، عن محمد بن إسحاق، عن عبد الله بن أبي بكر، عن عمرة أيضًا، عن عائشة قالت:",
      "markers": [
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 14477,
          "end": 14513,
          "stripped": "عن محمد بن إسحاق، عن عبد الله بن أبي",
          "span_id": "s142"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 14519,
          "end": 14548,
          "stripped": "عن عمرة أيضا، عن عائشة قالت:",
          "span_id": "s142"
        },
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "NARRATOR",
          "start": 14537,
          "end": 14542,
          "span_id": "s142"
        }
      ]
    },
    {
      "id": "s143",
      "start": 14548,
      "end": 14664,
      "text": " لما نزل عذري قام رسول الله - صلى الله عليه وسلم - فذكر ذلك وتلا القرآن، فلما نزل أمَرَ برجلين وامرأة فضربوا حدَّهم ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 14578,
          "end": 14596,
          "span_id": "s143"
        }
      ]
    },
    {
      "id": "s144",
      "start": 14737,
      "end": 14778,
      "text": "، وأخرجه أهل السنن الأربعة، وقال الترمذي:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "أخرجه",
          "start": 14740,
          "end": 14745,
          "span_id": "s144"
        }
      ]
    },
    {
      "id": "s145",
      "start": 14778,
      "end": 14819,
      "text": " هذا حديث حسن، ووقع عند أبي داود تسميتهم:",
      "markers": []
    },
    {
      "id": "s146",
      "start": 14819,
      "end": 14864,
      "text": " حسان بن ثابت، ومسطح بن أثاثة، وحمنة بنت جحش ",
      "markers": []
    },
    {
      "id": "s147",
      "start": 15119,
      "end": 15210,
      "text": "، فهذه طرق متعددة عن أم المؤمنين عائشة - رضي الله عنها - في المسانيد والصحاح والسنن وغيرها.",
      "markers": []
    },
    {
      "id": "s148",
      "start": 15210,
      "end": 15280,
      "text": "\r\nوقد روي من حديث أُمها أُم رومان - رضي الله عنها -، فقال الإمام أحمد:",
      "markers": []
    },
    {
      "id": "s149",
      "start": 15280,
      "end": 15355,
      "text": " حدثنا علي بن عاصم، أخبرنا حصين، عن أبي وائل، عن مسروق، عن أُم رومان، قالت:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 15281,
          "end": 15286,
          "span_id": "s149"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 15281,
          "end": 15319,
          "stripped": "حدثنا علي بن عاصم، أخبرنا حصين، عن أبي",
          "span_id": "s149"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 15287,
          "end": 15290,
          "span_id": "s149"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 15300,
          "end": 15306,
          "span_id": "s149"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 15313,
          "end": 15355,
          "stripped": "عن أبي وائل، عن مسروق، عن أم رومان، قالت:",
          "span_id": "s149"
        }
      ]
    },
    {
      "id": "s150",
      "start": 15355,
      "end": 15413,
      "text": " بينا أنا عند عائشة؛ إذ دخلت علينا امرأة من الأنصار فقالت:",
      "markers": []
    },
    {
      "id": "s151",
      "start": 15413,
      "end": 15448,
      "text": " فعل الله بابنها وفعل، فقالت عائشة:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "عائشة",
          "name": "عائشة",
          "role": "SPEAKER",
          "start": 15442,
          "end": 15447,
          "span_id": "s151"
        }
      ]
    },
    {
      "id": "s152",
      "start": 15448,
      "end": 15490,
      "text": " ولم؟ قالت: إنه كان فيمن حدث الحديث، قالت:",
      "markers": []
    },
    {
      "id": "s153",
      "start": 15490,
      "end": 15524,
      "text": " وأي الحديث؟ قالت: كذا وكذا، قالت:",
      "markers": []
    },
    {
      "id": "s154",
      "start": 15524,
      "end": 15570,
      "text": " وقد بلغ ذلك رسول الله - صلى الله عليه وسلم -؟",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 15549,
          "end": 15567,
          "span_id": "s154"
        }
      ]
    },
    {
      "id": "s155",
      "start": 15570,
      "end": 15601,
      "text": " قالت: نعم، قالت: وبلغ أبا بكر؟",
      "markers": []
    },
    {
      "id": "s156",
      "start": 15601,
      "end": 15708,
      "text": " قالت: نعم، فخرّت عائشة - رضي الله عنها - مغشيًا عليها، فما أفاقت إلا وعليها حمى بنافض، فقمت فدثرتها، قالت:",
      "markers": []
    },
    {
      "id": "s157",
      "start": 15708,
      "end": 15747,
      "text": " فجاء النبي - صلى الله عليه وسلم - قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 15722,
          "end": 15740,
          "span_id": "s157"
        }
      ]
    },
    {
      "id": "s158",
      "start": 15747,
      "end": 15769,
      "text": " \"فما شأن هذه؟ \" فقلت:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 15765,
          "end": 15768,
          "span_id": "s158"
        }
      ]
    },
    {
      "id": "s159",
      "start": 15769,
      "end": 15808,
      "text": " يا رسول الله أخذتها حُمَّى بنافض، قال:",
      "markers": []
    },
    {
      "id": "s160",
      "start": 15808,
      "end": 15838,
      "text": " \"فلعله في حديث تحدث به\" قالت:",
      "markers": []
    },
    {
      "id": "s161",
      "start": 15838,
      "end": 15868,
      "text": " فاستوت له عائشة قاعدة، فقالت:",
      "markers": []
    },
    {
      "id": "s162",
      "start": 15868,
      "end": 15968,
      "text": " والله لئن حلفت لكم لا تصدقوني، ولئن اعتذرت إليكم لا تعذروني، فمثلي ومثلكم كمثل يعقوب وبنيه حين قال:",
      "markers": []
    },
    {
      "id": "s163",
      "start": 15968,
      "end": 16033,
      "text": " {فَصَبْرٌ جَمِيلٌ وَاللَّهُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 15969,
          "end": 16032,
          "span_id": "s163"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 16033,
          "end": 16043,
          "text": "[يوسف: 18]",
          "via": "apparatus",
          "span_id": "s163"
        }
      ]
    },
    {
      "id": "s164",
      "start": 16043,
      "end": 16168,
      "text": " قالت: فخرج رسول الله - صلى الله عليه وسلم - وأنزل الله عذرها، فرجع رسول الله - صلى الله عليه وسلم - ومعه أبو بكر، فدخل فقال:",
      "markers": [
        {
          "family": "SIRA",
          "marker": "خرج رسول الله",
          "start": 16051,
          "end": 16064,
          "span_id": "s164"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 16067,
          "end": 16085,
          "span_id": "s164"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 16123,
          "end": 16141,
          "span_id": "s164"
        }
      ]
    },
    {
      "id": "s165",
      "start": 16168,
      "end": 16213,
      "text": " يا عائشة \"إن الله تعالى قد أنزل عذرك\" فقالت:",
      "markers": []
    },
    {
      "id": "s166",
      "start": 16213,
      "end": 16251,
      "text": " بحمد الله لا بحمدك، فقال لها أبو بكر:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "أبو بكر",
          "name": "أبو بكر",
          "role": "SPEAKER",
          "start": 16243,
          "end": 16250,
          "span_id": "s166"
        }
      ]
    }
  ],
  "editor_footnote_evidence": [
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s080",
      "start": 9159,
      "end": 9313,
      "text": "¬(المسند 6/ 194 - 197)، وصحيح البخاري، الشهادات، باب تعديل النساء بعضهن بعضًا (ح 2661)، وصحيح مسلم، التوبة، باب في حديث الإفك وقبول توبة القاذف (ح 2770).¥",
      "grading": [
        "صحيح"
      ]
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s082",
      "start": 9529,
      "end": 9569,
      "text": "¬السيرة النبوية لابن هشام 2/ 297 - 307.¥",
      "grading": []
    },
    {
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير",
      "attached_span_id": "s087",

  "spans": [
    {
      "id": "s001",
      "start": 0,
      "end": 88,
      "text": "وَلَوْلَا فَضْلُ اللَّهِ عَلَيْكُمْ وَرَحْمَتُهُ وَأَنَّ اللَّهَ تَوَّابٌ حَكِيمٌ (10)}.",
      "markers": []
    },
    {
      "id": "s002",
      "start": 88,
      "end": 329,
      "text": "\r\nهذه الآية الكريمة فيها فرج للأزواج وزيادة مخرج إذا قذف أحدهم زوجته، وتعسر عليه إقامة البينة أن يلاعنها كما أمر الله -عَزَّ وَجَلَّ-، وهو أن يحضرها إلى الإمام فيدعي عليها بما رماها به، فيحلّفه الحاكم أربع شهادات بالله في مقابلة أربعة شهداء:",
      "markers": []
    },
    {
      "id": "s003",
      "start": 329,
      "end": 646,
      "text": " إنه لمن الصادقين؛ أي فيما رماها به من الزنا {وَالْخَامِسَةُ أَنَّ لَعْنَتَ اللَّهِ عَلَيْهِ إِنْ كَانَ مِنَ الْكَاذِبِينَ (7)} فإذا قال ذلك، بانت منه بنفس هذا اللعان عند الشافعي وطائفة كثيرة من العلماء، وحرمت عليه أبدًا، ويعطيها مهرها ويتوجب عليها حد الزنا، ولا يدرأ عنها العذاب إلا أن تلاعن فتشهد أربع شهادات بالله:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 374,
          "end": 456,
          "span_id": "s003"
        }
      ]
    },
    {
      "id": "s004",
      "start": 646,
      "end": 711,
      "text": " {أَرْبَعَ شَهَادَاتٍ بِاللَّهِ إِنَّهُ لَمِنَ الْكَاذِبِينَ} أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 647,
          "end": 707,
          "span_id": "s004"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 708,
          "end": 711,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 711,
      "end": 818,
      "text": " فيما رماها به {وَالْخَامِسَةَ أَنَّ غَضَبَ اللَّهِ عَلَيْهَا إِنْ كَانَ مِنَ الصَّادِقِينَ (9)} ولهذا قال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 726,
          "end": 807,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 818,
      "end": 1237,
      "text": " {وَيَدْرَأُ عَنْهَا الْعَذَابَ} يعني: الحد {أَنْ تَشْهَدَ أَرْبَعَ شَهَادَاتٍ بِاللَّهِ إِنَّهُ لَمِنَ الْكَاذِبِينَ (8) وَالْخَامِسَةَ أَنَّ غَضَبَ اللَّهِ عَلَيْهَا إِنْ كَانَ مِنَ الصَّادِقِينَ (9)} فخصَّها بالغضب، كما أن الغالب أن الرجل لا يتجشم فضيحة أهله ورميها بالزنا إلا وهو صادق معذور، وهي تعلم صدقه فيما رماها به، ولهذا كانت الخامسة في حقِّها أن غضب اللَّه عليها، والمغضوب عليه هو الذي يعلم الحق ثم يحيد عنه.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 819,
          "end": 850,
          "span_id": "s006"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 862,
          "end": 1020,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 1237,
      "end": 1344,
      "text": "\r\nثم ذكر تعالى رأفته بخلقه ولطفه بهم فيما شرع لهم من الفرج والمخرج من شدة ما يكون بهم من الضيق، فقال تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "قال تعالى",
          "start": 1334,
          "end": 1343,
          "span_id": "s007"
        }
      ]
    },
    {
      "id": "s008",
      "start": 1344,
      "end": 1399,
      "text": " {وَلَوْلَا فَضْلُ اللَّهِ عَلَيْكُمْ وَرَحْمَتُهُ} أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1345,
          "end": 1395,
          "span_id": "s008"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 1396,
          "end": 1399,
          "span_id": "s008"
        }
      ]
    },
    {
      "id": "s009",
      "start": 1399,
      "end": 1463,
      "text": " لحرجتم ولشق عليكم كثير من أموركم {وَأَنَّ اللَّهَ تَوَّابٌ} أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1433,
          "end": 1459,
          "span_id": "s009"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 1460,
          "end": 1463,
          "span_id": "s009"
        }
      ]
    },
    {
      "id": "s010",
      "start": 1463,
      "end": 1646,
      "text": " على عباده، وإن كان ذلك بعد الحلف والأيمان المغلظة {حَكِيمٌ} فيما يشرعه ويأمر به وفيما ينهى عنه، وقد وردت الأحاديث بمقتضى العمل بهذه الآية، وذكر سبب نزولها، وفيمن نزلت فيه من الصحابة.",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1514,
          "end": 1523,
          "span_id": "s010"
        },
        {
          "family": "NUZUL",
          "marker": "سبب نزول",
          "start": 1608,
          "end": 1616,
          "span_id": "s010"
        },
        {
          "family": "NUZUL",
          "marker": "نزلت في",
          "start": 1626,
          "end": 1633,
          "span_id": "s010"
        }
      ]
    },
    {
      "id": "s011",
      "start": 1646,
      "end": 1731,
      "text": "\r\nفقال الإمام أحمد: حَدَّثَنَا يزيد، أخبرنا عباد بن منصور، عن عكرمة، عن ابن عباس قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 1666,
          "end": 1676,
          "span_id": "s011"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 1666,
          "end": 1704,
          "stripped": "حدثنا يزيد، أخبرنا عباد بن منصور،",
          "span_id": "s011"
        },
        {
          "family": "HADITH",
          "marker": "أخبرنا",
          "start": 1683,
          "end": 1689,
          "span_id": "s011"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 1705,
          "end": 1731,
          "stripped": "عن عكرمة، عن ابن عباس قال:",
          "span_id": "s011"
        },
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "NARRATOR",
          "start": 1708,
          "end": 1713,
          "span_id": "s011"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 1718,
          "end": 1726,
          "span_id": "s011"
        }
      ]
    },
    {
      "id": "s012",
      "start": 1731,
      "end": 1900,
      "text": " لما نزلت {وَالَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ ثُمَّ لَمْ يَأْتُوا بِأَرْبَعَةِ شُهَدَاءَ فَاجْلِدُوهُمْ ثَمَانِينَ جَلْدَةً وَلَا تَقْبَلُوا لَهُمْ شَهَادَةً أَبَدًا} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 1741,
          "end": 1899,
          "span_id": "s012"
        },
        {
          "family": "QURAN",
          "marker": "verse_ref",
          "start": 1900,
          "end": 1910,
          "text": "[النور: 4]",
          "via": "apparatus",
          "span_id": "s012"
        }
      ]
    },
    {
      "id": "s013",
      "start": 1910,
      "end": 1961,
      "text": " قال سعد بن عبادة وهو سيد الأنصار - رضي الله عنه -:",
      "markers": []
    },
    {
      "id": "s014",
      "start": 1961,
      "end": 1989,
      "text": " أهكذا أنزلت يا رسول اللَّه؟",
      "markers": []
    },
    {
      "id": "s015",
      "start": 1989,
      "end": 2028,
      "text": " فقال رسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 1991,
          "end": 2004,
          "span_id": "s015"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2007,
          "end": 2025,
          "span_id": "s015"
        }
      ]
    },
    {
      "id": "s016",
      "start": 2028,
      "end": 2071,
      "text": " \"يا معشر الأنصار ألا تسمعون ما يقول سيدكم؟",
      "markers": []
    },
    {
      "id": "s017",
      "start": 2071,
      "end": 2213,
      "text": " \" فقالوا: يا رسول اللَّه لا تلمه فإنه رجل غيور، والله ما تزوج امرأة قط إلا بكرًا، وما طلق امرأة له قط فاجترأ رجل منا أن يتزوجها من شدة غيرته.",
      "markers": []
    },
    {
      "id": "s018",
      "start": 2213,
      "end": 2314,
      "text": " فقال سعد: والله يا رسول اللَّه إني لأعلم أنها حق وأنها من اللَّه، ولكني قد تعجبت أني لو وجدت لكاعًا ",
      "markers": []
    },
    {
      "id": "s019",
      "start": 2326,
      "end": 2434,
      "text": " قد تفخذها رجل لم يكن لي أن أهيجه ولا أحركه حتَّى آتي بأربعة شهداء، فوالله لا آتي بهم حتَّى يقضي حاجته -قال:",
      "markers": []
    },
    {
      "id": "s020",
      "start": 2434,
      "end": 2646,
      "text": " فما لبثوا إلا يسيرًا- حتَّى جاء هلال بن أمية وهو أحد الثلاثة الذين تيب عليهم، فجاء من أرضه عشاء، فوجد عند أهله رجلًا، فرأى بعينيه وسمع بأذنيه فلم يهيجه حتَّى أصبح، فغدا على رسول الله - صلى الله عليه وسلم - فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2620,
          "end": 2638,
          "span_id": "s020"
        }
      ]
    },
    {
      "id": "s021",
      "start": 2646,
      "end": 2814,
      "text": " يا رسول الله إني جئت على أهلي عشاء فوجدت عندها رجلًا، فرأيت بعيني وسمعت بأذني، فكره رسول الله - صلى الله عليه وسلم - ما جاء به واشتد عليه، واجتمعت عليه الأنصار وقالوا:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2743,
          "end": 2761,
          "span_id": "s021"
        }
      ]
    },
    {
      "id": "s022",
      "start": 2814,
      "end": 2937,
      "text": " قد ابتلينا بما قال سعد بن عبادة الآن، يضرب رسول الله - صلى الله عليه وسلم - هلال بن أمية ويبطل شهادته في الناس، فقال هلال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 2870,
          "end": 2888,
          "span_id": "s022"
        }
      ]
    },
    {
      "id": "s023",
      "start": 2937,
      "end": 2982,
      "text": " والله إني لأرجو أن يجعل الله لي منها مخرجًا.",
      "markers": []
    },
    {
      "id": "s024",
      "start": 2982,
      "end": 3067,
      "text": " وقال هلال: يا رسول اللَّه فإني قد أرى ما اشتد عليك مما جئت به، والله يعلم إني لصادق.",
      "markers": []
    },
    {
      "id": "s025",
      "start": 3067,
      "end": 3131,
      "text": " فواللهِ إن رسول الله - صلى الله عليه وسلم - يريد أن يأمر بضربه؛",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3091,
          "end": 3109,
          "span_id": "s025"
        }
      ]
    },
    {
      "id": "s026",
      "start": 3131,
      "end": 3186,
      "text": " إذ أنزل اللَّه على رسوله - صلى الله عليه وسلم - الوحي.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3159,
          "end": 3177,
          "span_id": "s026"
        }
      ]
    },
    {
      "id": "s027",
      "start": 3186,
      "end": 3231,
      "text": "\r\nوكان إذا أنزل عليه الوحي عرفوا ذلك في تربد ",
      "markers": []
    },
    {
      "id": "s028",
      "start": 3251,
      "end": 3444,
      "text": " وجهه؛ يعني: فأمسكوا عنه حتَّى فرغ من الوحي، فنزلت {وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ وَلَمْ يَكُنْ لَهُمْ شُهَدَاءُ إِلَّا أَنْفُسُهُمْ فَشَهَادَةُ أَحَدِهِمْ أَرْبَعُ شَهَادَاتٍ بِاللَّهِ .",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فنزلت",
          "start": 3296,
          "end": 3301,
          "span_id": "s028"
        }
      ]
    },
    {
      "id": "s029",
      "start": 3444,
      "end": 3509,
      "text": ". .. } الآية، فسُريَّ عن رسول اللَّه - صلى الله عليه وسلم - فقال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3483,
          "end": 3501,
          "span_id": "s029"
        }
      ]
    },
    {
      "id": "s030",
      "start": 3509,
      "end": 3567,
      "text": " \"أبشر يا هلال فقد جعل اللَّه لك فرجًا ومخرجًا\" فقال هلال:",
      "markers": []
    },
    {
      "id": "s031",
      "start": 3567,
      "end": 3648,
      "text": " قد كنت أرجو ذلك من ربي -عَزَّ وَجَلَّ-، فقال رسول اللَّه - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 3609,
          "end": 3624,
          "span_id": "s031"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3627,
          "end": 3645,
          "span_id": "s031"
        }
      ]
    },
    {
      "id": "s032",
      "start": 3648,
      "end": 3794,
      "text": " \"أرسلوا إليها\" فأرسلوا إليها فجاءت، فتلاها رسول اللِّه - صلى الله عليه وسلم - عليهما، فذكرهما وأخبرهما عذاب الآخرة أشد من عذاب الدنيا، فقال هلال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3706,
          "end": 3724,
          "span_id": "s032"
        }
      ]
    },
    {
      "id": "s033",
      "start": 3794,
      "end": 3838,
      "text": " والله يا رسول اللَّه لقد صدقت عليها، فقالت:",
      "markers": []
    },
    {
      "id": "s034",
      "start": 3838,
      "end": 3882,
      "text": " كذب، فقال رسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 3845,
          "end": 3858,
          "span_id": "s034"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 3861,
          "end": 3879,
          "span_id": "s034"
        }
      ]
    },
    {
      "id": "s035",
      "start": 3882,
      "end": 3983,
      "text": " \"لاعنوا بينهما\" فقيل لهلال: اشهد، فشهد أربع شهادات بالله إنه لمن الصادقين، فلما كانت الخامسة قيل له:",
      "markers": []
    },
    {
      "id": "s036",
      "start": 3983,
      "end": 4085,
      "text": " يا هلال اتق اللَّه، فإن عذاب الدنيا أهون من عذاب الآخرة، وإن هذه الموجبة التي توجب عليك العذاب، فقال:",
      "markers": []
    },
    {
      "id": "s037",
      "start": 4085,
      "end": 4206,
      "text": " والله لا يعذبني اللَّه عليها كما لم يجلدني عليها، فشهد في الخامسة أن لعنة اللَّه عليه إن كان من الكاذبين، ثم قيل للمرأة:",
      "markers": []
    },
    {
      "id": "s038",
      "start": 4206,
      "end": 4270,
      "text": " اشهدي أربع شهادات بالله إنه لمن الكاذبين، وقيل لها عند الخامسة:",
      "markers": []
    },
    {
      "id": "s039",
      "start": 4270,
      "end": 4395,
      "text": " اتقي اللَّه، فإن عذاب الدنيا أهون من عذاب الآخرة، وإن هذه الموجبة التي توجب عليك العذاب فتلكأت ساعة وهمت بالاعتراف، ثم قالت:",
      "markers": []
    },
    {
      "id": "s040",
      "start": 4395,
      "end": 4472,
      "text": " والله لا أفضح قومي، فشهدت في الخامسة أن غضب اللَّه عليها إن كان من الصادقين.",
      "markers": []
    },
    {
      "id": "s041",
      "start": 4472,
      "end": 4703,
      "text": "\r\nففرق رسول الله - صلى الله عليه وسلم - بينهما، وقضى أن لا يدعى ولدها لأب، ولا يرمى ولدها، ومن رماها أو رمى ولدها فعليه الحد، وقضى أن لا بيت لها عليه ولا قوت لها من أجل أن يفترقا من غير طلاق ولا متوفى عنها، وقال: \"إن جاءت به أصيهب ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 4491,
          "end": 4509,
          "span_id": "s041"
        }
      ]
    },
    {
      "id": "s042",
      "start": 4714,
      "end": 4721,
      "text": " أريسح ",
      "markers": []
    },
    {
      "id": "s043",
      "start": 4741,
      "end": 4754,
      "text": " حمس الساقين ",
      "markers": []
    },
    {
      "id": "s044",
      "start": 4773,
      "end": 4877,
      "text": "، فهو لهلال، وإن جاءت به أورق جعدًا جماليًا خدلج الساقين سابغ الأليتين، فهو الذي رميت به\" فجاءت به أورق ",
      "markers": []
    },
    {
      "id": "s045",
      "start": 4888,
      "end": 4895,
      "text": " جعدًا ",
      "markers": []
    },
    {
      "id": "s046",
      "start": 4911,
      "end": 4920,
      "text": " جماليًا ",
      "markers": []
    },
    {
      "id": "s047",
      "start": 4938,
      "end": 4952,
      "text": " خدلج الساقين ",
      "markers": []
    },
    {
      "id": "s048",
      "start": 4971,
      "end": 5025,
      "text": " سابغ الأليتين، فقال رسول الله - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 4988,
          "end": 5001,
          "span_id": "s048"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5004,
          "end": 5022,
          "span_id": "s048"
        }
      ]
    },
    {
      "id": "s049",
      "start": 5025,
      "end": 5058,
      "text": " \"لولا الأيمان لكان لي ولها شأن\".",
      "markers": []
    },
    {
      "id": "s050",
      "start": 5058,
      "end": 5128,
      "text": "\r\nقال عكرمة: فكان بعد ذلك أميرًا على مصر، وكان يدعى لأمه ولا يدعى لأب ",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "عكرمة",
          "name": "عكرمة",
          "role": "SPEAKER",
          "start": 5064,
          "end": 5069,
          "span_id": "s050"
        }
      ]
    },
    {
      "id": "s051",
      "start": 5213,
      "end": 5281,
      "text": ". ورواه أبو داود، عن الحسن بن علي، عن يزيد بن هارون به نحوه مختصرًا ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 5216,
          "end": 5220,
          "span_id": "s051"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 5231,
          "end": 5267,
          "stripped": "عن الحسن بن علي، عن يزيد بن هارون به",
          "span_id": "s051"
        },
        {
          "family": "TABIIN",
          "marker": "الحسن",
          "name": "الحسن",
          "role": "NARRATOR",
          "start": 5234,
          "end": 5239,
          "span_id": "s051"
        },
        {
          "family": "SAHABA",
          "marker": "علي",
          "name": "علي",
          "role": "NARRATOR",
          "start": 5243,
          "end": 5246,
          "span_id": "s051"
        }
      ]
    },
    {
      "id": "s052",
      "start": 5328,
      "end": 5409,
      "text": ".\r\nولهذا الحديث شواهد كثيرة في الصحاح وغيرها من وجوه كثيرة، فمنها ما قال البخاري:",
      "markers": []
    },
    {
      "id": "s053",
      "start": 5409,
      "end": 5614,
      "text": " حدثني محمد بن بشار، حَدَّثَنَا ابن أبي عدي، عن هشام بن حسان، حدثني عكرمة، عن ابن عباس أن هلال بن أمية قذف امرأته عند النَّبِيّ - صلى الله عليه وسلم - بشريك بن سحماء، فقال النَّبِيّ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 5430,
          "end": 5440,
          "span_id": "s053"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 5487,
          "end": 5495,
          "span_id": "s053"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5539,
          "end": 5557,
          "span_id": "s053"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5593,
          "end": 5611,
          "span_id": "s053"
        }
      ]
    },
    {
      "id": "s054",
      "start": 5614,
      "end": 5643,
      "text": " \"البينة أو حد في ظهرك\" فقال:",
      "markers": []
    },
    {
      "id": "s055",
      "start": 5643,
      "end": 5709,
      "text": " يا رسول اللَّه إذا رأى أحدنا على امرأته رجلًا ينطلق يلتمس البينة؟",
      "markers": []
    },
    {
      "id": "s056",
      "start": 5709,
      "end": 5753,
      "text": " فجعل النَّبِيّ - صلى الله عليه وسلم - يقول:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5727,
          "end": 5745,
          "span_id": "s056"
        }
      ]
    },
    {
      "id": "s057",
      "start": 5753,
      "end": 5789,
      "text": " \"البينة وإلا حد في ظهرك\" فقال هلال:",
      "markers": []
    },
    {
      "id": "s058",
      "start": 5789,
      "end": 6066,
      "text": " والذي بعثك بالحق إني لصادق ولينزلن اللَّه ما يبرئ ظهري من الحد، فنزل جبريل وأنزل عليه {وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ} فقرأ حتَّى بلغ {إِنْ كَانَ مِنَ الصَّادِقِينَ} فانصرف النَّبِيّ - صلى الله عليه وسلم -، فأرسل إليهما، فجاء هلال فشهد والنبي - صلى الله عليه وسلم - يقول:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5876,
          "end": 5913,
          "span_id": "s058"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 5915,
          "end": 5918,
          "span_id": "s058"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 5929,
          "end": 5960,
          "span_id": "s058"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 5980,
          "end": 5998,
          "span_id": "s058"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6040,
          "end": 6058,
          "span_id": "s058"
        }
      ]
    },
    {
      "id": "s059",
      "start": 6066,
      "end": 6114,
      "text": " \"إن اللَّه يعلم أن أحدكما كاذب، فهل منكما تائب؟",
      "markers": []
    },
    {
      "id": "s060",
      "start": 6114,
      "end": 6166,
      "text": " \" ثم قامت فشهدت، فلما كان في الخامسة وقفوها وقالوا:",
      "markers": []
    },
    {
      "id": "s061",
      "start": 6166,
      "end": 6196,
      "text": " إنها موجبة، قال ابن عَبَّاسٍ:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6183,
          "end": 6194,
          "span_id": "s061"
        }
      ]
    },
    {
      "id": "s062",
      "start": 6196,
      "end": 6240,
      "text": " فتلكأت ونكصت حتَّى ظننا أنها ترجع، ثم قالت:",
      "markers": []
    },
    {
      "id": "s063",
      "start": 6240,
      "end": 6309,
      "text": " لا أفضح قومي سائر اليوم فمضت، فقال النَّبِيّ - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6288,
          "end": 6306,
          "span_id": "s063"
        }
      ]
    },
    {
      "id": "s064",
      "start": 6309,
      "end": 6442,
      "text": " \"أبصروها فإن جاءت به أكحل العينين سابغ الأليتين خدلج الساقين، فهو لشريك ابن سحماء\" فجاءت به كذلك، فقال النبي - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6421,
          "end": 6439,
          "span_id": "s064"
        }
      ]
    },
    {
      "id": "s065",
      "start": 6442,
      "end": 6489,
      "text": " \"لولا ما مضى من كتاب اللَّه لكان لي ولها شأن\" ",
      "markers": []
    },
    {
      "id": "s066",
      "start": 6616,
      "end": 6687,
      "text": "، انفرد به البخاري من هذا الوجه، وقد رواه من غير وجه عن ابن عباس وغيره.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 6653,
          "end": 6657,
          "span_id": "s066"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 6672,
          "end": 6680,
          "span_id": "s066"
        }
      ]
    },
    {
      "id": "s067",
      "start": 6687,
      "end": 6788,
      "text": "\r\nوقال ابن أبي حاتم: حَدَّثَنَا أحمد بن منصور الرمادي، حَدَّثَنَا يونس بن محمد، حَدَّثَنَا صالح -وهو:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6708,
          "end": 6718,
          "span_id": "s067"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6742,
          "end": 6752,
          "span_id": "s067"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 6742,
          "end": 6788,
          "stripped": "حدثنا يونس بن محمد، حدثنا صالح -وهو:",
          "span_id": "s067"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6767,
          "end": 6777,
          "span_id": "s067"
        }
      ]
    },
    {
      "id": "s068",
      "start": 6788,
      "end": 6821,
      "text": " ابن عمر-، حَدَّثَنَا عاصم -يعني:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 6799,
          "end": 6809,
          "span_id": "s068"
        }
      ]
    },
    {
      "id": "s069",
      "start": 6821,
      "end": 6861,
      "text": " ابن كليب-، عن أبيه، حدثني ابن عباس قال:",
      "markers": [
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "SPEAKER",
          "start": 6848,
          "end": 6856,
          "span_id": "s069"
        }
      ]
    },
    {
      "id": "s070",
      "start": 6861,
      "end": 7010,
      "text": " جاء رجل إلى رسول اللَّه - صلى الله عليه وسلم - فرمى امرأته برجل، فكره ذلك رسول اللَّه - صلى الله عليه وسلم -، فلم يزل يردده حتَّى أنزل اللَّه تعالى:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6888,
          "end": 6906,
          "span_id": "s070"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 6950,
          "end": 6968,
          "span_id": "s070"
        }
      ]
    },
    {
      "id": "s071",
      "start": 7010,
      "end": 7133,
      "text": " {وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ وَلَمْ يَكُنْ لَهُمْ شُهَدَاءُ} فقرأ حتَّى فرغ من الآيتين، فأرسل إليهما فدعاهما فقال:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 7011,
          "end": 7079,
          "span_id": "s071"
        },
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 7081,
          "end": 7084,
          "span_id": "s071"
        }
      ]
    },
    {
      "id": "s072",
      "start": 7133,
      "end": 7268,
      "text": " \"إن اللَّه تعالى قد أنزل فيكما\" فدعا الرجل فقرأ عليه، فشهد أربع شهادات بالله إنه لمن الصادقين، ثم أمر به فأمسك على فيه فوعظه، فقال له:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 7178,
          "end": 7181,
          "span_id": "s072"
        }
      ]
    },
    {
      "id": "s073",
      "start": 7268,
      "end": 7317,
      "text": " \"كل شيء أهون عليه من لعنة اللَّه\" ثم أرسله فقال:",
      "markers": []
    },
    {
      "id": "s074",
      "start": 7317,
      "end": 7452,
      "text": " \"لعنة اللَّه عليه إن كان من الكاذبين\" ثم دعاها فقرأ عليها، فشهدت أربع شهادات بالله إنه من الكاذبين، ثم أمر فأمسك على فيها فوعظها وقال:",
      "markers": [
        {
          "family": "QIRAAT",
          "marker": "قرأ",
          "start": 7366,
          "end": 7369,
          "span_id": "s074"
        }
      ]
    },
    {
      "id": "s075",
      "start": 7452,
      "end": 7502,
      "text": " \"ويحك كل شيء أهون من غضب اللَّه\" ثم أرسلها فقالت:",
      "markers": []
    },
    {
      "id": "s076",
      "start": 7502,
      "end": 7539,
      "text": " غضب اللَّه عليها إن كان من الصادقين.",
      "markers": []
    },
    {
      "id": "s077",
      "start": 7539,
      "end": 7580,
      "text": " فقال رسول اللَّه - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "قال رسول الله",
          "start": 7541,
          "end": 7556,
          "span_id": "s077"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 7559,
          "end": 7577,
          "span_id": "s077"
        }
      ]
    },
    {
      "id": "s078",
      "start": 7580,
      "end": 7622,
      "text": " \"أما والله لأقضين بينكما قضاء فصلًا\" قال:",
      "markers": []
    },
    {
      "id": "s079",
      "start": 7622,
      "end": 7677,
      "text": " فولدت فما رأيت مولودًا بالمدينة أكثر غاشيةً منه، فقال:",
      "markers": []
    },
    {
      "id": "s080",
      "start": 7677,
      "end": 7768,
      "text": " \"إن جاءت به لكذا وكذا فهو كذا، وإن جاءت به لكذا وكذا فهو كذا\"، فجاءت به يشبه الذي قذفت به ",
      "markers": []
    },
    {
      "id": "s081",
      "start": 7812,
      "end": 7897,
      "text": ".\r\nوقال الإمام أحمد: حَدَّثَنَا يحيى بن سعيد، حَدَّثَنَا عبد الملك بن أبي سليمان قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7833,
          "end": 7843,
          "span_id": "s081"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 7833,
          "end": 7881,
          "stripped": "حدثنا يحيى بن سعيد، حدثنا عبد الملك بن",
          "span_id": "s081"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 7858,
          "end": 7868,
          "span_id": "s081"
        }
      ]
    },
    {
      "id": "s082",
      "start": 7897,
      "end": 7920,
      "text": " سمعت سعيد بن جبير قال:",
      "markers": [
        {
          "family": "TABIIN",
          "marker": "سعيد بن جبير",
          "name": "سعيد بن جبير",
          "role": "SPEAKER",
          "start": 7903,
          "end": 7915,
          "span_id": "s082"
        }
      ]
    },
    {
      "id": "s083",
      "start": 7920,
      "end": 7974,
      "text": " سُئلت عن المتلاعنين أيفرق بينهما في إمارة ابن الزبير؟",
      "markers": []
    },
    {
      "id": "s084",
      "start": 7974,
      "end": 8029,
      "text": " فما دريت ما أقول، فقمت من مكاني إلى منزل ابن عمر فقلت:",
      "markers": [
        {
          "family": "RAY",
          "marker": "قلت",
          "start": 8025,
          "end": 8028,
          "span_id": "s084"
        }
      ]
    },
    {
      "id": "s085",
      "start": 8029,
      "end": 8073,
      "text": " يا أبا عبد الرحمن، المتلاعنان أيفرق بينهما؟",
      "markers": []
    },
    {
      "id": "s086",
      "start": 8073,
      "end": 8134,
      "text": " فقال: سبحان اللَّه، إن أول من سأل عن ذلك فلان بن فلان، فقال:",
      "markers": []
    },
    {
      "id": "s087",
      "start": 8134,
      "end": 8246,
      "text": " يا رسول اللَّه أرأيت الرجل يرى امرأته على فاحشة فإن تكلم تكلم بأمر عظيم وإن سكت سكت على مثل ذلك، فسكت فلم يجبه.",
      "markers": []
    },
    {
      "id": "s088",
      "start": 8246,
      "end": 8275,
      "text": "\r\nفلما كان بعد ذلك أتاه فقال:",
      "markers": []
    },
    {
      "id": "s089",
      "start": 8275,
      "end": 8532,
      "text": " الذي سألتك عنه قد ابتليت به، فأنزل اللَّه تعالى هذه الآيات في سورة النور {وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ} حتَّى بلغ {أَنَّ غَضَبَ اللَّهِ عَلَيْهَا إِنْ كَانَ مِنَ الصَّادِقِينَ} فبدأ بالرجل فوعظه وذكره، وأخبره أن عذاب الدنيا أهون من عذاب الآخرة فقال:",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 8305,
          "end": 8310,
          "span_id": "s089"
        },
        {
          "family": "NUZUL",
          "marker": "فأنزل الله",
          "start": 8305,
          "end": 8317,
          "span_id": "s089"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8349,
          "end": 8386,
          "span_id": "s089"
        },
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 8397,
          "end": 8459,
          "span_id": "s089"
        }
      ]
    },
    {
      "id": "s090",
      "start": 8532,
      "end": 8634,
      "text": " والذي بعثك بالحق ما كذبتك، ثم ثنّى بالمرأة فوعظها وذكرها، وأخبرها أن عذاب الدنيا أهون من عذاب الآخرة.",
      "markers": []
    },
    {
      "id": "s091",
      "start": 8634,
      "end": 8681,
      "text": " فقالت المرأة: والذي بعثك بالحق إنه لكاذب، قال:",
      "markers": []
    },
    {
      "id": "s092",
      "start": 8681,
      "end": 8906,
      "text": " فبدأ بالرجل، فشهد أربع شهادات بالله إنه لمن الصادقين، والخامسة أن لعنة اللَّه عليه إن كان من الكاذبين، ثم ثنى بالمرأة، فشهدت أربع شهادات بالله إنه لمن الكاذبين، والخامسة أن غضب اللَّه عليها إن كان من الصادقين، ثم فرق بينهما.",
      "markers": []
    },
    {
      "id": "s093",
      "start": 8906,
      "end": 9020,
      "text": " رواه النسائي في التفسير من حديث عبد الملك بن أبي سليمان به، وأخرجاه فى الصحيحين من حديث سعيد بن جبير عن ابن عباس ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 8907,
          "end": 8911,
          "span_id": "s093"
        },
        {
          "family": "SAHABA",
          "marker": "ابن عباس",
          "name": "ابن عباس",
          "role": "NARRATOR",
          "start": 9011,
          "end": 9019,
          "span_id": "s093"
        }
      ]
    },
    {
      "id": "s094",
      "start": 9150,
      "end": 9270,
      "text": ". \r\nوقال الإمام أحمد: حَدَّثَنَا يحيى بن حماد، حَدَّثَنَا أبو عوانة، عن الأعمش، عن إبراهيم، عن علقمة، عن عبد اللَّه قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9172,
          "end": 9182,
          "span_id": "s094"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 9172,
          "end": 9221,
          "stripped": "حدثنا يحيى بن حماد، حدثنا أبو عوانة، عن",
          "span_id": "s094"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9197,
          "end": 9207,
          "span_id": "s094"
        },
        {
          "family": "ISNAD",
          "marker": "عن…عن",
          "start": 9219,
          "end": 9265,
          "stripped": "عن الأعمش، عن إبراهيم، عن علقمة، عن عبد الله",
          "span_id": "s094"
        }
      ]
    },
    {
      "id": "s095",
      "start": 9270,
      "end": 9325,
      "text": " كنا جلوسًا عشية الجمعة في المسجد، فقال رجل من الأنصار:",
      "markers": []
    },
    {
      "id": "s096",
      "start": 9325,
      "end": 9484,
      "text": " أحدنا إذا رأى مع امرأته رجلًا إن قتله قتلتموه، وإن تكلم جلدتموه، وإن سكت سكت على غيظ، والله لئن أصبحت صالحًا لأسألنَّ رسول اللَّه - صلى الله عليه وسلم -، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 9458,
          "end": 9476,
          "span_id": "s096"
        }
      ]
    },
    {
      "id": "s097",
      "start": 9484,
      "end": 9613,
      "text": " فسأله، فقال: يا رسول اللَّه إن أحدنا إذا رأى مع امرأته رجلًا فقتله قتلتموه، وإن تكلم جلدتموه، وإن سكت سكت على غيظ، اللَّهم احكم.",
      "markers": []
    },
    {
      "id": "s098",
      "start": 9613,
      "end": 9669,
      "text": " قال: فأنزلت آية اللعان، فكان ذلك الرجل أول من ابتلي به.",
      "markers": [
        {
          "family": "NUZUL",
          "marker": "فأنزل",
          "start": 9619,
          "end": 9624,
          "span_id": "s098"
        }
      ]
    },
    {
      "id": "s099",
      "start": 9669,
      "end": 9733,
      "text": " انفرد بإخراجه مسلم، فرواه من طرق عن سليمان بن مهران الأعمش، به ",
      "markers": [
        {
          "family": "HADITH",
          "marker": "رواه",
          "start": 9691,
          "end": 9695,
          "span_id": "s099"
        }
      ]
    },
    {
      "id": "s100",
      "start": 9780,
      "end": 9806,
      "text": ".\r\nوقال الإمام أحمد أيضًا:",
      "markers": []
    },
    {
      "id": "s101",
      "start": 9806,
      "end": 9894,
      "text": " حَدَّثَنَا أبو كامل، حَدَّثَنَا إبراهيم بن سعد، حَدَّثَنَا ابن شهاب، عن سهل بن سعد قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9807,
          "end": 9817,
          "span_id": "s101"
        },
        {
          "family": "ISNAD",
          "marker": "حدثنا…حدثنا",
          "start": 9807,
          "end": 9878,
          "stripped": "حدثنا أبو كامل، حدثنا إبراهيم بن سعد، حدثنا ابن شهاب، عن",
          "span_id": "s101"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9828,
          "end": 9838,
          "span_id": "s101"
        },
        {
          "family": "HADITH",
          "marker": "حدثنا",
          "start": 9855,
          "end": 9865,
          "span_id": "s101"
        }
      ]
    },
    {
      "id": "s102",
      "start": 9894,
      "end": 9921,
      "text": " جاء عويمر إلى عاصم بن عدي ",
      "markers": []
    },
    {
      "id": "s103",
      "start": 10104,
      "end": 10152,
      "text": " فقال له: سل رسول اللَّه - صلى الله عليه وسلم -:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 10131,
          "end": 10149,
          "span_id": "s103"
        }
      ]
    },
    {
      "id": "s104",
      "start": 10152,
      "end": 10213,
      "text": " أرأيت رجلًا وجد رجلًا مع امرأته فقتله أيقتل به، أم كيف يصنع؟",
      "markers": []
    },
    {
      "id": "s105",
      "start": 10213,
      "end": 10312,
      "text": " فسأل عاصم رسول اللَّه - صلى الله عليه وسلم - فعاب رسول اللَّه - صلى الله عليه وسلم - المسائل، قال:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 10238,
          "end": 10256,
          "span_id": "s105"
        },
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 10278,
          "end": 10296,
          "span_id": "s105"
        }
      ]
    },
    {
      "id": "s106",
      "start": 10312,
      "end": 10339,
      "text": " فلقيه عويمر فقال: ما صنعت؟",
      "markers": []
    },
    {
      "id": "s107",
      "start": 10339,
      "end": 10437,
      "text": " قال: ما صنعت إنك لم تأتني بخير، سألت رسول اللَّه - صلى الله عليه وسلم - فعاب المسائل، فقال عويمر:",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 10391,
          "end": 10409,
          "span_id": "s107"
        }
      ]
    },
    {
      "id": "s108",
      "start": 10437,
      "end": 10492,
      "text": " والله لآتين رسول الله - صلى الله عليه وسلم - فلأسألنه.",
      "markers": [
        {
          "family": "HADITH",
          "marker": "صلى الله عليه وسلم",
          "start": 10462,
          "end": 10480,
          "span_id": "s108"
        }
      ]
    },
    {
      "id": "s109",
      "start": 10492,
      "end": 10529,
      "text": " فأتاه فوجده قد أنزل عليه فيهما، قال:",
      "markers": []
    },
    {
      "id": "s110",
      "start": 10529,
      "end": 10564,
      "text": " فدعا بهما فلاعن بينهما. قال عويمر:",
      "markers": []
    }
  ],

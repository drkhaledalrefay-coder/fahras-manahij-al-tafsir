    {
      "id": "s001",
      "start": 0,
      "end": 128,
      "text": "لِيَجْزِيَهُمُ اللَّهُ أَحْسَنَ مَا عَمِلُوا وَيَزِيدَهُمْ مِنْ فَضْلِهِ وَاللَّهُ يَرْزُقُ مَنْ يَشَاءُ بِغَيْرِ حِسَابٍ (38)\r\n",
      "markers": []
    },
    {
      "id": "s002",
      "start": 128,
      "end": 178,
      "text": "{لِيَجْزِيَهُمُ اللَّهُ أَحْسَنَ مَا عَمِلُوا} أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",

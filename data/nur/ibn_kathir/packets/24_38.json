          "marker": "قال تعالى",
          "start": 303,
          "end": 312,
          "span_id": "s005"
        }
      ]
    },
    {
      "id": "s006",
      "start": 313,
      "end": 440,
      "text": " {إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَإِنْ تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِنْ لَدُنْهُ أَجْرًا عَظِيمًا (40)} ",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 314,
          "end": 439,
          "span_id": "s006"
        }
      ]
    },
    {
      "id": "s007",
      "start": 448,
      "end": 516,
      "text": "، وقال تعالى: {مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا} ",
      "markers": [

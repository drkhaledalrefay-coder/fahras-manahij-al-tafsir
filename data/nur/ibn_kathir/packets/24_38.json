          "start": 175,
          "end": 178,
          "span_id": "s002"
        }
      ]
    },
    {
      "id": "s003",
      "start": 178,
      "end": 227,
      "text": " هؤلاء من الذين يتقبل حسناتهم ويتجاوز عن سيئاتهم.",
      "markers": []
    },
    {
      "id": "s004",
      "start": 227,
      "end": 268,
      "text": " وقوله: {وَيَزِيدَهُمْ مِنْ فَضْلِهِ} أي:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "{…}",
          "start": 235,
          "end": 264,
          "span_id": "s004"
        },
        {
          "family": "LUGHA",
          "marker": "أي:",
          "start": 265,
          "end": 268,
          "span_id": "s004"
        }
      ]
    },
    {
      "id": "s005",
      "start": 268,
      "end": 313,
      "text": " يتقبل منهم الحسن ويضاعفه لهم، كما قال تعالى:",
      "markers": [
        {
          "family": "QURAN",
          "marker": "كما قال تعالى",
          "start": 299,
          "end": 312,
          "span_id": "s005"
        },
        {

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 532,
      "end": 586,
      "text": "¬أخرجه الطبري وابن أبي حاتم بسند ثابت من طريق علي به.¥",
      "attached_span_id": "s003",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 716,
      "end": 822,
      "text": "¬أخرجه الطبري من طريق ابن جريج به وسنده ضعيف؛ لأن ابن جريج لم يسمع من مجاهد وابن عباس - رضي الله عنهما -.¥",
      "attached_span_id": "s005",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 947,
      "end": 1060,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده ضعيف لضعف وهب بن راشد (لسان الميزان 6/ 230، 231)، ويشهد له الرواية قبل السابقة.¥",
      "attached_span_id": "s007",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1458,
      "end": 1483,
      "text": "¬وهي قراءة شاذة تفسيرية.¥",
      "attached_span_id": "s014",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1524,
      "end": 1596,
      "text": "¬أخرجه الطبري وابن أبي حاتم مقطعًا بسند جيد من طريق أبي جعفر الرازي به.¥",
      "attached_span_id": "s015",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1685,
      "end": 1748,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق سعيد بن جبير عن ابن عباس.¥",
      "attached_span_id": "s017",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1830,
      "end": 1851,
      "text": "¬قراءة شاذة تفسيرية.¥",
      "attached_span_id": "s018",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1946,
      "end": 1999,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق أسباط عن السدي.¥",
      "attached_span_id": "s020",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2266,
      "end": 2342,
      "text": "¬رواه ابن إسحاق بلاغًا (ينظر: السيرة النبوية لابن هشام 1/ 420)، وسنده ضعيف.¥",
      "attached_span_id": "s022",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2568,
      "end": 2681,
      "text": "¬صحيح البخاري، الجمعة، باب التهجد بالليل (ح 1120)، وصحيح مسلم، صلاة المسافرين، باب الدعاء في صلاة الليل (ح 769).¥",
      "attached_span_id": "s025",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2890,
      "end": 2952,
      "text": "¬أخرجه الطبري بسند ثابت من طريق علي ابن أبي طلحة عن ابن عباس.¥",
      "attached_span_id": "s030",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3515,
      "end": 3708,
      "text": "¬قول ابن عباس أخرجه الطبري وابن أبي حاتم كسابقه، وقول مجاهد أخرجه ابن أبي حاتم بسند صحيح من طريق ابن أبي نجيح عنه، وقول محمد بن كعب أخرجه ابن أبي حاتم بسند حسن من طريق عاصم بن محمد العمري عنه.¥",
      "attached_span_id": "s036",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4182,
      "end": 4225,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق العوفي به.¥",
      "attached_span_id": "s044",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4278,
      "end": 4347,
      "text": "¬أخرجه الطبري وابن أبي حاتم بسند صحيح من طريق ابن أبي نجيح عن مجاهد.¥",
      "attached_span_id": "s045",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4399,
      "end": 4482,
      "text": "¬أخرجه الطبري وابن أبي حاتم بسند حسن من طريق حصين بن عبد الرحمن عن أبي مالك غزوان.¥",
      "attached_span_id": "s047",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4535,
      "end": 4599,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق داود ابن أبي هند عن مجاهد.¥",
      "attached_span_id": "s048",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4789,
      "end": 4872,
      "text": "¬أخرجه الطبري وابن أبي حاتم بسند جيد من طريق أبي العالية عن أُبي - رضي الله عنه -.¥",

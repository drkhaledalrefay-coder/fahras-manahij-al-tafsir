  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 772,
      "end": 807,
      "text": "¬تقدم تخريجه في تفسير الآية نفسها.¥",
      "attached_span_id": "s003",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1309,
      "end": 1372,
      "text": "¬أخرجه ابن أبي حاتم بسند ضعيف فيه حفص بن عمر العدني، وهو ضعيف.¥",
      "attached_span_id": "s009",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1858,
      "end": 1930,
      "text": "¬أخرجه ابن أبي حاتم من طريق الثوري به، وفي سنده جابر، وهو الجعفي: ضعيف.¥",
      "attached_span_id": "s012",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2032,
      "end": 2144,
      "text": "¬أخرجه ابن أبي حاتم من طريق ابن وهب به، وسنده ضعيف لإبهام الراوي عن عطاء بن أبي رباح، وسيأتي بسند صحيح عن عطاء.¥",
      "attached_span_id": "s014",
      "grading": [
        "صحيح",
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2170,
      "end": 2239,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق بكير بن معروف عن مقاتل بن حيان.¥",
      "attached_span_id": "s015",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2780,
      "end": 2973,
      "text": "¬صحيح البخاري، العتق، باب في المكاتب ونجومه في كل سنة نجم، قبل حديث رقم 2560، ووصله إسماعيل بن إسحاق القاضي في \"أحكام القرآن\" عن علي بن المديني عن روح به (ينظر: فتح الباري 5/ 186)، وسنده صحيح.¥",
      "attached_span_id": "s022",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3148,
      "end": 3244,
      "text": "¬أخرجه عبد الرزاق بسنده ومتنه (المصنف 8/ 371)، وسنده صحيح، وأخرجه الطبري من طريق عبد الرزاق به.¥",
      "attached_span_id": "s026",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3397,
      "end": 3464,
      "text": "¬أخرجه الطبري بسنده ومتنه، وصحح سنده الحافظ ابن كثير، وهو كما قال.¥",
      "attached_span_id": "s028",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3543,
      "end": 3566,
      "text": "¬سنده ضعيف لضعف جويبر.¥",
      "attached_span_id": "s030",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3696,
      "end": 3817,
      "text": "¬أخرجه الإمام أحمد من حديث عمِّ أبي حرَّة الرقاشي مطولًا (المسند 34/ 299 - 301 ح 20695)، وقال محققوه: صحيح لغيره مقطعًا.¥",
      "attached_span_id": "s032",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4021,
      "end": 4099,
      "text": "¬الموطأ 2/ 788، وأخرجه الطبري بسند صحيح من طريق ابن وهب عن الإمام مالك بنحوه.¥",
      "attached_span_id": "s035",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4162,
      "end": 4247,
      "text": "¬أخرجه الطبري بسند صحيح من طريق ابن وهب، وهو عبد الله، عن عبد الرحمن بن زيد بن أسلم.¥",
      "attached_span_id": "s036",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4354,
      "end": 4410,
      "text": "¬أخرجه آدم بن أبي إياس بسند حسن من طريق مبارك عن الحسن.¥",
      "attached_span_id": "s038",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4431,
      "end": 4482,
      "text": "¬أخرجه الطبري بسند صحيح عن الحسن، وإبراهيم النخعي.¥",
      "attached_span_id": "s039",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4503,
      "end": 4575,
      "text": "¬أخرجه آدم بن أبي إياس والطبري بسند صحيح من طريق ابن أبي نجيح عن مجاهد.¥",
      "attached_span_id": "s040",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4601,
      "end": 4660,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق معمر عن قتادة بنحوه.¥",
      "attached_span_id": "s041",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4842,
      "end": 4888,
      "text": "¬سنده معضل؛ لأن يحيى ابن أبي كثير تابع تابعي.¥",
      "attached_span_id": "s045",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5047,
      "end": 5125,
      "text": "¬أخرجه البستي بسند حسن من طريق أبي عبد الرحمن السلمي عن علي - رضي الله عنه -.¥",
      "attached_span_id": "s047",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5152,
      "end": 5254,
      "text": "¬أخرجه البستي بسند ضعيف من طريق القاسم بن عبد الرحمن عن عمر - رضي الله عنه -، والقاسم لم يسمع من عمر.¥",
      "attached_span_id": "s048",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5477,
      "end": 5678,
      "text": "¬قول الحسن أخرجه الطبري بسند صحيح من طريق يونس عنه، وقول عبد الرحمن بن زيد أخرجه ابن أبي حاتم بسند صحيح من طريق ابن وهب عنه، وقول مقاتل بن سليمان أخرجه ابن أبي حاتم بسند حسن من طريق بكير بن معروف عنه.¥",
      "attached_span_id": "s051",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5810,
      "end": 5915,
      "text": "¬أخرجه عبد الرزاق بسند ضعيف من طريق مغيرة عن إبراهيم (المصنف 8/ 376)، ورواية مغيرة عن إبراهيم فيها مقال.¥",
      "attached_span_id": "s054",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5951,
      "end": 6015,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق عبد الله بن بريدة عن أبيه.¥",
      "attached_span_id": "s055",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6624,
      "end": 6689,
      "text": "¬هو القدر المعين الذي يؤديه المكاتب في وقت معين (النهاية 5/ 22).¥",
      "attached_span_id": "s064",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6707,
      "end": 6751,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده حسن.¥",
      "attached_span_id": "s065",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6991,
      "end": 7069,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده ضعيف لضعف ابن حميد، وهو محمد بن حميد الرازي.¥",
      "attached_span_id": "s067",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7196,
      "end": 7236,
      "text": "¬أخرجه الطبري بسند ثابت من طريق علي به.¥",
      "attached_span_id": "s069",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7313,
      "end": 7363,
      "text": "¬أخرج بعضها الطبري وابن أبي حاتم، وتتقوى بسابقها.¥",
      "attached_span_id": "s070",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7492,
      "end": 7577,
      "text": "¬أخرجه ابن أبي شيبة بسند صحيح من طريق عطاء بن أبي رباح عن ابن سيرين (المصنف 6/ 371).¥",
      "attached_span_id": "s072",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7812,
      "end": 7925,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده ضعيف فيه جندب: مستور، وعطاء بن السائب: صدوق اختلط، والصواب وقفه كما تقدم.¥",
      "attached_span_id": "s075",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8047,
      "end": 8121,
      "text": "¬تقدم تخريجه وثبوته عن علي - رضي الله عنه - موقوفًا في تفسير الآية نفسها.¥",
      "attached_span_id": "s076",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9113,
      "end": 9167,
      "text": "¬أخرجه ابن أبي حاتم بسند مرسل عن السدي ويتقوى كسابقه.¥",
      "attached_span_id": "s084",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9511,
      "end": 9606,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق بكير بن معروف عن مقاتل لكنه معضل، ولبعضه شواهد يتقوى بها.¥",
      "attached_span_id": "s086",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9852,
      "end": 10003,
      "text": "¬أخرجه الشيخان من حديث عقبة بن عمرو - رضي الله عنه - (صحيح البخاري، البيوع، باب ثمن الكلب ح 2237)، وصحيح مسلم، المساقاة، باب تحريم ثمن الكلب (ح 1567).¥",
      "attached_span_id": "s089",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10068,
      "end": 10211,
      "text": "¬أخرجه أبو داود من حديث رافع بن خديج - رضي الله عنه - (السنن، البيوع، باب في كسب الحجام ح 3421)، وصححه الألباني في صحيح سنن أبي داود (ح 2919).¥",
      "attached_span_id": "s090",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10433,
      "end": 10496,
      "text": "¬أخرجه الطبري وابن أبي حاتم بسند ثابت من طريق ابن أبي طلحة به.¥",
      "attached_span_id": "s094",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10544,
      "end": 10847,
      "text": "¬قول مجاهد أخرجه آدم بن أبي إياس والطبري بسند صحيح من طريق ابن أبي نجيح عنه، وقول عطاء الخراساني أخرجه ابن أبي حاتم بسند ضعيف من طريق عثمان بن عطاء عن أبيه، وعثمان: ضعيف، وقول الأعمش أخرجه ابن أبي حاتم بسند صحيح من طريق ابن نمير عن الأعمش، وقول قتادة أخرجه ابن أبي حاتم بسند صحيح من طريق ابن أبي عروبة.¥",
      "attached_span_id": "s095",
      "grading": [
        "صحيح",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11005,
      "end": 11017,
      "text": "¬سنده صحيح.¥",
      "attached_span_id": "s096",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11109,
      "end": 11179,
      "text": "¬أخرجه الطبري بسند صحيح من طريق ابن وهب عن عبد الرحمن بن زيد بن أسلم.¥",
      "attached_span_id": "s098",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11416,
      "end": 11523,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده ضعيف؛ لأن سعيد بن جبير لم يسمع من ابن مسعود، والقراءة شاذة تفسيرية.¥",
      "attached_span_id": "s101",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11636,
      "end": 11680,
      "text": "¬تقدم تخريجه في تفسير سورة الأعراف آية 157.¥",
      "attached_span_id": "s103",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

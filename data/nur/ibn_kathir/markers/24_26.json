  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 399,
      "end": 476,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق العوفي عن ابن عباس ويتقوى بالآثار التي تليه.¥",
      "attached_span_id": "s003",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 566,
      "end": 712,
      "text": "¬ذكرهم ابن أبي حاتم بحذف السند، وأخرج الطبري آثارهم بأسانيد ثابتة إلا قول الحسن البصري لم يخرجه وقد عزاه السيوطي في الدر المنثور إلى عبد بن حميد.¥",
      "attached_span_id": "s004",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1142,
      "end": 1214,
      "text": "¬أخرجه الطبري بسند صحيح من طريق ابن وهب - وهو عبد الله - عن عبد الرحمن.¥",
      "attached_span_id": "s007",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1971,
      "end": 2030,
      "text": "¬أي: تتردد وتتحرك، والجلجلة: حركة مع صوت (النهاية 1/ 284).¥",
      "attached_span_id": "s018",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2364,
      "end": 2408,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده حسن.¥",
      "attached_span_id": "s020",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2612,
      "end": 2767,
      "text": "¬أخرجه الإمام أحمد من حديث أبي هريرة - رضي الله عنه - (المسند 14/ 284 ح 8639)، وضعفه محققوه؛ لأن فيه علي بن زيد، وهو ابن جدعان: ضعيف، ولجهالة أوس بن خالد.¥",
      "attached_span_id": "s023",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2826,
      "end": 3045,
      "text": "¬أخرجه الترمذي وقال: هذا حديث غريب (السنن، أبواب العلم، باب في فضل الفقه على العبادة ح 2687)، وابن ماجه (السنن، الزهد، باب الحكمة ح 4169)، وضعفه السخاوي (المقاصد الحسنة ص 191، 192)، وضعفه الألباني في ضعيف سنن ابن ماجه.¥",
      "attached_span_id": "s024",
      "grading": [
        "حسن",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

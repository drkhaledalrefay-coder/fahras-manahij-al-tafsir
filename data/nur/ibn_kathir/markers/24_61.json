  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 820,
      "end": 1014,
      "text": "¬قول عطاء الخراساني أخرجه ابن أبي حاتم بسند ضعيف من طريق عثمان بن عطاء عنه، وعثمان ضعيف، وقول عبد الرحمن أخرجه الطبري بسند صحيح من طريق عبد الله بن وهب عنه لكنه معضل؛ لأن عبد الرحمن تابع تابعي.¥",
      "attached_span_id": "s002",
      "grading": [
        "صحيح",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2007,
      "end": 2104,
      "text": "¬أخرجه البستي وابن أبي حاتم بسند حسن من طريق عبيد بن سليمان عن الضحاك وهو مرسل، ويتقوى بما يليه.¥",
      "attached_span_id": "s008",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2424,
      "end": 2467,
      "text": "¬أخرجه عبد الرزاق بسنده ومتنه، وسنده صحيح.¥",
      "attached_span_id": "s012",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2865,
      "end": 2944,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق أسباط عن السدي لكنه مرسل، ويتقوى بما سبق.¥",
      "attached_span_id": "s015",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3303,
      "end": 3576,
      "text": "¬أخرجه الإمام أحمد من حديث عبد الله بن عمرو - رضي الله عنهما -، (المسند 11/ 261 ح 6678)، وقال محققوه: صحيح لغيره، وأخرجه أبو داود (السنن، الإجارة، باب في الرجل يأكل من مال ولده ح 3530)، وقال الألباني: حسن صحيح (صحيح سنن أبي داود ح 3015)، وابن ماجه (السنن، البيوع، ح 2292).¥",
      "attached_span_id": "s017",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3906,
      "end": 3976,
      "text": "¬القهرمان: القائم بأمور الرجل باللغة الفارسية (ينظر: النهاية 4/ 129).¥",
      "attached_span_id": "s022",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4025,
      "end": 4156,
      "text": "¬قول سعيد بن جبير أخرجه ابن أبي حاتم بسند حسن من طريق عطاء بن دينار عنه، وقول السدي أخرجه ابن أبي حاتم بسند جيد من طريق أسباط عنه.¥",
      "attached_span_id": "s023",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4494,
      "end": 4559,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق صالح بن كيسان عن الزهري به.¥",
      "attached_span_id": "s027",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4749,
      "end": 4815,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق سعيد بن أبي عروبة عن قتادة.¥",
      "attached_span_id": "s030",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5448,
      "end": 5502,
      "text": "¬أخرجه الطبري وابن أبي حاتم بسند ثابت من طريق علي به.¥",
      "attached_span_id": "s036",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5743,
      "end": 5809,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق سعيد بن أبي عروبة عن قتادة.¥",
      "attached_span_id": "s037",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6150,
      "end": 6326,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 25/ 485 ح 16078)، وقال محققوه: حسن بشواهده، وأخرجه الحاكم وصححه ووافقه الذهبي (المستدرك 2/ 103)، وحسنه الألباني (السلسلة الصحيحة ح 664).¥",
      "attached_span_id": "s042",
      "grading": [
        "صحيح",
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6379,
      "end": 6541,
      "text": "¬سنن ابن ماجه، الأطعمة، باب الاجتماع على الطعام (ح 3286)، وسنن أبي داود، الأطعمة، باب الاجتماع على الطعام (ح 3764)، وحسنه الألباني في صحيح سنن ابن ماجه (ح 2657).¥",
      "attached_span_id": "s043",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6718,
      "end": 6896,
      "text": "¬أخرجه ابن ماجه، الأطعمة، باب الاجتماع على الطعام (ح 3287)، وضعفه البوصيري (مصباح الزجاجة 3/ 77)، وذكر الألباني أنه ضعيف جدًا ... والجملة الأولى ثابتة، (السلسلة الصحيحة ح 2691).¥",
      "attached_span_id": "s045",
      "grading": [
        "صحيح",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7040,
      "end": 7248,
      "text": "¬قول سعيد بن جبير أخرجه ابن أبي حاتم بسند حسن من طريق عطاء بن دينار عنه، وقول الحسن البصري أخرجه عبد الرزاق بسند صحيح عن معمر عن الحسن، وقول قتادة أخرجه ابن أبي حاتم بسند صحيح من طريق سعيد ابن أبي عروبة عنه.¥",
      "attached_span_id": "s047",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7396,
      "end": 7499,
      "text": "¬أخرجه البخاري من طريق ابن جريج به (الأدب المفرد ح 1095)، وصححه الألباني في صحيح الأدب المفرد (ح 833).¥",
      "attached_span_id": "s049",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7714,
      "end": 7792,
      "text": "¬أخرجه الطبري من طريق ابن جريج به لكن في سنده الحسين، وهو ابن داود، وهو ضعيف.¥",
      "attached_span_id": "s053",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7953,
      "end": 8019,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق عبد الكريم الجزري عن مجاهد.¥",
      "attached_span_id": "s056",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8177,
      "end": 8242,
      "text": "¬أخرجه ابن أبي شيبة بسند صحيح من طريق الثوري به (المصنف 8/ 649).¥",
      "attached_span_id": "s058",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8409,
      "end": 8485,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق سعيد بن أبي عروبة عن قتادة لكنه مرسل.¥",
      "attached_span_id": "s060",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8870,
      "end": 8984,
      "text": "¬سنده ضعيف جدًا؛ لأن عويد بن أبي عمران الجوني: متروك، وروى عن أبيه أحاديث منكرة (ينظر: لسان الميزان 4/ 386، 387).¥",
      "attached_span_id": "s064",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9547,
      "end": 9600,
      "text": "¬أخرجه ابن أبي حاتم من طريق أبي إسحاق به، وسنده حسن.¥",
      "attached_span_id": "s070",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9679,
      "end": 9952,
      "text": "¬أخرجه مسلم من حديث ابن عباس - رضي الله عنهما - بلفظ: \"التحيات المباركات الصلوات الطيبات لله، السلام عليك أيها النبي ورحمة الله وبركاته، السلام علينا وعلى عباد الله الصالحين، أشهد أن لا إله إلا الله وأشهد أن محمدًا رسول الله\" (الصحيح، الصلاة، باب التشهّد في الصلاة ح 403).¥",
      "attached_span_id": "s071",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 352,
      "end": 384,
      "text": "¬ذكرهم ابن أبي حاتم بحذف السند.¥",
      "attached_span_id": "s003",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 893,
      "end": 1088,
      "text": "¬أخرجه أبو داود بسنده ومتنه (السنن، اللباس، باب في قول الله - عز وجل -: {وَقُلْ لِلْمُؤْمِنَاتِ يَغْضُضْنَ مِنْ أَبْصَارِهِنَّ} [النور: 31] ح 4111)، وحسنه الألباني في صحيح سنن أبي داود (ح 3464).¥",
      "attached_span_id": "s009",
      "grading": [
        "صحيح",
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1195,
      "end": 1260,
      "text": "¬أخرجه ابن أبي حاتم بعدة طرق صحاح عن ابن مسعود - رضي الله عنه -.¥",
      "attached_span_id": "s011",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1382,
      "end": 1419,
      "text": "¬ذكرهم كلهم ابن أبي حاتم بحذف السند.¥",
      "attached_span_id": "s012",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1478,
      "end": 1491,
      "text": "¬أي: القميص.¥",
      "attached_span_id": "s013",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1500,
      "end": 1598,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق عمران بن سليمان المرادي عن أبي صالح، وهو باذام مولى أم هانئ.¥",
      "attached_span_id": "s014",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1761,
      "end": 1851,
      "text": "¬أخرجه ابن أبي حاتم من طريق سعيد بن جبير به، وسنده ضعيف، لأن سعيدًا لم يسمع من ابن مسعود.¥",
      "attached_span_id": "s016",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1969,
      "end": 2037,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق عطاء بن دينار عن سعيد بن جبير.¥",
      "attached_span_id": "s018",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2424,
      "end": 2502,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وطلحة بنت عاصم لم أجد لها ترجمة ومعناه صحيح.¥",
      "attached_span_id": "s024",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2897,
      "end": 2999,
      "text": "¬أخرجه ابن أبي حاتم بسنده من طريق أسباط عن السدي، والسدي في هذا المتن يُنبه على تشيعه، فالإسناد ضعيف.¥",
      "attached_span_id": "s030",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

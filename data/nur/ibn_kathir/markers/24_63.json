  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 423,
      "end": 528,
      "text": "¬أخرجه ابن أبي حاتم من طريق الضحاك به، وسنده ضعيف؛ لأن الضحاك لم يلق ابن عباس، ويتقوى بالمراسيل التالية.¥",
      "attached_span_id": "s004",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 560,
      "end": 743,
      "text": "¬قول مجاهد أخرجه آدم بن أبي إياس والطبري بسند صحيح من طريق ابن أبي نجيح عنه، وقول سعيد بن جبير أخرجه ابن أبي حاتم بسند صحيح من طريق سالم الأفطس عنه، وهذان المرسلان يقوي أحدهما الآخر.¥",
      "attached_span_id": "s005",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 838,
      "end": 938,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق سعيد بن أبي عروبة عن قتادة وهو مرسل ويتقوى بالمراسيل السابقة.¥",
      "attached_span_id": "s006",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1147,
      "end": 1235,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق بكير بن معروف عن مقاتل، وسنده معضل ويتقوى بما سبق.¥",
      "attached_span_id": "s011",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1375,
      "end": 1413,
      "text": "¬سنده صحيح وهو مرسل، ويشهد له ما سبق.¥",
      "attached_span_id": "s013",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2363,
      "end": 2517,
      "text": "¬قول ابن عباس وعطية أخرجه ابن أبي حاتم بسند ضعيف من طريق عطية العوفي به عن ابن عباس، وقول الحسن أخرجه ابن أبي حاتم بسند حسن من طريق عاصم عن الحسن البصري.¥",
      "attached_span_id": "s020",
      "grading": [
        "حسن",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3047,
      "end": 3142,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق بكير بن معروف عن مقاتل لكنه معضل لأن مقاتلًا؛ تابع تابعي.¥",
      "attached_span_id": "s024",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3228,
      "end": 3281,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق أسباط عن السدي.¥",
      "attached_span_id": "s025",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3408,
      "end": 3474,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق سعيد بن أبي عروبة عن قتادة.¥",
      "attached_span_id": "s027",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3568,
      "end": 3636,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق مهران، وهو ابن أبي عمر العطار.¥",
      "attached_span_id": "s027",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3671,
      "end": 3693,
      "text": "¬زيادة من (ح) و (حم).¥",
      "attached_span_id": "s028",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3701,
      "end": 3807,
      "text": "¬أخرجه البستي والطبري وابن أبي حاتم كلهم من طريق ابن جريج عن مجاهد، وهو لم يسمع من مجاهد، ويتقوى بما سبق.¥",
      "attached_span_id": "s029",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4174,
      "end": 4218,
      "text": "¬تقدم تخريجه في تفسير سورة آل عمران آية 31.¥",
      "attached_span_id": "s032",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",

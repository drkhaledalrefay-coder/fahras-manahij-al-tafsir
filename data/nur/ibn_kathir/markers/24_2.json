  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1402,
      "end": 1534,
      "text": "¬صحيح البخاري، الصلح، باب إذا اصطلحوا على صلح جور فالصلح مردود (ح 2696)، وصحيح مسلم، الحدود، باب من اعترف على نفسه بالزنا (ح 1698).¥",
      "attached_span_id": "s006",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2295,
      "end": 2401,
      "text": "¬صحيح البخاري، الحدود، باب الاعتراف بالزنا (ح 6829)، وصحيح مسلم، الحدود، باب رجم الثيب في الزنا (ح 1691).¥",
      "attached_span_id": "s013",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2790,
      "end": 2862,
      "text": "¬أخرجه الإمام أحمد بسنده بنحوه (المسند 1/ 327 ح 197)، وصحح سنده محققوه.¥",
      "attached_span_id": "s020",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2916,
      "end": 2940,
      "text": "¬السنن الكبرى (ح 7154).¥",
      "attached_span_id": "s021",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3494,
      "end": 3597,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 1/ 296 ح 156)، وضعف سنده محققوه لضعف علي بن زيد، وهو ابن جدعان.¥",
      "attached_span_id": "s025",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3719,
      "end": 3791,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 1/ 362 ح 249)، وصحح سنده محققوه.¥",
      "attached_span_id": "s027",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3846,
      "end": 3904,
      "text": "¬سنن الترمذي، الحدود، باب ما جاء في تحقيق الرجم (ح 1431).¥",
      "attached_span_id": "s028",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4434,
      "end": 4471,
      "text": "¬سنده ضعيف لإبهام شيخ محمد بن سيرين.¥",
      "attached_span_id": "s041",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4597,
      "end": 4621,
      "text": "¬السنن الكبرى (ح 7145).¥",
      "attached_span_id": "s042",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5466,
      "end": 5728,
      "text": "¬أخرجه البخاري بلفظ: \"حين رجم المرأة يوم الجمعة\"، وقال: رجمتها بسُّنة رسول الله - صلى الله عليه وسلم -. دون ذكر الجلد (الصحيح، الحدود، باب رجم المحصن ح 6812)، وأخرجه البستي من طريق عمرو بن علي، وسنده ضعيف؛ لأن عمرو لم يسمع من على (المراسيل لابن أبي حاتم ص 122).¥",
      "attached_span_id": "s046",
      "grading": [
        "صحيح",
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6011,
      "end": 6260,
      "text": "¬المسند 5/ 317، وصحيح مسلم، الحدود، باب حد الزنا (ح 1690)، وسنن أبي داود، الحدود، باب الرجم (ح 4415)، وسنن الترمذي، الحدود، باب ما جاء في الرجم على الثيب (ح 1434)، والسنن الكبرى للنسائي، الرجم (ح 7142)، وسنن ابن ماجه، الحدود، باب حد الزنا (ح 2550).¥",
      "attached_span_id": "s049",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6381,
      "end": 6436,
      "text": "¬كذا في (ح) و (حم)، وفي الأصل صُحف إلى: \"وترثوا لهما\".¥",
      "attached_span_id": "s052",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6683,
      "end": 6744,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق ابن أبي نجيح عن مجاهد.¥",
      "attached_span_id": "s055",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6864,
      "end": 7041,
      "text": "¬أخرجه أبو داود من حديث عبد الله بن عمرو بن العاص -رضي الله عنهما- (السنن، الحدود، باب العفو عن الحدود ما لم تبلغ السلطان ح 4376)، وصححه الألباني في صحيح سنن أبي داود (ح 3680).¥",
      "attached_span_id": "s057",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7122,
      "end": 7369,
      "text": "¬أخرجه الإمام أحمد من حديث أبي هريرة - رضي الله عنه - (المسند 14/ 351 ح 8738)، وضعف سنده محققوه، وكذا أخرجه ابن ماجه (السنن، الحدود، باب إقامة الحدود ح 2538)، وحسنه الألباني في صحيح سنن ابن ماجه (ح 2057)، وحسنه المنذري في الترغيب والترهيب 3/ 246.¥",
      "attached_span_id": "s058",
      "grading": [
        "صحيح",
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7623,
      "end": 7686,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق عطاء بن السائب عن الشعبي.¥",
      "attached_span_id": "s060",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7716,
      "end": 7788,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق حجاج بن أرطأة عن عطاء بن أبي رباح.¥",
      "attached_span_id": "s061",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8207,
      "end": 8253,
      "text": "¬أخرجه الطبري بسند صحيح من طريق شعبة عن حماد.¥",
      "attached_span_id": "s067",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8465,
      "end": 8554,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وأخرجه عبد الرزاق من طريق ابن أبي مليكة به، وسنده صحيح.¥",
      "attached_span_id": "s070",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8846,
      "end": 9038,
      "text": "¬أخرجه الإمام أحمد من حديث قرَّة المزني - رضي الله عنه - (المسند 33/ 472 ح 20363)، وصحح سنده محققوه، وأخرجه البخاري بنحوه في الأدب المفرد (ح 373)، وصححه الألباني في صحيح الأدب المفرد (ح 287).¥",
      "attached_span_id": "s073",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9357,
      "end": 9413,
      "text": "¬أخرجه ابن أبي شيبة بسند صحيح عن الحسن (المصنف 10/ 60).¥",
      "attached_span_id": "s076",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9535,
      "end": 9602,
      "text": "¬أخرجه عبد الرزاق وابن أبي حاتم بسند صحيح من طريق ابن أبي طلحة به.¥",
      "attached_span_id": "s078",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9637,
      "end": 9711,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق أبي بشر، وهو جعفر بن إياس، عن مجاهد.¥",
      "attached_span_id": "s079",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9728,
      "end": 9795,
      "text": "¬أخرجه ابن أبي حاتم بسند فيه حفص بن عمر، وهو ضعيف، ويتقوى بما سبق.¥",
      "attached_span_id": "s080",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9869,
      "end": 9923,
      "text": "¬أخرجه الطبري بسند صحيح من طريق ابن أبي نجيح عن عطاء.¥",
      "attached_span_id": "s082",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10029,
      "end": 10085,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق عطاء بن دينار عنه.¥",
      "attached_span_id": "s083",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10119,
      "end": 10193,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق يونس بن يزيد وابن أبي ذئب عن الزهري.¥",
      "attached_span_id": "s084",

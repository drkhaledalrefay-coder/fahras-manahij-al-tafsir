  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1284,
      "end": 1354,
      "text": "¬أخرجه الطبري من طريق هشيم به، وسنده ضعيف لإبهام الراوي عن ابن مسعود.¥",
      "attached_span_id": "s011",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1629,
      "end": 1747,
      "text": "¬أخرجه عبد الرزاق والطبري وابن أبي حاتم كلهم من طريق عمرو بن دينار به، وسنده ضعيف لضعف عمرو بن دينار، كما في التقريب.¥",
      "attached_span_id": "s014",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2174,
      "end": 2218,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده جيد.¥",
      "attached_span_id": "s020",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2488,
      "end": 2548,
      "text": "¬أخرجه ابن أبي حاتم وفي سنده أيضًا عمرو بن دينار، وهو ضعيف.¥",
      "attached_span_id": "s022",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2636,
      "end": 2775,
      "text": "¬قول سعيد أخرجه الطبري وابن أبي حاتم بسند صحيح من طريق شعبة وعوف الأعرابي عنه، وقول الضحاك أخرجه ابن أبي حاتم بسند ضعيف من طريق جويبر عنه.¥",
      "attached_span_id": "s024",
      "grading": [
        "صحيح",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2885,
      "end": 2947,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق عبد الله بن شوذب عن مطر.¥",
      "attached_span_id": "s025",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3078,
      "end": 3132,
      "text": "¬أخرجه الطبري وابن أبي حاتم بسند ثابت من طريق علي به.¥",
      "attached_span_id": "s026",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3172,
      "end": 3205,
      "text": "¬ذكرهما ابن أبي حاتم بحذف السند.¥",
      "attached_span_id": "s027",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3239,
      "end": 3292,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق أسباط عن السدي.¥",
      "attached_span_id": "s028",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3419,
      "end": 3480,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق بكير بن معروف عن مقاتل.¥",
      "attached_span_id": "s030",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }

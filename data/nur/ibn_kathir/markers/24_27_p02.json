  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 894,
      "end": 943,
      "text": "¬أي: شغلني عن ذلك الحديث أمر التجارة في الأسواق.¥",
      "attached_span_id": "s010",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 953,
      "end": 1063,
      "text": "¬صحيح البخاري، الاستئذان، باب التسليم والاستئذان ثلاثًا (ح 6245)، وصحيح مسلم، الآداب، باب الاستئذان (ح 2153).¥",
      "attached_span_id": "s011",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1651,
      "end": 1711,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 3/ 138)، وسنده صحيح.¥",
      "attached_span_id": "s017",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2690,
      "end": 2719,
      "text": "¬أي: جعل عليه فراشًا وطيئًا.¥",
      "attached_span_id": "s030",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2935,
      "end": 3037,
      "text": "¬سنن أبي داود، الأدب، باب كم مرة يسلم الرجل في الاستئذان (ح 5185)، وقال عنه الحافظ ابن كثير: جيد قوي.¥",
      "attached_span_id": "s034",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3519,
      "end": 3590,
      "text": "¬المصدر السابق (ح 5186)، وصححه الألباني في صحيح سنن أبي داود (ح 4318).¥",
      "attached_span_id": "s040",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3955,
      "end": 4050,
      "text": "¬سنن أبي داود، الأدب، باب في الاستئذان (ح 5174)، وصححه الألباني في صحيح سنن أبي داود (ح 4310).¥",
      "attached_span_id": "s046",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4196,
      "end": 4221,
      "text": "¬المصدر السابق (ح 5175).¥",
      "attached_span_id": "s048",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4320,
      "end": 4333,
      "text": "¬أي: فرميته.¥",
      "attached_span_id": "s050",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4372,
      "end": 4498,
      "text": "¬صحيح البخاري، الديات، باب من اطلع في بيت قوم ففقئوا عينه (ح 6902)، وصحيح مسلم، الآداب، باب تحريم النظر في بيت غيره (ح 2158).¥",
      "attached_span_id": "s051",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4680,
      "end": 4798,
      "text": "¬صحيح البخاري، الاستئذان، باب إذا قال: أنا ... (ح 6250)، وصحيح مسلم، الأدب، باب كراهة قول المستأذن: أنا ... (ح 2155).¥",
      "attached_span_id": "s054",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5059,
      "end": 5110,
      "text": "¬أخرجه الطبري بسند ضعيف عن العوفي به، ومعناه صحيح.¥",
      "attached_span_id": "s057",
      "grading": [
        "صحيح",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5359,
      "end": 5493,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده صحيح، ولعل قول ابن عباس هذا مستند على قراءة منسوخة قرأ بها أُبي بن كعب كما سيأتي في الرواية التالية.¥",
      "attached_span_id": "s059",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5707,
      "end": 5785,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق الحسين عن هشيم به، والحسين هو ابن داود: ضعيف.¥",
      "attached_span_id": "s061",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5907,
      "end": 5991,
      "text": "¬أخرجه الطبري من الطريق السابق، وفيه أيضًا إبراهيم وهو النخعي لم يسمع من ابن مسعود.¥",
      "attached_span_id": "s064",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6217,
      "end": 6253,
      "text": "¬اللبا: هو أول ما يحلب عند الولادة.¥",
      "attached_span_id": "s066",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6263,
      "end": 6314,
      "text": "¬الجَداية من أولاد الظباء ما بلغ ستة أشهر أو سبعة.¥",
      "attached_span_id": "s067",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6323,
      "end": 6362,
      "text": "¬الضغابيس: جمع ضغبوس، وهي صغار القثاء.¥",
      "attached_span_id": "s068",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6557,
      "end": 6632,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 24/ 152 ح 15425)، وصحح سنده محققوه.¥",
      "attached_span_id": "s072",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6734,
      "end": 6901,
      "text": "¬سنن أبي داود، الأدب، باب كيف الاستئذان (ح 5176)، وسنن الترمذي، الاستئذان؟ باب ما جاء في التسليم قبل الاستئذان (ح 2710)، وصححه الألباني في صحيح سنن أبي داود (ح 4311).¥",
      "attached_span_id": "s074",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7265,
      "end": 7336,
      "text": "¬المصدر السابق (ح 5177)، وصححه الألباني في صحيح سنن أبي داود (ح 4312).¥",
      "attached_span_id": "s080",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7664,
      "end": 7708,
      "text": "¬أخرجه الطبري بسنده ومتنه، ويشهد له ما سبق.¥",
      "attached_span_id": "s085",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7983,
      "end": 8072,
      "text": "¬أخرجه الترمذي بسنده ومتنه ونقده (السنن، أبواب الاستئذان، باب السلام قبل الكلام ح 2699).¥",
      "attached_span_id": "s089",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8283,
      "end": 8351,
      "text": "¬أخرجه الطبري من طريق الحسين عن هشيم به، والحسين هو ابن داود: ضعيف.¥",
      "attached_span_id": "s093",
      "grading": [

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 626,
      "end": 766,
      "text": "¬صحيح البخاري، النكاح، باب من لم يستطع الباءة فليصم (ح 5066)، وصحيح مسلم، النكاح، باب استحباب النكاح لمن تاقت نفسه إليه ووجد مؤنه (ح 1400).¥",
      "attached_span_id": "s007",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 894,
      "end": 1341,
      "text": "¬أخرجه أبو داود (السنن، النكاح، باب النهي عن تزويج من لم يلد من النساء ح 2050)، والنسائي (السنن، النكاح، باب كراهية تزوج العقيم 6/ 65)، وأحمد (المسند 3/ 158)، وحسنه الهيثمي (مجمع الزوائد 4/ 258)، وابن حبان (الإحسان 9/ 338 ح 4028)، وصححه محققه والضياء المقدسي (المختارة 5/ 260 ح 1888)، وحسنه محققه، وأخرجه الحاكم وصححه و وافقه الذهبي (المستدرك 2/ 162)، وصححه العراقي (تخريج إحياء علوم الدين 2/ 970)، وصححه الألباني بشواهده (الإرواء 6/ 195 ح 1784).¥",
      "attached_span_id": "s009",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1518,
      "end": 1535,
      "text": "¬الصحاح 5/ 1868.¥",
      "attached_span_id": "s010",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1816,
      "end": 1856,
      "text": "¬أخرجه الطبري بسند ثابت من طريق علي به.¥",
      "attached_span_id": "s015",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2160,
      "end": 2285,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، ورجاله ثقات لكن سنده منقطع؛ لأن سعيد بن عبد العزيز رواه بلاغًا عن أبي بكر - رضي الله عنه -.¥",
      "attached_span_id": "s021",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2419,
      "end": 2499,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق القاسم بن الوليد عن ابن مسعود، وهو لم يسمع منه.¥",
      "attached_span_id": "s023",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2526,
      "end": 3041,
      "text": "¬أخرجه البغوي معلقًا بغير سند (التفسير 3/ 342)، وأخرجه عبد الرزاق عن معمر عن قتادة أن عمر قال:\r\nعجبت لرجل لا يطلب الغنى بالباءة (ينظر: المقاصد الحسنة ص 83)، وسنده منقطع لأن قتادة لم يسمع من عمر - رضي الله عنه -، وأخرجه عبد الرزاق بهذا السند والمتن، وكذلك أخرجه من طريق هشام بن حسان عن الحسن عن عمر، ومن طريق هشام بن عروة عن عمر (المصنف 6/ 170 - 173)، وهذه الطرق يقوي بعضها بعضًا، وأخرجه البستي من طريق محمد بن عجلان عن عمر بلفظ: \"ابتغوا الغنى في النكاح\"، ومحمد بن عجلان لم يسمع من عمر، ولكن يتقوى بما سبق من الطرق.¥",
      "attached_span_id": "s024",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3298,
      "end": 3751,
      "text": "¬المسند 13/ 49، وصحح سنده أحمد شاكر، وسنن الترمذي، وحسنه، كتاب، فضائل الجهاد، باب ما جاء في المجاهد والناكح والمكاتب ... (ح 1655)، وسنن النسائي، الجهاد، باب فضل الروحة في سبيل الله 6/ 15، وسنن ابن ماجه، العتق، باب المكاتب (ح 2518)، وأخرجه ابن حبان (الإحسان 9/ 339 ح 4030)، والحاكم وصححه و وافقه الذهبي (المستدرك 2/ 160)، وحسنه البغوي (شرح السنة 9/ 7)، وصححه السيوطي (الجامع الصغير مع شرح فيض القدير 3/ 317)، وحسنه الألباني في صحيح سنن الترمذي (ح 1352).¥",
      "attached_span_id": "s028",
      "grading": [
        "صحيح",
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3928,
      "end": 3992,
      "text": "¬صحيح البخاري، فضائل القرآن، باب القراءة عن ظهر القلب (ح 5030).¥",
      "attached_span_id": "s029",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4126,
      "end": 4415,
      "text": "¬أخرجه البزار والدار قطني في العلل، والحاكم وابن مردويه والديلمي كلهم من رواية سلم بن جنادة عن أبي أسامة عن هشام عن أبيه عن عائشة مرفوعًا: \"تزوجوا النساء، فإنهن يأتين بالمال\"، قال الحاكم: تفرد به سُلم وهو ثقة، وقال البزار والدار قطني: سلم يرويه مرسلًا (ينظر: المقاصد الحسنة للسخاوي ص 82).¥",
      "attached_span_id": "s030",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5955,
      "end": 6002,
      "text": "¬كذا في (ح) و (حم)، وفي الأصل صُحف إلى: ههيان.¥",
      "attached_span_id": "s061",

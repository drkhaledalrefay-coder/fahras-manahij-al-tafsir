  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 621,
      "end": 705,
      "text": "¬أخرجه الطبري وابن أبي حاتم بسند ثابت من طريق علي وزيادة: و\"هي المساجد تُكرم. . .\".¥",
      "attached_span_id": "s005",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 828,
      "end": 865,
      "text": "¬ذكرهم كلهم ابن أبي حاتم بحذف السند.¥",
      "attached_span_id": "s006",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1155,
      "end": 1291,
      "text": "¬أخرجه ابن أبي حاتم بسند صحيح من طريق سعيد بن أبي عروبة عن قتادة، وأما الشطر الآخر عن كعب الأحبار ففيه انقطاع لأن قتادة لم يسمع من كعب.¥",
      "attached_span_id": "s010",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1715,
      "end": 1828,
      "text": "¬صحيح البخاري، الصلاة، باب من بنى مسجدًا (ح 450)، وصحيح مسلم، المساجد، باب فضل بناء المساجد والحث عليها (ح 533).¥",
      "attached_span_id": "s014",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1983,
      "end": 2251,
      "text": "¬سنن ابن ماجه، المساجد، باب من بنى مسجدًا (ح 735)، وسنن النسائي، المساجد، باب الفضل في بناء المساجد 2/ 31، وسند ابن ماجه منقطع؛ لأنه رواه من طريق عثمان بن عبد الله عن عمر، وعثمان لم يسمع من عمر (ينظر: مصباح الزجاجة 1/ 260)، ويشهد له حديث عمرو بن عنبسة والحديث السابق.¥",
      "attached_span_id": "s017",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2284,
      "end": 2340,
      "text": "¬سنن النسائي، المساجد، باب الفضل في بناء المساجد 2/ 31.¥",
      "attached_span_id": "s018",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2515,
      "end": 2791,
      "text": "¬(المسند 43/ 397 ح 26386)، وصححه محققوه بشواهده، وسنن أبي داود، الصلاة، باب اتخاذ المساجد في الدور (ح 455)، وسنن الترمذي، أبواب السفر، باب ما ذكر في تطييب المساجد (ح 594) وسنن ابن ماجه، المساجد، باب تطهير المساجد وتطييبها (ح 758)، وصححه الألباني في صحيح سنن أبي داود (ح 436).¥",
      "attached_span_id": "s022",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2833,
      "end": 2932,
      "text": "¬(المسند 5/ 17)، وسنن أبي داود، الباب السابق (ح 456)، وصححه الألباني في صحيح سنن أبي داود (ح 437).¥",
      "attached_span_id": "s023",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3020,
      "end": 3074,
      "text": "¬صحيح البخاري، الصلاة، باب بنيان المسجد بعد حديث 445.¥",
      "attached_span_id": "s025",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3188,
      "end": 3286,
      "text": "¬سنن ابن ماجه، المساجد، باب تشييد المساجد (ح 741)، وسنده موضوع؛ لأن فيه جبارة بن المغلس وهو كذاب.¥",
      "attached_span_id": "s028",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3434,
      "end": 3531,
      "text": "¬سنن أبي داود، الصلاة، باب في بناء المساجد (ح 448)، وصححه الألباني في صحيح سنن أبي داود (ح 431).¥",
      "attached_span_id": "s032",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3681,
      "end": 3903,
      "text": "¬(المسند 3/ 134)، وسنن أبي داود، الصلاة، باب ما جاء في المساجد (ح 449)، وسنن النسائي، المساجد، باب المباهاة في المساجد 2/ 32، وسنن ابن ماجه، المساجد، باب تشييد المساجد (ح 739)، وصححه الألباني في صحيح سنن أبي داود (ح 432).¥",
      "attached_span_id": "s036",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4058,
      "end": 4122,
      "text": "¬صحيح مسلم، المساجد، باب النهي عن نشد الضالة في المسجد (ح 569).¥",
      "attached_span_id": "s039",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4289,
      "end": 4595,
      "text": "¬المسند 2/ 179، وسنن أبي داود، الصلاة، باب التحلق يوم الجمعة قبل الصلاة (ح 1079)، وسنن الترمذي، الصلاة، باب ما جاء في كراهية البيع والشراء ... (ح 322)، وسنن النسائي، المساجد، باب النهي عن البيع والشراء في المسجد 2/ 47، وسنن ابن ماجه، المساجد والجماعات (ح 749)، وحسنه الألباني في صحيح سنن أبي داود (ح 956).¥",
      "attached_span_id": "s042",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4830,
      "end": 4956,
      "text": "¬سنن الترمذي، أبواب البيوع، باب النهي عن البيع في المسجد (ح 1321)، ويشهد له حديث بريدة - رضي الله عنه - المتقدم في صحيح مسلم.¥",
      "attached_span_id": "s046",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5080,
      "end": 5097,
      "text": "¬أي: لا يشد فيه.¥",
      "attached_span_id": "s049",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5199,
      "end": 5318,
      "text": "¬سنن ابن ماجه، المساجد والجماعات، باب ما يكره في المساجد (ح 748)، وسنده ضعيف فيه زيد بن جبيرة وهو ضعيف كما في التقريب.¥",
      "attached_span_id": "s050",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5532,
      "end": 5682,
      "text": "¬سنن ابن ماجه، المساجد، باب ما يكره في المساجد (ح 748)، قال البوصيري: فيه زيد بن جبيرة، قال ابن عبد البر: أجمعوا على أنه ضعيف (مصباح الزجاجة 1/ 264).¥",
      "attached_span_id": "s052",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6105,
      "end": 6139,
      "text": "¬صحيح مسلم، البر والصلة (ح 2615).¥",
      "attached_span_id": "s056",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6617,
      "end": 6689,
      "text": "¬ينظر: صحيح البخاري، الوضوء، باب صبّ الماء على البول في المسجد (ح 220).¥",
      "attached_span_id": "s058",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6883,
      "end": 6908,
      "text": "¬أي: يطوف بالليل ساهرًا.¥",
      "attached_span_id": "s059",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7258,
      "end": 7279,
      "text": "¬أي: الصراخ والصياح.¥",
      "attached_span_id": "s064",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7441,
      "end": 7526,
      "text": "¬كذا في (ح) و (حم) وصحيح البخاري، وفي الأصل صُحفت إلى: \"عبد الرحمن بن يزيد بن خصيف\".¥",
      "attached_span_id": "s067",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7800,
      "end": 7856,
      "text": "¬صحيح البخاري، الصلاة، باب رفع الصوت في المسجد (ح 470).¥",
      "attached_span_id": "s073",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8033,
      "end": 8082,
      "text": "¬ينظر: تحفة الأشراف 8/ 4، وصححه الحافظ ابن كثير.¥",
      "attached_span_id": "s075",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8608,
      "end": 8776,
      "text": "¬أخرجه أبو يعلى بسنده ومتنه (المسند 1/ 170 ح 1190)، وضعفه محققه لضعف عبد الله بن عمر العمري، ونقل عن الهيثمي أنه مختلف فيه (مجمع الزوائد 2/ 11)، وحسنه الحافظ ابن كثير.¥",
      "attached_span_id": "s085",
      "grading": [
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9192,
      "end": 9296,
      "text": "¬صحيح البخاري، الأذان، باب فضل صلاة الجماعة (ح 647)، وصحيح مسلم، المساجد، باب فضل صلاة الجماعة (ح 649).¥",
      "attached_span_id": "s089",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9360,
      "end": 9766,
      "text": "¬أخرجه الدار قطني بسند فيه سليمان بن داود اليمامي (السنن، الصلاة، باب الحث لجار المسجد على الصلاة فيه إلا من عذر 1/ 420)، وسنده ضعيف لضعف سليمان (ينظر: العلل المتناهية لابن الجوزي ح 693)، وأخرجه الحاكم من طريق سليمان بن داود به (المستدرك 1/ 246)، وأخرجه الدار قطني من حديث جابر - رضي الله عنه - وفي سنده محمد بن مسكين (المصدر السابق)، وقال الذهبي: محمد بن مسكين لا يعرف وخبره منكر (ميزان الاعتدال 3/ 567).¥",
      "attached_span_id": "s091",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9842,
      "end": 10087,
      "text": "¬سنن أبي داود، الصلاة، باب ما جاء في المشي إلى الصلاة في الظلم (ح 561)، وسنن الترمذي، الصلاة، باب ما جاء في فضل العشاء والفجر في الجماعة (ح 223)، وسنن ابن ماجه، المساجد، باب المشي إلى الصلاة (ح 779)، وصححه الألباني في صحيح سنن ابن ماجه (ح 632).¥",
      "attached_span_id": "s092",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }

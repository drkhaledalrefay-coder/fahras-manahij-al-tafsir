  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1027,
      "end": 1208,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وفي سنده عبد الله بن خراش وهو ضعيف كما في التقريب، وقد توبع فأخرجه الحاكم من طريق يزيد بن هارون عن العوام به، وصححه ووافقه الذهبي (المستدرك 4/ 10).¥",
      "attached_span_id": "s008",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1814,
      "end": 1925,
      "text": "¬أخرجه الطبري بسنده ومتنه، ويشهد له حديث قصة الإفك المتفق عليه، وقد مضى في تفسير آية 11 من هذه السورة الكريمة.¥",
      "attached_span_id": "s017",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2165,
      "end": 2465,
      "text": "¬قول الضحاك أخرجه الطبراني من طريق محمد بن يوسف الفريابي عن سفيان عن سلمة بن نبيط عنه (المعجم الكبير 23/ 152 رقم 229) وسنده صحيح، وقول أبي الجوزاء أخرجه ابن أبي حاتم بسند حسن من طريق عمرو بن مالك النكري عنه، وقول سلمة بن نبيط أخرجه ابن أبي حاتم بسند صحيح من طريق أبي أسامة - وهو حماد بن أسامة - عنه.¥",
      "attached_span_id": "s020",
      "grading": [
        "صحيح",
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2952,
      "end": 3013,
      "text": "¬أخرجه الطبري بسند ضعيف من طريق العوفي به، ويشهد له ما تقدم.¥",
      "attached_span_id": "s023",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3639,
      "end": 3768,
      "text": "¬أخرجه الطبري بسنده ومتنه، وسنده ضعيف، وأخرجه الطبراني من طريق هشيم به (المعجم الكبير 23/ 154 رقم 234)، ويشهد له الآثار السابقة.¥",
      "attached_span_id": "s029",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3983,
      "end": 4096,
      "text": "¬أخرجه الطبري بسند صحيح من طريق ابن وهب عن عبد الرحمن، وأخرجه ابن أبي حاتم بسند صحيح من طريق أصبغ عن عبد الرحمن.¥",
      "attached_span_id": "s031",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4571,
      "end": 4795,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وهو صحيح متفق عليه (صحيح البخاري، الوصايا، باب قول الله تعالى: {إِنَّ الَّذِينَ يَأْكُلُونَ أَمْوَالَ الْيَتَامَى ظُلْمًا} [النساء: 10] ح 2766)، وصحيح مسلم، الإيمان، باب أكبر الكبائر (ح 89).¥",
      "attached_span_id": "s035",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5077,
      "end": 5181,
      "text": "¬أخرجه الطبراني بسنده ومتنه (المعجم الكبير 3/ 187 رقم 3023)، وفي سنده ليث، وهو ابن أبي سُليم، فيه مقال.¥",
      "attached_span_id": "s038",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

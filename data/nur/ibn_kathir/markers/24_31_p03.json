  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 13684,
      "end": 13884,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 44/ 73 ح 26473) وضعّف سنده محققوه، وأخرجه الترمذي من طريق سفيان بن عيينة به، وقال: حسن صحيح، (السنن، البيوع، باب ما جاء في المكاتب إذا كان عنده ما يؤدي ح 1261).¥",
      "attached_span_id": "s113",
      "grading": [
        "صحيح",
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 13922,
      "end": 13992,
      "text": "¬السنن، العتق، باب في المكاتب يؤدي بعض كتابته فيعجر أو يموت (ح 3928).¥",
      "attached_span_id": "s114",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 14224,
      "end": 14299,
      "text": "¬أخرجه الطبري وابن أبي حاتم بسند ثابت من طريق علي بن أبي طلحة عن ابن عباس.¥",
      "attached_span_id": "s117",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 14323,
      "end": 14385,
      "text": "¬أخرجه البستي والطبري وابن أبي حاتم بأسانيد يقوي بعضها بعضًا.¥",
      "attached_span_id": "s118",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 14427,
      "end": 14490,
      "text": "¬أخرجه ابن أبي حاتم بسند ضعيف فيه حفص بن عمر العدني، وهو ضعيف.¥",
      "attached_span_id": "s119",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 14871,
      "end": 14933,
      "text": "¬تعرف الآن بالعزيزية تقع في الشمال الغربي من المدينة المنورة.¥",
      "attached_span_id": "s123",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 14959,
      "end": 15079,
      "text": "¬أخرجه مسلم من طريق معمر عن الزهري به مختصرًا (صحيح مسلم، السلام، باب منع المخنث من الدخول على النساء الأجانب، ح 2181).¥",
      "attached_span_id": "s124",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 15474,
      "end": 15534,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 6/ 290)، وسنده صحيح.¥",
      "attached_span_id": "s128",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 15576,
      "end": 15721,
      "text": "¬صحيح البخاري، اللباس، باب إخراج المتشبهين بالنساء من البيوت (ح 5887)، وصحيح مسلم، السلام، باب منع المخنث من الدخول على النساء الأجانب (ح 2180).¥",
      "attached_span_id": "s129",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 16140,
      "end": 16200,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 6/ 152)، وسنده صحيح.¥",
      "attached_span_id": "s134",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 16254,
      "end": 16413,
      "text": "¬وصحيح مسلم، الحديث السابق، وسنن أبي داود، اللباس، باب في قوله: {غَيْرِ أُولِي الْإِرْبَةِ} [النور: 31] (ح 4108)، والسنن الكبرى للنسائي، عشرة النساء (ح 9246).¥",
      "attached_span_id": "s135",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 16911,
      "end": 16929,
      "text": "¬أي: أقارب الزوج.¥",
      "attached_span_id": "s139",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 16937,
      "end": 17076,
      "text": "¬صحيح البخاري، النكاح، باب لا يخلون رجل بمرأة إلا ذو محرم (ح 5232)، وصحيح مسلم، السلام، باب تحريم الخلوة بالأجنبية والدخول عليها (ح 2172).¥",
      "attached_span_id": "s140",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 17816,
      "end": 17897,
      "text": "¬سنن الترمذي، أبواب الاستئذان، باب ما جاء في كراهية خروج المرأة متعطرة (ح 2786).¥",
      "attached_span_id": "s147",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 17947,
      "end": 18118,
      "text": "¬سنن أبي داود، الترجل، باب ما جاء في المرأة تتطيب للخروج (ح 4173)، وسنن النسائي، الزينة، باب ما يكره للنساء من الطيب 8/ 153، وحسنه الألباني في صحيح سنن أبي داود (ح 3516).¥",
      "attached_span_id": "s148",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 18508,
      "end": 18579,
      "text": "¬المصدر السابق (ح 4174)، وصححه الألباني في صحيح سنن أبي داود (ح 3517).¥",
      "attached_span_id": "s154",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 18650,
      "end": 18691,
      "text": "¬السنن، الفتن، باب فتنة النساء (ح 4002).¥",
      "attached_span_id": "s155",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 18878,
      "end": 18994,
      "text": "¬السنن، الرضاع، باب ما جاء في كراهية خروج النساء في الزينة (ح 1167)، وسنده ضعيف لضعف موسى بن عبيدة، ويشهد له سابقه.¥",
      "attached_span_id": "s158",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 19497,
      "end": 19633,
      "text": "¬أخرجه أبو داود بسنده ومتنه (السنن، الأدب، باب في مشي النساء مع الرجال في الطريق ح 5272)، وحسنه الألباني في صحيح سنن أبي داود (ح 4392).¥",
      "attached_span_id": "s162",
      "grading": [
        "صحيح",
        "حسن",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1107,
      "end": 1120,
      "text": "¬أي: شعورهن.¥",
      "attached_span_id": "s003",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1232,
      "end": 1302,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده ضعيف لإبهام شيخ مقاتل بن حيان.¥",
      "attached_span_id": "s005",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 1985,
      "end": 2266,
      "text": "¬سنن أبي داود، اللباس، باب قول الله - عز وجل -: {وَقُلْ لِلْمُؤْمِنَاتِ يَغْضُضْنَ} [النور: 31] (ح 113)، وسنن الترمذي، الأدب، باب ما جاء في احتجاب النساء من الرجال (ح 778) وقال: هذا حديث حسن صحيح، وأخرجه ابن حبان (الإحسان 12/ 387 ح 5575)، وقواه الحافظ ابن حجر (فتح الباري 9/ 337).¥",
      "attached_span_id": "s014",
      "grading": [
        "صحيح",
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2514,
      "end": 2573,
      "text": "¬صحيح البخاري، الصلاة، باب أصحاب الحراب في المسجد (ح 454).¥",
      "attached_span_id": "s015",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2639,
      "end": 2707,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق عطاء بن دينار عن سعيد بن جبير.¥",
      "attached_span_id": "s016",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2743,
      "end": 2815,
      "text": "¬قول سفيان أخرجه ابن أبي حاتم بسند حسن من طريق عبد الله بن المبارك عنه.¥",
      "attached_span_id": "s017",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2838,
      "end": 2899,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق بكير بن معروف عن مقاتل.¥",
      "attached_span_id": "s018",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 2990,
      "end": 3051,
      "text": "¬أخرجه الطبري بسند جيد من طريق الربيع بن أنس عن أبي العالية.¥",
      "attached_span_id": "s019",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3097,
      "end": 3164,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق الربيع بن أنس عن أبي العالية.¥",
      "attached_span_id": "s020",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3327,
      "end": 3515,
      "text": "¬أخرجه البُستي والطبري وابن أبي حاتم والحاكم من طرق عن ابن مسعود، وصححه الحاكم ووافقه الذهبي (المستدرك 2/ 397)، وأخرجه الطبراني وقال الهيثمي: ورجال أحدها رجال الصحيح (مجمع الزوائد 7/ 82).¥",
      "attached_span_id": "s023",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3776,
      "end": 3826,
      "text": "¬أخرجه الطبري بسند صحيح من طريق علقمة عن إبراهيم.¥",
      "attached_span_id": "s026",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 3961,
      "end": 4319,
      "text": "¬هذا الطريق لم أجدهُ ولم يسم الحافظ ابن كثير الراوي عن الأعمش، وفرضًا لو صح فإنه مقيد في هذا التفسير في بيتها، فقد أخرج الطبري بسنده الثابت من طريق علي بن أبي طلحة عن ابن عباس: فهذه تظهر في بيتها لمن دخل من الناس عليها، وقد وضحه الزهري كما سيأتي بعد روايتين، علمًا أن الطبري أخرجه بلفظ: \"الكحل والخاتم\" وفيه مسلم بن كيسان الملائي، وهو ضعيف: (التقريب ص 530).¥",
      "attached_span_id": "s028",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4416,
      "end": 4782,
      "text": "¬قول ابن عمر لم أجده مسندًا، وقول عطاء أخرجه الطبري بسند صحيح من طريق الأوزاعي عنه، وقول سعيد بن جبير أخرجه البستي والطبري بسند ضعيف من طريق عبد الله بن مسلم بن هرمز عن سعيد، وعبد الله بن مسلم بن هرمز ضعيف، وقول الضحاك أخرجه الطبري بسند ضعيف من طريق جويبر عنه، وقول إبراهيم غير هذا فهو بلفظ \"الثياب\" كقول ابن مسعود، وأخرجه الطبري بسند صحيح من طريق علقمة عن إبراهيم.¥",
      "attached_span_id": "s029",
      "grading": [
        "صحيح",
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 4978,
      "end": 5043,
      "text": "¬أخرجه ابن أبي حاتم بسند فيه حجاج بن أرطأة، وهو صدوق كثير الخطأ.¥",
      "attached_span_id": "s031",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5175,
      "end": 5274,
      "text": "¬أخرجه ابن أبي حاتم بسند فيه حجاج بن أرطأة، وهو صدوق كثير الخطأ، ويشهد لأخره ما تقدم عن ابن مسعود.¥",
      "attached_span_id": "s034",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5418,
      "end": 5483,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق يزيد بن أبي حبيب عن الزهري.¥",
      "attached_span_id": "s035",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 5551,
      "end": 5590,
      "text": "¬سنده صحيح وتقدم نحوه وزيادة في سابقه.¥",
      "attached_span_id": "s037",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 6059,
      "end": 6390,
      "text": "¬أخرجه أبو داود بسنده ومتنه (السنن، اللباس، باب فيما تبدي المرأة من زينتها ح 4104)، وصححه الألباني في صحيح سنن أبي داود (ح 3458)، والحق أنه ضعيف لثلاث علل: أولًا: ضعف سعيد بن بشير، ثانيًا: تدليس قتادة. ثالثًا: خالد بن دريك لم يسمع من عائشة، كما نقل الحافظ ابن كثير، من أجل ذلك قول الحافظ ابن كثير أن هذا الحديث يستأنس به، فيه نظر.¥",
      "attached_span_id": "s042",
      "grading": [
        "صحيح",
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7564,
      "end": 7688,
      "text": "¬صحيح البخاري، التفسير، سورة النور، باب قوله تعالى: {وَلْيَضْرِبْنَ بِخُمُرِهِنَّ عَلَى جُيُوبِهِنَّ} [النور: 31] (ح 4758).¥",
      "attached_span_id": "s056",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 7931,
      "end": 7956,
      "text": "¬المصدر السابق (ح 4759).¥",
      "attached_span_id": "s059",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8639,
      "end": 8713,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وأخرجه البخاري كما في الحديثين السابقين.¥",
      "attached_span_id": "s065",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8761,
      "end": 8908,
      "text": "¬السنن، اللباس، باب قوله تعالى: {يُدْنِينَ عَلَيْهِنَّ مِنْ جَلَابِيبِهِنَّ} [الأحزاب: 59] (ح 4101)، وصححه الألباني في صحيح سنن أبي داود (ح 3456).¥",
      "attached_span_id": "s066",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 8962,
      "end": 9011,
      "text": "¬كذا في (ح) و (حم)، وفي الأصل صُحف إلى: \"قرقرة\".¥",
      "attached_span_id": "s068",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 9231,
      "end": 9326,
      "text": "¬أخرجه الطبري وأبو داود، المصدر السابق (ح 4102)، وصححه الألباني في صحيح سنن أبي داود (ح 3457).¥",
      "attached_span_id": "s071",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10088,
      "end": 10100,
      "text": "¬سنده صحيح.¥",
      "attached_span_id": "s077",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10482,
      "end": 10566,
      "text": "¬صحيح البخاري، النكاح، باب لا تباشر المرأة، المرأة المرأة، فتنعتها لزوجها (ح 5241).¥",
      "attached_span_id": "s081",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10895,
      "end": 11042,
      "text": "¬أخرجه البيهقي من طريق سعيد بن منصور به (السنن الكبرى 7/ 95)، وسنده ضعيف؛ لأن نسي والد عبادة: مجهول، وأخرجه الطبري من طريق عبادة بدون ذكر عن أبيه.¥",
      "attached_span_id": "s085",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11172,
      "end": 11237,
      "text": "¬أخرجه ابن أبي حاتم بسنده فيه ليث، وهو ابن أبي سُليم، وفيه مقال.¥",
      "attached_span_id": "s087",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11249,
      "end": 11295,
      "text": "¬أي: عبد بن حميد الكشي، صاحب التفسير المشهور.¥",
      "attached_span_id": "s088",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11463,
      "end": 11600,
      "text": "¬سنده ضعيف جدًا لضعف الكلبي، وتصريحه بأن كل ما روى عن أبي صالح عن ابن عباس فهو كذب، كما في تهذيب التهذيب في ترجمة محمد بن السائب الكلبي.¥",
      "attached_span_id": "s091",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11736,
      "end": 11786,
      "text": "¬في سنده أيضًا ليث، وهو ابن أبي سُليم، وفيه مقال.¥",
      "attached_span_id": "s094",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11831,
      "end": 11857,
      "text": "¬أي: تولد، بدليل ما يليه.¥",
      "attached_span_id": "s095",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11896,
      "end": 11970,
      "text": "¬أخرجه الطبري بسند ضعيف عن عبادة بن نسيّ، وذلك لضعف الحسين، وهو ابن داود.¥",
      "attached_span_id": "s096",
      "grading": [
        "ضعيف"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 12176,
      "end": 12269,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده ضعيف لضعف ابن عطاء؛ وهو عثمان وأبوه: صدوق يهم كثيرًا.¥",
      "attached_span_id": "s100",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 12492,
      "end": 12512,
      "text": "¬ذكره الطبري بنحوه.¥",
      "attached_span_id": "s103",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 12566,
      "end": 12671,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق طارق بن عبد الرحمن عن سعيد بن المسيب بلفظ: \"إنما يعني ذلك: الإماء\".¥",
      "attached_span_id": "s104",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 13077,
      "end": 13209,
      "text": "¬أخرجه أبو داود بسنده ومتنه (السنن، اللباس، باب في العبد ينظر إلى شعر مولاته ح 4106)، وصححه الألباني في صحيح سنن أبي داود (ح 3460).¥",
      "attached_span_id": "s109",
      "grading": [
        "صحيح",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10018,
      "end": 10185,
      "text": "¬أخرجه بطوله وطرقه الطبري بسنده ومتنه، وسنده ضعيف؛ لأنه مروي من طريق الحسين، وهو ابن داود ويُلقب بسُنيد وهو ضعيف، وأخرجه سنيد به كما في التمهيد لابن عبد البر 16/ 232.¥",
      "attached_span_id": "s120",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10592,
      "end": 10646,
      "text": "¬أخرجه الطبري بسنده ومتنه، وصحح سنده الحافظ ابن كثير.¥",
      "attached_span_id": "s124",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10778,
      "end": 10851,
      "text": "¬كذا في (ح) و (حم) وتفسير ابن أبي حاتم، وفي الأصل صُحف إلى: \"أبي هبيرة\".¥",
      "attached_span_id": "s127",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10908,
      "end": 11015,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده منقطع؛ لأن أبا عبيدة لم يسمع من عبد الله بن مسعود - رضي الله عنه -.¥",
      "attached_span_id": "s128",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11076,
      "end": 11125,
      "text": "¬أخرجه الطبري بسندين يقوي أحدهما الآخر عن مجاهد.¥",
      "attached_span_id": "s129",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11319,
      "end": 11379,
      "text": "¬صحيح البخاري، النكاح، باب لا يطرق أهله ليلًا ... (ح 5243).¥",
      "attached_span_id": "s132",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11406,
      "end": 11463,
      "text": "¬صحيح مسلم، الإمارة، باب كراهية الطروق ... (ح 715/ 184).¥",
      "attached_span_id": "s133",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11638,
      "end": 11703,
      "text": "¬صحيح البخاري، النكاح، باب تستحد المغيبة وتمتشط الشعثة (ح 5247).¥",
      "attached_span_id": "s136",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11975,
      "end": 12101,
      "text": "¬أخرجه ابن أبي حاتم بسنده ومتنه، وسنده ضعيف لضعف واصل وأبي سورة، كما في التقريب. وضعف سنده الحافظ ابن حجر (فتح الباري 11/ 8).¥",
      "attached_span_id": "s140",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 12392,
      "end": 12452,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق محمد بن يسار عن قتادة.¥",
      "attached_span_id": "s142",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 13062,
      "end": 13171,
      "text": "¬أخرجه ابن أبي حاتم بسند حسن من طريق بكير بن معروف عن مقاتل بن حيان لكنه معضل؛ لأن مقاتل بن حيان تابع تابعي.¥",
      "attached_span_id": "s147",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

  "editor_footnote_evidence": [
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10586,
      "end": 10644,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق أبي العالية عن أُبي.¥",
      "attached_span_id": "s114",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 10880,
      "end": 10931,
      "text": "¬أخرجه ابن أبي حاتم مقطعًا بسند حسن من طريق شمر به¥",
      "attached_span_id": "s119",
      "grading": [
        "حسن"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11120,
      "end": 11173,
      "text": "¬أخرجه ابن أبي حاتم بسند جيد من طريق أسباط عن السدي.¥",
      "attached_span_id": "s121",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11418,
      "end": 11484,
      "text": "¬كذا في (ح) و (حم) والمسند وترجمته، وفي الأصل صُحف إلى: \"الديلي\".¥",
      "attached_span_id": "s125",
      "grading": [],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 11707,
      "end": 11782,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه، (المسند 11/ 219 ح 6644)، وصحح سنده محققوه.¥",
      "attached_span_id": "s129",
      "grading": [
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 12093,
      "end": 12254,
      "text": "¬أخرجه البزار كما في كشف الأستار (ح 2145)، وأخرجه الإمام أحمد من طريق عبد الله الديلمي عن عبد الله بن عمرو - رضي الله عنه -، كما في الحديث السابق، الصحيح السند.¥",
      "attached_span_id": "s132",
      "grading": [
        "صحيح"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    },
    {
      "family": "EDITOR",
      "marker": "editor_footnote",
      "start": 13101,
      "end": 13279,
      "text": "¬أخرجه الإمام أحمد بسنده ومتنه (المسند 17/ 208 ح 11129)، وضعف سنده محققوه، وجود الحافظ ابن كثير سنده، والحق أنه ضعيف لانقطاعه بين أبي البُختري وأبي سعيد الخدري - رضي الله عنه -.¥",
      "attached_span_id": "s140",
      "grading": [
        "ضعيف",
        "سنده"
      ],
      "label_ar": "حاشية المحقق — ليست من كلام ابن كثير"
    }
  ],

  "spans": [
    {
      "start": 0,
      "end": 100,
      "text": "وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ وَيَخْشَ اللَّهَ وَيَتَّقْهِ فَأُولَئِكَ هُمُ الْفَائِزُونَ (52)\r\n",
      "id": "s001"
    },
    {
      "start": 100,
      "end": 146,
      "text": "وقوله: {وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ} أي:",
      "id": "s002"
    },
    {
      "start": 146,
      "end": 244,
      "text": " فيما أمراه به، وترك ما نهياه عنه، {وَيَخْشَ اللَّهَ} فيما مضى من ذنوبه {وَيَتَّقْهِ} فيما يستقبل.",
      "id": "s003"
    },
    {
      "start": 244,
      "end": 291,
      "text": "\r\nوقوله: {فَأُولَئِكَ هُمُ الْفَائِزُونَ} يعني:",
      "id": "s004"
    },
    {
      "start": 291,
      "end": 346,
      "text": " الذين فازوا بكل خير وأمنوا من كل شر في الدنيا والآخرة.",
      "id": "s005"
    }
  ]
}
  "span_count": 7,
  "spans": [
    {
      "start": 0,
      "end": 112,
      "text": "لَا تَحْسَبَنَّ الَّذِينَ كَفَرُوا مُعْجِزِينَ فِي الْأَرْضِ وَمَأْوَاهُمُ النَّارُ وَلَبِئْسَ الْمَصِيرُ (57)\r\n",
      "id": "s001"
    },
    {
      "start": 112,
      "end": 147,
      "text": "وقوله تعالى: {لَا تَحْسَبَنَّ} أي: ",
      "id": "s002"
    },
    {
      "start": 166,
      "end": 167,
      "text": " ",
      "id": "s003"
    },
    {
      "start": 231,
      "end": 302,
      "text": " {الَّذِينَ كَفَرُوا} أي: خالفوك وكذبوك {مُعْجِزِينَ فِي الْأَرْضِ} أي:",
      "id": "s004"
    },
    {
      "start": 302,
      "end": 383,
      "text": " لا يعجزون الله؛ بل الله قادر عليهم وسيعذبهم على ذلك أشد العذاب، ولهذا قال تعالى:",
      "id": "s005"
    },
    {
      "start": 383,
      "end": 456,
      "text": " {وَمَأْوَاهُمُ} أي: في الدار الآخرة {النَّارُ وَلَبِئْسَ الْمَصِيرُ} أي:",
      "id": "s006"
    },
    {
      "start": 456,
      "end": 505,
      "text": " بئس المآل مآل الكافرين، وبئس القرار وبئس المهاد.",
      "id": "s007"
    }
  ]
}
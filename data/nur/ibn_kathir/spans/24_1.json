  "spans": [
    {
      "start": 0,
      "end": 37,
      "text": "سُوْرَةُ النُّوْرِ\r\nوهي مدنية\r\n****\r\n",
      "id": "s001"
    },
    {
      "start": 37,
      "end": 144,
      "text": "سُورَةٌ أَنْزَلْنَاهَا وَفَرَضْنَاهَا وَأَنْزَلْنَا فِيهَا آيَاتٍ بَيِّنَاتٍ لَعَلَّكُمْ تَذَكَّرُونَ (1)\r\n",
      "id": "s002"
    },
    {
      "start": 144,
      "end": 243,
      "text": "يقول تعالى: هذه {سُورَةٌ أَنْزَلْنَاهَا} فيه تنبيه على الاعتناء بها ولا ينفي ما عداها \"وفرَّضناها\".",
      "id": "s003"
    },
    {
      "start": 243,
      "end": 310,
      "text": "\r\nقال مجاهد وقتادة: أي بيَّنا الحلال والحرام والأمر والنهي والحدود ",
      "id": "s004"
    },
    {
      "start": 454,
      "end": 496,
      "text": ".\r\nوقال البخاري: ومن قرأ {وَفَرَضْنَاهَا} ",
      "id": "s005"
    },
    {
      "start": 518,
      "end": 554,
      "text": "، يقول: فرضناها عليكم وعلى من بعدكم ",
      "id": "s006"
    },
    {
      "start": 590,
      "end": 679,
      "text": ".\r\n{وَأَنْزَلْنَا فِيهَا آيَاتٍ بَيِّنَاتٍ} أي: مفسرات واضحات {لَعَلَّكُمْ تَذَكَّرُونَ}.",
      "id": "s007"
    }
  ]
}
  "spans": [
    {
      "start": 0,
      "end": 27,
      "text": "تفسير سورة النور\nوهي مدينة\n",
      "id": "s001"
    },
    {
      "start": 27,
      "end": 135,
      "text": "{سُورَةٌ أَنْزَلْنَاهَا وَفَرَضْنَاهَا وَأَنْزَلْنَا فِيهَا آيَاتٍ بَيِّنَاتٍ لَعَلَّكُمْ تَذَكَّرُونَ (1)}.",
      "id": "s002"
    },
    {
      "start": 135,
      "end": 187,
      "text": "\n{1} أي: هذه {سورةٌ} عظيمةُ القَدْرِ، {أنْزَلْناها}:",
      "id": "s003"
    },
    {
      "start": 187,
      "end": 247,
      "text": " رحمةً منَّا بالعباد، وحفظناها من كلِّ شيطان، {وفَرَضْناها}؛",
      "id": "s004"
    },
    {
      "start": 247,
      "end": 334,
      "text": " أي: قدَّرنا فيها ما قدَّرنا من الحدود والشهادات وغيرها، {وأنزلنا فيها آياتٍ بيِّناتٍ}؛",
      "id": "s005"
    },
    {
      "start": 334,
      "end": 382,
      "text": " أي: أحكاماً جليلةً وأوامر وزواجر وحِكماً عظيمة؛",
      "id": "s006"
    },
    {
      "start": 382,
      "end": 452,
      "text": " {لعلَّكم تذكَّرون}: حين نبيِّنُ لكم، ونُعْلِمُكم ما لم تكونوا تعلمون.",
      "id": "s007"
    }
  ]
}
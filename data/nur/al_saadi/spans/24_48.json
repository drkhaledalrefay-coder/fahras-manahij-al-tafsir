  "spans": [
    {
      "start": 0,
      "end": 105,
      "text": "{وَإِذَا دُعُوا إِلَى اللَّهِ وَرَسُولِهِ لِيَحْكُمَ بَيْنَهُمْ إِذَا فَرِيقٌ مِنْهُمْ مُعْرِضُونَ (48)}.",
      "id": "s001"
    },
    {
      "start": 105,
      "end": 152,
      "text": "\n{48} {وإذا دُعوا إلى الله ورسوله ليحكم بينهم}؛",
      "id": "s002"
    },
    {
      "start": 152,
      "end": 201,
      "text": " أي: إذا صار بينَهم وبينَ أحدٍ حكومةٌ ودُعوا إلى ",
      "id": "s003"
    },
    {
      "start": 206,
      "end": 246,
      "text": " الله ورسوله، {إذا فريقٌ منهم معرِضونَ}:",
      "id": "s004"
    },
    {
      "start": 246,
      "end": 334,
      "text": " يريدونَ أحكامَ الجاهليَّة ويفضِّلون أحكام القوانين غير الشرعيَّة على الأحكام الشرعيَّة؛",
      "id": "s005"
    },
    {
      "start": 334,
      "end": 409,
      "text": " لعلمِهِم أنَّ الحقَّ عليهم، وأنَّ الشرع لا يحكُم إلاَّ بما يطابِقُ الواقع.",
      "id": "s006"
    }
  ]
}
  "span_count": 7,
  "spans": [
    {
      "start": 0,
      "end": 77,
      "text": "{وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَى اللَّهِ الْمَصِيرُ (42)}.",
      "id": "s001"
    },
    {
      "start": 77,
      "end": 144,
      "text": "\n{42} فلما بيَّن عبوديَّتهم وافتقارهم إليه من جهة العبادة والتوحيد؛",
      "id": "s002"
    },
    {
      "start": 144,
      "end": 198,
      "text": " بيَّن افتقارَهم من جهة الملك والتربية والتدبير، فقال:",
      "id": "s003"
    },
    {
      "start": 198,
      "end": 236,
      "text": " {ولله ملكُ السمواتِ والأرض}: خالقهما ",
      "id": "s004"
    },
    {
      "start": 255,
      "end": 354,
      "text": " ورازقهما والمتصرِّفُ فيهما في حكمه الشرعيِّ والقدريِّ في هذه الدار وفي حكمه الجزائيِّ بدار القرار؛",
      "id": "s005"
    },
    {
      "start": 354,
      "end": 387,
      "text": " بدليل قوله: {وإلى الله المصيرُ}؛",
      "id": "s006"
    },
    {
      "start": 387,
      "end": 430,
      "text": " أي: مرجع الخلق ومآلهم ليجازِيَهم بأعمالهم.",
      "id": "s007"
    }
  ]
}
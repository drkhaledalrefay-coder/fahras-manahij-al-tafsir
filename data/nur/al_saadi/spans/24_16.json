  "spans": [
    {
      "start": 0,
      "end": 124,
      "text": "{وَلَوْلَا إِذْ سَمِعْتُمُوهُ قُلْتُمْ مَا يَكُونُ لَنَا أَنْ نَتَكَلَّمَ بِهَذَا سُبْحَانَكَ هَذَا بُهْتَانٌ عَظِيمٌ (16)}.",
      "id": "s001"
    },
    {
      "start": 124,
      "end": 156,
      "text": "\n{16} {ولولا إذ سمِعْتُموه}؛ أي:",
      "id": "s002"
    },
    {
      "start": 156,
      "end": 212,
      "text": " وهلاَّ إذ سمعتُم أيها المؤمنون كلامَ أهل الإفك، {قلتم}:",
      "id": "s003"
    },
    {
      "start": 212,
      "end": 275,
      "text": " منكرين لذلك معظِّمين لأمرِه: {ما يكونُ لنا أن نتكَلَّمَ بهذا}؛",
      "id": "s004"
    },
    {
      "start": 275,
      "end": 333,
      "text": " أي: ما ينبغي لنا وما يليقُ بنا الكلامُ بهذا الإفك المبين؛",
      "id": "s005"
    },
    {
      "start": 333,
      "end": 380,
      "text": " لأنَّ المؤمن يمنعُه إيمانُه من ارتكاب القبائح.",
      "id": "s006"
    },
    {
      "start": 380,
      "end": 411,
      "text": " {هذا بهتانٌ}؛ أي: كذب {عظيمٌ}.",
      "id": "s007"
    }
  ]
}
  "spans": [
    {
      "start": 0,
      "end": 67,
      "text": "{وَإِنْ يَكُنْ لَهُمُ الْحَقُّ يَأْتُوا إِلَيْهِ مُذْعِنِينَ (49)}.",
      "id": "s001"
    },
    {
      "start": 67,
      "end": 105,
      "text": "\n{49} {وإن يكن لهم الحقُّ يأتوا إليه}؛",
      "id": "s002"
    },
    {
      "start": 105,
      "end": 137,
      "text": " أي: إلى حكم الشرع {مُذْعِنينَ}:",
      "id": "s003"
    },
    {
      "start": 137,
      "end": 202,
      "text": " وليس ذلك لأجل أنَّه حكم شرعيٌّ، وإنَّما ذلك لأجل موافقة أهوائهم؛",
      "id": "s004"
    },
    {
      "start": 202,
      "end": 254,
      "text": " فليسوا ممدوحينَ في هذه الحال، ولو أتوا إليه مذعنين؛",
      "id": "s005"
    },
    {
      "start": 254,
      "end": 332,
      "text": " لأنَّ العبدَ حقيقةً مَن يتَّبع الحقَّ فيما يحبُّ ويكره، وفيما يسرُّه ويحزنُه.",
      "id": "s006"
    },
    {
      "start": 332,
      "end": 445,
      "text": " وأما الذي يتَّبع الشرع عند موافقة هواه وينبِذُهُ عند مخالفتِهِ، ويقدِّم الهوى على الشرع؛ فليس بعبدٍ على الحقيقة.",
      "id": "s007"
    }
  ]
}
  "source_char_length": 601,
  "author_char_length": 601,
  "span_count": 10,
  "spans": [
    {
      "start": 0,
      "end": 137,
      "text": "{لَوْلَا جَاءُوا عَلَيْهِ بِأَرْبَعَةِ شُهَدَاءَ فَإِذْ لَمْ يَأْتُوا بِالشُّهَدَاءِ فَأُولَئِكَ عِنْدَ اللَّهِ هُمُ الْكَاذِبُونَ (13)}.",
      "id": "s001"
    },
    {
      "start": 137,
      "end": 175,
      "text": "\n{13} {لولا جاؤوا عليه بأربعة شهداءَ}؛",
      "id": "s002"
    },
    {
      "start": 175,
      "end": 229,
      "text": " أي: هلاَّ جاء الرامون على ما رَمَوْا به بأربعة شهداء؛",
      "id": "s003"
    },
    {
      "start": 229,
      "end": 304,
      "text": " أي: عدول مرضيين، {فإذْ لم يأتوا بالشهداءِ فأولئك عندَ اللهِ هم الكاذبونَ}:",
      "id": "s004"
    },
    {
      "start": 304,
      "end": 342,
      "text": " وإن كانوا في أنفسِهم قد تيقَّنوا ذلك؛",
      "id": "s005"
    },
    {
      "start": 342,
      "end": 371,
      "text": " فإنَّهم كاذبونَ في حكم الله؛",
      "id": "s006"
    },
    {
      "start": 371,
      "end": 435,
      "text": " لأنَّه حرَّمَ عليهم التكلُّم بذلك من دون أربعة شهود، ولهذا قال:",
      "id": "s007"
    },
    {
      "start": 435,
      "end": 466,
      "text": " {فأولئك عند الله هم الكاذبون}:",
      "id": "s008"
    },
    {
      "start": 466,
      "end": 539,
      "text": " ولم يَقُلْ: فأولئك هم الكاذبون، وهذا كلُّه من تعظيم حرمةِ عِرْضِ المسلم؛",
      "id": "s009"
    },
    {
      "start": 539,
      "end": 601,
      "text": " بحيثُ لا يجوز الإقدام على رميِهِ من دون نِصاب الشهادة بالصدق.",
      "id": "s010"
    }
  ]
}
  "spans": [
    {
      "start": 0,
      "end": 70,
      "text": "{وَيُبَيِّنُ اللَّهُ لَكُمُ الْآيَاتِ وَاللَّهُ عَلِيمٌ حَكِيمٌ (18)}.",
      "id": "s001"
    },
    {
      "start": 70,
      "end": 104,
      "text": "\n{18} {ويبيِّن اللهُ لكم الآياتِ}:",
      "id": "s002"
    },
    {
      "start": 104,
      "end": 214,
      "text": " المشتملة على بيان الأحكام والوعظِ والزجر والترغيب والترهيب، يوضِّحُها لكم توضيحاً جليًّا. {والله عليم (حكيم) ",
      "id": "s003"
    },
    {
      "start": 244,
      "end": 276,
      "text": "}؛ أي: كامل العلم، عامُّ الحكمة؛",
      "id": "s004"
    },
    {
      "start": 276,
      "end": 358,
      "text": " فمن علمِهِ وحكمتِهِ أن علَّمكم من علمه، وإنْ كان ذلك راجعاً لمصالحكم في كلِّ وقت.",
      "id": "s005"
    }
  ]
}
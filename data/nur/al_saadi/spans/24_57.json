  "spans": [
    {
      "start": 0,
      "end": 113,
      "text": "{لَا تَحْسَبَنَّ الَّذِينَ كَفَرُوا مُعْجِزِينَ فِي الْأَرْضِ وَمَأْوَاهُمُ النَّارُ وَلَبِئْسَ الْمَصِيرُ (57)}.",
      "id": "s001"
    },
    {
      "start": 113,
      "end": 164,
      "text": "\n{57} {لا تحسبنَّ الذين كفروا مُعْجِزينَ في الأرض}:",
      "id": "s002"
    },
    {
      "start": 164,
      "end": 214,
      "text": " فلا يَغْرُرْكَ ما مُتِّعوا به في الحياة الدُّنيا؛",
      "id": "s003"
    },
    {
      "start": 214,
      "end": 263,
      "text": " فإنَّ الله وإنْ أمْهَلَهم؛ فإنَّه لا يُهْمِلُهم؛",
      "id": "s004"
    },
    {
      "start": 263,
      "end": 311,
      "text": " {نمتِّعُهم قليلاً ثم نضطرُّهم إلى عذابٍ غليظٍ}.",
      "id": "s005"
    },
    {
      "start": 311,
      "end": 361,
      "text": " ولهذا قال هنا: {ومأواهُمُ النارُ ولبئسَ المصيرُ}؛",
      "id": "s006"
    },
    {
      "start": 361,
      "end": 390,
      "text": " أي: بئس المآلُ مآل الكافرين؛",
      "id": "s007"
    },
    {
      "start": 390,
      "end": 429,
      "text": " مآل الشرِّ والحسرة والعقوبة الأبديَّة.",
      "id": "s008"
    }
  ]
}
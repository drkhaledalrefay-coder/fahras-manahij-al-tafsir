  "span_count": 12,
  "spans": [
    {
      "start": 0,
      "end": 191,
      "text": "{أَلَا إِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ قَدْ يَعْلَمُ مَا أَنْتُمْ عَلَيْهِ وَيَوْمَ يُرْجَعُونَ إِلَيْهِ فَيُنَبِّئُهُمْ بِمَا عَمِلُوا وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ (64)}.",
      "id": "s001"
    },
    {
      "start": 191,
      "end": 234,
      "text": "\n{64} {ألا إنَّ لله ما في السمواتِ والأرض}:",
      "id": "s002"
    },
    {
      "start": 234,
      "end": 295,
      "text": " مُلكاً وعبيداً يتصرَّف فيهم بحكمِهِ القدريِّ وحكمه الشرعيِّ.",
      "id": "s003"
    },
    {
      "start": 295,
      "end": 320,
      "text": " {قد يعلم ما أنتُم عليه}؛",
      "id": "s004"
    },
    {
      "start": 320,
      "end": 388,
      "text": " أي: قد أحاط علمُه بما أنتُم عليه من خيرٍ وشرٍّ، وعلم جميعَ أعمالكم؛",
      "id": "s005"
    },
    {
      "start": 388,
      "end": 487,
      "text": " أحصاها علمُه، وجرى بها قلمُه، وكتبتْها عليكم الحفظةُ الكرام الكاتِبون. {ويومَ يُرْجَعون إليه}؛ أي ",
      "id": "s006"
    },
    {
      "start": 502,
      "end": 542,
      "text": ": يوم القيامة {فينَبِّئُهم بما عَمِلوا}:",
      "id": "s007"
    },
    {
      "start": 542,
      "end": 584,
      "text": " يخبرُهم بجميع أعمالِهِم؛ دقيقِها وجليلها؛",
      "id": "s008"
    },
    {
      "start": 584,
      "end": 642,
      "text": " إخباراً مطابقاً لما وَقَعَ منهم، ويستشهدُ عليهم أعضاءَهم؛",
      "id": "s009"
    },
    {
      "start": 642,
      "end": 676,
      "text": " فلا يعدَمون منه فَضْلاً أو عدلاً.",
      "id": "s010"
    },
    {
      "start": 676,
      "end": 734,
      "text": " ولما قيَّد علمَه بأعمالهم؛ ذكر العمومَ بعد الخُصوص، فقال:",
      "id": "s011"
    },
    {
      "start": 734,
      "end": 767,
      "text": " {واللهُ بكلِّ شيءٍ عليمٌ}.\n* * *",
      "id": "s012"
    }
  ]
}